# kavach.cyr -- bundled distribution
# Version: 3.12.3
# Profile: confine
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- util.cyr ---

# kavach — shared string helpers + security hardening primitives

# ⛔ EXPLICIT chrono INCLUDE — DO NOT DELETE AS "UNUSED HERE".
# `chrono` is declared in `[deps].stdlib`, but under cc 6.5.27 that declaration
# alone stopped putting it in the compilation unit, and every kavach chrono call
# (`clock_epoch_secs` in audit / quarantine / oci_spec / observability /
# attestation / scanning_threat / scanning_runtime, `clock_now_ns` in lifecycle,
# `sleep_ms` in spawn) became an undefined function — a hard build stop.
#
# The mechanism is an ORDERING bug in the resolver, not a missing declaration.
# `_dep_copy_stdlib_recursive` (cyrius cbt/deps.cyr) tests its `seen` set on the
# FIRST line and returns before the `is_top == 1` push onto `_dep_includes`. So a
# module that is first pulled TRANSITIVELY (is_top=0) is marked seen, and its own
# later top-level `[deps].stdlib` entry silently resolves to a no-op — the file is
# copied into lib/ but no `include` is ever prepended. cc 6.5.27 added
# `lib/async_macos.cyr`, which includes `lib/chrono.cyr`, and `lib/async.cyr`
# includes that; since `async` precedes `chrono` in our `[deps].stdlib`, chrono
# started arriving transitively and lost its prepend.
#
# Fixed here rather than by reordering `[deps].stdlib`, because an explicit
# include is order-independent: it survives any further churn in upstream's
# include chains, and it rides into `dist/kavach.cyr` (distlib preserves
# `include "lib/..."` lines), so CONSUMERS get the same protection — their
# `dist/kavach.deps` sidecar resolves chrono through the identical code path and
# would otherwise hit the identical no-op. Cyrius include resolution is
# include-once, so this is a no-op wherever the auto-prepend works.
include "lib/chrono.cyr"

# ---- portable filesystem-removal shims -----------------------------------
# ⛔ THE AGNOS AND LINUX SYSCALL WRAPPERS HAVE DIFFERENT ARITIES, and kavach called the Linux form
# unguarded in eight files. On Linux `sys_unlink(path)` / `sys_rmdir(path)` take one argument; on
# agnos they take `(path, pathlen)`. Cyrius used to WARN on an arity mismatch and compile anyway —
# it is now a hard ERROR, which is correct, and which turned this latent wrongness into a build stop.
#
# ⚠ THE BLAST RADIUS WAS THE WHOLE CONSUMER, NOT THE BACKEND. `cyrius build` auto-prepends every
# `[deps.*]` module into the compilation unit, so any project declaring `[deps.kavach]` and building
# `--agnos` failed to compile even if it never touched the OCI or Firecracker backends. That is how
# it surfaced: it broke the aethersafha compositor, which uses only `sandbox_*`.
#
# These shims are the ONE place the difference lives. Call sites use kv_unlink / kv_rmdir and stay
# target-agnostic. See docs/development/issues/2026-08-01-linux-only-backends-break-every-agnos-consumer.md
fn kv_unlink(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_unlink(path, strlen(path));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_unlink(path);
    #endif
}

fn kv_rmdir(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path, strlen(path));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path);
    #endif
}

# kv_waitpid(pid, status_out, opts) — portable reap. Returns the pid (>0) or -1.
#
# ⛔ THIS IS NOT AN ARITY DIFFERENCE, IT IS A MODEL DIFFERENCE, and treating it as the former would
# be silently wrong. Linux `sys_waitpid(pid, status, opts)` writes a packed wait-STATUS word whose
# low 7 bits are the terminating signal and whose bits 8-15 are the exit code. agnos
# `sys_waitpid(pid)` takes one argument and returns the child's **exit code DIRECTLY** — cyrius's own
# `syscalls_x86_64_agnos.cyr` says so where it defines the agnos `W*` decoders.
#
# ⚠ Every caller in this repo decodes `(status >> 8) & 255`. Handing them a bare exit code would put
# the code in the SIGNAL field: a child exiting 11 would read as "killed by SIGSEGV", and a clean
# exit 0 would read as "killed by signal 0". So the agnos arm SYNTHESISES the Linux-shaped word.
fn kv_waitpid(pid, status_out, opts): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var code = sys_waitpid(pid);
    if (code < 0) { return 0 - 1; }
    # agnos children always exit normally (there is no signal-kill model here), so the signal
    # field is 0 and the exit code goes where every caller already looks for it.
    if (status_out != 0) { store32(status_out, (code & 255) << 8); }
    return pid;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_waitpid(pid, status_out, opts);
    #endif
}

# kv_getgid() — the caller's group id, or -1 where the platform has no group model.
#
# ⛔ AN `#ifdef` EARLY-RETURN DOES NOT REMOVE THE REST OF THE BODY FROM THE BUILD, which is why
# 3.10.0's fail-closed guards did not fix this. `spawn_namespaces_available` opens with
# `#ifdef CYRIUS_TARGET_AGNOS return 0; #endif` and STILL referenced `sys_getgid` twenty lines
# further down: the guard is a runtime branch, so every statement after it is compiled and every
# symbol it names must resolve. Only a shim — whose two arms are selected at COMPILE time — keeps
# the undefined name out of the object. That distinction cost a build.
#
# ⚠ agnos defines `sys_getuid` and does NOT define `sys_getgid` — there is no group model in the
# kernel, so there is no honest number to return. This answers **-1 = unknown**, never 0: every
# consumer here (the uid_map/gid_map writer, the OCI `gidMappings` field) treats the value as a
# real credential, and 0 is the id of *root*. A shim that quietly reports root on a platform with
# no groups is the kind of lie that reads as a working sandbox.
#
# ⭐ Nothing on agnos consumes the result: all four call sites sit inside Linux-only namespace /
# seccomp / OCI paths that 3.10.0 already made fail closed. The arm exists so the module compiles.
fn kv_getgid(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_getgid();
    #endif
}

# kv_lstat(path, statbuf) — stat WITHOUT following a final symlink. 0 on success, -1 otherwise.
#
# ⛔ THE AGNOS ARM MUST NOT FALL BACK TO `sys_stat`, even though agnos has one. lstat's whole
# purpose at the single call site (`_oci_dir_is_ours`) is to refuse a path whose last component is
# a symlink — an attacker pointing the state root at a directory they control is exactly the case
# it exists to catch. agnos's `sys_stat(path, pathlen, statbuf)` FOLLOWS links, so substituting it
# would turn a security check into its own bypass while every caller still read 0 = "verified ours".
#
# ⚠ It would also return the wrong SHAPE: agnos's stat buffer carries no `st_uid`, and the caller
# reads the owner out of `+24 >> 32` (see the xstat-bridges-the-call-not-the-struct finding). A
# successful-looking return would hand it a garbage uid to compare against.
#
# So agnos answers -1, the caller returns "no usable state root", and the OCI backend — which is
# Linux-only by construction — stays refused.
fn kv_lstat(path, statbuf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_lstat(path, statbuf);
    #endif
}

# ---- portable fork/exec shims --------------------------------------------
# agnos has NO fork/exec model at all: `sys_fork`, `sys_dup2`, `sys_execve` and `sys_setsid` are
# absent from `syscalls_x86_64_agnos.cyr`, and process creation is the FUSED `sys_spawn_path(path,
# len)` #43 — load an ELF and run it, with no separately-addressable child in between. There is no
# moment at which a child could redirect its stdio or replace its image, so there is nothing for
# these to map onto and they answer -1 rather than pretending.
#
# ⭐ THE REFUSAL IS THE EXISTING ERROR PATH, NOT A NEW ONE. Every fork site in this repo is already
# written `var pid = kv_fork(); if (pid < 0) { ...cleanup...; return -1; }`, so a -1 walks straight
# into the failure handling the Linux path uses when fork itself fails. No caller needs a target
# check, no sandbox reports success, and the `if (pid == 0)` child block is unreachable at runtime
# by construction rather than by guard.
#
# ⚠ SHIMMED EVEN THOUGH ONLY `sys_execve` CURRENTLY TRIPS THE BUILD. The compiler flags undefined
# symbols it can prove reachable; `sys_fork`/`sys_dup2`/`sys_setsid` sit in the SAME child blocks
# and are undefined too — they warn today and error the moment reachability analysis, an inliner,
# or one new caller shifts. Leaving three of a family of four un-shimmed keeps a build break loaded
# for whoever touches this next, which is exactly how the 2026-08-01 aethersafha stop happened.
fn kv_fork(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_fork();
    #endif
}

# ⚠ NOT emulated with agnos's `sys_dup` — dup picks the lowest free descriptor, dup2 forces a
# SPECIFIC one. Every call here targets fd 0/1/2 to wire up stdio, and a shim that returned some
# other descriptor would report success while the child's output went nowhere the parent reads.
fn kv_dup2(oldfd, newfd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_dup2(oldfd, newfd);
    #endif
}

fn kv_execve(path, argv, envp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_execve(path, argv, envp);
    #endif
}

fn kv_setsid(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_setsid();
    #endif
}

# ---- constant-time ops ---------------------------------------------------
# Delegates to the stdlib ct_eq_bytes_lens, which XORs byte-by-byte into an
# accumulator without early exit. Prevents timing side channels on
# HMAC/signature verification (ADR-005 §C1). sigil retired its own ct_eq in
# the 3.x line in favor of this stdlib symbol (identical semantics) — see
# CHANGELOG 3.3.0.

fn ct_streq(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    if (la != lb) { return 0; }
    return ct_eq_bytes_lens(a, la, b, lb);
}

# ---- overflow-checked arithmetic -----------------------------------------
# Return -1 on overflow instead of wrapping. Use for sizes fed to alloc().

fn checked_add(a, b) {
    if (a < 0) { return 0 - 1; }
    if (b < 0) { return 0 - 1; }
    var r = a + b;
    if (r < a) { return 0 - 1; }
    return r;
}

fn checked_mul(a, b) {
    if (a < 0) { return 0 - 1; }
    if (b < 0) { return 0 - 1; }
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var r = a * b;
    if (r / a != b) { return 0 - 1; }
    return r;
}

# Sum 4 non-negative sizes with overflow detection. Returns -1 on any
# negative input or any intermediate overflow. Unused slots: pass 0.
# Chosen arity keeps our worst alloc sites (audit/quarantine/oci_spec)
# coverable in one call — those stitch at most 4 user-lengths plus a
# bounded constant the caller adds separately.
fn checked_sum4(a, b, c, d) {
    var s = checked_add(a, b);
    if (s < 0) { return 0 - 1; }
    s = checked_add(s, c);
    if (s < 0) { return 0 - 1; }
    s = checked_add(s, d);
    if (s < 0) { return 0 - 1; }
    return s;
}

# Overflow-safe alloc: returns 0 (instead of aborting) if requested size
# is negative or exceeds the attacker-defense ceiling of 64 MiB per
# single allocation. 64 MiB is larger than any legitimate per-op buffer
# kavach allocates (OCI spec worst case ~2 MiB, audit line < 1 MiB).
fn alloc_checked(size) {
    if (size < 0) { return 0; }
    if (size > 67108864) { return 0; }
    return alloc(size);
}

# ---- input validation ----------------------------------------------------

# Reject control chars (NUL, BEL, ESC, …) while allowing tab/newline/CR.
# Prevents JSON injection, log forgery, and terminal escape smuggling.
# Returns 1 if safe, 0 otherwise.
#
# Reads the untrusted input through a bounds-checked slice (`sl[i]` lowers to
# the stdlib `_slice_idx_get_1`, which traps on out-of-range): on this
# security-relevant validation path a future off-by-one becomes a clean abort
# rather than an out-of-bounds read of attacker-influenced memory.
fn is_safe_text(s) {
    var n = strlen(s);
    var sl: [u8] = 0;
    slice_set(&sl, s, n);
    var i = 0;
    while (i < n) {
        var c = sl[i];
        if (c < 32) {
            if (c != 9) {
                if (c != 10) {
                    if (c != 13) { return 0; }
                }
            }
        }
        i = i + 1;
    }
    return 1;
}

# Stricter: reject newlines + CR too (used for command arguments where
# each line becomes a token and could smuggle extra args). Same
# bounds-checked-slice read of untrusted input as is_safe_text.
fn is_safe_argument(s) {
    var n = strlen(s);
    var sl: [u8] = 0;
    slice_set(&sl, s, n);
    var i = 0;
    while (i < n) {
        var c = sl[i];
        if (c < 32) {
            if (c != 9) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# ---- secure file I/O -----------------------------------------------------
# O_WRONLY=1, O_CREAT=0x40, O_TRUNC=0x200, O_EXCL=0x80, O_NOFOLLOW=0x20000
# Mode 0600 = 384.

# Human-readable name for a stdlib IoError variant — for the structured
# log/error line emitted on a failed external write (ADR-005 audit trail).
fn io_error_name(e) {
    if (e == IoNotFound) { return "not found"; }
    if (e == IoAccessDenied) { return "access denied"; }
    if (e == IoBadFd) { return "bad fd"; }
    if (e == IoFailed) { return "write incomplete"; }
    return "i/o error";
}

# Result-returning hardened write. Same O_EXCL|O_NOFOLLOW guarantee as
# file_write_secure (refuses to follow a symlink or clobber an existing file;
# mode 0600), but built on the stdlib `_r` primitives so the failure carries a
# distinguishable IoError (ENOENT vs EACCES vs ELOOP/EEXIST→IoOther) instead of
# a bare -1. NOTE: the stdlib file_write_all_r is deliberately NOT used — it
# opens O_WRONLY|O_CREAT|O_TRUNC without the O_EXCL|O_NOFOLLOW hardening
# (ADR-005 §C4). Returns Ok(len) or Err(IoError).
fn file_write_secure_r(path, buf, len): Result {
    var flags = 1 + 64 + 512 + 128 + 131072;
    var fo = file_open_r(path, flags, 384);
    if (is_err_result(fo) == 1) { return fo; }
    var fd = result_unwrap(fo);
    var wr = file_write_r(fd, buf, len);
    file_close_r(fd);
    if (is_err_result(wr) == 1) { return wr; }
    if (result_unwrap(wr) != len) { return Err(IoFailed); }
    return Ok(len);
}

# Back-compat int wrapper: returns bytes written, or -1 on any failure.
# Existing callers that don't need the distinguished error keep using this.
fn file_write_secure(path, buf, len) {
    return result_unwrap_or(file_write_secure_r(path, buf, len), 0 - 1);
}

# As file_write_secure, but honors a caller-supplied final mode via fchmod
# on the same fd that the write went through. Used by credential injection
# (ADR-005 §M2): the file is created mode 0600 by O_CREAT, the content
# lands while still 0600 (no other-readable window), then the fd is
# fchmod'd to the requested mode before close. Closing the fd between
# write and chmod would re-open a TOCTOU window — using fchmod on the
# same fd closes it.
#
# Raw `syscall(91, ...)` because the stdlib doesn't ship a sys_fchmod
# wrapper at cc 5.10.34. SYS_FCHMOD = 91 on x86_64 Linux. Only used here;
# folded back into sys_fchmod when the wrapper lands upstream.
fn file_write_secure_modal(path, buf, len, mode) {
    var flags = 1 + 64 + 512 + 128 + 131072;
    var fd = sys_open(path, flags, 384);
    if (fd < 0) { return 0 - 1; }
    var n = sys_write(fd, buf, len);
    if (n < 0) { sys_close(fd); return 0 - 1; }
    if (n != len) { sys_close(fd); return 0 - 1; }
    # SAFETY: SYS_FCHMOD = 91 on x86_64 Linux; fd is owned by this fn
    # (just opened above), mode is the caller-supplied octal value, the
    # third arg is the standard syscall(...) trailing zero.
    syscall(91, fd, mode, 0);
    sys_close(fd);
    return n;
}

# Restrict an existing file to owner-only (best-effort; ignores errors so
# that failing platforms don't break the exec path — caller still wrote).
fn file_restrict_mode(path) {
    sys_chmod(path, 384);
    return 0;
}

# ---- random bytes --------------------------------------------------------
# Fill `count` bytes of buf from the kernel CSPRNG via getrandom(2) (the
# stdlib random_bytes wrapper). Returns bytes filled, or -1 on failure. Used
# for unpredictable container ids — breaks the /tmp-symlink-precreate attack
# (ADR-005 §C3). getrandom needs no fd and works where /dev/urandom isn't
# mounted (chroot, landlocked, minimal mount ns) — strictly better for a
# sandbox tool than the old open/read/close on /dev/urandom. Blocks only
# until the kernel pool is seeded (immediate post-boot); flags=0, never
# GRND_INSECURE — the unpredictability is a security property here.
fn fill_random(buf, count) {
    var n = random_bytes(buf, count);
    if (n < 0) { return 0 - 1; }
    return n;
}

# Hex-encode `len` bytes from src into dst. dst must fit len*2 + 1 bytes.
fn hex_encode_bytes(src, len, dst) {
    var hex = "0123456789abcdef";
    var i = 0;
    while (i < len) {
        var b = load8(src + i);
        store8(dst + i * 2, load8(hex + ((b >> 4) & 15)));
        store8(dst + i * 2 + 1, load8(hex + (b & 15)));
        i = i + 1;
    }
    store8(dst + len * 2, 0);
    return 0;
}

# 16-char hex id from the kernel CSPRNG (8 random bytes × 2). Returns heap cstr.
fn rand_hex_id() {
    var raw[8];
    fill_random(&raw, 8);
    var out = alloc(17);
    hex_encode_bytes(&raw, 8, out);
    return out;
}

# 64-bit random from the kernel CSPRNG. Used for UUID-v4-equivalent internal
# IDs (sandbox, finding, quarantine entry). Collision probability across
# 2^32 entries is ~2^-32 — sufficient for correlation IDs. Falls back
# to 0 on failure (caller sees a duplicate, which is a visible bug
# rather than a silent TOCTOU).
fn rand_u64() {
    var raw[8];
    if (fill_random(&raw, 8) != 8) { return 0; }
    return load64(&raw);
}

# 32-char hex UUID-like id. Two u64 samples give 128 bits of randomness.
fn rand_uuid_hex() {
    var raw[16];
    fill_random(&raw, 16);
    var out = alloc(33);
    hex_encode_bytes(&raw, 16, out);
    return out;
}

# ---- secret redaction ----------------------------------------------------
# For evidence snippets that may contain an actual secret. Policy: show
# first 4 + '****' + last 4 if len > 8; otherwise full mask. Preserves
# signal (prefix identifies key type, e.g. 'AKIA****') without leaking
# the secret content.

fn redact_evidence(text, start, len) {
    if (len <= 8) {
        var mask = alloc(len + 1);
        memset(mask, 42, len);
        store8(mask + len, 0);
        return mask;
    }
    var buf = alloc(13);
    memcpy(buf, text + start, 4);
    memcpy(buf + 4, "****", 4);
    memcpy(buf + 8, text + start + len - 4, 4);
    store8(buf + 12, 0);
    return buf;
}

# ---- existing helpers ----------------------------------------------------

fn ch_ascii_lower(c) {
    if (c >= 65) {
        if (c <= 90) { return c + 32; }
    }
    return c;
}

# Case-insensitive null-terminated string equality. 1 = equal, 0 = not.
fn strieq(a, b) {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ch_ascii_lower(ca) != ch_ascii_lower(cb)) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Split a command line on runs of spaces/tabs into a vec of cstr tokens.
#
# Lives here rather than in a backend because BOTH the process backend and the
# OCI spec generator need it — the OCI spec must emit `process.args` as real
# argv, not a `/bin/sh -c` string, or any image without a shell (distroless,
# scratch, a single static binary) cannot run.
fn _split_command(cmdline) {
    var args = vec_new();
    var n = strlen(cmdline);
    var i = 0;
    while (i < n) {
        while (i < n) {
            var c = load8(cmdline + i);
            if (c != 32) { if (c != 9) { break; } }
            i = i + 1;
        }
        if (i >= n) { break; }
        var start = i;
        while (i < n) {
            var c = load8(cmdline + i);
            if (c == 32) { break; }
            if (c == 9) { break; }
            i = i + 1;
        }
        var len = i - start;
        var tok = alloc(len + 1);
        memcpy(tok, cmdline + start, len);
        store8(tok + len, 0);
        vec_push(args, tok);
    }
    return args;
}

# Sleep `ms` milliseconds.
#
# 3.11.4: the drain loop in `confine_capture` polls a non-blocking pipe, and
# without a sleep between reads it burns a full core for as long as the payload
# runs. agnosai measured exactly that shape in its own capture — 100% CPU for
# the duration of a `sleep 2` — before adding the idle sleep.
fn kv_sleep_ms(ms): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 35 = nanosleep on x86_64 Linux. Spelled numerically because the stdlib
    # exposes no constant for it and kavach must not depend on one appearing.
    var ts[16];
    store64(&ts, ms / 1000);
    store64(&ts + 8, (ms % 1000) * 1000000);
    return syscall(35, &ts, 0);
    #endif
}

# --- generic string helpers, lifted out of scanning_code.cyr at 3.12.3 ---------------------------------
#
# ⚠ They live HERE, not in the code scanner where they were written, because `scanning_runtime.cyr` also
# calls them — which meant the [lib.confine] profile could not close without dragging the entire code
# scanner (and its 25 pattern groups) into a bundle whose whole point is to carry only the confinement
# path. Cyrius has ONE flat namespace, so every existing caller is unaffected by the move.

# Copy src (null-terminated) into dst, ascii-lowered. dst must be sized.
fn str_to_lower_into(src, dst) {
    var i = 0;
    while (1 == 1) {
        var c = load8(src + i);
        store8(dst + i, ch_ascii_lower(c));
        if (c == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# 1 if haystack contains needle (both null-terminated cstrs). Linear search.
fn cstr_contains(haystack, needle) {
    var hlen = strlen(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var i = 0;
    while (i + nlen <= hlen) {
        var j = 0;
        while (j < nlen) {
            if (load8(haystack + i + j) != load8(needle + j)) { break; }
            j = j + 1;
        }
        if (j == nlen) { return 1; }
        i = i + 1;
    }
    return 0;
}

# --- error.cyr ---

# kavach — error codes
# Ported from rust-old/src/error.rs
#
# Members are namespaced `KAVACH_ERR_*` — the same crate-name prefix
# convention as `SysErrorKind` (src/sys_error.cyr). Cyrius hoists enum
# members to global constants under "last definition wins", and qualified
# `KavachError.X` access is only sugar for that hoisted global (verified:
# a two-enum consumer probe had `KavachError.OK` resolve to a later dep's
# generic `OK`, not 0). Bare generic names (`OK`, `TIMEOUT`, `IO_ERROR`,
# `OTHER`) would therefore silently collide with any dep minting the same
# names — in either direction. The `KAVACH_ERR_*` prefix keeps every member
# globally unique so no consumer surface can clash. See ADR-006 §4.

enum KavachError {
    KAVACH_ERR_OK = 0;
    KAVACH_ERR_BACKEND_UNAVAILABLE = 1;
    KAVACH_ERR_CREATION_FAILED = 2;
    KAVACH_ERR_EXEC_FAILED = 3;
    KAVACH_ERR_TIMEOUT = 4;
    KAVACH_ERR_POLICY_VIOLATION = 5;
    KAVACH_ERR_CREDENTIAL_ERROR = 6;
    KAVACH_ERR_INVALID_TRANSITION = 7;
    KAVACH_ERR_EXTERNALIZATION_BLOCKED = 8;
    KAVACH_ERR_IO_ERROR = 9;
    KAVACH_ERR_OTHER = 10;
}

fn kavach_err_name(code) {
    if (code == KAVACH_ERR_OK) { return "ok"; }
    if (code == KAVACH_ERR_BACKEND_UNAVAILABLE) { return "backend not available"; }
    if (code == KAVACH_ERR_CREATION_FAILED) { return "sandbox creation failed"; }
    if (code == KAVACH_ERR_EXEC_FAILED) { return "sandbox execution failed"; }
    if (code == KAVACH_ERR_TIMEOUT) { return "sandbox timeout"; }
    if (code == KAVACH_ERR_POLICY_VIOLATION) { return "policy violation"; }
    if (code == KAVACH_ERR_CREDENTIAL_ERROR) { return "credential error"; }
    if (code == KAVACH_ERR_INVALID_TRANSITION) { return "lifecycle error"; }
    if (code == KAVACH_ERR_EXTERNALIZATION_BLOCKED) { return "externalization blocked"; }
    if (code == KAVACH_ERR_IO_ERROR) { return "i/o error"; }
    if (code == KAVACH_ERR_OTHER) { return "error"; }
    return "unknown error";
}

fn kavach_err_print(code, detail) {
    var name = kavach_err_name(code);
    # Diagnostics to stderr (fd 2) via the stdlib write wrapper — no raw
    # syscall/magic number. Lengths are strlen of NUL-terminated cstrs or
    # literal byte counts of fixed strings (S3).
    sys_write(2, "kavach: ", 8);
    sys_write(2, name, strlen(name));
    if (detail != 0) {
        sys_write(2, ": ", 2);
        sys_write(2, detail, strlen(detail));
    }
    sys_write(2, "\n", 1);
    return 0;
}

# --- sys_security_syscalls.cyr ---

# sys_security_syscalls.cyr — raw x86_64 *LINUX* syscall numbers the
# internalized security/mac/kernel_audit backends need on the LINUX HOST target.
# (The prior comment mislabeled these "agnos-only" — they are plain Linux
# x86_64 numbers; that mislabel is exactly the confusion the 3.5.3 fix corrects.)
# The landlock / prctl / close numbers come from cyrius's lib/syscalls; only
# these are kept here. Extracted (NOT the whole per-arch layer) with the
# agnosys → agnodrm decomposition, to avoid duplicating cyrius's syscall layer.
#
# ⚠ DANGER ON AGNOS — these numbers ALIAS catastrophically on agnos's own 0-62
# syscall table (#41=sleep_ms, #44=unassigned, #45=getrandom, #49=sock_recv;
# #272/#520 are out of range). A raw syscall() with any of them on agnos would
# invoke the WRONG sovereign syscall (e.g. syscall(49,fd,sockaddr,12) → sock_recv
# with a sockaddr pointer as a destination buffer = memory-unsafe garbage).
# Therefore EVERY consumer of these constants — kernel_audit.cyr
# (audit_open/send_raw/recv_raw/agnos_log) and security.cyr (unshare) — MUST
# reference them ONLY inside a `#ifndef CYRIUS_TARGET_AGNOS` branch; the agnos
# branch returns kavach_err_not_supported (the security.cyr precedent). Confinement on
# agnos is the capability layer's job, not these Linux syscalls.
enum SecuritySyscall {
    SYS_UNSHARE = 272;          # Linux x86_64 unshare   (out of agnos 0-62 range)
    SYS_SOCKET_NR = 41;         # Linux x86_64 socket    (agnos #41 = sleep_ms!)
    SYS_BIND_NR = 49;           # Linux x86_64 bind      (agnos #49 = sock_recv!)
    SYS_SENDTO_NR = 44;         # Linux x86_64 sendto    (agnos #44 = unassigned)
    SYS_RECVFROM_NR = 45;       # Linux x86_64 recvfrom  (agnos #45 = getrandom!)
    SYS_AGNOS_AUDIT_LOG = 520;  # claimed-custom; NONEXISTENT on agnos (out of range)
    SYS_CHROOT_NR = 161;        # Linux x86_64 chroot     (agnos #161 out of range)
    SYS_PIVOT_ROOT_NR = 155;    # Linux x86_64 pivot_root (agnos #155 out of range)
}

# --- sys_error.cyr ---

# error.cyr — unified error type with errno mapping
# Ported from rust-old/src/error.rs
#
# In Cyrius, errors are integer codes. The SysError "enum" becomes
# integer constants, and error messages are string pointers.
#
# Error representation: a Result (tagged union from lib/tagged.cyr)
# where Err payload is a pointer to an error struct:
#   { kind: i64, errno: i64, message: *str }
#
# Convention: all agnosys functions return Result values.
# Ok(value) on success, Err(err_ptr) on failure.

# ================================================================
# Error kind constants (maps to Rust SysError variants)
# ================================================================

enum SysErrorKind {
    KAVACH_ERR_SYSCALL_FAILED = 1;
    KAVACH_ERR_INVALID_ARGUMENT = 2;
    KAVACH_ERR_PERMISSION_DENIED = 3;
    KAVACH_ERR_WOULD_BLOCK = 4;
    KAVACH_ERR_MODULE_NOT_LOADED = 5;
    KAVACH_ERR_NOT_SUPPORTED = 6;
    KAVACH_ERR_UNKNOWN = 7;
    KAVACH_ERR_IO = 8;
}

# ================================================================
# Errno constants (Linux x86_64)
# ================================================================

enum Errno {
    EPERM = 1;
    ENOENT = 2;
    ESRCH = 3;
    EINTR = 4;
    EIO = 5;
    ENXIO = 6;
    EBADF = 9;
    EAGAIN = 11;
    ENOMEM = 12;
    EACCES = 13;
    EFAULT = 14;
    EBUSY = 16;
    EEXIST = 17;
    ENODEV = 19;
    ENOTDIR = 20;
    EISDIR = 21;
    EINVAL = 22;
    EMFILE = 24;
    ENOSPC = 28;
    EPIPE = 32;
    ERANGE = 34;
    ENOSYS = 38;
    ENOTEMPTY = 39;
    ENODATA = 61;
    EOVERFLOW = 75;
    EOPNOTSUPP = 95;
    EADDRINUSE = 98;
    ECONNREFUSED = 111;
    ETIMEDOUT = 110;
}

# ================================================================
# Error struct: { kind, errno, message_ptr }
# Layout: kind at +0, errno at +8, message at +16. Total: 24 bytes.
# ================================================================

# ================================================================
# Error representation — dual encoding
# ================================================================
#
# Packed error: kind << 16 | errno (no message, no heap, value < 0x100000)
# Heap error:   pointer to { kind, errno, message_ptr } (24 bytes, value >= 0x100000)
#
# syserr_kind/errno/message dispatch on the value automatically.

# Pack kind + errno into a single integer (zero allocation)
fn syserr_pack(kind, errno): i64 {
    return kind << 16 | errno;
}

# Create a new error with message (heap-allocated, cold path)
fn syserr_new(kind, errno, message): i64 {
    var e = alloc(24);
    store64(e, kind);
    store64(e + 8, errno);
    store64(e + 16, message);
    return e;
}

# Get error kind (works for both packed and heap errors)
fn syserr_kind(e): i64 {
    if (e < 0x100000) { return e >> 16; }
    return load64(e);
}

# Get errno value (works for both packed and heap errors)
fn syserr_errno(e): i64 {
    if (e < 0x100000) { return e & 0xFFFF; }
    return load64(e + 8);
}

# Get error message pointer (0 for packed errors)
fn syserr_message(e): i64 {
    if (e < 0x100000) { return 0; }
    return load64(e + 16);
}

# ================================================================
# Error constructors — packed (fast, no alloc)
# ================================================================

fn kavach_err_syscall_failed_nr(errno): i64 {
    return Err(syserr_pack(KAVACH_ERR_SYSCALL_FAILED, errno));
}

fn kavach_err_permission_denied_nr(errno): i64 {
    return Err(syserr_pack(KAVACH_ERR_PERMISSION_DENIED, errno));
}

fn kavach_err_would_block(): i64 {
    return Err(syserr_pack(KAVACH_ERR_WOULD_BLOCK, EAGAIN));
}

fn kavach_err_invalid_argument_nr(): i64 {
    return Err(syserr_pack(KAVACH_ERR_INVALID_ARGUMENT, EINVAL));
}

fn kavach_err_not_supported_nr(): i64 {
    return Err(syserr_pack(KAVACH_ERR_NOT_SUPPORTED, ENOSYS));
}

# ================================================================
# Error constructors — with message (heap, cold path)
# ================================================================

fn kavach_err_syscall_failed(errno, message): i64 {
    return Err(syserr_new(KAVACH_ERR_SYSCALL_FAILED, errno, message));
}

fn kavach_err_invalid_argument(message): i64 {
    return Err(syserr_new(KAVACH_ERR_INVALID_ARGUMENT, EINVAL, message));
}

fn kavach_err_permission_denied(operation): i64 {
    return Err(syserr_new(KAVACH_ERR_PERMISSION_DENIED, EPERM, operation));
}

fn kavach_err_module_not_loaded(module): i64 {
    return Err(syserr_new(KAVACH_ERR_MODULE_NOT_LOADED, ENODEV, module));
}

fn kavach_err_not_supported(feature): i64 {
    return Err(syserr_new(KAVACH_ERR_NOT_SUPPORTED, ENOSYS, feature));
}

fn kavach_err_unknown(message): i64 {
    return Err(syserr_new(KAVACH_ERR_UNKNOWN, 0, message));
}

fn kavach_err_io(errno, message): i64 {
    return Err(syserr_new(KAVACH_ERR_IO, errno, message));
}

# ================================================================
# Errno-based error creation — packed (zero alloc, hot path)
# ================================================================

fn kavach_err_from_errno(errno): i64 {
    if (errno == EPERM) { return kavach_err_permission_denied_nr(EPERM); }
    if (errno == EACCES) { return kavach_err_permission_denied_nr(EACCES); }
    if (errno == EAGAIN) { return kavach_err_would_block(); }
    if (errno == EINVAL) { return kavach_err_invalid_argument_nr(); }
    if (errno == ENOSYS) { return kavach_err_not_supported_nr(); }
    return kavach_err_syscall_failed_nr(errno);
}

fn kavach_err_from_syscall_ret(ret): i64 {
    var errno = 0 - ret;
    return kavach_err_from_errno(errno);
}

# ================================================================
# Error printing
# ================================================================

fn syserr_print(e): i64 {
    var kind = syserr_kind(e);
    var msg = syserr_message(e);
    var msglen = 0;
    if (msg != 0) { msglen = strlen(msg); }

    # Exhaustive match — every SysErrorKind variant explicit so cyrius
    # lint catches any future addition that misses a handler. No
    # `_ =>` opt-out: a missing variant should fail loud (fall through
    # to the trailing newline + return) rather than silently degrade.
    match kind {
        KAVACH_ERR_SYSCALL_FAILED => {
            sys_write(2, "syscall failed (errno ", 22);
            var ebuf[24];
            var elen = fmt_int_buf(syserr_errno(e), &ebuf);
            sys_write(2, &ebuf, elen);
            sys_write(2, "): ", 3);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_INVALID_ARGUMENT => {
            sys_write(2, "invalid argument: ", 18);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_PERMISSION_DENIED => {
            sys_write(2, "permission denied: ", 19);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_WOULD_BLOCK => {
            sys_write(2, "resource temporarily unavailable", 32);
        }
        KAVACH_ERR_MODULE_NOT_LOADED => {
            sys_write(2, "kernel module not loaded: ", 25);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_NOT_SUPPORTED => {
            sys_write(2, "feature not supported: ", 23);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_UNKNOWN => {
            sys_write(2, "unknown error: ", 15);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_IO => {
            sys_write(2, "io error (errno ", 16);
            var ibuf[24];
            var ilen = fmt_int_buf(syserr_errno(e), &ibuf);
            sys_write(2, &ibuf, ilen);
            sys_write(2, "): ", 3);
            sys_write(2, msg, msglen);
        }
    }
    sys_write(2, "\n", 1);
    return 0;
}

# Print error from a Result if it's Err, then return the error code.
# Returns 0 if the Result is Ok.
fn result_print_err(res): i64 {
    if (is_ok(res) == 1) { return 0; }
    var e = payload(res);
    syserr_print(e);
    return syserr_errno(e);
}

# ================================================================
# Result helpers for agnosys convention
# ================================================================

# Propagate error: if res is Err, return it immediately.
# Use at top of functions: var val = try_unwrap(res); if (val == 0) { ... }
# Note: Cyrius has no ? operator, so error propagation is manual.
# Pattern:
#   var res = some_call();
#   if (is_err_result(res) == 1) { return res; }
#   var val = payload(res);

# Check if a syscall return value indicates error (negative = errno)
fn is_syscall_err(ret): i64 {
    return ret < 0;
}

# Wrap a raw syscall return: Ok(ret) if >= 0, Err(from_errno) if < 0
fn wrap_syscall(ret): i64 {
    if (ret < 0) { return kavach_err_from_syscall_ret(ret); }
    return Ok(ret);
}

# --- sys_util.cyr ---

# agnosys — shared cross-module utilities
#
# Small helpers that several modules need identically. Kept here (rather
# than copied per-module) so a single definition is audited and tested
# once. Public `agnosys_*` prefix per the project's prefix discipline.
#
# Placed in [lib.core] so every profile bundle (core + domain) resolves
# these — consumers span security/storage/trust/system profiles.

# Emit a JSON value for a possibly-null C string into a str_builder:
# `null` when the pointer is 0, otherwise a JSON-quoted/escaped string.
# Replaces the per-module `_<mod>_emit_cstr_or_null` shims (mac, dmverity,
# drm, certpin, update) that were byte-identical.
fn agnosys_json_emit_cstr_or_null(sb, c): i64 {
    if (c == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_json_str(sb, str_from(c));
    }
    return 0;
}

# Is `ch` an ASCII hex digit (0-9, a-f, A-F)? Single definition shared by
# the hash/digest validators in ima, dmverity, tpm, update.
fn agnosys_is_hex_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 70) { return 1; }   # A-F
    if (ch >= 97 && ch <= 102) { return 1; }  # a-f
    return 0;
}

# Is `ch` valid in a device-mapper / volume name (alphanumeric, `-`, `_`)?
# Single source for the dm-name allowlist shared by dmverity and luks.
fn agnosys_is_name_char(ch): i64 {
    if (ch >= 48 && ch <= 57) { return 1; }   # 0-9
    if (ch >= 65 && ch <= 90) { return 1; }   # A-Z
    if (ch >= 97 && ch <= 122) { return 1; }  # a-z
    if (ch == 45) { return 1; }               # -
    if (ch == 95) { return 1; }               # _
    return 0;
}

# Does C string `str` start with C string `prefix`? Single-pass: walks
# `prefix` and compares, stopping at the first mismatch, the prefix
# terminator, or the str terminator — no up-front strlen of either side
# (the previous per-module copies scanned both strings fully first).
fn agnosys_cstr_starts_with(str, prefix): i64 {
    var i = 0;
    var pc = load8(prefix);
    while (pc != 0) {
        var sc = load8(str + i);
        if (sc == 0) { return 0; }
        if (sc != pc) { return 0; }
        i = i + 1;
        pc = load8(prefix + i);
    }
    return 1;
}

# Run a subprocess (cstr argv vec) and capture stdout into a caller buffer.
# Returns Ok(bytes_read) or Err(errmsg) on exec failure. `errmsg` is the
# per-tool diagnostic. Shared by dmverity/luks/tpm `*_run_capture`.
fn agnosys_run_capture(args, buf, buflen, errmsg): i64 {
    var n = exec_capture(args, buf, buflen);
    if (n < 0) {
        return kavach_err_unknown(errmsg);
    }
    return Ok(n);
}

# Run a subprocess (cstr argv vec) and check for a zero exit code.
# Returns Ok(0) or Err(errmsg) on non-zero exit / exec failure. Shared by
# dmverity/luks/tpm `*_run_checked`.
fn agnosys_run_checked(args, errmsg): i64 {
    var rc = exec_vec(args);
    if (rc != 0) {
        return kavach_err_unknown(errmsg);
    }
    return Ok(0);
}

# Read up to `cap` bytes from `fd` into a fresh heap buffer, NUL-terminate,
# and return it as a Str (also valid as a cstr). Drains short reads. The
# buffer is `cap + 1` bytes so the terminator never writes past the end
# even at a full read (the per-module copies alloc'd exactly `cap`, a
# latent 1-byte overflow when the file filled the buffer). Shared by the
# pam config / passwd readers.
fn agnosys_read_fd_to_str(fd, cap): i64 {
    var buf = alloc(cap + 1);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, cap - total);
        if (n <= 0) {
            rgo = 0;
        } else {
            total = total + n;
            if (total >= cap) { rgo = 0; }
        }
    }
    store8(buf + total, 0);
    return str_new(buf, total);
}

# --- security.cyr ---

# security.cyr — Landlock, seccomp BPF, namespace creation
# Ported from rust-old/src/security.rs
#
# Provides Landlock filesystem sandboxing, seccomp-BPF syscall filtering,
# and Linux namespace creation via raw syscalls.

#define LINUX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "lib/hashmap.cyr"

# ================================================================
# Landlock constants (kernel 5.13+)
# ================================================================
#
# SYS_LANDLOCK_* numbers are arch-invariant and now provided by
# lib/syscalls.cyr (cyrius 5.7.x). SYS_PRCTL is arch-varying and
# supplied by src/syscall_arch.cyr.

# **The full ABI v1 right set, plus the two later additions.**
#
# Until 3.11.1 only READ_FILE, READ_DIR and WRITE_FILE were declared, and only
# those three went into `handled_access_fs`. **Landlock restricts ONLY the
# rights named there and leaves every other right fully permitted**, so a
# confined process could still delete any file on the host, create directories
# anywhere, and exec any binary — while the obvious smoke test ("cannot read
# /etc/passwd") passed, because reading was one of the three that *were*
# handled. Reported by agnosai with a runnable probe; the filing is in
# `docs/development/issues/`, dated 2026-08-03.
enum LandlockConst {
    LANDLOCK_ACCESS_FS_EXECUTE = 1;
    LANDLOCK_ACCESS_FS_WRITE_FILE = 2;
    LANDLOCK_ACCESS_FS_READ_FILE = 4;
    LANDLOCK_ACCESS_FS_READ_DIR = 8;
    LANDLOCK_ACCESS_FS_REMOVE_DIR = 16;
    LANDLOCK_ACCESS_FS_REMOVE_FILE = 32;
    LANDLOCK_ACCESS_FS_MAKE_CHAR = 64;
    LANDLOCK_ACCESS_FS_MAKE_DIR = 128;
    LANDLOCK_ACCESS_FS_MAKE_REG = 256;
    LANDLOCK_ACCESS_FS_MAKE_SOCK = 512;
    LANDLOCK_ACCESS_FS_MAKE_FIFO = 1024;
    LANDLOCK_ACCESS_FS_MAKE_BLOCK = 2048;
    LANDLOCK_ACCESS_FS_MAKE_SYM = 4096;
    LANDLOCK_ACCESS_FS_REFER = 8192;
    LANDLOCK_ACCESS_FS_TRUNCATE = 16384;
    LANDLOCK_RULE_PATH_BENEATH = 1;
    # Flag to `landlock_create_ruleset` that asks for the ABI version instead of
    # creating a ruleset. Returns the version as a positive integer.
    LANDLOCK_CREATE_RULESET_VERSION = 1;
}

# The ABI v1 rights — every kernel with Landlock at all accepts these.
fn _landlock_rights_v1(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR
    | LANDLOCK_ACCESS_FS_REMOVE_DIR | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM;
}

# The running kernel's Landlock ABI version, or 0 if Landlock is unavailable.
#
# **This query is not optional.** `landlock_create_ruleset` fails with EINVAL if
# `handled_access_fs` names a right the running ABI does not know, so naming
# REFER (v2) or TRUNCATE (v3) unconditionally would turn a working sandbox into
# a hard error on any kernel older than 6.2.
fn security_landlock_abi_version(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var v = syscall(SYS_LANDLOCK_CREATE_RULESET, 0, 0, LANDLOCK_CREATE_RULESET_VERSION);
    if (v < 0) { return 0; }
    return v;
    #endif
}

# Every right this kernel will accept in `handled_access_fs`.
#
# Masking down by ABI rather than up: the v1 set is the floor, and the two later
# rights are added only where the kernel knows them.
fn _landlock_handled_access(abi): i64 {
    var mask = _landlock_rights_v1();
    if (abi >= 2) { mask = mask | LANDLOCK_ACCESS_FS_REFER; }
    if (abi >= 3) { mask = mask | LANDLOCK_ACCESS_FS_TRUNCATE; }
    return mask;
}

# The rights granted **inside** a path opened read-only.
#
# EXECUTE is included deliberately. Before 3.11.1 it was permitted *everywhere*
# because it was unhandled, and a sandbox that read-only-mounts `/usr` in order
# to run `/usr/bin/python3` is the normal case — withholding it here would turn
# a security fix into a breaking change for every such consumer. Granting it
# only within allowed paths is strictly tighter than the old behaviour while
# keeping that case working.
fn _landlock_allow_read_only(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_READ_FILE
    | LANDLOCK_ACCESS_FS_READ_DIR;
}

# The rights granted **inside** a path opened read-write.
#
# The read-only set plus every mutation right, so a sandboxed process retains
# full control of its own writable area — create, delete, truncate, and (on ABI
# v2+) rename across two of its own allowed directories. Outside those paths all
# of it is now denied, which is the actual fix.
fn _landlock_allow_read_write(abi): i64 {
    var mask = _landlock_allow_read_only() | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_REMOVE_DIR | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM;
    if (abi >= 2) { mask = mask | LANDLOCK_ACCESS_FS_REFER; }
    if (abi >= 3) { mask = mask | LANDLOCK_ACCESS_FS_TRUNCATE; }
    return mask;
}

# Filesystem access levels
enum FsAccess {
    FS_NO_ACCESS = 0;
    FS_READ_ONLY = 1;
    FS_READ_WRITE = 2;
}

# Filesystem rule: { path_ptr, access }
# path_ptr is a null-terminated C string pointer
fn security_fs_rule_new(path, access): i64 {
    var r = alloc(16);
    store64(r, path);
    store64(r + 8, access);
    return r;
}

fn security_fs_rule_path(r): i64 { return load64(r); }
fn security_fs_rule_access(r): i64 { return load64(r + 8); }

fn security_fs_rule_read_only(path): i64 { return security_fs_rule_new(path, FS_READ_ONLY); }
fn security_fs_rule_read_write(path): i64 { return security_fs_rule_new(path, FS_READ_WRITE); }

# ================================================================
# Apply Landlock filesystem restrictions
# ================================================================

# rules: vec of fs_rule pointers, count: number of rules
# Returns Result: Ok(0) on success, Err on failure.
fn security_apply_landlock(rules, count): i64 {
    if (count == 0) { return Ok(0); }

    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no Landlock (a Linux LSM/MAC primitive). FS confinement on AGNOS
    # is the capability layer's responsibility, so report a structured "unsupported
    # on this platform" the system process can surface + branch on — the same way
    # mac.cyr handles SELinux/AppArmor and kernel_audit.cyr handles NETLINK_AUDIT.
    # This is deliberately NOT a silent Ok(0): a silent success would falsely imply
    # the sandbox's FS rules were enforced. Transitional — until AGNOS ships its own
    # FS-confinement mechanism (the native capability-layer Landlock-equivalent),
    # at which point this branch calls that instead of returning unsupported.
    return kavach_err_not_supported("LANDLOCK");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS

    # 3.11.1 — every right the running kernel knows, not the three that happened
    # to be declared. Unhandled rights are PERMITTED by Landlock, so the mask is
    # the entire security surface.
    var abi = security_landlock_abi_version();
    if (abi == 0) { return Ok(0); }
    var handled_access = _landlock_handled_access(abi);

    # LandlockRulesetAttr: { handled_access_fs: u64 } = 8 bytes.
    # Function-local `var X[N]` is N BYTES (cyrius 6.3.13 moved these to
    # the guard-paged thread stack), so this must be [8] to hold the u64
    # store64 below — `var attr[1]` was a 1-byte local taking an 8-byte
    # write, a latent stack smash that 6.3.13+ turns into a hard fault.
    var attr[8];
    store64(&attr, handled_access);

    var ruleset_fd = syscall(SYS_LANDLOCK_CREATE_RULESET, &attr, 8, 0);
    if (ruleset_fd < 0) {
        var errno = 0 - ruleset_fd;
        if (errno == ENOSYS) { return Ok(0); }
        if (errno == EOPNOTSUPP) { return Ok(0); }
        return kavach_err_syscall_failed(errno, "landlock_create_ruleset failed");
    }
    defer { syscall(SYS_CLOSE, ruleset_fd); }

    # 3.11.3: bound the walk by the list as well as the count. A caller asking
    # for a ruleset with **no** path-beneath rules — total filesystem denial,
    # which `policy_landlock_deny_all` expresses as a non-zero count over an
    # empty list — must create and enforce the ruleset without indexing past
    # the end of it. `count == 0` above still means "no landlock at all", which
    # is a different request and stays different.
    var walk = count;
    if (rules == 0) { walk = 0; }
    else { if (vec_len(rules) < walk) { walk = vec_len(rules); } }

    var idx = 0;
    while (idx < walk) {
        var rule = vec_get(rules, idx);
        var access = security_fs_rule_access(rule);

        var allowed_access = 0;
        if (access == FS_READ_ONLY) {
            allowed_access = _landlock_allow_read_only();
        }
        elif (access == FS_READ_WRITE) {
            allowed_access = _landlock_allow_read_write(abi);
        }

        if (allowed_access != 0) {
            var path = security_fs_rule_path(rule);
            # O_PATH = 0x200000, O_CLOEXEC = 0x80000
            var path_fd = sys_open(path, 0x280000, 0);
            if (path_fd < 0) {
                return kavach_err_syscall_failed(0 - path_fd, "landlock open path failed");
            }

            # LandlockPathBeneathAttr: { allowed_access: u64, parent_fd: i32 }
            # Layout: 8 bytes access + 4 bytes fd = 12 bytes (pad to 16)
            var beneath[16];
            store64(&beneath, allowed_access);
            store32(&beneath + 8, path_fd);

            var ret = syscall(SYS_LANDLOCK_ADD_RULE,
              ruleset_fd, LANDLOCK_RULE_PATH_BENEATH, &beneath, 0);
            syscall(SYS_CLOSE, path_fd);

            if (ret < 0) {
                return kavach_err_syscall_failed(0 - ret, "landlock_add_rule failed");
            }
        }
        idx = idx + 1;
    }

    # Set no_new_privs (required by Landlock)
    var ret = syscall(SYS_PRCTL, 38, 1, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_NO_NEW_PRIVS failed");
    }

    ret = syscall(SYS_LANDLOCK_RESTRICT_SELF, ruleset_fd, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "landlock_restrict_self failed");
    }

    return Ok(0);
    #endif
}

# ================================================================
# Seccomp BPF
# ================================================================

# BPF instruction constants
enum BpfConst {
    BPF_LD_W_ABS = 0x20;
    BPF_JMP_JEQ_K = 0x15;
    BPF_RET_K = 0x06;
    SECCOMP_RET_ALLOW = 0x7FFF0000;
    SECCOMP_RET_KILL_PROCESS = 0x80000000;
    SECCOMP_RET_TRAP = 0x00030000;
    BPF_MAXINSNS = 4096;
    PR_SET_NO_NEW_PRIVS = 38;
    PR_SET_SECCOMP = 22;
    SECCOMP_MODE_FILTER = 2;
}

# BPF sock_filter instruction — kernel ABI struct (8 bytes).
# Layout enforced by per-field widths; pointer-to-struct dot syntax
# emits store16/store8/store32 at the kernel-correct offsets.
struct bpf_insn {
    code: i16;
    jt: i8;
    jf: i8;
    k: i32;
}

# Write a BPF sock_filter instruction (8 bytes) to buf at offset.
# Write one classic-BPF instruction at `buf + offset`.
#
# Layout is the kernel's `struct sock_filter`, little-endian:
#   +0 u16 code   +2 u8 jt   +3 u8 jf   +4 u32 k
#
# Written with explicit byte stores rather than through a typed `bpf_insn`
# local. The typed form — `var insn: bpf_insn = buf + offset; insn.code = …` —
# compiled to a NO-OP under this toolchain: every field write was dropped and
# the buffer stayed zero-filled. Nothing failed loudly; the filter simply came
# out as 184 zero bytes, and PR_SET_SECCOMP rejected it with EINVAL, so
# **seccomp confinement was never actually applied by any caller**. The
# regression test below asserts the produced bytes, not just that the call
# returned — the previous shape "worked" by every check except the only one
# that mattered.
fn security_bpf_write_insn(buf, offset, code, jt, jf, k): i64 {
    store8(buf + offset, code & 255);
    store8(buf + offset + 1, (code >> 8) & 255);
    store8(buf + offset + 2, jt & 255);
    store8(buf + offset + 3, jf & 255);
    store8(buf + offset + 4, k & 255);
    store8(buf + offset + 5, (k >> 8) & 255);
    store8(buf + offset + 6, (k >> 16) & 255);
    store8(buf + offset + 7, (k >> 24) & 255);
    return 0;
}

# Load a seccomp-BPF filter into the calling process.
# filter: pointer to BPF bytecode, filter_len: total bytes.
# Returns Result.
fn security_load_seccomp(filter, filter_len): i64 {
    if (filter_len == 0) {
        return kavach_err_invalid_argument("empty seccomp filter");
    }
    if (filter_len % 8 != 0) {
        return kavach_err_invalid_argument("filter size not multiple of 8");
    }
    var num_insns = filter_len / 8;
    if (num_insns > BPF_MAXINSNS) {
        return kavach_err_invalid_argument("seccomp filter too large");
    }

    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no seccomp-BPF (a Linux syscall-filtering facility). Syscall-surface
    # restriction on AGNOS is the capability layer's job, so report a structured
    # "unsupported on this platform" (same pattern as Landlock above) rather than a
    # silent Ok(0) that would falsely imply the syscall surface was filtered. The
    # filter is still validated above. Transitional — until AGNOS provides native
    # syscall-surface filtering, at which point this branch calls that instead.
    return kavach_err_not_supported("SECCOMP");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS

    # Set no_new_privs
    var ret = syscall(SYS_PRCTL, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_NO_NEW_PRIVS failed");
    }

    # sock_fprog: { u16 len, pad[6], u64 filter_ptr }
    # On x86_64: { u16 len (2 bytes), 6 pad, ptr (8 bytes) } = 16 bytes
    var prog[16];
    store16(&prog, num_insns);
    store64(&prog + 8, filter);

    ret = syscall(SYS_PRCTL, PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &prog, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_SECCOMP failed");
    }

    return Ok(0);
    #endif
}

# Syscalls denied by the exec-safe profile. These are the ones a container
# payload has no business making and that lead directly to host compromise or
# namespace escape. Ordered roughly by how often they appear in escape chains.
var _SECCOMP_DENY = 0;

fn _seccomp_deny_list() {
    if (_SECCOMP_DENY != 0) { return _SECCOMP_DENY; }
    var v = vec_new();
    vec_push(v, 165);   # mount
    vec_push(v, 166);   # umount2
    vec_push(v, 155);   # pivot_root
    vec_push(v, 272);   # unshare        — re-namespacing after confinement
    vec_push(v, 308);   # setns          — entering another container's ns
    vec_push(v, 101);   # ptrace         — reading/writing sibling processes
    vec_push(v, 310);   # process_vm_readv
    vec_push(v, 311);   # process_vm_writev
    vec_push(v, 175);   # init_module
    vec_push(v, 176);   # delete_module
    vec_push(v, 313);   # finit_module
    vec_push(v, 246);   # kexec_load
    vec_push(v, 169);   # reboot
    vec_push(v, 167);   # swapon
    vec_push(v, 168);   # swapoff
    vec_push(v, 321);   # bpf
    vec_push(v, 298);   # perf_event_open
    vec_push(v, 323);   # userfaultfd    — a classic exploit-timing primitive
    vec_push(v, 139);   # sysfs
    vec_push(v, 103);   # syslog
    _SECCOMP_DENY = v;
    return v;
}

# Create a seccomp filter that can be installed BEFORE execve.
# Returns Result: Ok(info) where info is {ptr, len}.
#
# **This is a DENY-list (default ALLOW), unlike
# security_create_basic_seccomp_filter's 20-syscall allowlist, and the
# difference is deliberate rather than lazy.**
#
# The allowlist profile is designed for a process already running its payload:
# it permits read/write/mmap/futex and friends, and does NOT permit execve. Load
# it before an exec and the kernel kills the child on the very syscall that
# starts it — so it is unusable on any spawn path, which is why the detached
# spawn needs this variant.
#
# A default-deny profile usable pre-exec would need to allowlist execve plus the
# whole dynamic-loader surface (openat, mmap, mprotect, access, newfstatat, …)
# and then everything the payload itself uses — in practice the ~300-entry list
# the OCI default profile carries. That list is a policy artifact, not something
# this function should invent. Until it exists, blocking the ~20 syscalls that
# actually appear in container-escape chains is the honest, applicable middle:
# strictly better than no filter, and explicitly weaker than the allowlist.
#
# Layout: LD_W_ABS; one JEQ per denied nr jumping to KILL; RET ALLOW; RET KILL.
fn security_create_exec_seccomp_filter(): i64 {
    var deny = _seccomp_deny_list();
    var n = vec_len(deny);
    var insns = n + 3;
    var filter_size = insns * 8;
    var filter = alloc(filter_size);

    # insn 0: load the syscall number from seccomp_data.nr (offset 0).
    security_bpf_write_insn(filter, 0, BPF_LD_W_ABS, 0, 0, 0);

    # insns 1..n: JEQ <nr> -> KILL. A BPF jump counts instructions to SKIP, so
    # from index (1+i) the jump to index (n+2) is (n+2) - (1+i) - 1 = n - i.
    var i = 0;
    while (i < n) {
        security_bpf_write_insn(filter, (1 + i) * 8, BPF_JMP_JEQ_K,
          n - i, 0, vec_get(deny, i));
        i = i + 1;
    }
    # insn n+1: fell through every JEQ — allow.
    security_bpf_write_insn(filter, (n + 1) * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW);
    # insn n+2: KILL target.
    security_bpf_write_insn(filter, (n + 2) * 8, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);

    var info = alloc(16);
    store64(info, filter);
    store64(info + 8, filter_size);
    return Ok(info);
}

# Create a basic seccomp filter allowing safe syscalls.
# Returns Result: Ok(filter_ptr) where payload is {ptr, len}.
# The caller must use the returned pointer and length with security_load_seccomp.
fn security_create_basic_seccomp_filter(): i64 {
    # Pre-computed BPF filter: 23 instructions x 8 bytes = 184 bytes.
    # Layout per insn: u16 code, u8 jt, u8 jf, u32 k (little-endian).
    # 20 allowlisted syscalls: read(0), write(1), close(3), fstat(5),
    # mmap(9), mprotect(10), munmap(11), brk(12), rt_sigreturn(15),
    # exit(60), sigaltstack(131), arch_prctl(158), gettid(186),
    # futex(202), set_tid_address(218), exit_group(231),
    # set_robust_list(273), getrandom(318), clock_gettime(228), rseq(334).
    var filter_size = 184;
    var filter = alloc(filter_size);

    # Insn 0: BPF_LD_W_ABS, k=0 (load syscall nr)
    security_bpf_write_insn(filter, 0, 0x20, 0, 0, 0);
    # Insns 1-20: JEQ for each syscall, jt = skip to ALLOW
    security_bpf_write_insn(filter, 8,   0x15, 20, 0, 0);     # read
    security_bpf_write_insn(filter, 16,  0x15, 19, 0, 1);     # write
    security_bpf_write_insn(filter, 24,  0x15, 18, 0, 3);     # close
    security_bpf_write_insn(filter, 32,  0x15, 17, 0, 5);     # fstat
    security_bpf_write_insn(filter, 40,  0x15, 16, 0, 9);     # mmap
    security_bpf_write_insn(filter, 48,  0x15, 15, 0, 10);    # mprotect
    security_bpf_write_insn(filter, 56,  0x15, 14, 0, 11);    # munmap
    security_bpf_write_insn(filter, 64,  0x15, 13, 0, 12);    # brk
    security_bpf_write_insn(filter, 72,  0x15, 12, 0, 15);    # rt_sigreturn
    security_bpf_write_insn(filter, 80,  0x15, 11, 0, 60);    # exit
    security_bpf_write_insn(filter, 88,  0x15, 10, 0, 131);   # sigaltstack
    security_bpf_write_insn(filter, 96,  0x15, 9,  0, 158);   # arch_prctl
    security_bpf_write_insn(filter, 104, 0x15, 8,  0, 186);   # gettid
    security_bpf_write_insn(filter, 112, 0x15, 7,  0, 202);   # futex
    security_bpf_write_insn(filter, 120, 0x15, 6,  0, 218);   # set_tid_address
    security_bpf_write_insn(filter, 128, 0x15, 5,  0, 231);   # exit_group
    security_bpf_write_insn(filter, 136, 0x15, 4,  0, 273);   # set_robust_list
    security_bpf_write_insn(filter, 144, 0x15, 3,  0, 318);   # getrandom
    security_bpf_write_insn(filter, 152, 0x15, 2,  0, 228);   # clock_gettime
    security_bpf_write_insn(filter, 160, 0x15, 1,  0, 334);   # rseq
    # Insn 21: default KILL
    security_bpf_write_insn(filter, 168, 0x06, 0, 0, 0x80000000);
    # Insn 22: ALLOW
    security_bpf_write_insn(filter, 176, 0x06, 0, 0, 0x7FFF0000);

    var info = alloc(16);
    store64(info, filter);
    store64(info + 8, filter_size);
    return Ok(info);
}

# Get filter pointer from security_create_basic_seccomp_filter result
fn security_seccomp_filter_ptr(info): i64 { return load64(info); }
fn security_seccomp_filter_len(info): i64 { return load64(info + 8); }

# ================================================================
# Namespace creation
# ================================================================

enum CloneFlag {
    CLONE_NEWNET = 0x40000000;
    CLONE_NEWNS = 0x00020000;
    CLONE_NEWPID = 0x20000000;
    CLONE_NEWUSER = 0x10000000;
}

enum NsFlag {
    NS_NETWORK = 1;
    NS_MOUNT = 2;
    NS_PID = 4;
    NS_USER = 8;
}

# SYS_UNSHARE is arch-varying and supplied via src/syscall_arch.cyr.

# Create new namespace(s) with specified flags.
# flags: bitwise OR of NS_NETWORK, NS_MOUNT, NS_PID, NS_USER
# Returns Result.
fn security_create_namespace(flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no Linux namespaces / unshare(2). Process isolation on AGNOS is the
    # capability layer's job, so report a structured "unsupported on this platform"
    # (same pattern as Landlock/seccomp) rather than a silent Ok(0) that would falsely
    # imply isolation was applied. Transitional — until AGNOS provides native
    # isolation primitives, at which point this branch calls those instead.
    return kavach_err_not_supported("NAMESPACES");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sflags = 0;
    if ((flags & NS_NETWORK) != 0) { sflags = sflags | CLONE_NEWNET; }
    if ((flags & NS_MOUNT) != 0) { sflags = sflags | CLONE_NEWNS; }
    if ((flags & NS_PID) != 0) { sflags = sflags | CLONE_NEWPID; }
    if ((flags & NS_USER) != 0) { sflags = sflags | CLONE_NEWUSER; }

    var ret = syscall(SYS_UNSHARE, sflags);
    if (ret < 0) {
        var errno = 0 - ret;
        if (errno == EPERM) { return kavach_err_permission_denied("security_create_namespace"); }
        if (errno == EINVAL) { return kavach_err_invalid_argument("security_create_namespace: invalid flags"); }
        return kavach_err_syscall_failed(errno, "unshare failed");
    }

    return Ok(0);
    #endif
}

# ================================================================
# Syscall name to number mapping (hashmap, O(1) lookup)
# ================================================================

var _syscall_map = 0;

fn security_syscall_map_reset(): i64 { _syscall_map = 0; return 0; }

fn _syscall_map_init(): i64 {
    if (_syscall_map != 0) { return 0; }
    _syscall_map = map_new();
    map_set(_syscall_map, "read", 0);
    map_set(_syscall_map, "write", 1);
    map_set(_syscall_map, "open", 2);
    map_set(_syscall_map, "close", 3);
    map_set(_syscall_map, "stat", 4);
    map_set(_syscall_map, "fstat", 5);
    map_set(_syscall_map, "lseek", 8);
    map_set(_syscall_map, "mmap", 9);
    map_set(_syscall_map, "mprotect", 10);
    map_set(_syscall_map, "munmap", 11);
    map_set(_syscall_map, "brk", 12);
    map_set(_syscall_map, "rt_sigreturn", 15);
    map_set(_syscall_map, "ioctl", 16);
    map_set(_syscall_map, "access", 21);
    map_set(_syscall_map, "pipe", 22);
    map_set(_syscall_map, "dup", 32);
    map_set(_syscall_map, "dup2", 33);
    map_set(_syscall_map, "getpid", 39);
    map_set(_syscall_map, "socket", 41);
    map_set(_syscall_map, "connect", 42);
    map_set(_syscall_map, "accept", 43);
    map_set(_syscall_map, "sendto", 44);
    map_set(_syscall_map, "recvfrom", 45);
    map_set(_syscall_map, "bind", 49);
    map_set(_syscall_map, "listen", 50);
    map_set(_syscall_map, "fork", 57);
    map_set(_syscall_map, "execve", 59);
    map_set(_syscall_map, "exit", 60);
    map_set(_syscall_map, "wait4", 61);
    map_set(_syscall_map, "kill", 62);
    map_set(_syscall_map, "fcntl", 72);
    map_set(_syscall_map, "fsync", 74);
    map_set(_syscall_map, "getcwd", 79);
    map_set(_syscall_map, "chdir", 80);
    map_set(_syscall_map, "mkdir", 83);
    map_set(_syscall_map, "rmdir", 84);
    map_set(_syscall_map, "unlink", 87);
    map_set(_syscall_map, "chmod", 90);
    map_set(_syscall_map, "getuid", 102);
    map_set(_syscall_map, "getgid", 104);
    map_set(_syscall_map, "geteuid", 107);
    map_set(_syscall_map, "getegid", 108);
    map_set(_syscall_map, "getppid", 110);
    map_set(_syscall_map, "setsid", 112);
    map_set(_syscall_map, "prctl", 157);
    map_set(_syscall_map, "mount", 165);
    map_set(_syscall_map, "umount2", 166);
    map_set(_syscall_map, "gettid", 186);
    map_set(_syscall_map, "futex", 202);
    map_set(_syscall_map, "getdents64", 217);
    map_set(_syscall_map, "set_tid_address", 218);
    map_set(_syscall_map, "clock_gettime", 228);
    map_set(_syscall_map, "exit_group", 231);
    map_set(_syscall_map, "openat", 257);
    map_set(_syscall_map, "set_robust_list", 273);
    map_set(_syscall_map, "pipe2", 293);
    map_set(_syscall_map, "epoll_create1", 291);
    map_set(_syscall_map, "getrandom", 318);
    map_set(_syscall_map, "rseq", 334);
    return 0;
}

# Map a syscall name to its x86_64 number. Returns -1 if not found.
fn security_syscall_name_to_nr(name): i64 {
    _syscall_map_init();
    if (map_has(_syscall_map, name) == 1) {
        return map_get(_syscall_map, name);
    }
    return 0 - 1;
}

# --- backend.cyr ---

# kavach — Backend enum and metadata
# Ported from rust-old/src/backend/mod.rs

enum KavachBackend {
    PROCESS = 0;
    GVISOR = 1;
    FIRECRACKER = 2;
    WASM = 3;
    OCI = 4;
    SGX = 5;
    SEV = 6;
    TDX = 7;
    SY_AGNOS = 8;
    NOOP = 9;
}

var KAVACH_BACKEND_COUNT = 10;

# Renamed from `backend_name` (3.8.2): ai-hwaccel — pulled transitively via
# [deps.samay] since 3.8.0 — defines its own `backend_name(b)` over a DIFFERENT
# enum (BACKEND_CUDA..BACKEND_WINDOWS, 17 hardware-detection backends). Both
# enums start at 0, cycc resolves duplicate fns last-definition-wins, and
# ai-hwaccel sorts after kavach — so the collision silently returned hardware
# names for OS backends (`backend_name(KavachBackend.OCI)` → "intel-npu"). `os_`
# marks this as the OS/isolation-backend namer; ai-hwaccel keeps the bare name.
fn os_backend_name(b) {
    if (b == KavachBackend.PROCESS) { return "process"; }
    if (b == KavachBackend.GVISOR) { return "gvisor"; }
    if (b == KavachBackend.FIRECRACKER) { return "firecracker"; }
    if (b == KavachBackend.WASM) { return "wasm"; }
    if (b == KavachBackend.OCI) { return "oci"; }
    if (b == KavachBackend.SGX) { return "sgx"; }
    if (b == KavachBackend.SEV) { return "sev"; }
    if (b == KavachBackend.TDX) { return "tdx"; }
    if (b == KavachBackend.SY_AGNOS) { return "sy-agnos"; }
    if (b == KavachBackend.NOOP) { return "noop"; }
    return "unknown";
}

# Case-insensitive parse. Returns backend code on success, -1 on unknown.
fn backend_parse(s) {
    if (strieq(s, "process") == 1) { return KavachBackend.PROCESS; }
    if (strieq(s, "gvisor") == 1) { return KavachBackend.GVISOR; }
    if (strieq(s, "firecracker") == 1) { return KavachBackend.FIRECRACKER; }
    if (strieq(s, "wasm") == 1) { return KavachBackend.WASM; }
    if (strieq(s, "oci") == 1) { return KavachBackend.OCI; }
    if (strieq(s, "sgx") == 1) { return KavachBackend.SGX; }
    if (strieq(s, "sev") == 1) { return KavachBackend.SEV; }
    if (strieq(s, "tdx") == 1) { return KavachBackend.TDX; }
    if (strieq(s, "sy-agnos") == 1) { return KavachBackend.SY_AGNOS; }
    if (strieq(s, "syagnos") == 1) { return KavachBackend.SY_AGNOS; }
    if (strieq(s, "noop") == 1) { return KavachBackend.NOOP; }
    return 0 - 1;
}

# Existence check via the stdlib access(2) wrapper with F_OK (mode 0).
# Returns 1 if the path exists, 0 otherwise. (Was a raw `syscall(21, ...)`;
# routing through sys_access drops the bare syscall + magic number — S2.)
fn kavach_path_exists(path) {
    if (sys_access(path, 0) == 0) { return 1; }
    return 0;
}

# Check common PATH locations for a binary. Returns 1 if any exists.
fn which_exists(name) {
    var nlen = strlen(name);
    var buf = alloc(nlen + 24);

    var p1 = "/usr/local/bin/";
    memcpy(buf, p1, strlen(p1));
    memcpy(buf + strlen(p1), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p2 = "/usr/bin/";
    memcpy(buf, p2, strlen(p2));
    memcpy(buf + strlen(p2), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p3 = "/bin/";
    memcpy(buf, p3, strlen(p3));
    memcpy(buf + strlen(p3), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p4 = "/usr/sbin/";
    memcpy(buf, p4, strlen(p4));
    memcpy(buf + strlen(p4), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    return 0;
}

# Look for wasmtime on PATH. Returns path cstr, or 0 if none.
fn _wasm_binary_path() {
    if (kavach_path_exists("/usr/local/bin/wasmtime") == 1) { return "/usr/local/bin/wasmtime"; }
    if (kavach_path_exists("/usr/bin/wasmtime") == 1) { return "/usr/bin/wasmtime"; }
    # Fall back to a cargo-installed wasmtime under $HOME/.cargo/bin. getenv
    # ships in the stdlib now (reads /proc/self/environ + allocates) — call it
    # here at config time only, never post-fork (it is not async-signal-safe).
    var home = getenv("HOME");
    if (home != 0) {
        var suffix = "/.cargo/bin/wasmtime";
        var hlen = strlen(home);
        var slen = strlen(suffix);
        var path = alloc_checked(checked_sum4(hlen, slen, 1, 0));
        if (path != 0) {
            memcpy(path, home, hlen);
            memcpy(path + hlen, suffix, slen);
            store8(path + hlen + slen, 0);
            if (kavach_path_exists(path) == 1) { return path; }
        }
    }
    return 0;
}

fn backend_is_available(b) {
    if (b == KavachBackend.NOOP) { return 1; }
    if (b == KavachBackend.PROCESS) { return 1; }
    # 3.11.8: PROBE, like every sibling below. This was a hardcoded 0 while
    # `wasm_health` right next to it did the correct check — and because
    # `sandbox_create` refuses a backend that reports unavailable, the WASM path
    # was unreachable through the public API **even with wasmtime installed**.
    # A consumer could register the backend, configure it and never reach
    # `wasm_exec`. `_wasm_binary_path` moved here from `backend_wasm.cyr` so
    # this file can call it; Cyrius resolves single-pass, callees first.
    if (b == KavachBackend.WASM) {
        if (_wasm_binary_path() == 0) { return 0; }
        return 1;
    }
    if (b == KavachBackend.GVISOR) { return which_exists("runsc"); }
    if (b == KavachBackend.FIRECRACKER) { return which_exists("firecracker"); }
    if (b == KavachBackend.OCI) {
        if (which_exists("runc") == 1) { return 1; }
        if (which_exists("crun") == 1) { return 1; }
        return 0;
    }
    if (b == KavachBackend.SGX) { return kavach_path_exists("/dev/sgx_enclave"); }
    if (b == KavachBackend.SEV) { return kavach_path_exists("/dev/sev"); }
    if (b == KavachBackend.TDX) { return kavach_path_exists("/dev/tdx_guest"); }
    if (b == KavachBackend.SY_AGNOS) {
        if (which_exists("docker") == 1) { return 1; }
        if (which_exists("podman") == 1) { return 1; }
        return 0;
    }
    return 0;
}

# Iterate all 10 backends by index 0..KAVACH_BACKEND_COUNT.
fn backend_at(i) {
    return i;
}

# ---- shared exec-backend epilogue ----------------------------------------
# Every exec-capture backend (process / gvisor / oci / wasm / sgx / sev /
# tdx / sy-agnos / firecracker) builds its ExecResult the same way. These
# three helpers carry that shared shape so the logic — and its hardening —
# lives in exactly one place.

# Whether the most recent backend result is a KAVACH DIAGNOSTIC rather than
# captured payload output.
#
# It matters because `sandbox_exec` runs the externalization gate over the
# result's stdout+stderr, and the gate's contract is "scan what the payload
# is about to externalize". A backend error is not payload output — it is
# kavach explaining why there was no payload. Scanning it lets kavach's own
# secret scanner censor kavach's own error messages: `code_scan` rates a
# runtime diagnostic such as
#   runc run failed: ... exec: "/app/x": stat /app/x: no such file or directory
# a HIGH finding, the gate turns HIGH into QUARANTINE, and the user is told
# "externalization blocked: quarantined" instead of what actually went wrong.
# That is a category error, and it silently swallows exactly the message
# needed to diagnose the failure.
#
# Set by the two diagnostic constructors, cleared by the capture path, so the
# flag always describes the result the caller is holding.
var _backend_diag_only = 0;

#[must_use]
fn backend_result_is_diagnostic() { return _backend_diag_only; }

# Simple failure result: exit 1, no stdout, caller-supplied stderr, zero
# duration. Replaces the per-backend `_X_error` helpers.
fn backend_error_result(msg) {
    _backend_diag_only = 1;
    var r = exec_result_new();
    ExecResult_set_exit_code(r, 1);
    ExecResult_set_stdout(r, "");
    ExecResult_set_stderr(r, msg);
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# Runtime-guard violation result: exit 126 with the first violation's
# description. Call only when vec_len(violations) > 0.
fn backend_guard_result(violations) {
    _backend_diag_only = 1;
    var r = exec_result_new();
    ExecResult_set_exit_code(r, 126);
    var v0 = vec_get(violations, 0);
    ExecResult_set_stderr(r, GuardViolation_description(v0));
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# Build the success/failure ExecResult from a captured-output buffer.
#
# SAFETY (M1, 3.3.1): `exec_capture` fills until `total >= buflen` and can
# return exactly `out_cap`. Writing `store8(out_buf + n, 0)` with n == out_cap
# is one byte past `alloc(out_cap)` — a heap overflow on attacker-influenced
# subprocess output. Clamping n into [0, out_cap - 1] before the NUL makes the
# terminator always land inside the allocation. At the exact-fill boundary this
# drops the final byte of an already-truncated 1 MiB capture — acceptable; the
# alternative (reading past the buffer) is not. Centralizing here fixes the
# off-by-one for all nine capture backends at once.
fn backend_capture_finish(out_buf, n, out_cap, fail_msg, start_ns, end_ns) {
    # This IS captured payload output, so the gate must see it.
    _backend_diag_only = 0;
    var r = exec_result_new();
    if (n < 0) {
        ExecResult_set_exit_code(r, 1);
        ExecResult_set_stdout(r, "");
        ExecResult_set_stderr(r, fail_msg);
    }
    else {
        if (n >= out_cap) { n = out_cap - 1; }
        store8(out_buf + n, 0);
        ExecResult_set_exit_code(r, 0);
        ExecResult_set_stdout(r, out_buf);
        ExecResult_set_stderr(r, "");
    }
    ExecResult_set_duration_ms(r, (end_ns - start_ns) / 1000000);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# --- policy.cyr ---

# kavach — SandboxPolicy
# Ported from rust-old/src/policy/mod.rs
#
# No floats in Cyrius core — cpu_limit stored as tenths (10 = 1.0 core).

#derive(accessors)
struct SandboxPolicy {
    seccomp_enabled;
    seccomp_profile;
    landlock_rules_len;
    network_enabled;
    network_tcp_bind_len;
    network_tcp_connect_len;
    read_only_rootfs;
    memory_limit_mb;
    cpu_limit_tenths;
    max_pids;
    landlock_abstract_unix;
    landlock_signal;
    landlock_rules;
}

# 104 (3.11.3): `landlock_rules` is appended, so no existing field offset moves
# and a consumer holding a policy built by an older release keeps working.
var SANDBOX_POLICY_SIZE = 104;

fn policy_new() {
    var p = alloc(SANDBOX_POLICY_SIZE);
    var i = 0;
    while (i < SANDBOX_POLICY_SIZE) {
        store64(p + i, 0);
        i = i + 8;
    }
    return p;
}

fn policy_minimal() {
    return policy_new();
}

fn policy_basic() {
    var p = policy_new();
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, "basic");
    return p;
}

fn policy_strict() {
    var p = policy_new();
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, "strict");
    SandboxPolicy_set_read_only_rootfs(p, 1);
    SandboxPolicy_set_memory_limit_mb(p, 512);
    SandboxPolicy_set_cpu_limit_tenths(p, 10);
    SandboxPolicy_set_max_pids(p, 64);
    SandboxPolicy_set_landlock_abstract_unix(p, 1);
    SandboxPolicy_set_landlock_signal(p, 1);
    return p;
}

# Allow the payload access to `path`, and to everything beneath it.
#
# **Before 3.11.3 there was no way to say this.** `landlock_rules_len` was a
# bare counter with no list behind it, and `confine_child` called
# `security_apply_landlock(0, 0)` — so a consumer could not express a rule, both
# shipped presets carried a count of 0, and landlock was applied by nothing.
# The machinery underneath was complete: `security_apply_landlock` walks a vec
# of `security_fs_rule` and has since 3.11.1 handled all thirteen ABI v1 rights.
# Only the path from a policy to that vec was missing.
#
# `access` is `FS_READ_ONLY` or `FS_READ_WRITE`. The counter is kept in step
# with the list so `score_backend`, which reads the count, keeps describing
# what is actually configured.
#
# **Landlock is allow-list only.** A policy with one rule permits that subtree
# and denies every other path; a policy with no rules gets no landlock ruleset
# at all, which is not the same thing — see `policy_landlock_deny_all`.
fn policy_landlock_add(p, path, access) {
    if (p == 0) { return 0 - 1; }
    var rules = SandboxPolicy_landlock_rules(p);
    if (rules == 0) {
        rules = vec_new();
        SandboxPolicy_set_landlock_rules(p, rules);
    }
    vec_push(rules, security_fs_rule_new(path, access));
    SandboxPolicy_set_landlock_rules_len(p, vec_len(rules));
    return 0;
}

# Deny the payload every filesystem path.
#
# A landlock ruleset naming **no** path-beneath rules permits nothing, which is
# the strongest confinement available and is exactly right for a payload that
# needs no files: it receives its input on an already-open descriptor, and
# landlock does not affect descriptors that were open before it was applied.
# agnosai's cx tool sandbox is that shape — `cxvm` reads its bytecode from
# stdin.
#
# Distinct from leaving the rule list empty, which applies no ruleset and
# therefore restricts nothing. The sentinel path is never opened: the count is
# what makes `confine_child` install a ruleset, and a `FS_READ_ONLY` rule on a
# path that cannot be opened would fail closed rather than silently widen.
fn policy_landlock_deny_all(p) {
    if (p == 0) { return 0 - 1; }
    var rules = SandboxPolicy_landlock_rules(p);
    if (rules == 0) {
        rules = vec_new();
        SandboxPolicy_set_landlock_rules(p, rules);
    }
    SandboxPolicy_set_landlock_rules_len(p, vec_len(rules) + 1);
    return 0;
}

# The rule list a policy carries, or 0 when it names none.
fn policy_landlock_rules(p) {
    if (p == 0) { return 0; }
    return SandboxPolicy_landlock_rules(p);
}

# Whether this policy asks for any child-side confinement.
#
# The routing predicate for `process_exec`: a policy answering 1 must not reach
# a plain `exec_capture`, because that path has no seam between `fork` and
# `execve` in which to install a filter. Answering on the policy rather than on
# the rootfs is the whole of the 3.11.3 fix.
fn policy_wants_confinement(p) {
    if (p == 0) { return 0; }
    if (SandboxPolicy_seccomp_enabled(p) == 1) { return 1; }
    if (SandboxPolicy_landlock_rules_len(p) > 0) { return 1; }
    return 0;
}

# Case-insensitive preset lookup. Returns 0 on unknown name.
fn policy_from_preset(name) {
    if (strieq(name, "minimal") == 1) { return policy_minimal(); }
    if (strieq(name, "basic") == 1) { return policy_basic(); }
    if (strieq(name, "strict") == 1) { return policy_strict(); }
    return 0;
}

# --- scoring.cyr ---

# kavach — strength scoring (0-100)
# Ported from rust-old/src/scoring/mod.rs

fn base_score(backend) {
    if (backend == KavachBackend.NOOP) { return 0; }
    if (backend == KavachBackend.PROCESS) { return 50; }
    if (backend == KavachBackend.OCI) { return 55; }
    if (backend == KavachBackend.WASM) { return 65; }
    if (backend == KavachBackend.GVISOR) { return 70; }
    if (backend == KavachBackend.SGX) { return 80; }
    if (backend == KavachBackend.SEV) { return 82; }
    if (backend == KavachBackend.TDX) { return 85; }
    if (backend == KavachBackend.SY_AGNOS) { return 80; }
    if (backend == KavachBackend.FIRECRACKER) { return 90; }
    return 0;
}

fn score_label(score) {
    if (score < 30) { return "minimal"; }
    if (score < 50) { return "basic"; }
    if (score < 70) { return "standard"; }
    if (score < 85) { return "hardened"; }
    if (score <= 100) { return "fortress"; }
    return "unknown";
}

# Score a backend with policy modifiers applied. Matches SY reference.
fn score_backend(backend, policy) {
    var score = base_score(backend);

    if (SandboxPolicy_seccomp_enabled(policy) == 1) { score = score + 5; }
    if (SandboxPolicy_landlock_rules_len(policy) > 0) { score = score + 3; }
    if (SandboxPolicy_network_enabled(policy) == 0) { score = score + 5; }
    if (SandboxPolicy_read_only_rootfs(policy) == 1) { score = score + 3; }

    # Resource limits: +2 once if either memory or cpu is set
    if (SandboxPolicy_memory_limit_mb(policy) > 0) { score = score + 2; }
    elif (SandboxPolicy_cpu_limit_tenths(policy) > 0) { score = score + 2; }

    # Landlock TCP ports (ABI v4): +3 once if either list is non-empty
    if (SandboxPolicy_network_tcp_bind_len(policy) > 0) { score = score + 3; }
    elif (SandboxPolicy_network_tcp_connect_len(policy) > 0) { score = score + 3; }

    # Landlock scoping (ABI v6)
    if (SandboxPolicy_landlock_abstract_unix(policy) == 1) { score = score + 2; }
    if (SandboxPolicy_landlock_signal(policy) == 1) { score = score + 2; }

    if (score > 100) { score = 100; }
    if (score < 0) { score = 0; }
    return score;
}

# Rank all available backends by score under `policy`. Returns strongest
# available backend code. Falls back to KavachBackend.NOOP if nothing else passes.
fn resolve_best_backend(policy) {
    var best = KavachBackend.NOOP;
    var best_score = 0 - 1;
    var i = 0;
    while (i < KAVACH_BACKEND_COUNT) {
        var b = backend_at(i);
        if (b != KavachBackend.NOOP) {
            if (backend_is_available(b) == 1) {
                var s = score_backend(b, policy);
                if (s > best_score) {
                    best_score = s;
                    best = b;
                }
            }
        }
        i = i + 1;
    }
    return best;
}

# Returns strongest backend meeting min_score, or -1 if none.
fn resolve_min_strength_backend(policy, min_score) {
    var best = 0 - 1;
    var best_score = min_score - 1;
    var i = 0;
    while (i < KAVACH_BACKEND_COUNT) {
        var b = backend_at(i);
        if (backend_is_available(b) == 1) {
            var s = score_backend(b, policy);
            if (s >= min_score) {
                if (s > best_score) {
                    best_score = s;
                    best = b;
                }
            }
        }
        i = i + 1;
    }
    return best;
}

# --- lifecycle.cyr ---

# kavach — sandbox lifecycle (state machine, config, exec result, Sandbox)
# Ported from rust-old/src/lifecycle/mod.rs
#
# Deferred vs Rust: async is synchronous here, UUID is a monotonic counter,
# timestamps are nanoseconds from CLOCK_MONOTONIC (0 = unset), SecretRef/
# ExternalizationPolicy/RuntimeManifest plumbing omitted until those modules land.

# ---- SandboxState ---------------------------------------------------------

enum SandboxState {
    CREATED = 0;
    RUNNING = 1;
    PAUSED = 2;
    STOPPED = 3;
    DESTROYED = 4;
}

fn state_name(s) {
    if (s == SandboxState.CREATED) { return "created"; }
    if (s == SandboxState.RUNNING) { return "running"; }
    if (s == SandboxState.PAUSED) { return "paused"; }
    if (s == SandboxState.STOPPED) { return "stopped"; }
    if (s == SandboxState.DESTROYED) { return "destroyed"; }
    return "unknown";
}

# Valid FSM edges, mirroring the Rust matches!(...) table:
#   Created  -> Running
#   Running  -> Paused | Stopped | Destroyed
#   Paused   -> Running | Stopped | Destroyed
#   Stopped  -> Destroyed
fn valid_transition(from, to) {
    if (from == SandboxState.CREATED) {
        if (to == SandboxState.RUNNING) { return 1; }
        return 0;
    }
    if (from == SandboxState.RUNNING) {
        if (to == SandboxState.PAUSED) { return 1; }
        if (to == SandboxState.STOPPED) { return 1; }
        if (to == SandboxState.DESTROYED) { return 1; }
        return 0;
    }
    if (from == SandboxState.PAUSED) {
        if (to == SandboxState.RUNNING) { return 1; }
        if (to == SandboxState.STOPPED) { return 1; }
        if (to == SandboxState.DESTROYED) { return 1; }
        return 0;
    }
    if (from == SandboxState.STOPPED) {
        if (to == SandboxState.DESTROYED) { return 1; }
        return 0;
    }
    return 0;
}

# ---- ExecResult -----------------------------------------------------------

# `stdout_len` / `stderr_len` (3.11.7): the artifact's TRUE byte length, or -1
# when the caller did not supply one and `strlen` is the right answer.
#
# They exist because the externalization gate measured every artifact with
# `strlen`, which is not a length — it is a distance to the first NUL. A payload
# whose stdout contained an embedded NUL was scanned only up to it, so a
# credential sitting after one was **released as PASS**. Appended after
# `timed_out` so no existing field offset moves.
#
# NB: keep field comments OUT of this struct body — `#derive(accessors)` reads
# each line as a field.
#derive(accessors)
struct ExecResult {
    exit_code;
    stdout;
    stderr;
    duration_ms;
    timed_out;
    stdout_len;
    stderr_len;
}

var EXEC_RESULT_SIZE = 56;

fn exec_result_new() {
    var r = alloc(EXEC_RESULT_SIZE);
    var i = 0;
    while (i < EXEC_RESULT_SIZE) { store64(r + i, 0); i = i + 8; }
    ExecResult_set_stdout(r, "");
    ExecResult_set_stderr(r, "");
    # -1, not 0, so "unset" and "genuinely empty" stay distinguishable — a 0
    # sentinel would make every default-constructed result claim its stdout is
    # zero bytes and silence the gate entirely.
    ExecResult_set_stdout_len(r, 0 - 1);
    ExecResult_set_stderr_len(r, 0 - 1);
    return r;
}

# Set stdout together with its true length — the length-carrying setter.
#
# Use this whenever the artifact may contain a NUL. The bare
# `ExecResult_set_stdout` leaves the stored length untouched, which is correct
# for a cstring and **stale** if a length was set earlier for a different
# buffer, so do not mix the two on one result.
fn exec_result_set_stdout_n(r, p, n) {
    ExecResult_set_stdout(r, p);
    ExecResult_set_stdout_len(r, n);
    return r;
}

fn exec_result_set_stderr_n(r, p, n) {
    ExecResult_set_stderr(r, p);
    ExecResult_set_stderr_len(r, n);
    return r;
}

# The artifact's length: the supplied one when there is one, else `strlen`.
#
# Every reader of an `ExecResult` artifact goes through these two rather than
# calling `strlen` directly, so a caller that supplied a length gets it honoured
# everywhere and one that did not keeps the pre-3.11.7 behaviour exactly.
#[must_use]
fn exec_result_stdout_len(r) {
    var n = ExecResult_stdout_len(r);
    if (n >= 0) { return n; }
    return strlen(ExecResult_stdout(r));
}

#[must_use]
fn exec_result_stderr_len(r) {
    var n = ExecResult_stderr_len(r);
    if (n >= 0) { return n; }
    return strlen(ExecResult_stderr(r));
}

# ---- SandboxConfig --------------------------------------------------------

# `rootfs` (3.9.1): the filesystem the payload runs INSIDE, or 0 to run on the
# host filesystem — which is what every release before 3.9.1 did unconditionally,
# so a container runtime consuming this API had no way to say "run in this
# rootfs" and its containers silently executed host binaries. Appended at offset
# 64 so no existing field offset moves.
#
# NB: keep field comments OUT of this struct body — `#derive(accessors)` reads
# each line as a field, so a continuation comment becomes a field named `#` and
# generates `SandboxConfig_set_#`.
#derive(accessors)
struct SandboxConfig {
    backend;
    policy;
    timeout_ms;
    inner_backend;
    agent_id;
    hostname;
    domainname;
    workdir;
    rootfs;
    externalization;
    require_ns;
    stdin;
    stdin_len;
    fuel;
    env;
}

# 120: `env` appended, so no existing field offset moves — the same discipline
# `fuel` followed at 112, `stdin`/`stdin_len` at 104 and `require_ns` at 88.
var SANDBOX_CONFIG_SIZE = 120;

# Defaults match Rust's SandboxConfig::default():
#   backend=Process, policy=basic(), timeout_ms=30000, inner_backend=-1 (none)
fn config_new() {
    var c = alloc(SANDBOX_CONFIG_SIZE);
    var i = 0;
    while (i < SANDBOX_CONFIG_SIZE) { store64(c + i, 0); i = i + 8; }
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy_basic());
    SandboxConfig_set_timeout_ms(c, 30000);
    SandboxConfig_set_inner_backend(c, 0 - 1);
    return c;
}

# Fluent-ish setters: mutate in place and return the config pointer so
# callers may chain if they wish.
fn config_backend(c, b)        { SandboxConfig_set_backend(c, b); return c; }
fn config_policy(c, p)         { SandboxConfig_set_policy(c, p); return c; }
fn config_timeout_ms(c, ms)    { SandboxConfig_set_timeout_ms(c, ms); return c; }

# Bytes to hand the payload on stdin (3.11.8). `ptr = 0` means "inherit this
# process's stdin", which is what every backend did before this existed.
#
# ⚠ The buffer is NOT copied — it must outlive the `sandbox_exec` that consumes
# it. And it is capped by pipe capacity: see `confine_capture_input`, which does
# not retry a short write because a payload larger than the pipe would block
# before the child is reading.
fn config_stdin(c, ptr, len)   {
    SandboxConfig_set_stdin(c, ptr);
    SandboxConfig_set_stdin_len(c, len);
    return c;
}

# An explicit WASM instruction budget, in wasmtime `--fuel` units.
#
# ⚠ **0 means "derive from `timeout_ms`", which is what every caller got before
# this existed** — `_wasm_fuel_from_timeout` returns `timeout_ms * 1_000_000`,
# so the default 30 s timeout implies 3e10. That is a *wall-clock* bound
# expressed as a *CPU* bound, and the two are not interchangeable: a caller
# wanting Rust's `Store::set_fuel(1_000_000_000)` had no way to ask for it
# without also shortening its timeout to one second.
#
# Reported by agnosai 2026-08-13, whose `WasmSandbox` advertises the oracle's
# 1e9 through `agnosai_wasm_sandbox_fuel` while the guest actually ran with 30x
# that. Setting this makes the advertised limit the enforced one.
fn config_fuel(c, fuel)        { SandboxConfig_set_fuel(c, fuel); return c; }

# Require the namespaces the policy asks for, even without a rootfs.
#
# **Off by default, and that default is a deliberate trade** (3.11.5). Namespace
# isolation on a rootfs-less sandbox needs a new *user* namespace when
# unprivileged, and Ubuntu 24.04 restricts those outright — so applying it
# unconditionally turns payloads that used to run into payloads that do not run
# at all, on a stock CI host. 3.11.3 briefly did exactly that.
#
# With this set, the rootfs-less path requests the policy's namespaces and
# **fails closed** if the host refuses: the payload exits `SPAWN_EXIT_NS` (123)
# or `SPAWN_EXIT_IDMAP` (118) rather than running with the network the policy
# said it would not have. That is the right answer for a caller who needs the
# guarantee, and the wrong default for one who does not know they are asking.
#
# Off, a rootfs-less sandbox gets seccomp and landlock and **no network
# isolation** — which is what it silently got before 3.11.5, now sayable.
fn config_require_namespaces(c, on) { SandboxConfig_set_require_ns(c, on); return c; }
fn config_inner_backend(c, b)  { SandboxConfig_set_inner_backend(c, b); return c; }
fn config_agent_id(c, s)       { SandboxConfig_set_agent_id(c, s); return c; }
fn config_hostname(c, s)       { SandboxConfig_set_hostname(c, s); return c; }
fn config_domainname(c, s)     { SandboxConfig_set_domainname(c, s); return c; }
fn config_workdir(c, s)        { SandboxConfig_set_workdir(c, s); return c; }

# The filesystem the payload runs INSIDE (3.9.1). Absent (0) means the payload
# execs on the host filesystem, which is what every release before 3.9.1 did
# unconditionally — a container runtime consuming this API had no way to say
# "run in this rootfs", so its containers silently ran host binaries.
fn config_rootfs(c, path)      { SandboxConfig_set_rootfs(c, path); return c; }

# Attach an externalization policy to this sandbox — 3.11.2.
#
# **Carrying the policy is all this does; nothing applies it for you.** The
# lifecycle does not run the gate, so a caller still passes the policy to
# `gate_apply` at the point it wants output scanned. What the field buys is that
# two sandboxes running under different trust levels no longer look identical to
# anything reading their configs.
#
# Reported by agnosai, whose Rust original builds every config with
# `.externalization(ExternalizationPolicy::default())` and had no counterpart to
# port. Default is **0**, not `ext_policy_default()`: defaulting to an active
# policy would start scanning output for every existing consumer that never
# asked for it, which is a behaviour change rather than a new capability.
fn config_externalization(c, p) { SandboxConfig_set_externalization(c, p); return c; }

# The payload's environment — an EXPLICIT, caller-supplied vec of "KEY=VALUE"
# cstrs. Default 0, which execs with an empty environment exactly as before.
#
# This does NOT reverse kavach's standing position that the caller's environment
# is never leaked into a sandbox (`backend_oci.cyr`). The two are opposites:
# inheritance is implicit and carries whatever the host happened to export;
# this is a list the caller wrote down. Nothing is inherited — an entry reaches
# the payload only because a caller put it there. That distinction is the whole
# reason this is safe to add: the default stays empty, so every existing
# consumer is byte-identical, and `getenv` in a sandbox still returns nothing
# unless someone explicitly asked for it.
#
# Reported by stiva, whose containers silently lost the OCI image's declared
# `process.env`: it parsed the image config, persisted the vars, built them into
# its RuntimeSpec — and then had no kavach setter to hand them to, so every
# container ran without the environment its image declared. The Rust runtime
# stiva was ported from applied them via `Command::env`, so this was a parity
# regression with no expressible fix on the consumer side.
#
# Honoured by the process backend (`confine_capture_input`), `sandbox_spawn`,
# and the OCI backend's `process.env`. NOT honoured by persistent sandboxes,
# which have no config in scope — see `_persistent_spawn_inner`.
fn config_env(c, v) { SandboxConfig_set_env(c, v); return c; }

# Build a NULL-terminated envp from a vec of "KEY=VALUE" cstrs. `v == 0` (the
# default) yields the empty envp every kavach exec path used unconditionally
# before 3.12.0, so an unset config is bit-for-bit the old behaviour.
#[must_use]
fn kv_envp_from_vec(v) {
    if (v == 0) {
        var e0 = alloc(8);
        store64(e0, 0);
        return e0;
    }
    var n = vec_len(v);
    var envp = alloc((n + 1) * 8);
    var i = 0;
    while (i < n) {
        store64(envp + i * 8, vec_get(v, i));
        i = i + 1;
    }
    store64(envp + n * 8, 0);
    return envp;
}

# Convenience: enable seccomp with a profile name on the config's policy.
fn config_policy_seccomp(c, profile) {
    var p = SandboxConfig_policy(c);
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, profile);
    return c;
}

fn config_network(c, enabled) {
    var p = SandboxConfig_policy(c);
    SandboxPolicy_set_network_enabled(p, enabled);
    return c;
}

# ---- Sandbox --------------------------------------------------------------

#derive(accessors)
struct Sandbox {
    id;
    config;
    state;
    created_at;
    started_at;
    stopped_at;
}

var SANDBOX_SIZE = 48;

# Sandbox IDs: 64 bits from /dev/urandom, UUID-v4-equivalent for
# correlation. Collision probability across 2^32 sandboxes is ~2^-32.
# Previously a monotonic counter (deferred per ADR-004 §8); closed in
# v3.0 now that util.cyr ships rand_u64().

# Monotonic nanoseconds. Thin alias over the stdlib chrono.clock_now_ns
# (chrono is already a dep) — was a byte-for-byte duplicate of it
# (CLOCK_MONOTONIC clock_gettime). Kept as a named wrapper so the ~22
# backend/lifecycle call sites stay put and the raw syscall + magic 228
# live in one upstream place (S1).
fn mono_now_ns() {
    return clock_now_ns();
}

# Create a sandbox from config. Fails with BACKEND_UNAVAILABLE if the
# selected backend is not present on this system.
fn sandbox_create(config) {
    var b = SandboxConfig_backend(config);
    if (backend_is_available(b) == 0) {
        kavach_err_print(KAVACH_ERR_BACKEND_UNAVAILABLE, os_backend_name(b));
        return 0;
    }
    var s = alloc(SANDBOX_SIZE);
    Sandbox_set_id(s, rand_u64());
    Sandbox_set_config(s, config);
    Sandbox_set_state(s, SandboxState.CREATED);
    Sandbox_set_created_at(s, mono_now_ns());
    Sandbox_set_started_at(s, 0);
    Sandbox_set_stopped_at(s, 0);
    return s;
}

# Transition to a new state. Returns KAVACH_ERR_OK on success,
# KAVACH_ERR_INVALID_TRANSITION otherwise.
fn sandbox_transition(s, to) {
    var from = Sandbox_state(s);
    if (valid_transition(from, to) == 0) {
        return KAVACH_ERR_INVALID_TRANSITION;
    }
    Sandbox_set_state(s, to);
    if (to == SandboxState.RUNNING) {
        Sandbox_set_started_at(s, mono_now_ns());
    }
    if (to == SandboxState.STOPPED) { Sandbox_set_stopped_at(s, mono_now_ns()); }
    if (to == SandboxState.DESTROYED) { Sandbox_set_stopped_at(s, mono_now_ns()); }
    return KAVACH_ERR_OK;
}

# Destroy the sandbox. Transitions through STOPPED if still running.
fn sandbox_destroy(s) {
    var st = Sandbox_state(s);
    if (st == SandboxState.RUNNING) {
        sandbox_transition(s, SandboxState.STOPPED);
    }
    if (st == SandboxState.PAUSED) {
        sandbox_transition(s, SandboxState.STOPPED);
    }
    return sandbox_transition(s, SandboxState.DESTROYED);
}

# ---- SandboxPool ----------------------------------------------------------

#derive(accessors)
struct SandboxPool {
    template;
    warm_count;
    pool_vec;
}

fn sandbox_pool_new(template, warm_count) {
    var p = alloc(24);
    SandboxPool_set_template(p, template);
    SandboxPool_set_warm_count(p, warm_count);
    var v = vec_new();
    var i = 0;
    while (i < warm_count) {
        var sb = sandbox_create(template);
        if (sb == 0) { return 0; }
        vec_push(v, sb);
        i = i + 1;
    }
    SandboxPool_set_pool_vec(p, v);
    return p;
}

# Pop a pre-created sandbox from the pool; cold-start one on miss.
fn sandbox_pool_claim(p) {
    var v = SandboxPool_pool_vec(p);
    if (vec_len(v) > 0) {
        return vec_pop(v);
    }
    return sandbox_create(SandboxPool_template(p));
}

fn sandbox_pool_replenish(p) {
    var v = SandboxPool_pool_vec(p);
    var target = SandboxPool_warm_count(p);
    while (vec_len(v) < target) {
        var sb = sandbox_create(SandboxPool_template(p));
        if (sb == 0) { return KAVACH_ERR_CREATION_FAILED; }
        vec_push(v, sb);
    }
    return KAVACH_ERR_OK;
}

fn sandbox_pool_available(p) {
    return vec_len(SandboxPool_pool_vec(p));
}

# --- scanning_types.cyr ---

# kavach — scanning types
# Ported from rust-old/src/scanning/types.rs

enum Severity {
    INFO = 0;
    LOW = 1;
    MEDIUM = 2;
    HIGH = 3;
    CRITICAL = 4;
}

enum ScanVerdict {
    PASS = 0;
    WARN = 1;
    QUARANTINE = 2;
    BLOCK = 3;
}

fn severity_name(s) {
    if (s == Severity.INFO) { return "info"; }
    if (s == Severity.LOW) { return "low"; }
    if (s == Severity.MEDIUM) { return "medium"; }
    if (s == Severity.HIGH) { return "high"; }
    if (s == Severity.CRITICAL) { return "critical"; }
    return "unknown";
}

fn verdict_name(v) {
    if (v == ScanVerdict.PASS) { return "pass"; }
    if (v == ScanVerdict.WARN) { return "warn"; }
    if (v == ScanVerdict.QUARANTINE) { return "quarantine"; }
    if (v == ScanVerdict.BLOCK) { return "block"; }
    return "unknown";
}

# A single finding from a scanner.
#derive(accessors)
struct ScanFinding {
    id;
    scanner;
    severity;
    category;
    message;
    evidence;
}

var SCAN_FINDING_SIZE = 48;

# Finding IDs: 64-bit random from /dev/urandom (UUID-v4-equivalent).
# Swapped from a monotonic counter in v3.0 — see ADR-004 §8.
fn finding_new(scanner, severity, category, message, evidence) {
    var f = alloc(SCAN_FINDING_SIZE);
    ScanFinding_set_id(f, rand_u64());
    ScanFinding_set_scanner(f, scanner);
    ScanFinding_set_severity(f, severity);
    ScanFinding_set_category(f, category);
    ScanFinding_set_message(f, message);
    ScanFinding_set_evidence(f, evidence);
    return f;
}

#derive(accessors)
struct ScanResult {
    verdict;
    findings;
    worst_severity;
}

var SCAN_RESULT_SIZE = 24;

fn scan_result_new() {
    var r = alloc(SCAN_RESULT_SIZE);
    ScanResult_set_verdict(r, ScanVerdict.PASS);
    ScanResult_set_findings(r, vec_new());
    ScanResult_set_worst_severity(r, Severity.INFO);
    return r;
}

fn scan_result_push(r, finding) {
    var v = ScanResult_findings(r);
    vec_push(v, finding);
    var sev = ScanFinding_severity(finding);
    if (sev > ScanResult_worst_severity(r)) {
        ScanResult_set_worst_severity(r, sev);
    }
    return 0;
}

# Externalization gate policy.
#derive(accessors)
struct ExternalizationPolicy {
    enabled;
    max_artifact_size_bytes;
    block_threshold;
    quarantine_threshold;
    redact_secrets;
}

var EXT_POLICY_SIZE = 40;

fn ext_policy_default() {
    var p = alloc(EXT_POLICY_SIZE);
    ExternalizationPolicy_set_enabled(p, 1);
    # 50 MiB
    ExternalizationPolicy_set_max_artifact_size_bytes(p, 52428800);
    ExternalizationPolicy_set_block_threshold(p, Severity.CRITICAL);
    ExternalizationPolicy_set_quarantine_threshold(p, Severity.HIGH);
    ExternalizationPolicy_set_redact_secrets(p, 1);
    return p;
}

# --- aho_corasick.cyr ---

# kavach — Aho-Corasick multi-pattern matcher
#
# Replaces the scanners' per-pattern full-buffer re-scan (O(patterns × n × m)
# naive substring, ~150 cstr_contains calls in scanning_code.cyr) with a
# single O(n + matches) pass: build one automaton over the literal pattern set,
# run the text through it once, and read each pattern's first-match position
# out of a hit table.
#
# The automaton is built once over a static pattern set and cached by the
# caller (the pattern set is compile-time fixed), so build cost is amortized to
# zero across scans; only the O(n) search runs per artifact.
#
# Patterns are matched case-sensitively against bytes — callers that want
# case-insensitive matching pre-lower both the text and the patterns (which is
# exactly what the code/data scanners already do against their `lower` buffer).
#
# Memory model (all heap, manual): dense 256-way goto so a transition is a flat
# load; node count is bounded by the total pattern length, built once.
#
#   automaton struct (64 bytes):
#     +0  goto_base   (num_nodes_cap * 256 i64; 0 = no transition, root = node 0)
#     +8  fail_base   (num_nodes_cap i64)
#     +16 term_base   (num_nodes_cap i64; pattern id ending at node, or -1)
#     +24 dict_base   (num_nodes_cap i64; output/suffix link to nearest terminal)
#     +32 patlen_base (num_pats i64; byte length of each pattern)
#     +40 num_pats
#     +48 num_nodes   (actual, after build)

# Build an automaton from a vec of pattern cstrs. Pattern ids are the vec
# indices. Returns a heap automaton pointer (never freed — cache it).
fn ac_build(patterns) {
    var np = vec_len(patterns);

    # Upper bound on trie nodes: root + one per pattern char (shared prefixes
    # only ever use fewer). Sized exactly once.
    var total = 0;
    var i = 0;
    while (i < np) {
        total = total + strlen(vec_get(patterns, i));
        i = i + 1;
    }
    var cap = total + 1;

    var goto_b = alloc(cap * 256 * 8);
    memset(goto_b, 0, cap * 256 * 8);
    var fail_b = alloc(cap * 8);
    memset(fail_b, 0, cap * 8);
    var dict_b = alloc(cap * 8);
    memset(dict_b, 0, cap * 8);
    var term_b = alloc(cap * 8);
    var patlen_b = alloc(np * 8);

    # term[] initialised to -1 (no pattern ends here).
    var t = 0;
    while (t < cap) { store64(term_b + t * 8, 0 - 1); t = t + 1; }

    var num_nodes = 1;   # node 0 = root

    # ---- insert patterns into the trie ----
    i = 0;
    while (i < np) {
        var p = vec_get(patterns, i);
        var plen = strlen(p);
        store64(patlen_b + i * 8, plen);
        var node = 0;
        var j = 0;
        while (j < plen) {
            var c = load8(p + j);
            var slot = goto_b + (node * 256 + c) * 8;
            var nxt = load64(slot);
            if (nxt == 0) {
                nxt = num_nodes;
                num_nodes = num_nodes + 1;
                store64(slot, nxt);
            }
            node = nxt;
            j = j + 1;
        }
        store64(term_b + node * 8, i);   # pattern i terminates at `node`
        i = i + 1;
    }

    # ---- BFS to compute failure + dict (output) links ----
    var queue = vec_new();
    # depth-1 nodes (root's children) fail to root.
    var c0 = 0;
    while (c0 < 256) {
        var ch = load64(goto_b + c0 * 8);   # goto[root][c0]
        if (ch != 0) {
            store64(fail_b + ch * 8, 0);
            vec_push(queue, ch);
        }
        c0 = c0 + 1;
    }
    var qi = 0;
    while (qi < vec_len(queue)) {
        var u = vec_get(queue, qi);
        qi = qi + 1;
        var cc = 0;
        while (cc < 256) {
            var v = load64(goto_b + (u * 256 + cc) * 8);
            if (v != 0) {
                # follow u's fail chain to find the longest proper suffix that
                # has a transition on cc
                var f = load64(fail_b + u * 8);
                while (f != 0) {
                    if (load64(goto_b + (f * 256 + cc) * 8) != 0) { break; }
                    f = load64(fail_b + f * 8);
                }
                var ff = load64(goto_b + (f * 256 + cc) * 8);
                if (ff == v) { ff = 0; }   # never let a node fail to itself
                store64(fail_b + v * 8, ff);
                # dict link: nearest terminal node reachable via fail links
                if (load64(term_b + ff * 8) != (0 - 1)) {
                    store64(dict_b + v * 8, ff);
                }
                else {
                    store64(dict_b + v * 8, load64(dict_b + ff * 8));
                }
                vec_push(queue, v);
            }
            cc = cc + 1;
        }
    }

    var ac = alloc(64);
    store64(ac + 0, goto_b);
    store64(ac + 8, fail_b);
    store64(ac + 16, term_b);
    store64(ac + 24, dict_b);
    store64(ac + 32, patlen_b);
    store64(ac + 40, np);
    store64(ac + 48, num_nodes);
    return ac;
}

fn ac_num_pats(ac) { return load64(ac + 40); }

# Allocate a hit-position table for `ac`, initialised to -1 (no match).
# Indexed by pattern id; on a hit, holds the START offset of the first match.
fn ac_hits_new(ac) {
    var np = load64(ac + 40);
    var h = alloc(np * 8);
    var i = 0;
    while (i < np) { store64(h + i * 8, 0 - 1); i = i + 1; }
    return h;
}

# Run `text` (length n) through the automaton, recording the first-match start
# offset of every pattern into `hit_pos` (caller-allocated via ac_hits_new).
fn ac_search(ac, text, n, hit_pos) {
    var goto_b = load64(ac + 0);
    var fail_b = load64(ac + 8);
    var term_b = load64(ac + 16);
    var dict_b = load64(ac + 24);
    var patlen_b = load64(ac + 32);

    var node = 0;
    var i = 0;
    while (i < n) {
        var c = load8(text + i);
        # follow fail links until a transition on c exists (or we're at root)
        while (node != 0) {
            if (load64(goto_b + (node * 256 + c) * 8) != 0) { break; }
            node = load64(fail_b + node * 8);
        }
        node = load64(goto_b + (node * 256 + c) * 8);   # 0 (root) if none
        # emit every pattern ending at this position via the dict-link chain
        var u = node;
        if (load64(term_b + u * 8) == (0 - 1)) { u = load64(dict_b + u * 8); }
        while (u != 0) {
            var pid = load64(term_b + u * 8);
            if (pid != (0 - 1)) {
                if (load64(hit_pos + pid * 8) == (0 - 1)) {
                    store64(hit_pos + pid * 8, i - load64(patlen_b + pid * 8) + 1);
                }
            }
            u = load64(dict_b + u * 8);
        }
        i = i + 1;
    }
    return 0;
}

# --- scanning_runtime.cyr ---

# kavach — runtime guards (fork bomb, paths, commands, shell injection)
# Ported from rust-old/src/scanning/runtime.rs
#
# Integrity monitoring (PID/mount/user namespace checks) is deferred —
# needs /proc file reads which aren't in the current stdlib stub.

# ---- Violation types -----------------------------------------------------

enum ViolationType {
    FORK_BOMB = 0;
    SENSITIVE_PATH = 1;
    BLOCKED_COMMAND = 2;
    SHELL_INJECTION = 3;
    TIME_ANOMALY = 4;
}

fn violation_type_name(t) {
    if (t == ViolationType.FORK_BOMB) { return "fork_bomb"; }
    if (t == ViolationType.SENSITIVE_PATH) { return "sensitive_path"; }
    if (t == ViolationType.BLOCKED_COMMAND) { return "blocked_command"; }
    if (t == ViolationType.SHELL_INJECTION) { return "shell_injection"; }
    if (t == ViolationType.TIME_ANOMALY) { return "time_anomaly"; }
    return "unknown";
}

#derive(accessors)
struct GuardViolation {
    violation_type;
    description;
}

fn guard_violation_new(t, desc) {
    var v = alloc(16);
    GuardViolation_set_violation_type(v, t);
    GuardViolation_set_description(v, desc);
    return v;
}

# ---- Guard config --------------------------------------------------------

#derive(accessors)
struct RuntimeGuardConfig {
    max_pids;
    block_sensitive_paths;
    enforce_command_blocklist;
    time_anomaly_multiplier_x100;
}

fn runtime_guard_config_default() {
    var c = alloc(32);
    RuntimeGuardConfig_set_max_pids(c, 64);
    RuntimeGuardConfig_set_block_sensitive_paths(c, 1);
    RuntimeGuardConfig_set_enforce_command_blocklist(c, 1);
    RuntimeGuardConfig_set_time_anomaly_multiplier_x100(c, 200);
    return c;
}

# 3.12.1 — the guard config for a sandbox that has its OWN ROOTFS.
#
# Identical to the default in every respect EXCEPT the command blocklist, which
# is disabled. Sensitive-path detection and the shell-metacharacter check both
# stay on; only the "is this binary named `sh`" test is dropped.
#
# ⚠ WHY. The blocklist exists to stop an agent sandbox shelling out to an
# interpreter **on the host**, where the name `sh` resolves to the host's
# `/bin/sh` and running it is an escape. When the sandbox has a rootfs, that
# premise is gone: the name resolves INSIDE the container's filesystem, to a
# binary the caller supplied, reached only after `_spawn_enter_rootfs` has
# chrooted and the namespaces are up. The isolation there is the rootfs, the
# namespaces, seccomp and the cgroup — not the payload's filename.
#
# Applying it anyway made kavach unusable as a container runtime, which is what
# the `rootfs` field added at 3.9.1 exists for. Reported by stiva, reproduced
# end-to-end: `stiva run <image>` with no CMD defaults its command to `/bin/sh`,
# and every backend refused it — `blocked command: sh`, exit 126, before fork.
# The same refusal hit any image whose entrypoint is `sh`, `bash`, `python3`,
# `node`, `ruby`, `perl` or `php`, i.e. most of them. No container that needed a
# shell could ever start.
#
# ⚠ This does NOT weaken a rootfs-less sandbox: `rootfs == 0` returns the
# unchanged default, so every agent-sandbox consumer keeps the blocklist exactly
# as before. The narrowing is conditional on a field only a container runtime
# sets.
#[must_use]
fn runtime_guard_config_for_rootfs(rootfs) {
    var c = runtime_guard_config_default();
    if (rootfs != 0) {
        RuntimeGuardConfig_set_enforce_command_blocklist(c, 0);
    }
    return c;
}

# ---- Command parsing -----------------------------------------------------

# Return heap cstr of base command name (first whitespace-separated token,
# stripped of path prefix). "ls -la" -> "ls"; "/bin/bash -c" -> "bash".
fn _base_command(cmd) {
    var n = strlen(cmd);
    # Skip leading whitespace
    var start = 0;
    while (start < n) {
        var c = load8(cmd + start);
        if (c != 32) { if (c != 9) { break; } }
        start = start + 1;
    }
    # End at whitespace
    var end = start;
    while (end < n) {
        var c = load8(cmd + end);
        if (c == 32) { break; }
        if (c == 9) { break; }
        if (c == 10) { break; }
        end = end + 1;
    }
    # Last slash in [start, end) — chars after it are the base name
    var base_start = start;
    var i = start;
    while (i < end) {
        if (load8(cmd + i) == 47) { base_start = i + 1; }
        i = i + 1;
    }
    var len = end - base_start;
    var buf = alloc(len + 1);
    memcpy(buf, cmd + base_start, len);
    store8(buf + len, 0);
    return buf;
}

# ---- Blocklist checks ----------------------------------------------------

fn _is_blocked_command(base) {
    if (streq(base, "bash") == 1) { return 1; }
    if (streq(base, "sh") == 1) { return 1; }
    if (streq(base, "zsh") == 1) { return 1; }
    if (streq(base, "fish") == 1) { return 1; }
    if (streq(base, "dash") == 1) { return 1; }
    if (streq(base, "csh") == 1) { return 1; }
    if (streq(base, "tcsh") == 1) { return 1; }
    if (streq(base, "python") == 1) { return 1; }
    if (streq(base, "python3") == 1) { return 1; }
    if (streq(base, "perl") == 1) { return 1; }
    if (streq(base, "ruby") == 1) { return 1; }
    if (streq(base, "php") == 1) { return 1; }
    if (streq(base, "lua") == 1) { return 1; }
    if (streq(base, "node") == 1) { return 1; }
    if (streq(base, "deno") == 1) { return 1; }
    if (streq(base, "bun") == 1) { return 1; }
    if (streq(base, "gcc") == 1) { return 1; }
    if (streq(base, "cc") == 1) { return 1; }
    if (streq(base, "g++") == 1) { return 1; }
    if (streq(base, "clang") == 1) { return 1; }
    if (streq(base, "make") == 1) { return 1; }
    if (streq(base, "cmake") == 1) { return 1; }
    if (streq(base, "cargo") == 1) { return 1; }
    if (streq(base, "go") == 1) { return 1; }
    if (streq(base, "rustc") == 1) { return 1; }
    if (streq(base, "javac") == 1) { return 1; }
    return 0;
}

fn is_allowed_command(base) {
    if (streq(base, "ls") == 1) { return 1; }
    if (streq(base, "cat") == 1) { return 1; }
    if (streq(base, "head") == 1) { return 1; }
    if (streq(base, "tail") == 1) { return 1; }
    if (streq(base, "wc") == 1) { return 1; }
    if (streq(base, "grep") == 1) { return 1; }
    if (streq(base, "find") == 1) { return 1; }
    if (streq(base, "df") == 1) { return 1; }
    if (streq(base, "du") == 1) { return 1; }
    if (streq(base, "uname") == 1) { return 1; }
    if (streq(base, "hostname") == 1) { return 1; }
    if (streq(base, "ip") == 1) { return 1; }
    if (streq(base, "ss") == 1) { return 1; }
    if (streq(base, "ps") == 1) { return 1; }
    if (streq(base, "top") == 1) { return 1; }
    if (streq(base, "free") == 1) { return 1; }
    if (streq(base, "lsblk") == 1) { return 1; }
    if (streq(base, "lscpu") == 1) { return 1; }
    if (streq(base, "date") == 1) { return 1; }
    if (streq(base, "whoami") == 1) { return 1; }
    if (streq(base, "id") == 1) { return 1; }
    if (streq(base, "env") == 1) { return 1; }
    if (streq(base, "printenv") == 1) { return 1; }
    if (streq(base, "echo") == 1) { return 1; }
    if (streq(base, "true") == 1) { return 1; }
    if (streq(base, "false") == 1) { return 1; }
    if (streq(base, "test") == 1) { return 1; }
    return 0;
}

fn _check_sensitive_paths(cmd_lower, out_vec) {
    var n = 0;
    if (cstr_contains(cmd_lower, "/etc/shadow") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /etc/shadow"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/etc/gshadow") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /etc/gshadow"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/etc/sudoers") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /etc/sudoers"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/root/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /root/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.ssh/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.ssh/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.gnupg/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.gnupg/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.aws/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.aws/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.kube/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.kube/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.docker/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.docker/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/mem") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /dev/mem"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/kmem") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /dev/kmem"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/port") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /dev/port"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/proc/kcore") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /proc/kcore"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/proc/sysrq-trigger") == 1) {
        vec_push(out_vec, guard_violation_new(
            ViolationType.SENSITIVE_PATH, "sensitive path access: /proc/sysrq-trigger"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/sys/firmware/efi/efivars") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: efivars"));
        n = n + 1;
    }
    return n;
}

fn _check_shell_meta(cmd_lower, out_vec) {
    var n = 0;
    if (cstr_contains(cmd_lower, "| sh") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | sh"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "| bash") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | bash"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "; sh") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: ; sh"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "; bash") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: ; bash"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "| /bin/sh") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | /bin/sh"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "| /bin/bash") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | /bin/bash"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "$(") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: $("));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "${") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: ${"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/tcp") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: /dev/tcp"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "mkfifo") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: mkfifo"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "`") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: backtick"));
        n = n + 1;
    }
    return n;
}

# ---- Main entry points ---------------------------------------------------

# Returns a vec of GuardViolation pointers (empty = safe).
fn check_command(command, config) {
    var violations = vec_new();
    var n = strlen(command);
    var lower = alloc(n + 1);
    str_to_lower_into(command, lower);

    if (RuntimeGuardConfig_enforce_command_blocklist(config) == 1) {
        var base = _base_command(command);
        if (_is_blocked_command(base) == 1) {
            var msg_len = strlen(base) + 18;
            var msg = alloc(msg_len + 1);
            memcpy(msg, "blocked command: ", 17);
            memcpy(msg + 17, base, strlen(base));
            store8(msg + 17 + strlen(base), 0);
            vec_push(violations, guard_violation_new(ViolationType.BLOCKED_COMMAND, msg));
        }
    }

    if (RuntimeGuardConfig_block_sensitive_paths(config) == 1) {
        _check_sensitive_paths(lower, violations);
    }

    _check_shell_meta(lower, violations);
    return violations;
}

# Returns GuardViolation ptr if fork bomb detected, 0 otherwise.
fn check_fork_bomb(current_pids, config) {
    if (current_pids > RuntimeGuardConfig_max_pids(config)) {
        return guard_violation_new(ViolationType.FORK_BOMB, "process count exceeds limit");
    }
    return 0;
}

# Returns GuardViolation ptr if duration is anomalous, 0 otherwise.
# multiplier_x100 = 200 means "2.0x expected".
fn check_time_anomaly(duration_ms, expected_ms, config) {
    var threshold = expected_ms * RuntimeGuardConfig_time_anomaly_multiplier_x100(config) / 100;
    if (duration_ms > threshold) {
        return guard_violation_new(ViolationType.TIME_ANOMALY, "execution duration anomalous");
    }
    return 0;
}

# ---- Sandbox integrity monitoring ---------------------------------------
# Ported from rust-old/src/scanning/runtime.rs check_integrity(). Reads
# /proc to verify the current process is in a separate PID, mount, and
# user namespace from the host. Used by callers that want to assert
# isolation is actually in effect before proceeding with sensitive work.

#derive(accessors)
struct IntegrityCheck {
    name;
    passed;
    detail;
}

fn _integrity_check_new(name, passed, detail) {
    var c = alloc(24);
    IntegrityCheck_set_name(c, name);
    IntegrityCheck_set_passed(c, passed);
    IntegrityCheck_set_detail(c, detail);
    return c;
}

#derive(accessors)
struct IntegrityReport {
    intact;
    checks;
    checked_at;
}

fn runtime_integrity_report_new() {
    var r = alloc(24);
    IntegrityReport_set_intact(r, 0);
    IntegrityReport_set_checks(r, vec_new());
    IntegrityReport_set_checked_at(r, 0);
    return r;
}

# PID namespace check: /proc/1/cmdline should not contain 'systemd' or
# 'init'. If the read fails (e.g. /proc masked), assume isolated — the
# caller can't see host state anyway.
fn _integrity_check_pid_ns() {
    var buf = alloc(512);
    # Read at most size-1 so the NUL terminator below always lands inside the
    # allocation — file_read_all can fill the whole buffer otherwise, making
    # store8(buf + n, 0) a one-byte heap overflow (matches cgroup_supported).
    var n = file_read_all("/proc/1/cmdline", buf, 511);
    if (n <= 0) {
        return _integrity_check_new("pid_namespace", 1, "proc not readable (assume isolated)");
    }
    store8(buf + n, 0);
    if (cstr_contains(buf, "systemd") == 1) {
        return _integrity_check_new("pid_namespace", 0, "host systemd visible as PID 1");
    }
    if (cstr_contains(buf, "/init") == 1) {
        return _integrity_check_new("pid_namespace", 0, "host init visible as PID 1");
    }
    return _integrity_check_new("pid_namespace", 1, "PID namespace isolated");
}

# Mount namespace check: /proc/mounts should not expose host /home
# unless overlay-mounted (containers commonly overlay user dirs).
fn _integrity_check_mount_ns() {
    var buf = alloc(8192);
    # size-1 read limit — see _integrity_check_pid_ns for the rationale.
    var n = file_read_all("/proc/mounts", buf, 8191);
    if (n <= 0) {
        return _integrity_check_new("mount_namespace", 1, "/proc/mounts not readable");
    }
    store8(buf + n, 0);
    if (cstr_contains(buf, "/home/") == 1) {
        if (cstr_contains(buf, "overlay") == 0) {
            return _integrity_check_new("mount_namespace", 0, "host /home visible");
        }
    }
    return _integrity_check_new("mount_namespace", 1, "mount namespace isolated");
}

# User namespace check: /proc/self/uid_map should be non-empty when a
# user namespace is in effect.
fn _integrity_check_user_ns() {
    var buf = alloc(256);
    # size-1 read limit — see _integrity_check_pid_ns for the rationale.
    var n = file_read_all("/proc/self/uid_map", buf, 255);
    if (n <= 0) {
        return _integrity_check_new("user_namespace", 0, "no UID mapping");
    }
    store8(buf + n, 0);
    if (n < 4) {
        return _integrity_check_new("user_namespace", 0, "UID map suspiciously small");
    }
    return _integrity_check_new("user_namespace", 1, "user namespace active");
}

fn check_integrity() {
    var report = runtime_integrity_report_new();
    IntegrityReport_set_checked_at(report, clock_epoch_secs());
    var checks = IntegrityReport_checks(report);

    var c1 = _integrity_check_pid_ns();
    var c2 = _integrity_check_mount_ns();
    var c3 = _integrity_check_user_ns();
    vec_push(checks, c1);
    vec_push(checks, c2);
    vec_push(checks, c3);

    var intact = 1;
    if (IntegrityCheck_passed(c1) == 0) { intact = 0; }
    if (IntegrityCheck_passed(c2) == 0) { intact = 0; }
    if (IntegrityCheck_passed(c3) == 0) { intact = 0; }
    IntegrityReport_set_intact(report, intact);
    return report;
}

# --- cgroup.cyr ---

# kavach — cgroups v2 resource limits
#
# Wires SandboxPolicy.{memory_limit_mb,cpu_limit_tenths,max_pids} into a
# per-sandbox cgroup under /sys/fs/cgroup/kavach-<id>/.
#
# Placement model: cgroups are created as direct children of the cgroup-v2
# root. That avoids the "no internal processes" rule (root cgroup is the
# only one allowed to host both processes AND child cgroups; non-root
# non-leaf cgroups can't host processes). Requires that the running
# system has cgroup v2 mounted at /sys/fs/cgroup (the unified hierarchy
# default on modern systemd) and that the desired controllers (memory,
# cpu, pids) are enabled in the root's cgroup.subtree_control.
#
# PID assignment uses the "shell-prepend" pattern — the user command is
# wrapped in `sh -c 'echo $$ > /sys/fs/cgroup/<scope>/cgroup.procs;
# exec <cmd>'`. The shell writes its own PID into the cgroup, then
# exec()s the user command, which inherits the cgroup placement. The
# window between fork and the write is bounded by sh's startup (a few
# syscalls); no userspace work runs in the unrestricted cgroup. This is
# the standard Linux-container-runtime pattern for unprivileged
# placement without a custom fork+pre_exec helper.
#
# Graceful degradation: if /sys/fs/cgroup isn't writable (read-only
# mount, missing controllers, unprivileged container, non-Linux), every
# entry point returns 0 / no-op and cgroup_supported() returns 0 so
# callers can decline to wrap.

var CGROUP_ROOT = "/sys/fs/cgroup";

# Whole-token match in a whitespace-separated list. cgroup.subtree_control
# is a space-separated controller list ("cpuset cpu io memory pids"), so a
# naive substring check for "cpu" spuriously matches "cpuset" — reporting the
# cpu controller present when only cpuset is. Require the token to be bounded
# by start-of-string/whitespace on both sides.
fn _cgroup_has_controller(list, name) {
    var llen = strlen(list);
    var nlen = strlen(name);
    var i = 0;
    while (i + nlen <= llen) {
        var ok = 1;
        if (i > 0) {
            var pc = load8(list + i - 1);
            if (pc != 32) { if (pc != 10) { if (pc != 9) { ok = 0; } } }
        }
        if (ok == 1) {
            var j = 0;
            while (j < nlen) {
                if (load8(list + i + j) != load8(name + j)) { ok = 0; break; }
                j = j + 1;
            }
            if (ok == 1) {
                var after = i + nlen;
                if (after < llen) {
                    var ac = load8(list + after);
                    if (ac != 32) { if (ac != 10) { if (ac != 9) { ok = 0; } } }
                }
                if (ok == 1) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Check whether cgroup v2 is mounted and writable. Returns 1 if the root
# is writable AND the memory + cpu + pids controllers are enabled in the
# root's cgroup.subtree_control (so child cgroups can use them).
fn cgroup_supported() {
    if (sys_access(CGROUP_ROOT, 2) < 0) { return 0; }
    var buf = alloc(512);
    var n = file_read_all("/sys/fs/cgroup/cgroup.subtree_control", buf, 511);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    if (_cgroup_has_controller(buf, "memory") == 0) { return 0; }
    if (_cgroup_has_controller(buf, "cpu") == 0) { return 0; }
    if (_cgroup_has_controller(buf, "pids") == 0) { return 0; }
    return 1;
}

# Build the cgroup path for a sandbox id (a random u64). Returns a freshly
# allocated cstr the caller owns.
fn _cgroup_path(scope_id) {
    var prefix = "/sys/fs/cgroup/kavach-";
    var prefix_len = strlen(prefix);
    var id_buf[24];
    var id_len = fmt_int_buf(scope_id, &id_buf);
    var out = alloc(prefix_len + id_len + 1);
    memcpy(out, prefix, prefix_len);
    memcpy(out + prefix_len, &id_buf, id_len);
    store8(out + prefix_len + id_len, 0);
    return out;
}

# Build a child file path under a cgroup directory. Caller owns return.
fn _cgroup_file(cgroup_path, name) {
    var clen = strlen(cgroup_path);
    var nlen = strlen(name);
    var out = alloc(clen + 1 + nlen + 1);
    memcpy(out, cgroup_path, clen);
    store8(out + clen, 47);
    memcpy(out + clen + 1, name, nlen);
    store8(out + clen + 1 + nlen, 0);
    return out;
}

# Write a numeric value to a cgroup controller file (e.g. memory.max).
# Returns 0 on success, -1 on failure (gracefully ignored by caller).
fn _cgroup_write_int(cgroup_path, name, value) {
    var fpath = _cgroup_file(cgroup_path, name);
    var buf[32];
    var len = fmt_int_buf(value, &buf);
    var r = file_write_all(fpath, &buf, len);
    if (r < 0) { return 0 - 1; }
    return 0;
}

# Write a literal string to a cgroup controller file. Used for cpu.max
# which takes "<quota_us> <period_us>" rather than a bare integer.
fn _cgroup_write_str(cgroup_path, name, value) {
    var fpath = _cgroup_file(cgroup_path, name);
    var r = file_write_all(fpath, value, strlen(value));
    if (r < 0) { return 0 - 1; }
    return 0;
}

# Build the cpu.max content for a tenths value (10 = 1.0 cores, 25 = 2.5 cores).
# cgroup v2 cpu.max takes "<quota_us> <period_us>"; we use a 100ms period and
# scale the quota accordingly: 1.0 cores = "100000 100000", 2.5 = "250000 100000".
# Returns a freshly-allocated cstr.
fn _cpu_max_string(tenths) {
    var period_us = 100000;
    var quota_us = (period_us * tenths) / 10;
    var qbuf[24];
    var qlen = fmt_int_buf(quota_us, &qbuf);
    var pbuf[24];
    var plen = fmt_int_buf(period_us, &pbuf);
    var out = alloc(qlen + 1 + plen + 1);
    memcpy(out, &qbuf, qlen);
    store8(out + qlen, 32);
    memcpy(out + qlen + 1, &pbuf, plen);
    store8(out + qlen + 1 + plen, 0);
    return out;
}

# Create the per-sandbox cgroup directory and write the limit files from
# policy. Returns the cgroup_path cstr on success, 0 on any failure
# (caller should fall back to running without cgroups).
#
# Honors: memory_limit_mb (memory.max in bytes), cpu_limit_tenths
# (cpu.max as "<quota> <period>"), max_pids (pids.max).
fn cgroup_setup(policy) {
    if (cgroup_supported() == 0) { return 0; }
    var scope = rand_u64();
    if (scope < 0) { scope = 0 - scope; }
    var path = _cgroup_path(scope);
    # sys_mkdir mode is ignored by cgroupfs (it owns the dir mode), but
    # passing 0700 keeps the intent visible.
    if (sys_mkdir(path, 448) < 0) { return 0; }

    var mem_mb = SandboxPolicy_memory_limit_mb(policy);
    if (mem_mb > 0) {
        _cgroup_write_int(path, "memory.max", mem_mb * 1048576);
    }
    var cpu_t = SandboxPolicy_cpu_limit_tenths(policy);
    if (cpu_t > 0) {
        var cpu_max = _cpu_max_string(cpu_t);
        _cgroup_write_str(path, "cpu.max", cpu_max);
    }
    var pids = SandboxPolicy_max_pids(policy);
    if (pids > 0) {
        _cgroup_write_int(path, "pids.max", pids);
    }
    return path;
}

# Tear down a cgroup created by cgroup_setup. Safe to call with 0 (no-op).
# The kernel rmdirs the cgroup only when no processes remain in it; after
# the wrapped command exits, kavach's wait() returns and the cgroup is
# empty.
fn cgroup_teardown(cgroup_path) {
    if (cgroup_path == 0) { return 0; }
    kv_rmdir(cgroup_path);
    return 0;
}

# Return 1 if `policy` has any cgroup-controlled limit set (memory, cpu,
# or pids). Backends use this to decide whether to apply the wrapping at
# all — no limits = no wrapping = no shell dependency.
fn cgroup_policy_has_limits(policy) {
    if (SandboxPolicy_memory_limit_mb(policy) > 0) { return 1; }
    if (SandboxPolicy_cpu_limit_tenths(policy) > 0) { return 1; }
    if (SandboxPolicy_max_pids(policy) > 0) { return 1; }
    return 0;
}

# Build the cgroup-join "-c" body string for the sh wrapper.
# Shape: `echo $$ > <cgroup_path>/cgroup.procs; exec "$@"`
#
# The `exec "$@"` pattern passes the user argv through positionally —
# sh does NOT re-interpret quotes / variables / metachars in the user
# command, only the literal `echo $$` line and the `exec "$@"` directive
# are under shell control. This preserves the no-shell-interpretation
# guarantee that direct execve would give, while still letting us write
# the shell's own PID into cgroup.procs before it execs the user command.
fn _cgroup_sh_body(cgroup_path) {
    var head = "echo $$ > ";
    var tail = "/cgroup.procs; exec \"$@\"";
    var hl = strlen(head);
    var cp = strlen(cgroup_path);
    var tl = strlen(tail);
    var out = alloc(hl + cp + tl + 1);
    var pos = 0;
    memcpy(out + pos, head, hl); pos = pos + hl;
    memcpy(out + pos, cgroup_path, cp); pos = pos + cp;
    memcpy(out + pos, tail, tl); pos = pos + tl;
    store8(out + pos, 0);
    return out;
}

# Wrap a user argv vec with the cgroup-join shell prelude, returning a
# new argv vec. The resulting argv shape is:
#
#   ["sh", "-c", "echo $$ > <cgroup_path>/cgroup.procs; exec \"$@\"",
#    "--", <user argv...>]
#
# `--` separates sh's own positional args ($0 = "--", $1.. = user argv).
# Per `man sh`, $0 receives whatever follows "-c <body>", so the first
# positional arg goes into $0 — passing "--" there is the standard way
# to skip the slot.
#
# The returned vec is freshly allocated; the user_argv vec is not consumed
# (callers can free / reuse it).
fn cgroup_wrap_argv(cgroup_path, user_argv) {
    var out = vec_new();
    vec_push(out, "sh");
    vec_push(out, "-c");
    vec_push(out, _cgroup_sh_body(cgroup_path));
    vec_push(out, "--");
    var i = 0;
    while (i < vec_len(user_argv)) {
        vec_push(out, vec_get(user_argv, i));
        i = i + 1;
    }
    return out;
}

# --- confine.cyr ---

# confine.cyr — the child-side confinement sequence, shared by every backend
# that forks (3.9.1).
#
# Extracted from spawn.cyr so the BLOCKING exec path can use it too:
# `backend_process.cyr` is included before `spawn.cyr` (spawn needs its
# `_split_command`), so it cannot reach into spawn — and without this split only
# detached containers would enter their rootfs, which would be a stranger bug
# than the one being fixed.
#
# Everything here runs in the CHILD, after fork and before execve.

# Highest fd we scan when clearing inherited descriptors. close_range(2) would
# be tidier but is not in the frozen syscall surface this module may use.
var SPAWN_MAX_FD = 1024;

# O_WRONLY|O_CREAT|O_APPEND, mode 0644. Append rather than truncate: a restarted
# container should extend its log, not silently erase the evidence of why the
# previous attempt died.
var SPAWN_LOG_FLAGS = 1089;
var SPAWN_LOG_MODE = 420;

# Child exit codes for a confinement step that could not be applied. The child
# _exits rather than execing, so the payload never runs less confined than the
# policy promised — and the specific code says which primitive was missing.
enum SpawnExit {
    SPAWN_EXIT_STDIO = 120;
    SPAWN_EXIT_CGROUP = 121;
    SPAWN_EXIT_NNP = 122;
    SPAWN_EXIT_NS = 123;
    SPAWN_EXIT_LANDLOCK = 124;
    SPAWN_EXIT_SECCOMP = 125;
    SPAWN_EXIT_ROOTFS = 119;
    SPAWN_EXIT_IDMAP = 118;
    SPAWN_EXIT_WORKDIR = 117;
}

# Namespace flags implied by the policy.
#
# `network_enabled == 0` asks for a private network namespace. Note this reads a
# field that `policy_new` zero-fills, so the DEFAULT policy requests network
# isolation — that is the intended default for a sandbox, and the exec path's
# failure to act on it is a gap there, not a licence to ignore it here.
#
# Unprivileged `unshare(CLONE_NEWNET)` is EPERM: an unprivileged process may
# only create a network namespace as part of a NEW USER namespace, which is
# exactly how rootless containers get one. So when we are not root we pair
# NS_USER with it. Running as root, the user namespace is unnecessary and adds a
# uid-mapping step nothing here needs, so it is omitted.
#[must_use]
fn _spawn_ns_flags(policy, rootfs) {
    var f = 0;
    if (policy != 0) {
        if (SandboxPolicy_network_enabled(policy) == 0) { f = f | NS_NETWORK; }
    }
    # Entering a rootfs needs a mount namespace of our own, or making `/`
    # private and chrooting would affect the host.
    if (rootfs != 0) { f = f | NS_MOUNT; }
    if (f == 0) { return 0; }
    # Unprivileged, neither a network nor a mount namespace is obtainable on its
    # own — both require being in a NEW USER namespace, which is how rootless
    # containers get them. As root the user namespace is unnecessary.
    if (sys_getuid() != 0) { f = f | NS_USER; }
    return f;
}

# mount(2) flags used to detach our mount namespace from the host's.
var MS_REC_PRIVATE = 278528;        # MS_REC (0x4000) | MS_PRIVATE (0x40000)

# Map our uid/gid to root INSIDE the new user namespace.
#
# Without this every file in the rootfs is owned by `nobody` from the payload's
# point of view, and anything needing uid 0 (most container images) fails in a
# way that looks like a corrupt image rather than a missing mapping.
# `setgroups=deny` first is mandatory for an unprivileged writer of gid_map —
# the kernel refuses the gid_map otherwise.
fn _spawn_write_idmaps(uid, gid) {
    file_write_all("/proc/self/setgroups", "deny", 4);
    var ub[64];
    var un = fmt_int_buf(0, &ub);
    store8(&ub + un, 32);
    un = un + 1 + fmt_int_buf(uid, &ub + un + 1);
    store8(&ub + un, 32);
    store8(&ub + un + 1, 49);                       # '1'
    if (file_write_all("/proc/self/uid_map", &ub, un + 2) < 0) { return 0 - 1; }
    var gb[64];
    var gn = fmt_int_buf(0, &gb);
    store8(&gb + gn, 32);
    gn = gn + 1 + fmt_int_buf(gid, &gb + gn + 1);
    store8(&gb + gn, 32);
    store8(&gb + gn + 1, 49);
    if (file_write_all("/proc/self/gid_map", &gb, gn + 2) < 0) { return 0 - 1; }
    return 0;
}

# Enter `rootfs` — the step whose absence made every container before 3.9.1 run
# host binaries.
#
# Requires a mount namespace already unshared (the caller does that with
# NS_MOUNT), or the private-mount call below would alter the HOST's propagation.
#
# Uses chroot(2), not pivot_root(2). chroot is escapable by a process that holds
# CAP_SYS_CHROOT *and* a directory fd outside the new root — which is exactly why
# the caller closes inherited descriptors first, and why the payload is left with
# no capability to re-chroot. pivot_root is the stronger primitive and wants the
# rootfs to be a mount point of its own; recorded as the next increment in the
# 3.9.1 CHANGELOG entry ("pivot_root is the stronger primitive and is the next
# increment"), because it is a behaviour change rather than a silent upgrade.
fn _spawn_enter_rootfs(rootfs) {
    if (rootfs == 0) { return 0; }
    # ⛔ LINUX ONLY, AND IT MUST FAIL CLOSED ELSEWHERE. This is mount-namespace + chroot
    # confinement: agnos has no mount namespaces, no `chroot`, and no `chdir` syscall — `sys_mount`
    # is a 0-argument stub there and `SYS_CHDIR` is not in the enum at all, so this function did not
    # even COMPILE for `--agnos`, taking every consumer of `[deps.kavach]` down with it.
    # ⚠ The agnos arm returns -1, NOT 0. Returning 0 would report "the payload is confined to
    # `rootfs`" on a platform where nothing of the sort happened — a sandbox that silently is not
    # one. A caller that cannot confine must be told it cannot confine.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Detach propagation, or our mounts (and the chroot) leak to the host.
    if (sys_mount(0, "/", 0, MS_REC_PRIVATE, 0) < 0) { return 0 - 1; }
    if (syscall(SYS_CHROOT_NR, rootfs) < 0) { return 0 - 1; }
    # chroot does NOT move cwd; leaving it outside the new root is itself an
    # escape route.
    if (syscall(SYS_CHDIR, "/") < 0) { return 0 - 1; }
    return 0;
    #endif
}

# 3.12.2: chdir into the payload's configured working directory.
#
# ⚠ MUST run AFTER `_spawn_enter_rootfs`, or the path resolves against the HOST
# filesystem — a `workdir` of `/app` would land in the host's `/app` and the
# payload would run outside the container with no error. `_spawn_enter_rootfs`
# already `chdir("/")`s after chroot, so this refines a cwd that is already
# inside the root rather than establishing one.
#
# ⚠ FAILS CLOSED. A workdir the caller asked for and did not get is a silently
# wrong environment — the payload runs somewhere it was not told to. runc errors
# out in the same situation, and so does this: the child `_exit`s with
# SPAWN_EXIT_WORKDIR rather than falling through to execve from the wrong
# directory. `workdir == 0` (the default) is not a request and returns 0.
fn _spawn_enter_workdir(workdir) {
    if (workdir == 0) { return 0; }
    if (strlen(workdir) == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no chdir syscall — see _spawn_enter_rootfs. A caller that asked
    # for a workdir must be told it did not get one.
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (syscall(SYS_CHDIR, workdir) < 0) { return 0 - 1; }
    return 0;
    #endif
}

# Close every descriptor from `from` up to SPAWN_MAX_FD. Errors are expected
# and ignored — most of the range is simply not open.
fn _spawn_close_inherited(from) {
    var fd = from;
    while (fd < SPAWN_MAX_FD) {
        sys_close(fd);
        fd = fd + 1;
    }
    return 0;
}

# Put the CALLING process into `cgroup_path`. Returns 0 on success, -1 on
# failure. Called in the child, so "the calling process" is the payload.
fn _spawn_cgroup_join(cgroup_path) {
    if (cgroup_path == 0) { return 0; }
    var fpath = _cgroup_file(cgroup_path, "cgroup.procs");
    var buf[32];
    var len = fmt_int_buf(sys_getpid(), &buf);
    if (file_write_all(fpath, &buf, len) < 0) { return 0 - 1; }
    return 0;
}

# Redirect stdio for the detached child: stdin from /dev/null, stdout+stderr to
# `log_path` (or /dev/null when none was given). Returns 0 / -1.
fn _spawn_redirect_stdio(log_path) {
    var devnull = sys_open("/dev/null", 0, 0);          # O_RDONLY
    if (devnull < 0) { return 0 - 1; }
    kv_dup2(devnull, 0);
    sys_close(devnull);

    var out = 0 - 1;
    if (log_path != 0) {
        out = sys_open(log_path, SPAWN_LOG_FLAGS, SPAWN_LOG_MODE);
    }
    if (out < 0) {
        out = sys_open("/dev/null", 1, 0);              # O_WRONLY
        if (out < 0) { return 0 - 1; }
    }
    kv_dup2(out, 1);
    kv_dup2(out, 2);
    if (out > 2) { sys_close(out); }
    return 0;
}

# Apply the whole confinement sequence in the child. Returns 0, or does not
# return (each step _exits with its own code so a caller can tell which
# primitive was unavailable).
#
# Order is security-relevant and is the reason this is one function rather than
# a checklist each backend re-implements:
#   fds -> cgroup -> NO_NEW_PRIVS -> namespaces (+idmap) -> rootfs -> landlock
#   -> seccomp
# seccomp is last because it denies mount/chroot/unshare; rootfs entry precedes
# landlock because landlock path rules resolve against the current root.
# `want_ns` (3.11.3) — whether to create namespaces as the policy requests.
#
# **1 for every caller that predates 3.11.3, and their behaviour is unchanged.**
# `sandbox_spawn` in particular has a fail-closed namespace contract with a test
# to match: a policy asking for network isolation on a host that denies
# unprivileged user namespaces must exit 123/118 rather than run the payload
# less isolated than promised.
#
# 0 for exactly one caller: the rootfs-less capture that 3.11.3 added so
# `seccomp_enabled` would stop being ignored. That path previously applied
# **nothing at all**, so seccomp + landlock is a strict gain — but making
# unprivileged namespace creation a *precondition* for it would turn payloads
# that used to run into payloads that do not run, on any host restricting user
# namespaces (Ubuntu 24.04 does). It claims no network isolation it did not get;
# a caller wanting that guarantee uses a rootfs-bearing sandbox or
# `sandbox_spawn`, both of which still fail closed.
fn confine_child(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns) {
    return confine_child_wd(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, 0);
}

# 3.12.2: the same sequence with the payload's working directory. `workdir == 0`
# is the pre-3.12.2 behaviour (cwd `/` inside the rootfs), so the wrapper above
# is unchanged for every existing caller — the same discipline `confine_capture`
# follows for `input` and `confine_capture_input_env` for `env`.
fn confine_child_wd(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, workdir) {
    # ⛔ THE WHOLE SEQUENCE IS LINUX-SPECIFIC and none of it exists on agnos: no cgroups, no
    # `prctl`, no namespaces, no landlock, no seccomp. `SYS_PRCTL` is not even in the agnos syscall
    # enum, so this function failed to COMPILE for `--agnos` and took every consumer of
    # `[deps.kavach]` with it — including consumers that never sandbox anything.
    # ⚠ FAIL CLOSED, and loudly. Returning 0 here would tell a caller "the child is confined" on a
    # platform where not one primitive ran — a sandbox that is silently not a sandbox, which is the
    # worst failure mode this file has. agnos sandboxing goes through backend_sy_agnos, not here.
    #ifdef CYRIUS_TARGET_AGNOS
    sys_exit(SPAWN_EXIT_NNP);
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    _spawn_close_inherited(3);
    if (_spawn_cgroup_join(cgroup_path) != 0) { sys_exit(SPAWN_EXIT_CGROUP); }
    if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }

    # `want_ns` is 0 only for the capture path added in 3.11.3 — see the note
    # on `confine_child`'s signature.
    var nsf = 0;
    if (want_ns != 0) { nsf = _spawn_ns_flags(policy, rootfs); }
    if (nsf != 0) {
        if (is_ok(security_create_namespace(nsf)) == 0) { sys_exit(SPAWN_EXIT_NS); }
        if ((nsf & NS_USER) != 0) {
            # Its OWN code. Creating the namespace and mapping ids into it are
            # different privileges that fail on different hosts — a CI runner
            # already inside a restricted user namespace creates one happily and
            # then cannot write uid_map. Sharing SPAWN_EXIT_NS between them made
            # the two indistinguishable, which is exactly the opacity the
            # per-step codes exist to remove.
            if (_spawn_write_idmaps(uid, gid) != 0) { sys_exit(SPAWN_EXIT_IDMAP); }
        }
    }
    if (_spawn_enter_rootfs(rootfs) != 0) { sys_exit(SPAWN_EXIT_ROOTFS); }
    # After the chroot, so the path resolves inside the container. See the fn's header.
    if (_spawn_enter_workdir(workdir) != 0) { sys_exit(SPAWN_EXIT_WORKDIR); }

    if (policy != 0) {
        if (SandboxPolicy_landlock_rules_len(policy) > 0) {
            # 3.11.3: the policy's ACTUAL rules, where this passed `(0, 0)` —
            # a null list with a zero count, which `security_apply_landlock`
            # answers `Ok(0)` to immediately. The count was checked, the rules
            # were never sent, and no ruleset was ever installed.
            #
            # A `deny_all` policy carries a count with an empty list on purpose:
            # a ruleset with no path-beneath rules permits nothing, so the count
            # is passed rather than the list length.
            var _ll = SandboxPolicy_landlock_rules(policy);
            if (_ll == 0) { _ll = vec_new(); }
            if (is_ok(security_apply_landlock(_ll,
                  SandboxPolicy_landlock_rules_len(policy))) == 0) {
                sys_exit(SPAWN_EXIT_LANDLOCK);
            }
        }
    }
    if (seccomp_info != 0) {
        if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(seccomp_info),
              security_seccomp_filter_len(seccomp_info))) == 0) {
            sys_exit(SPAWN_EXIT_SECCOMP);
        }
    }
    return 0;
    #endif
}

# Human-readable name for a confinement exit code, or 0 when `code` is not one.
#
# The child _exits with a distinct code per failed primitive, which is precise
# but opaque at the call site: "the container exited 123" says nothing, and a
# caller staring at that has no way to know the host simply cannot create user
# namespaces. Callers should run a non-zero exit through this before reporting.
#[must_use]
fn spawn_exit_name(code) {
    if (code == SPAWN_EXIT_STDIO) { return "cannot redirect stdio"; }
    if (code == SPAWN_EXIT_CGROUP) { return "cannot join cgroup"; }
    if (code == SPAWN_EXIT_NNP) { return "cannot set no_new_privs"; }
    if (code == SPAWN_EXIT_NS) {
        return "cannot create namespaces (unprivileged user namespaces may be disabled on this host)";
    }
    if (code == SPAWN_EXIT_LANDLOCK) { return "cannot apply landlock"; }
    if (code == SPAWN_EXIT_SECCOMP) { return "cannot load seccomp filter"; }
    if (code == SPAWN_EXIT_ROOTFS) { return "cannot enter rootfs"; }
    if (code == SPAWN_EXIT_IDMAP) {
        return "cannot write uid_map/gid_map (already inside a restricted user namespace?)";
    }
    # 0 is the contract, not an oversight: "this is not a confinement code",
    # which `test_spawn_exit_name` asserts for a normal exit and for 127.
    # Callers must not hand it straight to a string function — see the guard in
    # `test_spawn_namespaces_environment_aware`, where an unexpected code would
    # otherwise turn a failed assertion into a SIGSEGV.
    return 0;
}

# 1 when this host can actually create the namespaces `flags` asks for.
#
# Probes in a FORKED CHILD, because unshare(2) mutates the caller — there is no
# way to ask "would this work?" without doing it. Hosts with
# `kernel.unprivileged_userns_clone=0`, some hardened distros, and many CI
# containers deny unprivileged user namespaces outright, and a caller wanting to
# degrade gracefully (or a test wanting to skip) needs to know that up front
# rather than decoding a child exit code afterwards.
#[must_use]
fn spawn_namespaces_available(flags) {
    # ⛔ LINUX ONLY. This PROBES namespace availability by forking a child; agnos has no fork,
    # no namespaces, and no uid_map. ⚠ Answering 0 ("unavailable") is the honest and SAFE answer —
    # a caller that believes namespaces exist would build a policy it cannot enforce.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    if (flags == 0) { return 1; }
    # Read the ids BEFORE the fork. Inside a fresh user namespace getuid()
    # reports the UNMAPPED id (nobody), and a uid_map written against that is
    # rejected — the probe would then report "unavailable" on a host that works
    # perfectly. sandbox_spawn reads them in the parent for the same reason.
    var probe_uid = sys_getuid();
    var probe_gid = kv_getgid();
    var pid = kv_fork();
    if (pid < 0) { return 0; }
    if (pid == 0) {
        if (is_ok(security_create_namespace(flags)) == 0) { sys_exit(1); }
        # Creating the namespace is only half of it — mapping ids into it is a
        # separate privilege, and a host can grant the first and refuse the
        # second. Probing only the first reports "available" for a spawn that
        # will still die.
        if ((flags & NS_USER) != 0) {
            if (_spawn_write_idmaps(probe_uid, probe_gid) != 0) { sys_exit(1); }
        }
        sys_exit(0);
    }
    var st[4];
    store32(&st, 0);
    kv_waitpid(pid, &st, 0);
    var status = load32(&st);
    if ((status & 127) != 0) { return 0; }
    if (((status >> 8) & 255) != 0) { return 0; }
    return 1;
}

# 1 when this host will actually load a seccomp filter.
#
# Same shape and same reason as spawn_namespaces_available: the filter is loaded
# in the CHILD, so a host that refuses it turns every spawn into an opaque
# `SPAWN_EXIT_SECCOMP`. Probes in a fork because loading a filter is
# irreversible for the calling process.
#[must_use]
fn spawn_seccomp_available() {
    # ⛔ LINUX ONLY — forks a child to test-load a seccomp filter. agnos has neither.
    # ⚠ 0 = "no seccomp here", which is true, and which keeps callers from promising a filter.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    var res = security_create_exec_seccomp_filter();
    if (is_ok(res) == 0) { return 0; }
    var info = result_unwrap(res);
    var pid = kv_fork();
    if (pid < 0) { return 0; }
    if (pid == 0) {
        if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(info),
              security_seccomp_filter_len(info))) == 0) {
            sys_exit(1);
        }
        sys_exit(0);
    }
    var st[4];
    store32(&st, 0);
    kv_waitpid(pid, &st, 0);
    var status = load32(&st);
    if ((status & 127) != 0) { return 0; }
    if (((status >> 8) & 255) != 0) { return 0; }
    return 1;
}

# Fork, confine, exec, and capture stdout — the blocking counterpart of
# sandbox_spawn, used when the sandbox names a rootfs.
#
# The stdlib's `exec_capture` forks and execs on the HOST; it has no seam for a
# child-side confinement step, which is why a rootfs-bearing sandbox needs its
# own fork here rather than a flag passed down.
#
# Returns bytes captured, or -1.
# `timeout_ms` (3.11.4) — wall-clock budget, 0 for none. On expiry the payload
# is SIGKILLed and reaped, and `confine_last_timed_out()` reports it.
#
# **`SandboxConfig.timeout_ms` was accepted and ignored by every backend except
# WASM.** A config with a 1000 ms deadline ran `/bin/sleep 8` for 8001 ms and
# reported `timed_out = 0` — the bound was not enforced and the flag said it
# had been. `process_exec` now passes the config's deadline here.
#
# `do_confine` (3.11.4) — whether to run `confine_child` at all. 0 gives a plain
# fork/exec capture, which is what the non-confining path used to get from the
# stdlib's `exec_capture`. Routing it through here instead is what gives that
# path a real exit code and a deadline; `exec_capture` discards the wait status
# and has no seam for either.
fn confine_capture_input(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len) {
    return confine_capture_input_env(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, input, input_len, 0);
}

# 3.12.0: the same path with an explicit payload environment. `env == 0` is the
# empty envp every caller got before, so the wrapper above is unchanged
# behaviour — the same discipline `confine_capture` follows for `input`.
fn confine_capture_input_env(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env) {
    return confine_capture_input_env_wd(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, input, input_len, env, 0);
}

# 3.12.2: …and the payload's working directory. `workdir == 0` is unchanged
# behaviour, so the wrapper above covers every 3.12.0/3.12.1 caller.
#
# ⚠ The parameter list has grown to 14 by strict append-and-wrap, which has kept
# every release source-compatible but is at the end of its useful life. The next
# capability here should take a config struct instead of a 15th positional.
fn confine_capture_input_env_wd(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env, workdir) {
    # ⛔ LINUX ONLY — the fork/confine/execve/capture path. agnos has no fork by design and its
    # sandboxing goes through backend_sy_agnos, not this file.
    # ⚠ -1, never a fabricated success: a caller must not receive an empty capture buffer and
    # conclude the payload ran and printed nothing.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    # **The body is excluded from the agnos build, not merely unreachable on it.**
    # The `#ifdef` arm above returns before any of this runs, but a preprocessor
    # arm is not a compiler arm: the lines below are still compiled, and
    # `SYS_FCNTL` does not exist in the agnos syscall enum. That is a hard error
    # since cyrius made arity/undefined-symbol mismatches fatal, and because
    # `cyrius build` auto-prepends every `[deps.*]` module, it fails **any**
    # `--agnos` consumer that declares `[deps.kavach]` — including one that never
    # touches this backend. The non-blocking drain added in 3.11.5 is what
    # introduced the reference.
    #ifndef CYRIUS_TARGET_AGNOS
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    # Caller-supplied payload environment, or the empty envp when unset. Built
    # in the PARENT — alloc after fork is unsafe, same rule as the argv above.
    var envp = kv_envp_from_vec(env);

    # Read the ids in the PARENT — inside the new user namespace getuid()
    # reports the mapped id, not the one the map must be written against.
    var uid = sys_getuid();
    var gid = kv_getgid();

    var pipefd[16];
    sys_pipe(&pipefd);
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);
    # 3.11.5: a SECOND pipe, so the payload's stderr is its own stream. Until
    # then both fds went to one pipe and `backend_capture_finish` then set
    # `ExecResult.stderr` to "" — a field that always read empty, which is a
    # different and false claim from "the payload wrote nothing".
    var epipe[16];
    sys_pipe(&epipe);
    var erfd = load32(&epipe);
    var ewfd = load32(&epipe + 4);
    # 3.11.8: a THIRD pipe, for the payload's stdin — created ONLY when there is
    # something to send. Until then the child inherited the parent's fd 0, so a
    # backend could run a program but could not pass it arguments on stdin,
    # which is the whole contract of every WASM/CLI tool protocol. agnosai filed
    # it while porting `.agpkg`: "a WASM tool that cannot receive parameters is
    # not a port of this file".
    #
    # ⚠ `input == 0` keeps the INHERIT behaviour rather than handing the child an
    # empty stdin. Every pre-3.11.8 caller reaches here through `confine_capture`
    # with `input = 0`, and switching them to an immediate EOF would change what
    # an interactive payload sees.
    var in_rfd = 0 - 1;
    var in_wfd = 0 - 1;
    if (input != 0) {
        var inpipe[16];
        sys_pipe(&inpipe);
        in_rfd = load32(&inpipe);
        in_wfd = load32(&inpipe + 4);
    }
    var pid = kv_fork();
    if (pid < 0) {
        sys_close(rfd); sys_close(wfd); sys_close(erfd); sys_close(ewfd);
        if (in_rfd >= 0) { sys_close(in_rfd); sys_close(in_wfd); }
        return 0 - 1;
    }
    if (pid == 0) {
        sys_close(rfd);
        sys_close(erfd);
        if (in_rfd >= 0) {
            sys_close(in_wfd);
            kv_dup2(in_rfd, 0);
            sys_close(in_rfd);
        }
        kv_dup2(wfd, 1);
        kv_dup2(ewfd, 2);
        sys_close(wfd);
        sys_close(ewfd);
        # ⚠ workdir is passed as 0 here and applied BELOW instead, so it lands
        # whether or not the child is confined. A working directory is process
        # setup, not a confinement primitive — the same reasoning that makes
        # `envp` unconditional. Applying it inside `confine_child_wd` only would
        # mean an UNCONFINED capture silently ignored the caller's workdir, which
        # is the decorative-setter shape this release exists to remove.
        if (do_confine != 0) {
            confine_child_wd(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, 0);
        }
        # After confinement, so the path resolves inside the rootfs when there is one.
        if (_spawn_enter_workdir(workdir) != 0) { sys_exit(SPAWN_EXIT_WORKDIR); }
        kv_execve(vec_get(args, 0), argv, envp);
        # execve failed — 127 is the shell's "command not found", and it is
        # visible to the caller instead of being swallowed into a success.
        sys_exit(127);
    }
    sys_close(wfd);
    sys_close(ewfd);

    # Send the payload's stdin and close it, so a guest that reads to EOF makes
    # progress. ⚠ BEFORE the drain loop, and the close is what matters: a guest
    # blocked on a read that never ends would hit the deadline instead of
    # answering, and the failure would look like a timeout rather than a
    # protocol mistake.
    #
    # ⚠ A short write is not retried. Pipe capacity is 64 KiB by default and the
    # child is not reading yet, so an input larger than that would block here
    # while the child is still in `execve` — which is a deadlock, not a slow
    # write. Callers with a large payload should pass it by file instead; stated
    # rather than papered over with a partial write nobody checks.
    if (in_rfd >= 0) {
        sys_close(in_rfd);
        if (input_len > 0) { sys_write(in_wfd, input, input_len); }
        sys_close(in_wfd);
    }

    # **Both ends non-blocking and drained round-robin** (3.11.5). Draining one
    # to EOF and then the other deadlocks the moment the undrained pipe fills
    # (64 KiB): the payload blocks writing to it, so it never closes the first,
    # so the parent's read never finishes. The deadline needs the same
    # non-blocking reads, so the two requirements share one loop.
    syscall(SYS_FCNTL, rfd, 4, 2048);       # F_SETFL, O_NONBLOCK
    syscall(SYS_FCNTL, erfd, 4, 2048);

    var deadline = 0;
    if (timeout_ms > 0) { deadline = mono_now_ns() / 1000000 + timeout_ms; }

    var total = 0;
    var etotal = 0;
    var odone = 0;
    var edone = 0;
    var killed = 0;
    var idle = 0;
    while (odone == 0 || edone == 0) {
        var moved = 0;
        if (odone == 0) {
            var n = sys_read(rfd, buf + total, buflen - 1 - total);
            if (n == 0) { odone = 1; }
            if (n > 0) {
                total = total + n;
                moved = 1;
                if (total >= buflen - 1) { odone = 1; }
            }
        }
        if (edone == 0) {
            var m = sys_read(erfd, &_confine_err_buf + etotal, CONFINE_ERR_MAX - 1 - etotal);
            if (m == 0) { edone = 1; }
            if (m > 0) {
                etotal = etotal + m;
                moved = 1;
                if (etotal >= CONFINE_ERR_MAX - 1) { edone = 1; }
            }
        }
        if (moved == 0) {
            if (deadline > 0 && mono_now_ns() / 1000000 >= deadline) {
                # Kill FIRST: the payload's pipe ends must close, or the loop
                # would wait on an EOF that is never coming.
                sys_kill(pid, 9);
                killed = 1;
                odone = 1;
                edone = 1;
            } else {
                # An idle iteration still sleeps rather than spinning — a
                # non-blocking read that finds nothing returns at once, and
                # retrying it burns a core for as long as the payload runs.
                #
                # **But it backs off into that, rather than starting there
                # (3.11.7).** A flat `CONFINE_POLL_MS` charges every exec the
                # full interval before its first byte is even readable, and a
                # short payload is *entirely* that wait. Measured on
                # `/bin/echo hi` through the PROCESS backend: **11.96 ms at a
                # flat 5 ms against 4.78 ms at a flat 1 ms** — 2.5x, none of it
                # work. The regression arrived with this loop in 3.11.5 and
                # shipped through 3.11.6 because no benchmark execs anything;
                # `process_exec_echo` exists now so it cannot happen again.
                #
                # The ramp keeps both properties: a fast payload is noticed in
                # about a millisecond, and a slow one still converges to
                # `CONFINE_POLL_MS`, so the CPU argument above is unchanged for
                # exactly the case it was made about.
                idle = idle + 1;
                if (idle < CONFINE_POLL_RAMP) { kv_sleep_ms(1); }
                else { kv_sleep_ms(CONFINE_POLL_MS); }
            }
        }
    }
    sys_close(rfd);
    sys_close(erfd);
    store8(&_confine_err_buf + etotal, 0);
    _confine_err_len = etotal;
    _confine_last_timed_out = killed;

    var stbuf[4];
    store32(&stbuf, 0);
    kv_waitpid(pid, &stbuf, 0);
    var status = load32(&stbuf);
    var sig = status & 127;
    var code = 0;
    if (sig == 0) { code = (status >> 8) & 255; }
    else { code = 128 + sig; }
    _confine_last_exit = code;
    return total;
    #endif
}

# The pre-3.11.8 shape: capture with the child inheriting the parent's stdin.
# Every existing caller lands here, so none of them changed behaviour.
fn confine_capture(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen, want_ns,
  timeout_ms, do_confine) {
    return confine_capture_input(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, 0, 0);
}

# Exit code of the most recent confine_capture. The capture returns a byte
# count, and a caller that only looked at that would report success for a
# payload that never ran — which is exactly how the missing-rootfs bug stayed
# invisible.
var _confine_last_exit = 0;

# How often the drain loop looks again while a payload is running.
var CONFINE_POLL_MS = 5;

# Idle iterations spent at 1 ms before falling back to `CONFINE_POLL_MS`.
#
# 8 ms of fine-grained polling covers process startup, which is where a short
# payload's whole latency lives; past that the payload is genuinely working and
# 5 ms granularity costs it nothing. Set this to 0 to restore the flat interval
# 3.11.5 and 3.11.6 shipped.
var CONFINE_POLL_RAMP = 8;

# Ceiling on captured stderr. A payload cannot make the parent allocate without
# bound by writing diagnostics.
var CONFINE_ERR_MAX = 65536;
var _confine_err_buf[65536];
var _confine_err_len = 0;

# The payload's stderr from the most recent `confine_capture`, NUL-terminated.
#
# Its own stream since 3.11.5. Before that both fds went to one pipe and
# `ExecResult.stderr` was hardcoded to "" — so a caller that checked it was told
# the payload wrote nothing, which is a different claim from "we did not keep
# it".
#[must_use]
fn confine_last_stderr() { return &_confine_err_buf; }

#[must_use]
fn confine_last_stderr_len() { return _confine_err_len; }

# Whether the most recent `confine_capture` killed its payload on the deadline.
var _confine_last_timed_out = 0;

#[must_use]
fn confine_last_timed_out() { return _confine_last_timed_out; }

#[must_use]
fn confine_last_exit() { return _confine_last_exit; }

# --- backend_dispatch.cyr ---

# kavach — backend dispatch table
# Each backend registers function pointers for exec/health/destroy.
# Lookup is O(1) via Backend enum index.

# Slot layout (per backend, 32 bytes):
#   0: exec_fn(sandbox, command) -> ExecResult*
#   8: health_fn(sandbox) -> 1/0
#  16: destroy_fn(sandbox) -> 0 ok, nonzero err
#  24: reserved
var _backend_table[320];
var BACKEND_SLOT_SIZE = 32;

fn _backend_slot(backend_id) {
    return &_backend_table + backend_id * BACKEND_SLOT_SIZE;
}

# Bounds-checked fn-pointer fetch. `backend_id` flows from semi-trusted
# config (backend_parse can yield -1); an out-of-range id would otherwise
# index _backend_table[320] out of bounds and load a wild function pointer.
# Returns 0 (== "no implementation") for any id outside [0, KAVACH_BACKEND_COUNT).
fn _backend_fp(backend_id, offset) {
    if (backend_id < 0) { return 0; }
    if (backend_id >= KAVACH_BACKEND_COUNT) { return 0; }
    return load64(_backend_slot(backend_id) + offset);
}

fn backend_register_exec(backend_id, fp) {
    store64(_backend_slot(backend_id) + 0, fp);
    return 0;
}

fn backend_register_health(backend_id, fp) {
    store64(_backend_slot(backend_id) + 8, fp);
    return 0;
}

fn backend_register_destroy(backend_id, fp) {
    store64(_backend_slot(backend_id) + 16, fp);
    return 0;
}

# Dispatch entry points. Callers pass sandbox pointer (contains config).
# Returns 0 on missing implementation, after logging an error.
fn backend_dispatch_exec(sandbox, command) {
    var bid = SandboxConfig_backend(Sandbox_config(sandbox));
    var fp = _backend_fp(bid, 0);
    if (fp == 0) {
        kavach_err_print(KAVACH_ERR_BACKEND_UNAVAILABLE, os_backend_name(bid));
        return 0;
    }
    return fncall2(fp, sandbox, command);
}

fn backend_dispatch_health(sandbox) {
    var bid = SandboxConfig_backend(Sandbox_config(sandbox));
    var fp = _backend_fp(bid, 8);
    if (fp == 0) { return 0; }
    return fncall1(fp, sandbox);
}

fn backend_dispatch_destroy(sandbox) {
    var bid = SandboxConfig_backend(Sandbox_config(sandbox));
    var fp = _backend_fp(bid, 16);
    if (fp == 0) { return 0; }
    return fncall1(fp, sandbox);
}

fn backend_is_registered(backend_id) {
    if (_backend_fp(backend_id, 0) != 0) { return 1; }
    return 0;
}

# --- backend_noop.cyr ---

# kavach — Noop backend (no isolation, testing only)
# Matches Rust's NoopBackend: returns a clean ExecResult with exit_code=0.

fn noop_exec(sandbox, command) {
    var r = exec_result_new();
    ExecResult_set_exit_code(r, 0);
    ExecResult_set_stdout(r, "");
    ExecResult_set_stderr(r, "");
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

fn noop_health(sandbox) { return 1; }
fn noop_destroy(sandbox) { return 0; }

fn backend_noop_register() {
    backend_register_exec(KavachBackend.NOOP, &noop_exec);
    backend_register_health(KavachBackend.NOOP, &noop_health);
    backend_register_destroy(KavachBackend.NOOP, &noop_destroy);
    return 0;
}

# --- backend_process.cyr ---

# kavach — Process backend (minimum-viable fork+exec+wait via lib/process.cyr)
# Ported from rust-old/src/backend/process/mod.rs
#
# This is the v3.0 skeleton: fork+exec+wait + runtime-guard precheck.
# Seccomp/Landlock/cgroups/namespaces are separate modules that will hook
# into pre_exec once their syscall wrappers land.

var PROCESS_MAX_OUTPUT = 1048576;

# Whitespace-split command into a vec of cstrs. No quote handling —
# callers with quoted args should build the vec themselves and bypass.

fn process_exec(sandbox, command) {
    var start_ns = mono_now_ns();

    # Reject control chars before tokenizing. A NUL/CR/newline in `command`
    # would otherwise split into multiple argv tokens and smuggle extra
    # arguments past the runtime guard. Tab is allowed as a whitespace
    # separator; newline/CR/NUL/ESC are not. See ADR-005 §H3.
    if (is_safe_argument(command) == 0) {
        var er = exec_result_new();
        ExecResult_set_exit_code(er, 126);
        ExecResult_set_stderr(er, "command contains illegal control chars");
        return er;
    }

    # Runtime-guard precheck — policy-violating commands never hit fork.
    # 3.12.1: a rootfs'd sandbox is a container — its command resolves inside
    # the image, so the host-interpreter blocklist does not apply. See
    # `runtime_guard_config_for_rootfs`.
    var guard_cfg = runtime_guard_config_for_rootfs(
      SandboxConfig_rootfs(Sandbox_config(sandbox)));
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    var args = _split_command(command);
    if (vec_len(args) == 0) {
        return backend_error_result("empty command");
    }

    # Cgroup wrap: if the sandbox's policy carries any resource limit
    # (memory.max / cpu.max / pids.max), create a per-sandbox cgroup,
    # wrap the user argv in the cgroup-join sh prelude, and tear the
    # cgroup down after exec. Graceful fall-through when cgroup v2 is
    # unavailable: setup returns 0 and we run unwrapped.
    var cgroup_path = 0;
    var cfg = Sandbox_config(sandbox);
    if (cfg != 0) {
        var policy = SandboxConfig_policy(cfg);
        if (policy != 0) {
            if (cgroup_policy_has_limits(policy) == 1) {
                cgroup_path = cgroup_setup(policy);
                if (cgroup_path != 0) {
                    args = cgroup_wrap_argv(cgroup_path, args);
                }
            }
        }
    }

    var buf = alloc(PROCESS_MAX_OUTPUT);
    var n = 0;
    # The deadline the config carries — accepted since forever, enforced since
    # 3.11.4.
    var tmo = 0;
    if (cfg != 0) { tmo = SandboxConfig_timeout_ms(cfg); }
    # A sandbox naming a rootfs must run INSIDE it. The stdlib's exec_capture
    # forks and execs on the host with no child-side seam, so a rootfs-bearing
    # sandbox takes kavach's own confined capture instead. Before 3.9.1 there was
    # no rootfs field at all and every container ran host binaries.
    #
    # **And a policy asking for seccomp or landlock needs that same seam, rootfs
    # or not** (3.11.3). Until then this branch was gated on `rootfs != 0`
    # alone, so `seccomp_enabled = 1` was stored, scored by `score_backend`, and
    # never applied: a `policy_strict()` sandbox with no rootfs read arbitrary
    # host files and reported success. Measured by agnosai against 3.11.2 —
    # `/bin/cat` of a file outside any allowed path returned its 33 bytes.
    # `_spawn_enter_rootfs(0)` already returns 0, and `_spawn_ns_flags` already
    # takes `rootfs` into account, so the confined path needs no rootfs to work.
    var rootfs = 0;
    if (cfg != 0) { rootfs = SandboxConfig_rootfs(cfg); }
    var pol0 = 0;
    if (cfg != 0) { pol0 = SandboxConfig_policy(cfg); }
    if (rootfs != 0 || policy_wants_confinement(pol0) == 1) {
        var pol = pol0;
        var sec = 0;
        if (pol != 0) {
            if (SandboxPolicy_seccomp_enabled(pol) == 1) {
                var sres = security_create_exec_seccomp_filter();
                # **Fail closed.** A policy that asked for seccomp and did not
                # get a filter must not fall through to an unconfined exec —
                # that is the shape of the bug this whole branch fixes.
                if (is_ok(sres) == 0) {
                    return backend_error_result("seccomp requested but the filter could not be built");
                }
                sec = result_unwrap(sres);
            }
        }
        # Namespaces where they were already attempted (with a rootfs), or
        # where the caller explicitly asked for them (3.11.5). The rootfs-less
        # arm is the one 3.11.3 added, and it must not make unprivileged
        # namespace creation a precondition for seccomp by default — but a
        # caller who needs network isolation can now say so and get a
        # fail-closed refusal instead of silence.
        var want_ns = 0;
        if (rootfs != 0) { want_ns = 1; }
        if (cfg != 0) {
            if (SandboxConfig_require_ns(cfg) == 1) { want_ns = 1; }
        }
        # 3.12.0: hand the payload the config's explicit environment. Unset (the
        # default) is the empty envp this path always used.
        var pexec_env = 0;
        if (cfg != 0) { pexec_env = SandboxConfig_env(cfg); }
        # 3.12.2: and the working directory, applied inside the rootfs.
        var pexec_wd = 0;
        if (cfg != 0) { pexec_wd = SandboxConfig_workdir(cfg); }
        n = confine_capture_input_env_wd(args, pol, rootfs, cgroup_path, sec, buf,
          PROCESS_MAX_OUTPUT, want_ns, tmo, 1, 0, 0, pexec_env, pexec_wd);
        cgroup_teardown(cgroup_path);
        var end_rf = mono_now_ns();
        var rr = backend_capture_finish(buf, n, PROCESS_MAX_OUTPUT, "exec failed", start_ns, end_rf);
        # Surface the payload's real exit code. Reporting 0 for a command that
        # never ran is how the missing-rootfs bug looked healthy for so long.
        if (rr != 0) {
            ExecResult_set_exit_code(rr, confine_last_exit());
            ExecResult_set_timed_out(rr, confine_last_timed_out());
            # 3.11.5: the payload's own stderr, where this field was "".
            ExecResult_set_stderr(rr, confine_last_stderr());
        }
        return rr;
    }

    # **The unconfined path takes the same capture** (3.11.4), with
    # `do_confine = 0`. It used the stdlib's `exec_capture`, which discards the
    # child's wait status and has no seam for a deadline — so every command that
    # ran reported `exit_code = 0` (measured: `/bin/false`, real exit 1, and
    # `/bin/ls` on a missing path, real exit 2, both came back 0) and no
    # `timeout_ms` was ever enforced. One capture, so neither can drift again.
    n = confine_capture(args, 0, 0, cgroup_path, 0, buf, PROCESS_MAX_OUTPUT, 0, tmo, 0);
    cgroup_teardown(cgroup_path);
    var end_ns = mono_now_ns();

    var pr = backend_capture_finish(buf, n, PROCESS_MAX_OUTPUT, "exec failed", start_ns, end_ns);
    if (pr != 0) {
        ExecResult_set_exit_code(pr, confine_last_exit());
        ExecResult_set_timed_out(pr, confine_last_timed_out());
        ExecResult_set_stderr(pr, confine_last_stderr());
    }
    return pr;
}

fn process_health(sandbox) { return 1; }
fn process_destroy(sandbox) { return 0; }

fn backend_process_register() {
    backend_register_exec(KavachBackend.PROCESS, &process_exec);
    backend_register_health(KavachBackend.PROCESS, &process_health);
    backend_register_destroy(KavachBackend.PROCESS, &process_destroy);
    return 0;
}

# --- spawn.cyr ---

# spawn.cyr — policy-threaded DETACHED spawn (3.9.0).
#
# `sandbox_exec` runs a command to completion and captures its output;
# `persistent_spawn` keeps a guest alive on pipes but takes no Sandbox, so it
# threads NO policy — no cgroup, no namespaces, no landlock, no seccomp. Neither
# shape serves a daemon container: the caller needs the process to outlive the
# call, under the sandbox's policy, with its output going somewhere durable.
#
# That is what this module adds. The consumer is stiva's `run -d`, which has been
# blocked on this symbol existing (its roadmap tracks the gate by symbol rather
# than by kavach version, precisely because two releases went by with the
# version moving and the symbol absent).
#
# ── The policy contract ──────────────────────────
# A detached spawn that quietly drops half the policy is worse than no detached
# spawn, because the caller cannot tell. So every isolation primitive the policy
# asks for is either APPLIED or the spawn REFUSES. There is no "best effort"
# path here. In particular a hardening step that fails in the child `_exit`s
# rather than falling through to execve unconfined.
#
# ── Ordering in the child, and why ────────────────────────
#   1. setsid          — leave the parent's session/controlling terminal, or a
#                        Ctrl-C in the launching shell kills the "detached" job.
#   2. stdio redirect  — stdin from /dev/null, stdout+stderr appended to the log.
#   3. fd cleanup      — close(3..) so no inherited descriptor reaches the
#                        payload (the CVE-2024-21626 class: a leaked host
#                        directory fd is a filesystem escape).
#   4. cgroup join     — write our own pid to cgroup.procs. Direct, unlike the
#                        `sh -c` prelude cgroup_wrap_argv needs for the exec
#                        path, because here we ARE the child.
#   5. NO_NEW_PRIVS    — must precede seccomp; the kernel rejects a filter from
#                        an unprivileged process without it.
#   6. namespaces      — unshare before the payload exists.
#   7. landlock        — path rules; also sets NO_NEW_PRIVS itself.
#   8. execve.
#
#   8. rootfs entry    — chroot into the container filesystem, before landlock
#                        (path rules resolve against the current root) and
#                        before seccomp (which denies mount/chroot).
#   9. seccomp         — applied LAST, or it would filter the confinement steps
#                        above it. Uses the exec-safe DENY-list profile; the
#                        20-syscall allowlist cannot be used pre-exec because it
#                        does not permit execve. See
#                        security_create_exec_seccomp_filter.

# A detached child under sandbox policy.
#   pid         — child pid
#   alive       — 1 running, 0 reaped (exit_code then valid)
#   exit_code   — -1 until reaped
#   cgroup_path — cstr | 0; rmdir'd when the child is reaped
#   log_path    — cstr | 0; where stdout+stderr went
#derive(accessors)
struct SpawnedProcess {
    pid;
    alive;
    exit_code;
    cgroup_path;
    log_path;
}
var SPAWNED_PROCESS_SIZE = 40;

# Spawn `command` detached under `sandbox`'s policy, with stdout+stderr appended
# to `log_path` (0 → /dev/null). Returns SpawnedProcess*, or 0.
#
# Refuses when: the sandbox is not RUNNING, the command carries control
# characters or trips the runtime guard, the policy asks for an isolation
# primitive that cannot be applied (see _spawn_seccomp_supported), or the fork
# fails. A refusal prints through kavach_err_print and leaves nothing running.
fn sandbox_spawn(sandbox, command, log_path) {
    if (Sandbox_state(sandbox) != SandboxState.RUNNING) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "sandbox not running");
        return 0;
    }
    # Same two pre-checks the exec path runs, for the same reason: a control
    # character would split into extra argv tokens, and a guard-violating
    # command must never reach fork.
    if (is_safe_argument(command) == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "command contains illegal control chars");
        return 0;
    }
    # 3.12.1: a rootfs'd sandbox is a container — its command resolves inside
    # the image, so the host-interpreter blocklist does not apply. See
    # `runtime_guard_config_for_rootfs`.
    var guard_cfg = runtime_guard_config_for_rootfs(
      SandboxConfig_rootfs(Sandbox_config(sandbox)));
    if (vec_len(check_command(command, guard_cfg)) > 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "command blocked by runtime guard");
        return 0;
    }
    var args = _split_command(command);
    var argc = vec_len(args);
    if (argc == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "empty command");
        return 0;
    }

    var policy = 0;
    var rootfs = 0;
    var cfg = Sandbox_config(sandbox);
    if (cfg != 0) {
        policy = SandboxConfig_policy(cfg);
        rootfs = SandboxConfig_rootfs(cfg);
    }
    # Read the ids in the PARENT: inside the new user namespace getuid() would
    # report the mapped id, not the one the map has to be written against.
    var spawn_uid = sys_getuid();
    var spawn_gid = kv_getgid();

    # Build the seccomp filter in the PARENT: alloc in the child after fork is
    # fine here, but a filter that fails to build should refuse the spawn rather
    # than _exit a child the caller already has a handle to.
    var seccomp_info = 0;
    if (policy != 0) {
        if (SandboxPolicy_seccomp_enabled(policy) == 1) {
            var sres = security_create_exec_seccomp_filter();
            if (is_ok(sres) == 0) {
                kavach_err_print(KAVACH_ERR_EXEC_FAILED, "cannot build seccomp filter");
                return 0;
            }
            seccomp_info = result_unwrap(sres);
        }
    }

    # Cgroup is created by the PARENT (the child may lack permission to mkdir
    # under the cgroup root) and joined by the child.
    var cgroup_path = 0;
    if (policy != 0) {
        if (cgroup_policy_has_limits(policy) == 1) {
            cgroup_path = cgroup_setup(policy);
        }
    }

    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    # The config's explicit env, or the empty envp when unset (the pre-3.12.0
    # behaviour for every caller that does not call `config_env`). Built in the
    # PARENT for the same reason the seccomp filter is: alloc after fork is
    # unsafe.
    var spawn_env = 0;
    if (cfg != 0) { spawn_env = SandboxConfig_env(cfg); }
    var spawn_wd = 0;
    if (cfg != 0) { spawn_wd = SandboxConfig_workdir(cfg); }
    var envp = kv_envp_from_vec(spawn_env);

    var pid = kv_fork();
    if (pid < 0) {
        cgroup_teardown(cgroup_path);
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "fork failed");
        return 0;
    }
    if (pid == 0) {
        # ── child ──
        # Every failure below _exits. Falling through to execve after a failed
        # hardening step would run the payload with less isolation than the
        # policy promised, which is the one outcome this module must not have.
        # Each confinement step has its OWN exit code, so a caller that sees a
        # dead container can tell WHICH isolation primitive was unavailable
        # rather than staring at one opaque number. 12x is chosen to sit below
        # 126/127, which the shell already reserves for "not executable" and
        # "not found".
        kv_setsid();
        if (_spawn_redirect_stdio(log_path) != 0) { sys_exit(SPAWN_EXIT_STDIO); }
        # 1: sandbox_spawn's namespace contract is unchanged by 3.11.3 — it
        # fails closed when the host denies them, and a test asserts exactly
        # that.
        # 3.12.2: the config's workdir, applied inside the rootfs. Read in the
        # parent (cfg is not touched after fork).
        confine_child_wd(policy, rootfs, cgroup_path, spawn_uid, spawn_gid, seccomp_info, 1,
          spawn_wd);
        kv_execve(vec_get(args, 0), argv, envp);
        sys_exit(127);
    }

    # ── parent ──
    var sp = alloc(SPAWNED_PROCESS_SIZE);
    SpawnedProcess_set_pid(sp, pid);
    SpawnedProcess_set_alive(sp, 1);
    SpawnedProcess_set_exit_code(sp, 0 - 1);
    SpawnedProcess_set_cgroup_path(sp, cgroup_path);
    SpawnedProcess_set_log_path(sp, log_path);
    return sp;
}

# Child pid, or -1.
#[must_use]
fn spawned_pid(sp) {
    if (sp == 0) { return 0 - 1; }
    return SpawnedProcess_pid(sp);
}

# 1 while the child has not been reaped.
#[must_use]
fn spawned_alive(sp) {
    if (sp == 0) { return 0; }
    return SpawnedProcess_alive(sp);
}

# Exit code, or -1 until the child has been reaped.
#[must_use]
fn spawned_exit_code(sp) {
    if (sp == 0) { return 0 - 1; }
    return SpawnedProcess_exit_code(sp);
}

# Record a reaped status: decode the wait status, mark dead, drop the cgroup.
fn _spawned_reap(sp, status) {
    var code = 0;
    # WIFEXITED: low 7 bits are the signal; 0 means a normal exit and the code
    # is in bits 8-15. A signalled child reports 128+signal, the shell
    # convention, so a caller can tell "exited 9" from "killed by SIGKILL".
    var sig = status & 127;
    if (sig == 0) { code = (status >> 8) & 255; }
    else { code = 128 + sig; }
    SpawnedProcess_set_exit_code(sp, code);
    SpawnedProcess_set_alive(sp, 0);
    cgroup_teardown(SpawnedProcess_cgroup_path(sp));
    SpawnedProcess_set_cgroup_path(sp, 0);
    return code;
}

# Non-blocking reap. 1 = exited (exit_code now valid), 0 = still running,
# -1 = error / already reaped.
fn spawned_try_wait(sp) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return 1; }
    var stbuf[4];
    store32(&stbuf, 0);
    # WNOHANG = 1.
    var r = kv_waitpid(SpawnedProcess_pid(sp), &stbuf, 1);
    if (r < 0) { return 0 - 1; }
    if (r == 0) { return 0; }
    _spawned_reap(sp, load32(&stbuf));
    return 1;
}

# Block until the child exits; returns its exit code, or -1 on error.
fn spawned_wait(sp) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return SpawnedProcess_exit_code(sp); }
    var stbuf[4];
    store32(&stbuf, 0);
    var r = kv_waitpid(SpawnedProcess_pid(sp), &stbuf, 0);
    if (r < 0) { return 0 - 1; }
    return _spawned_reap(sp, load32(&stbuf));
}

# Signal the child. Returns 0 on success, -1 on error or when already reaped.
# Does NOT reap — call spawned_wait / spawned_try_wait after, or the child
# becomes a zombie and its cgroup is never torn down.
fn spawned_kill(sp, signal) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return 0 - 1; }
    if (sys_kill(SpawnedProcess_pid(sp), signal) < 0) { return 0 - 1; }
    return 0;
}

# SIGTERM, wait up to `grace_ms` for the child to go, then SIGKILL and reap.
# Returns the exit code, or -1. This is the shape a container runtime's `stop`
# wants, and getting the escalation wrong (no grace, or no final SIGKILL) is a
# common way to either lose data or leak processes.
fn spawned_terminate(sp, grace_ms) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return SpawnedProcess_exit_code(sp); }
    spawned_kill(sp, 15);                               # SIGTERM
    var waited = 0;
    while (waited < grace_ms) {
        if (spawned_try_wait(sp) == 1) { return SpawnedProcess_exit_code(sp); }
        sleep_ms(20);
        waited = waited + 20;
    }
    spawned_kill(sp, 9);                                # SIGKILL
    return spawned_wait(sp);
}
