fn _cg_pkg_install(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "npm install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "npm install");
    }
    if (_cg_hit(hits, lower, "pip install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "pip install");
    }
    if (_cg_hit(hits, lower, "gem install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "gem install");
    }
    if (_cg_hit(hits, lower, "cargo install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "cargo install");
    }
    if (_cg_hit(hits, lower, "go install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "go install");
    }
    if (_cg_hit(hits, lower, "apt install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "apt install");
    }
    if (_cg_hit(hits, lower, "apt-get install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "apt-get install");
    }
    if (_cg_hit(hits, lower, "yum install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "yum install");
    }
    if (_cg_hit(hits, lower, "dnf install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "dnf install");
    }
    if (_cg_hit(hits, lower, "pacman -s") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "pacman -s");
    }
    return 0;
}

fn _cg_remote_script(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "curl | sh") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "curl | sh");
    }
    if (_cg_hit(hits, lower, "curl | bash") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "curl | bash");
    }
    if (_cg_hit(hits, lower, "wget -o - |") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "wget -o - |");
    }
    if (_cg_hit(hits, lower, "curl -ssl |") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "curl -ssl |");
    }
    return 0;
}

fn _cg_dyn_import(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "require(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "supply_chain", "Dynamic require/import", "require(");
    }
    if (_cg_hit(hits, lower, "import(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "supply_chain", "Dynamic require/import", "import(");
    }
    if (_cg_hit(hits, lower, "__import__(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "supply_chain", "Dynamic require/import", "__import__(");
    }
    return 0;
}

fn _cg_base64(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "atob(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "atob(");
    }
    if (_cg_hit(hits, lower, "base64 -d") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "base64 -d");
    }
    if (_cg_hit(hits, lower, "base64 --decode") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "base64 --decode");
    }
    if (_cg_hit(hits, lower, "b64decode") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "b64decode");
    }
    return 0;
}

fn _cg_unicode_esc(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "\\u00") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Unicode escape", "\\u00");
    }
    if (_cg_hit(hits, lower, "\\x00") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Unicode escape", "\\x00");
    }
    if (_cg_hit(hits, lower, "string.fromcharcode") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Unicode escape", "string.fromcharcode");
    }
    return 0;
}

fn _cg_hex_enc(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "\\x") == 1) {
        return code_emit(text, lower, result,
          Severity.LOW, "obfuscation", "Hex encoding", "\\x");
    }
    if (_cg_hit(hits, lower, "fromhex(") == 1) {
        return code_emit(text, lower, result,
          Severity.LOW, "obfuscation", "Hex encoding", "fromhex(");
    }
    if (_cg_hit(hits, lower, "hex.decode") == 1) {
        return code_emit(text, lower, result,
          Severity.LOW, "obfuscation", "Hex encoding", "hex.decode");
    }
    return 0;
}

fn _cg_sens_path(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "/etc/shadow") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/etc/shadow");
    }
    if (_cg_hit(hits, lower, "/etc/passwd") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/etc/passwd");
    }
    if (_cg_hit(hits, lower, "/etc/sudoers") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/etc/sudoers");
    }
    if (_cg_hit(hits, lower, "/.ssh/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.ssh/");
    }
    if (_cg_hit(hits, lower, "/.gnupg/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.gnupg/");
    }
    if (_cg_hit(hits, lower, "/.aws/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.aws/");
    }
    if (_cg_hit(hits, lower, "/.kube/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.kube/");
    }
    if (_cg_hit(hits, lower, "/dev/mem") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/dev/mem");
    }
    if (_cg_hit(hits, lower, "/dev/kmem") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/dev/kmem");
    }
    if (_cg_hit(hits, lower, "/proc/kcore") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/proc/kcore");
    }
    return 0;
}

fn _cg_traversal(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "../") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "filesystem_abuse", "Path traversal", "../");
    }
    if (_cg_hit(hits, lower, "..\\") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "filesystem_abuse", "Path traversal", "..\\");
    }
    return 0;
}

fn _cg_destructive(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "rm -rf") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "rm -rf");
    }
    if (_cg_hit(hits, lower, "dd if=") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "dd if=");
    }
    if (_cg_hit(hits, lower, "mkfs.") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "mkfs.");
    }
    if (_cg_hit(hits, lower, "shred ") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "shred ");
    }
    return 0;
}

fn _cg_weak_hash(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "md5(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "crypto_misuse", "Weak hash", "md5(");
    }
    if (_cg_hit(hits, lower, "sha1(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "crypto_misuse", "Weak hash", "sha1(");
    }
    return 0;
}

fn _cg_hardcoded_key(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "aes_key =") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "crypto_misuse", "Hardcoded key", "aes_key =");
    }
    if (_cg_hit(hits, lower, "encryption_key =") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "crypto_misuse", "Hardcoded key", "encryption_key =");
    }
    if (_cg_hit(hits, lower, "secret_key =") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "crypto_misuse", "Hardcoded key", "secret_key =");
    }
    return 0;
}

# ---- main scan -----------------------------------------------------------

fn code_scan(text, result) {
    var n = strlen(text);
    var lower = alloc(n + 1);
    str_to_lower_into(text, lower);

    # Single Aho-Corasick pass over the lowered text replaces the ~109
    # per-pattern re-scans the groups below used to do. Results go into this
    # scan's hit table, which the groups read via _cg_hit().
    var ac = _cg_automaton();
    var hits = ac_hits_new(ac);
    ac_search(ac, lower, n, hits);

    _cg_shell_exec(text, lower, result, hits);
    _cg_process_spawn(text, lower, result, hits);
    _cg_eval_exec(text, lower, result, hits);
    _cg_shell_invoc(text, lower, result, hits);
    _cg_shell_meta(text, lower, result, hits);
    _cg_pipe_shell(text, lower, result, hits);
    _cg_http_req(text, lower, result, hits);
    _cg_dns_exfil(text, lower, result, hits);
    _cg_reverse_shell(text, lower, result, hits);
    _cg_net_tools(text, lower, result, hits);
    _cg_sudo(text, lower, result, hits);
    _cg_perm_change(text, lower, result, hits);
    _cg_kernel_mod(text, lower, result, hits);
    _cg_mount(text, lower, result, hits);
    _cg_capability(text, lower, result, hits);
    _cg_pkg_install(text, lower, result, hits);
    _cg_remote_script(text, lower, result, hits);
    _cg_dyn_import(text, lower, result, hits);
    _cg_base64(text, lower, result, hits);
    _cg_unicode_esc(text, lower, result, hits);
    _cg_hex_enc(text, lower, result, hits);
    _cg_sens_path(text, lower, result, hits);
    _cg_traversal(text, lower, result, hits);
    _cg_destructive(text, lower, result, hits);
    _cg_weak_hash(text, lower, result, hits);
    _cg_hardcoded_key(text, lower, result, hits);
    return 0;
}

# --- scanning_data.cyr ---

# kavach — data/compliance scanner (PII + HIPAA/GDPR/PCI/SOC2)
# Ported from rust-old/src/scanning/data.rs
#
# Compliance keywords are case-insensitive multi-word substrings — matched
# against a pre-lowered copy of the text. Numeric/structural PII patterns
# (credit cards, phone, IPv4, IBAN) use hand-rolled char-class scanners.

fn _dg_emit(text, lower, result, severity, category, name, matched) {
    return code_emit(text, lower, result, severity, category, name, matched);
}

# Position-aware emit for the structural PII matchers, which already know the
# match offset+length. The old path passed a single stand-in char ("4"/"0"/…)
# as `matched`, so evidence extraction re-scanned the whole artifact and
# pointed the snippet at the first stray digit instead of the real match.
fn _dg_emit_at(text, result, severity, category, name, start, len) {
    return code_emit_at(text, result, severity, category, name, start, len);
}

# ---- Credit card matchers ------------------------------------------------

# Word boundary: position 0 or preceding char is non-token.
fn _at_word_start(text, i) {
    if (i == 0) { return 1; }
    if (is_token_c(load8(text + i - 1)) == 0) { return 1; }
    return 0;
}

# Word boundary: position == length or next char is non-token.
fn _at_word_end(text, i, n) {
    if (i >= n) { return 1; }
    if (is_token_c(load8(text + i)) == 0) { return 1; }
    return 0;
}

# Consecutive digit run starting at i; returns count.
fn _digit_run(text, i, n) {
    var j = 0;
    while (i + j < n) {
        if (is_digit_c(load8(text + i + j)) == 0) { return j; }
        j = j + 1;
    }
    return j;
}

# Visa: 4 + 12 digits, optionally +3 more, word-bounded. Returns match len.
fn match_visa(text, i, n) {
    if (_at_word_start(text, i) == 0) { return 0; }
    if (i + 13 > n) { return 0; }
    if (load8(text + i) != 52) { return 0; }
    var run = _digit_run(text, i, n);
    if (run == 16) {
        if (_at_word_end(text, i + 16, n) == 1) { return 16; }
        return 0;
    }
    if (run == 13) {
        if (_at_word_end(text, i + 13, n) == 1) { return 13; }
        return 0;
    }
    return 0;
}

# Mastercard: 5[1-5] + 14 digits = 16 total.
fn match_mastercard(text, i, n) {
    if (_at_word_start(text, i) == 0) { return 0; }
    if (i + 16 > n) { return 0; }
    if (load8(text + i) != 53) { return 0; }
    var c2 = load8(text + i + 1);
    if (c2 < 49) { return 0; }
    if (c2 > 53) { return 0; }
    var run = _digit_run(text, i, n);
    if (run == 16) {
        if (_at_word_end(text, i + 16, n) == 1) { return 16; }
    }
    return 0;
}

# Amex: 3[47] + 13 digits = 15 total.
fn match_amex(text, i, n) {
    if (_at_word_start(text, i) == 0) { return 0; }
    if (i + 15 > n) { return 0; }
    if (load8(text + i) != 51) { return 0; }
    var c2 = load8(text + i + 1);
    if (c2 != 52) { if (c2 != 55) { return 0; } }
    var run = _digit_run(text, i, n);
    if (run == 15) {
        if (_at_word_end(text, i + 15, n) == 1) { return 15; }
    }
    return 0;
}

# Parse a 1-3 digit octet (0-255) starting at i. Returns (value+1, len) or (0,0).
# We use value+1 so 0 return indicates failure even for octet 0.
fn _parse_octet(text, i, n) {
    if (i >= n) { return (0, 0); }
    var c1 = load8(text + i);
    if (is_digit_c(c1) == 0) { return (0, 0); }
    var v = c1 - 48;
    var len = 1;
    if (i + 1 < n) {
        var c2 = load8(text + i + 1);
        if (is_digit_c(c2) == 1) {
            v = v * 10 + (c2 - 48);
            len = 2;
            if (i + 2 < n) {
                var c3 = load8(text + i + 2);
                if (is_digit_c(c3) == 1) {
                    var v3 = v * 10 + (c3 - 48);
                    if (v3 <= 255) {
                        v = v3;
                        len = 3;
                    }
                }
            }
        }
    }
    return (v + 1, len);
}

# IPv4: octet '.' octet '.' octet '.' octet, all 0-255, word-bounded.
fn match_ipv4(text, i, n) {
    if (_at_word_start(text, i) == 0) { return 0; }
    var pos = i;
    var k = 0;
    while (k < 3) {
        var v, l = _parse_octet(text, pos, n);
        if (v == 0) { return 0; }
        pos = pos + l;
        if (pos >= n) { return 0; }
        if (load8(text + pos) != 46) { return 0; }
        pos = pos + 1;
        k = k + 1;
    }
    var v4, l4 = _parse_octet(text, pos, n);
    if (v4 == 0) { return 0; }
    pos = pos + l4;
    if (_at_word_end(text, pos, n) == 0) { return 0; }
    return pos - i;
}

# IBAN: [A-Z]{2}[0-9]{2}[A-Z0-9]{4}[0-9]{7}[A-Z0-9]{0,18}, word-bounded.
fn match_iban(text, i, n) {
    if (_at_word_start(text, i) == 0) { return 0; }
    if (i + 15 > n) { return 0; }
    if (is_upper_c(load8(text + i)) == 0) { return 0; }
    if (is_upper_c(load8(text + i + 1)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 2)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 3)) == 0) { return 0; }
    var j = 4;
    while (j < 8) {
        var c = load8(text + i + j);
        if (is_upper_c(c) == 0) {
            if (is_digit_c(c) == 0) { return 0; }
        }
        j = j + 1;
    }
    while (j < 15) {
        if (is_digit_c(load8(text + i + j)) == 0) { return 0; }
        j = j + 1;
    }
    # Optional 0..18 more [A-Z0-9]
    var extra = 0;
    while (extra < 18) {
        if (i + j + extra >= n) { break; }
        var c = load8(text + i + j + extra);
        if (is_upper_c(c) == 0) {
            if (is_digit_c(c) == 0) { break; }
        }
        extra = extra + 1;
    }
    if (_at_word_end(text, i + j + extra, n) == 0) { return 0; }
    return j + extra;
}

# US phone: "(###) ###-####" or "###-###-####" or "###.###.####" — simplified.
# Rust had a complex regex; we accept the common formats.
fn _is_phone_sep(c) {
    if (c == 45) { return 1; }   # -
    if (c == 46) { return 1; }   # .
    if (c == 32) { return 1; }   # space
    return 0;
}

fn match_us_phone(text, i, n) {
    if (_at_word_start(text, i) == 0) { return 0; }
    var pos = i;
    # Optional "(": skip if present, expect ")" after 3 digits
    var paren = 0;
    if (pos < n) {
        if (load8(text + pos) == 40) {
            paren = 1;
            pos = pos + 1;
        }
    }
    var k = 0;
    while (k < 3) {
        if (pos >= n) { return 0; }
        if (is_digit_c(load8(text + pos)) == 0) { return 0; }
        pos = pos + 1;
        k = k + 1;
    }
    if (paren == 1) {
        if (pos >= n) { return 0; }
        if (load8(text + pos) != 41) { return 0; }
        pos = pos + 1;
    }
    # Optional separator
    if (pos < n) {
        if (_is_phone_sep(load8(text + pos)) == 1) { pos = pos + 1; }
    }
    k = 0;
    while (k < 3) {
        if (pos >= n) { return 0; }
        if (is_digit_c(load8(text + pos)) == 0) { return 0; }
        pos = pos + 1;
        k = k + 1;
    }
    if (pos < n) {
        if (_is_phone_sep(load8(text + pos)) == 1) { pos = pos + 1; }
    }
    k = 0;
    while (k < 4) {
        if (pos >= n) { return 0; }
        if (is_digit_c(load8(text + pos)) == 0) { return 0; }
        pos = pos + 1;
        k = k + 1;
    }
    if (_at_word_end(text, pos, n) == 0) { return 0; }
    return pos - i;
}

# ---- PII dispatch (credit cards, phone, IP, IBAN) ------------------------
# Walk the text once, try each matcher at each position, emit on first hit.

fn _data_scan_pii(text, lower, result) {
    var n = strlen(text);
    var i = 0;
    while (i < n) {
        var m = match_visa(text, i, n);
        if (m > 0) {
            _dg_emit_at(text, result, Severity.CRITICAL,
              "pii_financial", "Credit Card (Visa)", i, m);
            i = i + m;
        }
        else {
            var mc = match_mastercard(text, i, n);
            if (mc > 0) {
                _dg_emit_at(text, result, Severity.CRITICAL,
                  "pii_financial", "Credit Card (Mastercard)", i, mc);
                i = i + mc;
            }
            else {
                var amex = match_amex(text, i, n);
                if (amex > 0) {
                    _dg_emit_at(text, result, Severity.CRITICAL,
                      "pii_financial", "Credit Card (Amex)", i, amex);
                    i = i + amex;
                }
                else {
                    var ip = match_ipv4(text, i, n);
                    if (ip > 0) {
                        _dg_emit_at(text, result, Severity.LOW,
                          "pii_network", "IP Address (IPv4)", i, ip);
                        i = i + ip;
                    }
                    else {
                        var ib = match_iban(text, i, n);
                        if (ib > 0) {
                            _dg_emit_at(text, result, Severity.HIGH,
                              "pii_financial", "IBAN", i, ib);
                            i = i + ib;
                        }
                        else {
                            var ph = match_us_phone(text, i, n);
                            if (ph > 0) {
                                _dg_emit_at(text, result, Severity.MEDIUM,
                                  "pii", "US Phone Number", i, ph);
                                i = i + ph;
                            }
                            else {
                                i = i + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

# ---- Compliance keyword groups (substring, case-insensitive) -------------

fn _dg_hipaa(text, lower, result) {
    if (cstr_contains(lower, "patient id") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "patient id");
    }
    if (cstr_contains(lower, "patient name") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "patient name");
    }
    if (cstr_contains(lower, "patient record") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "patient record");
    }
    if (cstr_contains(lower, "patient dob") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "patient dob");
    }
    if (cstr_contains(lower, "patient ssn") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "patient ssn");
    }
    if (cstr_contains(lower, "patient mrn") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "patient mrn");
    }
    if (cstr_contains(lower, "medical record number") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "medical record number");
    }
    if (cstr_contains(lower, "health insurance claim") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "health insurance claim");
    }
    if (cstr_contains(lower, "protected health information") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_hipaa", "HIPAA identifier", "protected health information");
    }
    return 0;
}

fn _dg_gdpr(text, lower, result) {
    if (cstr_contains(lower, "data subject") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_gdpr", "GDPR personal data", "data subject");
    }
    if (cstr_contains(lower, "right to erasure") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_gdpr", "GDPR personal data", "right to erasure");
    }
    if (cstr_contains(lower, "right to be forgotten") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_gdpr", "GDPR personal data", "right to be forgotten");
    }
    if (cstr_contains(lower, "consent withdraw") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_gdpr", "GDPR personal data", "consent withdraw");
    }
    if (cstr_contains(lower, "data processing agreement") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_gdpr", "GDPR personal data", "data processing agreement");
    }
    if (cstr_contains(lower, "data controller") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_gdpr", "GDPR personal data", "data controller");
    }
    if (cstr_contains(lower, "data processor") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_gdpr", "GDPR personal data", "data processor");
    }
    return 0;
}

fn _dg_pci(text, lower, result) {
    if (cstr_contains(lower, "cardholder data") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "cardholder data");
    }
    if (cstr_contains(lower, "card verification") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "card verification");
    }
    if (cstr_contains(lower, "cvv") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "cvv");
    }
    if (cstr_contains(lower, "cvc") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "cvc");
    }
    if (cstr_contains(lower, "primary account number") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "primary account number");
    }
    if (cstr_contains(lower, "pan data") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "pan data");
    }
    if (cstr_contains(lower, "track data") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "track data");
    }
    if (cstr_contains(lower, "magnetic stripe") == 1) {
        return _dg_emit(text, lower, result,
          Severity.HIGH, "compliance_pci", "PCI-DSS cardholder data", "magnetic stripe");
    }
    return 0;
}

fn _dg_soc2(text, lower, result) {
    if (cstr_contains(lower, "soc 2") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_soc2", "SOC2 audit artifact", "soc 2");
    }
    if (cstr_contains(lower, "soc2") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_soc2", "SOC2 audit artifact", "soc2");
    }
    if (cstr_contains(lower, "trust service criteria") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_soc2", "SOC2 audit artifact", "trust service criteria");
    }
    if (cstr_contains(lower, "system description") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_soc2", "SOC2 audit artifact", "system description");
    }
    if (cstr_contains(lower, "complementary user entity controls") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_soc2", "SOC2 audit artifact", "complementary user entity controls");
    }
    if (cstr_contains(lower, "cuec") == 1) {
        return _dg_emit(text, lower, result,
          Severity.MEDIUM, "compliance_soc2", "SOC2 audit artifact", "cuec");
    }
    return 0;
}

# ---- main scan -----------------------------------------------------------

fn data_scan(text, result) {
    var n = strlen(text);
    var lower = alloc(n + 1);
    str_to_lower_into(text, lower);

    _data_scan_pii(text, lower, result);
    _dg_hipaa(text, lower, result);
    _dg_gdpr(text, lower, result);
    _dg_pci(text, lower, result);
    _dg_soc2(text, lower, result);
    return 0;
}

# --- scanning_gate.cyr ---

# kavach — externalization gate (orchestrates 3 scanners into a verdict)
# Ported from rust-old/src/scanning/gate.rs
#
# Secrets redaction on WARN verdict is stubbed — TODO once a single-pass
# redactor is ported (Rust Cow-based impl needs reworking for Cyrius).

fn determine_verdict(worst, policy) {
    if (worst >= ExternalizationPolicy_block_threshold(policy)) {
        return ScanVerdict.BLOCK;
    }
    if (worst >= ExternalizationPolicy_quarantine_threshold(policy)) {
        return ScanVerdict.QUARANTINE;
    }
    if (worst > Severity.INFO) {
        return ScanVerdict.WARN;
    }
    return ScanVerdict.PASS;
}

# Combine stdout + "\n" + stderr into a fresh heap cstr. Newline separator
# prevents false positives at the stdout/stderr boundary.
fn _concat_with_nl(a, b) {
    return _concat_scan_buf(a, strlen(a), b, strlen(b));
}

# The buffer the three scanners actually see: `alen` bytes of `a`, a newline,
# `blen` bytes of `b`, NUL-terminated — with every **interior** NUL rewritten to
# a newline.
#
# **The rewrite is what makes `strlen` correct rather than what works around
# it.** The scanners take a cstring and measure it themselves; before 3.11.7
# they were handed a buffer whose first NUL might be nowhere near its end, so
# `secrets_scan` stopped there and a credential after it was never looked at —
# measured, an identical 23 bytes returning PASS with a NUL and BLOCK with a
# space. Guaranteeing the buffer contains no interior NUL makes every scanner
# see the whole artifact with no change to any of them.
#
# **A newline, not a space or a NUL-strip.** `_concat_with_nl` already separates
# stdout from stderr with one for exactly this reason — it is a boundary the
# scanners are known to handle and no secret, code or data pattern contains it,
# so substituting it neither hides a match nor invents one. Dropping the bytes
# instead would splice two unrelated spans together and could fabricate a
# pattern that was never in the artifact.
#
# The artifact itself is untouched: this is a scanning copy. What the caller
# releases is still its own bytes, NULs and all.
fn _concat_scan_buf(a, alen, b, blen) {
    var buf = alloc(alen + blen + 2);
    var i = 0;
    while (i < alen) {
        var c = load8(a + i);
        if (c == 0) { c = 10; }
        store8(buf + i, c);
        i = i + 1;
    }
    store8(buf + alen, 10);
    var j = 0;
    while (j < blen) {
        var d = load8(b + j);
        if (d == 0) { d = 10; }
        store8(buf + alen + 1 + j, d);
        j = j + 1;
    }
    store8(buf + alen + 1 + blen, 0);
    return buf;
}

# Apply the externalization gate. Returns a ScanResult with verdict set.
# Callers use verdict to decide whether to release the artifact:
#   PASS       → release as-is
#   WARN       → release (optionally redacted)
#   QUARANTINE → hold, require approval
#   BLOCK      → reject
fn gate_apply(result, policy) {
    var sr = scan_result_new();

    if (ExternalizationPolicy_enabled(policy) == 0) {
        ScanResult_set_verdict(sr, ScanVerdict.PASS);
        return sr;
    }

    var stdout = ExecResult_stdout(result);
    var stderr = ExecResult_stderr(result);
    # The artifact's TRUE lengths (3.11.7). `strlen` is a distance to the first
    # NUL, not a length, and using it here understated the size cap as well as
    # the scan — an artifact with an embedded NUL under-reported its own size to
    # the limit it was being checked against.
    var olen = exec_result_stdout_len(result);
    var elen = exec_result_stderr_len(result);
    var total = olen + elen;
    if (total > ExternalizationPolicy_max_artifact_size_bytes(policy)) {
        scan_result_push(sr, finding_new("gate", Severity.CRITICAL,
            "size_limit", "output size exceeds limit", 0));
        ScanResult_set_verdict(sr, ScanVerdict.BLOCK);
        return sr;
    }

    var combined = _concat_scan_buf(stdout, olen, stderr, elen);
    secrets_scan(combined, sr);
    code_scan(combined, sr);
    data_scan(combined, sr);

    var verdict = determine_verdict(ScanResult_worst_severity(sr), policy);
    ScanResult_set_verdict(sr, verdict);

    # WARN-verdict redaction: replace every secret span in stdout/stderr
    # with [REDACTED:CATEGORY] so the caller can release the artifact
    # without leaking. Closed in v3.0 per ADR-004 §7; only fires when
    # the policy opts in (ExternalizationPolicy.redact_secrets == 1).
    if (verdict == ScanVerdict.WARN) {
        if (ExternalizationPolicy_redact_secrets(policy) == 1) {
            # Redacted over the TRUE lengths, and the produced lengths stored
            # back. Redaction copies non-matching spans verbatim, so its output
            # carries any NUL the input had — leaving the stored length behind
            # would describe the new buffer with the old buffer's size, and
            # re-deriving it with `strlen` would truncate the artifact at the
            # first NUL on the way out. Both are how a partial redaction gets
            # released as a whole one.
            var ol[8];
            store64(&ol, 0);
            var red_out = secrets_redact_n(stdout, olen, &ol);
            if (red_out != 0) { exec_result_set_stdout_n(result, red_out, load64(&ol)); }
            var el[8];
            store64(&el, 0);
            var red_err = secrets_redact_n(stderr, elen, &el);
            if (red_err != 0) { exec_result_set_stderr_n(result, red_err, load64(&el)); }
        }
    }
    return sr;
}

# --- scanning_runtime.cyr ---

# kavach — runtime guards (fork bomb, paths, commands, shell injection)
# Ported from rust-old/src/scanning/runtime.rs
#
# Integrity monitoring (PID/mount/user namespace checks) is deferred —
# needs /proc file reads which aren't in the current stdlib stub.

# ---- Violation types -----------------------------------------------------

enum ViolationType {
    FORK_BOMB = 0;
    SENSITIVE_PATH = 1;
    BLOCKED_COMMAND = 2;
    SHELL_INJECTION = 3;
    TIME_ANOMALY = 4;
}

fn violation_type_name(t) {
    if (t == ViolationType.FORK_BOMB) { return "fork_bomb"; }
    if (t == ViolationType.SENSITIVE_PATH) { return "sensitive_path"; }
    if (t == ViolationType.BLOCKED_COMMAND) { return "blocked_command"; }
    if (t == ViolationType.SHELL_INJECTION) { return "shell_injection"; }
    if (t == ViolationType.TIME_ANOMALY) { return "time_anomaly"; }
    return "unknown";
}

#derive(accessors)
struct GuardViolation {
    violation_type;
    description;
}

fn guard_violation_new(t, desc) {
    var v = alloc(16);
    GuardViolation_set_violation_type(v, t);
    GuardViolation_set_description(v, desc);
    return v;
}

# ---- Guard config --------------------------------------------------------

#derive(accessors)
struct RuntimeGuardConfig {
    max_pids;
    block_sensitive_paths;
    enforce_command_blocklist;
    time_anomaly_multiplier_x100;
}

fn runtime_guard_config_default() {
    var c = alloc(32);
    RuntimeGuardConfig_set_max_pids(c, 64);
    RuntimeGuardConfig_set_block_sensitive_paths(c, 1);
    RuntimeGuardConfig_set_enforce_command_blocklist(c, 1);
    RuntimeGuardConfig_set_time_anomaly_multiplier_x100(c, 200);
    return c;
}

# 3.12.1 — the guard config for a sandbox that has its OWN ROOTFS.
#
# Identical to the default in every respect EXCEPT the command blocklist, which
# is disabled. Sensitive-path detection and the shell-metacharacter check both
# stay on; only the "is this binary named `sh`" test is dropped.
#
# ⚠ WHY. The blocklist exists to stop an agent sandbox shelling out to an
# interpreter **on the host**, where the name `sh` resolves to the host's
# `/bin/sh` and running it is an escape. When the sandbox has a rootfs, that
# premise is gone: the name resolves INSIDE the container's filesystem, to a
# binary the caller supplied, reached only after `_spawn_enter_rootfs` has
# pivoted and the namespaces are up. The isolation there is the rootfs, the
# namespaces, seccomp and the cgroup — not the payload's filename.
#
# Applying it anyway made kavach unusable as a container runtime, which is what
# the `rootfs` field added at 3.9.1 exists for. Reported by stiva, reproduced
# end-to-end: `stiva run <image>` with no CMD defaults its command to `/bin/sh`,
# and every backend refused it — `blocked command: sh`, exit 126, before fork.
# The same refusal hit any image whose entrypoint is `sh`, `bash`, `python3`,
# `node`, `ruby`, `perl` or `php`, i.e. most of them. No container that needed a
# shell could ever start.
#
# ⚠ This does NOT weaken a rootfs-less sandbox: `rootfs == 0` returns the
# unchanged default, so every agent-sandbox consumer keeps the blocklist exactly
# as before. The narrowing is conditional on a field only a container runtime
# sets.
#[must_use]
fn runtime_guard_config_for_rootfs(rootfs) {
    var c = runtime_guard_config_default();
    if (rootfs != 0) {
        RuntimeGuardConfig_set_enforce_command_blocklist(c, 0);
    }
    return c;
}

# ---- Command parsing -----------------------------------------------------

# Return heap cstr of base command name (first whitespace-separated token,
# stripped of path prefix). "ls -la" -> "ls"; "/bin/bash -c" -> "bash".
fn _base_command(cmd) {
    var n = strlen(cmd);
    # Skip leading whitespace
    var start = 0;
    while (start < n) {
        var c = load8(cmd + start);
        if (c != 32) { if (c != 9) { break; } }
        start = start + 1;
    }
    # End at whitespace
    var end = start;
    while (end < n) {
        var c = load8(cmd + end);
        if (c == 32) { break; }
        if (c == 9) { break; }
        if (c == 10) { break; }
        end = end + 1;
    }
    # Last slash in [start, end) — chars after it are the base name
    var base_start = start;
    var i = start;
    while (i < end) {
        if (load8(cmd + i) == 47) { base_start = i + 1; }
        i = i + 1;
    }
    var len = end - base_start;
    var buf = alloc(len + 1);
    memcpy(buf, cmd + base_start, len);
    store8(buf + len, 0);
    return buf;
}

# ---- Blocklist checks ----------------------------------------------------

fn _is_blocked_command(base) {
    if (streq(base, "bash") == 1) { return 1; }
    if (streq(base, "sh") == 1) { return 1; }
    if (streq(base, "zsh") == 1) { return 1; }
    if (streq(base, "fish") == 1) { return 1; }
    if (streq(base, "dash") == 1) { return 1; }
    if (streq(base, "csh") == 1) { return 1; }
    if (streq(base, "tcsh") == 1) { return 1; }
    if (streq(base, "python") == 1) { return 1; }
    if (streq(base, "python3") == 1) { return 1; }
    if (streq(base, "perl") == 1) { return 1; }
    if (streq(base, "ruby") == 1) { return 1; }
    if (streq(base, "php") == 1) { return 1; }
    if (streq(base, "lua") == 1) { return 1; }
    if (streq(base, "node") == 1) { return 1; }
    if (streq(base, "deno") == 1) { return 1; }
    if (streq(base, "bun") == 1) { return 1; }
    if (streq(base, "gcc") == 1) { return 1; }
    if (streq(base, "cc") == 1) { return 1; }
    if (streq(base, "g++") == 1) { return 1; }
    if (streq(base, "clang") == 1) { return 1; }
    if (streq(base, "make") == 1) { return 1; }
    if (streq(base, "cmake") == 1) { return 1; }
    if (streq(base, "cargo") == 1) { return 1; }
    if (streq(base, "go") == 1) { return 1; }
    if (streq(base, "rustc") == 1) { return 1; }
    if (streq(base, "javac") == 1) { return 1; }
    return 0;
}

fn is_allowed_command(base) {
    if (streq(base, "ls") == 1) { return 1; }
    if (streq(base, "cat") == 1) { return 1; }
    if (streq(base, "head") == 1) { return 1; }
    if (streq(base, "tail") == 1) { return 1; }
    if (streq(base, "wc") == 1) { return 1; }
    if (streq(base, "grep") == 1) { return 1; }
    if (streq(base, "find") == 1) { return 1; }
    if (streq(base, "df") == 1) { return 1; }
    if (streq(base, "du") == 1) { return 1; }
    if (streq(base, "uname") == 1) { return 1; }
    if (streq(base, "hostname") == 1) { return 1; }
    if (streq(base, "ip") == 1) { return 1; }
    if (streq(base, "ss") == 1) { return 1; }
    if (streq(base, "ps") == 1) { return 1; }
    if (streq(base, "top") == 1) { return 1; }
    if (streq(base, "free") == 1) { return 1; }
    if (streq(base, "lsblk") == 1) { return 1; }
    if (streq(base, "lscpu") == 1) { return 1; }
    if (streq(base, "date") == 1) { return 1; }
    if (streq(base, "whoami") == 1) { return 1; }
    if (streq(base, "id") == 1) { return 1; }
    if (streq(base, "env") == 1) { return 1; }
    if (streq(base, "printenv") == 1) { return 1; }
    if (streq(base, "echo") == 1) { return 1; }
    if (streq(base, "true") == 1) { return 1; }
    if (streq(base, "false") == 1) { return 1; }
    if (streq(base, "test") == 1) { return 1; }
    return 0;
}

fn _check_sensitive_paths(cmd_lower, out_vec) {
    var n = 0;
    if (cstr_contains(cmd_lower, "/etc/shadow") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /etc/shadow"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/etc/gshadow") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /etc/gshadow"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/etc/sudoers") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /etc/sudoers"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/root/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /root/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.ssh/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.ssh/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.gnupg/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.gnupg/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.aws/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.aws/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.kube/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.kube/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/.docker/") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /.docker/"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/mem") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /dev/mem"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/kmem") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /dev/kmem"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/port") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /dev/port"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/proc/kcore") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: /proc/kcore"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/proc/sysrq-trigger") == 1) {
        vec_push(out_vec, guard_violation_new(
            ViolationType.SENSITIVE_PATH, "sensitive path access: /proc/sysrq-trigger"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/sys/firmware/efi/efivars") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SENSITIVE_PATH, "sensitive path access: efivars"));
        n = n + 1;
    }
    return n;
}

fn _check_shell_meta(cmd_lower, out_vec) {
    var n = 0;
    if (cstr_contains(cmd_lower, "| sh") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | sh"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "| bash") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | bash"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "; sh") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: ; sh"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "; bash") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: ; bash"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "| /bin/sh") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | /bin/sh"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "| /bin/bash") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: | /bin/bash"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "$(") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: $("));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "${") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: ${"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "/dev/tcp") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: /dev/tcp"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "mkfifo") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: mkfifo"));
        n = n + 1;
    }
    if (cstr_contains(cmd_lower, "`") == 1) {
        vec_push(out_vec, guard_violation_new(ViolationType.SHELL_INJECTION, "shell metacharacter: backtick"));
        n = n + 1;
    }
    return n;
}

# ---- Main entry points ---------------------------------------------------

# Returns a vec of GuardViolation pointers (empty = safe).
fn check_command(command, config) {
    var violations = vec_new();
    var n = strlen(command);
    var lower = alloc(n + 1);
    str_to_lower_into(command, lower);

    if (RuntimeGuardConfig_enforce_command_blocklist(config) == 1) {
        var base = _base_command(command);
        if (_is_blocked_command(base) == 1) {
            var msg_len = strlen(base) + 18;
            var msg = alloc(msg_len + 1);
            memcpy(msg, "blocked command: ", 17);
            memcpy(msg + 17, base, strlen(base));
            store8(msg + 17 + strlen(base), 0);
            vec_push(violations, guard_violation_new(ViolationType.BLOCKED_COMMAND, msg));
        }
    }

    if (RuntimeGuardConfig_block_sensitive_paths(config) == 1) {
        _check_sensitive_paths(lower, violations);
    }

    _check_shell_meta(lower, violations);
    return violations;
}

# Returns GuardViolation ptr if fork bomb detected, 0 otherwise.
fn check_fork_bomb(current_pids, config) {
    if (current_pids > RuntimeGuardConfig_max_pids(config)) {
        return guard_violation_new(ViolationType.FORK_BOMB, "process count exceeds limit");
    }
    return 0;
}

# Returns GuardViolation ptr if duration is anomalous, 0 otherwise.
# multiplier_x100 = 200 means "2.0x expected".
fn check_time_anomaly(duration_ms, expected_ms, config) {
    var threshold = expected_ms * RuntimeGuardConfig_time_anomaly_multiplier_x100(config) / 100;
    if (duration_ms > threshold) {
        return guard_violation_new(ViolationType.TIME_ANOMALY, "execution duration anomalous");
    }
    return 0;
}

# ---- Sandbox integrity monitoring ---------------------------------------
# Ported from rust-old/src/scanning/runtime.rs check_integrity(). Reads
# /proc to verify the current process is in a separate PID, mount, and
# user namespace from the host. Used by callers that want to assert
# isolation is actually in effect before proceeding with sensitive work.

#derive(accessors)
struct IntegrityCheck {
    name;
    passed;
    detail;
}

fn _integrity_check_new(name, passed, detail) {
    var c = alloc(24);
    IntegrityCheck_set_name(c, name);
    IntegrityCheck_set_passed(c, passed);
    IntegrityCheck_set_detail(c, detail);
    return c;
}

#derive(accessors)
struct IntegrityReport {
    intact;
    checks;
    checked_at;
}

fn runtime_integrity_report_new() {
    var r = alloc(24);
    IntegrityReport_set_intact(r, 0);
    IntegrityReport_set_checks(r, vec_new());
    IntegrityReport_set_checked_at(r, 0);
    return r;
}

# PID namespace check: /proc/1/cmdline should not contain 'systemd' or
# 'init'. If the read fails (e.g. /proc masked), assume isolated — the
# caller can't see host state anyway.
fn _integrity_check_pid_ns() {
    var buf = alloc(512);
    # Read at most size-1 so the NUL terminator below always lands inside the
    # allocation — file_read_all can fill the whole buffer otherwise, making
    # store8(buf + n, 0) a one-byte heap overflow (matches cgroup_supported).
    var n = file_read_all("/proc/1/cmdline", buf, 511);
    if (n <= 0) {
        return _integrity_check_new("pid_namespace", 1, "proc not readable (assume isolated)");
    }
    store8(buf + n, 0);
    if (cstr_contains(buf, "systemd") == 1) {
        return _integrity_check_new("pid_namespace", 0, "host systemd visible as PID 1");
    }
    if (cstr_contains(buf, "/init") == 1) {
        return _integrity_check_new("pid_namespace", 0, "host init visible as PID 1");
    }
    return _integrity_check_new("pid_namespace", 1, "PID namespace isolated");
}

# Mount namespace check: /proc/mounts should not expose host /home
# unless overlay-mounted (containers commonly overlay user dirs).
fn _integrity_check_mount_ns() {
    var buf = alloc(8192);
    # size-1 read limit — see _integrity_check_pid_ns for the rationale.
    var n = file_read_all("/proc/mounts", buf, 8191);
    if (n <= 0) {
        return _integrity_check_new("mount_namespace", 1, "/proc/mounts not readable");
    }
    store8(buf + n, 0);
    if (cstr_contains(buf, "/home/") == 1) {
        if (cstr_contains(buf, "overlay") == 0) {
            return _integrity_check_new("mount_namespace", 0, "host /home visible");
        }
    }
    return _integrity_check_new("mount_namespace", 1, "mount namespace isolated");
}

# User namespace check: /proc/self/uid_map should be non-empty when a
# user namespace is in effect.
fn _integrity_check_user_ns() {
    var buf = alloc(256);
    # size-1 read limit — see _integrity_check_pid_ns for the rationale.
    var n = file_read_all("/proc/self/uid_map", buf, 255);
    if (n <= 0) {
        return _integrity_check_new("user_namespace", 0, "no UID mapping");
    }
    store8(buf + n, 0);
    if (n < 4) {
        return _integrity_check_new("user_namespace", 0, "UID map suspiciously small");
    }
    return _integrity_check_new("user_namespace", 1, "user namespace active");
}

fn check_integrity() {
    var report = runtime_integrity_report_new();
    IntegrityReport_set_checked_at(report, clock_epoch_secs());
    var checks = IntegrityReport_checks(report);

    var c1 = _integrity_check_pid_ns();
    var c2 = _integrity_check_mount_ns();
    var c3 = _integrity_check_user_ns();
    vec_push(checks, c1);
    vec_push(checks, c2);
    vec_push(checks, c3);

    var intact = 1;
    if (IntegrityCheck_passed(c1) == 0) { intact = 0; }
    if (IntegrityCheck_passed(c2) == 0) { intact = 0; }
    if (IntegrityCheck_passed(c3) == 0) { intact = 0; }
    IntegrityReport_set_intact(report, intact);
    return report;
}

# --- scanning_threat.cyr ---

# kavach — threat classification (intent scoring + kill-chain)
# Ported from rust-old/src/scanning/threat.rs
#
# Cyrius i64 arithmetic; Rust floats are expressed as fixed-point x1000:
#   intent_score 0..1000 represents 0.000..1.000.
# OffenderTracker (time-decay + agent keying) landed in v3.0 using
# chrono + rand_u64 — see bottom of file.

enum KillChainStage {
    RECONNAISSANCE = 0;
    WEAPONIZATION = 1;
    DELIVERY = 2;
    EXPLOITATION = 3;
    INSTALLATION = 4;
    COMMAND_AND_CONTROL = 5;
    EXFILTRATION = 6;
}

fn kill_chain_stage_name(s) {
    if (s == KillChainStage.RECONNAISSANCE) { return "reconnaissance"; }
    if (s == KillChainStage.WEAPONIZATION) { return "weaponization"; }
    if (s == KillChainStage.DELIVERY) { return "delivery"; }
    if (s == KillChainStage.EXPLOITATION) { return "exploitation"; }
    if (s == KillChainStage.INSTALLATION) { return "installation"; }
    if (s == KillChainStage.COMMAND_AND_CONTROL) { return "command_and_control"; }
    if (s == KillChainStage.EXFILTRATION) { return "exfiltration"; }
    return "unknown";
}

enum ThreatTier {
    BENIGN = 0;
    SUSPICIOUS = 1;
    LIKELY_MALICIOUS = 2;
    MALICIOUS = 3;
}

enum EscalationTier {
    TIER1_LOG = 0;
    TIER2_ALERT = 1;
    TIER3_SUSPEND = 2;
    TIER4_REVOKE = 3;
}

fn threat_tier_name(t) {
    if (t == ThreatTier.BENIGN) { return "benign"; }
    if (t == ThreatTier.SUSPICIOUS) { return "suspicious"; }
    if (t == ThreatTier.LIKELY_MALICIOUS) { return "likely_malicious"; }
    if (t == ThreatTier.MALICIOUS) { return "malicious"; }
    return "unknown";
}

fn escalation_tier_name(e) {
    if (e == EscalationTier.TIER1_LOG) { return "tier1_log"; }
    if (e == EscalationTier.TIER2_ALERT) { return "tier2_alert"; }
    if (e == EscalationTier.TIER3_SUSPEND) { return "tier3_suspend"; }
    if (e == EscalationTier.TIER4_REVOKE) { return "tier4_revoke"; }
    return "unknown";
}

#derive(accessors)
struct ThreatAssessment {
    intent_score_x1000;
    classification;
    escalation;
    kill_chain_stages;
    finding_count;
}

fn _severity_weight_x1000(sev) {
    if (sev == Severity.INFO) { return 50; }
    if (sev == Severity.LOW) { return 150; }
    if (sev == Severity.MEDIUM) { return 350; }
    if (sev == Severity.HIGH) { return 600; }
    if (sev == Severity.CRITICAL) { return 900; }
    return 0;
}

# Map a finding category to its kill-chain stage. Returns -1 if no mapping.
fn _category_to_stage(category) {
    if (streq(category, "pii_network") == 1) { return KillChainStage.RECONNAISSANCE; }
    if (streq(category, "obfuscation") == 1) { return KillChainStage.WEAPONIZATION; }
    if (streq(category, "crypto_misuse") == 1) { return KillChainStage.WEAPONIZATION; }
    if (streq(category, "supply_chain") == 1) { return KillChainStage.DELIVERY; }
    if (streq(category, "command_injection") == 1) { return KillChainStage.EXPLOITATION; }
    if (streq(category, "privilege_escalation") == 1) { return KillChainStage.EXPLOITATION; }
    if (streq(category, "filesystem_abuse") == 1) { return KillChainStage.INSTALLATION; }
    if (streq(category, "data_exfiltration") == 1) { return KillChainStage.COMMAND_AND_CONTROL; }
    if (streq(category, "cloud_credential") == 1) { return KillChainStage.EXFILTRATION; }
    if (streq(category, "api_token") == 1) { return KillChainStage.EXFILTRATION; }
    if (streq(category, "auth_token") == 1) { return KillChainStage.EXFILTRATION; }
    if (streq(category, "private_key") == 1) { return KillChainStage.EXFILTRATION; }
    if (streq(category, "connection_string") == 1) { return KillChainStage.EXFILTRATION; }
    if (streq(category, "credential") == 1) { return KillChainStage.EXFILTRATION; }
    if (streq(category, "pii") == 1) { return KillChainStage.EXFILTRATION; }
    if (streq(category, "pii_financial") == 1) { return KillChainStage.EXFILTRATION; }
    return 0 - 1;
}

fn _vec_contains_stage(v, stage) {
    var i = 0;
    while (i < vec_len(v)) {
        if (vec_get(v, i) == stage) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Classify findings (vec<ScanFinding>) into a ThreatAssessment.
fn classify_threat(findings) {
    var assessment = alloc(40);
    ThreatAssessment_set_finding_count(assessment, vec_len(findings));
    ThreatAssessment_set_kill_chain_stages(assessment, vec_new());

    if (vec_len(findings) == 0) {
        ThreatAssessment_set_intent_score_x1000(assessment, 0);
        ThreatAssessment_set_classification(assessment, ThreatTier.BENIGN);
        ThreatAssessment_set_escalation(assessment, EscalationTier.TIER1_LOG);
        return assessment;
    }

    var raw_x1000 = 0;
    var stages = vec_new();
    var i = 0;
    while (i < vec_len(findings)) {
        var f = vec_get(findings, i);
        raw_x1000 = raw_x1000 + _severity_weight_x1000(ScanFinding_severity(f));
        var st = _category_to_stage(ScanFinding_category(f));
        if (st >= 0) {
            if (_vec_contains_stage(stages, st) == 0) { vec_push(stages, st); }
        }
        i = i + 1;
    }
    ThreatAssessment_set_kill_chain_stages(assessment, stages);

    # Co-occurrence amplifier (x1000):
    #   >= 3 stages -> 1.5x (1500)
    #   >= 2 stages -> 1.3x (1300)
    #   else         -> 1.0x (1000)
    var amp = 1000;
    if (vec_len(stages) >= 3) { amp = 1500; }
    elif (vec_len(stages) >= 2) { amp = 1300; }

    var intent = raw_x1000 * amp / 1000;
    if (intent > 1000) { intent = 1000; }
    ThreatAssessment_set_intent_score_x1000(assessment, intent);

    var cls = ThreatTier.BENIGN;
    if (intent >= 200) { cls = ThreatTier.SUSPICIOUS; }
    if (intent >= 500) { cls = ThreatTier.LIKELY_MALICIOUS; }
    if (intent >= 800) { cls = ThreatTier.MALICIOUS; }
    ThreatAssessment_set_classification(assessment, cls);

    var esc = EscalationTier.TIER1_LOG;
    if (cls == ThreatTier.SUSPICIOUS) { esc = EscalationTier.TIER2_ALERT; }
    if (cls == ThreatTier.LIKELY_MALICIOUS) { esc = EscalationTier.TIER3_SUSPEND; }
    if (cls == ThreatTier.MALICIOUS) { esc = EscalationTier.TIER4_REVOKE; }
    ThreatAssessment_set_escalation(assessment, esc);

    return assessment;
}

# ---- Repeat-offender tracking --------------------------------------------
# Ported from rust-old/src/scanning/threat.rs OffenderTracker. Each
# agent_id accumulates a weighted violation score that decays with time
# (half-life = half the rolling window). When the agent's decayed score
# exceeds the escalation_threshold_x1000, should_escalate() returns 1.
#
# Storage: three parallel vecs keyed by insertion order. A violation
# record is (agent_id cstr, score_x1000, timestamp_secs). Pruning
# drops records older than window_secs.

#derive(accessors)
struct OffenderTracker {
    window_secs;
    decay_factor_x1000;
    escalation_threshold_x1000;
    records;
}

#derive(accessors)
struct ViolationRecord {
    timestamp_secs;
    score_x1000;
    agent_id;
}

fn _violation_record_new(ts, score, agent_id) {
    var r = alloc(24);
    ViolationRecord_set_timestamp_secs(r, ts);
    ViolationRecord_set_score_x1000(r, score);
    ViolationRecord_set_agent_id(r, agent_id);
    return r;
}

# Defaults match Rust:
#   window_secs=3600 (1h), decay=0.5 per half-window, threshold=3.0 score
fn offender_tracker_new() {
    var t = alloc(32);
    OffenderTracker_set_window_secs(t, 3600);
    OffenderTracker_set_decay_factor_x1000(t, 500);
    OffenderTracker_set_escalation_threshold_x1000(t, 3000);
    OffenderTracker_set_records(t, vec_new());
    return t;
}

fn offender_tracker_with_config(window_secs, decay_x1000, threshold_x1000) {
    if (window_secs <= 0) { return 0; }
    var t = alloc(32);
    OffenderTracker_set_window_secs(t, window_secs);
    OffenderTracker_set_decay_factor_x1000(t, decay_x1000);
    OffenderTracker_set_escalation_threshold_x1000(t, threshold_x1000);
    OffenderTracker_set_records(t, vec_new());
    return t;
}

# Record a violation. Intent score comes from a ThreatAssessment
# (intent_score_x1000). Duplicate agent_ids accumulate across records;
# decay is applied at query time, not at insert.
fn offender_tracker_record(tracker, agent_id, assessment) {
    var now = clock_epoch_secs();
    var score = ThreatAssessment_intent_score_x1000(assessment);
    var rec = _violation_record_new(now, score, agent_id);
    vec_push(OffenderTracker_records(tracker), rec);
    return 0;
}

# Walk records, drop those older than window. Called implicitly by
# agent_score; callers can invoke manually after a burst.
fn offender_tracker_prune(tracker) {
    var now = clock_epoch_secs();
    var window = OffenderTracker_window_secs(tracker);
    var recs = OffenderTracker_records(tracker);
    var keep = vec_new();
    var i = 0;
    while (i < vec_len(recs)) {
        var r = vec_get(recs, i);
        if (now - ViolationRecord_timestamp_secs(r) <= window) {
            vec_push(keep, r);
        }
        i = i + 1;
    }
    OffenderTracker_set_records(tracker, keep);
    return 0;
}

# Compute decayed score for an agent. Each record's contribution is
# multiplied by (decay_factor)^(age / half_window) — age is rounded to
# half-windows to stay in i64-land without floats. After N half-lives,
# contribution is score * (decay^N) via repeated division.
fn offender_tracker_agent_score(tracker, agent_id) {
    offender_tracker_prune(tracker);
    var now = clock_epoch_secs();
    var half_window = OffenderTracker_window_secs(tracker) / 2;
    if (half_window <= 0) { half_window = 1; }
    var decay = OffenderTracker_decay_factor_x1000(tracker);
    var recs = OffenderTracker_records(tracker);
    var total = 0;
    var i = 0;
    while (i < vec_len(recs)) {
        var r = vec_get(recs, i);
        if (streq(ViolationRecord_agent_id(r), agent_id) == 1) {
            var age = now - ViolationRecord_timestamp_secs(r);
            var half_lives = age / half_window;
            var contribution = ViolationRecord_score_x1000(r);
            var k = 0;
            while (k < half_lives) {
                contribution = contribution * decay / 1000;
                if (contribution == 0) { break; }
                k = k + 1;
            }
            total = total + contribution;
        }
        i = i + 1;
    }
    return total;
}

fn offender_tracker_should_escalate(tracker, agent_id) {
    var score = offender_tracker_agent_score(tracker, agent_id);
    if (score >= OffenderTracker_escalation_threshold_x1000(tracker)) { return 1; }
    return 0;
}

fn offender_tracker_count(tracker) {
    return vec_len(OffenderTracker_records(tracker));
}

# --- audit.cyr ---

# kavach — HMAC-SHA256 audit chain (append-only, tamper-evident)
# Ported from rust-old/src/scanning/audit.rs
#
# Each entry:
#   serial (u64) | event_type (cstr) | payload (cstr) | timestamp | hmac | prev_hmac
# HMAC is computed over "serial:event_type:payload:timestamp:prev_hmac"
# using a caller-supplied key. File format is JSONL; verify walks linearly.
#
# Deferred vs Rust:
#   - payload is pre-serialized cstr, not serde_json::Value (cleaner anyway)
#   - timestamp is epoch-seconds decimal, not ISO 8601 rfc3339
#   - reopen/verify-on-open is stubbed until fs line-read is wired

# 3.14.8: the chain's lock. Included here so `dist/kavach.deps` names them.
include "lib/atomic.cyr"
include "lib/sync.cyr"

# ---- Hex encoding --------------------------------------------------------

var _HEX_CHARS = "0123456789abcdef";

# Hex-encode 32 bytes into a 65-byte output buffer (64 hex + NUL).
fn hex_encode32(bytes, out) {
    var i = 0;
    while (i < 32) {
        var b = load8(bytes + i);
        var hi = (b >> 4) & 15;
        var lo = b & 15;
        store8(out + i * 2, load8(_HEX_CHARS + hi));
        store8(out + i * 2 + 1, load8(_HEX_CHARS + lo));
        i = i + 1;
    }
    store8(out + 64, 0);
    return 0;
}

# ---- KavachAuditEntry ----------------------------------------------------
#
# ⚠ PREFIXED NAME, DELIBERATELY (3.12.9). As `AuditEntry` its derived accessors
# (`AuditEntry_timestamp`, `AuditEntry_set_timestamp`) were also generated by
# stiva's own `struct AuditEntry`, a kavach consumer. The layouts differ
# (`timestamp` is field 3 here and field 0 in stiva), and under
# last-definition-wins one pair served both: whichever lost read and wrote the
# other struct's slot.

#derive(accessors)
struct KavachAuditEntry {
    serial;
    event_type;
    payload;
    timestamp;
    hmac;
    prev_hmac;
}

# ⚠ PREFIXED NAME, DELIBERATELY. `audit_entry_new` collided with agnostik's
# `audit_entry_new(id, agent_id, action, severity)` — a DIFFERENT type at a
# different arity. Any consumer vendoring both (aethersafha) got "last definition
# wins", so calls to the loser silently mis-bound. cyrius 6.6.2 makes a same-name
# different-arity duplicate a hard error, which is what surfaced it. kavach's is
# the one that moved: one caller here, against agnostik's five.
fn kavach_audit_entry_new() {
    var e = alloc(48);
    KavachAuditEntry_set_event_type(e, "");
    KavachAuditEntry_set_payload(e, "");
    KavachAuditEntry_set_timestamp(e, "");
    KavachAuditEntry_set_hmac(e, "");
    KavachAuditEntry_set_prev_hmac(e, "");
    return e;
}

# ---- AuditChain ----------------------------------------------------------

# `lock` (3.14.8): held from reading the chain's head to writing the next one.
# `sandbox_exec` records to one process-wide chain (`sandbox_exec_set_audit_chain`),
# and two records at once read the same head: two entries with one serial and one
# `prev_hmac`, so the log no longer verifies as a chain.
#derive(accessors)
struct AuditChain {
    log_path;
    hmac_key;
    hmac_key_len;
    last_hmac;
    next_serial;
    lock;
}

var AUDIT_CHAIN_SIZE = 48;

# The mutex in `*cell`, made on first use (3.14.8). The first thread to publish
# one wins and every other uses it, so a lock nobody made at startup is still one
# lock. Never 0 unless the allocator is out.
fn kavach_lock_cell(cell) {
    var m = atomic_load(cell);
    if (m != 0) { return m; }
    var fresh = mutex_new();
    if (fresh == 0) { return 0; }
    if (atomic_cas(cell, 0, fresh) == 1) { return fresh; }
    return atomic_load(cell);
}

# Compute HMAC-SHA256 over a cstr message; return 65-byte hex cstr.
# Returns 0 on null msg (propagated overflow from upstream).
fn _hmac_hex(key, key_len, msg) {
    if (msg == 0) { return 0; }
    var raw[32];
    hmac_sha256(key, key_len, msg, strlen(msg), &raw);
    var out = alloc(65);
    hex_encode32(&raw, out);
    return out;
}

# Build the signing input: serial:event_type:payload:timestamp:prev_hmac
# Sizes are checked-summed to defend against overflow — if any input
# is malformed, returns 0 and the HMAC site will observe a null msg.
# (All callers already guard against a null return before hashing.)
fn _sign_input(serial, event_type, payload, timestamp, prev_hmac) {
    var serial_buf[24];
    var serial_len = fmt_int_buf(serial, &serial_buf);
    var user_lens = checked_sum4(strlen(event_type), strlen(payload),
      strlen(timestamp), strlen(prev_hmac));
    if (user_lens < 0) { return 0; }
    var total = checked_add(user_lens, serial_len + 5);
    if (total < 0) { return 0; }
    var buf = alloc_checked(total);
    if (buf == 0) { return 0; }
    var pos = 0;
    memcpy(buf + pos, &serial_buf, serial_len); pos = pos + serial_len;
    store8(buf + pos, 58); pos = pos + 1;
    memcpy(buf + pos, event_type, strlen(event_type)); pos = pos + strlen(event_type);
    store8(buf + pos, 58); pos = pos + 1;
    memcpy(buf + pos, payload, strlen(payload)); pos = pos + strlen(payload);
    store8(buf + pos, 58); pos = pos + 1;
    memcpy(buf + pos, timestamp, strlen(timestamp)); pos = pos + strlen(timestamp);
    store8(buf + pos, 58); pos = pos + 1;
    memcpy(buf + pos, prev_hmac, strlen(prev_hmac)); pos = pos + strlen(prev_hmac);
    store8(buf + pos, 0);
    return buf;
}

# JSONL serializer. Event_type and payload are user-controllable, so both
# pass through oci_json_escape (full RFC-8259 control-char escaping).
# Timestamp is epoch-seconds decimal (digits-only; no escape needed).
# Hmac + prev_hmac are hex (64 chars or empty; no escape needed).
# See ADR-005 §C2.
fn _entry_to_jsonl(entry) {
    var serial_buf[24];
    var slen = fmt_int_buf(KavachAuditEntry_serial(entry), &serial_buf);
    var ev = oci_json_escape(KavachAuditEntry_event_type(entry));
    var pl = oci_json_escape(KavachAuditEntry_payload(entry));
    var ts = KavachAuditEntry_timestamp(entry);
    var h = KavachAuditEntry_hmac(entry);
    var ph = KavachAuditEntry_prev_hmac(entry);
    var user_lens = checked_sum4(strlen(ev), strlen(pl), strlen(ts),
      strlen(h) + strlen(ph));
    if (user_lens < 0) { return 0; }
    var cap = checked_add(user_lens, slen + 256);
    if (cap < 0) { return 0; }
    var buf = alloc_checked(cap);
    if (buf == 0) { return 0; }
    var pos = 0;
    var prefix = "{\"serial\":";
    memcpy(buf + pos, prefix, strlen(prefix)); pos = pos + strlen(prefix);
    memcpy(buf + pos, &serial_buf, slen); pos = pos + slen;
    var k1 = ",\"event_type\":\"";
    memcpy(buf + pos, k1, strlen(k1)); pos = pos + strlen(k1);
    memcpy(buf + pos, ev, strlen(ev)); pos = pos + strlen(ev);
    var k2 = "\",\"payload\":\"";
    memcpy(buf + pos, k2, strlen(k2)); pos = pos + strlen(k2);
    memcpy(buf + pos, pl, strlen(pl)); pos = pos + strlen(pl);
    var k3 = "\",\"timestamp\":\"";
    memcpy(buf + pos, k3, strlen(k3)); pos = pos + strlen(k3);
    memcpy(buf + pos, ts, strlen(ts)); pos = pos + strlen(ts);
    var k4 = "\",\"hmac\":\"";
    memcpy(buf + pos, k4, strlen(k4)); pos = pos + strlen(k4);
    memcpy(buf + pos, h, strlen(h)); pos = pos + strlen(h);
    var k5 = "\",\"prev_hmac\":\"";
    memcpy(buf + pos, k5, strlen(k5)); pos = pos + strlen(k5);
    memcpy(buf + pos, ph, strlen(ph)); pos = pos + strlen(ph);
    var k6 = "\"}\n";
    memcpy(buf + pos, k6, strlen(k6)); pos = pos + strlen(k6);
    store8(buf + pos, 0);
    return buf;
}

# ---- Log append ----------------------------------------------------------

# Append one serialized record to the log at `path`, all or nothing. Returns
# `len`, or a negative errno with the log byte-for-byte as it was — unless the
# cut-back itself fails (see SAFETY below), which is reported on stderr.
#
# ⛔ WHY NOT THE STDLIB'S file_append_locked. Since cyrius 6.6.6 it refuses a
# short write instead of calling it success, so the chain head no longer
# advances over a torn record — but the bytes that did land stay at the tail.
# The next record is appended straight onto that partial line, and the merged
# line parses as neither: the refused record takes the next good one with it.
# Measured on 3.12.6 (2 KB records, RLIMIT_FSIZE 4 KiB): a 1,685-byte torn
# tail, and the next process's genesis record lost inside it. So kavach does
# its own append:
#   * the open creates the file at 0600, closing the create-at-0644-then-chmod
#     window (ADR-005 §C4);
#   * the pre-append length is read under LOCK_EX, and a short write is cut
#     back to it before the lock is released.
#
# ⚠ ONE write, NOT a full-write loop. A regular file writes short only at a
# size limit, a full disk or quota, or a fatal signal, and a retry finishes the
# record in none of them. Under RLIMIT_FSIZE the retry is worse than useless:
# it starts AT the limit, which is the write the kernel answers with SIGXFSZ,
# and the default action kills the process before any rollback runs (measured:
# exit 153, torn tail left). A write that stops short of the limit raises
# nothing.
#
# A record also starts on a line of its own. The rollback cannot remove every
# torn record: a writer killed inside its write, agnos (sys_ftruncate is
# -ENOSYS) and an append-only log (chattr +a) all leave one at the tail, and a
# record appended straight onto it would merge into a line that parses as
# neither. So under the lock, when the log does not end in "\n", the record
# goes out with one in front of it, in the same single write. The fragment
# keeps a line of its own. Only a byte actually read decides: a failed read
# adds nothing.
fn _audit_append(path, line, len) {
    var fd = file_open(path, O_RDWR | O_CREAT | O_APPEND, 384);   # 0600; RDWR reads the last byte
    if (fd < 0) { return fd; }
    #ifndef CYRIUS_TARGET_AGNOS
    # Best effort, as the per-append chmod it replaces was: a log an older
    # kavach created at 0644, or someone else created, still ends up 0600.
    # fchmod, so the mode lands on the file this fd writes rather than on
    # whatever the path names by now. agnos has no fchmod.
    sys_fchmod(fd, 384);
    #endif
    # The rollback is only safe under the lock: no lock, no append.
    var lk = file_lock(fd);
    while (lk == 0 - 4) { lk = file_lock(fd); }   # EINTR: a signal handler ran
    if (lk < 0) {
        file_close(fd);
        return lk;
    }
    # The pre-append length, and the append offset on agnos (its kernel does
    # not honour O_APPEND yet). Negative on a pipe or tty: nothing to cut back.
    var base = xlseek(fd, 0, 2);
    var out = line;
    var olen = len;
    if (base > 0) {
        var last[8];
        var got = 0;
        if (xlseek(fd, base - 1, 0) == base - 1) { got = file_read(fd, &last, 1); }
        if (got != 1) {
            # Put the offset back at the end: agnos writes at it, and a failed
            # read must not leave this record over the log's last byte.
            xlseek(fd, base, 0);
        }
        elif (load8(&last) != 10) {
            out = alloc(len + 1);
            store8(out, 10);
            memcpy(out + 1, line, len);
            olen = len + 1;
        }
    }
    var n = file_write(fd, out, olen);
    if (n == olen) { n = len; }
    else {
        if (n > 0) {
            var cut = 0 - 1;
            # SAFETY: LOCK_EX has been held on this fd since `base` was read,
            # and every writer of an audit log appends through this function,
            # so the file grew by exactly our `n` bytes; truncating to `base`
            # removes the torn record and nothing else. Shrinking a file is
            # never refused by RLIMIT_FSIZE or ENOSPC, so the conditions that
            # cause a short write cannot also block its repair. The cut does
            # fail, and says so below, on agnos (sys_ftruncate is -ENOSYS)
            # and on a file marked append-only (chattr +a).
            if (base >= 0) { cut = sys_ftruncate(fd, base); }
            if (cut < 0) {
                kavach_err_print(KAVACH_ERR_IO_ERROR,
                  "audit chain: a torn record could not be removed from the log");
            }
        }
        if (n >= 0) { n = 0 - 5; }   # short write: -EIO
    }
    file_unlock(fd);
    file_close(fd);
    return n;
}

# Open (or create) an audit chain at log_path with the given HMAC key.
# If the path exists, the file is left in place and the chain resumes from
# wherever the caller last recorded — file-based reload/verify is a TODO.
fn audit_chain_open(log_path, hmac_key, hmac_key_len) {
    sha256_global_init();
    var c = alloc(AUDIT_CHAIN_SIZE);
    AuditChain_set_lock(c, 0);
    AuditChain_set_log_path(c, log_path);
    AuditChain_set_hmac_key(c, hmac_key);
    AuditChain_set_hmac_key_len(c, hmac_key_len);
    AuditChain_set_last_hmac(c, "");
    AuditChain_set_next_serial(c, 0);

    # Emit genesis entry
    audit_chain_record(c, "genesis", "audit chain initialized");
    return c;
}

# Record an event. event_type and payload must be cstrs; payload should be
# pre-serialized (no escape handling here).
fn audit_chain_record(chain, event_type, payload) {
    # SAFETY: `lock` is the chain's sixth field, at +40 of AUDIT_CHAIN_SIZE (48),
    # which `audit_chain_open` allocates and zeroes.
    var m = kavach_lock_cell(chain + 40);
    if (m != 0) { mutex_lock(m); }
    var entry = _audit_chain_record_locked(chain, event_type, payload);
    if (m != 0) { mutex_unlock(m); }
    return entry;
}

fn _audit_chain_record_locked(chain, event_type, payload) {
    var serial = AuditChain_next_serial(chain);
    var ts_buf[24];
    var ts_len = fmt_int_buf(clock_epoch_secs(), &ts_buf);
    var timestamp = alloc(ts_len + 1);
    memcpy(timestamp, &ts_buf, ts_len);
    store8(timestamp + ts_len, 0);

    var prev = AuditChain_last_hmac(chain);
    var msg = _sign_input(serial, event_type, payload, timestamp, prev);
    var hmac_hex = _hmac_hex(AuditChain_hmac_key(chain),
      AuditChain_hmac_key_len(chain), msg);

    var entry = kavach_audit_entry_new();
    KavachAuditEntry_set_serial(entry, serial);
    KavachAuditEntry_set_event_type(entry, event_type);
    KavachAuditEntry_set_payload(entry, payload);
    KavachAuditEntry_set_timestamp(entry, timestamp);
    KavachAuditEntry_set_hmac(entry, hmac_hex);
    KavachAuditEntry_set_prev_hmac(entry, prev);

    var line = _entry_to_jsonl(entry);
    # All or nothing (see _audit_append): a refused record leaves the log as it
    # was and the chain head where it was, so the next record starts on a line
    # of its own.
    if (_audit_append(AuditChain_log_path(chain), line, strlen(line)) < 0) {
        kavach_err_print(KAVACH_ERR_IO_ERROR, "audit chain write failed");
        return 0;
    }

    AuditChain_set_last_hmac(chain, hmac_hex);
    AuditChain_set_next_serial(chain, serial + 1);
    return entry;
}

fn audit_chain_len(chain) {
    return AuditChain_next_serial(chain);
}

# Recompute hmac for an AuditEntry using `key` and compare to entry.hmac.
# Uses constant-time comparison (ct_streq → sigil ct_eq) to prevent timing
# side-channel attacks on the signing key. See ADR-005 §C1.
# Returns 1 if valid, 0 otherwise.
fn audit_entry_verify(entry, key, key_len) {
    var msg = _sign_input(KavachAuditEntry_serial(entry),
      KavachAuditEntry_event_type(entry),
      KavachAuditEntry_payload(entry),
      KavachAuditEntry_timestamp(entry),
      KavachAuditEntry_prev_hmac(entry));
    var expected = _hmac_hex(key, key_len, msg);
    return ct_streq(expected, KavachAuditEntry_hmac(entry));
}

# Zero the HMAC key buffer. Callers that no longer need a chain should
# invoke this to minimize key-material exposure in core dumps or swap.
# Uses sigil's zeroize_key (sigil/dist/sigil.cyr:2834) which is compiler
# barrier-protected against dead-store elimination.
fn audit_chain_close(chain) {
    var key = AuditChain_hmac_key(chain);
    var key_len = AuditChain_hmac_key_len(chain);
    if (key != 0) {
        if (key_len > 0) { zeroize_key(key, key_len); }
    }
    AuditChain_set_hmac_key(chain, 0);
    AuditChain_set_hmac_key_len(chain, 0);
    return 0;
}

# --- credential.cyr ---

# kavach — credential proxy (SecretRef + direct injection)
# Ported from rust-old/src/credential/mod.rs
#
# Three injection methods: env var, file, stdin.
# HTTP proxy layer is a separate module (deferred — needs http/tls).

# **Prefixed, deliberately (3.12.9).** These were `ENV_VAR`, `FILE` and `STDIN`.
# cyrius hoists enum members to global names under last-definition-wins, and the
# `InjectionMethod.` qualifier is cosmetic, so the stdlib's `var STDIN = 0`
# (`lib/io.cyr`) could win in a consumer. Then STDIN equalled ENV_VAR:
# `credential_proxy_env_vars` returned each stdin secret as an env pair with a
# null variable name, and `credential_proxy_stdin_payload` picked up every
# env-var secret too. Filed from agnosai; see
# docs/development/issues/archived/2026-08-22-injectionmethod-stdin-aliases-env-var.md.
enum InjectionMethod {
    KAVACH_INJECT_ENV_VAR = 0;
    KAVACH_INJECT_FILE = 1;
    KAVACH_INJECT_STDIN = 2;
}

#derive(accessors)
struct SecretRef {
    name;
    inject_via;
    param1;
    param2;
}

# Build a SecretRef for env-var injection.
fn secret_ref_env(name, var_name) {
    var r = alloc(32);
    SecretRef_set_name(r, name);
    SecretRef_set_inject_via(r, KAVACH_INJECT_ENV_VAR);
    SecretRef_set_param1(r, var_name);
    SecretRef_set_param2(r, 0);
    return r;
}

# Build a SecretRef for file injection (mode is octal, e.g. 0o600 = 384).
fn secret_ref_file(name, path, mode) {
    var r = alloc(32);
    SecretRef_set_name(r, name);
    SecretRef_set_inject_via(r, KAVACH_INJECT_FILE);
    SecretRef_set_param1(r, path);
    SecretRef_set_param2(r, mode);
    return r;
}

fn secret_ref_stdin(name) {
    var r = alloc(32);
    SecretRef_set_name(r, name);
    SecretRef_set_inject_via(r, KAVACH_INJECT_STDIN);
    SecretRef_set_param1(r, 0);
    SecretRef_set_param2(r, 0);
    return r;
}

#derive(accessors)
struct FileInjection {
    path;
    content;
    mode;
}

fn file_injection_new(path, content, mode) {
    var f = alloc(24);
    FileInjection_set_path(f, path);
    FileInjection_set_content(f, content);
    FileInjection_set_mode(f, mode);
    return f;
}

# ---- CredentialProxy -----------------------------------------------------

#derive(accessors)
struct CredentialProxy {
    secrets;
}

fn credential_proxy_new() {
    var p = alloc(8);
    CredentialProxy_set_secrets(p, map_new());
    return p;
}

fn credential_proxy_register(proxy, name, value) {
    map_set(CredentialProxy_secrets(proxy), name, value);
    return 0;
}

# Returns resolved cstr or 0 (no match).
fn credential_proxy_resolve(proxy, secret_ref) {
    return map_get(CredentialProxy_secrets(proxy), SecretRef_name(secret_ref));
}

fn credential_proxy_len(proxy) {
    return map_count(CredentialProxy_secrets(proxy));
}

# Build env var pairs for ENV_VAR refs. Returns vec of interleaved
# (var_name, value) cstrs. Only refs that resolve are emitted.
fn credential_proxy_env_vars(proxy, refs) {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(refs)) {
        var r = vec_get(refs, i);
        if (SecretRef_inject_via(r) == KAVACH_INJECT_ENV_VAR) {
            var v = credential_proxy_resolve(proxy, r);
            if (v != 0) {
                vec_push(out, SecretRef_param1(r));
                vec_push(out, v);
            }
        }
        i = i + 1;
    }
    return out;
}

# Build FileInjection structs for FILE refs.
fn credential_proxy_file_injections(proxy, refs) {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(refs)) {
        var r = vec_get(refs, i);
        if (SecretRef_inject_via(r) == KAVACH_INJECT_FILE) {
            var v = credential_proxy_resolve(proxy, r);
            if (v != 0) {
                vec_push(out, file_injection_new(
                    SecretRef_param1(r), v, SecretRef_param2(r)));
            }
        }
        i = i + 1;
    }
    return out;
}

# Write each FileInjection in the vec to disk, honoring its `mode` field.
# Each file lands via file_write_secure_modal — O_CREAT|O_EXCL|O_NOFOLLOW
# at mode 0600, content written while still 0600 (no other-readable
# window), then fchmod to the FileInjection.mode before close (no TOCTOU
# window between write and chmod).
#
# ADR-005 §M2: closes the v3.0 gap where FileInjection.mode was stored
# but not honored. Returns the number of files successfully written; on
# any failure returns `-(n + 1)` where `n` is the count successful before
# the failure — caller can resume / report which injection broke.
fn credential_inject_files(injections) {
    var written = 0;
    var i = 0;
    while (i < vec_len(injections)) {
        var f = vec_get(injections, i);
        var content = FileInjection_content(f);
        var clen = strlen(content);
        var r = file_write_secure_modal(
          FileInjection_path(f), content, clen, FileInjection_mode(f));
        if (r < 0) { return 0 - (written + 1); }
        written = written + 1;
        i = i + 1;
    }
    return written;
}

# Join stdin-method secrets with newlines. Returns cstr or 0 if none.
fn credential_proxy_stdin_payload(proxy, refs) {
    var parts = vec_new();
    var total = 0;
    var i = 0;
    while (i < vec_len(refs)) {
        var r = vec_get(refs, i);
        if (SecretRef_inject_via(r) == KAVACH_INJECT_STDIN) {
            var v = credential_proxy_resolve(proxy, r);
            if (v != 0) {
                vec_push(parts, v);
                # Overflow-checked accumulation on attacker-influenced secret
                # lengths — bail to 0 rather than wrap into an undersized alloc.
                total = checked_add(total, strlen(v));
                if (total < 0) { return 0; }
            }
        }
        i = i + 1;
    }
    if (vec_len(parts) == 0) { return 0; }
    total = checked_add(total, vec_len(parts));
    if (total < 0) { return 0; }
    var buf = alloc_checked(total);
    if (buf == 0) { return 0; }
    var pos = 0;
    var j = 0;
    while (j < vec_len(parts)) {
        var s = vec_get(parts, j);
        var slen = strlen(s);
        memcpy(buf + pos, s, slen);
        pos = pos + slen;
        if (j + 1 < vec_len(parts)) {
            store8(buf + pos, 10);
            pos = pos + 1;
        }
        j = j + 1;
    }
    store8(buf + pos, 0);
    return buf;
}

# --- credential_http.cyr ---

# kavach — HTTP credential proxy (local-only)
#
# Closes ADR-004 §4: kavach exposes secrets to the sandbox over an HTTP
# endpoint on 127.0.0.1:<port> rather than via on-disk file injection.
# The sandbox makes `GET /v1/secret/<name>` calls; kavach serves them
# from CredentialProxy (in-memory store) with an allowlist gate. Every
# fetch hits the audit chain when one is wired.
#
# Threat model:
# - **Localhost-only.** Listener binds 127.0.0.1, never INADDR_ANY. A
#   peer outside the same loopback namespace can't reach the listener.
# - **Allowlist-bound.** Each proxy instance carries a vec of allowed
#   secret names. Fetches for names outside the allowlist return 403
#   without checking CredentialProxy (no oracle for "does this name
#   exist?").
# - **Audit-logged.** Every served fetch + every 403/404 is recorded
#   on the audit chain (when one is wired via the constructor).
# - **Secret never lands on disk.** Unlike file injection (which
#   writes secret-to-tmpfs-file), HTTP serves the bytes in-memory and
#   the sandbox process consumes them in-memory.
#
# Routes:
#   GET /v1/secret/<name>   200 with raw secret value, content-type text/plain
#                           403 if <name> not in this proxy's allowlist
#                           404 if <name> not registered with CredentialProxy
#   GET /v1/health          200 "ok"
#   *                       405 Method Not Allowed
#
# No TLS — by design. The listener is loopback-only; in a deployment that
# spans network namespaces, the consumer-side runs in the same netns as
# the kavach process via vsock or a unix-socket-relay shim (out of scope).

# ---- sandhi TLS-session-cache shims --------------------------------------
# sandhi 1.3.3 calls hashmap_new_a / hashmap_get / hashmap_set_a / hashmap_len
# from its TLS session-cache surface; the stdlib hashmap module exports the
# same surface under `map_*` names. The kavach HTTP credential proxy is
# loopback-only and never reaches the TLS session-cache code paths, but the
# linker still resolves the references at build time. These shims bridge
# the call gap so the build is warning-clean. If a future kavach feature
# wires sandhi as a TLS client (e.g. fetching secrets from a remote vault),
# revisit this — the shims will be load-bearing then. Tracked: file an
# upstream sandhi issue for the hashmap_ vs map_ naming inconsistency.
fn hashmap_new_a(a)              { return map_new_a(a); }
fn hashmap_get(h, k)             { return map_get(h, k); }
fn hashmap_set_a(a, h, k, v)     { return map_set_a(a, h, k, v); }
fn hashmap_len(h)                { return map_count(h); }

#derive(accessors)
struct CredentialHttpProxy {
    listen_fd;
    port;
    proxy_ref;
    allowed_names;
    audit_chain;
    request_count;
    denied_count;
    not_found_count;
    req_buf;
}

fn credential_http_proxy_new(proxy, allowed_vec, audit) {
    var h = alloc(72);
    CredentialHttpProxy_set_listen_fd(h, 0 - 1);
    CredentialHttpProxy_set_port(h, 0);
    CredentialHttpProxy_set_proxy_ref(h, proxy);
    CredentialHttpProxy_set_allowed_names(h, allowed_vec);
    CredentialHttpProxy_set_audit_chain(h, audit);
    CredentialHttpProxy_set_request_count(h, 0);
    CredentialHttpProxy_set_denied_count(h, 0);
    CredentialHttpProxy_set_not_found_count(h, 0);
    CredentialHttpProxy_set_req_buf(h, 0);
    return h;
}

# Bind to 127.0.0.1:<port> and start listening. Returns 0 on success,
# -1 on socket/bind/listen failure. Port 0 lets the kernel pick; the
# chosen port lands in the handle's `port` field (NOT auto-populated
# from getsockname today — caller should pass a chosen port).
#
# ⛔ Close-on-exec (3.12.9). The stdlib's `tcp_socket()` creates the socket
# without it, so every child kavach exec'd while the proxy was up inherited the
# listener: a persistent guest (which also did not close inherited fds) found it
# at fd 3 and could accept on it, reading secrets meant for other callers.
# Linux gets SOCK_CLOEXEC at creation, which leaves no window for a concurrent
# fork; agnos keeps `tcp_socket()`, having no exec to inherit across.
fn credential_http_proxy_listen(http, port) {
    #ifdef CYRIUS_TARGET_AGNOS
    var sock_res_t, sock_res_v = tcp_socket();
    if (is_err_result(sock_res_t) == 1) { return 0 - 1; }
    var fd = sock_res_v;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = sys_socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
    if (fd < 0) { return 0 - 1; }
    #endif
    sock_reuse(fd);
    var bind_res_t, bind_res_v = sock_bind(fd, INADDR_LOOPBACK(), port);
    if (is_err_result(bind_res_t) == 1) {
        sock_close(fd);
        return 0 - 1;
    }
    var listen_res_t, listen_res_v = sock_listen(fd, 8);
    if (is_err_result(listen_res_t) == 1) {
        sock_close(fd);
        return 0 - 1;
    }
    CredentialHttpProxy_set_listen_fd(http, fd);
    CredentialHttpProxy_set_port(http, port);
    return 0;
}

fn credential_http_proxy_close(http) {
    var fd = CredentialHttpProxy_listen_fd(http);
    if (fd >= 0) {
        sock_close(fd);
        CredentialHttpProxy_set_listen_fd(http, 0 - 1);
    }
    return 0;
}

# Linear allowlist check. Allowlists are expected to be small (<20 entries).
fn _http_allowed(http, name) {
    var allowed = CredentialHttpProxy_allowed_names(http);
    if (allowed == 0) { return 0; }
    var i = 0;
    while (i < vec_len(allowed)) {
        var n = vec_get(allowed, i);
        if (streq(n, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _http_audit(http, event, payload) {
    var chain = CredentialHttpProxy_audit_chain(http);
    if (chain != 0) { audit_chain_record(chain, event, payload); }
    return 0;
}

# Extract <name> from a path like "/v1/secret/<name>". Returns 0 if the
# path doesn't match the prefix. Returned cstr is a fresh allocation.
fn _http_extract_secret_name(path) {
    var prefix = "/v1/secret/";
    var plen = strlen(prefix);
    var path_len = strlen(path);
    if (path_len <= plen) { return 0; }
    var i = 0;
    while (i < plen) {
        if (load8(path + i) != load8(prefix + i)) { return 0; }
        i = i + 1;
    }
    var tail_len = path_len - plen;
    if (tail_len == 0) { return 0; }
    # Disallow any "/" in the suffix — secret names must be flat.
    var j = 0;
    while (j < tail_len) {
        if (load8(path + plen + j) == 47) { return 0; }
        j = j + 1;
    }
    var out = alloc(tail_len + 1);
    memcpy(out, path + plen, tail_len);
    store8(out + tail_len, 0);
    return out;
}

# Handle one accepted connection: parse, dispatch, respond, close.
# Returns 1 on a request fully served, 0 on a malformed-request short-circuit,
# -1 on socket error.
fn _http_handle_conn(http, conn_fd) {
    # One request buffer per proxy, reused (3.12.9). It was `alloc(8192)` per
    # request, and the bump allocator never frees: a long-lived proxy grew by
    # about 8.5 KB a request (measured by the 3.12.9 review) until it ran out.
    # Connections are served one at a time, so nothing else holds the buffer.
    var buf = CredentialHttpProxy_req_buf(http);
    if (buf == 0) {
        buf = alloc(8192);
        CredentialHttpProxy_set_req_buf(http, buf);
    }
    memset(buf, 0, 8192);
    var req_len = sandhi_server_recv_request(conn_fd, buf, 8191);
    if (req_len <= 0) {
        sock_close(conn_fd);
        return 0 - 1;
    }
    CredentialHttpProxy_set_request_count(http,
      CredentialHttpProxy_request_count(http) + 1);

    var method = sandhi_server_get_method(buf, req_len);
    var path = sandhi_server_get_path(buf, req_len);
    if (method == 0) { method = ""; }
    if (path == 0) { path = ""; }

    # GET only.
    if (streq(method, "GET") == 0) {
        sandhi_server_send_status(conn_fd, 405, "Method Not Allowed");
        sock_close(conn_fd);
        return 1;
    }

    # GET /v1/health
    if (streq(path, "/v1/health") == 1) {
        sandhi_server_send_response(conn_fd, 200, "OK",
          "text/plain", "ok", 2, 0);
        sock_close(conn_fd);
        return 1;
    }

    # GET /v1/secret/<name>
    var name = _http_extract_secret_name(path);
    if (name == 0) {
        sandhi_server_send_status(conn_fd, 404, "Not Found");
        _http_audit(http, "http_cred_404", path);
        sock_close(conn_fd);
        return 1;
    }

    if (_http_allowed(http, name) == 0) {
        sandhi_server_send_status(conn_fd, 403, "Forbidden");
        CredentialHttpProxy_set_denied_count(http,
          CredentialHttpProxy_denied_count(http) + 1);
        _http_audit(http, "http_cred_403", name);
        sock_close(conn_fd);
        return 1;
    }

    # Allowed — resolve from the in-memory proxy. We build a transient
    # SecretRef just to satisfy credential_proxy_resolve's signature; only
    # the .name field is consulted.
    var sr = secret_ref_env(name, "");
    var value = credential_proxy_resolve(
      CredentialHttpProxy_proxy_ref(http), sr);
    if (value == 0) {
        sandhi_server_send_status(conn_fd, 404, "Not Found");
        CredentialHttpProxy_set_not_found_count(http,
          CredentialHttpProxy_not_found_count(http) + 1);
        _http_audit(http, "http_cred_404", name);
        sock_close(conn_fd);
        return 1;
    }

    var vlen = strlen(value);
    sandhi_server_send_response(conn_fd, 200, "OK",
      "text/plain", value, vlen, 0);
    _http_audit(http, "http_cred_served", name);
    sock_close(conn_fd);
    return 1;
}

# Accept one pending connection (blocking) and serve it. Returns 1 if a
# request was processed, -1 on accept error. Designed for use in a
# polling loop; callers can interleave with other work.
fn credential_http_proxy_serve_one(http) {
    var fd = CredentialHttpProxy_listen_fd(http);
    if (fd < 0) { return 0 - 1; }
    # Each connection close-on-exec too (3.12.9), for the same reason as the
    # listener: it is open while a spawn on another thread may exec.
    #ifdef CYRIUS_TARGET_AGNOS
    var ar_t, ar_v = sock_accept(fd);
    if (is_err_result(ar_t) == 1) { return 0 - 1; }
    var conn_fd = ar_v;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var conn_fd = sys_accept4(fd, 0, 0, SOCK_CLOEXEC);
    if (conn_fd < 0) { return 0 - 1; }
    #endif
    return _http_handle_conn(http, conn_fd);
}

# Serve up to `max_requests` requests, then return. Returns count actually
# served. A value of 0 for max_requests means "serve until accept fails".
fn credential_http_proxy_serve(http, max_requests) {
    var served = 0;
    while (1) {
        if (max_requests > 0) {
            if (served >= max_requests) { return served; }
        }
        var r = credential_http_proxy_serve_one(http);
        if (r < 0) { return served; }
        served = served + 1;
    }
    return served;
}

# --- quarantine.cyr ---

# kavach — file-based quarantine storage
# Ported from rust-old/src/scanning/quarantine.rs
#
# Layout:
#   <base_dir>/<id>.bin        raw artifact bytes
#   <base_dir>/<id>.meta       JSON sidecar (sandbox_id, verdict, status, ts)
#
# UUID is replaced with a monotonic counter (padded decimal) for v3.0;
# full UUIDv4 waits on a random-bytes provider.

enum QuarantineStatus {
    QUARANTINED = 0;
    APPROVED = 1;
    RELEASED = 2;
    REJECTED = 3;
}

fn quarantine_status_name(s) {
    if (s == QuarantineStatus.QUARANTINED) { return "quarantined"; }
    if (s == QuarantineStatus.APPROVED) { return "approved"; }
    if (s == QuarantineStatus.RELEASED) { return "released"; }
    if (s == QuarantineStatus.REJECTED) { return "rejected"; }
    return "unknown";
}

#derive(accessors)
struct QuarantineStorage {
    base_dir;
    next_id;
}

fn quarantine_storage_new(base_dir) {
    # Mode 0700 — only owner may enter. EEXIST is acceptable for the
    # storage dir (unlike per-entry files) since operators intentionally
    # reuse the location across runs.
    kv_mkdir(base_dir, 448);
    # ⛔ Tighten through an fd, and refuse what is not a real directory
    # (3.12.9). This was `sys_chmod(base_dir, 0700)`, which follows symlinks:
    # with `base_dir` pre-planted as a link, the chmod landed on the link's
    # target and every `.bin` / `.meta` after it was written there. Opening with
    # O_DIRECTORY | O_NOFOLLOW refuses the link; a 0 return means "no usable
    # store", as `_oci_state_root` does for runc's.
    #ifndef CYRIUS_TARGET_AGNOS
    var dfd = file_open(base_dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
    if (dfd < 0) { return 0; }
    var st[144];
    if (sys_fstat(dfd, &st) < 0) { sys_close(dfd); return 0; }
    if (load32(&st + STAT_UID) != sys_getuid()) { sys_close(dfd); return 0; }
    if (sys_fchmod(dfd, 448) < 0) { sys_close(dfd); return 0; }
    sys_close(dfd);
    #endif
    var q = alloc(16);
    QuarantineStorage_set_base_dir(q, base_dir);
    # next_id field retained for API compat; actual entry IDs are 64-bit
    # random per quarantine_store() call.
    QuarantineStorage_set_next_id(q, 1);
    return q;
}

# Build "<base_dir>/<id>.<ext>"
fn _qpath(base_dir, id, ext) {
    var id_buf[24];
    var id_len = fmt_int_buf(id, &id_buf);
    var blen = strlen(base_dir);
    var elen = strlen(ext);
    var total = checked_sum4(blen, id_len, elen, 3);
    if (total < 0) { return 0; }
    var buf = alloc_checked(total);
    if (buf == 0) { return 0; }
    var pos = 0;
    memcpy(buf + pos, base_dir, blen); pos = pos + blen;
    store8(buf + pos, 47); pos = pos + 1;
    memcpy(buf + pos, &id_buf, id_len); pos = pos + id_len;
    store8(buf + pos, 46); pos = pos + 1;
    memcpy(buf + pos, ext, elen); pos = pos + elen;
    store8(buf + pos, 0);
    return buf;
}

# Serialize metadata as simple JSON. sandbox_id is user-controllable so
# it must be JSON-escaped (ADR-005 §C2).
fn _meta_jsonl(id, sandbox_id, verdict, status) {
    var id_buf[24];
    var id_len = fmt_int_buf(id, &id_buf);
    var sid_raw = sandbox_id;
    if (sid_raw == 0) { sid_raw = ""; }
    var sid = oci_json_escape(sid_raw);
    var vn = verdict_name(verdict);
    var sn = quarantine_status_name(status);
    var ts_buf[24];
    var ts_len = fmt_int_buf(clock_epoch_secs(), &ts_buf);

    var user_lens = checked_sum4(id_len, strlen(sid), strlen(vn),
      strlen(sn) + ts_len);
    if (user_lens < 0) { return 0; }
    var cap = checked_add(user_lens, 256);
    if (cap < 0) { return 0; }
    var buf = alloc_checked(cap);
    if (buf == 0) { return 0; }
    var pos = 0;
    var p1 = "{\"id\":";
    memcpy(buf + pos, p1, strlen(p1)); pos = pos + strlen(p1);
    memcpy(buf + pos, &id_buf, id_len); pos = pos + id_len;
    var p2 = ",\"sandbox_id\":\"";
    memcpy(buf + pos, p2, strlen(p2)); pos = pos + strlen(p2);
    memcpy(buf + pos, sid, strlen(sid)); pos = pos + strlen(sid);
    var p3 = "\",\"verdict\":\"";
    memcpy(buf + pos, p3, strlen(p3)); pos = pos + strlen(p3);
    memcpy(buf + pos, vn, strlen(vn)); pos = pos + strlen(vn);
    var p4 = "\",\"status\":\"";
    memcpy(buf + pos, p4, strlen(p4)); pos = pos + strlen(p4);
    memcpy(buf + pos, sn, strlen(sn)); pos = pos + strlen(sn);
    var p5 = "\",\"quarantined_at\":";
    memcpy(buf + pos, p5, strlen(p5)); pos = pos + strlen(p5);
    memcpy(buf + pos, &ts_buf, ts_len); pos = pos + ts_len;
    store8(buf + pos, 125); pos = pos + 1;
    store8(buf + pos, 10); pos = pos + 1;
    store8(buf + pos, 0);
    return buf;
}

# Store artifact + metadata. Returns the assigned id on success, -1 on
# failure. Both files are created with O_EXCL|O_NOFOLLOW + mode 0600
# (file_write_secure) — attacker-staged symlinks at the target paths
# cannot redirect the write. Artifact writes that fail abort the op
# instead of silently returning a fake id. See ADR-005 §C4 + §H2.
fn quarantine_store(storage, artifact, artifact_len, scan_result, sandbox_id) {
    # 64-bit random entry id; unpredictable filenames defeat the
    # symlink-preseed vector on the base dir. See ADR-004 §8.
    var id = rand_u64();
    var base = QuarantineStorage_base_dir(storage);

    var art_path = _qpath(base, id, "bin");
    if (art_path == 0) { return 0 - 1; }
    # Use the Result-returning secure write so a failed quarantine — a
    # security-relevant event — records *why* (access denied vs not found vs
    # a staged symlink) in the error trail rather than an opaque -1.
    var aw_t, aw_v = file_write_secure_r(art_path, artifact, artifact_len);
    if (is_err_result(aw_t) == 1) {
        kavach_err_print(KAVACH_ERR_IO_ERROR, io_error_name(err_code_of(aw_t, aw_v)));
        return 0 - 1;
    }

    var meta_path = _qpath(base, id, "meta");
    if (meta_path == 0) { kv_unlink(art_path); return 0 - 1; }
    var meta = _meta_jsonl(id, sandbox_id,
      ScanResult_verdict(scan_result),
      QuarantineStatus.QUARANTINED);
    var mw_t, mw_v = file_write_secure_r(meta_path, meta, strlen(meta));
    if (is_err_result(mw_t) == 1) {
        kavach_err_print(KAVACH_ERR_IO_ERROR, io_error_name(err_code_of(mw_t, mw_v)));
        kv_unlink(art_path);
        return 0 - 1;
    }
    return id;
}

# Approve or reject an entry by rewriting its metadata with new status.
# Callers must re-read the artifact separately.
fn quarantine_update_status(storage, id, status) {
    var base = QuarantineStorage_base_dir(storage);
    var meta_path = _qpath(base, id, "meta");
    if (meta_path == 0) { return KAVACH_ERR_IO_ERROR; }
    # For v3.0 we just drop a new meta — readers see the latest. Parsing the
    # previous file requires a JSON parser and is deferred.
    var placeholder = _meta_jsonl(id, 0, ScanVerdict.QUARANTINE, status);
    # ⛔ Rewrite the entry's OWN file, or fail (3.12.9). This was
    # `file_write_all`, which creates at 0644 and follows a symlink, and its
    # result was dropped: a `.meta` link truncated and overwrote the link's
    # target, and a write that failed still returned OK, so an approve or
    # reject could be lost while the caller was told it was recorded. No O_CREAT:
    # the entry must already exist (`quarantine_store` made it, 0600).
    var fd = file_open(meta_path, O_WRONLY | O_TRUNC | O_NOFOLLOW, 0);
    if (fd < 0) { return KAVACH_ERR_IO_ERROR; }
    var len = strlen(placeholder);
    var n = file_write(fd, placeholder, len);
    sys_close(fd);
    if (n != len) { return KAVACH_ERR_IO_ERROR; }
    return KAVACH_ERR_OK;
}

# --- cgroup.cyr ---

# kavach — cgroups v2 resource limits
#
# Wires SandboxPolicy.{memory_limit_mb,cpu_limit_tenths,max_pids} into a
# per-sandbox cgroup under /sys/fs/cgroup/kavach-<id>/.
#
# Placement model: cgroups are created as direct children of the cgroup-v2
# root. That avoids the "no internal processes" rule (root cgroup is the
# only one allowed to host both processes AND child cgroups; non-root
# non-leaf cgroups can't host processes). Requires that the running
# system has cgroup v2 mounted at /sys/fs/cgroup (the unified hierarchy
# default on modern systemd) and that the desired controllers (memory,
# cpu, pids) are enabled in the root's cgroup.subtree_control.
#
# PID assignment uses the "shell-prepend" pattern — the user command is
# wrapped in `sh -c 'echo $$ > /sys/fs/cgroup/<scope>/cgroup.procs;
# exec <cmd>'`. The shell writes its own PID into the cgroup, then
# exec()s the user command, which inherits the cgroup placement. The
# window between fork and the write is bounded by sh's startup (a few
# syscalls); no userspace work runs in the unrestricted cgroup. This is
# the standard Linux-container-runtime pattern for unprivileged
# placement without a custom fork+pre_exec helper.
#
# Graceful degradation: if /sys/fs/cgroup isn't writable (read-only
# mount, missing controllers, unprivileged container, non-Linux), every
# entry point returns 0 / no-op and cgroup_supported() returns 0 so
# callers can decline to wrap.

var CGROUP_ROOT = "/sys/fs/cgroup";

# Whole-token match in a whitespace-separated list. cgroup.subtree_control
# is a space-separated controller list ("cpuset cpu io memory pids"), so a
# naive substring check for "cpu" spuriously matches "cpuset" — reporting the
# cpu controller present when only cpuset is. Require the token to be bounded
# by start-of-string/whitespace on both sides.
fn _cgroup_has_controller(list, name) {
    var llen = strlen(list);
    var nlen = strlen(name);
    var i = 0;
    while (i + nlen <= llen) {
        var ok = 1;
        if (i > 0) {
            var pc = load8(list + i - 1);
            if (pc != 32) { if (pc != 10) { if (pc != 9) { ok = 0; } } }
        }
        if (ok == 1) {
            var j = 0;
            while (j < nlen) {
                if (load8(list + i + j) != load8(name + j)) { ok = 0; break; }
                j = j + 1;
            }
            if (ok == 1) {
                var after = i + nlen;
                if (after < llen) {
                    var ac = load8(list + after);
                    if (ac != 32) { if (ac != 10) { if (ac != 9) { ok = 0; } } }
                }
                if (ok == 1) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Check whether cgroup v2 is mounted and writable. Returns 1 if the root
# is writable AND the memory + cpu + pids controllers are enabled in the
# root's cgroup.subtree_control (so child cgroups can use them).
fn cgroup_supported() {
    if (sys_access(CGROUP_ROOT, 2) < 0) { return 0; }
    var buf = alloc(512);
    var n = file_read_all("/sys/fs/cgroup/cgroup.subtree_control", buf, 511);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    if (_cgroup_has_controller(buf, "memory") == 0) { return 0; }
    if (_cgroup_has_controller(buf, "cpu") == 0) { return 0; }
    if (_cgroup_has_controller(buf, "pids") == 0) { return 0; }
    return 1;
}

# Build the cgroup path for a sandbox id (a random u64). Returns a freshly
# allocated cstr the caller owns.
fn _cgroup_path(scope_id) {
    var prefix = "/sys/fs/cgroup/kavach-";
    var prefix_len = strlen(prefix);
    var id_buf[24];
    var id_len = fmt_int_buf(scope_id, &id_buf);
    var out = alloc(prefix_len + id_len + 1);
    memcpy(out, prefix, prefix_len);
    memcpy(out + prefix_len, &id_buf, id_len);
    store8(out + prefix_len + id_len, 0);
    return out;
}

# Build a child file path under a cgroup directory. Caller owns return.
fn _cgroup_file(cgroup_path, name) {
    var clen = strlen(cgroup_path);
    var nlen = strlen(name);
    var out = alloc(clen + 1 + nlen + 1);
    memcpy(out, cgroup_path, clen);
    store8(out + clen, 47);
    memcpy(out + clen + 1, name, nlen);
    store8(out + clen + 1 + nlen, 0);
    return out;
}

# Write a numeric value to a cgroup controller file (e.g. memory.max).
# Returns 0 on success, -1 on failure (gracefully ignored by caller).
fn _cgroup_write_int(cgroup_path, name, value) {
    var fpath = _cgroup_file(cgroup_path, name);
    var buf[32];
    var len = fmt_int_buf(value, &buf);
    var r = file_write_all(fpath, &buf, len);
    if (r < 0) { return 0 - 1; }
    return 0;
}

# Write a literal string to a cgroup controller file. Used for cpu.max
# which takes "<quota_us> <period_us>" rather than a bare integer.
fn _cgroup_write_str(cgroup_path, name, value) {
    var fpath = _cgroup_file(cgroup_path, name);
    var r = file_write_all(fpath, value, strlen(value));
    if (r < 0) { return 0 - 1; }
    return 0;
}

# Build the cpu.max content for a tenths value (10 = 1.0 cores, 25 = 2.5 cores).
# cgroup v2 cpu.max takes "<quota_us> <period_us>"; we use a 100ms period and
# scale the quota accordingly: 1.0 cores = "100000 100000", 2.5 = "250000 100000".
# Returns a freshly-allocated cstr.
fn _cpu_max_string(tenths) {
    var period_us = 100000;
    var quota_us = (period_us * tenths) / 10;
    var qbuf[24];
    var qlen = fmt_int_buf(quota_us, &qbuf);
    var pbuf[24];
    var plen = fmt_int_buf(period_us, &pbuf);
    var out = alloc(qlen + 1 + plen + 1);
    memcpy(out, &qbuf, qlen);
    store8(out + qlen, 32);
    memcpy(out + qlen + 1, &pbuf, plen);
    store8(out + qlen + 1 + plen, 0);
    return out;
}

# Create the per-sandbox cgroup directory and write the limit files from
# policy. Returns the cgroup_path cstr on success, 0 on any failure
# (caller should fall back to running without cgroups).
#
# Honors: memory_limit_mb (memory.max in bytes), cpu_limit_tenths
# (cpu.max as "<quota> <period>"), max_pids (pids.max).
fn cgroup_setup(policy) {
    if (cgroup_supported() == 0) { return 0; }
    var scope = rand_u64();
    if (scope < 0) { scope = 0 - scope; }
    var path = _cgroup_path(scope);
    # sys_mkdir mode is ignored by cgroupfs (it owns the dir mode), but
    # passing 0700 keeps the intent visible.
    if (kv_mkdir(path, 448) < 0) { return 0; }

    var mem_mb = SandboxPolicy_memory_limit_mb(policy);
    if (mem_mb > 0) {
        _cgroup_write_int(path, "memory.max", mem_mb * 1048576);
    }
    var cpu_t = SandboxPolicy_cpu_limit_tenths(policy);
    if (cpu_t > 0) {
        var cpu_max = _cpu_max_string(cpu_t);
        _cgroup_write_str(path, "cpu.max", cpu_max);
    }
    var pids = SandboxPolicy_max_pids(policy);
    if (pids > 0) {
        _cgroup_write_int(path, "pids.max", pids);
    }
    return path;
}

# Tear down a cgroup created by cgroup_setup. Safe to call with 0 (no-op).
# The kernel rmdirs the cgroup only when no processes remain in it; after
# the wrapped command exits, kavach's wait() returns and the cgroup is
# empty.
fn cgroup_teardown(cgroup_path) {
    if (cgroup_path == 0) { return 0; }
    kv_rmdir(cgroup_path);
    return 0;
}

# Return 1 if `policy` has any cgroup-controlled limit set (memory, cpu,
# or pids). Backends use this to decide whether to apply the wrapping at
# all — no limits = no wrapping = no shell dependency.
fn cgroup_policy_has_limits(policy) {
    if (SandboxPolicy_memory_limit_mb(policy) > 0) { return 1; }
    if (SandboxPolicy_cpu_limit_tenths(policy) > 0) { return 1; }
    if (SandboxPolicy_max_pids(policy) > 0) { return 1; }
    return 0;
}

# Build the cgroup-join "-c" body string for the sh wrapper.
# Shape: `echo $$ > <cgroup_path>/cgroup.procs; exec "$@"`
#
# The `exec "$@"` pattern passes the user argv through positionally —
# sh does NOT re-interpret quotes / variables / metachars in the user
# command, only the literal `echo $$` line and the `exec "$@"` directive
# are under shell control. This preserves the no-shell-interpretation
# guarantee that direct execve would give, while still letting us write
# the shell's own PID into cgroup.procs before it execs the user command.
fn _cgroup_sh_body(cgroup_path) {
    var head = "echo $$ > ";
    var tail = "/cgroup.procs; exec \"$@\"";
    var hl = strlen(head);
    var cp = strlen(cgroup_path);
    var tl = strlen(tail);
    var out = alloc(hl + cp + tl + 1);
    var pos = 0;
    memcpy(out + pos, head, hl); pos = pos + hl;
    memcpy(out + pos, cgroup_path, cp); pos = pos + cp;
    memcpy(out + pos, tail, tl); pos = pos + tl;
    store8(out + pos, 0);
    return out;
}

# Wrap a user argv vec with the cgroup-join shell prelude, returning a
# new argv vec. The resulting argv shape is:
#
#   ["/bin/sh", "-c", "echo $$ > <cgroup_path>/cgroup.procs; exec \"$@\"",
#    "--", <user argv...>]
#
# ⛔ `/bin/sh`, absolute (3.12.9). It was a bare "sh", and kavach execs with
# execve, which does no PATH search: "sh" resolved against the child's working
# directory. With no `./sh` there, every cgroup-limited payload exited 127
# without running; with one, that file ran in place of the prelude. Absolute,
# it is also pinned before fork like every other exec (ADR-005 §H4).
#
# `--` separates sh's own positional args ($0 = "--", $1.. = user argv).
# Per `man sh`, $0 receives whatever follows "-c <body>", so the first
# positional arg goes into $0 — passing "--" there is the standard way
# to skip the slot.
#
# The returned vec is freshly allocated; the user_argv vec is not consumed
# (callers can free / reuse it).
fn cgroup_wrap_argv(cgroup_path, user_argv) {
    var out = vec_new();
    vec_push(out, "/bin/sh");
    vec_push(out, "-c");
    vec_push(out, _cgroup_sh_body(cgroup_path));
    vec_push(out, "--");
    var i = 0;
    while (i < vec_len(user_argv)) {
        vec_push(out, vec_get(user_argv, i));
        i = i + 1;
    }
    return out;
}

# --- oci_spec.cyr ---

# kavach — OCI runtime spec (v1.0.2) generator shared by gVisor + OCI backends.
# Ported from rust-old/src/backend/oci_spec.rs.
#
# Minimal spec: pid/ipc/uts/mount namespaces always included, network
# namespace conditional on policy, resource limits applied when set, readonly
# rootfs per policy, command wrapped in `/bin/sh -c`. Every spec sets
# `noNewPrivileges`, a bounded capability set (`_oci_capabilities_json`) and the
# masked and read-only /proc paths (`_oci_paths_json`), and the OCI backend's
# carries the policy's seccomp filter (`_oci_seccomp_json`).

var _oci_id_counter = 1;

# Container id = <prefix>-<epoch>-<counter>-<16 hex chars from /dev/urandom>.
# Randomness breaks the predictable-id vector that let a local attacker
# pre-create /tmp/<id> as a symlink. See ADR-005 §C3.
fn oci_container_id(prefix) {
    var ts_buf[24];
    var ts_len = fmt_int_buf(clock_epoch_secs(), &ts_buf);
    # 3.14.8: one atomic step, so two threads never take one number. The random
    # tail kept the ids apart anyway; the counter now says so on its own.
    var ctr = atomic_fetch_add(&_oci_id_counter, 1);
    var ctr_buf[24];
    var ctr_len = fmt_int_buf(ctr, &ctr_buf);
    var rand_id = rand_hex_id();

    var out = alloc(strlen(prefix) + 1 + ts_len + 1 + ctr_len + 1 + 17);
    var pos = 0;
    memcpy(out + pos, prefix, strlen(prefix)); pos = pos + strlen(prefix);
    store8(out + pos, 45); pos = pos + 1;
    memcpy(out + pos, &ts_buf, ts_len); pos = pos + ts_len;
    store8(out + pos, 45); pos = pos + 1;
    memcpy(out + pos, &ctr_buf, ctr_len); pos = pos + ctr_len;
    store8(out + pos, 45); pos = pos + 1;
    memcpy(out + pos, rand_id, strlen(rand_id)); pos = pos + strlen(rand_id);
    store8(out + pos, 0);
    return out;
}

# RFC 8259 §7 compliant JSON string escape. Worst-case expansion is 6×
# (e.g. 0x01 → \u0001). Returns allocated null-terminated cstr.
# Protects the audit log + OCI configs against log forgery and JSON
# injection via control chars / ANSI escape sequences (ADR-005 §C2).
fn oci_json_escape(s) {
    var n = strlen(s);
    # Overflow guard: reject absurd inputs early (see util.cyr checked_mul).
    if (n > 1048576) {
        var tr = alloc(4);
        memcpy(tr, "...", 4);
        return tr;
    }
    var dst = alloc(n * 6 + 1);
    var di = 0;
    var hex = "0123456789abcdef";
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 34) {
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 34); di = di + 1;
        }
        elif (c == 92) {
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 92); di = di + 1;
        }
        elif (c == 10) {
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 110); di = di + 1;
        }
        elif (c == 13) {
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 114); di = di + 1;
        }
        elif (c == 9) {
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 116); di = di + 1;
        }
        elif (c == 8) {
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 98); di = di + 1;
        }
        elif (c == 12) {
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 102); di = di + 1;
        }
        elif (c < 32) {
            # Generic control char: \u00XX
            store8(dst + di, 92); di = di + 1;
            store8(dst + di, 117); di = di + 1;
            store8(dst + di, 48); di = di + 1;
            store8(dst + di, 48); di = di + 1;
            store8(dst + di, load8(hex + ((c >> 4) & 15))); di = di + 1;
            store8(dst + di, load8(hex + (c & 15))); di = di + 1;
        }
        else {
            store8(dst + di, c); di = di + 1;
        }
        i = i + 1;
    }
    store8(dst + di, 0);
    return dst;
}

fn oci_network_mode(policy) {
    if (SandboxPolicy_network_enabled(policy) == 1) { return "host"; }
    return "none";
}

# Whether this config's spec carries the filter.
fn _oci_wants_filter(config) {
    if (config == 0) { return 0; }
    if (SandboxConfig_backend(config) == KavachBackend.GVISOR) { return 0; }
    var policy = SandboxConfig_policy(config);
    if (policy == 0) { return 0; }
    if (SandboxPolicy_seccomp_enabled(policy) != 1) { return 0; }
    return 1;
}

# Why this config's capability list cannot be written, as a message, or 0 when it
# can. The spec is refused rather than the name dropped: a payload running with
# less than its caller asked for fails later, somewhere that says nothing of why.
#
#   - An unknown name (`security_capability_refusal`). A name is written into the
#     spec unescaped because it has matched the table, and runc only warns about one
#     it does not know, which `_oci_exec_with` would then report as a runtime failure.
#   - CAP_SYS_ADMIN under the filter. `open_tree_attr` gets past the filter by name
#     (see `_oci_seccomp_json`) and needs CAP_SYS_ADMIN to clone a tree. Measured
#     under runc 1.5.2 with the filter on and a read-only rootfs: a direct create
#     read EROFS, while `open_tree_attr` with MOUNT_ATTR_RDONLY in `attr_clr`
#     returned a writable clone, and a file created through it appeared in the
#     rootfs. No `move_mount` is needed. A caller who needs the capability turns
#     the filter off. gVisor's spec carries no filter, so this does not apply there.
#[must_use]
fn oci_capabilities_refusal(config) {
    if (config == 0) { return 0; }
    var v = SandboxConfig_capabilities(config);
    if (v == 0) { return 0; }
    var unknown = security_capability_refusal(v);
    if (unknown != 0) { return unknown; }
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), "CAP_SYS_ADMIN") == 1 && _oci_wants_filter(config) == 1) {
            return "CAP_SYS_ADMIN cannot be granted under a seccomp filter: it reopens a read-only rootfs";
        }
        i = i + 1;
    }
    return 0;
}

# The payload's capabilities as a `process.capabilities` member, with its leading
# comma: the config's list, or `oci_default_capabilities()`. Every spec has one,
# whatever the policy, because a runtime drops nothing when the key is absent.
#
# `inheritable` and `ambient` stay empty, as Docker's have since CVE-2022-24769.
#
# runsc reads the same key but defaults the other way: with none, a payload has no
# capabilities at all (`specutils.Capabilities`, read and not run). So on gVisor
# this list adds rather than removes. Those are the sentry's own, held against its
# emulated kernel and not the host.
fn _oci_capabilities_json(config) {
    var names = 0;
    if (config != 0) { names = SandboxConfig_capabilities(config); }
    if (names == 0) { names = oci_default_capabilities(); }
    var lb = str_builder_new();
    str_builder_add_cstr(lb, "[");
    var i = 0;
    while (i < vec_len(names)) {
        if (i > 0) { str_builder_add_cstr(lb, ","); }
        str_builder_add_cstr(lb, "\"");
        str_builder_add_cstr(lb, vec_get(names, i));
        str_builder_add_cstr(lb, "\"");
        i = i + 1;
    }
    str_builder_add_cstr(lb, "]");
    var list = str_data(str_builder_build(lb));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ",\"capabilities\":{\"bounding\":");
    str_builder_add_cstr(sb, list);
    str_builder_add_cstr(sb, ",\"effective\":");
    str_builder_add_cstr(sb, list);
    str_builder_add_cstr(sb, ",\"permitted\":");
    str_builder_add_cstr(sb, list);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# `linux.maskedPaths` and `linux.readonlyPaths`, with a leading comma: the lists
# `runc spec` 1.5.2 writes, from `security_masked_path` and `security_readonly_path`
# since 3.14.7, which the process path reads too.
#
# A filter cannot stand in for them, because writing a sysctl is an `open` and a
# `write`, and a core pattern naming a program runs that program on the host.
# Measured as root under runc 1.5.2 with neither list and every capability:
#
#   | | neither list | these lists |
#   |---|---|---|
#   | open /proc/sys/kernel/core_pattern to write | allowed | EROFS |
#   | open /proc/sysrq-trigger to write | allowed | EROFS |
#   | read /proc/kcore | a byte | none |
#
# A path that does not exist is skipped, which /sys/firmware always is: this spec
# mounts no /sys. It stays, so the lists are runc's and not a variant of them.
#
# runsc's boot path applies neither (read, not run). Its /proc is its own.
#
# Built once and kept (3.14.7): the tables are fixed, and the 35 appends cost
# `oci_spec_filtered` 5.5% when they ran for every spec. The spec copies it.
var _OCI_PATHS_JSON = 0;

fn _oci_paths_json() {
    if (_OCI_PATHS_JSON != 0) { return _OCI_PATHS_JSON; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ",\"maskedPaths\":[");
    var i = 0;
    while (i < SECURITY_MASKED_PATHS) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, security_masked_path(i));
        str_builder_add_cstr(sb, "\"");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"readonlyPaths\":[");
    i = 0;
    while (i < SECURITY_READONLY_PATHS) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, security_readonly_path(i));
        str_builder_add_cstr(sb, "\"");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    _OCI_PATHS_JSON = str_data(str_builder_build(sb));
    return _OCI_PATHS_JSON;
}

# The exec-safe filter as a `linux.seccomp` member, with its leading comma: what
# `security_create_exec_seccomp_filter` compiles for the process backend, in the
# form a runtime compiles itself, from the same table. "" when no filter applies.
#
# Through 3.14.3 the spec carried no filter and no `noNewPrivileges`, on the
# path every container takes where runc or crun is installed, while
# `score_backend` added 5 for `seccomp_enabled`. Measured under runc 1.5.2 with
# `policy_basic()`: the payload read `Seccomp: 0` and `NoNewPrivs: 0` from
# /proc/self/status, and `mount -t tmpfs` and `unshare -U` both succeeded.
#
#   - The default is ALLOW, with the deny list killing the process: the same
#     deny-list trade the exec filter makes, for the reason it gives.
#   - The spec stays `ociVersion` 1.0.2, whose text predates some of these fields.
#     runc 1.5.2 applies them under it, as measured below, and reads no gate there.
#   - `architectures` names the native ABI alone, so a call through any other
#     (the i386 gate, x32) never runs, as under `_seccomp_write_prologue`. The
#     action differs: libseccomp kills the calling thread where that filter kills
#     the process, so another thread in the payload would carry on.
#   - clone3 is ENOSYS, not a kill: its flags are behind a pointer seccomp cannot
#     read, and glibc answers ENOSYS by falling back to clone, which it can.
#     `errnoRet` is what makes it ENOSYS; a runtime's default errno is EPERM,
#     and glibc does not fall back from that.
#   - clone is denied once per namespace flag. The filter's one JSET cannot be
#     written here: the only masked operator is SCMP_CMP_MASKED_EQ, which asks
#     whether the masked value equals a datum, and "any of these bits" is not an
#     equality. A rule per bit is. They are separate rules, not one rule's
#     `args`, because `args` are ANDed unless a runtime special-cases them.
#
# ⚠ One deny entry cannot hold by name. A runtime resolves a name through
# libseccomp and skips one it does not know, silently, and a spec cannot give a
# number. runc 1.5.2 with libseccomp 2.6.0 does not know `open_tree_attr` (Linux
# 6.15). No default set holds CAP_SYS_ADMIN, and `oci_capabilities_refusal` refuses
# to grant it here, which closes that from the other side. An older libseccomp may
# skip more of the mount API, each call of which needs the same capability:
# `test_oci_payload_observes_the_filter` reports what a host denies.
#
# Not for gVisor. runsc applies a spec's filter only under `--oci-seccomp`, and
# then refuses SCMP_ACT_KILL_PROCESS as an invalid action (runsc/specutils/
# seccomp/seccomp.go), so a spec written for runc would be ignored or refused.
# See docs/development/issues/archived/2026-11-06-gvisor-policy-seccomp-is-not-applied.md.
fn _oci_seccomp_json(config) {
    if (_oci_wants_filter(config) == 0) { return ""; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ",\"seccomp\":{\"defaultAction\":\"SCMP_ACT_ALLOW\",\"architectures\":[\"");
    str_builder_add_cstr(sb, security_seccomp_oci_arch());
    str_builder_add_cstr(sb, "\"],\"syscalls\":[{\"names\":[");
    var names = security_seccomp_deny_names();
    var i = 0;
    while (i < vec_len(names)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, vec_get(names, i));
        str_builder_add_cstr(sb, "\"");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"action\":\"SCMP_ACT_KILL_PROCESS\"}");
    str_builder_add_cstr(sb, ",{\"names\":[\"clone3\"],\"action\":\"SCMP_ACT_ERRNO\",\"errnoRet\":");
    var eb[24];
    var elen = fmt_int_buf(ENOSYS, &eb);
    store8(&eb + elen, 0);
    str_builder_add_cstr(sb, &eb);
    str_builder_add_cstr(sb, "}");
    var bit = 1;
    while (bit <= SECCOMP_CLONE_NS_FLAGS) {
        if ((SECCOMP_CLONE_NS_FLAGS & bit) != 0) {
            var fb[24];
            var flen = fmt_int_buf(bit, &fb);
            store8(&fb + flen, 0);
            str_builder_add_cstr(sb, ",{\"names\":[\"clone\"],\"action\":\"SCMP_ACT_KILL_PROCESS\",");
            str_builder_add_cstr(sb, "\"args\":[{\"index\":0,\"value\":");
            str_builder_add_cstr(sb, &fb);
            str_builder_add_cstr(sb, ",\"valueTwo\":");
            str_builder_add_cstr(sb, &fb);
            str_builder_add_cstr(sb, ",\"op\":\"SCMP_CMP_MASKED_EQ\"}]}");
        }
        bit = bit * 2;
    }
    str_builder_add_cstr(sb, "]}");
    return str_data(str_builder_build(sb));
}

# Render OCI runtime config.json v1.0.2. Returns allocated cstr.
fn oci_generate_spec(sandbox, command) {
    var config = Sandbox_config(sandbox);
    if (oci_capabilities_refusal(config) != 0) { return 0; }
    var policy = SandboxConfig_policy(config);
    var cmd_escaped = oci_json_escape(command);
    var cfg_rootfs_for_args = SandboxConfig_rootfs(config);

    var mem = SandboxPolicy_memory_limit_mb(policy);
    var pids = SandboxPolicy_max_pids(policy);
    var readonly = "false";
    if (SandboxPolicy_read_only_rootfs(policy) == 1) { readonly = "true"; }

    var resources = "";
    if (mem > 0) {
        var mem_buf[32];
        var mem_bytes = mem * 1048576;
        var mem_len = fmt_int_buf(mem_bytes, &mem_buf);
        # Render the pids int up front so the buffer can be sized to fit it.
        # The fixed JSON fragments are p1(32) + optional p2(18) + p3(2) + NUL;
        # 64 covers them with margin. The old `alloc(64 + mem_len)` ignored
        # pids_len entirely and overflowed for max_pids > ~10 digits (C1).
        var pids_buf[24];
        var pids_len = 0;
        if (pids > 0) { pids_len = fmt_int_buf(pids, &pids_buf); }
        var rcap = checked_sum4(64, mem_len, pids_len, 0);
        if (rcap < 0) { return 0; }
        var r = alloc_checked(rcap);
        if (r == 0) { return 0; }
        var rpos = 0;
        var p1 = ",\"resources\":{\"memory\":{\"limit\":";
        memcpy(r + rpos, p1, strlen(p1)); rpos = rpos + strlen(p1);
        memcpy(r + rpos, &mem_buf, mem_len); rpos = rpos + mem_len;
        if (pids > 0) {
            var p2 = "},\"pids\":{\"limit\":";
            memcpy(r + rpos, p2, strlen(p2)); rpos = rpos + strlen(p2);
            memcpy(r + rpos, &pids_buf, pids_len); rpos = rpos + pids_len;
        }
        var p3 = "}}";
        memcpy(r + rpos, p3, strlen(p3)); rpos = rpos + strlen(p3);
        store8(r + rpos, 0);
        resources = r;
    }

    var netns = "{\"type\":\"network\"},";
    if (SandboxPolicy_network_enabled(policy) == 1) { netns = ""; }

    # 3.12.0: `process.env`. Unset (the default) keeps the fixed PATH/TERM pair
    # every spec carried before, so an existing consumer is byte-identical. Set,
    # the caller's list REPLACES that pair rather than appending to it — an OCI
    # image declares its own PATH, and silently prepending kavach's would shadow
    # it. A caller that wants the defaults includes them in its own list.
    var env_json = "],\"env\":[\"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\",\"TERM=xterm\"],";
    var cfg_env = SandboxConfig_env(config);
    if (cfg_env != 0) {
        if (vec_len(cfg_env) > 0) {
            var esb = str_builder_new();
            str_builder_add_cstr(esb, "],\"env\":[");
            var ei = 0;
            while (ei < vec_len(cfg_env)) {
                if (ei > 0) { str_builder_add_cstr(esb, ","); }
                str_builder_add_cstr(esb, "\"");
                str_builder_add_cstr(esb, oci_json_escape(vec_get(cfg_env, ei)));
                str_builder_add_cstr(esb, "\"");
                ei = ei + 1;
            }
            str_builder_add_cstr(esb, "],");
            env_json = str_data(str_builder_build(esb));
        }
    }

    # 3.12.2: `process.cwd` from the config, where this hardcoded "/" — so a
    # caller's workdir was dropped on the runc path exactly as it was on the
    # process path. Escaped, since it is caller-supplied.
    var cwd_json = "\"cwd\":\"/\"";
    var cfg_wd = SandboxConfig_workdir(config);
    if (cfg_wd != 0) {
        if (strlen(cfg_wd) > 0) {
            var wsb = str_builder_new();
            str_builder_add_cstr(wsb, "\"cwd\":\"");
            str_builder_add_cstr(wsb, oci_json_escape(cfg_wd));
            str_builder_add_cstr(wsb, "\"");
            cwd_json = str_data(str_builder_build(wsb));
        }
    }

    var cap = checked_add(strlen(cmd_escaped), strlen(resources));
    if (cap < 0) { return 0; }
    cap = checked_add(cap, strlen(env_json));
    if (cap < 0) { return 0; }
    cap = checked_add(cap, strlen(cwd_json));
    if (cap < 0) { return 0; }
    var seccomp_json = _oci_seccomp_json(config);
    cap = checked_add(cap, strlen(seccomp_json));
    if (cap < 0) { return 0; }
    var caps_json = _oci_capabilities_json(config);
    cap = checked_add(cap, strlen(caps_json));
    if (cap < 0) { return 0; }
    var paths_json = _oci_paths_json();
    cap = checked_add(cap, strlen(paths_json));
    if (cap < 0) { return 0; }
    cap = checked_add(cap, 2048);
    var scfg_cap = Sandbox_config(sandbox);
    if (scfg_cap != 0) {
        var rf_cap = SandboxConfig_rootfs(scfg_cap);
        if (rf_cap != 0) { cap = checked_add(cap, strlen(rf_cap) * 2 + 64); }
    }
    if (cap < 0) { return 0; }
    cap = checked_add(cap, 512);        # rootless user-ns + id mappings + mounts
    if (cap < 0) { return 0; }
    # ⛔ The argv form's framing (3.12.9). A rootfs-bearing sandbox writes each
    # token as `"tok",`, 3 bytes around the escaped token where the command
    # string had one separator, and nothing above counted it: past ~1000 tokens
    # the fixed slack ran out and the loop below wrote past `buf` (1500 tokens
    # crashed the process). Split first, and add 3 bytes per token.
    var av = 0;
    if (cfg_rootfs_for_args != 0 || Sandbox_argv(sandbox) != 0) {
        av = _sandbox_command_argv(sandbox, command);
        cap = checked_add(cap, checked_mul(vec_len(av), 3));
        if (cap < 0) { return 0; }
    }
    var buf = alloc_checked(cap);
    if (buf == 0) { return 0; }
    var pos = 0;
    var head = "{\"ociVersion\":\"1.0.2\",\"process\":{\"terminal\":false,\"args\":[";
    memcpy(buf + pos, head, strlen(head)); pos = pos + strlen(head);
    # argv, not `/bin/sh -c <string>`.
    #
    # The shell wrapper made every OCI container depend on the IMAGE shipping
    # /bin/sh — so a distroless or scratch image, or a single static binary,
    # could not run at all, and the failure looked like the payload doing
    # nothing. A rootfs-bearing sandbox gets real argv; without a rootfs the
    # legacy wrapper is kept, since a caller relying on shell syntax there has
    # a host shell by definition. A caller of a sandbox_*_argv form gets real
    # argv either way: the wrapper would hand its arguments to a shell to parse.
    if (av != 0) {
        var ai = 0;
        while (ai < vec_len(av)) {
            if (ai > 0) { store8(buf + pos, 44); pos = pos + 1; }        # ','
            store8(buf + pos, 34); pos = pos + 1;                        # '"'
            var tok = oci_json_escape(vec_get(av, ai));
            memcpy(buf + pos, tok, strlen(tok)); pos = pos + strlen(tok);
            store8(buf + pos, 34); pos = pos + 1;                        # '"'
            ai = ai + 1;
        }
    } else {
        var shw = "\"/bin/sh\",\"-c\",\"";
        memcpy(buf + pos, shw, strlen(shw)); pos = pos + strlen(shw);
        memcpy(buf + pos, cmd_escaped, strlen(cmd_escaped)); pos = pos + strlen(cmd_escaped);
        store8(buf + pos, 34); pos = pos + 1;                            # closing '"'
    }
    var mid1a = env_json;
    # root.path: the sandbox's OWN rootfs when it has one, else the bundle's
    # empty "rootfs" dir. The relative form is what every release before 3.9.1
    # emitted unconditionally — an EMPTY directory — so an OCI-backed container
    # ran with no filesystem and any payload from the image silently did
    # nothing. runc accepts an absolute root.path, so no bind mount is needed.
    var cfg_rf = 0;
    var scfg = Sandbox_config(sandbox);
    if (scfg != 0) { cfg_rf = SandboxConfig_rootfs(scfg); }
    var _mb = str_builder_new();
    str_builder_add_cstr(_mb, cwd_json);
    # Unconditional, as `confine_child` sets it on every rootfs'd process-backend
    # run, whatever the policy. runsc honours it too (runsc/boot/loader.go).
    str_builder_add_cstr(_mb, ",\"noNewPrivileges\":true");
    str_builder_add_cstr(_mb, caps_json);
    if (cfg_rf != 0) { str_builder_add_cstr(_mb, "},\"root\":{\"path\":\""); }
    else { str_builder_add_cstr(_mb, "},\"root\":{\"path\":\"rootfs\",\"readonly\":"); }
    var mid1b = str_data(str_builder_build(_mb));
    memcpy(buf + pos, mid1a, strlen(mid1a)); pos = pos + strlen(mid1a);
    memcpy(buf + pos, mid1b, strlen(mid1b)); pos = pos + strlen(mid1b);
    if (cfg_rf != 0) {
        var rf_esc = oci_json_escape(cfg_rf);
        memcpy(buf + pos, rf_esc, strlen(rf_esc)); pos = pos + strlen(rf_esc);
        var rf_tail = "\",\"readonly\":";
        memcpy(buf + pos, rf_tail, strlen(rf_tail)); pos = pos + strlen(rf_tail);
    }
    memcpy(buf + pos, readonly, strlen(readonly)); pos = pos + strlen(readonly);
    # A minimal mounts list. Without /proc runc panics in its own init
    # ("at least one candidate /proc/thread-self path should work"); without a
    # /dev tmpfs it fails setting up the standard /dev symlinks. Neither is
    # optional, and an image rootfs supplies neither — the previous spec emitted
    # no mounts at all, which is survivable only because it also pointed at an
    # empty rootfs and therefore never got far enough to care.
    var mnt_proc = "},\"mounts\":[{\"destination\":\"/proc\",\"type\":\"proc\",\"source\":\"proc\"},";
    var mnt_dev = "{\"destination\":\"/dev\",\"type\":\"tmpfs\",\"source\":\"tmpfs\",";
    var mnt_devopt = "\"options\":[\"nosuid\",\"strictatime\",\"mode=755\",\"size=65536k\"]}]";
    memcpy(buf + pos, mnt_proc, strlen(mnt_proc)); pos = pos + strlen(mnt_proc);
    memcpy(buf + pos, mnt_dev, strlen(mnt_dev)); pos = pos + strlen(mnt_dev);
    memcpy(buf + pos, mnt_devopt, strlen(mnt_devopt)); pos = pos + strlen(mnt_devopt);
    var mid2 = ",\"linux\":{\"namespaces\":[";
    memcpy(buf + pos, mid2, strlen(mid2)); pos = pos + strlen(mid2);
    memcpy(buf + pos, netns, strlen(netns)); pos = pos + strlen(netns);
    var ns_rest = "{\"type\":\"pid\"},{\"type\":\"ipc\"},{\"type\":\"uts\"},{\"type\":\"mount\"}]";
    # ROOTLESS: an unprivileged runc refuses outright — "rootless container
    # requires user namespaces" — unless the spec declares a user namespace AND
    # id mappings. Without this every OCI-backed container failed for a
    # non-root caller, and the failure was invisible because a runc that never
    # starts writes nothing to the captured stdout.
    if (sys_getuid() != 0) {
        var ns_user = "{\"type\":\"user\"},";
        # Insert the user namespace FIRST — runc requires it before the others
        # it will create inside it.
        memcpy(buf + pos, ns_user, strlen(ns_user)); pos = pos + strlen(ns_user);
    }
    memcpy(buf + pos, ns_rest, strlen(ns_rest)); pos = pos + strlen(ns_rest);
    if (sys_getuid() != 0) {
        # Map our uid/gid to 0 inside, so image files owned by root are usable.
        var m1 = ",\"uidMappings\":[{\"containerID\":0,\"hostID\":";
        memcpy(buf + pos, m1, strlen(m1)); pos = pos + strlen(m1);
        var ub[24];
        var ulen = fmt_int_buf(sys_getuid(), &ub);
        memcpy(buf + pos, &ub, ulen); pos = pos + ulen;
        var m2 = ",\"size\":1}],\"gidMappings\":[{\"containerID\":0,\"hostID\":";
        memcpy(buf + pos, m2, strlen(m2)); pos = pos + strlen(m2);
        var gb[24];
        var glen = fmt_int_buf(kv_getgid(), &gb);
        memcpy(buf + pos, &gb, glen); pos = pos + glen;
        var m3 = ",\"size\":1}]";
        memcpy(buf + pos, m3, strlen(m3)); pos = pos + strlen(m3);
    }
    memcpy(buf + pos, resources, strlen(resources)); pos = pos + strlen(resources);
    memcpy(buf + pos, seccomp_json, strlen(seccomp_json)); pos = pos + strlen(seccomp_json);
    memcpy(buf + pos, paths_json, strlen(paths_json)); pos = pos + strlen(paths_json);
    var tail = "}}";
    memcpy(buf + pos, tail, strlen(tail)); pos = pos + strlen(tail);
    # The sizing above must cover every byte written (3.12.9). A bump allocator
    # hides a write past `buf`: the bytes land in memory already handed out, and
    # the spec still looks right, which is how the argv undercount survived. So
    # an undercount is refused here, and a test can see it, rather than being
    # returned as if the buffer held it.
    if (pos >= cap) { return 0; }
    store8(buf + pos, 0);
    return buf;
}

# Create bundle dir under /tmp with an empty rootfs and a config.json.
# Mode 0700 on both dirs; file_write_secure opens with O_CREAT|O_EXCL|
# O_NOFOLLOW, mode 0600. Any mkdir failure aborts — no "silently clobber
# an attacker-staged symlink" path. See ADR-005 §C3 + §C4.
# Returns the bundle path, or 0 on failure.
fn oci_prepare_bundle(container_id, sandbox, command) {
    var bundle = alloc(32 + strlen(container_id));
    var pos = 0;
    var prefix = "/tmp/";
    memcpy(bundle + pos, prefix, strlen(prefix)); pos = pos + strlen(prefix);
    memcpy(bundle + pos, container_id, strlen(container_id)); pos = pos + strlen(container_id);
    store8(bundle + pos, 0);
    # Mode 0700 = 448. EEXIST aborts (random id, so collision is attack-
    # signal, not natural occurrence).
    if (kv_mkdir(bundle, 448) < 0) { return 0; }

    # Only stage an empty bundle rootfs when the sandbox has none of its own;
    # with a configured rootfs the spec points at it absolutely.
    var cfg_rootfs = 0;
    var pb_cfg = Sandbox_config(sandbox);
    if (pb_cfg != 0) { cfg_rootfs = SandboxConfig_rootfs(pb_cfg); }
    var rootfs = alloc(strlen(bundle) + 8);
    memcpy(rootfs, bundle, strlen(bundle));
    memcpy(rootfs + strlen(bundle), "/rootfs", 8);
    if (cfg_rootfs == 0) {
        if (kv_mkdir(rootfs, 448) < 0) { kv_rmdir(bundle); return 0; }
    }

    var cfg_path = alloc(strlen(bundle) + 16);
    memcpy(cfg_path, bundle, strlen(bundle));
    memcpy(cfg_path + strlen(bundle), "/config.json", 13);

    var spec = oci_generate_spec(sandbox, command);
    if (spec == 0) {
        kv_rmdir(rootfs);
        kv_rmdir(bundle);
        return 0;
    }
    var r = file_write_secure(cfg_path, spec, strlen(spec));
    if (r < 0) {
        kv_rmdir(rootfs);
        kv_rmdir(bundle);
        return 0;
    }
    return bundle;
}

# Best-effort cleanup: unlink config.json, rmdir rootfs/, rmdir bundle/.
fn oci_cleanup_bundle(bundle) {
    var cfg_path = alloc(strlen(bundle) + 16);
    memcpy(cfg_path, bundle, strlen(bundle));
    memcpy(cfg_path + strlen(bundle), "/config.json", 13);
    kv_unlink(cfg_path);

    var rootfs = alloc(strlen(bundle) + 8);
    memcpy(rootfs, bundle, strlen(bundle));
    memcpy(rootfs + strlen(bundle), "/rootfs", 8);
    kv_rmdir(rootfs);

    kv_rmdir(bundle);
    return 0;
}

# --- confine.cyr ---

# confine.cyr — the child-side confinement sequence, shared by every backend
# that forks (3.9.1).
#
# Extracted from spawn.cyr so the BLOCKING exec path can use it too:
# `backend_process.cyr` is included before `spawn.cyr` (spawn needs its
# `_split_command`), so it cannot reach into spawn — and without this split only
# detached containers would enter their rootfs, which would be a stranger bug
# than the one being fixed.
#
# Everything here runs in the CHILD, after fork and before execve.

# Highest fd we scan when clearing inherited descriptors. close_range(2) would
# be tidier but is not in the frozen syscall surface this module may use.
var SPAWN_MAX_FD = 1024;

# O_WRONLY|O_CREAT|O_APPEND, mode 0644. Append rather than truncate: a restarted
# container should extend its log, not silently erase the evidence of why the
# previous attempt died.
var SPAWN_LOG_FLAGS = 1089;
var SPAWN_LOG_MODE = 420;

# Child exit codes for a confinement step that could not be applied. The child
# _exits rather than execing, so the payload never runs less confined than the
# policy promised — and the specific code says which primitive was missing.
enum SpawnExit {
    SPAWN_EXIT_STDIO = 120;
    SPAWN_EXIT_CGROUP = 121;
    SPAWN_EXIT_NNP = 122;
    SPAWN_EXIT_NS = 123;
    SPAWN_EXIT_LANDLOCK = 124;
    SPAWN_EXIT_SECCOMP = 125;
    SPAWN_EXIT_ROOTFS = 119;
    SPAWN_EXIT_IDMAP = 118;
    SPAWN_EXIT_WORKDIR = 117;
    SPAWN_EXIT_CAPS = 116;
    SPAWN_EXIT_PROC = 115;
    SPAWN_EXIT_READONLY = 114;
    SPAWN_EXIT_DEV = 113;
}

# 3.14.6: the capabilities a payload with a rootfs keeps unless its config names
# others, as a mask: `oci_default_capabilities()`, which a payload reads as
# `CapEff: 00000000a00405fb`. A constant because `confine_child` runs after fork,
# where it cannot allocate, and `test_capability_masks` holds it to the list.
var KAVACH_CAPS_DEFAULT = 0xA00405FB;

# prctl(2) options and the capget(2) header version, which the stdlib does not name.
var KAVACH_PR_CAPBSET_READ = 23;
var KAVACH_PR_CAPBSET_DROP = 24;
var KAVACH_CAP_VERSION_3 = 0x20080522;

# CAP_SYS_ADMIN's bit. With it and no filter a payload unmounts the read-only `/proc`
# and `/sys`, and as root mounts a `/proc` of its own (3.14.7).
var KAVACH_CAP_SYS_ADMIN = 21;
# CAP_SETPCAP's bit, which dropping from the bounding set takes (3.14.8).
var KAVACH_CAP_SETPCAP = 8;

# statfs(2) f_type values (linux/magic.h), and where f_type and f_flags sit in the
# 64-bit Linux `struct statfs`, the same on x86-64 and aarch64. The stdlib's STATFS_*
# name neither field.
var KAVACH_PROC_SUPER_MAGIC = 0x9FA0;
var KAVACH_SYSFS_MAGIC = 0x62656572;
var KAVACH_STATFS_TYPE = 0;
var KAVACH_STATFS_FLAGS = 80;

# The mount flags the stdlib's MsFlag does not name, and statfs's ST_RELATIME, the one
# ST_* bit whose MS_* counterpart has another value. The rest share them.
var KAVACH_MS_NOATIME = 1024;
var KAVACH_MS_NODIRATIME = 2048;
var KAVACH_MS_RELATIME = 2097152;
var KAVACH_ST_RELATIME = 4096;

# Namespace flags implied by the policy.
#
# `network_enabled == 0` asks for a private network namespace. Note this reads a
# field that `policy_new` zero-fills, so the DEFAULT policy requests network
# isolation — that is the intended default for a sandbox, and the exec path's
# failure to act on it is a gap there, not a licence to ignore it here.
#
# Unprivileged `unshare(CLONE_NEWNET)` is EPERM: an unprivileged process may
# only create a network namespace as part of a NEW USER namespace, which is
# exactly how rootless containers get one. So when we are not root we pair
# NS_USER with it. Running as root, the user namespace is unnecessary and adds a
# uid-mapping step nothing here needs, so it is omitted.
#
# 3.14.8: not for a policy naming TCP ports (`policy_network_allow_tcp`). A fresh
# network namespace holds only a loopback that is down, so the ports would reach
# nothing; landlock holds that payload to them instead, with no namespace.
#[must_use]
fn _spawn_ns_flags(policy, rootfs) {
    var f = 0;
    if (policy != 0) {
        if (SandboxPolicy_network_enabled(policy) == 0 && policy_network_tcp_rules(policy) == 0) {
            f = f | NS_NETWORK;
        }
    }
    # Entering a rootfs needs a mount namespace of our own, or making `/`
    # private and entering it would affect the host.
    if (rootfs != 0) { f = f | NS_MOUNT; }
    if (f == 0) { return 0; }
    # Unprivileged, neither a network nor a mount namespace is obtainable on its
    # own — both require being in a NEW USER namespace, which is how rootless
    # containers get them. As root the user namespace is unnecessary.
    if (sys_getuid() != 0) { f = f | NS_USER; }
    return f;
}

# mount(2) flags used to detach our mount namespace from the host's.
var MS_REC_PRIVATE = 278528;        # MS_REC (0x4000) | MS_PRIVATE (0x40000)
var MS_REC_BIND = 20480;            # MS_REC (0x4000) | MS_BIND (0x1000)
var KAVACH_MNT_DETACH = 2;

# Map our uid/gid to root INSIDE the new user namespace.
#
# Without this every file in the rootfs is owned by `nobody` from the payload's
# point of view, and anything needing uid 0 (most container images) fails in a
# way that looks like a corrupt image rather than a missing mapping.
# `setgroups=deny` first is mandatory for an unprivileged writer of gid_map —
# the kernel refuses the gid_map otherwise.
fn _spawn_write_idmaps(uid, gid) {
    file_write_all("/proc/self/setgroups", "deny", 4);
    var ub[64];
    var un = fmt_int_buf(0, &ub);
    store8(&ub + un, 32);
    un = un + 1 + fmt_int_buf(uid, &ub + un + 1);
    store8(&ub + un, 32);
    store8(&ub + un + 1, 49);                       # '1'
    if (file_write_all("/proc/self/uid_map", &ub, un + 2) < 0) { return 0 - 1; }
    var gb[64];
    var gn = fmt_int_buf(0, &gb);
    store8(&gb + gn, 32);
    gn = gn + 1 + fmt_int_buf(gid, &gb + gn + 1);
    store8(&gb + gn, 32);
    store8(&gb + gn + 1, 49);
    if (file_write_all("/proc/self/gid_map", &gb, gn + 2) < 0) { return 0 - 1; }
    return 0;
}

# ---- A caller's /proc and /sys in a rootfs (3.14.7) ------------------------
#
# A rootfs entered with no `/proc` of kavach's own may hold one the caller mounted:
# the postgres entry point needs one (ADR-009). There, through 3.14.6, uid 0 with the
# twelve opened `core_pattern` and `sysrq-trigger` to write, because that access is
# uid 0's and not a capability's. These make a `/proc` and a `/sys` there what runc
# makes them: `security_readonly_path`'s read-only and `security_masked_path`'s
# masked, and a sysfs read-only, as runc's spec mounts one. See ADR-010.
#
# They run in the child, from `_spawn_enter_rootfs`, with the cwd at the top of the
# new root, so every path is relative to it. ⛔ LINUX ONLY: on agnos `sys_mount`,
# `sys_lstat` and `sys_statfs` take other arguments, so every body is out of that build.

# 1 when `path` is a directory, not a symlink, on a filesystem of type `magic`.
fn _spawn_is_fs(path, magic) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var st[144];
    if (kv_lstat(path, &st) != 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x4000) { return 0; }
    var sfs[2176];
    if (sys_statfs(path, &sfs) != 0) { return 0; }
    if ((load64(&sfs + KAVACH_STATFS_TYPE) & 0xFFFFFFFF) != magic) { return 0; }
    return 1;
    #endif
}

# The flags a bind remount of `path` must carry over, or -1. In a user namespace the
# kernel locks nosuid, nodev, noexec and the atime flags of every mount it copied,
# and a remount that drops one reads EPERM, so they are read from the mount itself.
fn _spawn_locked_flags(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfs[2176];
    if (sys_statfs(path, &sfs) != 0) { return 0 - 1; }
    var st = load64(&sfs + KAVACH_STATFS_FLAGS);
    var f = st & (MS_NOSUID | MS_NODEV | MS_NOEXEC | KAVACH_MS_NOATIME | KAVACH_MS_NODIRATIME);
    if ((st & KAVACH_ST_RELATIME) != 0) { f = f | KAVACH_MS_RELATIME; }
    return f;
    #endif
}

# Bind `path` onto itself and remount it read-only. Returns 0, or -1.
#
# Not recursive first, so a mount below `path` is not carried into the bind: a
# read-only remount is not recursive, and binfmt_misc under `/proc/sys`, or a cgroup
# or debugfs under `/sys`, would keep its own flags and stay writable. The bind then
# hides them. In a user namespace the kernel refuses that bind (EINVAL) when a locked
# mount is below, and there it is recursive: such a mount is owned by a uid the
# payload is not, and writing to it reads EACCES. A path the kernel does not have is
# skipped, as runc skips it.
fn _spawn_readonly(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var r = sys_mount(path, path, 0, MS_BIND, 0);
    if (r == 0 - ENOENT) { return 0; }
    if (r == 0 - EINVAL) { r = sys_mount(path, path, 0, MS_REC_BIND, 0); }
    if (r != 0) { return 0 - 1; }
    var f = _spawn_locked_flags(path);
    if (f < 0) { return 0 - 1; }
    if (sys_mount(0, path, 0, MS_REMOUNT | MS_BIND | MS_RDONLY | f, 0) != 0) { return 0 - 1; }
    return 0;
    #endif
}

# Mask `path` as runc's maskPath does: the host's /dev/null over a file, and an empty
# read-only tmpfs over a directory. Returns 0, or -1. A path the kernel does not have
# is skipped. The caller has checked that /dev/null is a character device, so an
# ENOENT here is the target's.
fn _spawn_mask(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var st[144];
    var l = kv_lstat(path, &st);
    if (l == 0 - ENOENT) { return 0; }
    if (l != 0) { return 0 - 1; }
    var r = 0;
    if ((load32(&st + STAT_MODE) & 0xF000) == 0x4000) {
        r = sys_mount("tmpfs", path, "tmpfs", MS_RDONLY, 0);
    } else {
        r = sys_mount("/dev/null", path, 0, MS_BIND, 0);
    }
    if (r != 0) { return 0 - 1; }
    return 0;
    #endif
}

# 1 when `p`, a path from the tables, is under `top`, which ends in a slash.
fn _spawn_path_under(p, top) {
    var n = strlen(top);
    if (strlen(p) < n) { return 0; }
    return memeq(p, top, n);
}

# Guard a `/proc` and a `/sys` at the top of the cwd. Returns 0, or -1 when one is
# there and could not be guarded, and the payload must not run.
#
# Before the pivot, where /dev/null is the host's: a rootfs as kavach leaves it has
# no /dev, and runc's own check on a rootfs's /dev/null exists because a payload's
# image can make that one a symlink (CVE-2025-31133). The host's is checked too.
#
# ⚠ Only `/proc` and `/sys`, as runc's lists name them, and only as directories: a
# symlink would resolve against the host here, so it is left to
# `_spawn_proc_sys_held`, which refuses one that leads to an unguarded procfs. A
# procfs the caller mounted anywhere else in the rootfs is not found: see ADR-010.
fn _spawn_guard_proc_sys() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var has_proc = _spawn_is_fs("proc", KAVACH_PROC_SUPER_MAGIC);
    var has_sys = _spawn_is_fs("sys", KAVACH_SYSFS_MAGIC);
    if (has_proc == 0 && has_sys == 0) { return 0; }
    var st[144];
    if (kv_lstat("/dev/null", &st) != 0) { return 0 - 1; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x2000) { return 0 - 1; }
    # runc's order: the read-only paths, then the masks.
    if (has_sys == 1) {
        if (_spawn_readonly("sys") != 0) { return 0 - 1; }
    }
    var i = 0;
    while (i < SECURITY_READONLY_PATHS) {
        var rp = security_readonly_path(i) + 1;
        if (has_proc == 1 && _spawn_path_under(rp, "proc/") == 1) {
            if (_spawn_readonly(rp) != 0) { return 0 - 1; }
        }
        i = i + 1;
    }
    i = 0;
    while (i < SECURITY_MASKED_PATHS) {
        var mp = security_masked_path(i) + 1;
        var want = 0;
        if (has_proc == 1 && _spawn_path_under(mp, "proc/") == 1) { want = 1; }
        if (has_sys == 1 && _spawn_path_under(mp, "sys/") == 1) { want = 1; }
        if (want == 1) {
            if (_spawn_mask(mp) != 0) { return 0 - 1; }
        }
        i = i + 1;
    }
    return 0;
    #endif
}

# After the pivot, whether a `/proc` and a `/sys` the payload will meet are guarded.
# Returns 0, or -1, and then the payload must not run.
#
# `_spawn_guard_proc_sys` runs before the pivot, where an absolute symlink in the
# rootfs resolves against the host, so it guards only a `proc` or `sys` that is a
# directory. After the pivot a symlink resolves inside the rootfs, and could lead to a
# procfs nothing guarded. This follows it, as the payload will: a procfs at `/proc`
# must have a read-only `/proc/sys`, and a sysfs at `/sys` must be read-only.
fn _spawn_proc_sys_held() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfs[2176];
    if (sys_statfs("/proc", &sfs) == 0) {
        if ((load64(&sfs + KAVACH_STATFS_TYPE) & 0xFFFFFFFF) == KAVACH_PROC_SUPER_MAGIC) {
            var r = sys_statfs("/proc/sys", &sfs);
            if (r != 0 && r != 0 - ENOENT) { return 0 - 1; }
            if (r == 0 && (load64(&sfs + KAVACH_STATFS_FLAGS) & MS_RDONLY) == 0) { return 0 - 1; }
        }
    }
    if (sys_statfs("/sys", &sfs) == 0) {
        if ((load64(&sfs + KAVACH_STATFS_TYPE) & 0xFFFFFFFF) == KAVACH_SYSFS_MAGIC) {
            if ((load64(&sfs + KAVACH_STATFS_FLAGS) & MS_RDONLY) == 0) { return 0 - 1; }
        }
    }
    return 0;
    #endif
}

# ---- A /dev of kavach's own in a rootfs (3.14.8) ---------------------------
#
# Through 3.14.7 a payload with a rootfs met whatever `dev` the caller left there.
# ADR-009 ran postgres with the caller's `/dev` an rbind of the host's, and a payload
# holding the twelve then opened the host's disk, `/dev/nvme0n1`, read-only: uid 0
# owns the node, so no capability is asked for, and the process path has no device
# cgroup to refuse it, as runc's does. Now, as runc does, the payload never sees a
# `dev` it was handed: where the rootfs has a `dev` directory, kavach mounts a tmpfs
# over it holding runc's default devices bound from the host's, a devpts of its own,
# a tmpfs `/dev/shm` and runc's links, the four into /proc only where the rootfs has a
# procfs at /proc. The maintainer chose this over a cgroup
# device program, which needs bpf(2), a cgroup and root, and over covering only a
# `dev` something is mounted on. See ADR-011.
#
# A rootfs with no `dev` keeps having none, since kavach makes no directory in the
# caller's tree. One whose `dev` is a symlink is refused: before the pivot it would
# resolve against the host. Like the /proc guards, this runs before the pivot with
# the cwd at the top of the new root, and is ⛔ LINUX ONLY.

# The host nodes the payload gets, runc's default devices: null, zero, full, random,
# urandom and tty, by index, as literals, so the child reads them with no
# allocation. A node the host does not have is left out, as runc leaves one out.
var KAVACH_DEV_NODES = 6;

fn _spawn_dev_node(i) {
    if (i == 0) { return "null"; }
    if (i == 1) { return "zero"; }
    if (i == 2) { return "full"; }
    if (i == 3) { return "random"; }
    if (i == 4) { return "urandom"; }
    if (i == 5) { return "tty"; }
    return 0;
}

# "<prefix><name>" into `buf` (at least 64 bytes), NUL-terminated. Returns `buf`.
fn _spawn_join(buf, prefix, name) {
    var pn = strlen(prefix);
    var nn = strlen(name);
    memcpy(buf, prefix, pn);
    memcpy(buf + pn, name, nn);
    store8(buf + pn + nn, 0);
    return buf;
}

# Make the rootfs's `dev` kavach's own. `userns` is 1 when the child is in a user
# namespace of its own, where only uid and gid 0 are mapped, so devpts takes no
# `gid=5`. `self_root` is 1 for a rootfs of "/", whose `dev` is the host's own and
# is read through a descriptor taken before it is covered. Returns the device id of
# the new `dev`, for `_spawn_dev_held`, 0 when there is no `dev` to make, or -1
# when one is there and could not be made, and the payload must not run.
fn _spawn_own_dev(userns, self_root) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var st[144];
    var l = kv_lstat("dev", &st);
    if (l == 0 - ENOENT) { return 0; }
    if (l != 0) { return 0 - 1; }
    var mode = load32(&st + STAT_MODE) & 0xF000;
    if (mode == 0xA000) { return 0 - 1; }                 # a symlink: refused
    if (mode != 0x4000) { return 0; }                     # a file: nothing to cover
    # The host's devices, as a prefix: "/dev/", or for a rootfs of "/" the host's
    # `/dev` through a descriptor held open under the tmpfs that covers it.
    var src[64];
    var prefix = "/dev/";
    var hostfd = 0 - 1;
    if (self_root == 1) {
        hostfd = file_open("/dev", O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0);
        if (hostfd < 0) { return 0 - 1; }
        var pb[48];
        var pn = 0;
        memcpy(&pb, "/proc/self/fd/", 14);
        pn = 14 + fmt_int_buf(hostfd, &pb + 14);
        store8(&pb + pn, 47);                              # '/'
        store8(&pb + pn + 1, 0);
        prefix = &pb;
    }
    var r = sys_mount("tmpfs", "dev", "tmpfs", MS_NOSUID, "mode=755,size=65536k");
    if (r != 0) {
        if (hostfd >= 0) { sys_close(hostfd); }
        return 0 - 1;
    }
    var dst[64];
    var i = 0;
    while (i < KAVACH_DEV_NODES) {
        var name = _spawn_dev_node(i);
        _spawn_join(&src, prefix, name);
        var sst[144];
        # A char device, or it is left out: a host without the node, or with
        # something else at its name, gives the payload nothing there.
        if (sys_stat(&src, &sst) == 0 && (load32(&sst + STAT_MODE) & 0xF000) == 0x2000) {
            _spawn_join(&dst, "dev/", name);
            var f = file_open(&dst, O_WRONLY | O_CREAT | O_CLOEXEC, 438);
            if (f < 0) { r = 0 - 1; }
            else {
                sys_close(f);
                if (sys_mount(&src, &dst, 0, MS_BIND, 0) != 0) { r = 0 - 1; }
            }
        }
        i = i + 1;
    }
    if (hostfd >= 0) { sys_close(hostfd); }
    if (r != 0) { return 0 - 1; }
    if (kv_mkdir("dev/pts", 493) != 0) { return 0 - 1; }
    var pts_opts = "newinstance,ptmxmode=0666,mode=0620,gid=5";
    if (userns == 1) { pts_opts = "newinstance,ptmxmode=0666,mode=0620"; }
    if (sys_mount("devpts", "dev/pts", "devpts", MS_NOSUID | MS_NOEXEC, pts_opts) != 0) { return 0 - 1; }
    if (kv_mkdir("dev/shm", 1023) != 0) { return 0 - 1; }
    if (sys_mount("shm", "dev/shm", "tmpfs", MS_NOSUID | MS_NODEV | MS_NOEXEC,
        "mode=1777,size=65536k") != 0) {
        return 0 - 1;
    }
    # runc's links into /proc only where the rootfs has a procfs at /proc, as a
    # caller who mounted one does: runc always mounts one, and kavach does not. With
    # none they would dangle, and an open of one with O_CREAT fails where through
    # 3.14.7 it made a file: nginx:alpine's error log is a link to /dev/stderr, and
    # measured, it stopped starting with them. Without a /proc the payload meets what
    # 3.14.7 gave it there.
    if (_spawn_is_fs("proc", KAVACH_PROC_SUPER_MAGIC) == 1) {
        if (sys_symlink("/proc/self/fd", "dev/fd") != 0) { return 0 - 1; }
        if (sys_symlink("/proc/self/fd/0", "dev/stdin") != 0) { return 0 - 1; }
        if (sys_symlink("/proc/self/fd/1", "dev/stdout") != 0) { return 0 - 1; }
        if (sys_symlink("/proc/self/fd/2", "dev/stderr") != 0) { return 0 - 1; }
    }
    if (sys_symlink("pts/ptmx", "dev/ptmx") != 0) { return 0 - 1; }
    var dst2[144];
    if (sys_stat("dev", &dst2) != 0) { return 0 - 1; }
    var id = load64(&dst2);
    if (id == 0) { id = 1; }
    return id;
    #endif
}

# After the pivot, whether `/dev` is the one `_spawn_own_dev` made (`dev_id`, its
# device id, or 0 when it made none). Returns 0, or -1, and then the payload must
# not run.
fn _spawn_dev_held(dev_id) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (dev_id <= 0) { return 0; }
    var st[144];
    if (sys_stat("/dev", &st) != 0) { return 0 - 1; }
    if (load64(&st) != dev_id) { return 0 - 1; }
    return 0;
    #endif
}

# Remount the root read-only, for a policy with `read_only_rootfs` (3.14.7). Through
# 3.14.6 the flag was scored and nothing on the process path applied it. Run after
# the pivot, where `/` is the rootfs's own bind, so only that mount changes: a `/proc`
# or `/sys` below keeps what `_spawn_guard_proc_sys` gave it. Returns 0, or -1.
fn _spawn_readonly_root() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var f = _spawn_locked_flags("/");
    if (f < 0) { return 0 - 1; }
    if (sys_mount(0, "/", 0, MS_REMOUNT | MS_BIND | MS_RDONLY | f, 0) != 0) { return 0 - 1; }
    return 0;
    #endif
}

# Enter `rootfs` — the step whose absence made every container before 3.9.1 run
# host binaries.
#
# Requires a mount namespace already unshared (the caller does that with
# NS_MOUNT), or the private-mount call below would alter the HOST's propagation.
#
# pivot_root(2), runc's sequence, since 3.14.6. Through 3.14.5 this was chroot(2),
# which moves a process's root and leaves the old tree in its mount namespace. A
# payload left in three calls, needing no fd from outside: `chroot("sub")` puts its
# cwd outside the new root, `..` from there walks to the top of the namespace, and
# `chroot(".")` settles there. It held CAP_SYS_CHROOT, nothing denies `chroot`, and
# that held rootless too (docs/development/issues/archived/2026-11-06-process-backend-
# keeps-every-capability.md). Here nothing is left to walk up to, because the old root is
# detached, so a payload may hold CAP_SYS_CHROOT, as `oci_default_capabilities` has
# it do. See ADR-009.
#
# pivot_root wants a mount point, so the rootfs is bound onto itself first, and
# MS_REC because a user namespace refuses to bind a subtree holding locked mounts
# without it. The rest is the sequence pivot_root(2) gives for needing no temporary
# directory: `pivot_root(".", ".")` stacks the old root on top of the new one, and
# `.` resolves up that stack, so the detach takes the old root off.
#
# ⛔ FAILS CLOSED where this cannot run, with no fall back to chroot, which is the
# escape. pivot_root(2) names a root on the initial ramfs as one such host (read, not
# run). A caller that is itself chrooted onto a plain directory is refused sooner, at
# the private mount, as it was through 3.14.5, and onto a mount point it works.
#
# 3.14.7: a `/proc` or `/sys` the caller mounted in the rootfs is made what runc makes
# them (`_spawn_guard_proc_sys`), between the bind and the pivot. Returns 0, -1 when
# the rootfs cannot be entered, or -2 when a `/proc` or `/sys` there cannot be guarded.
fn _spawn_enter_rootfs(rootfs) {
    var userns = 0;
    if (sys_getuid() != 0) { userns = 1; }
    return _spawn_enter_rootfs_ns(rootfs, userns);
}

# The same, told whether the child is in a user namespace of its own (`userns`).
# 3.14.8: and the rootfs's `dev` made kavach's own (`_spawn_own_dev`), between the
# /proc guards and the pivot, or -3 when it cannot be.
fn _spawn_enter_rootfs_ns(rootfs, userns) {
    if (rootfs == 0) { return 0; }
    # ⛔ LINUX ONLY, AND IT MUST FAIL CLOSED ELSEWHERE. This is mount-namespace + pivot_root
    # confinement: agnos has no mount namespaces, no `pivot_root`, and no `chdir` syscall — `sys_mount`
    # is a 0-argument stub there and `SYS_CHDIR` is not in the enum at all, so this function did not
    # even COMPILE for `--agnos`, taking every consumer of `[deps.kavach]` down with it.
    # ⚠ The agnos arm returns -1, NOT 0. Returning 0 would report "the payload is confined to
    # `rootfs`" on a platform where nothing of the sort happened — a sandbox that silently is not
    # one. A caller that cannot confine must be told it cannot confine.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Detach propagation, or our mounts leak to the host.
    if (sys_mount(0, "/", 0, MS_REC_PRIVATE, 0) < 0) { return 0 - 1; }
    # "/" is the root already, with nothing above it to leave, and pivot_root reads
    # EBUSY for a new root on the mount it would replace.
    if (streq(rootfs, "/") == 1) {
        if (syscall(SYS_CHDIR, "/") < 0) { return 0 - 1; }
        if (_spawn_guard_proc_sys() != 0) { return 0 - 2; }
        if (_spawn_proc_sys_held() != 0) { return 0 - 2; }
        var self_dev = _spawn_own_dev(userns, 1);
        if (self_dev < 0) { return 0 - 3; }
        if (_spawn_dev_held(self_dev) != 0) { return 0 - 3; }
        return 0;
    }
    if (sys_mount(rootfs, rootfs, 0, MS_REC_BIND, 0) < 0) { return 0 - 1; }
    if (syscall(SYS_CHDIR, rootfs) < 0) { return 0 - 1; }
    # Before the pivot: the mask's /dev/null is the host's, and a bind from a mount
    # the pivot then detaches reads EINVAL. The cwd is the bind, so the relative
    # paths resolve in it, and the mounts move with it. The same holds for the
    # devices `_spawn_own_dev` binds, which come after, so the masks' /dev/null is
    # the host's and not the rootfs's.
    if (_spawn_guard_proc_sys() != 0) { return 0 - 2; }
    var dev_id = _spawn_own_dev(userns, 0);
    if (dev_id < 0) { return 0 - 3; }
    if (sys_pivot_root(".", ".") < 0) { return 0 - 1; }
    if (sys_umount2(".", KAVACH_MNT_DETACH) < 0) { return 0 - 1; }
    # As runc does, because the kernel promises nothing about the cwd after this.
    if (syscall(SYS_CHDIR, "/") < 0) { return 0 - 1; }
    if (_spawn_proc_sys_held() != 0) { return 0 - 2; }
    if (_spawn_dev_held(dev_id) != 0) { return 0 - 3; }
    return 0;
    #endif
}

# 3.12.2: chdir into the payload's configured working directory.
#
# ⚠ MUST run AFTER `_spawn_enter_rootfs`, or the path resolves against the HOST
# filesystem — a `workdir` of `/app` would land in the host's `/app` and the
# payload would run outside the container with no error. `_spawn_enter_rootfs`
# already `chdir("/")`s after the pivot, so this refines a cwd that is already
# inside the root rather than establishing one.
#
# ⚠ FAILS CLOSED. A workdir the caller asked for and did not get is a silently
# wrong environment — the payload runs somewhere it was not told to. runc errors
# out in the same situation, and so does this: the child `_exit`s with
# SPAWN_EXIT_WORKDIR rather than falling through to execve from the wrong
# directory. `workdir == 0` (the default) is not a request and returns 0.
fn _spawn_enter_workdir(workdir) {
    if (workdir == 0) { return 0; }
    if (strlen(workdir) == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no chdir syscall — see _spawn_enter_rootfs. A caller that asked
    # for a workdir must be told it did not get one.
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (syscall(SYS_CHDIR, workdir) < 0) { return 0 - 1; }
    return 0;
    #endif
}

# Bound the calling process, the child, to `mask`: the bounding set, then permitted
# and effective, with inheritable empty, which takes ambient with it. Returns 0, or
# -1 when a capability that had to go could not be dropped.
#
# The bounding set is what holds. A payload running as uid 0, in the host's user
# namespace or its own, takes its permitted set from it at `execve`. CAP_SETPCAP
# drops it, so that comes before the `capset` that may give it up.
#
# A bound, not a grant. `mask` is cut to what the caller holds, because `capset`
# refuses more, and NO_NEW_PRIVS stops `execve` adding any.
#
# 3.14.8: on every confined payload, not only one with a rootfs. A caller that is
# not uid 0 and holds no CAP_SETPCAP, as a rootless kavach outside a user namespace
# does, cannot drop the bounding set and need not: under NO_NEW_PRIVS a file's
# capabilities and a set-id bit grant nothing at `execve`, and only uid 0 takes
# the bounding set there. Its permitted, effective and inheritable sets are still
# lowered to `mask`, which holds with nothing held. uid 0 without CAP_SETPCAP
# cannot be bounded, and fails closed.
#
# ⛔ LINUX ONLY, like the sequence.
fn _spawn_bound_capabilities(mask) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var hdr[8];
    var data[24];
    store32(&hdr, KAVACH_CAP_VERSION_3);
    store32(&hdr + 4, 0);
    memset(&data, 0, 24);
    if (sys_capget(&hdr, &data) != 0) { return 0 - 1; }
    var eff = load32(&data) | (load32(&data + 12) << 32);
    var held = load32(&data + 4) | (load32(&data + 16) << 32);
    if (((eff >> KAVACH_CAP_SETPCAP) & 1) == 1) {
        var i = 0;
        while (i < 64) {
            if (((mask >> i) & 1) == 0) {
                # EINVAL is past the kernel's last capability.
                var bounded = syscall(SYS_PRCTL, KAVACH_PR_CAPBSET_READ, i, 0, 0, 0);
                if (bounded < 0) { break; }
                if (bounded == 1) {
                    if (syscall(SYS_PRCTL, KAVACH_PR_CAPBSET_DROP, i, 0, 0, 0) < 0) { return 0 - 1; }
                }
            }
            i = i + 1;
        }
    } else {
        if (sys_geteuid() == 0) { return 0 - 1; }
    }
    var keep = mask & held;
    memset(&data, 0, 24);
    store32(&data, keep & 0xFFFFFFFF);
    store32(&data + 4, keep & 0xFFFFFFFF);
    store32(&data + 12, keep >> 32);
    store32(&data + 16, keep >> 32);
    if (sys_capset(&hdr, &data) != 0) { return 0 - 1; }
    return 0;
    #endif
}

# Why `config`'s capability list cannot be honoured here, as a message, or 0.
# CAP_SYS_ADMIN under a filter
# is not refused, unlike `oci_capabilities_refusal`: that rule answers a runtime
# resolving a filter by name and skipping one it does not know, and this filter
# compares numbers, so `open_tree_attr` is denied here.
#
# 3.14.7: CAP_SYS_ADMIN with no filter is refused. It unmounts the read-only `/proc`
# and `/sys` that `_spawn_guard_proc_sys` makes, and as root mounts a `/proc` of its
# own, so with it the masks would mean nothing. A filter denies `mount`, `umount2`,
# `move_mount` and the rest of the mount API, and there the masks hold.
#
# 3.14.8: read with no rootfs too, since a list applies to every confined payload.
# The CAP_SYS_ADMIN rule stays a rootfs's: with no rootfs there is no `/proc` of
# the caller's to unmount, and the payload is on the host's files already.
#[must_use]
fn confine_capabilities_refusal(config) {
    if (config == 0) { return 0; }
    var v = SandboxConfig_capabilities(config);
    if (v == 0) { return 0; }
    var unknown = security_capability_refusal(v);
    if (unknown != 0) { return unknown; }
    if (SandboxConfig_rootfs(config) == 0) { return 0; }
    if (((security_capability_mask(v) >> KAVACH_CAP_SYS_ADMIN) & 1) == 1) {
        var p = SandboxConfig_policy(config);
        var filtered = 0;
        if (p != 0) { filtered = SandboxPolicy_seccomp_enabled(p); }
        if (filtered != 1) {
            return "CAP_SYS_ADMIN with a rootfs needs a seccomp filter: without one it unmounts the read-only /proc";
        }
    }
    return 0;
}

# `config`'s capabilities as a mask, for `confine_child_caps`. Built in the PARENT,
# because alloc after fork is unsafe and the list is strings.
#[must_use]
fn confine_capabilities(config) {
    if (config == 0) { return KAVACH_CAPS_DEFAULT; }
    var v = SandboxConfig_capabilities(config);
    if (v == 0) { return KAVACH_CAPS_DEFAULT; }
    return security_capability_mask(v);
}

# SIGPIPE back to its default in the payload (3.13.2), with the stdlib's
# `signal_default`. A signal set to SIG_IGN stays ignored across `execve`, so a
# payload inherited SIGPIPE ignored whenever kavach's own process ignored it, as
# a server often does and as the GitHub Actions runner starts its steps. A
# payload writing to a closed pipe then got EPIPE where it dies of SIGPIPE
# outside a sandbox: measured, `head` writing past a full capture exited 1, not
# 141. agnosai filed the stdlib function for this divergence. The capture,
# `sandbox_spawn` and persistent guests call it first in the child.
fn _spawn_default_sigpipe() {
    signal_default(SIGPIPE);
    return 0;
}

# The capture's payload dies with kavach (3.13.2): PR_SET_PDEATHSIG (1) with
# SIGKILL (9), set in the child before `execve`, which keeps it for a binary
# that is not set-id. Through 3.13.1 a payload outlived a kavach killed
# mid-capture (measured: its `sleep` still running after kavach's SIGKILL), and
# gVisor and SY-agnos had the stdlib capture's guard until they moved onto this
# one. `getppid` against `ppid`, read before the fork, catches a parent that
# died before the `prctl`, when the signal would never come.
#
# Only for the capture, where kavach waits on the payload. `sandbox_spawn` and
# persistent guests hand the caller a handle to a process meant to run on.
fn _spawn_die_with_parent(ppid) {
    # ⛔ LINUX ONLY: `SYS_PRCTL` is not in the agnos syscall enum, and the one
    # caller, the capture, is compiled out there.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    syscall(SYS_PRCTL, 1, 9, 0, 0, 0);
    if (sys_getppid() != ppid) { sys_exit(1); }
    return 0;
    #endif
}

# Close every descriptor from `from` up to SPAWN_MAX_FD. Errors are expected
# and ignored — most of the range is simply not open. The one fd spared is the
# pinned binary the child is about to exec (kv_exec_pin, util.cyr). It is a
# close-on-exec fd to a FILE, and it only exists when there is no rootfs, so it
# is never a directory outside the root, which is what closing the rest is for.
fn _spawn_close_inherited(from) {
    var fd = from;
    while (fd < SPAWN_MAX_FD) {
        if (fd != _kv_exec_keep_fd) { sys_close(fd); }
        fd = fd + 1;
    }
    return 0;
}

# Put the CALLING process into `cgroup_path`. Returns 0 on success, -1 on
# failure. Called in the child, so "the calling process" is the payload.
fn _spawn_cgroup_join(cgroup_path) {
    if (cgroup_path == 0) { return 0; }
    var fpath = _cgroup_file(cgroup_path, "cgroup.procs");
    var buf[32];
    var len = fmt_int_buf(sys_getpid(), &buf);
    if (file_write_all(fpath, &buf, len) < 0) { return 0 - 1; }
    return 0;
}

# Install `policy`'s landlock ruleset in the calling process, the child, after
# the rootfs and before `execve`. Returns 0, also on a kernel with no landlock, or
# -1 when the ruleset could not be applied.
#
# `confine_child` and the persistent guest's sequence both call this, so they
# cannot differ on what a policy means. Until 3.11.3 `confine_child` passed
# `(0, 0)`, which `security_apply_landlock` answers `Ok(0)` at once: the count
# was checked, the rules never sent, and no ruleset installed.
#
# A deny-all policy (`policy_landlock_is_deny_all`) gets a ruleset naming no
# path, whatever its list holds: the null list gives the walk nothing, and the
# count still makes `security_apply_landlock` install the ruleset. Through
# 3.13.0 both paths passed the list, and the walk, bounded by the list and the
# count, applied every rule in it, so a deny-all policy that also named paths
# permitted them. Any other policy holds at least `count` rules, and the first
# `count` are applied. Unlike the code it replaced, this makes no list after
# `fork` for a count with no list.
#
# The policy's scopes go into the same ruleset (3.13.2): `landlock_abstract_unix`
# and `landlock_signal`, which `policy_strict()` sets, confine the payload's
# abstract unix sockets and signals to its own landlock domain. Through 3.13.1
# they were stored and scored and applied by nothing; a `policy_strict()`
# payload could signal kavach itself. A policy with scopes and no rules gets a
# ruleset of scopes alone.
#
# **Every confined payload gets a domain** (3.14.8), whatever the policy names,
# from `security_apply_landlock_domain`. A domain refuses ptrace access, and with it
# `/proc/<pid>/root`, to a process outside it: through 3.14.7 a payload with a
# caller's `/proc` read a file in a sibling sandbox's root as root. On ABI v6 the
# domain scopes its signals, so a payload signals neither kavach nor a sibling.
# And a policy denying network (`network_enabled = 0`) has its TCP binds and
# connects refused by it, but for the ports it names, where it is not in a network
# namespace of its own: agnosai filed that most hosts refuse the namespace.
#
# `net_deny` is `_spawn_net_alone`'s answer: 1 when the payload is denied network
# and has no network namespace of its own to deny it.
fn _spawn_apply_landlock(policy, net_deny) {
    var count = 0;
    var scopes = 0;
    var rules = 0;
    var binds = 0;
    var connects = 0;
    if (policy != 0) {
        count = SandboxPolicy_landlock_rules_len(policy);
        if (count < 0) { count = 0; }
        scopes = _spawn_landlock_scopes(policy);
        rules = SandboxPolicy_landlock_rules(policy);
        if (policy_landlock_is_deny_all(policy) == 1) { rules = 0; }
        if (net_deny == 1) {
            binds = SandboxPolicy_network_tcp_bind(policy);
            connects = SandboxPolicy_network_tcp_connect(policy);
        }
    }
    if (is_ok(security_apply_landlock_domain(rules, count, scopes, net_deny, binds, connects)) == 0) {
        return 0 - 1;
    }
    return 0;
}

# 1 when the payload's network is denied without a namespace (3.14.8): `policy`
# has `network_enabled = 0`, the confinement made no network namespace (`nsf`, the
# flags it created), and the kernel has landlock's network rights (ABI v4). The
# payload then gets landlock's TCP rule and `security_net_seccomp_filter`, both or
# neither. In a namespace of its own the namespace is the isolation, as through
# 3.14.7. Below ABI v4 neither applies and nothing changes from 3.14.7: the payload
# keeps the network, and `score_config` gives it no credit for it.
fn _spawn_net_alone(policy, nsf) {
    if (policy == 0) { return 0; }
    if (SandboxPolicy_network_enabled(policy) != 0) { return 0; }
    if ((nsf & NS_NETWORK) != 0) { return 0; }
    if (security_landlock_abi_version() < 4) { return 0; }
    return 1;
}

# Load `security_net_seccomp_filter` in the child. 0, or -1.
fn _spawn_load_net_filter() {
    var info = security_net_seccomp_filter();
    if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(info),
          security_seccomp_filter_len(info))) == 0) {
        return 0 - 1;
    }
    return 0;
}

# The landlock scopes `policy` asks for, as the kernel's mask.
fn _spawn_landlock_scopes(policy) {
    var scopes = 0;
    if (SandboxPolicy_landlock_abstract_unix(policy) == 1) {
        scopes = scopes | LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET;
    }
    if (SandboxPolicy_landlock_signal(policy) == 1) { scopes = scopes | LANDLOCK_SCOPE_SIGNAL; }
    return scopes;
}

# Redirect stdio for the detached child: stdin from /dev/null, stdout+stderr to
# `log_path` (or /dev/null when none was given). Returns 0 / -1.
fn _spawn_redirect_stdio(log_path) {
    var devnull = file_open("/dev/null", O_RDONLY, 0);
    if (devnull < 0) { return 0 - 1; }
    kv_dup2(devnull, 0);
    sys_close(devnull);

    var out = 0 - 1;
    if (log_path != 0) {
        out = file_open(log_path, SPAWN_LOG_FLAGS, SPAWN_LOG_MODE);
    }
    if (out < 0) {
        out = file_open("/dev/null", O_WRONLY, 0);
        if (out < 0) { return 0 - 1; }
    }
    kv_dup2(out, 1);
    kv_dup2(out, 2);
    if (out > 2) { sys_close(out); }
    return 0;
}

# Apply the whole confinement sequence in the child. Returns 0, or does not
# return (each step _exits with its own code so a caller can tell which
# primitive was unavailable).
#
# Order is security-relevant and is the reason this is one function rather than
# a checklist each backend re-implements:
#   fds -> cgroup -> NO_NEW_PRIVS -> namespaces (+idmap) -> rootfs (+ a caller's
#   /proc and /sys guarded) -> read-only root -> landlock -> capabilities -> seccomp
# seccomp is last because it denies mount/pivot_root/unshare; rootfs entry precedes
# landlock because landlock path rules resolve against the current root, and the
# capabilities follow landlock because its rules open their paths. The mounts that
# guard `/proc` and make the root read-only come before the capabilities, which
# take away the CAP_SYS_ADMIN they need and that would undo them.
# `want_ns` (3.11.3) — whether to create namespaces as the policy requests.
#
# **1 for every caller that predates 3.11.3, and their behaviour is unchanged.**
# `sandbox_spawn` in particular has a fail-closed namespace contract with a test
# to match: a policy asking for network isolation on a host that denies
# unprivileged user namespaces must exit 123/118 rather than run the payload
# less isolated than promised.
#
# 0 for exactly one caller: the rootfs-less capture that 3.11.3 added so
# `seccomp_enabled` would stop being ignored. That path previously applied
# **nothing at all**, so seccomp + landlock is a strict gain — but making
# unprivileged namespace creation a *precondition* for it would turn payloads
# that used to run into payloads that do not run, on any host restricting user
# namespaces (Ubuntu 24.04 does). It claims no network isolation it did not get;
# a caller wanting that guarantee uses a rootfs-bearing sandbox or
# `sandbox_spawn`, both of which still fail closed.
fn confine_child(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns) {
    return confine_child_wd(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, 0);
}

# 3.12.2: the same sequence with the payload's working directory. `workdir == 0`
# is the pre-3.12.2 behaviour (cwd `/` inside the rootfs), so the wrapper above
# is unchanged for every existing caller — the same discipline `confine_capture`
# follows for `input` and `confine_capture_input_env` for `env`.
fn confine_child_wd(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, workdir) {
    return confine_child_caps(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, workdir,
      KAVACH_CAPS_DEFAULT);
}

# 3.14.6: the same sequence with the capabilities a payload with a rootfs keeps, as
# a mask (`confine_capabilities`). The wrapper above gives it the default, so a
# caller of `dist/kavach-confine.cyr` passing a rootfs gets the bound unasked.
#
# 3.14.8: `caps` applies with no rootfs too (the issue's Ask 3, as the maintainer
# decided). Through 3.14.7 a uid 0 payload with no rootfs kept every capability
# kavach held, CAP_SYS_MODULE, CAP_SYS_RAWIO and CAP_SYS_ADMIN among them, and
# read `/proc/kcore`. ⚠ It is still on the host's files: no set bounds uid 0 from
# what root owns, and `core_pattern` opens to write with `CapEff` zero, which
# SECURITY.md says. A landlock rule (`policy_landlock_add`) is what bounds that.
# See ADR-009 and ADR-011.
fn confine_child_caps(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, workdir, caps) {
    # ⛔ THE WHOLE SEQUENCE IS LINUX-SPECIFIC and none of it exists on agnos: no cgroups, no
    # `prctl`, no namespaces, no landlock, no seccomp. `SYS_PRCTL` is not even in the agnos syscall
    # enum, so this function failed to COMPILE for `--agnos` and took every consumer of
    # `[deps.kavach]` with it — including consumers that never sandbox anything.
    # ⚠ FAIL CLOSED, and loudly. Returning 0 here would tell a caller "the child is confined" on a
    # platform where not one primitive ran — a sandbox that is silently not a sandbox, which is the
    # worst failure mode this file has. agnos sandboxing goes through backend_sy_agnos, not here.
    #ifdef CYRIUS_TARGET_AGNOS
    sys_exit(SPAWN_EXIT_NNP);
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    _spawn_close_inherited(3);
    if (_spawn_cgroup_join(cgroup_path) != 0) { sys_exit(SPAWN_EXIT_CGROUP); }
    if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }

    # `want_ns` is 0 only for the capture path added in 3.11.3 — see the note
    # on `confine_child`'s signature.
    #
    # ⛔ A rootfs always gets its namespaces, whatever `want_ns` says (3.12.9).
    # `_spawn_enter_rootfs` makes `/` private and pivots, and with no mount
    # namespace of our own that `mount` lands in the caller's: as root, the
    # host's propagation. kavach's own callers pass want_ns = 1 whenever there
    # is a rootfs, but this function is exported (`dist/kavach-confine.cyr`),
    # and a caller passing 0 with a rootfs reached exactly that.
    var nsf = 0;
    if (want_ns != 0 || rootfs != 0) { nsf = _spawn_ns_flags(policy, rootfs); }
    if (nsf != 0) {
        if (is_ok(security_create_namespace(nsf)) == 0) { sys_exit(SPAWN_EXIT_NS); }
        if ((nsf & NS_USER) != 0) {
            # Its OWN code. Creating the namespace and mapping ids into it are
            # different privileges that fail on different hosts — a CI runner
            # already inside a restricted user namespace creates one happily and
            # then cannot write uid_map. Sharing SPAWN_EXIT_NS between them made
            # the two indistinguishable, which is exactly the opacity the
            # per-step codes exist to remove.
            if (_spawn_write_idmaps(uid, gid) != 0) { sys_exit(SPAWN_EXIT_IDMAP); }
        }
    }
    var userns = 0;
    if ((nsf & NS_USER) != 0) { userns = 1; }
    var entered = _spawn_enter_rootfs_ns(rootfs, userns);
    if (entered == 0 - 2) { sys_exit(SPAWN_EXIT_PROC); }
    if (entered == 0 - 3) { sys_exit(SPAWN_EXIT_DEV); }
    if (entered != 0) { sys_exit(SPAWN_EXIT_ROOTFS); }
    if (rootfs != 0 && policy != 0) {
        if (SandboxPolicy_read_only_rootfs(policy) == 1) {
            if (_spawn_readonly_root() != 0) { sys_exit(SPAWN_EXIT_READONLY); }
        }
    }
    # After the pivot, so the path resolves inside the container. See the fn's header.
    if (_spawn_enter_workdir(workdir) != 0) { sys_exit(SPAWN_EXIT_WORKDIR); }

    var net_alone = _spawn_net_alone(policy, nsf);
    if (_spawn_apply_landlock(policy, net_alone) != 0) { sys_exit(SPAWN_EXIT_LANDLOCK); }
    if (rootfs != 0) {
        # 3.14.7: CAP_SYS_ADMIN with no filter unmounts the read-only `/proc` and, as
        # root, mounts a `/proc` of its own, so it is refused without one. The
        # parent refuses it sooner (`confine_capabilities_refusal`); this holds for a
        # caller of `confine_child_caps` that passed the mask itself.
        if (((caps >> KAVACH_CAP_SYS_ADMIN) & 1) == 1 && seccomp_info == 0) {
            sys_exit(SPAWN_EXIT_CAPS);
        }
    }
    # 3.14.8: with a rootfs or without one.
    if (_spawn_bound_capabilities(caps) != 0) { sys_exit(SPAWN_EXIT_CAPS); }
    if (seccomp_info != 0) {
        if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(seccomp_info),
              security_seccomp_filter_len(seccomp_info))) == 0) {
            sys_exit(SPAWN_EXIT_SECCOMP);
        }
    }
    # 3.14.8: the network rules landlock's TCP rights leave to a filter.
    if (net_alone == 1) {
        if (_spawn_load_net_filter() != 0) { sys_exit(SPAWN_EXIT_SECCOMP); }
    }
    return 0;
    #endif
}

# Human-readable name for a confinement exit code, or 0 when `code` is not one.
#
# The child _exits with a distinct code per failed primitive, which is precise
# but opaque at the call site: "the container exited 123" says nothing, and a
# caller staring at that has no way to know the host simply cannot create user
# namespaces. Callers should run a non-zero exit through this before reporting.
#[must_use]
fn spawn_exit_name(code) {
    if (code == SPAWN_EXIT_STDIO) { return "cannot redirect stdio"; }
    if (code == SPAWN_EXIT_CGROUP) { return "cannot join cgroup"; }
    if (code == SPAWN_EXIT_NNP) { return "cannot set no_new_privs"; }
    if (code == SPAWN_EXIT_NS) {
        return "cannot create namespaces (unprivileged user namespaces may be disabled on this host)";
    }
    if (code == SPAWN_EXIT_LANDLOCK) { return "cannot apply landlock"; }
    if (code == SPAWN_EXIT_SECCOMP) { return "cannot load seccomp filter"; }
    if (code == SPAWN_EXIT_ROOTFS) { return "cannot enter rootfs"; }
    if (code == SPAWN_EXIT_CAPS) { return "cannot bound capabilities"; }
    if (code == SPAWN_EXIT_PROC) { return "cannot make /proc or /sys in the rootfs read-only"; }
    if (code == SPAWN_EXIT_READONLY) { return "cannot make the rootfs read-only"; }
    if (code == SPAWN_EXIT_DEV) { return "cannot give the payload a /dev of its own in the rootfs"; }
    if (code == SPAWN_EXIT_IDMAP) {
        return "cannot write uid_map/gid_map (already inside a restricted user namespace?)";
    }
    # 0 is the contract, not an oversight: "this is not a confinement code",
    # which `test_spawn_exit_name` asserts for a normal exit and for 127.
    # Callers must not hand it straight to a string function — see the guard in
    # `test_spawn_namespaces_environment_aware`, where an unexpected code would
    # otherwise turn a failed assertion into a SIGSEGV.
    return 0;
}

# 1 when this host can actually create the namespaces `flags` asks for.
#
# Probes in a FORKED CHILD, because unshare(2) mutates the caller — there is no
# way to ask "would this work?" without doing it. Hosts with
# `kernel.unprivileged_userns_clone=0`, some hardened distros, and many CI
# containers deny unprivileged user namespaces outright, and a caller wanting to
# degrade gracefully (or a test wanting to skip) needs to know that up front
# rather than decoding a child exit code afterwards.
#[must_use]
fn spawn_namespaces_available(flags) {
    # ⛔ LINUX ONLY. This PROBES namespace availability by forking a child; agnos has no fork,
    # no namespaces, and no uid_map. ⚠ Answering 0 ("unavailable") is the honest and SAFE answer —
    # a caller that believes namespaces exist would build a policy it cannot enforce.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    if (flags == 0) { return 1; }
    # Read the ids BEFORE the fork. Inside a fresh user namespace getuid()
    # reports the UNMAPPED id (nobody), and a uid_map written against that is
    # rejected — the probe would then report "unavailable" on a host that works
    # perfectly. sandbox_spawn reads them in the parent for the same reason.
    var probe_uid = sys_getuid();
    var probe_gid = kv_getgid();
    var pid = kv_fork();
    if (pid < 0) { return 0; }
    if (pid == 0) {
        if (is_ok(security_create_namespace(flags)) == 0) { sys_exit(1); }
        # Creating the namespace is only half of it — mapping ids into it is a
        # separate privilege, and a host can grant the first and refuse the
        # second. Probing only the first reports "available" for a spawn that
        # will still die.
        if ((flags & NS_USER) != 0) {
            if (_spawn_write_idmaps(probe_uid, probe_gid) != 0) { sys_exit(1); }
        }
        sys_exit(0);
    }
    var st[4];
    store32(&st, 0);
    kv_waitpid(pid, &st, 0);
    var status = load32(&st);
    if ((status & 127) != 0) { return 0; }
    if (((status >> 8) & 255) != 0) { return 0; }
    return 1;
}

# 1 when this host will actually load a seccomp filter.
#
# Same shape and same reason as spawn_namespaces_available: the filter is loaded
# in the CHILD, so a host that refuses it turns every spawn into an opaque
# `SPAWN_EXIT_SECCOMP`. Probes in a fork because loading a filter is
# irreversible for the calling process.
#[must_use]
fn spawn_seccomp_available() {
    # ⛔ LINUX ONLY — forks a child to test-load a seccomp filter. agnos has neither.
    # ⚠ 0 = "no seccomp here", which is true, and which keeps callers from promising a filter.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    var res_t, res_v = security_create_exec_seccomp_filter();
    if (is_ok(res_t) == 0) { return 0; }
    var info = result_unwrap(res_t, res_v);
    var pid = kv_fork();
    if (pid < 0) { return 0; }
    if (pid == 0) {
        if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(info),
              security_seccomp_filter_len(info))) == 0) {
            sys_exit(1);
        }
        sys_exit(0);
    }
    var st[4];
    store32(&st, 0);
    kv_waitpid(pid, &st, 0);
    var status = load32(&st);
    if ((status & 127) != 0) { return 0; }
    if (((status >> 8) & 255) != 0) { return 0; }
    return 1;
}

# Fork, confine, exec, and capture stdout — the blocking counterpart of
# sandbox_spawn, used when the sandbox names a rootfs.
#
# The stdlib's `exec_capture` forks and execs on the HOST; it has no seam for a
# child-side confinement step, which is why a rootfs-bearing sandbox needs its
# own fork here rather than a flag passed down.
#
# Returns bytes captured, or -1.
# `timeout_ms` (3.11.4) — wall-clock budget, 0 for none. On expiry the payload
# is SIGKILLed and reaped, and `confine_last_timed_out()` reports it.
#
# **`SandboxConfig.timeout_ms` was accepted and ignored by every backend except
# WASM.** A config with a 1000 ms deadline ran `/bin/sleep 8` for 8001 ms and
# reported `timed_out = 0` — the bound was not enforced and the flag said it
# had been. `process_exec` now passes the config's deadline here.
#
# `do_confine` (3.11.4) — whether to run `confine_child` at all. 0 gives a plain
# fork/exec capture, which is what the non-confining path used to get from the
# stdlib's `exec_capture`. Routing it through here instead is what gives that
# path a real exit code and a deadline; `exec_capture` discards the wait status
# and has no seam for either.
fn confine_capture_input(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len) {
    return confine_capture_input_env(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, input, input_len, 0);
}

# 3.12.0: the same path with an explicit payload environment. `env == 0` is the
# empty envp every caller got before, so the wrapper above is unchanged
# behaviour — the same discipline `confine_capture` follows for `input`.
fn confine_capture_input_env(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env) {
    return confine_capture_input_env_wd(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, input, input_len, env, 0);
}

# 3.12.2: …and the payload's working directory. `workdir == 0` is unchanged
# behaviour, so the wrapper above covers every 3.12.0/3.12.1 caller.
#
# ⚠ The parameter list grew to 14 by strict append-and-wrap, which kept every release
# source-compatible and is where it stops. What comes next is a `ConfineCapture`
# field: `caps` was the first (3.14.6).
fn confine_capture_input_env_wd(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env, workdir) {
    var c = confine_capture_new(args, policy, rootfs, cgroup_path, seccomp_info,
      buf, buflen, want_ns, timeout_ms, do_confine, input, input_len, env, workdir);
    var n = confine_capture_run(c);
    confine_capture_release(c);
    return n;
}

# One capture: everything `confine_capture_run` reads, and since 3.14.8 what it
# found, which the fields after `caps` hold.
#
# **A run's result is the capture's** (3.14.8). Through 3.14.7 it was the process's:
# the stderr went into one static buffer as it arrived, and the exit code and the
# deadline flag into three globals, which each backend read back. Two captures on
# two threads wrote the same buffer at once. agnosai measured 100 to 125 runs of 200
# returning a stderr that was not their own, or two spliced, with `/bin/ls` and
# `/bin/cat` on two threads through `sandbox_exec`. Now each capture has a stderr
# buffer of its own, and kavach's backends read the capture they ran.
#
#   total      what `confine_capture_run` returned: the bytes in `buf`, or -1
#   exit       the payload's exit code, 128 + the signal that ended it
#   timed_out  1 when the deadline killed it
#   err        its stderr, NUL-terminated, up to CONFINE_ERR_MAX - 1 bytes
#   err_len    how many of those bytes it wrote
#
# `err` is an anonymous mapping of CONFINE_ERR_MAX bytes, so it costs the pages the
# payload's stderr fills, and `confine_capture_release` gives it back.
#derive(accessors)
struct ConfineCapture {
    args;
    policy;
    rootfs;
    cgroup_path;
    seccomp_info;
    buf;
    buflen;
    want_ns;
    timeout_ms;
    do_confine;
    input;
    input_len;
    env;
    workdir;
    caps;
    total;
    exit;
    timed_out;
    err;
    err_len;
}
var CONFINE_CAPTURE_SIZE = 160;

# A capture of what the positional wrappers above have always taken, with `caps` at
# the default. A caller with a config sets `caps` from `confine_capabilities`.
fn confine_capture_new(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env, workdir) {
    var c = alloc(CONFINE_CAPTURE_SIZE);
    ConfineCapture_set_args(c, args);
    ConfineCapture_set_policy(c, policy);
    ConfineCapture_set_rootfs(c, rootfs);
    ConfineCapture_set_cgroup_path(c, cgroup_path);
    ConfineCapture_set_seccomp_info(c, seccomp_info);
    ConfineCapture_set_buf(c, buf);
    ConfineCapture_set_buflen(c, buflen);
    ConfineCapture_set_want_ns(c, want_ns);
    ConfineCapture_set_timeout_ms(c, timeout_ms);
    ConfineCapture_set_do_confine(c, do_confine);
    ConfineCapture_set_input(c, input);
    ConfineCapture_set_input_len(c, input_len);
    ConfineCapture_set_env(c, env);
    ConfineCapture_set_workdir(c, workdir);
    ConfineCapture_set_caps(c, KAVACH_CAPS_DEFAULT);
    ConfineCapture_set_total(c, 0 - 1);
    ConfineCapture_set_exit(c, 0);
    ConfineCapture_set_timed_out(c, 0);
    ConfineCapture_set_err(c, 0);
    ConfineCapture_set_err_len(c, 0);
    return c;
}

# Fork, confine, exec and capture. Returns the bytes in `buf`, or -1. The rest of
# the run is the capture's (`ConfineCapture_exit`, `_timed_out`, `_err` and
# `_err_len`), and is copied to `confine_last_*` for a caller on one thread.
fn confine_capture_run(c) {
    var n = _confine_capture_run(c);
    ConfineCapture_set_total(c, n);
    return n;
}

# Give back a capture's stderr buffer. The capture's other fields stay readable;
# its stderr reads empty after this. Safe to call twice.
fn confine_capture_release(c) {
    if (c == 0) { return 0; }
    var e = ConfineCapture_err(c);
    if (e != 0) {
        backend_capture_release(e, CONFINE_ERR_MAX);
        ConfineCapture_set_err(c, 0);
        ConfineCapture_set_err_len(c, 0);
    }
    return 0;
}

# The capture's stderr, NUL-terminated, "" when it has none.
#[must_use]
fn confine_capture_stderr(c) {
    if (c == 0) { return ""; }
    var e = ConfineCapture_err(c);
    if (e == 0) { return ""; }
    return e;
}

# What the capture's run wrote to stderr is also what `confine_last_*` reads, for
# a caller with one thread. ⚠ Those are still one process's, so with two captures
# at once they read whichever finished last: a caller with threads reads the
# capture it ran.
fn _confine_mirror_last(c) {
    var n = ConfineCapture_err_len(c);
    var e = ConfineCapture_err(c);
    if (e != 0 && n > 0) { memcpy(&_confine_err_buf, e, n); }
    else { n = 0; }
    store8(&_confine_err_buf + n, 0);
    _confine_err_len = n;
    _confine_last_exit = ConfineCapture_exit(c);
    _confine_last_timed_out = ConfineCapture_timed_out(c);
    return 0;
}

fn _confine_capture_run(c) {
    var args = ConfineCapture_args(c);
    var policy = ConfineCapture_policy(c);
    var rootfs = ConfineCapture_rootfs(c);
    var cgroup_path = ConfineCapture_cgroup_path(c);
    var seccomp_info = ConfineCapture_seccomp_info(c);
    var buf = ConfineCapture_buf(c);
    var buflen = ConfineCapture_buflen(c);
    var want_ns = ConfineCapture_want_ns(c);
    var timeout_ms = ConfineCapture_timeout_ms(c);
    var do_confine = ConfineCapture_do_confine(c);
    var input = ConfineCapture_input(c);
    var input_len = ConfineCapture_input_len(c);
    var env = ConfineCapture_env(c);
    var workdir = ConfineCapture_workdir(c);
    var caps = ConfineCapture_caps(c);
    # ⛔ LINUX ONLY — the fork/confine/execve/capture path. agnos has no fork by design and its
    # sandboxing goes through backend_sy_agnos, not this file.
    # ⚠ -1, never a fabricated success: a caller must not receive an empty capture buffer and
    # conclude the payload ran and printed nothing.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    # **The body is excluded from the agnos build, not merely unreachable on it.**
    # The `#ifdef` arm above returns before any of this runs, but a preprocessor
    # arm is not a compiler arm: the lines below are still compiled, and
    # `SYS_FCNTL` does not exist in the agnos syscall enum. That is a hard error
    # since cyrius made arity/undefined-symbol mismatches fatal, and because
    # `cyrius build` auto-prepends every `[deps.*]` module, it fails **any**
    # `--agnos` consumer that declares `[deps.kavach]` — including one that never
    # touches this backend. The non-blocking drain added in 3.11.5 is what
    # introduced the reference.
    #ifndef CYRIUS_TARGET_AGNOS
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    # No buffer (3.14.7: `backend_capture_buf` answers 0 when it has none) is a
    # failed capture, never a write through a null pointer.
    if (buf == 0 || buflen < 2) { return 0 - 1; }
    # The capture's own stderr buffer (3.14.8), taken before the fork as stdout's is.
    var ebuf = ConfineCapture_err(c);
    if (ebuf == 0) {
        ebuf = backend_capture_buf(CONFINE_ERR_MAX);
        if (ebuf == 0) { return 0 - 1; }
        ConfineCapture_set_err(c, ebuf);
    }
    ConfineCapture_set_err_len(c, 0);
    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    # Caller-supplied payload environment, or the empty envp when unset. Built
    # in the PARENT — alloc after fork is unsafe, same rule as the argv above.
    var envp = kv_envp_from_vec(env);

    # Read the ids in the PARENT — inside the new user namespace getuid()
    # reports the mapped id, not the one the map must be written against.
    var uid = sys_getuid();
    var gid = kv_getgid();
    # For `_spawn_die_with_parent`, read before the fork.
    var ppid = sys_getpid();

    var pipefd[16];
    sys_pipe(&pipefd);
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);
    # 3.11.5: a SECOND pipe, so the payload's stderr is its own stream. Until
    # then both fds went to one pipe and `backend_capture_finish` then set
    # `ExecResult.stderr` to "" — a field that always read empty, which is a
    # different and false claim from "the payload wrote nothing".
    var epipe[16];
    sys_pipe(&epipe);
    var erfd = load32(&epipe);
    var ewfd = load32(&epipe + 4);
    # 3.11.8: a THIRD pipe, for the payload's stdin — created ONLY when there is
    # something to send. Until then the child inherited the parent's fd 0, so a
    # backend could run a program but could not pass it arguments on stdin,
    # which is the whole contract of every WASM/CLI tool protocol. agnosai filed
    # it while porting `.agpkg`: "a WASM tool that cannot receive parameters is
    # not a port of this file".
    #
    # ⚠ `input == 0` keeps the INHERIT behaviour rather than handing the child an
    # empty stdin. Every pre-3.11.8 caller reaches here through `confine_capture`
    # with `input = 0`, and switching them to an immediate EOF would change what
    # an interactive payload sees.
    var in_rfd = 0 - 1;
    var in_wfd = 0 - 1;
    if (input != 0) {
        var inpipe[16];
        sys_pipe(&inpipe);
        in_rfd = load32(&inpipe);
        in_wfd = load32(&inpipe + 4);
    }
    # Pinned before fork, so the child execs the binary kavach committed to
    # (ADR-005 §H4). Not with a rootfs: there the path must resolve inside it.
    var pin = KV_EXEC_BY_PATH;
    if (rootfs == 0) { pin = kv_exec_pin(vec_get(args, 0)); }
    var pid = kv_fork();
    if (pid < 0) {
        sys_close(rfd); sys_close(wfd); sys_close(erfd); sys_close(ewfd);
        if (in_rfd >= 0) { sys_close(in_rfd); sys_close(in_wfd); }
        if (pin >= 0) { sys_close(pin); }
        return 0 - 1;
    }
    if (pid == 0) {
        _spawn_default_sigpipe();
        _spawn_die_with_parent(ppid);
        _kv_exec_keep_fd = pin;
        sys_close(rfd);
        sys_close(erfd);
        if (in_rfd >= 0) {
            sys_close(in_wfd);
            kv_dup2(in_rfd, 0);
            sys_close(in_rfd);
        }
        kv_dup2(wfd, 1);
        kv_dup2(ewfd, 2);
        sys_close(wfd);
        sys_close(ewfd);
        # ⚠ workdir is passed as 0 here and applied BELOW instead, so it lands
        # whether or not the child is confined. A working directory is process
        # setup, not a confinement primitive — the same reasoning that makes
        # `envp` unconditional. Applying it inside `confine_child_wd` only would
        # mean an UNCONFINED capture silently ignored the caller's workdir, which
        # is the decorative-setter shape this release exists to remove.
        if (do_confine != 0) {
            confine_child_caps(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, 0, caps);
        } else {
            # 3.14.8: an unconfined payload closes what it inherited too. Its pipes
            # are not close-on-exec, and a capture forked on another thread holds
            # this one's: through 3.14.7 such a payload kept them open, so this
            # capture waited for its EOF until that payload exited, and a payload
            # could read or write another run's stdio. The confined path has
            # closed them since 3.9.1, through `confine_child`.
            _spawn_close_inherited(3);
        }
        # After confinement, so the path resolves inside the rootfs when there is one.
        if (_spawn_enter_workdir(workdir) != 0) { sys_exit(SPAWN_EXIT_WORKDIR); }
        kv_exec_child(pin, vec_get(args, 0), argv, envp);
        # execve failed — 127 is the shell's "command not found", and it is
        # visible to the caller instead of being swallowed into a success.
        sys_exit(127);
    }
    if (pin >= 0) { sys_close(pin); }
    sys_close(wfd);
    sys_close(ewfd);

    # **The payload's stdin goes out from inside the drain loop** (3.14.4). Until
    # then it was one blocking write here, before the loop. A guest that writes
    # while it reads fills its stdout pipe while kavach is still blocked on its
    # stdin, and from then on each waits on the other. The deadline is checked
    # only in the loop, so `timeout_ms` never fired: agnosai measured an echoing
    # WASM guest on 200,000 B of stdin holding the calling thread for good. A
    # guest that reads to EOF still gets its EOF: the close comes after the last
    # byte, and straight away for an empty input.
    #
    # O_NONBLOCK belongs to this end's file description, so the payload's read
    # end stays a plain blocking pipe. SIGPIPE is held for the write, since a
    # payload may exit without reading it all: see `_confine_sigpipe_hold`.
    var in_sent = 0;
    var in_failed = 0;
    var in_held = 0;
    var in_mask[8];
    if (in_rfd >= 0) {
        sys_close(in_rfd);
        if (input_len > 0) {
            syscall(SYS_FCNTL, in_wfd, F_SETFL, O_NONBLOCK);
            _confine_sigpipe_hold(&in_mask);
            in_held = 1;
        } else {
            sys_close(in_wfd);
            in_wfd = 0 - 1;
        }
    }

    # **Both ends non-blocking and drained round-robin** (3.11.5). Draining one
    # to EOF and then the other deadlocks the moment the undrained pipe fills
    # (64 KiB): the payload blocks writing to it, so it never closes the first,
    # so the parent's read never finishes. The deadline needs the same
    # non-blocking reads, so the two requirements share one loop.
    syscall(SYS_FCNTL, rfd, 4, 2048);       # F_SETFL, O_NONBLOCK
    syscall(SYS_FCNTL, erfd, 4, 2048);

    var deadline = 0;
    if (timeout_ms > 0) { deadline = mono_now_ns() / 1000000 + timeout_ms; }

    var total = 0;
    var etotal = 0;
    var odone = 0;
    var edone = 0;
    var killed = 0;
    var idle = 0;
    while (odone == 0 || edone == 0 || in_wfd >= 0) {
        var moved = 0;
        if (in_wfd >= 0) {
            var w = sys_write(in_wfd, input + in_sent, input_len - in_sent);
            if (w > 0) {
                in_sent = in_sent + w;
                moved = 1;
            }
            # EAGAIN is a full pipe and EINTR a retry; anything else (EPIPE, the
            # reader is gone) ends the input, and the payload's exit status says
            # what became of it.
            if (w < 0 && w != 0 - EAGAIN && w != 0 - EINTR) { in_failed = 1; }
            if (in_failed == 1 || in_sent >= input_len) {
                sys_close(in_wfd);
                in_wfd = 0 - 1;
            }
        }
        # **A full buffer ends a stream without blocking the payload** (3.13.2).
        # Until then a full buffer only stopped the reads. The payload then
        # blocked writing to that pipe, never closed the other one, and the loop
        # waited for an EOF that could not come: measured, a `/bin/cat` of 2 MB
        # and a shell writing 200 KB of stderr before exiting 3 each hung until
        # the deadline, then reported `timed_out` and exit 137, and hung for good
        # with no deadline. A full stdout is closed, so the payload's next write
        # fails (SIGPIPE, exit 141), as it does under `exec_capture`. A full
        # stderr is read on into a sink, so diagnostics never stop a payload.
        if (odone == 0) {
            var n = sys_read(rfd, buf + total, buflen - 1 - total);
            if (n == 0) { odone = 1; }
            if (n > 0) {
                total = total + n;
                moved = 1;
                if (total >= buflen - 1) {
                    odone = 1;
                    sys_close(rfd);
                    rfd = 0 - 1;
                }
            }
        }
        if (edone == 0) {
            var room = CONFINE_ERR_MAX - 1 - etotal;
            var m = 0;
            # The sink is read into and never read from, so two captures sharing
            # it share nothing either keeps.
            if (room > 0) { m = sys_read(erfd, ebuf + etotal, room); }
            else { m = sys_read(erfd, &_confine_err_sink, CONFINE_ERR_SINK); }
            if (m == 0) { edone = 1; }
            if (m > 0) {
                if (room > 0) { etotal = etotal + m; }
                moved = 1;
            }
        }
        # The deadline is read on every pass, not only an idle one (3.14.4). A
        # payload keeping a pipe busy leaves few idle passes: measured, one writing
        # stderr without pause under a 1000 ms deadline was killed at 2049 ms.
        if (deadline > 0 && mono_now_ns() / 1000000 >= deadline) {
            # Kill FIRST: the payload's pipe ends must close, or the loop
            # would wait on an EOF that is never coming.
            sys_kill(pid, 9);
            killed = 1;
            odone = 1;
            edone = 1;
            if (in_wfd >= 0) {
                sys_close(in_wfd);
                in_wfd = 0 - 1;
            }
        } else {
            if (moved == 0) {
                # An idle iteration still sleeps rather than spinning — a
                # non-blocking read that finds nothing returns at once, and
                # retrying it burns a core for as long as the payload runs.
                #
                # **But it backs off into that, rather than starting there
                # (3.11.7).** A flat `CONFINE_POLL_MS` charges every exec the
                # full interval before its first byte is even readable, and a
                # short payload is *entirely* that wait. Measured on
                # `/bin/echo hi` through the PROCESS backend: **11.96 ms at a
                # flat 5 ms against 4.78 ms at a flat 1 ms** — 2.5x, none of it
                # work. The regression arrived with this loop in 3.11.5 and
                # shipped through 3.11.6 because no benchmark execs anything;
                # `process_exec_echo` exists now so it cannot happen again.
                #
                # The ramp keeps both properties: a fast payload is noticed in
                # about a millisecond, and a slow one still converges to
                # `CONFINE_POLL_MS`, so the CPU argument above is unchanged for
                # exactly the case it was made about.
                idle = idle + 1;
                if (idle < CONFINE_POLL_RAMP) { kv_sleep_ms(1); }
                else { kv_sleep_ms(CONFINE_POLL_MS); }
            } else {
                # While input is going out the pace is the payload's, so it does
                # not settle at the slow end of the ramp: 5 ms a pipeful would cap
                # a large stdin at 13 MiB/s.
                if (in_wfd >= 0) { idle = 0; }
            }
        }
    }
    if (rfd >= 0) { sys_close(rfd); }
    sys_close(erfd);
    if (in_held == 1) { _confine_sigpipe_release(&in_mask, in_failed); }
    store8(ebuf + etotal, 0);
    ConfineCapture_set_err_len(c, etotal);

    var stbuf[4];
    store32(&stbuf, 0);
    if (_confine_reap(pid, &stbuf, killed, deadline) == 1) { killed = 1; }
    ConfineCapture_set_timed_out(c, killed);
    var status = load32(&stbuf);
    var sig = status & 127;
    var code = 0;
    if (sig == 0) { code = (status >> 8) & 255; }
    else { code = 128 + sig; }
    ConfineCapture_set_exit(c, code);
    _confine_mirror_last(c);
    return total;
    #endif
}

# Reap `pid` into `stbuf`, holding it to `deadline` (ms, 0 for none) when it was
# not `killed` already. Returns 1 if the deadline killed it here, else 0.
#
# The drain loop ends at EOF on both streams, and that is not the payload's exit
# (3.14.4): one that closes stdout and stderr and carries on was outside the
# deadline, and held the caller in a blocking wait for as long as it ran.
# Measured, a payload closing its stdio and sleeping under a 1000 ms deadline
# was still running 6 s later.
fn _confine_reap(pid, stbuf, killed, deadline) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (killed == 0 && deadline > 0) {
        while (1 == 1) {
            # 0 is still running. Anything else ends the wait: the pid, or an
            # error such as ECHILD when the host ignores SIGCHLD.
            if (kv_waitpid(pid, stbuf, WNOHANG) != 0) { return 0; }
            if (mono_now_ns() / 1000000 >= deadline) { break; }
            kv_sleep_ms(1);
        }
        sys_kill(pid, 9);
        kv_waitpid(pid, stbuf, 0);
        return 1;
    }
    kv_waitpid(pid, stbuf, 0);
    return 0;
    #endif
}

# Hold SIGPIPE on the calling thread while kavach writes a payload's stdin; the
# caller's mask goes to `mask` (8 bytes).
#
# A payload that exits with stdin unread leaves the write end with no reader, and
# the next write raises SIGPIPE in KAVACH'S process, whose default is to die. It
# was possible before 3.14.4 and needed a payload exiting inside one write; with
# the write in the drain loop a payload has the whole run to do it. The signal
# goes to the writing thread, so a thread mask covers it without touching the
# process-wide disposition, which is the consumer's. The parent only: the child
# has forked already, so the payload does not inherit the block.
fn _confine_sigpipe_hold(mask) {
    #ifndef CYRIUS_TARGET_AGNOS
    var set[8];
    store64(&set, 1 << (SIGPIPE - 1));
    sys_sigprocmask(SIG_BLOCK, &set, mask);
    #endif
    return 0;
}

# Undo `_confine_sigpipe_hold`. After a failed write (`failed` 1) the SIGPIPE it
# raised is pending, and would be delivered when the mask comes back, so it is
# taken first, through a signalfd: the stdlib names no rt_sigtimedwait, and
# CLAUDE.md forbids the raw number. A caller that had SIGPIPE blocked keeps
# whatever is pending, as it would after its own write.
fn _confine_sigpipe_release(mask, failed) {
    #ifndef CYRIUS_TARGET_AGNOS
    var bit = 1 << (SIGPIPE - 1);
    if (failed == 1 && (load64(mask) & bit) == 0) {
        var set[8];
        store64(&set, bit);
        var fd = sys_signalfd(0 - 1, &set, O_NONBLOCK | O_CLOEXEC);
        if (fd >= 0) {
            var info[128];                                  # struct signalfd_siginfo
            sys_read(fd, &info, 128);
            sys_close(fd);
        }
    }
    sys_sigprocmask(SIG_SETMASK, mask, 0);
    #endif
    return 0;
}

# The pre-3.11.8 shape: capture with the child inheriting the parent's stdin.
# Every existing caller lands here, so none of them changed behaviour.
fn confine_capture(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen, want_ns,
  timeout_ms, do_confine) {
    return confine_capture_input(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, 0, 0);
}

# Exit code of the most recent confine_capture. The capture returns a byte
# count, and a caller that only looked at that would report success for a
# payload that never ran — which is exactly how the missing-rootfs bug stayed
# invisible.
#
# ⚠ The process's most recent, copied from the capture when it finishes
# (3.14.8). A caller running captures on two threads reads `ConfineCapture_exit`
# of the capture it ran: this one is whichever finished last.
var _confine_last_exit = 0;

# How often the drain loop looks again while a payload is running.
var CONFINE_POLL_MS = 5;

# Idle iterations spent at 1 ms before falling back to `CONFINE_POLL_MS`.
#
# 8 ms of fine-grained polling covers process startup, which is where a short
# payload's whole latency lives; past that the payload is genuinely working and
# 5 ms granularity costs it nothing. Set this to 0 to restore the flat interval
# 3.11.5 and 3.11.6 shipped.
var CONFINE_POLL_RAMP = 8;

# Ceiling on captured stderr. A payload cannot make the parent allocate without
# bound by writing diagnostics.
var CONFINE_ERR_MAX = 65536;
# The most recent capture's stderr, copied there when it finishes (3.14.8). Until
# then every capture wrote its payload's stderr straight into this buffer, which is
# what two threads raced on. A top-level `var x[N]` is N*8 bytes, so it holds more
# than CONFINE_ERR_MAX.
var _confine_err_buf[65536];
var _confine_err_len = 0;

# Where stderr past `CONFINE_ERR_MAX` is read and dropped (3.13.2): 4096 bytes,
# as 512 slots, since a top-level `var x[N]` is N*8 bytes.
var CONFINE_ERR_SINK = 4096;
var _confine_err_sink[512];

# The payload's stderr from the most recent `confine_capture`, NUL-terminated.
#
# Its own stream since 3.11.5. Before that both fds went to one pipe and
# `ExecResult.stderr` was hardcoded to "" — so a caller that checked it was told
# the payload wrote nothing, which is a different claim from "we did not keep
# it".
#
# ⚠ The process's most recent capture, for a caller with one thread: see
# `_confine_last_exit`. `confine_capture_stderr` reads a capture's own.
#[must_use]
fn confine_last_stderr() { return &_confine_err_buf; }

#[must_use]
fn confine_last_stderr_len() { return _confine_err_len; }

# Whether the most recent `confine_capture` killed its payload on the deadline.
var _confine_last_timed_out = 0;

#[must_use]
fn confine_last_timed_out() { return _confine_last_timed_out; }

#[must_use]
fn confine_last_exit() { return _confine_last_exit; }

# --- backend_dispatch.cyr ---

# kavach — backend dispatch table
# Each backend registers function pointers for exec/health/destroy.
# Lookup is O(1) via Backend enum index.

# Slot layout (per backend, 32 bytes):
#   0: exec_fn(sandbox, command) -> ExecResult*
#   8: health_fn(sandbox) -> 1/0
#  16: destroy_fn(sandbox) -> 0 ok, nonzero err
#  24: spawn_fn(sandbox, command, log_path) -> SpawnedProcess* or 0 (3.14.8), or
#      none: `sandbox_spawn` then detaches the payload on the process path
var _backend_table[320];
var BACKEND_SLOT_SIZE = 32;

fn _backend_slot(backend_id) {
    return &_backend_table + backend_id * BACKEND_SLOT_SIZE;
}

# Bounds-checked fn-pointer fetch. `backend_id` flows from semi-trusted
# config (backend_parse can yield -1); an out-of-range id would otherwise
# index _backend_table[320] out of bounds and load a wild function pointer.
# Returns 0 (== "no implementation") for any id outside [0, KAVACH_BACKEND_COUNT).
fn _backend_fp(backend_id, offset) {
    if (backend_id < 0) { return 0; }
    if (backend_id >= KAVACH_BACKEND_COUNT) { return 0; }
    return load64(_backend_slot(backend_id) + offset);
}

fn backend_register_exec(backend_id, fp) {
    store64(_backend_slot(backend_id) + 0, fp);
    return 0;
}

fn backend_register_health(backend_id, fp) {
    store64(_backend_slot(backend_id) + 8, fp);
    return 0;
}

fn backend_register_destroy(backend_id, fp) {
    store64(_backend_slot(backend_id) + 16, fp);
    return 0;
}

# A backend's own detached spawn (3.14.8): the OCI backend's runs `runc run`.
fn backend_register_spawn(backend_id, fp) {
    store64(_backend_slot(backend_id) + 24, fp);
    return 0;
}

# The spawn `backend_id` registered, or 0 when `sandbox_spawn` detaches its payload
# on the process path.
fn backend_spawn_fn(backend_id) { return _backend_fp(backend_id, 24); }

# Dispatch entry points. Callers pass sandbox pointer (contains config).
# Returns 0 on missing implementation, after logging an error.
fn backend_dispatch_exec(sandbox, command) {
    var bid = SandboxConfig_backend(Sandbox_config(sandbox));
    var fp = _backend_fp(bid, 0);
    if (fp == 0) {
        kavach_err_print(KAVACH_ERR_BACKEND_UNAVAILABLE, os_backend_name(bid));
        return 0;
    }
    return fncall2(fp, sandbox, command);
}

fn backend_dispatch_health(sandbox) {
    var bid = SandboxConfig_backend(Sandbox_config(sandbox));
    var fp = _backend_fp(bid, 8);
    if (fp == 0) { return 0; }
    return fncall1(fp, sandbox);
}

fn backend_dispatch_destroy(sandbox) {
    var bid = SandboxConfig_backend(Sandbox_config(sandbox));
    var fp = _backend_fp(bid, 16);
    if (fp == 0) { return 0; }
    return fncall1(fp, sandbox);
}

fn backend_is_registered(backend_id) {
    if (_backend_fp(backend_id, 0) != 0) { return 1; }
    return 0;
}

# --- backend_noop.cyr ---

# kavach — Noop backend (no isolation, testing only)
# Matches Rust's NoopBackend: returns a clean ExecResult with exit_code=0.

fn noop_exec(sandbox, command) {
    var r = exec_result_new();
    ExecResult_set_exit_code(r, 0);
    ExecResult_set_stdout(r, "");
    ExecResult_set_stderr(r, "");
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

fn noop_health(sandbox) { return 1; }
fn noop_destroy(sandbox) { return 0; }

fn backend_noop_register() {
    backend_register_exec(KavachBackend.NOOP, &noop_exec);
    backend_register_health(KavachBackend.NOOP, &noop_health);
    backend_register_destroy(KavachBackend.NOOP, &noop_destroy);
    return 0;
}

# --- backend_process.cyr ---

# kavach — Process backend (minimum-viable fork+exec+wait via lib/process.cyr)
# Ported from rust-old/src/backend/process/mod.rs
#
# This is the v3.0 skeleton: fork+exec+wait + runtime-guard precheck.
# Seccomp/Landlock/cgroups/namespaces are separate modules that will hook
# into pre_exec once their syscall wrappers land.

var PROCESS_MAX_OUTPUT = 1048576;

# A command line is split on spaces and tabs, with no quote handling. A caller
# whose arguments hold either uses sandbox_exec_argv.

fn process_exec(sandbox, command) {
    var start_ns = mono_now_ns();

    # Reject control chars before tokenizing. A NUL/CR/newline in `command`
    # would otherwise split into multiple argv tokens and smuggle extra
    # arguments past the runtime guard. Tab is allowed as a whitespace
    # separator; newline/CR/NUL/ESC are not. See ADR-005 §H3.
    if (is_safe_argument(command) == 0) {
        var er = exec_result_new();
        ExecResult_set_exit_code(er, 126);
        ExecResult_set_stderr(er, "command contains illegal control chars");
        return er;
    }

    # Runtime-guard precheck — policy-violating commands never hit fork.
    # 3.12.1: a rootfs'd sandbox is a container — its command resolves inside
    # the image, so the host-interpreter blocklist does not apply. See
    # `runtime_guard_config_for_rootfs`.
    var guard_cfg = runtime_guard_config_for_rootfs(
      SandboxConfig_rootfs(Sandbox_config(sandbox)));
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    var args = _sandbox_command_argv(sandbox, command);
    if (vec_len(args) == 0) {
        return backend_error_result("empty command");
    }
    var caps_refused = confine_capabilities_refusal(Sandbox_config(sandbox));
    if (caps_refused != 0) { return backend_error_result(caps_refused); }

    # Cgroup wrap: if the sandbox's policy carries any resource limit
    # (memory.max / cpu.max / pids.max), create a per-sandbox cgroup,
    # wrap the user argv in the cgroup-join sh prelude, and tear the
    # cgroup down after exec. Graceful fall-through when cgroup v2 is
    # unavailable: setup returns 0 and we run unwrapped.
    var cgroup_path = 0;
    var cfg = Sandbox_config(sandbox);
    if (cfg != 0) {
        var policy = SandboxConfig_policy(cfg);
        if (policy != 0) {
            if (cgroup_policy_has_limits(policy) == 1) {
                cgroup_path = cgroup_setup(policy);
                if (cgroup_path != 0) {
                    args = cgroup_wrap_argv(cgroup_path, args);
                }
            }
        }
    }

    # The capture's buffer is taken next to each capture (3.14.7), so a refusal
    # in between gives nothing back, having taken nothing.
    var buf = 0;
    var n = 0;
    # The deadline the config carries — accepted since forever, enforced since
    # 3.11.4.
    var tmo = 0;
    if (cfg != 0) { tmo = SandboxConfig_timeout_ms(cfg); }

    # The payload's process setup, for both captures below: its stdin (3.11.8),
    # its environment (3.12.0) and its working directory (3.12.2). Unset, the
    # environment is empty and the working directory is kavach's; the stdin is
    # empty unless the config opts in to kavach's own (`_config_payload_stdin`,
    # 3.13.2; through 3.13.1 an unset stdin inherited it).
    #
    # ⚠ **Through 3.13.0 neither capture received `stdin`**, so `config_stdin`
    # never reached a process payload: it read kavach's own stdin instead
    # (measured: `/bin/cat` under a config holding `CONFIG-STDIN` printed what
    # the host process had been handed, on both captures). And the unconfined
    # capture was the stdlib-shaped `confine_capture`, which takes no
    # environment and no working directory, so under a policy asking for no
    # confinement `config_env` and `config_workdir` were dropped too, though
    # 3.12.0 and 3.12.2 both said the process backend honours them.
    var pexec_in = _config_payload_stdin(cfg);
    var pexec_in_len = _config_payload_stdin_len(cfg);
    var pexec_env = 0;
    var pexec_wd = 0;
    if (cfg != 0) {
        pexec_env = SandboxConfig_env(cfg);
        pexec_wd = SandboxConfig_workdir(cfg);
    }
    # A sandbox naming a rootfs must run INSIDE it. The stdlib's exec_capture
    # forks and execs on the host with no child-side seam, so a rootfs-bearing
    # sandbox takes kavach's own confined capture instead. Before 3.9.1 there was
    # no rootfs field at all and every container ran host binaries.
    #
    # **And a policy asking for seccomp or landlock needs that same seam, rootfs
    # or not** (3.11.3). Until then this branch was gated on `rootfs != 0`
    # alone, so `seccomp_enabled = 1` was stored, scored by `score_backend`, and
    # never applied: a `policy_strict()` sandbox with no rootfs read arbitrary
    # host files and reported success. Measured by agnosai against 3.11.2 —
    # `/bin/cat` of a file outside any allowed path returned its 33 bytes.
    # `_spawn_enter_rootfs(0)` already returns 0, and `_spawn_ns_flags` already
    # takes `rootfs` into account, so the confined path needs no rootfs to work.
    #
    # **And so does `config_require_namespaces`** (3.14.7). With a policy asking
    # for neither seccomp nor landlock this branch was skipped, and the flag with
    # it: `policy_new()` with the flag set ran in kavach's network namespace
    # (measured: `readlink /proc/self/ns/net` read kavach's own), where the flag
    # promises namespaces or a refusal.
    var rootfs = 0;
    if (cfg != 0) { rootfs = SandboxConfig_rootfs(cfg); }
    var pol0 = 0;
    if (cfg != 0) { pol0 = SandboxConfig_policy(cfg); }
    var asks_ns = 0;
    if (cfg != 0) { asks_ns = SandboxConfig_require_ns(cfg); }
    if (rootfs != 0 || policy_wants_confinement(pol0) == 1 || asks_ns == 1) {
        var pol = pol0;
        var sec = 0;
        if (pol != 0) {
            if (SandboxPolicy_seccomp_enabled(pol) == 1) {
                var sres_t, sres_v = security_create_exec_seccomp_filter();
                # **Fail closed.** A policy that asked for seccomp and did not
                # get a filter must not fall through to an unconfined exec —
                # that is the shape of the bug this whole branch fixes.
                if (is_ok(sres_t) == 0) {
                    return backend_error_result("seccomp requested but the filter could not be built");
                }
                sec = result_unwrap(sres_t, sres_v);
            }
        }
        # Namespaces where they were already attempted (with a rootfs), or
        # where the caller explicitly asked for them (3.11.5). The rootfs-less
        # arm is the one 3.11.3 added, and it must not make unprivileged
        # namespace creation a precondition for seccomp by default — but a
        # caller who needs network isolation can now say so and get a
        # fail-closed refusal instead of silence.
        var want_ns = 0;
        if (rootfs != 0) { want_ns = 1; }
        if (cfg != 0) {
            if (SandboxConfig_require_ns(cfg) == 1) { want_ns = 1; }
        }
        # The workdir is applied inside the rootfs.
        buf = backend_capture_buf(PROCESS_MAX_OUTPUT);
        var capture = confine_capture_new(args, pol, rootfs, cgroup_path, sec, buf,
          PROCESS_MAX_OUTPUT, want_ns, tmo, 1, pexec_in, pexec_in_len, pexec_env, pexec_wd);
        ConfineCapture_set_caps(capture, confine_capabilities(cfg));
        n = confine_capture_run(capture);
        cgroup_teardown(cgroup_path);
        var end_rf = mono_now_ns();
        # Surface the payload's real exit code. Reporting 0 for a command that
        # never ran is how the missing-rootfs bug looked healthy for so long.
        # 3.11.5: the payload's own stderr, where this field was "". A copy since
        # 3.13.2. 3.14.8: all three read from this capture, and not from
        # `confine_last_*`, which another thread's capture rewrites.
        var rr = backend_capture_result(capture, "exec failed", start_ns, end_rf);
        backend_capture_release(buf, PROCESS_MAX_OUTPUT);
        return rr;
    }

    # **The unconfined path takes the same capture** (3.11.4), with
    # `do_confine = 0`. It used the stdlib's `exec_capture`, which discards the
    # child's wait status and has no seam for a deadline — so every command that
    # ran reported `exit_code = 0` (measured: `/bin/false`, real exit 1, and
    # `/bin/ls` on a missing path, real exit 2, both came back 0) and no
    # `timeout_ms` was ever enforced. One capture, so neither can drift again.
    buf = backend_capture_buf(PROCESS_MAX_OUTPUT);
    var plain = confine_capture_new(args, 0, 0, cgroup_path, 0, buf, PROCESS_MAX_OUTPUT, 0, tmo, 0,
      pexec_in, pexec_in_len, pexec_env, pexec_wd);
    n = confine_capture_run(plain);
    cgroup_teardown(cgroup_path);
    var end_ns = mono_now_ns();

    var pr = backend_capture_result(plain, "exec failed", start_ns, end_ns);
    backend_capture_release(buf, PROCESS_MAX_OUTPUT);
    return pr;
}

fn process_health(sandbox) { return 1; }
fn process_destroy(sandbox) { return 0; }

fn backend_process_register() {
    backend_register_exec(KavachBackend.PROCESS, &process_exec);
    backend_register_health(KavachBackend.PROCESS, &process_health);
    backend_register_destroy(KavachBackend.PROCESS, &process_destroy);
    return 0;
}

# --- persistent.cyr ---

# kavach — persistent guest execution (live stdin / stdout)
#
# The one-shot PROCESS backend (backend_process.cyr) runs a guest to completion
# and captures its stdout. This module adds a PERSISTENT guest: fork+exec the
# command with a live stdin pipe (the parent writes) and a stdout pipe (the
# parent reads), so a host can STREAM input to a running guest and read its
# output over time. This is the execution primitive the swallow stage's M3
# protocol shim delivers events over (mehman → aethersafha).
#
# SECURITY: the same pre-exec command safety the one-shot path enforces applies
# here — `is_safe_argument` (reject control chars) + `check_command` (runtime
# guard) before the fork. What does NOT apply is the externalization gate: it
# scans a full captured output buffer, which is meaningless for an open-ended
# stream, so a persistent guest's stdout is NOT gate-scanned. Persistent
# execution is for trusted-shape guests behind the swallow capability contract;
# raw streaming is the deliberate trade for interactivity.
#
# LIMITATIONS: (1) writing to a guest that already exited on its own raises
# SIGPIPE (no SIG_IGN wrapper in the stdlib yet). `persistent_send` guards on the
# `alive` flag, so write-after-terminate is safe; stop sending once the guest is
# known dead. (2) `persistent_read` is blocking (a non-blocking variant via
# O_NONBLOCK/pipe2 is the follow-on for a compositor frame loop).

# Fields (all i64):
#   pid        — the child pid
#   stdin_fd   — parent's write end of the guest's stdin
#   stdout_fd  — parent's read end of the guest's stdout
#   alive      — 1 = running, 0 = terminated + reaped
#derive(accessors)
struct PersistentGuest {
    pid;
    stdin_fd;
    stdout_fd;
    alive;
}
var PERSISTENT_GUEST_SIZE = 32;

# Spawn `command` as a persistent guest with live stdin/stdout pipes. Runs the
# pre-exec safety checks, then fork + dup2 + execve (mirrors backend_process's
# argv build + the exec_capture pipe pattern, with a second pipe for stdin).
# -> PersistentGuest* (0 on an unsafe/blocked command, empty split, or fork/OOM).
# Spawn a persistent guest **inside a policy's confinement**.
#
# `persistent_spawn` — which this wraps — applies nothing: it is not associated
# with a `Sandbox`, takes no policy, and `kv_execve`s the payload with the
# caller's full ambient authority. That was invisible at the call site, and it
# is the only kavach API offering a stdin channel, so it is what a consumer
# needing one reaches for. agnosai measured the consequence against 3.11.2: a
# `cxvm` guest spawned this way opened `/etc/passwd`.
#
# **`persistent_spawn` keeps its signature and its behaviour** — callers who
# genuinely want an unconfined child still have it, now by naming it rather
# than by default. Its doc says so.
#
# Returns 0 if the command is refused, the fork fails, the policy asks for
# confinement that could not be applied, or it requires attestation (a local
# process has no quote).
fn persistent_spawn_confined(command, policy) {
    return persistent_spawn_confined_ns(command, policy, 0);
}

# Spawn a persistent guest with the policy's confinement **and its namespaces**.
#
# `require_ns` is the same opt-in, fail-closed shape `config_require_namespaces`
# gave `process_exec` in 3.11.5 — expressed as a parameter here because the
# persistent path takes no `SandboxConfig` to carry a flag on.
#
# **Why it is opt-in.** A network namespace needs a new *user* namespace when
# unprivileged, and Ubuntu 24.04 restricts those outright; making it
# unconditional would turn guests that ran into guests that do not run at all.
# **Why it fails closed.** A caller asking for network isolation and silently
# not getting it is the failure mode this whole line of releases exists to
# remove — the guest exits `SPAWN_EXIT_NS` (123) or `SPAWN_EXIT_IDMAP` (118)
# rather than running with a network its policy said it would not have.
#
# The namespaces come from the policy, so `network_enabled = 0` — the default —
# is what asks for network isolation. Until 3.11.6 that field reached this path
# and nothing acted on it.
fn persistent_spawn_confined_ns(command, policy, require_ns) {
    if (policy == 0) { return persistent_spawn(command); }
    # 3.13.0: a persistent guest is a local process, with no quote to verify.
    if (policy_wants_attestation(policy) == 1) { return 0; }
    if (policy_wants_confinement(policy) == 0 && require_ns == 0) {
        return persistent_spawn(command);
    }

    var sec = 0;
    if (SandboxPolicy_seccomp_enabled(policy) == 1) {
        var sres_t, sres_v = security_create_exec_seccomp_filter();
        # Fail closed: a policy that asked for seccomp and did not get a filter
        # must not fall through to an unconfined spawn.
        if (is_ok(sres_t) == 0) { return 0; }
        sec = result_unwrap(sres_t, sres_v);
    }
    # Read in the PARENT: inside a new user namespace `getuid` reports the
    # mapped id, not the one the map must be written against.
    return _persistent_spawn_inner(command, policy, sec, require_ns, sys_getuid(), kv_getgid());
}

# Spawn a persistent guest with **no confinement**.
#
# Applies no seccomp, no landlock and no namespaces, whatever policy the caller
# may hold elsewhere — it takes none. For a payload that is not trusted, use
# `persistent_spawn_confined`.
fn persistent_spawn(command) {
    return _persistent_spawn_inner(command, 0, 0, 0, 0, 0);
}

fn _persistent_spawn_inner(command, policy, seccomp_info, want_ns, uid, gid) {
    # ⛔ LINUX ONLY — forks a child and installs `prctl`/namespaces/landlock/
    # seccomp on it. agnos has no fork by design and its sandboxing goes through
    # backend_sy_agnos.
    # ⚠ 0, the same "could not spawn" the guards below return: a caller must not
    # receive a guest handle for a child that does not exist.
    #
    # The body is **excluded** from the agnos build rather than merely
    # unreachable on it. `SYS_PRCTL` is not in the agnos syscall enum, and an
    # undefined symbol is a hard error whether or not the line can execute —
    # which, because `cyrius build` auto-prepends every `[deps.*]` module, fails
    # any `--agnos` consumer that declares `[deps.kavach]` at all. The namespace
    # work in 3.11.6 is what introduced the reference.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (is_safe_argument(command) == 0) { return 0; }
    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) { return 0; }
    var args = _split_command(command);
    var argc = vec_len(args);
    if (argc == 0) { return 0; }

    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) { store64(argv + i * 8, vec_get(args, i)); i = i + 1; }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);

    # stdin pipe: parent writes in_wfd -> child reads in_rfd (its fd 0)
    var inpipe[16];
    sys_pipe(&inpipe);
    var in_rfd = load32(&inpipe);
    var in_wfd = load32(&inpipe + 4);
    # stdout pipe: child writes out_wfd (its fd 1) -> parent reads out_rfd
    var outpipe[16];
    sys_pipe(&outpipe);
    var out_rfd = load32(&outpipe);
    var out_wfd = load32(&outpipe + 4);

    # Pinned before fork (ADR-005 §H4). No rootfs on this path.
    var pin = kv_exec_pin(vec_get(args, 0));
    var pid = kv_fork();
    if (pid < 0) {
        sys_close(in_rfd); sys_close(in_wfd);
        sys_close(out_rfd); sys_close(out_wfd);
        if (pin >= 0) { sys_close(pin); }
        return 0;
    }
    if (pid == 0) {
        _spawn_default_sigpipe();
        # child: wire the pipe ends to stdin/stdout, /dev/null to stderr
        sys_close(in_wfd);
        sys_close(out_rfd);
        kv_dup2(in_rfd, 0);
        sys_close(in_rfd);
        kv_dup2(out_wfd, 1);
        sys_close(out_wfd);
        var devnull = file_open("/dev/null", O_WRONLY, 0);
        if (devnull >= 0) { kv_dup2(devnull, 2); sys_close(devnull); }
        # ⛔ Close everything else the guest would inherit (3.12.9), as
        # `confine_child` does for the other paths. This path never did: a
        # confined persistent guest found the credential proxy's listener at fd 3
        # and could accept on it. Only the pinned exec fd survives, and it is
        # close-on-exec.
        _kv_exec_keep_fd = pin;
        _spawn_close_inherited(3);
        # The seam. Namespaces, then landlock, then seccomp — installed HERE,
        # after the pipes are wired and before `execve`. The pipes come first
        # because none of these three affect descriptors that were already open,
        # which is what lets a confined guest still read its stdin; and all three
        # come before `execve` because a filter installed after it is too late by
        # definition.
        var nsf = 0;
        if (want_ns != 0 && policy != 0) {
            if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }
            nsf = _spawn_ns_flags(policy, 0);
            if (nsf != 0) {
                if (is_ok(security_create_namespace(nsf)) == 0) { sys_exit(SPAWN_EXIT_NS); }
                if ((nsf & NS_USER) != 0) {
                    # Its own code: creating the namespace and mapping ids into
                    # it are different privileges that fail on different hosts.
                    if (_spawn_write_idmaps(uid, gid) != 0) { sys_exit(SPAWN_EXIT_IDMAP); }
                }
            }
        }
        # 3.14.8: a confined guest is a confined process-path payload, so it gets
        # a landlock domain of its own and holds the default set, as `confine_child`
        # gives them. NO_NEW_PRIVS first, which the bound relies on when it cannot
        # drop the bounding set. An unconfined guest (`persistent_spawn`, policy 0)
        # gets none of it, as before.
        var net_alone = _spawn_net_alone(policy, nsf);
        if (policy != 0) {
            if (_spawn_apply_landlock(policy, net_alone) != 0) { sys_exit(SPAWN_EXIT_LANDLOCK); }
            if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }
            if (_spawn_bound_capabilities(KAVACH_CAPS_DEFAULT) != 0) { sys_exit(SPAWN_EXIT_CAPS); }
        }
        if (seccomp_info != 0) {
            if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }
            if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(seccomp_info),
                  security_seccomp_filter_len(seccomp_info))) == 0) {
                sys_exit(SPAWN_EXIT_SECCOMP);
            }
        }
        if (net_alone == 1) {
            if (_spawn_load_net_filter() != 0) { sys_exit(SPAWN_EXIT_SECCOMP); }
        }
        kv_exec_child(pin, vec_get(args, 0), argv, envp);
        sys_exit(127);
    }
    if (pin >= 0) { sys_close(pin); }
    # parent: keep the write-stdin + read-stdout ends
    sys_close(in_rfd);
    sys_close(out_wfd);
    var g = alloc(PERSISTENT_GUEST_SIZE);
    if (g == 0) { sys_close(in_wfd); sys_close(out_rfd); return 0; }
    PersistentGuest_set_pid(g, pid);
    PersistentGuest_set_stdin_fd(g, in_wfd);
    PersistentGuest_set_stdout_fd(g, out_rfd);
    PersistentGuest_set_alive(g, 1);
    return g;
    #endif
}

# Write `len` bytes to the guest's stdin. -> bytes written, or -1 if the guest is
# null / already terminated.
fn persistent_send(g, bytes, len): i64 {
    if (g == 0) { return 0 - 1; }
    if (PersistentGuest_alive(g) == 0) { return 0 - 1; }
    return sys_write(PersistentGuest_stdin_fd(g), bytes, len);
}

# Read up to `len` bytes of the guest's stdout into `buf` (blocking). -> bytes
# read (0 at EOF), or -1 for a null / terminated guest.
fn persistent_read(g, buf, len): i64 {
    if (g == 0) { return 0 - 1; }
    if (PersistentGuest_alive(g) == 0) { return 0 - 1; }
    return sys_read(PersistentGuest_stdout_fd(g), buf, len);
}

fn persistent_pid(g): i64   { if (g == 0) { return 0 - 1; } return PersistentGuest_pid(g); }
fn persistent_alive(g): i64 { if (g == 0) { return 0; } return PersistentGuest_alive(g); }

# Terminate + reap the guest: close its stdin (EOF), SIGKILL, waitpid (no zombie),
# close its stdout. Idempotent. -> 0 (or -1 for a null guest).
fn persistent_terminate(g): i64 {
    if (g == 0) { return 0 - 1; }
    if (PersistentGuest_alive(g) == 1) {
        sys_close(PersistentGuest_stdin_fd(g));
        sys_kill(PersistentGuest_pid(g), 9);   # 9 = SIGKILL (guaranteed reap)
        var stbuf[1];
        kv_waitpid(PersistentGuest_pid(g), &stbuf, 0);
        sys_close(PersistentGuest_stdout_fd(g));
        PersistentGuest_set_alive(g, 0);
    }
    return 0;
}

# --- spawn.cyr ---

# spawn.cyr — policy-threaded DETACHED spawn (3.9.0).
#
# `sandbox_exec` runs a command to completion and captures its output;
# `persistent_spawn` keeps a guest alive on pipes but takes no Sandbox, so it
# threads NO policy — no cgroup, no namespaces, no landlock, no seccomp. Neither
# shape serves a daemon container: the caller needs the process to outlive the
# call, under the sandbox's policy, with its output going somewhere durable.
#
# That is what this module adds. The consumer is stiva's `run -d`, which has been
# blocked on this symbol existing (its roadmap tracks the gate by symbol rather
# than by kavach version, precisely because two releases went by with the
# version moving and the symbol absent).
#
# ── The policy contract ──────────────────────────
# A detached spawn that quietly drops half the policy is worse than no detached
# spawn, because the caller cannot tell. So every isolation primitive the policy
# asks for is either APPLIED or the spawn REFUSES. There is no "best effort"
# path here. In particular a hardening step that fails in the child `_exit`s
# rather than falling through to execve unconfined.
#
# ── Ordering in the child, and why ────────────────────────
#   1. setsid          — leave the parent's session/controlling terminal, or a
#                        Ctrl-C in the launching shell kills the "detached" job.
#   2. stdio redirect  — stdin from /dev/null, stdout+stderr appended to the log.
#   3. fd cleanup      — close(3..) so no inherited descriptor reaches the
#                        payload (the CVE-2024-21626 class: a leaked host
#                        directory fd is a filesystem escape).
#   4. cgroup join     — write our own pid to cgroup.procs. Direct, unlike the
#                        `sh -c` prelude cgroup_wrap_argv needs for the exec
#                        path, because here we ARE the child.
#   5. NO_NEW_PRIVS    — must precede seccomp; the kernel rejects a filter from
#                        an unprivileged process without it.
#   6. namespaces      — unshare before the payload exists.
#   7. rootfs entry    — pivot_root into the container filesystem, before landlock
#                        (path rules resolve against the current root) and
#                        before seccomp (which denies mount and pivot_root).
#   8. landlock        — a domain of the payload's own, with its path rules,
#                        scopes and TCP rules (3.14.8); also sets NO_NEW_PRIVS.
#   9. capabilities    — the bound set: with a rootfs since 3.14.6, without one
#                        since 3.14.8.
#  10. seccomp         — applied LAST, or it would filter the confinement steps
#                        above it. Uses the exec-safe DENY-list profile; the
#                        20-syscall allowlist cannot be used pre-exec because it
#                        does not permit execve. See
#                        security_create_exec_seccomp_filter.
#  11. execve.

# A detached child under sandbox policy.
#   pid         — child pid
#   alive       — 1 running, 0 reaped (exit_code then valid)
#   exit_code   — -1 until reaped
#   cgroup_path — cstr | 0; rmdir'd when the child is reaped
#   log_path    — cstr | 0; where stdout+stderr went
#   kill_fn     — fn(sp, signal) -> 0 / -1, a backend's own signal, or 0 (3.14.8)
#   reap_fn     — fn(sp), a backend's own teardown once the child is reaped, or 0
#   ctx         — what those two read
#derive(accessors)
struct SpawnedProcess {
    pid;
    alive;
    exit_code;
    cgroup_path;
    log_path;
    kill_fn;
    reap_fn;
    ctx;
}
var SPAWNED_PROCESS_SIZE = 64;

# A handle for a detached child `pid`: alive, its exit code -1 until reaped, and
# no backend teardown. A backend's spawn sets `kill_fn`, `reap_fn` and `ctx`.
fn spawned_process_new(pid, cgroup_path, log_path) {
    var sp = alloc(SPAWNED_PROCESS_SIZE);
    memset(sp, 0, SPAWNED_PROCESS_SIZE);
    SpawnedProcess_set_pid(sp, pid);
    SpawnedProcess_set_alive(sp, 1);
    SpawnedProcess_set_exit_code(sp, 0 - 1);
    SpawnedProcess_set_cgroup_path(sp, cgroup_path);
    SpawnedProcess_set_log_path(sp, log_path);
    return sp;
}

# sandbox_spawn for a caller that holds real argv: `argv` is a vec of cstr, and
# each element reaches the payload as one argument. See sandbox_exec_argv, whose
# checks this shares. Returns SpawnedProcess*, or 0.
fn sandbox_spawn_argv(sandbox, argv, log_path) {
    var command = _kv_argv_command(argv);
    if (command == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "argv needs a program with no space or tab in it");
        return 0;
    }
    Sandbox_set_argv(sandbox, argv);
    var spawned = sandbox_spawn(sandbox, command, log_path);
    Sandbox_set_argv(sandbox, 0);
    return spawned;
}

# Spawn `command` detached under `sandbox`'s policy, with stdout+stderr appended
# to `log_path` (0 → /dev/null). Returns SpawnedProcess*, or 0.
#
# Refuses when: the sandbox is not RUNNING, the policy requires attestation,
# the command carries control characters or trips the runtime guard, the policy
# asks for an isolation primitive that cannot be applied (see
# _spawn_seccomp_supported), a rootfs'd config names a capability kavach does not
# know, or the fork fails. A refusal prints through kavach_err_print and leaves
# nothing running.
#
# 3.14.8: a backend with a spawn of its own takes it from here, after the checks
# above it, which every detached payload passes (`backend_spawn_fn`). The OCI
# backend registers one: `runc run` in the foreground, so the payload gets runc's
# PID namespace, `/proc`, masks, device rules and filter, and the handle's pid is
# runc's, which forwards a signal and exits with the payload's status. Through
# 3.14.7 an OCI sandbox detached here on the process path, with no PID namespace
# and no `/proc` of its own, which 3.14.7 scored as that (`score_spawn`) and the
# issue's Ask 4 asked be detached through runc instead. Every other backend, and
# an OCI sandbox from `dist/kavach-confine.cyr`, which carries no OCI backend,
# still detaches on the process path. See
# docs/development/issues/archived/2026-11-06-process-backend-keeps-every-capability.md.
fn sandbox_spawn(sandbox, command, log_path) {
    if (Sandbox_state(sandbox) != SandboxState.RUNNING) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "sandbox not running");
        return 0;
    }
    # 3.13.0: a spawned payload is a local process, with no quote to verify.
    if (policy_wants_attestation(SandboxConfig_policy(Sandbox_config(sandbox))) == 1) {
        kavach_err_print(KAVACH_ERR_POLICY_VIOLATION, "attestation required; a spawned process cannot attest");
        return 0;
    }
    # Same two pre-checks the exec path runs, for the same reason: a control
    # character would split into extra argv tokens, and a guard-violating
    # command must never reach fork.
    if (is_safe_argument(command) == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "command contains illegal control chars");
        return 0;
    }
    # 3.12.1: a rootfs'd sandbox is a container — its command resolves inside
    # the image, so the host-interpreter blocklist does not apply. See
    # `runtime_guard_config_for_rootfs`.
    var guard_cfg = runtime_guard_config_for_rootfs(
      SandboxConfig_rootfs(Sandbox_config(sandbox)));
    if (vec_len(check_command(command, guard_cfg)) > 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "command blocked by runtime guard");
        return 0;
    }
    var args = _sandbox_command_argv(sandbox, command);
    var argc = vec_len(args);
    if (argc == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "empty command");
        return 0;
    }
    var own = backend_spawn_fn(SandboxConfig_backend(Sandbox_config(sandbox)));
    if (own != 0) { return fncall3(own, sandbox, command, log_path); }
    var caps_refused = confine_capabilities_refusal(Sandbox_config(sandbox));
    if (caps_refused != 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, caps_refused);
        return 0;
    }

    var policy = 0;
    var rootfs = 0;
    var cfg = Sandbox_config(sandbox);
    if (cfg != 0) {
        policy = SandboxConfig_policy(cfg);
        rootfs = SandboxConfig_rootfs(cfg);
    }
    # Read the ids in the PARENT: inside the new user namespace getuid() would
    # report the mapped id, not the one the map has to be written against.
    var spawn_uid = sys_getuid();
    var spawn_gid = kv_getgid();

    # Build the seccomp filter in the PARENT: alloc in the child after fork is
    # fine here, but a filter that fails to build should refuse the spawn rather
    # than _exit a child the caller already has a handle to.
    var seccomp_info = 0;
    if (policy != 0) {
        if (SandboxPolicy_seccomp_enabled(policy) == 1) {
            var sres_t, sres_v = security_create_exec_seccomp_filter();
            if (is_ok(sres_t) == 0) {
                kavach_err_print(KAVACH_ERR_EXEC_FAILED, "cannot build seccomp filter");
                return 0;
            }
            seccomp_info = result_unwrap(sres_t, sres_v);
        }
    }

    # Cgroup is created by the PARENT (the child may lack permission to mkdir
    # under the cgroup root) and joined by the child.
    var cgroup_path = 0;
    if (policy != 0) {
        if (cgroup_policy_has_limits(policy) == 1) {
            cgroup_path = cgroup_setup(policy);
        }
    }

    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    # The config's explicit env, or the empty envp when unset (the pre-3.12.0
    # behaviour for every caller that does not call `config_env`). Built in the
    # PARENT for the same reason the seccomp filter is: alloc after fork is
    # unsafe.
    var spawn_env = 0;
    if (cfg != 0) { spawn_env = SandboxConfig_env(cfg); }
    var spawn_wd = 0;
    if (cfg != 0) { spawn_wd = SandboxConfig_workdir(cfg); }
    var envp = kv_envp_from_vec(spawn_env);
    var spawn_caps = confine_capabilities(cfg);

    # Pinned before fork (ADR-005 §H4); not with a rootfs, where the command
    # must resolve inside it.
    var pin = KV_EXEC_BY_PATH;
    if (rootfs == 0) { pin = kv_exec_pin(vec_get(args, 0)); }
    var pid = kv_fork();
    if (pid < 0) {
        if (pin >= 0) { sys_close(pin); }
        cgroup_teardown(cgroup_path);
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "fork failed");
        return 0;
    }
    if (pid == 0) {
        # ── child ──
        # Every failure below _exits. Falling through to execve after a failed
        # hardening step would run the payload with less isolation than the
        # policy promised, which is the one outcome this module must not have.
        # Each confinement step has its OWN exit code, so a caller that sees a
        # dead container can tell WHICH isolation primitive was unavailable
        # rather than staring at one opaque number. 12x is chosen to sit below
        # 126/127, which the shell already reserves for "not executable" and
        # "not found".
        _spawn_default_sigpipe();
        _kv_exec_keep_fd = pin;
        kv_setsid();
        if (_spawn_redirect_stdio(log_path) != 0) { sys_exit(SPAWN_EXIT_STDIO); }
        # 1: sandbox_spawn's namespace contract is unchanged by 3.11.3 — it
        # fails closed when the host denies them, and a test asserts exactly
        # that.
        # 3.12.2: the config's workdir, applied inside the rootfs. Read in the
        # parent (cfg is not touched after fork).
        confine_child_caps(policy, rootfs, cgroup_path, spawn_uid, spawn_gid, seccomp_info, 1,
          spawn_wd, spawn_caps);
        kv_exec_child(pin, vec_get(args, 0), argv, envp);
        sys_exit(127);
    }

    # ── parent ──
    if (pin >= 0) { sys_close(pin); }
    return spawned_process_new(pid, cgroup_path, log_path);
}

# Child pid, or -1.
#[must_use]
fn spawned_pid(sp) {
    if (sp == 0) { return 0 - 1; }
    return SpawnedProcess_pid(sp);
}

# 1 while the child has not been reaped.
#[must_use]
fn spawned_alive(sp) {
    if (sp == 0) { return 0; }
    return SpawnedProcess_alive(sp);
}

# Exit code, or -1 until the child has been reaped.
#[must_use]
fn spawned_exit_code(sp) {
    if (sp == 0) { return 0 - 1; }
    return SpawnedProcess_exit_code(sp);
}

# Record a reaped status: decode the wait status, mark dead, drop the cgroup.
fn _spawned_reap(sp, status) {
    var code = 0;
    # WIFEXITED: low 7 bits are the signal; 0 means a normal exit and the code
    # is in bits 8-15. A signalled child reports 128+signal, the shell
    # convention, so a caller can tell "exited 9" from "killed by SIGKILL".
    var sig = status & 127;
    if (sig == 0) { code = (status >> 8) & 255; }
    else { code = 128 + sig; }
    SpawnedProcess_set_exit_code(sp, code);
    SpawnedProcess_set_alive(sp, 0);
    cgroup_teardown(SpawnedProcess_cgroup_path(sp));
    SpawnedProcess_set_cgroup_path(sp, 0);
    # 3.14.8: a backend's own teardown, once: the OCI spawn deletes the container
    # and its bundle.
    var reap = SpawnedProcess_reap_fn(sp);
    if (reap != 0) {
        SpawnedProcess_set_reap_fn(sp, 0);
        fncall1(reap, sp);
    }
    return code;
}

# Non-blocking reap. 1 = exited (exit_code now valid), 0 = still running,
# -1 = error / already reaped.
fn spawned_try_wait(sp) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return 1; }
    var stbuf[4];
    store32(&stbuf, 0);
    # WNOHANG = 1.
    var r = kv_waitpid(SpawnedProcess_pid(sp), &stbuf, 1);
    if (r < 0) { return 0 - 1; }
    if (r == 0) { return 0; }
    _spawned_reap(sp, load32(&stbuf));
    return 1;
}

# Block until the child exits; returns its exit code, or -1 on error.
fn spawned_wait(sp) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return SpawnedProcess_exit_code(sp); }
    var stbuf[4];
    store32(&stbuf, 0);
    var r = kv_waitpid(SpawnedProcess_pid(sp), &stbuf, 0);
    if (r < 0) { return 0 - 1; }
    return _spawned_reap(sp, load32(&stbuf));
}

# Signal the child. Returns 0 on success, -1 on error or when already reaped.
# Does NOT reap — call spawned_wait / spawned_try_wait after, or the child
# becomes a zombie and its cgroup is never torn down.
fn spawned_kill(sp, signal) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return 0 - 1; }
    # 3.14.8: a backend's own signal. runc forwards what it is sent, but cannot be
    # asked to forward a SIGKILL, which the OCI spawn sends through `runc kill`.
    var kf = SpawnedProcess_kill_fn(sp);
    if (kf != 0) { return fncall2(kf, sp, signal); }
    if (sys_kill(SpawnedProcess_pid(sp), signal) < 0) { return 0 - 1; }
    return 0;
}

# SIGTERM, wait up to `grace_ms` for the child to go, then SIGKILL and reap.
# Returns the exit code, or -1. This is the shape a container runtime's `stop`
# wants, and getting the escalation wrong (no grace, or no final SIGKILL) is a
# common way to either lose data or leak processes.
fn spawned_terminate(sp, grace_ms) {
    if (sp == 0) { return 0 - 1; }
    if (SpawnedProcess_alive(sp) == 0) { return SpawnedProcess_exit_code(sp); }
    spawned_kill(sp, 15);                               # SIGTERM
    var waited = 0;
    while (waited < grace_ms) {
        if (spawned_try_wait(sp) == 1) { return SpawnedProcess_exit_code(sp); }
        sleep_ms(20);
        waited = waited + 20;
    }
    spawned_kill(sp, 9);                                # SIGKILL
    return spawned_wait(sp);
}

# --- backend_gvisor.cyr ---

# kavach — gVisor (runsc) backend
# Ported from rust-old/src/backend/gvisor/mod.rs
#
# OCI spec generation is shared with the OCI backend via src/oci_spec.cyr.
# This module handles only the runsc-specific orchestration: locate the
# binary, run with --network <mode>, clean up the container on exit.

fn _gvisor_runsc_path() {
    if (kavach_path_exists("/usr/local/bin/runsc") == 1) { return "/usr/local/bin/runsc"; }
    if (kavach_path_exists("/usr/bin/runsc") == 1) { return "/usr/bin/runsc"; }
    return 0;
}

# `runsc run` in the foreground, through `backend_run_capture` (3.13.2): the
# container's stdout into `out_buf`, runsc's exit status (the container's, when
# it ran), its stderr, the config's deadline and the config's stdin, which runsc
# hands the container (the bundle sets no terminal). A deadline kills runsc;
# `_gvisor_delete` then stops the container.
#
# 3.14.2: with `--log <path>`, the global flag runc has too, so runsc's own
# failures are told apart from the payload's. runsc reports every failure of
# its own through `util.Errorf` / `util.Fatalf` (runsc/cmd/util/util.go): the
# message goes to stderr, and as a JSON line (`{"msg":…,"level":"error"}`) to the
# `--log` file, and Fatalf exits 128. Its internal logs go nowhere unless
# `--debug-log` or `--alsologtostderr` asks (runsc/cli/cli.go). So the log file
# is written only when runsc itself failed. Read from runsc's source: this
# machine has no runsc to run it on, and the tests drive a stand-in that does
# what the source does.
# Returns the run's capture (3.14.8), or 0 when there is no log path to give runsc.
fn _gvisor_run(runsc, bundle, container_id, network, cfg, out_buf, out_cap) {
    var log_path = _oci_log_path(container_id);
    if (log_path == 0) { return 0; }
    var args = vec_new();
    vec_push(args, runsc);
    vec_push(args, "--log");
    vec_push(args, log_path);
    vec_push(args, "--network");
    vec_push(args, network);
    vec_push(args, "run");
    vec_push(args, "--bundle");
    vec_push(args, bundle);
    vec_push(args, container_id);
    # A leftover log would read as this run's failure (see _oci_run).
    kv_unlink(log_path);
    return backend_run_start(args, cfg, out_buf, out_cap);
}

# The message in runsc's log: the first `"msg"` of its JSON error lines, or the
# log as it is when there is none.
fn _gvisor_log_msg(log) {
    var at = strstr(log, "\"msg\":\"");
    if (at < 0) { return log; }
    var p = log + at + 7;
    var n = strlen(p);
    var out = alloc(n + 1);
    var i = 0;
    var o = 0;
    while (i < n) {
        var c = load8(p + i) & 255;
        if (c == 34) { break; }
        if (c == 92 && i + 1 < n) {
            i = i + 1;
            c = load8(p + i) & 255;
            if (c == 110) { c = 10; }
            if (c == 116) { c = 9; }
        }
        store8(out + o, c);
        o = o + 1;
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

fn _gvisor_delete(runsc, container_id) {
    var args = vec_new();
    vec_push(args, runsc);
    vec_push(args, "delete");
    vec_push(args, "--force");
    vec_push(args, container_id);
    var sink[32];
    kv_exec_capture(args, &sink, 32);
    return 0;
}

fn gvisor_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    var runsc = _gvisor_runsc_path();
    if (runsc == 0) {
        return backend_error_result("runsc not found in PATH");
    }

    # 3.12.1: a rootfs'd sandbox is a container — its command resolves inside
    # the image, so the host-interpreter blocklist does not apply. See
    # `runtime_guard_config_for_rootfs`.
    var guard_cfg = runtime_guard_config_for_rootfs(
      SandboxConfig_rootfs(Sandbox_config(sandbox)));
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }
    return _gvisor_exec_with(runsc, sandbox, command, start_ns);
}

# The run itself, under the runsc at `runsc`: bundle, run, delete, cleanup.
fn _gvisor_exec_with(runsc, sandbox, command, start_ns) {
    var refused = oci_capabilities_refusal(Sandbox_config(sandbox));
    if (refused != 0) { return backend_error_result(refused); }
    var container_id = oci_container_id("kavach-gvisor");
    var bundle = oci_prepare_bundle(container_id, sandbox, command);
    if (bundle == 0) {
        return backend_error_result("failed to prepare OCI bundle");
    }

    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);
    var network = oci_network_mode(policy);

    if (_oci_state_root() == 0) {
        oci_cleanup_bundle(bundle);
        return backend_error_result(
          "OCI state directory under /tmp is not a private directory owned by this user; refusing to run");
    }
    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);
    var gc = _gvisor_run(runsc, bundle, container_id, network, cfg, out_buf, out_cap);
    var end_ns = mono_now_ns();
    var runsc_log = _oci_take_log(container_id);
    # ⚠ Through 3.13.1 this was `backend_capture_finish` over `kv_exec_capture`:
    # exit 0 for any container that ran (measured with a stand-in runsc exiting
    # 7), its stderr sent to /dev/null, no deadline and kavach's own stdin.
    # 3.14.8: runsc's outcome is this capture's, not `confine_last_*`.
    var r = 0;
    if (gc == 0) { r = backend_capture_finish(out_buf, 0 - 1, out_cap, "runsc run failed", start_ns, end_ns); }
    else { r = backend_capture_result(gc, "runsc run failed", start_ns, end_ns); }
    backend_capture_release(out_buf, out_cap);

    _gvisor_delete(runsc, container_id);
    oci_cleanup_bundle(bundle);
    # runsc failed, not the payload: a diagnostic, kept out of the
    # externalization gate. Through 3.14.1 runsc's message reached the gate as
    # the payload's stderr, where `code_scan` can read a runtime error as a HIGH
    # finding and the exec failed as "externalization blocked" (see
    # _oci_log_path).
    if (strlen(runsc_log) > 0) {
        return backend_error_result(_oci_diag("gVisor runtime run failed: ", _gvisor_log_msg(runsc_log)));
    }
    return r;
}

fn gvisor_health(sandbox) {
    if (_gvisor_runsc_path() == 0) { return 0; }
    return 1;
}

fn gvisor_destroy(sandbox) { return 0; }

fn backend_gvisor_register() {
    backend_register_exec(KavachBackend.GVISOR, &gvisor_exec);
    backend_register_health(KavachBackend.GVISOR, &gvisor_health);
    backend_register_destroy(KavachBackend.GVISOR, &gvisor_destroy);
    return 0;
}

# --- backend_oci.cyr ---

# kavach — OCI (runc/crun) backend
# Ported from rust-old/src/backend/oci/mod.rs
#
# Shell-out to a standard OCI runtime: `runc run` (or `crun run`) against an
# OCI bundle generated by src/oci_spec.cyr. Picks the first available runtime
# in PATH; falls back across /usr/local/bin, /usr/bin, /bin.
#
# Forward direction: stiva will eventually provide a first-party container
# runtime. When its Cyrius port lands, `_oci_runtime_path()` can prepend
# the stiva binary; the rest of this backend is already bundle-driven via
# src/oci_spec.cyr and requires no API change.

# Discover a usable OCI runtime. Returns path cstr, or 0 if none.
fn _oci_runtime_path() {
    if (kavach_path_exists("/usr/local/bin/runc") == 1) { return "/usr/local/bin/runc"; }
    if (kavach_path_exists("/usr/bin/runc") == 1) { return "/usr/bin/runc"; }
    if (kavach_path_exists("/usr/local/bin/crun") == 1) { return "/usr/local/bin/crun"; }
    if (kavach_path_exists("/usr/bin/crun") == 1) { return "/usr/bin/crun"; }
    return 0;
}

# runc's state directory.
#
# The child is exec'd with an EMPTY environment (deliberate — kavach does not
# leak the caller's env into a sandbox), and an unprivileged runc with no
# XDG_RUNTIME_DIR defaults its state root to /run/runc, where it fails with
# "mkdir /run/runc: permission denied". That error went to stderr, which the
# capture sends to /dev/null, so the whole container silently produced nothing
# and reported success. Passing --root explicitly removes the dependency on
# environment entirely rather than re-introducing env inheritance.
#[must_use]
fn _oci_state_root() {
    var prefix = "/tmp/kavach-runc-";
    var b[32];
    var n = fmt_int_buf(sys_getuid(), &b);
    var plen = strlen(prefix);
    var p = alloc(plen + n + 1);
    memcpy(p, prefix, plen);
    memcpy(p + plen, &b, n);
    store8(p + plen + n, 0);
    kv_mkdir(p, 448);                      # 0700
    # VALIDATE, do not assume. The name is fully predictable — "kavach-runc-"
    # plus the victim's uid — and it lives in a world-writable directory, so on
    # a shared host another user can create it (or symlink it) FIRST and then
    # own runc's entire state directory plus its log file. `sys_mkdir`
    # returning EEXIST tells us nothing about what is there.
    #
    # Three properties, all required: it must be a real DIRECTORY (not a
    # symlink — `lstat`, so a link reports S_IFLNK rather than its target), it
    # must be owned by US, and it must not be group- or world-accessible. Any
    # failure returns 0 and every caller treats that as "no usable state root"
    # rather than proceeding into an attacker's directory.
    if (_oci_dir_is_ours(p) == 0) { return 0; }
    return p;
}

# 1 when `path` is a directory we own with no group/other bits set.
#[must_use]
fn _oci_dir_is_ours(path) {
    # agnos: kv_lstat refuses there, and agnos's stat has no owner field
    # (STAT_UID is not defined), so the check is Linux-only.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sb[144];                                        # >= struct stat on x86-64 (144) and aarch64 (128)
    if (kv_lstat(path, &sb) != 0) { return 0; }
    # st_mode and st_uid are 32-bit fields at per-arch offsets. Until 3.12.8
    # this read x86-64's (+24 and +28) on every arch. aarch64 has st_uid at +24
    # and st_gid at +28, so there it compared the owner's low bits as the mode
    # and the group as the owner.
    var mode = load32(&sb + STAT_MODE);
    if ((mode & 61440) != 16384) { return 0; }          # S_IFDIR, and NOT S_IFLNK
    if ((mode & 63) != 0) { return 0; }                 # any group/other bit -> refuse
    var uid = load32(&sb + STAT_UID);
    if (uid != sys_getuid()) { return 0; }
    return 1;
    #endif
}

# ── host capture with a real exit status (3.9.2) ──────────
#
# `exec_capture` returns a BYTE COUNT and sends the child's stderr to
# /dev/null. Both halves of that are wrong for running an OCI runtime:
#
#   * The byte count is not an outcome. `backend_capture_finish` sets
#     `exit_code = 0` for every non-negative `n`, so a container that exited 7,
#     died on a signal, or never started at all was reported as a success. That
#     is the same defect 3.9.1 fixed for the PROCESS backend via
#     `confine_last_exit()` — it just never reached this backend, which is the
#     one SELECTED whenever runc or crun is installed.
#   * runc writes its own diagnostics to stderr. Discarding them is how
#     "mkdir /run/runc: permission denied" turned into a silent empty success
#     once before (see `_oci_state_root` above). That was worked around by
#     passing `--root`; the general case still needs the message.
#
# 3.9.2 gave this backend its own fork, with stdout over a pipe and stderr into
# a temp file under the state root. Since 3.13.2 it runs through
# `backend_run_capture`, the process backend's capture: stdout and stderr are
# two pipes drained together, so neither blocks the runtime, and the run gets
# the config's deadline and stdin, which it had not.
var _oci_last_exit = 0;

# How much of runc's log `_oci_take_file` reads back.
var _OCI_ERR_MAX = 8192;

# Exit status of the most recent `_oci_run`, decoded from waitpid: the exit code
# when the child exited normally, `128 + signal` when it was killed — the same
# convention `confine_capture` uses, so an exit code means the same thing on
# both backends.
#
# ⚠ The process's most recent, for a caller on one thread (3.14.8). The backend
# reads the exit status from the run's own capture (`_oci_run_capture`).
#[must_use]
fn oci_last_exit() { return _oci_last_exit; }

# Scratch path for one run, under the same uid-scoped state root as runc's own
# state (0700), so a multi-user host cannot cross-read it.
#[must_use]
fn _oci_scratch_path(mid, container_id) {
    var base = _oci_state_root();
    if (base == 0) { return 0; }            # unusable state root — refuse, do not build a path
    var blen = strlen(base);
    var mlen = strlen(mid);
    var clen = strlen(container_id);
    var p = alloc(blen + mlen + clen + 1);
    memcpy(p, base, blen);
    memcpy(p + blen, mid, mlen);
    memcpy(p + blen + mlen, container_id, clen);
    store8(p + blen + mlen + clen, 0);
    return p;
}

# Where runc writes its OWN structured log, kept apart from the container's
# stderr by the global `--log` flag.
#
# The separation is not cosmetic — it is required for correctness. The
# externalization gate scans `stdout + stderr` for secrets, and runc's own
# messages are not container output: `code_scan` flags a plain
# `runc run failed: chdir /nonexistent: no such file or directory` as a HIGH
# finding, which the gate turns into QUARANTINE, which `sandbox_exec` turns into
# a hard failure. Mixing the two made every runtime error present as
# "externalization blocked: quarantined" — the runtime's own diagnostic
# suppressed by the scanner meant to police the payload.
#[must_use]
fn _oci_log_path(container_id) { return _oci_scratch_path("/log-", container_id); }

# Run `<runtime> --root <state> --log <log> run --bundle <bundle> <id>` through
# `backend_run_capture` with the config `cfg` (0 for none). Returns the stdout
# byte count, or -1; `oci_last_exit()` is the runtime's exit status (the
# container's, when it ran) and `confine_last_stderr()` its stderr. A deadline
# kills the runtime; `_oci_delete` then stops the container.
#
# For a caller on one thread. The backend runs `_oci_run_capture` (3.14.8).
fn _oci_run(runtime, bundle, container_id, cfg, out_buf, out_cap) {
    var c = _oci_run_capture(runtime, bundle, container_id, cfg, out_buf, out_cap);
    if (c == 0) {
        _oci_last_exit = 1;
        return 0 - 1;
    }
    var n = ConfineCapture_total(c);
    if (n < 0) { _oci_last_exit = 1; }
    else { _oci_last_exit = ConfineCapture_exit(c); }
    confine_capture_release(c);
    return n;
}

# The same run, handing back its capture, or 0 when it was refused before the
# runtime ran: no state directory or log path, or agnos.
fn _oci_run_capture(runtime, bundle, container_id, cfg, out_buf, out_cap) {
    # ⛔ LINUX ONLY — forks a child that execs an OCI runtime (runc/crun). Neither the fork nor
    # the runtime exists on agnos.
    # ⚠ 0 rather than an empty-but-successful capture, so "the container produced no output"
    # and "there is no container runtime here" stay distinguishable.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    var state_root = _oci_state_root();
    if (state_root == 0) { return 0; }
    var log_path = _oci_log_path(container_id);
    if (log_path == 0) { return 0; }
    var args = vec_new();
    vec_push(args, runtime);
    vec_push(args, "--root");
    vec_push(args, state_root);
    # Global flag, so it must precede the `run` subcommand. Sends runc's own
    # structured log to its own file instead of onto the container's stderr —
    # see _oci_log_path for why that separation is load-bearing.
    vec_push(args, "--log");
    vec_push(args, log_path);
    vec_push(args, "run");
    vec_push(args, "--bundle");
    vec_push(args, bundle);
    vec_push(args, container_id);

    # Clear the log path in the PARENT, before the run: a leftover log would
    # read as this run's runtime failure. Unlinking also removes a symlink
    # planted there (the link, not its target); the state-root validation above
    # is what makes that safe, since nobody else can be racing us inside a 0700
    # directory we own.
    kv_unlink(log_path);
    # The runtime was found by path (_oci_runtime_path); the capture pins it
    # before fork, so the child execs the binary that was found (ADR-005 §H4).
    # Its environment is empty, as everywhere else in kavach — `--root` above is
    # what removes this path's dependency on XDG_RUNTIME_DIR.
    return backend_run_start(args, cfg, out_buf, out_cap);
}

# Read back (and remove) one of the run's scratch files. Returns a cstr — "" when
# nothing was written or the file is unreadable, never 0.
fn _oci_take_file(path) {
    if (path == 0) { return ""; }
    var buf = alloc(_OCI_ERR_MAX + 1);
    store8(buf, 0);
    # O_RDONLY|O_NOFOLLOW — without O_NOFOLLOW an attacker who wins the
    # race on this predictable path turns the read into an arbitrary-file read
    # whose contents become the container's reported stderr. There is no O_EXCL
    # here, so this flag is the only guard — and until 3.12.6 it was the x86_64
    # literal, which aarch64 reads as O_LARGEFILE and follows the link. file_open,
    # not sys_open: this runs on agnos too (after _oci_run refuses), where
    # sys_open is (name, namelen, flags).
    var fd = file_open(path, O_RDONLY | O_NOFOLLOW, 0);
    if (fd < 0) { return buf; }
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total, _OCI_ERR_MAX - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= _OCI_ERR_MAX) { rgo = 0; }
        }
    }
    sys_close(fd);
    store8(buf + total, 0);
    kv_unlink(path);
    return buf;
}

# runc's own diagnostics for this run. Non-empty means the RUNTIME failed, not
# the payload — runc logs nothing here for a container that merely exits
# non-zero.
fn _oci_take_log(container_id) { return _oci_take_file(_oci_log_path(container_id)); }

fn _oci_delete(runtime, container_id) {
    var del_root = _oci_state_root();
    if (del_root == 0) { return 0; }
    var args = vec_new();
    vec_push(args, runtime);
    vec_push(args, "--root");
    vec_push(args, del_root);
    vec_push(args, "delete");
    vec_push(args, "--force");
    vec_push(args, container_id);
    var sink[32];
    kv_exec_capture(args, &sink, 32);
    return 0;
}

fn oci_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    var runtime = _oci_runtime_path();
    if (runtime == 0) {
        return backend_error_result("no OCI runtime (runc/crun) found in PATH");
    }
    # Refuse rather than run against a state directory we cannot vouch for.
    if (_oci_state_root() == 0) {
        return backend_error_result(
          "OCI state directory under /tmp is not a private directory owned by this user; refusing to run");
    }

    # 3.12.1: a rootfs'd sandbox is a container — its command resolves inside
    # the image, so the host-interpreter blocklist does not apply. See
    # `runtime_guard_config_for_rootfs`.
    var guard_cfg = runtime_guard_config_for_rootfs(
      SandboxConfig_rootfs(Sandbox_config(sandbox)));
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }
    return _oci_exec_with(runtime, sandbox, command, start_ns);
}

# The run itself, under the runtime at `runtime`: bundle, run, delete, cleanup.
fn _oci_exec_with(runtime, sandbox, command, start_ns) {
    var refused = oci_capabilities_refusal(Sandbox_config(sandbox));
    if (refused != 0) { return backend_error_result(refused); }
    var container_id = oci_container_id("kavach-oci");
    var bundle = oci_prepare_bundle(container_id, sandbox, command);
    if (bundle == 0) {
        return backend_error_result("failed to prepare OCI bundle");
    }

    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);
    var oc = _oci_run_capture(runtime, bundle, container_id, Sandbox_config(sandbox), out_buf, out_cap);
    var end_ns = mono_now_ns();
    var runclog = _oci_take_log(container_id);

    _oci_delete(runtime, container_id);
    oci_cleanup_bundle(bundle);

    # A non-empty runc log means the RUNTIME failed — a bad bundle, a refused
    # mount, a missing binary — and the payload never ran. That is a kavach-level
    # error, not container output, so it is reported as one and never reaches the
    # externalization gate. It must not: `code_scan` flags runc's own
    # `runc run failed: chdir /nonexistent: no such file or directory` as a HIGH
    # finding, so routing it through the gate would replace every runtime
    # diagnostic with "externalization blocked: quarantined" — the scanner meant
    # to police the payload suppressing the message that explains the failure.
    #
    # This also resolves what would otherwise be an unfixable ambiguity: `runc
    # run` exits with the CONTAINER's status on success but its own non-zero
    # status on its own failure, so the exit code alone cannot say which
    # happened. The log file can.
    if (strlen(runclog) > 0) {
        confine_capture_release(oc);
        backend_capture_release(out_buf, out_cap);
        return backend_error_result(_oci_diag("OCI runtime run failed: ", runclog));
    }

    # The payload's REAL outcome: its exit status, whether the deadline killed
    # it, and its stderr, which DOES belong to the payload and so DOES get
    # scanned (before 3.9.2 it went to /dev/null and bypassed the gate). When
    # the capture itself failed its own (1, fail_msg) pair is the truth. 3.14.8:
    # read from this run's capture, which no other thread's run writes.
    var r = 0;
    if (oc == 0) {
        r = backend_capture_finish(out_buf, 0 - 1, out_cap, "OCI runtime run failed", start_ns, end_ns);
    } else {
        r = backend_capture_result(oc, "OCI runtime run failed", start_ns, end_ns);
    }
    backend_capture_release(out_buf, out_cap);
    return r;
}

# "<prefix><detail>" with the detail trimmed of trailing newlines, as a fresh
# cstr — runc's log line ends in one and it reads badly inside an error string.
#[must_use]
fn _oci_diag(prefix, detail) {
    var dlen = strlen(detail);
    while (dlen > 0) {
        var c = load8(detail + dlen - 1);
        if (c != 10 && c != 13) { break; }
        dlen = dlen - 1;
    }
    var plen = strlen(prefix);
    var out = alloc(plen + dlen + 1);
    memcpy(out, prefix, plen);
    memcpy(out + plen, detail, dlen);
    store8(out + plen + dlen, 0);
    return out;
}

# ---- a detached container (3.14.8) -----------------------------------------
#
# `sandbox_spawn` on an OCI sandbox, as the issue's Ask 4 asked and the maintainer
# decided: `runc run` in the foreground, detached as the process path detaches a
# payload (its own session, stdin from /dev/null, stdout and stderr appended to the
# log). runc is the handle's pid. It stays the container's parent, forwards a
# signal it is sent to the container, exits with the container's status, and
# deletes the container when that ends. So `spawned_wait`, `spawned_try_wait` and
# `spawned_terminate` keep their meaning, and the payload gets what `oci_exec`'s
# gets: a PID namespace, runc's `/proc` with its masks, its device rules, ADR-008's
# capabilities and the policy's filter. runc's own errors go to the log, the
# detached payload's only channel.
#
# Through 3.14.7 an OCI sandbox's spawn ran on the process path: the bound set and a
# pivot_root, with no PID namespace, no `/proc` of its own and no device rules.
# stiva's `run -d` lands here.
#
#   - SIGKILL to runc would kill runc and not its container, so `spawned_kill` sends
#     it through `runc kill`, and to runc itself only when that fails, before the
#     container exists.
#   - Once runc is reaped, `runc delete --force` and the bundle's removal run, so a
#     runc that was killed leaves nothing behind.
#derive(accessors)
struct OciSpawn {
    runtime;
    id;
    bundle;
}
var OCI_SPAWN_SIZE = 24;

fn oci_spawn(sandbox, command, log_path) {
    # ⛔ LINUX ONLY, like `_oci_run`.
    #ifdef CYRIUS_TARGET_AGNOS
    kavach_err_print(KAVACH_ERR_BACKEND_UNAVAILABLE, "OCI");
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var runtime = _oci_runtime_path();
    if (runtime == 0) {
        kavach_err_print(KAVACH_ERR_BACKEND_UNAVAILABLE, "no OCI runtime (runc/crun) found in PATH");
        return 0;
    }
    var state_root = _oci_state_root();
    if (state_root == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED,
          "OCI state directory under /tmp is not a private directory owned by this user; refusing to spawn");
        return 0;
    }
    var refused = oci_capabilities_refusal(Sandbox_config(sandbox));
    if (refused != 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, refused);
        return 0;
    }
    var id = oci_container_id("kavach-oci");
    var bundle = oci_prepare_bundle(id, sandbox, command);
    if (bundle == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "failed to prepare OCI bundle");
        return 0;
    }
    var args = vec_new();
    vec_push(args, runtime);
    vec_push(args, "--root");
    vec_push(args, state_root);
    vec_push(args, "run");
    vec_push(args, "--bundle");
    vec_push(args, bundle);
    vec_push(args, id);
    var argc = vec_len(args);
    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);
    # Pinned before fork (ADR-005 §H4), as every runtime kavach starts.
    var pin = kv_exec_pin(runtime);
    var pid = kv_fork();
    if (pid < 0) {
        if (pin >= 0) { sys_close(pin); }
        oci_cleanup_bundle(bundle);
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "fork failed");
        return 0;
    }
    if (pid == 0) {
        _spawn_default_sigpipe();
        _kv_exec_keep_fd = pin;
        kv_setsid();
        if (_spawn_redirect_stdio(log_path) != 0) { sys_exit(SPAWN_EXIT_STDIO); }
        _spawn_close_inherited(3);
        kv_exec_child(pin, runtime, argv, envp);
        sys_exit(127);
    }
    if (pin >= 0) { sys_close(pin); }
    var ctx = alloc(OCI_SPAWN_SIZE);
    OciSpawn_set_runtime(ctx, runtime);
    OciSpawn_set_id(ctx, id);
    OciSpawn_set_bundle(ctx, bundle);
    var sp = spawned_process_new(pid, 0, log_path);
    SpawnedProcess_set_ctx(sp, ctx);
    SpawnedProcess_set_kill_fn(sp, &_oci_spawn_kill);
    SpawnedProcess_set_reap_fn(sp, &_oci_spawn_reap);
    return sp;
    #endif
}

# The bundle a spawned container runs from, or 0 for a handle that is not one.
fn oci_spawned_bundle(sp) {
    if (sp == 0) { return 0; }
    var ctx = SpawnedProcess_ctx(sp);
    if (ctx == 0) { return 0; }
    return OciSpawn_bundle(ctx);
}

# `spawned_kill` for a container: SIGKILL through `runc kill`, which signals the
# container's init, and every other signal to runc, which forwards it.
fn _oci_spawn_kill(sp, signal) {
    var ctx = SpawnedProcess_ctx(sp);
    if (signal == 9) {
        var root = _oci_state_root();
        if (root != 0) {
            var args = vec_new();
            vec_push(args, OciSpawn_runtime(ctx));
            vec_push(args, "--root");
            vec_push(args, root);
            vec_push(args, "kill");
            vec_push(args, OciSpawn_id(ctx));
            vec_push(args, "KILL");
            var sink[64];
            var c = confine_capture_new(args, 0, 0, 0, 0, &sink, 64, 0, 10000, 0, "", 0, 0, 0);
            confine_capture_run(c);
            var ok = 0;
            if (ConfineCapture_total(c) >= 0 && ConfineCapture_exit(c) == 0) { ok = 1; }
            confine_capture_release(c);
            if (ok == 1) { return 0; }
        }
    }
    if (sys_kill(SpawnedProcess_pid(sp), signal) < 0) { return 0 - 1; }
    return 0;
}

# Once runc is reaped: the container's state, however runc ended, and its bundle.
fn _oci_spawn_reap(sp) {
    var ctx = SpawnedProcess_ctx(sp);
    if (ctx == 0) { return 0; }
    _oci_delete(OciSpawn_runtime(ctx), OciSpawn_id(ctx));
    oci_cleanup_bundle(OciSpawn_bundle(ctx));
    return 0;
}

fn oci_health(sandbox) {
    if (_oci_runtime_path() == 0) { return 0; }
    return 1;
}

fn oci_destroy(sandbox) { return 0; }

fn backend_oci_register() {
    backend_register_exec(KavachBackend.OCI, &oci_exec);
    backend_register_health(KavachBackend.OCI, &oci_health);
    backend_register_destroy(KavachBackend.OCI, &oci_destroy);
    backend_register_spawn(KavachBackend.OCI, &oci_spawn);
    return 0;
}

# --- backend_wasm.cyr ---

# kavach — WASM (wasmtime) backend
# Ported from rust-old/src/backend/wasm/mod.rs
#
# The Rust version embedded wasmtime via Cargo crates. Cyrius v3.0 shells
# out to the `wasmtime` CLI binary instead, which accepts the same
# --fuel / --dir / --env / --max-memory-size flags. Module format is still
# `command = path to .wasm file`.
#
# Deferred: WAT inline modules, custom linker hooks. Both require embedding
# a real WASM runtime — v3.0 or whenever mabda/yukti exposes one.

# The guest memory ceiling applied when the policy names none, in MiB.
#
# ⚠ **A sandbox must not default to UNBOUNDED.** `policy_basic()` — what
# `config_new()` installs — sets seccomp and leaves `memory_limit_mb` at 0, and
# `_wasm_append_limits` used to emit `-W max-memory-size` only when that was
# > 0. So every caller on the default policy ran its guest with no ceiling at
# all: verified against wasmtime 47 with a module declaring **128 MiB**, which
# instantiates fine bare and is refused under a 64 MiB ceiling. wasm32 caps a
# guest at 4 GiB, so "no ceiling" means a hostile module can claim that much.
#
# 64 MiB is the value Rust's own `WasmSandbox` defaults to
# (`DEFAULT_MAX_MEMORY_BYTES`, agnosai's oracle at
# `rust-old/src/sandbox/wasm.rs:19`), so this matches the embedding host rather
# than inventing a number. A caller wanting more sets
# `SandboxPolicy_set_memory_limit_mb`; `policy_strict()` already sets 512.
var WASM_DEFAULT_MEMORY_LIMIT_MB = 64;

# The ceiling actually applied: the policy's, or the default when it names none.
fn _wasm_effective_memory_mb(policy) {
    var mem = SandboxPolicy_memory_limit_mb(policy);
    if (mem > 0) { return mem; }
    return WASM_DEFAULT_MEMORY_LIMIT_MB;
}

# Fuel calibration from timeout_ms. Matches Rust:
#   fuel ≈ timeout_ms * 1_000_000 (≈ 1B instr/sec assumption)
#
# ⚠ This is the FALLBACK, used only when `config_fuel` was not set. It derives a
# CPU budget from a wall-clock one, which is a guess — see `config_fuel`.
fn _wasm_fuel_from_timeout(timeout_ms) {
    return timeout_ms * 1000000;
}

# The effective fuel: an explicitly configured budget, or the timeout-derived
# fallback when none was set.
fn _wasm_effective_fuel(cfg, timeout_ms) {
    var explicit = SandboxConfig_fuel(cfg);
    if (explicit > 0) { return explicit; }
    return _wasm_fuel_from_timeout(timeout_ms);
}

# Whether `policy` asks for landlock: a rule, or deny-all. On this backend that
# makes the policy the guest's whole filesystem grant, and confines wasmtime.
fn _wasm_policy_has_landlock(policy) {
    if (policy == 0) { return 0; }
    if (SandboxPolicy_landlock_rules_len(policy) > 0) { return 1; }
    return 0;
}

# Append `--dir <path>`, or return -1 for a path `--dir` would misread:
# wasmtime splits its value at `::` into a host and a guest path, so
# `/srv/a::/etc` preopens the host's `/srv/a`, and names it `/etc`.
fn _wasm_push_dir(args, path) {
    if (cstr_contains(path, "::") == 1) { return 0 - 1; }
    vec_push(args, "--dir");
    vec_push(args, path);
    return 0;
}

# Whether `path` names something that exists and is not a directory, following
# a symlink as `--dir` and landlock do. 0 on agnos, where this backend cannot
# run a guest.
fn _wasm_names_a_file(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = file_open(path, 0x200000 | O_CLOEXEC, 0);    # O_PATH; the stdlib names none
    if (fd < 0) { return 0; }
    # SAFETY: `st` is 144 bytes, no smaller than struct stat on x86-64 (144) or
    # aarch64 (128), and STAT_MODE is the stdlib's per-arch offset of the 32-bit
    # st_mode inside it.
    var st[144];
    var r = sys_fstat(fd, &st);
    sys_close(fd);
    if (r < 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 61440) == 16384) { return 0; }   # S_IFDIR
    return 1;
    #endif
}

# The directories the guest may reach, as `--dir` preopens. Returns 0, or -1
# for a path `--dir` cannot express.
#
# **A policy with landlock is the whole grant**, as it is for a process: each
# rule the child would apply (the first `landlock_rules_len`) is preopened at
# its own path, and nothing else is, the workdir included. A deny-all policy
# preopens nothing. `--dir` is read-write, and wasmtime's CLI has no read-only
# form (wasmtime 49 takes `--dir X::/a::ro` and ignores the `::ro`), so an
# `FS_READ_ONLY` rule is held read-only by landlock on the wasmtime process
# (`_wasm_host_policy`).
#
# A rule naming a file gets no preopen, so the guest cannot reach that file.
# `--dir` takes only a directory (wasmtime refuses a file: "Not a directory"),
# and preopening the file's directory would hand the guest its siblings as
# well. A path that does not exist is passed on, and fails the exec closed.
#
# With no landlock the workdir, if set, is preopened, as before. That preopen
# is read-write: the comment here called it read-only through 3.13.0, and a
# guest could create files in it.
#
# Through 3.13.0 this read no rule. Its comment said the policy carried only a
# count, which stopped being so at 3.11.3. A deny-all policy's guest got the
# workdir, and a policy naming paths gave its guest the workdir and not them.
fn _wasm_append_preopens(args, sandbox) {
    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);
    if (_wasm_policy_has_landlock(policy) == 1) {
        if (policy_landlock_is_deny_all(policy) == 1) { return 0; }
        var rules = policy_landlock_rules(policy);
        var n = SandboxPolicy_landlock_rules_len(policy);
        var i = 0;
        while (i < n) {
            var path = security_fs_rule_path(vec_get(rules, i));
            if (_wasm_names_a_file(path) == 0) {
                if (_wasm_push_dir(args, path) != 0) { return 0 - 1; }
            }
            i = i + 1;
        }
        return 0;
    }
    var wd = SandboxConfig_workdir(cfg);
    if (wd != 0) {
        if (strlen(wd) > 0) { return _wasm_push_dir(args, wd); }
    }
    return 0;
}

# The landlock ruleset for the wasmtime process, when the policy asks for
# landlock. The guest reaches only its preopens either way; this ruleset is what
# makes an `FS_READ_ONLY` rule read-only inside its preopen, since `--dir`
# cannot, and it holds wasmtime itself to these paths.
#
# The policy's applied rules, with their access, and read-only access to what
# wasmtime needs to start and load the module: its binary, `/usr`, `/lib` and
# `/lib64` where they exist, and the module. A deny-all policy contributes no
# rule, so only wasmtime's own paths remain, and the guest has no preopen to
# reach them. The binary and the module are files, each granted alone: until a
# rule naming a file could be applied, this named their directories.
fn _wasm_host_policy(policy, wasmtime, module) {
    var host = policy_new();
    # The policy's landlock scopes (3.13.2) hold wasmtime too.
    SandboxPolicy_set_landlock_abstract_unix(host, SandboxPolicy_landlock_abstract_unix(policy));
    SandboxPolicy_set_landlock_signal(host, SandboxPolicy_landlock_signal(policy));
    policy_landlock_add(host, wasmtime, FS_READ_ONLY);
    policy_landlock_add(host, "/usr", FS_READ_ONLY);
    if (kavach_path_exists("/lib") == 1) { policy_landlock_add(host, "/lib", FS_READ_ONLY); }
    if (kavach_path_exists("/lib64") == 1) { policy_landlock_add(host, "/lib64", FS_READ_ONLY); }
    policy_landlock_add(host, module, FS_READ_ONLY);
    if (policy_landlock_is_deny_all(policy) == 1) { return host; }
    var rules = policy_landlock_rules(policy);
    var n = SandboxPolicy_landlock_rules_len(policy);
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        policy_landlock_add(host, security_fs_rule_path(r), security_fs_rule_access(r));
        i = i + 1;
    }
    return host;
}

# The seccomp filter wasmtime runs under: kavach's exec filter when the policy
# enables seccomp, as a process payload gets it; 0 when it does not; -1 when
# the filter cannot be built, which fails the exec closed.
#
# Through 3.13.1 the WASM backend applied no filter, while `score_backend` added
# 5 for `seccomp_enabled` on every backend. WASI stays the guest's syscall
# boundary; this holds wasmtime itself to the filter's deny list. Measured
# before it was wired: wasmtime runs under the exec filter, its guest reading a
# preopened directory.
fn _wasm_seccomp_info(policy) {
    if (policy == 0) { return 0; }
    if (SandboxPolicy_seccomp_enabled(policy) != 1) { return 0; }
    var st, sv = security_create_exec_seccomp_filter();
    if (is_ok(st) == 0) { return 0 - 1; }
    return result_unwrap(st, sv);
}

# Append resource-limit flags from policy.
# Build one `-W key=value` argument, NUL-terminated.
#
# ⚠ Both limits must be a SINGLE argv element of the form `-Wkey=value` or the
# pair `-W` `key=value` — wasmtime's option groups do not accept
# `-W key value`. This helper emits the pair form.
fn _wasm_push_w_opt(args, key, value) {
    var buf[64];
    var klen = strlen(key);
    memcpy(&buf, key, klen);
    store8(&buf + klen, 61);
    var vlen = fmt_int_buf(value, &buf + klen + 1);
    var total = klen + 1 + vlen;
    var out = alloc(total + 1);
    memcpy(out, &buf, total);
    store8(out + total, 0);
    vec_push(args, "-W");
    vec_push(args, out);
    return 0;
}

# CPU and memory bounds for the guest.
#
# ⚠ **These moved into wasmtime's `-W` option group and the old spellings are
# now HARD ERRORS.** Until 3.11.10 this emitted `--max-memory-size <bytes>` and
# `--fuel <N>` as top-level `run` flags; wasmtime 47 answers
# `error: unexpected argument '--max-memory-size' found` and runs nothing.
#
# ⚠ **It was never validated.** Nothing in this repo had ever run a real module
# through `wasm_exec` — `test_wasm_exec_without_wasmtime` and
# `test_wasm_exec_missing_file` both fail before argv is assembled, so a wrong
# flag was invisible. `test_wasm_exec_real_module` now runs one end to end and
# is the guard; it fails on the old spellings.
#
# The `-W` group has existed since wasmtime 14, so the pair form is not a
# 47-specific accommodation — it is the spelling that has been correct all along.
#
# The store limits came in 3.14.4 (`config_wasm_max_instances` and its peers);
# until then a guest was bounded in memory and fuel alone, and a failed grow
# returned -1. `cfg` may be 0, which is every default.
fn _wasm_append_limits(args, policy, fuel, cfg) {
    # Always emitted — see `WASM_DEFAULT_MEMORY_LIMIT_MB` for why a missing
    # policy limit must not mean "unbounded".
    _wasm_push_w_opt(args, "max-memory-size",
      _wasm_effective_memory_mb(policy) * 1048576);

    if (fuel > 0) {
        _wasm_push_w_opt(args, "fuel", fuel);
    }
    var grow_returns = 0;
    if (cfg != 0) {
        _wasm_push_w_limit(args, "max-instances", SandboxConfig_wasm_max_instances(cfg));
        _wasm_push_w_limit(args, "max-tables", SandboxConfig_wasm_max_tables(cfg));
        _wasm_push_w_limit(args, "max-table-elements", SandboxConfig_wasm_max_table_elements(cfg));
        _wasm_push_w_limit(args, "max-memories", SandboxConfig_wasm_max_memories(cfg));
        grow_returns = SandboxConfig_wasm_grow_returns_failure(cfg);
    }
    if (grow_returns == 0) {
        vec_push(args, "-W");
        vec_push(args, "trap-on-grow-failure=y");
    }
    return 0;
}

# `_wasm_push_w_opt` for a store limit the config may leave at wasmtime's default.
fn _wasm_push_w_limit(args, key, value) {
    if (value > 0) { _wasm_push_w_opt(args, key, value); }
    return 0;
}

# Trim leading/trailing ASCII whitespace. Returns allocated cstr.
fn _wasm_trim(s) {
    var n = strlen(s);
    var start = 0;
    while (start < n) {
        var c = load8(s + start);
        if (c != 32) { if (c != 9) { if (c != 10) { if (c != 13) { break; } } } }
        start = start + 1;
    }
    var end = n;
    while (end > start) {
        var c = load8(s + end - 1);
        if (c != 32) { if (c != 9) { if (c != 10) { if (c != 13) { break; } } } }
        end = end - 1;
    }
    var len = end - start;
    var out = alloc(len + 1);
    memcpy(out, s + start, len);
    store8(out + len, 0);
    return out;
}

fn wasm_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    var wasmtime = _wasm_binary_path();
    if (wasmtime == 0) {
        return backend_error_result("wasmtime not found in PATH");
    }

    # The command is expected to be a .wasm file path.
    var wasm_path = _wasm_trim(command);
    if (strlen(wasm_path) == 0) {
        return backend_error_result("WASM backend requires a .wasm file path as the command");
    }
    if (kavach_path_exists(wasm_path) == 0) {
        return backend_error_result("WASM module file not found");
    }

    # Runtime-guard precheck is still useful — a .wasm path containing
    # shell metacharacters (e.g., "/tmp/foo.wasm; cat /etc/shadow") would
    # only be sent as a literal argv element, but the sandbox caller still
    # deserves the warning.
    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);
    var timeout = SandboxConfig_timeout_ms(cfg);

    # A policy with landlock confines wasmtime itself (`_wasm_host_policy`), and
    # one with seccomp runs it under the exec filter (`_wasm_seccomp_info`).
    var confined = _wasm_policy_has_landlock(policy);
    var sec = _wasm_seccomp_info(policy);
    if (sec < 0) {
        return backend_error_result("seccomp requested but the filter could not be built");
    }
    var run_policy = policy;
    if (confined == 1) { run_policy = _wasm_host_policy(policy, wasmtime, wasm_path); }

    var args = vec_new();
    vec_push(args, wasmtime);
    vec_push(args, "run");
    # Confined, wasmtime cannot reach its module cache: it looks up the cache's
    # config under the user's home, and stops with "config file not specified
    # and failed to get the default" (wasmtime 49). So a confined run compiles
    # the module afresh.
    if (confined == 1) {
        vec_push(args, "-C");
        vec_push(args, "cache=n");
    }
    _wasm_append_limits(args, policy, _wasm_effective_fuel(cfg, timeout), cfg);
    if (_wasm_append_preopens(args, sandbox) != 0) {
        return backend_error_result("WASM backend cannot preopen a path containing \"::\"");
    }
    # `--` separator guards against .wasm paths starting with '-'.
    vec_push(args, "--");
    vec_push(args, wasm_path);

    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);

    # 3.11.8: `confine_capture_input`, not the stdlib's `exec_capture`.
    #
    # ⚠ Three things were wrong with `exec_capture` here, and the process
    # backend had already fixed all three for itself in 3.11.4/3.11.5 — this
    # backend was simply left behind on the old call:
    #
    #   * **the guest's exit code was discarded.** `backend_capture_finish`
    #     stamps 0 on any successful capture, and nothing overrode it, so a
    #     module that TRAPPED reported success with whatever partial stdout it
    #     managed. A consumer branching on `exit_code != 0` — which is the whole
    #     failure taxonomy of a tool protocol — saw every failure as a success.
    #   * **stderr was hard-redirected to /dev/null**, so `ExecResult.stderr`
    #     always read "", which is a different and false claim from "the guest
    #     wrote nothing".
    #   * **there was no stdin**, so a guest could be run but not given
    #     parameters. That is what agnosai filed: a WASM tool that cannot
    #     receive its input is not a tool.
    #
    # `do_confine`: wasmtime's own WASI sandbox is the boundary for the guest:
    # no preopen means no filesystem, and fuel and the memory ceiling bound it.
    # A policy asking for child-side confinement (`policy_wants_confinement`)
    # also confines the wasmtime process: `confine_child` sets NO_NEW_PRIVS,
    # closes inherited descriptors, applies the ruleset (`_wasm_host_policy`'s
    # when the policy has rules, which lets wasmtime read its module; otherwise
    # one of the policy's scopes alone) and loads the exec filter when the
    # policy enables seccomp. No namespaces and no cgroup: those arguments are
    # 0. Through 3.13.0 no policy confined wasmtime, and through 3.13.1 only
    # landlock rules did: seccomp and the scopes were not applied (3.13.2).
    var do_confine = policy_wants_confinement(policy);
    var c = confine_capture_new(args, run_policy, 0, 0, sec, out_buf, out_cap, 0,
      timeout, do_confine, _config_payload_stdin(cfg), _config_payload_stdin_len(cfg), 0, 0);
    confine_capture_run(c);
    var end_ns = mono_now_ns();

    # 3.14.8: the guest's exit status, deadline flag and stderr are this capture's.
    # Through 3.14.7 they were read back from `confine_last_*`, which agnosai's WASM
    # tier, running calls on several threads, could read from another call: it reads
    # stderr to tell a module over its store limits from a guest that failed.
    var r = backend_capture_result(c, "wasmtime run failed", start_ns, end_ns);
    backend_capture_release(out_buf, out_cap);
    return r;
}

fn wasm_health(sandbox) {
    if (_wasm_binary_path() == 0) { return 0; }
    return 1;
}

fn wasm_destroy(sandbox) { return 0; }

fn backend_wasm_register() {
    backend_register_exec(KavachBackend.WASM, &wasm_exec);
    backend_register_health(KavachBackend.WASM, &wasm_health);
    backend_register_destroy(KavachBackend.WASM, &wasm_destroy);
    return 0;
}

# --- backend_sy_agnos.cyr ---

# kavach — SyAgnos backend (hardened AGNOS OS image as container sandbox)
# Ported from rust-old/src/backend/sy_agnos/mod.rs
#
# Shells out to docker/podman running the `ghcr.io/maccracken/sy-agnos`
# image. The image carries its own baked hardening (immutable squashfs
# rootfs, seccomp-BPF, default-deny nftables); this backend translates
# SandboxPolicy into the runtime flags (--memory, --cpus, --pids-limit,
# --read-only, --network none|bridge) and optionally runs the Phylax
# scanner on output.
#
# Deferred vs Rust:
#   - Image manager (pull/build/list) — skipped for v3.0
#   - Tier detection from /etc/sy-agnos-release — needs JSON parse
#   - AttestationReport + PCR verify — wait for sigil TPM helpers

var SY_AGNOS_DEFAULT_IMAGE = "ghcr.io/maccracken/agnos:latest";
var _sy_agnos_image = 0;

# The image `sy_agnos_exec` runs: SY_AGNOS_DEFAULT_IMAGE unless
# `sy_agnos_set_image` named another (3.14.2), for a mirror, a pinned digest
# (`…@sha256:…`) or a local build. The name is copied. Returns the previous one.
fn sy_agnos_set_image(name) {
    var prev = sy_agnos_image();
    if (name == 0) { _sy_agnos_image = 0; return prev; }
    var n = strlen(name);
    var c = alloc(n + 1);
    memcpy(c, name, n + 1);
    _sy_agnos_image = c;
    return prev;
}

fn sy_agnos_image() {
    if (_sy_agnos_image != 0) { return _sy_agnos_image; }
    return SY_AGNOS_DEFAULT_IMAGE;
}

enum SyAgnosTier {
    MINIMAL = 0;
    DMVERITY = 1;
    TPM_MEASURED = 2;
}

fn sy_agnos_tier_name(t) {
    if (t == SyAgnosTier.MINIMAL) { return "minimal"; }
    if (t == SyAgnosTier.DMVERITY) { return "dmverity"; }
    if (t == SyAgnosTier.TPM_MEASURED) { return "tpm_measured"; }
    return "unknown";
}

fn sy_agnos_tier_strength(t) {
    if (t == SyAgnosTier.MINIMAL) { return 80; }
    if (t == SyAgnosTier.DMVERITY) { return 85; }
    if (t == SyAgnosTier.TPM_MEASURED) { return 88; }
    return 80;
}

fn sy_agnos_tier_parse(s) {
    if (streq(s, "tpm_measured") == 1) { return SyAgnosTier.TPM_MEASURED; }
    if (streq(s, "dmverity") == 1) { return SyAgnosTier.DMVERITY; }
    return SyAgnosTier.MINIMAL;
}

# ---- Runtime detection ---------------------------------------------------

fn _sy_agnos_runtime() {
    if (kavach_path_exists("/usr/local/bin/docker") == 1) { return "/usr/local/bin/docker"; }
    if (kavach_path_exists("/usr/bin/docker") == 1) { return "/usr/bin/docker"; }
    if (kavach_path_exists("/usr/local/bin/podman") == 1) { return "/usr/local/bin/podman"; }
    if (kavach_path_exists("/usr/bin/podman") == 1) { return "/usr/bin/podman"; }
    return 0;
}

# ---- Phylax scanner (sy-agnos-specific patterns) -------------------------
# Extends the normal secrets scanner with container-escape indicators.
# Each hit is tagged with one of: VERITY / NFTABLES_BYPASS /
# NAMESPACE_ESCAPE / MOUNT_ESCAPE.

fn _phylax_emit(text, lower, result, category, matched) {
    return code_emit(text, lower, result, Severity.CRITICAL, category,
      "Phylax indicator", matched);
}

fn phylax_scan(text, result) {
    # Run the standard secrets scanner first.
    secrets_scan(text, result);

    var n = strlen(text);
    var lower = alloc(n + 1);
    str_to_lower_into(text, lower);

    if (cstr_contains(lower, "dm-verity") == 1) {
        _phylax_emit(text, lower, result, "VERITY", "dm-verity");
    }
    if (cstr_contains(lower, "verity validation failed") == 1) {
        _phylax_emit(text, lower, result, "VERITY", "verity validation failed");
    }
    if (cstr_contains(lower, "device-mapper: verity") == 1) {
        _phylax_emit(text, lower, result, "VERITY", "device-mapper: verity");
    }
    if (cstr_contains(lower, "nft ") == 1) {
        _phylax_emit(text, lower, result, "NFTABLES_BYPASS", "nft ");
    }
    if (cstr_contains(lower, "nftables") == 1) {
        _phylax_emit(text, lower, result, "NFTABLES_BYPASS", "nftables");
    }
    if (cstr_contains(lower, "iptables") == 1) {
        _phylax_emit(text, lower, result, "NFTABLES_BYPASS", "iptables");
    }
    if (cstr_contains(lower, "nsenter") == 1) {
        _phylax_emit(text, lower, result, "NAMESPACE_ESCAPE", "nsenter");
    }
    if (cstr_contains(lower, "setns(") == 1) {
        _phylax_emit(text, lower, result, "NAMESPACE_ESCAPE", "setns(");
    }
    if (cstr_contains(lower, "unshare(") == 1) {
        _phylax_emit(text, lower, result, "NAMESPACE_ESCAPE", "unshare(");
    }
    if (cstr_contains(lower, "/proc/1/ns/") == 1) {
        _phylax_emit(text, lower, result, "NAMESPACE_ESCAPE", "/proc/1/ns/");
    }
    if (cstr_contains(lower, "mount -t proc") == 1) {
        _phylax_emit(text, lower, result, "MOUNT_ESCAPE", "mount -t proc");
    }
    if (cstr_contains(lower, "mount -o remount,rw") == 1) {
        _phylax_emit(text, lower, result, "MOUNT_ESCAPE", "mount -o remount,rw");
    }
    if (cstr_contains(lower, "pivot_root") == 1) {
        _phylax_emit(text, lower, result, "MOUNT_ESCAPE", "pivot_root");
    }
    if (cstr_contains(lower, "chroot") == 1) {
        _phylax_emit(text, lower, result, "MOUNT_ESCAPE", "chroot");
    }
    return 0;
}

# ---- Arg building --------------------------------------------------------

fn _sy_agnos_append_int_flag(args, flag, value, suffix) {
    var buf[32];
    var n = fmt_int_buf(value, &buf);
    var s = alloc(n + strlen(suffix) + 1);
    memcpy(s, &buf, n);
    memcpy(s + n, suffix, strlen(suffix));
    store8(s + n + strlen(suffix), 0);
    vec_push(args, flag);
    vec_push(args, s);
    return 0;
}

# ---- Exec ----------------------------------------------------------------

# `<runtime> rm --force <name>` after every run, as gVisor and OCI delete
# theirs: a deadline kills the client, and killing the client does not stop the
# container. For a container `create` never made it is a harmless failure.
fn _sy_agnos_remove(runtime, name) {
    var args = vec_new();
    vec_push(args, runtime);
    vec_push(args, "rm");
    vec_push(args, "--force");
    vec_push(args, name);
    var sink[32];
    kv_exec_capture(args, &sink, 32);
    return 0;
}

fn sy_agnos_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    var runtime = _sy_agnos_runtime();
    if (runtime == 0) {
        return backend_error_result("no container runtime (docker/podman) found");
    }

    # Runtime-guard precheck — same defense-in-depth as other backends.
    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }
    return _sy_agnos_exec_with(runtime, sandbox, command, start_ns);
}

# Run a runtime command that is not the payload (`create`, `inspect`): no
# stdin, its own deadline, stdout into `buf`. Returns the run's capture: its
# byte count (`ConfineCapture_total`, -1 for a failed capture), stderr and exit
# status. 3.14.8: through 3.14.7 these were read back from `confine_last_*`,
# which another thread's capture rewrites. The caller releases it.
fn _sy_agnos_tool(args, timeout_ms, buf, cap) {
    var c = confine_capture_new(args, 0, 0, 0, 0, buf, cap, 0, timeout_ms, 0, "", 0, 0, 0);
    confine_capture_run(c);
    return c;
}

# "<prefix><capture c's stderr>", trimmed of trailing newlines. Releases `c`.
fn _sy_agnos_diag(prefix, c) {
    var d = _oci_diag(prefix, confine_capture_stderr(c));
    confine_capture_release(c);
    return d;
}

# Milliseconds of `timeout_ms` left since `start_ns`; 0 when there was no
# deadline, and at least 1 when there was one.
fn _sy_agnos_left(timeout_ms, start_ns) {
    if (timeout_ms <= 0) { return 0; }
    var left = timeout_ms - (mono_now_ns() - start_ns) / 1000000;
    if (left < 1) { left = 1; }
    return left;
}

# Run `command` in the image under the container runtime `runtime`.
#
# 3.14.2: as `create`, then `start`, then `inspect`, so the runtime's own
# failures are told apart from the payload's. `docker run` prints its errors on
# the stderr the container's stderr goes to ("docker: Error response from
# daemon: …") and exits 125, 126 or 127, the statuses a shell payload uses too
# (127 for a command it cannot find). Measured on docker 29.9.2: a missing
# image, a refused `--memory 1m` and a missing entrypoint each reached the
# result as the payload's stderr, and through it the externalization gate,
# where a runtime error can read as a finding and fail the exec as
# "externalization blocked".
#
#   1. `<rt> create -i --name <n> … <image> -c <command>` pulls the image and
#      makes the container. Its stderr (pull progress, "No such image", a refused
#      flag) is the runtime's; a failure is a diagnostic.
#   2. `<rt> start -a -i <n>` runs it attached, with the payload's stdin and
#      what is left of the deadline (`backend_run_capture`'s contract): its
#      stdout, stderr and exit status are the payload's…
#   3. …unless it never started. Then `start` exits 1 with the daemon's message,
#      and `<rt> inspect --format {{.State.Error}} <n>` prints it; a payload that
#      exits 127 itself leaves it empty. A non-empty `.State.Error` is a
#      diagnostic. An inspect that fails says nothing either way, so it is one
#      too: the stderr cannot be shown to be the payload's.
#   4. `<rt> rm --force <n>`, after every run.
#
# podman has the same verbs and the same `.State.Error`.
fn _sy_agnos_exec_with(runtime, sandbox, command, start_ns) {
    var config = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(config);
    var timeout_ms = SandboxConfig_timeout_ms(config);
    # Named, so `start`, `inspect` and `_sy_agnos_remove` can find it.
    var name = oci_container_id("kavach-sy");

    var args = vec_new();
    vec_push(args, runtime);
    vec_push(args, "create");
    vec_push(args, "-i");
    vec_push(args, "--name");
    vec_push(args, name);

    vec_push(args, "--network");
    if (SandboxPolicy_network_enabled(policy) == 1) {
        vec_push(args, "bridge");
    }
    else {
        vec_push(args, "none");
    }

    var mem = SandboxPolicy_memory_limit_mb(policy);
    if (mem > 0) {
        _sy_agnos_append_int_flag(args, "--memory", mem, "m");
    }

    # cpu limit is tenths × 10 → whole cores as string. Example: 10 -> "1".
    var cpu_x10 = SandboxPolicy_cpu_limit_tenths(policy);
    if (cpu_x10 > 0) {
        _sy_agnos_append_int_flag(args, "--cpus", cpu_x10 / 10, "");
    }

    var max_pids = SandboxPolicy_max_pids(policy);
    if (max_pids > 0) {
        _sy_agnos_append_int_flag(args, "--pids-limit", max_pids, "");
    }

    if (SandboxPolicy_read_only_rootfs(policy) == 1) {
        vec_push(args, "--read-only");
    }

    vec_push(args, "--entrypoint");
    vec_push(args, "/bin/sh");
    vec_push(args, sy_agnos_image());
    vec_push(args, "-c");
    vec_push(args, command);

    var idbuf[128];
    var cc = _sy_agnos_tool(args, timeout_ms, &idbuf, 128);
    if (ConfineCapture_total(cc) < 0 || ConfineCapture_exit(cc) != 0 || ConfineCapture_timed_out(cc) == 1) {
        var why = "sy-agnos: container create failed: ";
        if (ConfineCapture_timed_out(cc) == 1) { why = "sy-agnos: container create ran past the deadline: "; }
        var d = _sy_agnos_diag(why, cc);
        _sy_agnos_remove(runtime, name);
        return backend_error_result(d);
    }
    confine_capture_release(cc);

    var sargs = vec_new();
    vec_push(sargs, runtime);
    vec_push(sargs, "start");
    vec_push(sargs, "-a");
    vec_push(sargs, "-i");
    vec_push(sargs, name);
    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);
    var sc = confine_capture_new(sargs, 0, 0, 0, 0, out_buf, out_cap, 0,
      _sy_agnos_left(timeout_ms, start_ns), 0, _config_payload_stdin(config), _config_payload_stdin_len(config), 0, 0);
    var n = confine_capture_run(sc);
    var end_ns = mono_now_ns();
    var timed_out = ConfineCapture_timed_out(sc);
    var r = backend_capture_result(sc, "sy-agnos container run failed", start_ns, end_ns);
    backend_capture_release(out_buf, out_cap);

    if (n >= 0 && timed_out == 0) {
        var iargs = vec_new();
        vec_push(iargs, runtime);
        vec_push(iargs, "inspect");
        vec_push(iargs, "--format");
        vec_push(iargs, "{{.State.Error}}");
        vec_push(iargs, name);
        var ecap = 4096;
        var ebuf = alloc(ecap + 1);
        var ic = _sy_agnos_tool(iargs, 10000, ebuf, ecap);
        var en = ConfineCapture_total(ic);
        if (en < 0 || ConfineCapture_exit(ic) != 0) {
            var idiag = _sy_agnos_diag(
              "sy-agnos: cannot inspect the container, so its stderr cannot be shown to be the payload's: ", ic);
            _sy_agnos_remove(runtime, name);
            return backend_error_result(idiag);
        }
        confine_capture_release(ic);
        store8(ebuf + en, 0);
        var state_err = _oci_diag("", ebuf);
        if (strlen(state_err) > 0) {
            _sy_agnos_remove(runtime, name);
            return backend_error_result(_oci_diag("sy-agnos: container start failed: ", state_err));
        }
    }
    _sy_agnos_remove(runtime, name);
    return r;
}

fn sy_agnos_health(sandbox) {
    if (_sy_agnos_runtime() == 0) { return 0; }
    return 1;
}

fn sy_agnos_destroy(sandbox) { return 0; }

fn backend_sy_agnos_register() {
    backend_register_exec(KavachBackend.SY_AGNOS, &sy_agnos_exec);
    backend_register_health(KavachBackend.SY_AGNOS, &sy_agnos_health);
    backend_register_destroy(KavachBackend.SY_AGNOS, &sy_agnos_destroy);
    return 0;
}

# --- backend_sgx.cyr ---

# kavach — Intel SGX (Gramine-SGX) backend
# Ported from rust-old/src/backend/sgx/mod.rs
#
# Generates a minimal Gramine manifest and runs `gramine-sgx <prefix>`.
# Requires /dev/sgx_enclave and the gramine-sgx binary.
#
# Deferred vs Rust:
#   - Quote fetch. kavach verifies DCAP quotes since 3.13.0
#     (`kavach_attest_sgx_quote`), but this launcher cannot get one out of the
#     enclave. It cannot start one yet either: the manifest it writes is a
#     template that is never rendered (`gramine-manifest`) or signed
#     (`gramine-sgx-sign`). A policy that requires attestation is refused here,
#     before anything runs.
#   - Sealing / unsealing (SealedData, SealKeyPolicy) — needs gramine-sgx-seal
#     wrapper and AES-GCM support in sigil

fn _sgx_gramine_path() {
    if (kavach_path_exists("/usr/local/bin/gramine-sgx") == 1) { return "/usr/local/bin/gramine-sgx"; }
    if (kavach_path_exists("/usr/bin/gramine-sgx") == 1) { return "/usr/bin/gramine-sgx"; }
    return 0;
}

fn _sgx_device_present() {
    return kavach_path_exists("/dev/sgx_enclave");
}

# Generate a minimal Gramine manifest. Writes to <workdir>/app.manifest
# and returns the path. NOTE: real-world SGX deployments sign the manifest
# with gramine-sgx-sign; for v3.0 we produce an unsigned template that
# consumers must post-process. Path returned is the `.manifest.sgx` prefix
# that `gramine-sgx` expects.
fn _sgx_manifest_path(workdir) {
    var buf = alloc(strlen(workdir) + 32);
    memcpy(buf, workdir, strlen(workdir));
    memcpy(buf + strlen(workdir), "/app", 5);
    return buf;
}

fn _sgx_manifest_file(workdir) {
    var buf = alloc(strlen(workdir) + 32);
    memcpy(buf, workdir, strlen(workdir));
    memcpy(buf + strlen(workdir), "/app.manifest", 14);
    return buf;
}

fn _sgx_write_manifest(workdir, sandbox, command) {
    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);
    var mem = SandboxPolicy_memory_limit_mb(policy);
    if (mem == 0) { mem = 256; }

    var cmd_escaped = oci_json_escape(command);
    var mem_buf[32];
    var mem_len = fmt_int_buf(mem, &mem_buf);

    var buf = alloc(2048 + strlen(cmd_escaped));
    var pos = 0;

    var p1a = "# kavach SGX enclave manifest (auto-generated)\n[libos]\nentrypoint = \"/bin/sh\"\n\n";
    var p1b = "[loader]\nentrypoint = \"file:{{ gramine.libos }}\"\nargv = [\"/bin/sh\", \"-c\", \"";
    memcpy(buf + pos, p1a, strlen(p1a)); pos = pos + strlen(p1a);
    memcpy(buf + pos, p1b, strlen(p1b)); pos = pos + strlen(p1b);
    memcpy(buf + pos, cmd_escaped, strlen(cmd_escaped)); pos = pos + strlen(cmd_escaped);

    var p2a = "\"]\nloader.env.PATH = \"/usr/local/bin:/usr/bin:/bin\"\nloader.env.HOME = \"/tmp\"\n\n";
    var p2b = "[sgx]\nenclave_size = \"";
    memcpy(buf + pos, p2a, strlen(p2a)); pos = pos + strlen(p2a);
    memcpy(buf + pos, p2b, strlen(p2b)); pos = pos + strlen(p2b);
    memcpy(buf + pos, &mem_buf, mem_len); pos = pos + mem_len;

    var p3a = "M\"\nmax_threads = 4\nedmm_enable = false\n\n[fs]\nmounts = [\n";
    var p3b = "  { path = \"/lib\", uri = \"file:{{ gramine.runtimedir() }}\" },\n";
    var p3c = "  { path = \"/usr\", uri = \"file:/usr\" },\n  { path = \"/bin\", uri = \"file:/bin\" },\n";
    var p3d = "  { path = \"/tmp\", uri = \"file:/tmp\", type = \"tmpfs\" },\n]\n\n";
    var p3e = "[[fs.trusted_files]]\nuri = \"file:{{ gramine.libos }}\"\n\n";
    var p3f = "[[fs.trusted_files]]\nuri = \"file:/bin/sh\"\n";
    memcpy(buf + pos, p3a, strlen(p3a)); pos = pos + strlen(p3a);
    memcpy(buf + pos, p3b, strlen(p3b)); pos = pos + strlen(p3b);
    memcpy(buf + pos, p3c, strlen(p3c)); pos = pos + strlen(p3c);
    memcpy(buf + pos, p3d, strlen(p3d)); pos = pos + strlen(p3d);
    memcpy(buf + pos, p3e, strlen(p3e)); pos = pos + strlen(p3e);
    memcpy(buf + pos, p3f, strlen(p3f)); pos = pos + strlen(p3f);
    store8(buf + pos, 0);

    var path = _sgx_manifest_file(workdir);
    # O_EXCL|O_NOFOLLOW write (ADR-005 §C4) — refuses to follow a symlink or
    # clobber a pre-existing file at the manifest path. Paired with the
    # unpredictable mode-0700 workdir, this closes the symlink-TOCTOU window.
    file_write_secure(path, buf, pos);
    return path;
}

fn sgx_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    if (backend_sandbox_nonce_len(sandbox) > 0) {
        return backend_error_result("sgx: the policy requires attestation, and this launcher cannot fetch a quote");
    }
    var gramine = _sgx_gramine_path();
    if (gramine == 0) {
        return backend_error_result("gramine-sgx not found in PATH");
    }
    if (_sgx_device_present() == 0) {
        return backend_error_result("SGX device /dev/sgx_enclave not found");
    }

    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    # Unpredictable workdir name (ADR-005 §C3): a predictable
    # /tmp/kavach-sgx-<epoch> let a local attacker pre-create the path (or a
    # symlink at it) before we write. A 16-hex-char random id from
    # /dev/urandom defeats the pre-seed, and mode 0700 + abort-on-EEXIST
    # means a real collision is a hard error, never a silent reuse.
    var rid = rand_hex_id();
    var prefix = "/tmp/kavach-sgx-";
    var workdir = alloc(strlen(prefix) + 17);
    memcpy(workdir, prefix, strlen(prefix));
    memcpy(workdir + strlen(prefix), rid, 16);
    store8(workdir + strlen(prefix) + 16, 0);
    if (kv_mkdir(workdir, 448) < 0) {
        return backend_error_result("failed to create SGX workdir");
    }

    _sgx_write_manifest(workdir, sandbox, command);

    var args = vec_new();
    vec_push(args, gramine);
    vec_push(args, _sgx_manifest_path(workdir));

    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);
    var n = kv_exec_capture(args, out_buf, out_cap);
    var end_ns = mono_now_ns();

    # Cleanup: unlink manifest, rmdir workdir.
    var manifest = _sgx_manifest_file(workdir);
    kv_unlink(manifest);
    kv_rmdir(workdir);

    var r = backend_capture_finish(out_buf, n, out_cap, "gramine-sgx run failed", start_ns, end_ns);
    backend_capture_release(out_buf, out_cap);
    return r;
}

fn sgx_health(sandbox) {
    if (_sgx_gramine_path() == 0) { return 0; }
    if (_sgx_device_present() == 0) { return 0; }
    return 1;
}

fn sgx_destroy(sandbox) { return 0; }

fn backend_sgx_register() {
    backend_register_exec(KavachBackend.SGX, &sgx_exec);
    backend_register_health(KavachBackend.SGX, &sgx_health);
    backend_register_destroy(KavachBackend.SGX, &sgx_destroy);
    return 0;
}

# --- backend_sev.cyr ---

# kavach — AMD SEV-SNP backend (encrypted VM via QEMU)
# Ported from rust-old/src/backend/sev/mod.rs
#
# Launches a QEMU-KVM VM with SEV-SNP enabled. The command is expected to
# be a guest-kernel path (bzImage) passed via -kernel. The guest agent
# inside the image is responsible for running the actual workload.
#
# Deferred vs Rust:
#   - Attestation report fetching (SevAttestationReport) — needs sigil EAR
#   - Guest policy bit flags (SevGuestPolicy) — fold into v3.0 sigil
#     attestation helpers
#   - Live snapshots / migration

fn _sev_qemu_path() {
    if (kavach_path_exists("/usr/local/bin/qemu-system-x86_64") == 1) { return "/usr/local/bin/qemu-system-x86_64"; }
    if (kavach_path_exists("/usr/bin/qemu-system-x86_64") == 1) { return "/usr/bin/qemu-system-x86_64"; }
    return 0;
}

fn _sev_device_present() {
    return kavach_path_exists("/dev/sev");
}

fn sev_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    var qemu = _sev_qemu_path();
    if (qemu == 0) {
        return backend_error_result("qemu-system-x86_64 not found in PATH");
    }
    if (_sev_device_present() == 0) {
        return backend_error_result("SEV device /dev/sev not found");
    }

    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);

    var args = vec_new();
    vec_push(args, qemu);
    vec_push(args, "-machine");
    vec_push(args, "q35,confidential-guest-support=sev0");
    vec_push(args, "-object");
    vec_push(args, "sev-snp-guest,id=sev0,cbitpos=51,reduced-phys-bits=1");
    vec_push(args, "-cpu");
    vec_push(args, "EPYC-v4");

    var mem = SandboxPolicy_memory_limit_mb(policy);
    if (mem == 0) { mem = 512; }
    var mem_buf[32];
    var mem_len = fmt_int_buf(mem, &mem_buf);
    var mem_str = alloc(mem_len + 2);
    memcpy(mem_str, &mem_buf, mem_len);
    memcpy(mem_str + mem_len, "M", 2);
    vec_push(args, "-m");
    vec_push(args, mem_str);

    vec_push(args, "-nographic");
    vec_push(args, "-serial");
    vec_push(args, "stdio");
    vec_push(args, "-kernel");
    vec_push(args, command);

    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);
    var n = kv_exec_capture(args, out_buf, out_cap);
    var end_ns = mono_now_ns();

    var r = backend_capture_finish(out_buf, n, out_cap, "qemu SEV run failed", start_ns, end_ns);
    backend_capture_release(out_buf, out_cap);
    return r;
}

fn sev_health(sandbox) {
    if (_sev_qemu_path() == 0) { return 0; }
    if (_sev_device_present() == 0) { return 0; }
    return 1;
}

fn sev_destroy(sandbox) { return 0; }

fn backend_sev_register() {
    backend_register_exec(KavachBackend.SEV, &sev_exec);
    backend_register_health(KavachBackend.SEV, &sev_health);
    backend_register_destroy(KavachBackend.SEV, &sev_destroy);
    return 0;
}

# --- backend_tdx.cyr ---

# kavach — Intel TDX backend (Trust Domain Extensions via QEMU)
# Skeleton port — no dedicated Rust tdx/ module existed in v1.x; this
# backend shares the QEMU code path with SEV, differentiated by guest
# object + CPU flags. Command is a guest-kernel path (bzImage).
#
# Deferred: quote fetch. kavach verifies TDX quotes since 3.13.0
# (`kavach_attest_tdx_quote`), but this launcher cannot get one out of the
# guest. It is not shown to boot one either: it passes no TDVF firmware, and it
# (like `backend_is_available`) looks for /dev/tdx_guest, the device inside a TD
# (the tdx-guest driver), so a TDX host reports the backend unavailable. That
# check stays until the launch is shown to boot. A policy that requires
# attestation is refused here, before anything runs.

fn _tdx_qemu_path() {
    if (kavach_path_exists("/usr/local/bin/qemu-system-x86_64") == 1) { return "/usr/local/bin/qemu-system-x86_64"; }
    if (kavach_path_exists("/usr/bin/qemu-system-x86_64") == 1) { return "/usr/bin/qemu-system-x86_64"; }
    return 0;
}

fn _tdx_device_present() {
    return kavach_path_exists("/dev/tdx_guest");
}

fn tdx_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    if (backend_sandbox_nonce_len(sandbox) > 0) {
        return backend_error_result("tdx: the policy requires attestation, and this launcher cannot fetch a quote");
    }
    var qemu = _tdx_qemu_path();
    if (qemu == 0) {
        return backend_error_result("qemu-system-x86_64 not found in PATH");
    }
    if (_tdx_device_present() == 0) {
        return backend_error_result("TDX device /dev/tdx_guest not found");
    }

    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);

    var args = vec_new();
    vec_push(args, qemu);
    vec_push(args, "-machine");
    vec_push(args, "q35,kernel_irqchip=split,confidential-guest-support=tdx0");
    vec_push(args, "-object");
    vec_push(args, "tdx-guest,id=tdx0,sept-ve-disable=off");
    vec_push(args, "-cpu");
    vec_push(args, "host,-kvm-steal-time,pmu=off");

    var mem = SandboxPolicy_memory_limit_mb(policy);
    if (mem == 0) { mem = 512; }
    var mem_buf[32];
    var mem_len = fmt_int_buf(mem, &mem_buf);
    var mem_str = alloc(mem_len + 2);
    memcpy(mem_str, &mem_buf, mem_len);
    memcpy(mem_str + mem_len, "M", 2);
    vec_push(args, "-m");
    vec_push(args, mem_str);

    vec_push(args, "-nographic");
    vec_push(args, "-serial");
    vec_push(args, "stdio");
    vec_push(args, "-kernel");
    vec_push(args, command);

    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);
    var n = kv_exec_capture(args, out_buf, out_cap);
    var end_ns = mono_now_ns();

    var r = backend_capture_finish(out_buf, n, out_cap, "qemu TDX run failed", start_ns, end_ns);
    backend_capture_release(out_buf, out_cap);
    return r;
}

fn tdx_health(sandbox) {
    if (_tdx_qemu_path() == 0) { return 0; }
    if (_tdx_device_present() == 0) { return 0; }
    return 1;
}

fn tdx_destroy(sandbox) { return 0; }

fn backend_tdx_register() {
    backend_register_exec(KavachBackend.TDX, &tdx_exec);
    backend_register_health(KavachBackend.TDX, &tdx_health);
    backend_register_destroy(KavachBackend.TDX, &tdx_destroy);
    return 0;
}

# --- backend_firecracker.cyr ---

# kavach — Firecracker (microVM) backend
# Ported from rust-old/src/backend/firecracker/{mod,config,network,vsock,snapshot}.rs
#
# Generates a minimal Firecracker VM config.json and boots a microVM via
# `firecracker --no-api --config-file <path>`. The `command` argument is
# interpreted as the path to a guest kernel image (bzImage); the rootfs is
# not wired here — callers staging a rootfs drive should extend the
# generated config and re-run.
#
# Deferred vs Rust:
#   - jailer wrapping — v3.1; needs uid/gid/cgroup plumbing
#   - vsock + snapshot + network/TAP — require networking syscalls
#     that aren't yet in the kavach stdlib surface
#   - `--log-path` wiring — replaced with /dev/null for v3.0

fn _fc_binary_path() {
    if (kavach_path_exists("/usr/local/bin/firecracker") == 1) { return "/usr/local/bin/firecracker"; }
    if (kavach_path_exists("/usr/bin/firecracker") == 1) { return "/usr/bin/firecracker"; }
    return 0;
}

# Generate a minimal Firecracker VM config JSON. The kernel path is the
# caller-supplied `command`. Memory and vCPU come from SandboxPolicy.
fn _fc_generate_config(sandbox, kernel_path) {
    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);

    var mem = SandboxPolicy_memory_limit_mb(policy);
    if (mem == 0) { mem = 128; }

    # cpu_limit_tenths: 10 = 1 vCPU, 20 = 2 vCPU, etc.
    var vcpu = SandboxPolicy_cpu_limit_tenths(policy) / 10;
    if (vcpu < 1) { vcpu = 1; }

    var kernel_escaped = oci_json_escape(kernel_path);
    var mem_buf[24];
    var mem_len = fmt_int_buf(mem, &mem_buf);
    var vcpu_buf[24];
    var vcpu_len = fmt_int_buf(vcpu, &vcpu_buf);

    var buf = alloc(1024 + strlen(kernel_escaped));
    var pos = 0;
    var p1 = "{\"boot-source\":{\"kernel_image_path\":\"";
    memcpy(buf + pos, p1, strlen(p1)); pos = pos + strlen(p1);
    memcpy(buf + pos, kernel_escaped, strlen(kernel_escaped)); pos = pos + strlen(kernel_escaped);

    var p2 = "\",\"boot_args\":\"console=ttyS0 reboot=k panic=1 pci=off\"},\"machine-config\":{\"vcpu_count\":";
    memcpy(buf + pos, p2, strlen(p2)); pos = pos + strlen(p2);
    memcpy(buf + pos, &vcpu_buf, vcpu_len); pos = pos + vcpu_len;

    var p3 = ",\"mem_size_mib\":";
    memcpy(buf + pos, p3, strlen(p3)); pos = pos + strlen(p3);
    memcpy(buf + pos, &mem_buf, mem_len); pos = pos + mem_len;

    var p4 = ",\"smt\":false},\"drives\":[]}";
    memcpy(buf + pos, p4, strlen(p4)); pos = pos + strlen(p4);
    store8(buf + pos, 0);
    return buf;
}

fn firecracker_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    var fc = _fc_binary_path();
    if (fc == 0) {
        return backend_error_result("firecracker not found in PATH");
    }

    # 3.12.1: a rootfs'd sandbox is a container — its command resolves inside
    # the image, so the host-interpreter blocklist does not apply. See
    # `runtime_guard_config_for_rootfs`.
    var guard_cfg = runtime_guard_config_for_rootfs(
      SandboxConfig_rootfs(Sandbox_config(sandbox)));
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    if (kavach_path_exists(command) == 0) {
        return backend_error_result("kernel image not found");
    }

    # Prepare workdir and config file. Unpredictable random name + mode 0700
    # + abort-on-EEXIST defeats the /tmp symlink-preseed vector that a
    # predictable /tmp/kavach-fc-<epoch> exposed (ADR-005 §C3).
    var rid = rand_hex_id();
    var prefix = "/tmp/kavach-fc-";
    var workdir = alloc(strlen(prefix) + 17);
    memcpy(workdir, prefix, strlen(prefix));
    memcpy(workdir + strlen(prefix), rid, 16);
    store8(workdir + strlen(prefix) + 16, 0);
    if (kv_mkdir(workdir, 448) < 0) {
        return backend_error_result("failed to create firecracker workdir");
    }

    var cfg_path = alloc(strlen(workdir) + 16);
    memcpy(cfg_path, workdir, strlen(workdir));
    memcpy(cfg_path + strlen(workdir), "/config.json", 13);

    var cfg_json = _fc_generate_config(sandbox, command);
    # O_EXCL|O_NOFOLLOW write (ADR-005 §C4) — no symlink-follow, no clobber.
    file_write_secure(cfg_path, cfg_json, strlen(cfg_json));

    var args = vec_new();
    vec_push(args, fc);
    vec_push(args, "--no-api");
    vec_push(args, "--config-file");
    vec_push(args, cfg_path);
    vec_push(args, "--log-path");
    vec_push(args, "/dev/null");
    vec_push(args, "--level");
    vec_push(args, "Warning");

    var out_cap = 1048576;
    var out_buf = backend_capture_buf(out_cap);
    var n = kv_exec_capture(args, out_buf, out_cap);
    var end_ns = mono_now_ns();

    # Cleanup workdir
    kv_unlink(cfg_path);
    kv_rmdir(workdir);

    var r = backend_capture_finish(out_buf, n, out_cap, "firecracker run failed", start_ns, end_ns);
    backend_capture_release(out_buf, out_cap);
    return r;
}

fn firecracker_health(sandbox) {
    if (_fc_binary_path() == 0) { return 0; }
    return 1;
}

fn firecracker_destroy(sandbox) { return 0; }

fn backend_firecracker_register() {
    backend_register_exec(KavachBackend.FIRECRACKER, &firecracker_exec);
    backend_register_health(KavachBackend.FIRECRACKER, &firecracker_health);
    backend_register_destroy(KavachBackend.FIRECRACKER, &firecracker_destroy);
    return 0;
}

# --- composite.cyr ---

# kavach — composite backend (defense-in-depth policy layering)
# Ported from rust-old/src/backend/composite.rs
#
# Merges an outer backend (runtime boundary) with an inner policy layer.
# The outer's exec dispatches as usual; the caller's policy is merged
# with the inner's policy before the call, taking the stricter side per
# field. The landlock rules are the exception: they are a union.
#
# Merge rules:
#   seccomp_enabled        OR  of the two sides
#   seccomp_profile        "strict" wins over "basic" wins over None
#   network_enabled        AND (both must allow)
#   network_tcp_* ports    both must allow (3.14.8): see _merge_tcp_ports
#   read_only_rootfs       OR  (either enforces)
#   landlock rules         union, in a fresh list; deny-all if either is
#   landlock_abstract_unix OR
#   landlock_signal        OR
#   memory_limit_mb        min (stricter is smaller; 0 = unset)
#   cpu_limit_tenths       min (0 = unset)
#   max_pids               min (0 = unset)
#   tcp_bind_len           max (more restriction signal)
#   tcp_connect_len        max

fn _stricter_profile(a, b) {
    # a and b are cstr or 0.
    if (a == 0) { return b; }
    if (b == 0) { return a; }
    if (streq(a, "strict") == 1) { return a; }
    if (streq(b, "strict") == 1) { return b; }
    return a;
}

fn _min_nz(a, b) {
    if (a == 0) { return b; }
    if (b == 0) { return a; }
    if (a < b) { return a; }
    return b;
}

fn _max(a, b) {
    if (a > b) { return a; }
    return b;
}

fn _or_bool(a, b) {
    if (a == 1) { return 1; }
    if (b == 1) { return 1; }
    return 0;
}

fn _and_bool(a, b) {
    if (a == 1) { if (b == 1) { return 1; } }
    return 0;
}

# Merge two policies into a fresh SandboxPolicy pointer.
# Neither input is mutated.
fn merge_policies(base, overlay) {
    var out = policy_new();
    SandboxPolicy_set_seccomp_enabled(out,
      _or_bool(SandboxPolicy_seccomp_enabled(base),
        SandboxPolicy_seccomp_enabled(overlay)));
    SandboxPolicy_set_seccomp_profile(out,
      _stricter_profile(SandboxPolicy_seccomp_profile(base),
        SandboxPolicy_seccomp_profile(overlay)));

    # Network: both must enable. Default disabled wins.
    SandboxPolicy_set_network_enabled(out,
      _and_bool(SandboxPolicy_network_enabled(base),
        SandboxPolicy_network_enabled(overlay)));

    SandboxPolicy_set_read_only_rootfs(out,
      _or_bool(SandboxPolicy_read_only_rootfs(base),
        SandboxPolicy_read_only_rootfs(overlay)));

    _merge_landlock(out, base, overlay);

    SandboxPolicy_set_landlock_abstract_unix(out,
      _or_bool(SandboxPolicy_landlock_abstract_unix(base),
        SandboxPolicy_landlock_abstract_unix(overlay)));
    SandboxPolicy_set_landlock_signal(out,
      _or_bool(SandboxPolicy_landlock_signal(base),
        SandboxPolicy_landlock_signal(overlay)));

    SandboxPolicy_set_memory_limit_mb(out,
      _min_nz(SandboxPolicy_memory_limit_mb(base),
        SandboxPolicy_memory_limit_mb(overlay)));
    SandboxPolicy_set_cpu_limit_tenths(out,
      _min_nz(SandboxPolicy_cpu_limit_tenths(base),
        SandboxPolicy_cpu_limit_tenths(overlay)));
    SandboxPolicy_set_max_pids(out,
      _min_nz(SandboxPolicy_max_pids(base),
        SandboxPolicy_max_pids(overlay)));

    _merge_tcp_ports(out, base, overlay);
    _merge_attestation(out, base, overlay);
    return out;
}

# TCP ports (3.14.8). The network is merged as both must allow it, so a port is
# too: a side allowing network restricts nothing and the other side's list stands;
# two sides denying it leave the ports both name. A side denying network with no
# list allows no port, so leaves none. Merged lists are fresh, as landlock's are,
# and the counts follow them. Through 3.14.7 the counts, which had no list, were
# merged as their maximum.
fn _merge_tcp_ports(out, base, overlay) {
    var bo = SandboxPolicy_network_enabled(base);
    var oo = SandboxPolicy_network_enabled(overlay);
    if (bo == 1 && oo == 1) { return 0; }
    var bind = 0;
    var conn = 0;
    if (bo == 1) {
        bind = _ports_copy(SandboxPolicy_network_tcp_bind(overlay));
        conn = _ports_copy(SandboxPolicy_network_tcp_connect(overlay));
    } elif (oo == 1) {
        bind = _ports_copy(SandboxPolicy_network_tcp_bind(base));
        conn = _ports_copy(SandboxPolicy_network_tcp_connect(base));
    } else {
        bind = _ports_both(SandboxPolicy_network_tcp_bind(base), SandboxPolicy_network_tcp_bind(overlay));
        conn = _ports_both(SandboxPolicy_network_tcp_connect(base), SandboxPolicy_network_tcp_connect(overlay));
    }
    SandboxPolicy_set_network_tcp_bind(out, bind);
    SandboxPolicy_set_network_tcp_connect(out, conn);
    var bl = 0;
    if (bind != 0) { bl = vec_len(bind); }
    var cl = 0;
    if (conn != 0) { cl = vec_len(conn); }
    SandboxPolicy_set_network_tcp_bind_len(out, bl);
    SandboxPolicy_set_network_tcp_connect_len(out, cl);
    return 0;
}

# A fresh copy of a port list, or 0 for none.
fn _ports_copy(v) {
    if (v == 0) { return 0; }
    var out = vec_new();
    var i = 0;
    while (i < vec_len(v)) {
        vec_push(out, vec_get(v, i));
        i = i + 1;
    }
    return out;
}

# The ports in both lists, as a fresh list, or 0 when that is none.
fn _ports_both(a, b) {
    if (a == 0 || b == 0) { return 0; }
    var out = vec_new();
    var i = 0;
    while (i < vec_len(a)) {
        var port = vec_get(a, i);
        if (_policy_port_in(b, port) == 1) { vec_push(out, port); }
        i = i + 1;
    }
    if (vec_len(out) == 0) { return 0; }
    return out;
}

# Landlock. The merged list holds both inputs' rules, so a path either side's
# rules allow stays allowed: landlock names allowed paths, not denied ones, and
# each layer may need paths of its own. A side with no rules adds none. The
# rules go into a fresh list, because sharing an input's would let a later
# `policy_landlock_add` on either policy change the other. Each input
# contributes the rules it applies, its first `landlock_rules_len`, the bound
# `security_apply_landlock` walks to.
#
# A deny-all input (`policy_landlock_is_deny_all`) makes the merge deny-all:
# that side has said the payload gets no path, and the other side's rules would
# hand it some. The child's landlock step asks the same predicate, so a policy
# that denies every path on its own denies every path merged.
#
# From 3.11.3, when `confine_child` began applying the list, through 3.13.0, the
# counts were summed and no list was carried. A count over no list is deny-all,
# so any merge with a rule on either side denied the payload every path,
# `/bin/cat` included.
fn _merge_landlock(out, base, overlay) {
    if (policy_landlock_is_deny_all(base) == 1 || policy_landlock_is_deny_all(overlay) == 1) {
        return policy_landlock_deny_all(out);
    }
    var a = SandboxPolicy_landlock_rules_len(base);
    var b = SandboxPolicy_landlock_rules_len(overlay);
    if (a <= 0 && b <= 0) { return 0; }
    var list = vec_new();
    _landlock_append(list, base, a);
    _landlock_append(list, overlay, b);
    SandboxPolicy_set_landlock_rules(out, list);
    SandboxPolicy_set_landlock_rules_len(out, vec_len(list));
    return 0;
}

# Append the first `n` of `p`'s rules to `list`. `p` is not deny-all, so its
# list holds at least `n`.
fn _landlock_append(list, p, n) {
    var from = SandboxPolicy_landlock_rules(p);
    var i = 0;
    while (i < n) {
        vec_push(list, vec_get(from, i));
        i = i + 1;
    }
    return 0;
}

fn _attest_same_root(a, b) {
    var n = SandboxPolicy_attest_root_len(a);
    if (n != SandboxPolicy_attest_root_len(b)) { return 0; }
    return memeq(SandboxPolicy_attest_root(a), SandboxPolicy_attest_root(b), n);
}

# Attestation (3.13.0). The merged policy requires attestation if either input
# does, and admits only a guest both would. When both do, the allowlists are
# intersected and debug is allowed only if both allow it. Two different roots
# admit no quote in common, since a quote chains to one root, and two allowlists
# may share no measurement. In either case the merged list holds one entry that
# matches no measurement: the policy still requires attestation, and every
# attempt fails. An empty list would instead stop requiring it.
fn _merge_attestation(out, base, overlay) {
    var a = policy_wants_attestation(base);
    var b = policy_wants_attestation(overlay);
    if (a == 0 && b == 0) { return 0; }
    var src = base;
    if (a == 0) { src = overlay; }
    var from = SandboxPolicy_attest_measurements(src);
    var list = vec_new();
    var i = 0;
    while (i < vec_len(from)) {
        var m = vec_get(from, i);
        if (a == 0 || b == 0 || _attest_listed(overlay, m) == 1) { vec_push(list, m); }
        i = i + 1;
    }
    var debug = SandboxPolicy_attest_allow_debug(src);
    if (a == 1 && b == 1) {
        if (_attest_same_root(base, overlay) == 0) { list = vec_new(); }
        debug = _and_bool(debug, SandboxPolicy_attest_allow_debug(overlay));
    }
    if (vec_len(list) == 0) { vec_push(list, "none"); }
    SandboxPolicy_set_attest_measurements(out, list);
    SandboxPolicy_set_attest_root(out, SandboxPolicy_attest_root(src));
    SandboxPolicy_set_attest_root_len(out, SandboxPolicy_attest_root_len(src));
    SandboxPolicy_set_attest_allow_debug(out, debug);
    # 3.14.2. The RTMR allowlists merge as the measurements do: when both
    # require attestation, an index either pins is pinned, to the values both
    # allow. The accepted TCB statuses are the ones both accept. The collateral
    # is the source policy's, or the other's when it has none: any genuine copy
    # describes the same platforms, and a quote must pass it.
    var accept = SandboxPolicy_attest_tcb_accept(src);
    var coll = SandboxPolicy_attest_collateral(src);
    var lists = alloc(32);
    memset(lists, 0, 32);
    var k = 0;
    while (k < 4) {
        var mine = policy_attest_rtmr_list(src, k);
        var theirs = 0;
        if (a == 1 && b == 1) { theirs = policy_attest_rtmr_list(overlay, k); }
        var r = vec_new();
        if (mine != 0) {
            var j = 0;
            while (j < vec_len(mine)) {
                var v = vec_get(mine, j);
                if (theirs == 0 || _merge_listed(theirs, v) == 1) { vec_push(r, v); }
                j = j + 1;
            }
            if (vec_len(r) == 0) { vec_push(r, "none"); }
        } else {
            if (theirs != 0) { _merge_copy_list(r, theirs); }
        }
        if (vec_len(r) > 0) { store64(lists + k * 8, r); }
        k = k + 1;
    }
    if (a == 1 && b == 1) {
        accept = accept & SandboxPolicy_attest_tcb_accept(overlay);
        if (coll == 0) { coll = SandboxPolicy_attest_collateral(overlay); }
    }
    SandboxPolicy_set_attest_rtmrs(out, lists);
    SandboxPolicy_set_attest_tcb_accept(out, accept);
    SandboxPolicy_set_attest_collateral(out, coll);
    return 0;
}

fn _merge_listed(list, v) {
    var i = 0;
    while (i < vec_len(list)) {
        if (streq(vec_get(list, i), v) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _merge_copy_list(dst, src) {
    var i = 0;
    while (i < vec_len(src)) {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    return 0;
}

# Score a composite = max(outer_base, inner_base) + 5, clamped to 100.
# The +5 reflects the layering bonus (both runtime boundary AND policy
# enforcement, which is additive defense).
fn score_composite(outer, inner, policy) {
    var a = base_score(outer);
    var b = base_score(inner);
    var base = a;
    if (b > a) { base = b; }
    var policy_score = score_backend(outer, policy) - base_score(outer);
    var composite = base + policy_score + 5;
    if (composite > 100) { composite = 100; }
    if (composite < 0) { composite = 0; }
    return composite;
}

# Dispatcher wrapper: execute via `outer` backend with the merged policy.
# Caller passes the outer+inner backend ids separately from the sandbox
# so the Sandbox struct layout stays v2.0-compatible.
#
# Typical flow:
#   var merged_policy = merge_policies(caller_policy, inner_policy);
#   # swap policy on config for the dispatch, preserving the original
#   SandboxConfig_set_policy(config, merged_policy);
#   var result = backend_dispatch_exec_as(outer_backend, sandbox, cmd);
#
# Refuses a policy that requires attestation (3.13.0): this path dispatches
# straight to the backend, past `sandbox_exec`'s attestation gate, so nothing
# would check the guest's quote.
fn composite_exec(outer_backend, inner_backend, sandbox, command, inner_policy) {
    var config = Sandbox_config(sandbox);
    var caller_policy = SandboxConfig_policy(config);
    if (policy_wants_attestation(caller_policy) == 1 || policy_wants_attestation(inner_policy) == 1) {
        kavach_err_print(KAVACH_ERR_POLICY_VIOLATION, "attestation required; composite_exec does not verify quotes");
        return 0;
    }
    var merged = merge_policies(caller_policy, inner_policy);
    var saved = caller_policy;
    SandboxConfig_set_policy(config, merged);
    SandboxConfig_set_backend(config, outer_backend);
    var result = backend_dispatch_exec(sandbox, command);
    SandboxConfig_set_policy(config, saved);
    return result;
}

# --- observability.cyr ---

# kavach — observability types (health, metrics, spawn handle)
# Ported from rust-old/src/backend/{health,metrics,exec_util}.rs.
#
# These are the public data types consumers of kavach use to observe
# sandbox state. Population of the fields is backend-specific; the v2.0
# process/gvisor/oci/wasm backends expose health via the dispatch table
# and leave metrics as a zeroed struct (real collection lives alongside
# cgroup v2 readers — see roadmap v3.0 blocked items).

# ---- HealthStatus --------------------------------------------------------

enum HealthState {
    HEALTHY = 0;
    DEGRADED = 1;
    UNHEALTHY = 2;
    UNKNOWN = 3;
}

fn health_state_name(s) {
    if (s == HealthState.HEALTHY) { return "healthy"; }
    if (s == HealthState.DEGRADED) { return "degraded"; }
    if (s == HealthState.UNHEALTHY) { return "unhealthy"; }
    return "unknown";
}

#derive(accessors)
struct HealthStatus {
    state;
    last_check_at;
    detail;
}

fn health_status_new(state, detail) {
    var h = alloc(24);
    HealthStatus_set_state(h, state);
    HealthStatus_set_last_check_at(h, clock_epoch_secs());
    HealthStatus_set_detail(h, detail);
    return h;
}

# Probe a sandbox's backend via the dispatch table and report a status.
fn health_probe(sandbox) {
    var ok = backend_dispatch_health(sandbox);
    if (ok == 1) {
        return health_status_new(HealthState.HEALTHY, "ok");
    }
    return health_status_new(HealthState.UNHEALTHY, "backend health check failed");
}

# ---- SandboxMetrics ------------------------------------------------------
# Resource-usage snapshot. Populated by cgroup v2 readers once those
# syscalls land in the Cyrius stdlib; until then the struct is available
# for API compatibility with zeroed fields.

#derive(accessors)
struct SandboxMetrics {
    cpu_time_ns;
    memory_bytes_peak;
    memory_bytes_current;
    pid_count;
    io_read_bytes;
    io_write_bytes;
    wall_duration_ms;
}

var SANDBOX_METRICS_SIZE = 56;

fn sandbox_metrics_new() {
    var m = alloc(SANDBOX_METRICS_SIZE);
    var i = 0;
    while (i < SANDBOX_METRICS_SIZE) { store64(m + i, 0); i = i + 8; }
    return m;
}

# Populate metrics from an ExecResult's wall clock. CPU/memory/PID/IO
# fields remain 0 until cgroup-backed collectors ship (v3.0 blocked item).
fn sandbox_metrics_from_result(result) {
    var m = sandbox_metrics_new();
    SandboxMetrics_set_wall_duration_ms(m, ExecResult_duration_ms(result));
    return m;
}

# (A second `struct SpawnedProcess` {pid, backend, started_at} and its
# `spawned_process_new` lived here until 3.12.9. Nothing called them, and the
# struct shadowed spawn.cyr's real `SpawnedProcess`, the `sandbox_spawn`
# handle: both generated `SpawnedProcess_pid`, kavach's one internal
# `duplicate fn`.)

# --- attest_collateral.cyr ---

# kavach — Intel DCAP collateral: the platform's TCB level, the Quoting
# Enclave's identity, and revocation (3.14.2)
#
# A quote that verifies to Intel's root (sigil, `*_quote_verify_full_into`)
# shows that a genuine platform made it. It does not show that the platform is
# current: a platform whose microcode or TDX module Intel has since found
# vulnerable, or whose PCK key Intel has revoked, still signs quotes that
# verify. Intel publishes what decides that as collateral, signed by its TCB
# Signing key, which chains to the same root:
#
#   * TCB info (v3): for the platform's FMSPC, the TCB levels in order, each
#     a set of SVNs and a status (UpToDate, OutOfDate, Revoked, ...). For TDX
#     also the TDX module identities.
#   * QE identity (v2): what the Quoting Enclave must be (MRSIGNER, ISVPRODID,
#     masked MISCSELECT and ATTRIBUTES) and its TCB levels by ISVSVN.
#   * The PCK CRL, issued by the PCK CA that issued the quote's PCK
#     certificate, and the root CA CRL, issued by the root.
#
# `kavach_collateral_check` evaluates them, after the quote has verified, in
# the order of Intel's Quote Verification Library (QVL) and google/go-tdx-guest
# `verify`: the TCB Signing certificate chains to the policy's root and is not
# revoked; it signed the TCB info and the QE identity, both current at `now`;
# both CRLs are signed by their issuers and current; neither the PCK
# certificate nor its CA is revoked; the PCK certificate's FMSPC and PCE-ID
# are the TCB info's; the platform's SVNs select a TCB level (for TDX, the
# TEE_TCB_SVN too, and the TDX module's identity); the QE report matches the QE
# identity and its ISVSVN selects a QE TCB level. Every status must be one the
# policy accepts (`policy_attest_accept_tcb`; UpToDate only by default).
# Revoked is never accepted.
#
# The collateral is the caller's to fetch: from Intel's PCS
# (api.trustedservices.intel.com, `/sgx/certification/v4/tcb`, `/qe/identity`,
# `/pckcrl`, and `/tdx/certification/v4/...` for TDX) or a PCCS cache, exactly
# as served. kavach makes no network call.
#
# Formats: Intel PCS API v4; Intel SGX PCK Certificate and CRL Profile (the
# SGX extension, OID 1.2.840.113741.1.13.1). See docs/sources.md.

#derive(accessors)
struct AttestCollateral {
    tcb_info;
    tcb_info_len;
    qe_identity;
    qe_identity_len;
    signer_chain;
    signer_chain_len;
    pck_crl;
    pck_crl_len;
    root_crl;
    root_crl_len;
}

var ATTEST_COLLATERAL_SIZE = 80;

# A TCB status, as one bit, so a policy can accept a set of them. Prefixed, as
# every kavach enum member is: cyrius hoists members to global names.
enum KavachTcbStatus {
    KAVACH_TCB_UP_TO_DATE = 1;
    KAVACH_TCB_SW_HARDENING_NEEDED = 2;
    KAVACH_TCB_CONFIGURATION_NEEDED = 4;
    KAVACH_TCB_CONFIGURATION_AND_SW_HARDENING_NEEDED = 8;
    KAVACH_TCB_OUT_OF_DATE = 16;
    KAVACH_TCB_OUT_OF_DATE_CONFIGURATION_NEEDED = 32;
    KAVACH_TCB_REVOKED = 64;
}

fn kavach_tcb_status_name(s) {
    if (s == KAVACH_TCB_UP_TO_DATE) { return "UpToDate"; }
    if (s == KAVACH_TCB_SW_HARDENING_NEEDED) { return "SWHardeningNeeded"; }
    if (s == KAVACH_TCB_CONFIGURATION_NEEDED) { return "ConfigurationNeeded"; }
    if (s == KAVACH_TCB_CONFIGURATION_AND_SW_HARDENING_NEEDED) { return "ConfigurationAndSWHardeningNeeded"; }
    if (s == KAVACH_TCB_OUT_OF_DATE) { return "OutOfDate"; }
    if (s == KAVACH_TCB_OUT_OF_DATE_CONFIGURATION_NEEDED) { return "OutOfDateConfigurationNeeded"; }
    if (s == KAVACH_TCB_REVOKED) { return "Revoked"; }
    return "unknown";
}

# ---- the collateral as the caller supplies it ------------------------------

fn kavach_collateral_new() {
    var c = alloc(ATTEST_COLLATERAL_SIZE);
    memset(c, 0, ATTEST_COLLATERAL_SIZE);
    return c;
}

fn _kc_copy(src, len) {
    var d = alloc(len);
    memcpy(d, src, len);
    return d;
}

# The TCB info as Intel's PCS serves it: `{"tcbInfo":{...},"signature":"<hex>"}`.
# The bytes are copied. Returns 0, or -1 for an empty body.
fn kavach_collateral_tcb_info(c, body, len) {
    if (c == 0 || body == 0 || len <= 0) { return 0 - 1; }
    AttestCollateral_set_tcb_info(c, _kc_copy(body, len));
    AttestCollateral_set_tcb_info_len(c, len);
    return 0;
}

# The QE identity as served: `{"enclaveIdentity":{...},"signature":"<hex>"}`,
# from `/sgx/.../qe/identity` for SGX quotes and `/tdx/.../qe/identity` (TD_QE)
# for TDX quotes.
fn kavach_collateral_qe_identity(c, body, len) {
    if (c == 0 || body == 0 || len <= 0) { return 0 - 1; }
    AttestCollateral_set_qe_identity(c, _kc_copy(body, len));
    AttestCollateral_set_qe_identity_len(c, len);
    return 0;
}

# The PEM chain PCS sends with both (`TCB-Info-Issuer-Chain`, URL-decoded): the
# TCB Signing certificate, then the root. The root copy is ignored; the chain is
# walked to the policy's root.
fn kavach_collateral_signer_chain(c, pem, len) {
    if (c == 0 || pem == 0 || len <= 0) { return 0 - 1; }
    AttestCollateral_set_signer_chain(c, _kc_copy(pem, len));
    AttestCollateral_set_signer_chain_len(c, len);
    return 0;
}

# The PCK CRL, DER (`/pckcrl?ca=platform|processor&encoding=der`), from the CA
# that issued the quote's PCK certificate.
fn kavach_collateral_pck_crl(c, der, len) {
    if (c == 0 || der == 0 || len <= 0) { return 0 - 1; }
    AttestCollateral_set_pck_crl(c, _kc_copy(der, len));
    AttestCollateral_set_pck_crl_len(c, len);
    return 0;
}

# The root CA CRL, DER (Intel publishes it at
# certificates.trustedservices.intel.com/IntelSGXRootCA.der).
fn kavach_collateral_root_crl(c, der, len) {
    if (c == 0 || der == 0 || len <= 0) { return 0 - 1; }
    AttestCollateral_set_root_crl(c, _kc_copy(der, len));
    AttestCollateral_set_root_crl_len(c, len);
    return 0;
}

# 1 when all five parts are set.
fn kavach_collateral_complete(c) {
    if (c == 0) { return 0; }
    if (AttestCollateral_tcb_info_len(c) <= 0) { return 0; }
    if (AttestCollateral_qe_identity_len(c) <= 0) { return 0; }
    if (AttestCollateral_signer_chain_len(c) <= 0) { return 0; }
    if (AttestCollateral_pck_crl_len(c) <= 0) { return 0; }
    if (AttestCollateral_root_crl_len(c) <= 0) { return 0; }
    return 1;
}

# ---- DER, over a bounded buffer --------------------------------------------
#
# Read the TLV at `pos` in buf[0..end). Writes its content start to out[0] and
# the position after it to out[8]; returns the tag, or -1 when it does not fit.
# Definite lengths of up to 3 bytes only: nothing in a certificate or CRL kavach
# reads is near 16 MiB.
fn _kc_tlv(buf, end, pos, out) {
    if (pos < 0 || pos + 2 > end) { return 0 - 1; }
    var tag = load8(buf + pos) & 255;
    var l = load8(buf + pos + 1) & 255;
    var c = pos + 2;
    if (l >= 128) {
        var nb = l & 127;
        if (nb == 0 || nb > 3) { return 0 - 1; }
        if (c + nb > end) { return 0 - 1; }
        l = 0;
        var i = 0;
        while (i < nb) {
            l = (l << 8) | (load8(buf + c + i) & 255);
            i = i + 1;
        }
        c = c + nb;
    }
    if (c + l > end) { return 0 - 1; }
    store64(out, c);
    store64(out + 8, c + l);
    return tag;
}

# A DER INTEGER's content as an unsigned value up to 0xFFFF; -1 for anything
# negative, empty or larger.
fn _kc_uint(buf, off, len) {
    if (len < 1 || len > 3) { return 0 - 1; }
    if ((load8(buf + off) & 128) != 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < len) {
        v = (v << 8) | (load8(buf + off + i) & 255);
        i = i + 1;
    }
    if (v > 65535) { return 0 - 1; }
    return v;
}

# Days since 1970-01-01 of a proleptic Gregorian date (Howard Hinnant's
# days_from_civil; docs/sources.md).
fn _kc_days(y, m, d) {
    if (m <= 2) { y = y - 1; }
    var era = y / 400;
    if (y < 0) { era = (y - 399) / 400; }
    var yoe = y - era * 400;
    var mp = m + 9;
    if (m > 2) { mp = m - 3; }
    var doy = (153 * mp + 2) / 5 + d - 1;
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

fn _kc_digits(p, n) {
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(p + i) & 255;
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + c - 48;
        i = i + 1;
    }
    return v;
}

# Epoch seconds of y-m-d h:mi:s UTC, or -1 for a field out of range.
fn _kc_epoch(y, mo, d, h, mi, s) {
    if (y < 0 || mo < 0 || d < 0 || h < 0 || mi < 0 || s < 0) { return 0 - 1; }
    if (mo < 1 || mo > 12 || d < 1 || d > 31 || h > 23 || mi > 59 || s > 59) { return 0 - 1; }
    return _kc_days(y, mo, d) * 86400 + h * 3600 + mi * 60 + s;
}

# An X.509 Time (UTCTime "YYMMDDHHMMSSZ", or GeneralizedTime
# "YYYYMMDDHHMMSSZ") as epoch seconds, or -1. UTCTime years 50-99 are 19xx
# (RFC 5280 §4.1.2.5.1).
fn _kc_der_time(buf, tag, off, len) {
    if (tag == 23 && len == 13 && load8(buf + off + 12) == 90) {
        var yy = _kc_digits(buf + off, 2);
        if (yy < 0) { return 0 - 1; }
        if (yy >= 50) { yy = yy + 1900; } else { yy = yy + 2000; }
        return _kc_epoch(yy, _kc_digits(buf + off + 2, 2), _kc_digits(buf + off + 4, 2),
          _kc_digits(buf + off + 6, 2), _kc_digits(buf + off + 8, 2), _kc_digits(buf + off + 10, 2));
    }
    if (tag == 24 && len == 15 && load8(buf + off + 14) == 90) {
        return _kc_epoch(_kc_digits(buf + off, 4), _kc_digits(buf + off + 4, 2), _kc_digits(buf + off + 6, 2),
          _kc_digits(buf + off + 8, 2), _kc_digits(buf + off + 10, 2), _kc_digits(buf + off + 12, 2));
    }
    return 0 - 1;
}

# Where the fields kavach reads sit in a certificate's DER: f[0], f[8] the
# serial's content offset and length; f[16], f[24] the issuer Name's whole TLV;
# f[32], f[40] the subject's; f[48], f[56] the extensions' SEQUENCE content
# (0, 0 when absent). Returns 1, or 0 for a certificate that does not have the
# RFC 5280 shape.
fn _kc_cert_fields(der, len, f) {
    memset(f, 0, 64);
    var t[16];
    if (_kc_tlv(der, len, 0, &t) != 48) { return 0; }
    var cend = load64(&t + 8);
    if (_kc_tlv(der, cend, load64(&t), &t) != 48) { return 0; }
    var tend = load64(&t + 8);
    var pos = load64(&t);
    var tag = _kc_tlv(der, tend, pos, &t);
    if (tag == 160) {
        pos = load64(&t + 8);
        tag = _kc_tlv(der, tend, pos, &t);
    }
    if (tag != 2) { return 0; }
    store64(f, load64(&t));
    store64(f + 8, load64(&t + 8) - load64(&t));
    pos = load64(&t + 8);
    if (_kc_tlv(der, tend, pos, &t) != 48) { return 0; }          # signature algorithm
    pos = load64(&t + 8);
    if (_kc_tlv(der, tend, pos, &t) != 48) { return 0; }          # issuer
    store64(f + 16, pos);
    store64(f + 24, load64(&t + 8) - pos);
    pos = load64(&t + 8);
    if (_kc_tlv(der, tend, pos, &t) != 48) { return 0; }          # validity
    pos = load64(&t + 8);
    if (_kc_tlv(der, tend, pos, &t) != 48) { return 0; }          # subject
    store64(f + 32, pos);
    store64(f + 40, load64(&t + 8) - pos);
    pos = load64(&t + 8);
    if (_kc_tlv(der, tend, pos, &t) != 48) { return 0; }          # subjectPublicKeyInfo
    pos = load64(&t + 8);
    while (pos < tend) {
        tag = _kc_tlv(der, tend, pos, &t);
        if (tag < 0) { return 0; }
        if (tag == 163) {
            var x[16];
            if (_kc_tlv(der, load64(&t + 8), load64(&t), &x) != 48) { return 0; }
            store64(f + 48, load64(&x));
            store64(f + 56, load64(&x + 8));
        }
        pos = load64(&t + 8);
    }
    return 1;
}

fn _kc_self_issued(der, f) {
    if (load64(f + 24) != load64(f + 40)) { return 0; }
    return memeq(der + load64(f + 16), der + load64(f + 32), load64(f + 24));
}

# 1.2.840.113741.1.13.1, the SGX extension, as DER OID content.
var _KC_SGX_OID = "\x2a\x86\x48\x86\xf8\x4d\x01\x0d\x01";
var _KC_SGX_OID_LEN = 9;

# The PCK certificate's TCB, decoded from its SGX extension:
#   +0  FMSPC (6 bytes)    +8  PCE-ID (2 bytes)    +16  the 16 SGX TCB
#   component SVNs (one byte each)    +32  PCESVN    +40  fields found (bits)
var _kc_pck[48];

# Decode one `SEQUENCE { OID <SGX>.<a>[.<b>], value }` from the extension.
# Returns the suffix (a * 256 + b, b = 0 when absent) and leaves the value's
# tag, content offset and end in v[0], v[8], v[16]; -1 for another OID.
fn _kc_sgx_entry(der, pos, end, v) {
    var t[16];
    if (_kc_tlv(der, end, pos, &t) != 48) { return 0 - 1; }
    var send = load64(&t + 8);
    var o[16];
    if (_kc_tlv(der, send, load64(&t), &o) != 6) { return 0 - 1; }
    var ooff = load64(&o);
    var olen = load64(&o + 8) - ooff;
    if (olen < _KC_SGX_OID_LEN + 1 || olen > _KC_SGX_OID_LEN + 2) { return 0 - 1; }
    if (memeq(der + ooff, _KC_SGX_OID, _KC_SGX_OID_LEN) == 0) { return 0 - 1; }
    var a = load8(der + ooff + _KC_SGX_OID_LEN) & 255;
    var b = 0;
    if (olen == _KC_SGX_OID_LEN + 2) { b = load8(der + ooff + _KC_SGX_OID_LEN + 1) & 255; }
    var w[16];
    var tag = _kc_tlv(der, send, load64(&o + 8), &w);
    if (tag < 0) { return 0 - 1; }
    store64(v, tag);
    store64(v + 8, load64(&w));
    store64(v + 16, load64(&w + 8));
    return a * 256 + b;
}

# Fill `_kc_pck` from a PCK certificate. Returns 1 when FMSPC, PCE-ID, all 16
# components and PCESVN were found, 0 otherwise.
fn _kc_pck_tcb(der, len) {
    memset(&_kc_pck, 0, 48);
    var f[64];
    if (_kc_cert_fields(der, len, &f) == 0) { return 0; }
    var pos = load64(&f + 48);
    var xend = load64(&f + 56);
    if (xend == 0) { return 0; }
    var found = 0;
    var t[16];
    while (pos < xend) {
        if (_kc_tlv(der, xend, pos, &t) != 48) { return 0; }
        var eend = load64(&t + 8);
        var o[16];
        if (_kc_tlv(der, eend, load64(&t), &o) != 6) { return 0; }
        var ooff = load64(&o);
        if (load64(&o + 8) - ooff == _KC_SGX_OID_LEN && memeq(der + ooff, _KC_SGX_OID, _KC_SGX_OID_LEN) == 1) {
            var vp = load64(&o + 8);
            var tag = _kc_tlv(der, eend, vp, &o);
            if (tag == 1) {                                  # critical BOOLEAN
                vp = load64(&o + 8);
                tag = _kc_tlv(der, eend, vp, &o);
            }
            if (tag != 4) { return 0; }
            var s[16];
            if (_kc_tlv(der, load64(&o + 8), load64(&o), &s) != 48) { return 0; }
            var p = load64(&s);
            var send = load64(&s + 8);
            var v[24];
            while (p < send) {
                var e[16];
                if (_kc_tlv(der, send, p, &e) != 48) { return 0; }
                var k = _kc_sgx_entry(der, p, send, &v);
                var vtag = load64(&v);
                var voff = load64(&v + 8);
                var vlen = load64(&v + 16) - voff;
                if (k == 4 * 256 && vtag == 4 && vlen == 6) {
                    memcpy(&_kc_pck, der + voff, 6);
                    found = found | 1;
                }
                if (k == 3 * 256 && vtag == 4 && vlen == 2) {
                    memcpy(&_kc_pck + 8, der + voff, 2);
                    found = found | 2;
                }
                if (k == 2 * 256 && vtag == 48) {
                    var q = voff;
                    var qend = load64(&v + 16);
                    var w[24];
                    while (q < qend) {
                        var e2[16];
                        if (_kc_tlv(der, qend, q, &e2) != 48) { return 0; }
                        var c = _kc_sgx_entry(der, q, qend, &w);
                        var ci = c - 2 * 256;
                        var wv = 0 - 1;
                        if (load64(&w) == 2) { wv = _kc_uint(der, load64(&w + 8), load64(&w + 16) - load64(&w + 8)); }
                        if (ci >= 1 && ci <= 16) {
                            if (wv < 0 || wv > 255) { return 0; }
                            store8(&_kc_pck + 16 + ci - 1, wv);
                            found = found | (1 << (ci + 3));
                        }
                        if (ci == 17) {
                            if (wv < 0) { return 0; }
                            store64(&_kc_pck + 32, wv);
                            found = found | 4;
                        }
                        q = load64(&e2 + 8);
                    }
                }
                p = load64(&e + 8);
            }
        }
        pos = eend;
    }
    store64(&_kc_pck + 40, found);
    # FMSPC (bit 0), PCE-ID (1), PCESVN (2) and components 1..16 (bits 4..19).
    if (found != 1048567) { return 0; }
    return 1;
}

# ---- JSON ------------------------------------------------------------------
#
# The signatures cover the bytes of the `tcbInfo` / `enclaveIdentity` member
# exactly as served, so kavach finds that member's span in the raw body, checks
# the signature over it, and evaluates what it parses from those bytes, never
# from the envelope around them.

fn _kc_ws(c) {
    if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; }
    return 0;
}

fn _kc_skip_ws(buf, len, i) {
    while (i < len && _kc_ws(load8(buf + i) & 255) == 1) { i = i + 1; }
    return i;
}

# The end of the JSON string starting at buf[i] == '"' (the index after its
# closing quote), or -1.
fn _kc_json_string_end(buf, len, i) {
    i = i + 1;
    while (i < len) {
        var c = load8(buf + i) & 255;
        if (c == 92) { i = i + 2; }
        else {
            if (c == 34) { return i + 1; }
            i = i + 1;
        }
    }
    return 0 - 1;
}

# The end of the JSON value starting at buf[i], or -1.
fn _kc_json_value_end(buf, len, i) {
    if (i >= len) { return 0 - 1; }
    var c = load8(buf + i) & 255;
    if (c == 34) { return _kc_json_string_end(buf, len, i); }
    if (c == 123 || c == 91) {
        var depth = 0;
        while (i < len) {
            c = load8(buf + i) & 255;
            if (c == 34) {
                i = _kc_json_string_end(buf, len, i);
                if (i < 0) { return 0 - 1; }
            } else {
                if (c == 123 || c == 91) { depth = depth + 1; }
                if (c == 125 || c == 93) {
                    depth = depth - 1;
                    if (depth == 0) { return i + 1; }
                }
                i = i + 1;
            }
        }
        return 0 - 1;
    }
    while (i < len) {
        c = load8(buf + i) & 255;
        if (c == 44 || c == 125 || c == 93 || _kc_ws(c) == 1) { return i; }
        i = i + 1;
    }
    return i;
}

# The span of member `key` of the top-level object in buf[0..len): out[0] its
# value's offset, out[8] its length. Returns 1; 0 when absent, when the key
# appears twice, or when the body is not one object.
fn _kc_json_member(buf, len, key, out) {
    var klen = strlen(key);
    var i = _kc_skip_ws(buf, len, 0);
    if (i >= len || (load8(buf + i) & 255) != 123) { return 0; }
    i = _kc_skip_ws(buf, len, i + 1);
    var hits = 0;
    if (i < len && (load8(buf + i) & 255) == 125) { return 0; }
    while (i < len) {
        if ((load8(buf + i) & 255) != 34) { return 0; }
        var kend = _kc_json_string_end(buf, len, i);
        if (kend < 0) { return 0; }
        var same = 0;
        if (kend - i - 2 == klen) { same = memeq(buf + i + 1, key, klen); }
        i = _kc_skip_ws(buf, len, kend);
        if (i >= len || (load8(buf + i) & 255) != 58) { return 0; }
        i = _kc_skip_ws(buf, len, i + 1);
        var vend = _kc_json_value_end(buf, len, i);
        if (vend < 0) { return 0; }
        if (same == 1) {
            hits = hits + 1;
            store64(out, i);
            store64(out + 8, vend - i);
        }
        i = _kc_skip_ws(buf, len, vend);
        if (i >= len) { return 0; }
        var c = load8(buf + i) & 255;
        if (c == 125) {
            if (_kc_skip_ws(buf, len, i + 1) != len) { return 0; }
            if (hits == 1) { return 1; }
            return 0;
        }
        if (c != 44) { return 0; }
        i = _kc_skip_ws(buf, len, i + 1);
    }
    return 0;
}

# A growable arena for the parsed JSON trees, reset before each check.
var _kc_json_alloc = 0;

fn _kc_json_scratch() {
    if (_kc_json_alloc == 0) {
        _kc_json_alloc = arena_allocator_growable(65536);
    } else {
        reset_via(_kc_json_alloc);
    }
    return _kc_json_alloc;
}

fn _kc_get(obj, key) { return bayan_json_v_obj_get_by_cstr(obj, key); }

# The integer at `obj.key`, or -1 when it is absent, not an integer, or negative.
fn _kc_int(obj, key) {
    var v = _kc_get(obj, key);
    if (v == 0) { return 0 - 1; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return 0 - 1; }
    var n = bayan_json_v_int(v);
    if (n < 0) { return 0 - 1; }
    return n;
}

# 1 when `obj.key` is the string `want`.
fn _kc_is(obj, key, want) {
    var v = _kc_get(obj, key);
    if (v == 0 || bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    var s = bayan_json_v_str(v);
    var n = strlen(want);
    if (str_len(s) != n) { return 0; }
    return memeq(str_data(s), want, n);
}

# Decode `obj.key`, a string of exactly 2n hex digits, into out[0..n). Returns
# 1, or 0.
fn _kc_hex(obj, key, out, n) {
    var v = _kc_get(obj, key);
    if (v == 0 || bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    var s = bayan_json_v_str(v);
    if (str_len(s) != 2 * n) { return 0; }
    return hex_decode_into(str_data(s), 2 * n, out);
}

# `obj.key`, "YYYY-MM-DDTHH:MM:SSZ", as epoch seconds; -1 otherwise.
fn _kc_date(obj, key) {
    var v = _kc_get(obj, key);
    if (v == 0 || bayan_json_v_tag(v) != JTAG_STR) { return 0 - 1; }
    var s = bayan_json_v_str(v);
    if (str_len(s) != 20) { return 0 - 1; }
    var p = str_data(s);
    if (load8(p + 4) != 45 || load8(p + 7) != 45 || load8(p + 10) != 84) { return 0 - 1; }
    if (load8(p + 13) != 58 || load8(p + 16) != 58 || load8(p + 19) != 90) { return 0 - 1; }
    return _kc_epoch(_kc_digits(p, 4), _kc_digits(p + 5, 2), _kc_digits(p + 8, 2),
      _kc_digits(p + 11, 2), _kc_digits(p + 14, 2), _kc_digits(p + 17, 2));
}

fn _kc_status(obj) {
    if (_kc_is(obj, "tcbStatus", "UpToDate") == 1) { return KAVACH_TCB_UP_TO_DATE; }
    if (_kc_is(obj, "tcbStatus", "SWHardeningNeeded") == 1) { return KAVACH_TCB_SW_HARDENING_NEEDED; }
    if (_kc_is(obj, "tcbStatus", "ConfigurationNeeded") == 1) { return KAVACH_TCB_CONFIGURATION_NEEDED; }
    if (_kc_is(obj, "tcbStatus", "ConfigurationAndSWHardeningNeeded") == 1) {
        return KAVACH_TCB_CONFIGURATION_AND_SW_HARDENING_NEEDED;
    }
    if (_kc_is(obj, "tcbStatus", "OutOfDate") == 1) { return KAVACH_TCB_OUT_OF_DATE; }
    if (_kc_is(obj, "tcbStatus", "OutOfDateConfigurationNeeded") == 1) {
        return KAVACH_TCB_OUT_OF_DATE_CONFIGURATION_NEEDED;
    }
    if (_kc_is(obj, "tcbStatus", "Revoked") == 1) { return KAVACH_TCB_REVOKED; }
    return 0;
}

# ---- signatures and certificates -------------------------------------------

# Decode the PEM chain at `pem` and parse its certificates into `arena`:
# certs[8 * i] the parsed X509Cert, ders[16 * i], ders[16 * i + 8] its DER.
# Returns how many (at most 4), or 0.
fn _kc_chain(pem, pem_len, certs, ders, arena) {
    var pool = arena_alloc(arena, pem_len);
    if (pool == 0) { return 0; }
    var n = pem_decode_certs_into(pem, pem_len, ders, 4, pool, pem_len);
    if (n < 1) { return 0; }
    var i = 0;
    while (i < n) {
        var c = x509_cert_alloc_into(arena);
        if (c == 0) { return 0; }
        if (x509_parse_into(load64(ders + i * 16), load64(ders + i * 16 + 8), c, arena) != 1) { return 0; }
        store64(certs + i * 8, c);
        i = i + 1;
    }
    return n;
}

# Check a signed PCS body: find `member`, check `signature` (hex r || s) over
# its bytes with the P-256 key `pk`, and return the parsed member, or 0.
fn _kc_signed_member(body, len, member, pk, ja) {
    var m[16];
    if (_kc_json_member(body, len, member, &m) == 0) { return 0; }
    var s[16];
    if (_kc_json_member(body, len, "signature", &s) == 0) { return 0; }
    if (load64(&s + 8) != 130) { return 0; }
    var sig[64];
    if (hex_decode_into(body + load64(&s) + 1, 128, &sig) == 0) { return 0; }
    if (ecdsa_p256_verify(pk, body + load64(&m), load64(&m + 8), &sig) != 1) { return 0; }
    var v = bayan_json_v_parse_buf_a(ja, body + load64(&m), load64(&m + 8));
    if (v == 0 || bayan_json_v_tag(v) != JTAG_OBJ) { return 0; }
    return v;
}

# Check a CRL issued by the certificate `issuer_der` (whose parsed form is
# `issuer`) at `now`, and whether it lists the serial at ser[0..ser_len) or the
# one at ser2[0..ser2_len) (ser2 0 for none): the root CRL is checked for two
# certificates, and its signature verified once. Returns 0 when it is in force
# and lists neither, "revoked" or "revoked2", or the reason.
fn _kc_crl_verdict(crl, crl_len, issuer, issuer_der, issuer_len, now, ser, ser_len, ser2, ser2_len, what) {
    var t[16];
    if (_kc_tlv(crl, crl_len, 0, &t) != 48) { return "a CRL does not parse"; }
    var cend = load64(&t + 8);
    var tbs = load64(&t);
    if (_kc_tlv(crl, cend, tbs, &t) != 48) { return "a CRL does not parse"; }
    var tbs_end = load64(&t + 8);
    var pos = load64(&t);
    var tag = _kc_tlv(crl, tbs_end, pos, &t);
    if (tag == 2) {                                             # version
        pos = load64(&t + 8);
        tag = _kc_tlv(crl, tbs_end, pos, &t);
    }
    if (tag != 48) { return "a CRL does not parse"; }           # signature algorithm
    pos = load64(&t + 8);
    if (_kc_tlv(crl, tbs_end, pos, &t) != 48) { return "a CRL does not parse"; }
    var iss = pos;
    var iss_len = load64(&t + 8) - pos;
    pos = load64(&t + 8);
    tag = _kc_tlv(crl, tbs_end, pos, &t);
    var this_update = _kc_der_time(crl, tag, load64(&t), load64(&t + 8) - load64(&t));
    pos = load64(&t + 8);
    tag = _kc_tlv(crl, tbs_end, pos, &t);
    var next_update = 0 - 1;
    if (tag == 23 || tag == 24) {
        next_update = _kc_der_time(crl, tag, load64(&t), load64(&t + 8) - load64(&t));
        pos = load64(&t + 8);
        tag = _kc_tlv(crl, tbs_end, pos, &t);
    }
    var rev = 0;
    var rev_end = 0;
    if (tag == 48) {
        rev = load64(&t);
        rev_end = load64(&t + 8);
    }
    # The signature over the TBS, ecdsa-with-SHA256 (1.2.840.10045.4.3.2).
    pos = tbs_end;
    if (_kc_tlv(crl, cend, pos, &t) != 48) { return "a CRL does not parse"; }
    var a[16];
    if (_kc_tlv(crl, load64(&t + 8), load64(&t), &a) != 6) { return "a CRL does not parse"; }
    if (load64(&a + 8) - load64(&a) != 8 || memeq(crl + load64(&a), "\x2a\x86\x48\xce\x3d\x04\x03\x02", 8) == 0) {
        return "a CRL is not signed with ECDSA P-256 and SHA-256";
    }
    pos = load64(&t + 8);
    if (_kc_tlv(crl, cend, pos, &t) != 3) { return "a CRL does not parse"; }
    var sig = load64(&t);
    var sig_len = load64(&t + 8) - sig;
    if (sig_len < 2 || load8(crl + sig) != 0) { return "a CRL does not parse"; }
    var f[64];
    if (_kc_cert_fields(issuer_der, issuer_len, &f) == 0) { return "a CRL issuer does not parse"; }
    if (iss_len != load64(&f + 40) || memeq(crl + iss, issuer_der + load64(&f + 32), iss_len) == 0) {
        return what;
    }
    if (x509_cert_curve(issuer) != X509_CURVE_P256) { return "a CRL issuer's key is not P-256"; }
    if (ecdsa_p256_verify_der(x509_cert_pubkey(issuer), crl + tbs, tbs_end - tbs, crl + sig + 1, sig_len - 1) != 1) {
        return "a CRL's signature does not verify";
    }
    if (this_update < 0 || next_update < 0) { return "a CRL has no validity window"; }
    if (now < this_update || now >= next_update) { return "a CRL is not current"; }
    var p = rev;
    while (p < rev_end) {
        if (_kc_tlv(crl, rev_end, p, &t) != 48) { return "a CRL does not parse"; }
        var e[16];
        if (_kc_tlv(crl, load64(&t + 8), load64(&t), &e) != 2) { return "a CRL does not parse"; }
        var slen = load64(&e + 8) - load64(&e);
        if (slen == ser_len && memeq(crl + load64(&e), ser, ser_len) == 1) { return "revoked"; }
        if (ser2 != 0 && slen == ser2_len && memeq(crl + load64(&e), ser2, ser2_len) == 1) { return "revoked2"; }
        p = load64(&t + 8);
    }
    return 0;
}

# ---- the TCB levels --------------------------------------------------------

# Whether the 16 SVNs of `comps` (a JSON array of {"svn": n}) are each at most
# have[i], from index `from`. -1 for a malformed array.
fn _kc_svns_at_most(comps, have, from) {
    if (comps == 0 || bayan_json_v_tag(comps) != JTAG_ARR || bayan_json_v_arr_len(comps) != 16) { return 0 - 1; }
    var i = from;
    while (i < 16) {
        var svn = _kc_int(bayan_json_v_arr_get(comps, i), "svn");
        if (svn < 0) { return 0 - 1; }
        if ((load8(have + i) & 255) < svn) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The platform's TCB status from `info.tcbLevels`: the first level whose SGX
# components and PCESVN the PCK certificate meets, and for TDX whose TDX
# components the TEE_TCB_SVN meets (from index 2 when the TDX module's major
# version, TEE_TCB_SVN[1], is not 0; those two bytes are the module's, checked
# against its identity). 0 when no level matches, -1 when malformed.
fn _kc_platform_status(info, tdx, tee_tcb_svn) {
    var levels = _kc_get(info, "tcbLevels");
    if (levels == 0 || bayan_json_v_tag(levels) != JTAG_ARR) { return 0 - 1; }
    var n = bayan_json_v_arr_len(levels);
    var i = 0;
    while (i < n) {
        var lv = bayan_json_v_arr_get(levels, i);
        var tcb = _kc_get(lv, "tcb");
        if (tcb == 0) { return 0 - 1; }
        var ok = _kc_svns_at_most(_kc_get(tcb, "sgxtcbcomponents"), &_kc_pck + 16, 0);
        if (ok < 0) { return 0 - 1; }
        var pcesvn = _kc_int(tcb, "pcesvn");
        if (pcesvn < 0) { return 0 - 1; }
        if (load64(&_kc_pck + 32) < pcesvn) { ok = 0; }
        if (ok == 1 && tdx == 1) {
            var from = 0;
            if ((load8(tee_tcb_svn + 1) & 255) > 0) { from = 2; }
            ok = _kc_svns_at_most(_kc_get(tcb, "tdxtcbcomponents"), tee_tcb_svn, from);
            if (ok < 0) { return 0 - 1; }
        }
        if (ok == 1) {
            var s = _kc_status(lv);
            if (s == 0) { return 0 - 1; }
            return s;
        }
        i = i + 1;
    }
    return 0;
}

# The first of `levels` (`[{"tcb": {"isvsvn": n}, "tcbStatus": ...}]`) whose
# ISVSVN is at most `svn`: its status, 0 when none is, -1 when malformed.
fn _kc_isvsvn_status(levels, svn) {
    if (levels == 0 || bayan_json_v_tag(levels) != JTAG_ARR) { return 0 - 1; }
    var n = bayan_json_v_arr_len(levels);
    var i = 0;
    while (i < n) {
        var lv = bayan_json_v_arr_get(levels, i);
        var want = _kc_int(_kc_get(lv, "tcb"), "isvsvn");
        if (want < 0) { return 0 - 1; }
        if (svn >= want) {
            var s = _kc_status(lv);
            if (s == 0) { return 0 - 1; }
            return s;
        }
        i = i + 1;
    }
    return 0;
}

# Whether buf[0..n) masked by `mask` equals `want`, byte by byte.
fn _kc_masked_eq(buf, mask, want, n) {
    var i = 0;
    while (i < n) {
        if (((load8(buf + i) & load8(mask + i)) & 255) != (load8(want + i) & 255)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The TDX module's identity. With TEE_TCB_SVN[1] (the major version) above 0,
# `tdxModuleIdentities` must hold "TDX_<major, two hex digits>": its MRSIGNER
# must be MRSIGNERSEAM, its masked attributes SEAMATTRIBUTES', and
# TEE_TCB_SVN[0] (the minor SVN) selects its status. With 0, `tdxModule`'s
# MRSIGNER and attributes apply and there is no module status (UpToDate).
# Returns the status (> 0), or a reason (a cstr pointer).
var _KC_HEX = "0123456789ABCDEF";

fn _kc_module_status(info, tee_tcb_svn, mrsignerseam, seamattr) {
    var major = load8(tee_tcb_svn + 1) & 255;
    var ident = 0;
    if (major > 0) {
        var want[8];
        memcpy(&want, "TDX_", 4);
        store8(&want + 4, load8(_KC_HEX + (major >> 4)));
        store8(&want + 5, load8(_KC_HEX + (major & 15)));
        store8(&want + 6, 0);
        var ids = _kc_get(info, "tdxModuleIdentities");
        if (ids == 0 || bayan_json_v_tag(ids) != JTAG_ARR) { return "the TCB info has no TDX module identities"; }
        var i = 0;
        while (i < bayan_json_v_arr_len(ids)) {
            var m = bayan_json_v_arr_get(ids, i);
            if (_kc_is(m, "id", &want) == 1) { ident = m; }
            i = i + 1;
        }
        if (ident == 0) { return "the TCB info has no identity for this TDX module"; }
    } else {
        ident = _kc_get(info, "tdxModule");
        if (ident == 0) { return "the TCB info has no TDX module"; }
    }
    var mrs[48];
    var attr[8];
    var mask[8];
    if (_kc_hex(ident, "mrsigner", &mrs, 48) == 0) { return "the TDX module identity does not parse"; }
    if (_kc_hex(ident, "attributes", &attr, 8) == 0) { return "the TDX module identity does not parse"; }
    if (_kc_hex(ident, "attributesMask", &mask, 8) == 0) { return "the TDX module identity does not parse"; }
    if (memeq(&mrs, mrsignerseam, 48) == 0) { return "the TDX module's signer is not Intel's"; }
    if (_kc_masked_eq(seamattr, &mask, &attr, 8) == 0) { return "the TDX module's attributes do not match"; }
    if (major == 0) { return KAVACH_TCB_UP_TO_DATE; }
    var s = _kc_isvsvn_status(_kc_get(ident, "tcbLevels"), load8(tee_tcb_svn) & 255);
    if (s < 0) { return "the TDX module identity does not parse"; }
    if (s == 0) { return "the TDX module is below every TCB level"; }
    return s;
}

# The QE report against the QE identity. Returns the QE's status (> 0), or a
# reason.
fn _kc_qe_status(ident, qe_report) {
    var misc[4];
    var misc_mask[4];
    var attr[16];
    var attr_mask[16];
    var mrs[32];
    if (_kc_hex(ident, "miscselect", &misc, 4) == 0) { return "the QE identity does not parse"; }
    if (_kc_hex(ident, "miscselectMask", &misc_mask, 4) == 0) { return "the QE identity does not parse"; }
    if (_kc_hex(ident, "attributes", &attr, 16) == 0) { return "the QE identity does not parse"; }
    if (_kc_hex(ident, "attributesMask", &attr_mask, 16) == 0) { return "the QE identity does not parse"; }
    if (_kc_hex(ident, "mrsigner", &mrs, 32) == 0) { return "the QE identity does not parse"; }
    var prodid = _kc_int(ident, "isvprodid");
    if (prodid < 0) { return "the QE identity does not parse"; }
    # SGX report body: MISCSELECT +16, ATTRIBUTES +48, MRSIGNER +128,
    # ISVPRODID +256, ISVSVN +258 (little-endian u16s).
    if (_kc_masked_eq(qe_report + 16, &misc_mask, &misc, 4) == 0) { return "the QE does not match its identity"; }
    if (_kc_masked_eq(qe_report + 48, &attr_mask, &attr, 16) == 0) { return "the QE does not match its identity"; }
    if (memeq(qe_report + 128, &mrs, 32) == 0) { return "the QE does not match its identity"; }
    var have_prodid = (load8(qe_report + 256) & 255) | ((load8(qe_report + 257) & 255) << 8);
    if (have_prodid != prodid) { return "the QE does not match its identity"; }
    var isvsvn = (load8(qe_report + 258) & 255) | ((load8(qe_report + 259) & 255) << 8);
    var s = _kc_isvsvn_status(_kc_get(ident, "tcbLevels"), isvsvn);
    if (s < 0) { return "the QE identity does not parse"; }
    if (s == 0) { return "the QE is below every TCB level"; }
    return s;
}

# ---- the check -------------------------------------------------------------

# What `kavach_collateral_check` found, for the result's details:
# +0 the platform's status, +8 the TDX module's (0 for SGX), +16 the QE's.
var _kc_found[24];

fn kavach_collateral_platform_status() { return load64(&_kc_found); }
fn kavach_collateral_module_status() { return load64(&_kc_found + 8); }
fn kavach_collateral_qe_status() { return load64(&_kc_found + 16); }

# Evaluate collateral `c` for a quote that has verified to `root`. `tdx` is 1
# for a TDX quote. `pem`, `pem_len` the quote's PCK chain; `qe_report` its QE
# report; `tee_tcb_svn`, `mrsignerseam`, `seamattr` from a TD report (0 for
# SGX). `accept` the statuses the policy accepts. Returns 0 when everything
# passes, or the reason. `arena` is the attestation scratch.
fn kavach_collateral_check(c, root, root_der, root_len, tdx, pem, pem_len, qe_report,
  tee_tcb_svn, mrsignerseam, seamattr, accept, now, arena) {
    memset(&_kc_found, 0, 24);
    if (kavach_collateral_complete(c) == 0) { return "the policy carries no collateral"; }
    # The quote's PCK chain: the leaf, then the CA that issued it.
    var qcerts[32];
    var qders[64];
    var qn = _kc_chain(pem, pem_len, &qcerts, &qders, arena);
    if (qn < 2) { return "the quote's PCK chain does not parse"; }
    var leaf_der = load64(&qders);
    var leaf_len = load64(&qders + 8);
    var ca = load64(&qcerts + 8);
    var ca_der = load64(&qders + 16);
    var ca_len = load64(&qders + 24);
    var lf[64];
    var cf[64];
    if (_kc_cert_fields(leaf_der, leaf_len, &lf) == 0) { return "the PCK certificate does not parse"; }
    if (_kc_cert_fields(ca_der, ca_len, &cf) == 0) { return "the PCK CA certificate does not parse"; }
    var iss_len = load64(&lf + 24);
    if (iss_len != load64(&cf + 40) || memeq(leaf_der + load64(&lf + 16), ca_der + load64(&cf + 32), iss_len) == 0) {
        return "the PCK certificate's issuer is not the next certificate";
    }
    if (_kc_pck_tcb(leaf_der, leaf_len) == 0) { return "the PCK certificate carries no SGX TCB"; }

    # The TCB Signing certificate, to the policy's root.
    var scerts[32];
    var sders[64];
    var sn = _kc_chain(AttestCollateral_signer_chain(c), AttestCollateral_signer_chain_len(c), &scerts, &sders, arena);
    if (sn < 1) { return "the TCB signing chain does not parse"; }
    var signer = load64(&scerts);
    var signer_der = load64(&sders);
    var signer_len = load64(&sders + 8);
    var inters: i64[4];
    memset(&inters, 0, 32);
    var ni = 0;
    var i = sn - 1;
    while (i >= 1) {
        var sf[64];
        if (_kc_cert_fields(load64(&sders + i * 16), load64(&sders + i * 16 + 8), &sf) == 0) {
            return "the TCB signing chain does not parse";
        }
        if (_kc_self_issued(load64(&sders + i * 16), &sf) == 0) {
            store64(&inters + ni * 8, load64(&scerts + i * 8));
            ni = ni + 1;
        }
        i = i - 1;
    }
    if (x509_verify_chain(signer, &inters, ni, root, now) != 1) {
        return "the TCB signing certificate does not verify to the policy's root";
    }
    if (x509_cert_curve(signer) != X509_CURVE_P256) { return "the TCB signing key is not P-256"; }

    # Revocation: the PCK certificate by its CA, the CA and the TCB Signing
    # certificate by the root.
    var why = _kc_crl_verdict(AttestCollateral_pck_crl(c), AttestCollateral_pck_crl_len(c), ca, ca_der, ca_len, now,
      leaf_der + load64(&lf), load64(&lf + 8), 0, 0, "the PCK CRL is not the PCK CA's");
    if (why != 0) {
        if (streq(why, "revoked") == 1) { return "the PCK certificate is revoked"; }
        return why;
    }
    var gf[64];
    if (_kc_cert_fields(signer_der, signer_len, &gf) == 0) { return "the TCB signing certificate does not parse"; }
    why = _kc_crl_verdict(AttestCollateral_root_crl(c), AttestCollateral_root_crl_len(c), root, root_der, root_len, now,
      ca_der + load64(&cf), load64(&cf + 8), signer_der + load64(&gf), load64(&gf + 8),
      "the root CRL is not the root's");
    if (why != 0) {
        if (streq(why, "revoked") == 1) { return "the PCK CA certificate is revoked"; }
        if (streq(why, "revoked2") == 1) { return "the TCB signing certificate is revoked"; }
        return why;
    }

    # The TCB info.
    var ja = _kc_json_scratch();
    var pk = x509_cert_pubkey(signer);
    var info = _kc_signed_member(AttestCollateral_tcb_info(c), AttestCollateral_tcb_info_len(c), "tcbInfo", pk, ja);
    if (info == 0) { return "the TCB info's signature does not verify"; }
    var kind = "SGX";
    if (tdx == 1) { kind = "TDX"; }
    if (_kc_is(info, "id", kind) == 0) { return "the TCB info is not for this kind of quote"; }
    if (_kc_int(info, "version") != 3) { return "the TCB info is not version 3"; }
    var issued = _kc_date(info, "issueDate");
    var next = _kc_date(info, "nextUpdate");
    if (issued < 0 || next < 0) { return "the TCB info has no validity window"; }
    if (now < issued || now >= next) { return "the TCB info is not current"; }
    var fmspc[6];
    var pceid[2];
    if (_kc_hex(info, "fmspc", &fmspc, 6) == 0 || _kc_hex(info, "pceId", &pceid, 2) == 0) {
        return "the TCB info does not parse";
    }
    if (memeq(&fmspc, &_kc_pck, 6) == 0) { return "the TCB info is for another platform (FMSPC)"; }
    if (memeq(&pceid, &_kc_pck + 8, 2) == 0) { return "the TCB info is for another PCE"; }
    if (tdx == 1) {
        var ms = _kc_module_status(info, tee_tcb_svn, mrsignerseam, seamattr);
        if (ms > 64) { return ms; }
        store64(&_kc_found + 8, ms);
    }
    var ps = _kc_platform_status(info, tdx, tee_tcb_svn);
    if (ps < 0) { return "the TCB info does not parse"; }
    if (ps == 0) { return "the platform is below every TCB level"; }
    store64(&_kc_found, ps);

    # The QE identity.
    var ident = _kc_signed_member(AttestCollateral_qe_identity(c), AttestCollateral_qe_identity_len(c),
      "enclaveIdentity", pk, ja);
    if (ident == 0) { return "the QE identity's signature does not verify"; }
    var qkind = "QE";
    if (tdx == 1) { qkind = "TD_QE"; }
    if (_kc_is(ident, "id", qkind) == 0) { return "the QE identity is not for this kind of quote"; }
    if (_kc_int(ident, "version") != 2) { return "the QE identity is not version 2"; }
    issued = _kc_date(ident, "issueDate");
    next = _kc_date(ident, "nextUpdate");
    if (issued < 0 || next < 0) { return "the QE identity has no validity window"; }
    if (now < issued || now >= next) { return "the QE identity is not current"; }
    var qs = _kc_qe_status(ident, qe_report);
    if (qs > 64) { return qs; }
    store64(&_kc_found + 16, qs);

    var ok = (accept | KAVACH_TCB_UP_TO_DATE) & (KAVACH_TCB_REVOKED - 1);
    if ((ps & ok) == 0) { return "the platform's TCB status is not accepted"; }
    if (tdx == 1 && (load64(&_kc_found + 8) & ok) == 0) { return "the TDX module's TCB status is not accepted"; }
    if ((qs & ok) == 0) { return "the QE's TCB status is not accepted"; }
    return 0;
}

# --- attestation.cyr ---

# kavach — attestation results and quote verification
# The types are ported from rust-old/src/backend/attestation.rs. SGX and TDX
# quote verification landed in 3.13.0 on sigil's verifiers (ADR-004 §2);
# SEV-SNP and EAR serialization have not.
#
# The AttestationResult struct is backend-agnostic: callers evaluate
# trust via `trust` + `backend` without hardware-specific parsing.

# Ordering matters: Contraindicated < Warning < None < Affirming
# (higher = more trusted). Values chosen so direct comparison works.
#
# **Prefixed, deliberately (3.12.9).** The members were `CONTRAINDICATED`,
# `WARNING`, `NONE` and `AFFIRMING`. cyrius hoists enum members to global
# names under last-definition-wins, and the qualifier is cosmetic, so a
# dependency defining a bare `WARNING` or `NONE` (dhancha defines `NONE = 0`)
# could replace these values in a consumer. `attestation_is_acceptable`
# compares them numerically: a `WARNING` that resolved to 3 would pass an
# `AFFIRMING` bar.
enum AttestationTrust {
    KAVACH_TRUST_CONTRAINDICATED = 0;
    KAVACH_TRUST_WARNING = 1;
    KAVACH_TRUST_NONE = 2;
    KAVACH_TRUST_AFFIRMING = 3;
}

fn attestation_trust_name(t) {
    if (t == KAVACH_TRUST_CONTRAINDICATED) { return "contraindicated"; }
    if (t == KAVACH_TRUST_WARNING) { return "warning"; }
    if (t == KAVACH_TRUST_NONE) { return "none"; }
    if (t == KAVACH_TRUST_AFFIRMING) { return "affirming"; }
    return "unknown";
}

# Backend-agnostic attestation result. Each confidential-computing
# backend (SGX/SEV/TDX) produces one of these; consumers treat them
# uniformly. Populated fields depend on the producer.
#derive(accessors)
struct AttestationResult {
    backend;
    trust;
    measurement_hex;
    signer_hex;
    svn;
    fresh_at;
    details;
    tcb_status;
}

# Eight fields. The constructor allocated 48 bytes until 3.13.0, so `details`
# at offset 48 was written past the end of the result, over the first word of
# whatever was allocated next. 3.14.2 appended `tcb_status`, the platform's TCB
# status (a KAVACH_TCB_* bit) once the collateral has been evaluated, else 0.
var ATTESTATION_RESULT_SIZE = 64;

# Named `kavach_` because sigil defines its own `attestation_result_new`, and
# under last-definition-wins only one of the two survives in a consumer.
fn kavach_attestation_result_new(backend) {
    var a = alloc(ATTESTATION_RESULT_SIZE);
    AttestationResult_set_backend(a, backend);
    AttestationResult_set_trust(a, KAVACH_TRUST_NONE);
    AttestationResult_set_measurement_hex(a, "");
    AttestationResult_set_signer_hex(a, "");
    AttestationResult_set_svn(a, 0);
    AttestationResult_set_fresh_at(a, clock_epoch_secs());
    AttestationResult_set_details(a, "");
    AttestationResult_set_tcb_status(a, 0);
    return a;
}

# Evaluate whether an attestation result meets a minimum trust bar.
# Returns 1 if `result.trust >= minimum`, 0 otherwise.
fn attestation_is_acceptable(result, minimum_trust) {
    if (AttestationResult_trust(result) >= minimum_trust) { return 1; }
    return 0;
}

# ---- SGX and TDX quote verification (3.13.0) -----------------------------
#
# `kavach_attest_quote` checks a quote in this order; the first failure makes
# the result `KAVACH_TRUST_CONTRAINDICATED`, with the reason in `details`:
#
#   1. The policy names a root, at least one measurement and its collateral,
#      the nonce is 1 to 64 bytes, and `now` is a real time (sigil reads 0 as
#      "skip the certificates' validity dates"). For TDX it also pins RTMR0,
#      RTMR1 and RTMR2.
#   2. The quote parses (sigil `sgx_quote_parse` / `tdx_quote_parse`).
#   3. It verifies to the policy's root at `now`, through sigil
#      `*_quote_verify_full_into`: the PCK certificate chain carried in the
#      quote, walked up to the root with each certificate's validity dates; the
#      PCK's signature over the Quoting Enclave's report; that report's binding
#      of the attestation key (SHA-256 of the key and the QE auth data); and the
#      attestation key's signature over the quote header and body.
#   4. Intel's collateral clears the platform (3.14.2,
#      `kavach_collateral_check` in src/attest_collateral.cyr): the TCB info and
#      QE identity are signed by a TCB Signing certificate under the root and
#      current; neither the PCK certificate, its CA nor the signing certificate
#      is revoked; the platform's TCB level, the TDX module's and the QE's are
#      statuses the policy accepts (UpToDate only, by default).
#   5. The guest is not a debug enclave or debug TD, unless the policy allows
#      one (SGX ATTRIBUTES.DEBUG, TDX TD_ATTRIBUTES.DEBUG).
#   6. The report data starts with the nonce, so the quote was made for this
#      exec and is not a replay.
#   7. The measurement is in the policy's allowlist: MRENCLAVE for SGX, MRTD
#      for TDX. For TDX each pinned RTMR is on its list (3.14.2).
#
# A result that passes is `KAVACH_TRUST_AFFIRMING`, or `KAVACH_TRUST_WARNING`
# for a debug guest the policy allowed; `details` names the TCB statuses. The
# measurement, signer and SVN are filled in only once step 3 has passed; before
# that they are whatever the quote's sender wrote.
#
# Through 3.14.1 step 4 did not exist, and neither did the RTMRs: a genuine
# platform with an out-of-date or revoked TCB passed, and for TDX only MRTD,
# the TD's firmware, was checked, not the kernel or its command line.

# The DEBUG bits are Linux's `SGX_ATTR_DEBUG` (BIT(1), arch/x86/include/asm/
# sgx.h: the enclave allows EDBGRD and EDBGWR, debug reads and writes of its
# memory) and `TDX_TD_ATTR_DEBUG` (bit 0, arch/x86/include/asm/shared/tdx.h).
# ATTRIBUTES sits at offset 48 of the SGX report body.
var SGX_REPORT_OFF_ATTRIBUTES = 48;
var SGX_FLAGS_DEBUG = 2;
var TDX_TD_ATTR_DEBUG = 1;
var ATTEST_NONCE_MAX = 64;

# Scratch for sigil's verifier and the collateral's certificates, reset before
# each quote, so repeated verification does not grow the heap. 128 KiB holds a
# real PCK chain, the signing chain and a TDX quote's normalized copy several
# times over; a quote whose certificate data does not fit fails verification.
var _attest_arena = 0;
var _attest_parsed[256];

# The scratch above, and `attest_collateral.cyr`'s, are one process's, so a quote
# is verified under this lock (3.14.8): two verifications at once on two threads
# reset one arena under each other. `kavach_attest_sgx_quote` and
# `kavach_attest_tdx_quote` take it; the collateral's status accessors read what
# the last check under it found.
var _attest_verify_lock = 0;

fn _attest_scratch() {
    if (_attest_arena == 0) {
        _attest_arena = arena_new(131072);
    } else {
        arena_reset(_attest_arena);
    }
    return _attest_arena;
}

fn _attest_fail(r, why) {
    AttestationResult_set_trust(r, KAVACH_TRUST_CONTRAINDICATED);
    AttestationResult_set_details(r, why);
    return r;
}

fn _attest_hex(ptr, len) {
    var s = alloc(len * 2 + 1);
    hex_encode_bytes(ptr, len, s);
    return s;
}

fn _attest_listed(policy, hex) {
    var list = SandboxPolicy_attest_measurements(policy);
    if (list == 0) { return 0; }
    var n = vec_len(list);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(list, i), hex) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Step 1. Returns 0, or the reason the quote cannot be checked.
fn _attest_precheck(policy, quote, quote_len, nonce, nonce_len, now) {
    if (policy_wants_attestation(policy) == 0) { return "the policy allows no measurement"; }
    if (SandboxPolicy_attest_root(policy) == 0) { return "the policy names no root"; }
    if (kavach_collateral_complete(SandboxPolicy_attest_collateral(policy)) == 0) {
        return "the policy carries no collateral";
    }
    if (nonce == 0 || nonce_len <= 0 || nonce_len > ATTEST_NONCE_MAX) { return "no nonce"; }
    if (now <= 0) { return "no verification time"; }
    if (quote == 0 || quote_len <= 0) { return "no quote"; }
    return 0;
}

# "verified[, debug guest allowed]; TCB <s>[, TDX module <s>], QE <s>".
fn _attest_passed_details(debug, tdx) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "verified");
    if (debug != 0) { str_builder_add_cstr(sb, ", debug guest allowed"); }
    str_builder_add_cstr(sb, "; TCB ");
    str_builder_add_cstr(sb, kavach_tcb_status_name(kavach_collateral_platform_status()));
    if (tdx == 1) {
        str_builder_add_cstr(sb, ", TDX module ");
        str_builder_add_cstr(sb, kavach_tcb_status_name(kavach_collateral_module_status()));
    }
    str_builder_add_cstr(sb, ", QE ");
    str_builder_add_cstr(sb, kavach_tcb_status_name(kavach_collateral_qe_status()));
    return str_data(str_builder_build(sb));
}

# "<prefix>RTMR<i><suffix>", as a fresh cstr.
fn _attest_rtmr_msg(prefix, i, suffix) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_cstr(sb, "RTMR");
    str_builder_add_int(sb, i);
    str_builder_add_cstr(sb, suffix);
    return str_data(str_builder_build(sb));
}

# For a TDX quote `tdxq` (0 for SGX): each RTMR the policy pins must be on its
# list. Returns 0, or the reason.
fn _attest_rtmrs_listed(policy, tdxq) {
    if (tdxq == 0) { return 0; }
    var i = 0;
    while (i < 4) {
        var list = policy_attest_rtmr_list(policy, i);
        if (list != 0) {
            var hex = _attest_hex(tdx_quote_rtmr0_ptr(tdxq) + i * 48, 48);
            if (_merge_listed(list, hex) == 0) { return _attest_rtmr_msg("", i, " not in the allowlist"); }
        }
        i = i + 1;
    }
    return 0;
}

# Steps 5 to 7.
fn _attest_finish(r, policy, debug, report_data, nonce, nonce_len, tdxq) {
    if (debug != 0 && SandboxPolicy_attest_allow_debug(policy) == 0) {
        return _attest_fail(r, "debug guest");
    }
    if (memeq(report_data, nonce, nonce_len) == 0) {
        return _attest_fail(r, "the report data does not carry the nonce");
    }
    if (_attest_listed(policy, AttestationResult_measurement_hex(r)) == 0) {
        return _attest_fail(r, "measurement not in the allowlist");
    }
    var why = _attest_rtmrs_listed(policy, tdxq);
    if (why != 0) { return _attest_fail(r, why); }
    var tdx = 0;
    if (tdxq != 0) { tdx = 1; }
    AttestationResult_set_details(r, _attest_passed_details(debug, tdx));
    if (debug != 0) {
        AttestationResult_set_trust(r, KAVACH_TRUST_WARNING);
        return r;
    }
    AttestationResult_set_trust(r, KAVACH_TRUST_AFFIRMING);
    return r;
}

# Step 4: the collateral, for a quote that has verified. Returns 0, or the
# reason. Records the platform's status in `r`.
fn _attest_collateral(r, policy, tdx, pem, pem_len, qe_report, tee_tcb_svn, mrsignerseam, seamattr, now, arena) {
    var root = x509_cert_alloc_into(arena);
    if (root == 0) { return "out of attestation scratch"; }
    var rder = SandboxPolicy_attest_root(policy);
    var rlen = SandboxPolicy_attest_root_len(policy);
    if (x509_parse_into(rder, rlen, root, arena) != 1) { return "the policy's root does not parse"; }
    var why = kavach_collateral_check(SandboxPolicy_attest_collateral(policy), root, rder, rlen, tdx, pem, pem_len,
      qe_report, tee_tcb_svn, mrsignerseam, seamattr, SandboxPolicy_attest_tcb_accept(policy), now, arena);
    AttestationResult_set_tcb_status(r, kavach_collateral_platform_status());
    return why;
}

# Whether a parsed quote is from a debug guest. Meaningful only once the quote
# has verified: the attribute bits are covered by the signature.
fn _attest_sgx_debug(q) {
    if ((load8(sgx_quote_report_body_ptr(q) + SGX_REPORT_OFF_ATTRIBUTES) & SGX_FLAGS_DEBUG) != 0) { return 1; }
    return 0;
}

fn _attest_tdx_debug(q) {
    if ((load8(tdx_quote_td_attributes_ptr(q)) & TDX_TD_ATTR_DEBUG) != 0) { return 1; }
    return 0;
}

# Verify an SGX DCAP v3 quote against `policy`. Returns an AttestationResult.
fn kavach_attest_sgx_quote(quote, quote_len, policy, nonce, nonce_len, now) {
    var m = kavach_lock_cell(&_attest_verify_lock);
    if (m != 0) { mutex_lock(m); }
    var r = _attest_sgx_quote(quote, quote_len, policy, nonce, nonce_len, now);
    if (m != 0) { mutex_unlock(m); }
    return r;
}

fn _attest_sgx_quote(quote, quote_len, policy, nonce, nonce_len, now) {
    var r = kavach_attestation_result_new(KavachBackend.SGX);
    AttestationResult_set_trust(r, KAVACH_TRUST_CONTRAINDICATED);
    AttestationResult_set_fresh_at(r, now);
    var why = _attest_precheck(policy, quote, quote_len, nonce, nonce_len, now);
    if (why != 0) { return _attest_fail(r, why); }
    var q = &_attest_parsed;
    memset(q, 0, 256);
    if (sgx_quote_parse(quote, quote_len, q) != 1) { return _attest_fail(r, "the quote does not parse"); }
    var arena = _attest_scratch();
    if (sgx_quote_verify_full_into(q, SandboxPolicy_attest_root(policy),
        SandboxPolicy_attest_root_len(policy), now, arena) != 1) {
        return _attest_fail(r, "the quote does not verify to the policy's root");
    }
    AttestationResult_set_measurement_hex(r, _attest_hex(sgx_quote_mr_enclave_ptr(q), 32));
    AttestationResult_set_signer_hex(r, _attest_hex(sgx_quote_mr_signer_ptr(q), 32));
    AttestationResult_set_svn(r, sgx_quote_isv_svn(q));
    why = _attest_collateral(r, policy, 0, sgx_quote_cert_data_ptr(q), sgx_quote_cert_data_len(q),
      sgx_quote_qe_report_ptr(q), 0, 0, 0, now, arena);
    if (why != 0) { return _attest_fail(r, why); }
    return _attest_finish(r, policy, _attest_sgx_debug(q), sgx_quote_report_data_ptr(q), nonce, nonce_len, 0);
}

fn _attest_le16(p) { return (load8(p) & 255) | ((load8(p + 1) & 255) << 8); }
fn _attest_le32(p) { return _attest_le16(p) | (_attest_le16(p + 2) << 16); }

# Parse a TDX v4 quote into `q`. Intel's quotes put the QE report, its
# signature, the QE auth data and the PCK chain inside certification data of
# type 6 ("QE report certification data") after the attestation key; sigil
# 3.13.15's `tdx_quote_parse` reads the QE report straight after the key, so it
# refuses every quote a real TD produces (measured on an Intel-signed quote from
# dcap-qvl's samples). When the plain parse fails and that wrapper is there,
# kavach parses a copy without its 6-byte header. No signature covers those
# bytes: the attestation key signs the header and body, the PCK key the QE
# report. Lifts when sigil parses the wrapper (filed: docs/development/issues/
# 2026-11-02-sigil-tdx-quote-type6-wrapper.md).
fn _attest_tdx_parse(quote, quote_len, q, arena) {
    if (tdx_quote_parse(quote, quote_len, q) == 1) { return 1; }
    if (quote_len < 636) { return 0; }
    if (_attest_le16(quote) != 4) { return 0; }
    var w = 64;
    if (_attest_le16(quote + 2) == 3) { w = 96; }
    var sig_len = _attest_le32(quote + 632);
    if (636 + sig_len != quote_len) { return 0; }
    var cur = 636 + 2 * w;
    if (cur + 6 > quote_len) { return 0; }
    if (_attest_le16(quote + cur) != 6) { return 0; }
    if (_attest_le32(quote + cur + 2) != quote_len - cur - 6) { return 0; }
    var flat = arena_alloc(arena, quote_len - 6);
    if (flat == 0) { return 0; }
    memcpy(flat, quote, cur);
    var n = sig_len - 6;
    store8(flat + 632, n & 255);
    store8(flat + 633, (n >> 8) & 255);
    store8(flat + 634, (n >> 16) & 255);
    store8(flat + 635, (n >> 24) & 255);
    memcpy(flat + cur, quote + cur + 6, quote_len - cur - 6);
    memset(q, 0, 256);
    return tdx_quote_parse(flat, quote_len - 6, q);
}

# Verify a TDX v4 quote against `policy`. Returns an AttestationResult. The
# measurement is MRTD; there is no signer, and `svn` stays 0 (the TDX module's
# TEE_TCB_SVN is 16 bytes, not one number).
fn kavach_attest_tdx_quote(quote, quote_len, policy, nonce, nonce_len, now) {
    var m = kavach_lock_cell(&_attest_verify_lock);
    if (m != 0) { mutex_lock(m); }
    var r = _attest_tdx_quote(quote, quote_len, policy, nonce, nonce_len, now);
    if (m != 0) { mutex_unlock(m); }
    return r;
}

fn _attest_tdx_quote(quote, quote_len, policy, nonce, nonce_len, now) {
    var r = kavach_attestation_result_new(KavachBackend.TDX);
    AttestationResult_set_trust(r, KAVACH_TRUST_CONTRAINDICATED);
    AttestationResult_set_fresh_at(r, now);
    var why = _attest_precheck(policy, quote, quote_len, nonce, nonce_len, now);
    if (why != 0) { return _attest_fail(r, why); }
    var i = 0;
    while (i < 3) {
        if (policy_attest_rtmr_list(policy, i) == 0) {
            return _attest_fail(r, _attest_rtmr_msg("the policy pins no ", i, ""));
        }
        i = i + 1;
    }
    var q = &_attest_parsed;
    memset(q, 0, 256);
    var arena = _attest_scratch();
    if (_attest_tdx_parse(quote, quote_len, q, arena) != 1) { return _attest_fail(r, "the quote does not parse"); }
    if (tdx_quote_verify_full_into(q, SandboxPolicy_attest_root(policy),
        SandboxPolicy_attest_root_len(policy), now, arena) != 1) {
        return _attest_fail(r, "the quote does not verify to the policy's root");
    }
    AttestationResult_set_measurement_hex(r, _attest_hex(tdx_quote_mrtd_ptr(q), 48));
    why = _attest_collateral(r, policy, 1, tdx_quote_cert_data_ptr(q), tdx_quote_cert_data_len(q),
      tdx_quote_qe_report_ptr(q), tdx_quote_tee_tcb_svn_ptr(q), tdx_quote_mrseamsigner_ptr(q),
      tdx_quote_seam_attributes_ptr(q), now, arena);
    if (why != 0) { return _attest_fail(r, why); }
    return _attest_finish(r, policy, _attest_tdx_debug(q), tdx_quote_report_data_ptr(q), nonce, nonce_len, q);
}

# Verify a quote from `backend` (SGX or TDX). Any other backend has no quote
# format kavach can check, and gets a CONTRAINDICATED result.
fn kavach_attest_quote(backend, quote, quote_len, policy, nonce, nonce_len, now) {
    if (backend == KavachBackend.SGX) {
        return kavach_attest_sgx_quote(quote, quote_len, policy, nonce, nonce_len, now);
    }
    if (backend == KavachBackend.TDX) {
        return kavach_attest_tdx_quote(quote, quote_len, policy, nonce, nonce_len, now);
    }
    var r = kavach_attestation_result_new(backend);
    AttestationResult_set_fresh_at(r, now);
    return _attest_fail(r, "this backend cannot attest");
}

# Whether `backend` can produce a quote kavach verifies.
fn kavach_attest_backend_supported(backend) {
    if (backend == KavachBackend.SGX) { return 1; }
    if (backend == KavachBackend.TDX) { return 1; }
    return 0;
}

# Whether a result lets the exec's output through under `policy`: AFFIRMING, or
# WARNING when the policy allows a debug guest. `attestation_is_acceptable`
# cannot say this: NONE sits above WARNING in its order, and NONE means no
# attestation was done.
fn kavach_attest_passes(result, policy) {
    if (result == 0) { return 0; }
    var t = AttestationResult_trust(result);
    if (t == KAVACH_TRUST_AFFIRMING) { return 1; }
    if (t == KAVACH_TRUST_WARNING && SandboxPolicy_attest_allow_debug(policy) == 1) { return 1; }
    return 0;
}

# ---- SGX-specific report (struct only; verify waits on sigil) ------------

#derive(accessors)
struct SgxAttestationReport {
    mrenclave_hex;
    mrsigner_hex;
    isv_prod_id;
    isv_svn;
    report_data_len;
    ias_signature;
    timestamp;
}

fn sgx_report_new() {
    var r = alloc(56);
    SgxAttestationReport_set_mrenclave_hex(r, "");
    SgxAttestationReport_set_mrsigner_hex(r, "");
    SgxAttestationReport_set_isv_prod_id(r, 0);
    SgxAttestationReport_set_isv_svn(r, 0);
    SgxAttestationReport_set_report_data_len(r, 0);
    SgxAttestationReport_set_ias_signature(r, "");
    SgxAttestationReport_set_timestamp(r, 0);
    return r;
}

# Structural verification: MRENCLAVE / MRSIGNER are 64-char lowercase
# hex, IAS signature is non-trivial (>= 32 chars). Cryptographic
# verification of the IAS signature against the Intel root cert is
# deferred — needs sigil EAR helpers + cert-chain validation.
fn sgx_report_verify_structure(report) {
    var me = SgxAttestationReport_mrenclave_hex(report);
    var ms = SgxAttestationReport_mrsigner_hex(report);
    var sig = SgxAttestationReport_ias_signature(report);
    if (strlen(me) != 64) { return 0; }
    if (strlen(ms) != 64) { return 0; }
    if (strlen(sig) < 32) { return 0; }
    # Check hex-ness of measurements
    var i = 0;
    while (i < 64) {
        var c = load8(me + i);
        if (is_digit_c(c) == 0) {
            if (c < 97) { return 0; }
            if (c > 102) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# ---- Seal key policy (SGX sealing; struct-only for now) ------------------

enum SealKeyPolicy {
    MR_ENCLAVE = 0;
    MR_SIGNER = 1;
}

fn seal_key_policy_name(p) {
    if (p == SealKeyPolicy.MR_ENCLAVE) { return "mrenclave"; }
    if (p == SealKeyPolicy.MR_SIGNER) { return "mrsigner"; }
    return "unknown";
}

# --- sandbox_exec.cyr ---

# kavach — end-to-end exec flow
# sandbox_exec() is the primary entry point for running a command
# through the full kavach pipeline:
#
#   1. Verify sandbox is in RUNNING state
#   2. Backend dispatch (backend.exec)
#   3. Attestation gate, when the policy requires it (3.13.0)
#   4. Externalization gate (secrets + code + data + verdict)
#   5. Threat classification (intent score + kill chain)
#   6. Audit record (HMAC-SHA256 chain)
#
# On BLOCK/QUARANTINE verdicts, returns 0 and logs via audit; caller
# inspects the sandbox's last_scan_result for details. A failed attestation
# also returns 0; `sandbox_exec_last_attestation` says why.

# ---- Sandbox runtime wrapper ---------------------------------------------
# We extend the lifecycle Sandbox with post-exec observations:
#   - last_scan_result: ScanResult* from the last gate run
#   - last_assessment:  ThreatAssessment* from the last classification
#   - audit_chain:      optional AuditChain*
# These are stored in a parallel SandboxRuntime struct keyed by sandbox id.
# For v3.0 port we carry them on the Sandbox pointer via appended fields.

# ---- Global scan / audit context -----------------------------------------
# One global ext policy, one global audit chain for the v3.0 skeleton.
# Consumers can swap these via sandbox_exec_set_policy / ...set_audit.
var _default_ext_policy = 0;
var _global_audit_chain = 0;
var _last_scan_result = 0;
var _last_assessment = 0;

fn sandbox_exec_set_ext_policy(p) { _default_ext_policy = p; return 0; }
fn sandbox_exec_set_audit_chain(c) { _global_audit_chain = c; return 0; }

# The process's most recent scan and assessment. ⚠ With execs on two threads
# these are either one's (3.14.8): a caller with threads reads its sandbox's,
# `sandbox_last_scan_result` and `sandbox_last_assessment`.
fn sandbox_exec_last_scan_result() { return _last_scan_result; }
fn sandbox_exec_last_assessment() { return _last_assessment; }

# What `sandbox_exec` found for `sandbox`'s last exec (3.14.8): the gate's
# ScanResult, the ThreatAssessment, and the AttestationResult when the policy
# required attestation. 0 when the exec stopped before that step, or for a
# diagnostic, which skips the gates.
fn sandbox_last_scan_result(sandbox) {
    if (sandbox == 0) { return 0; }
    return Sandbox_last_scan(sandbox);
}

fn sandbox_last_assessment(sandbox) {
    if (sandbox == 0) { return 0; }
    return Sandbox_last_assessment(sandbox);
}

fn sandbox_last_attestation(sandbox) {
    if (sandbox == 0) { return 0; }
    return Sandbox_last_attestation(sandbox);
}

# ---- Attestation (3.13.0) -------------------------------------------------
var _last_attestation = 0;
var _attest_time = 0;
var _attest_next_nonce = 0;
var _attest_next_nonce_len = 0;

# The AttestationResult of the last exec whose quote was checked, or 0: the
# policy did not require attestation, or the exec stopped before the check.
# ⚠ The process's most recent: see `sandbox_last_attestation`.
fn sandbox_exec_last_attestation() { return _last_attestation; }

# Held by an attesting exec from taking its nonce to taking its quote (3.14.8), so
# the process-wide pair `backend_attest_nonce` and `backend_attach_quote` belongs
# to one exec at a time. An exec that does not attest never takes it.
var _attest_exec_lock = 0;

# Verify quotes as of Unix time `t` rather than the wall clock; 0 returns to
# the clock. For checking evidence at the time it was recorded, and for tests
# whose fixture certificates expire.
fn sandbox_exec_set_attest_time(t) { _attest_time = t; return 0; }

# Bind the next exec's quote to `nonce` (1 to 64 bytes) instead of a random
# one: a relying party's challenge, so the quote is fresh for that party. Used
# once; the exec after it draws a random nonce again. Returns 0, or -1 for a
# nonce of the wrong length.
#
# "The next exec" is the process's next attesting one, which takes it under
# `_attest_exec_lock`, so it reaches one exec and no other.
fn sandbox_exec_set_attest_nonce(nonce, len) {
    if (nonce == 0 || len <= 0 || len > ATTEST_NONCE_MAX) { return 0 - 1; }
    var copy = alloc(len);
    memcpy(copy, nonce, len);
    _attest_next_nonce = copy;
    _attest_next_nonce_len = len;
    return 0;
}

# The nonce for this exec: the caller's, once, or 32 bytes from the kernel
# CSPRNG. Returns 0 if getrandom fails, which fails the exec. Set on `sandbox`,
# and on the process-wide pair, which the caller holds `_attest_exec_lock` for.
fn _attest_take_nonce(sandbox) {
    var n = 0;
    var len = 0;
    if (_attest_next_nonce_len > 0) {
        n = _attest_next_nonce;
        len = _attest_next_nonce_len;
        _attest_next_nonce = 0;
        _attest_next_nonce_len = 0;
    } else {
        n = alloc(32);
        if (fill_random(n, 32) != 32) { return 0; }
        len = 32;
    }
    backend_attest_reset(n, len);
    Sandbox_set_attest_nonce(sandbox, n);
    Sandbox_set_attest_nonce_len(sandbox, len);
    return n;
}

# Clear `sandbox`'s attestation context, so no exec reads another's nonce or quote.
fn _attest_clear(sandbox) {
    Sandbox_set_attest_nonce(sandbox, 0);
    Sandbox_set_attest_nonce_len(sandbox, 0);
    Sandbox_set_quote(sandbox, 0);
    Sandbox_set_quote_len(sandbox, 0);
    return 0;
}

fn _ensure_default_ext_policy() {
    if (_default_ext_policy == 0) {
        _default_ext_policy = ext_policy_default();
    }
    return _default_ext_policy;
}

# ---- Audit payload builders ----------------------------------------------

fn _audit_record_if(chain, event_type, payload) {
    if (chain != 0) { audit_chain_record(chain, event_type, payload); }
    return 0;
}

# ---- Main entry -----------------------------------------------------------

# 1 when `backend`'s exec reads the argv a sandbox carries. The others take a
# command line and hand it on as text.
fn _kv_backend_reads_argv(backend) {
    if (backend == KavachBackend.PROCESS) { return 1; }
    if (backend == KavachBackend.OCI) { return 1; }
    if (backend == KavachBackend.GVISOR) { return 1; }
    return 0;
}

# sandbox_exec for a caller that holds real argv: `argv` is a vec of cstr, and
# each element reaches the payload as one argument, whatever it holds. A command
# string is split on spaces and tabs, so through sandbox_exec "a  b" arrives as
# two arguments and "" as none. Returns what sandbox_exec returns.
#
# Everything but the payload's argv is sandbox_exec's: the runtime guard and the
# audit chain read the elements joined with spaces, so a command the string form
# refuses is refused here too. A backend that takes a command line refuses an
# element the join would change, rather than flatten it.
fn sandbox_exec_argv(sandbox, argv) {
    var command = _kv_argv_command(argv);
    if (command == 0) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "argv needs a program with no space or tab in it");
        return 0;
    }
    if (_kv_backend_reads_argv(SandboxConfig_backend(Sandbox_config(sandbox))) == 0) {
        var i = 0;
        while (i < vec_len(argv)) {
            if (_kv_arg_is_word(vec_get(argv, i)) == 0) {
                kavach_err_print(KAVACH_ERR_EXEC_FAILED,
                  "this backend takes a command line; an empty argument or one with a space or tab cannot reach it");
                return 0;
            }
            i = i + 1;
        }
    }
    Sandbox_set_argv(sandbox, argv);
    var r = sandbox_exec(sandbox, command);
    Sandbox_set_argv(sandbox, 0);
    return r;
}

# Execute a command through the full pipeline.
# Returns ExecResult* on PASS/WARN, 0 on BLOCK/QUARANTINE/error.
#
# 3.14.8: two execs on two threads are two runs. What one exec finds is its own:
# the capture's result is the capture's, the diagnostic flag the result's, the
# scan, assessment and attestation the sandbox's (`sandbox_last_*`), and an
# attesting exec holds `_attest_exec_lock` across its dispatch. The
# `sandbox_exec_last_*` accessors still read the process's most recent. One
# sandbox is one exec at a time: its `last_*` fields describe whichever of two
# execs on it finished last.
fn sandbox_exec(sandbox, command) {
    if (Sandbox_state(sandbox) != SandboxState.RUNNING) {
        kavach_err_print(KAVACH_ERR_EXEC_FAILED, "sandbox not running");
        return 0;
    }

    var policy = _ensure_default_ext_policy();
    var audit = _global_audit_chain;

    _audit_record_if(audit, "exec_begin", command);

    # Attestation is decided before anything runs. A policy that requires it
    # runs only on a backend that can produce a quote, with a nonce for the
    # guest to bind into it.
    var cfg = Sandbox_config(sandbox);
    var sp = SandboxConfig_policy(cfg);
    var attest = policy_wants_attestation(sp);
    _last_attestation = 0;
    Sandbox_set_last_attestation(sandbox, 0);
    Sandbox_set_last_scan(sandbox, 0);
    Sandbox_set_last_assessment(sandbox, 0);
    _attest_clear(sandbox);
    var lock = 0;
    if (attest == 1) {
        var bid = SandboxConfig_backend(cfg);
        if (kavach_attest_backend_supported(bid) == 0) {
            kavach_err_print(KAVACH_ERR_POLICY_VIOLATION, "attestation required; this backend cannot attest");
            _audit_record_if(audit, "exec_error", "attestation required; backend cannot attest");
            return 0;
        }
        lock = kavach_lock_cell(&_attest_exec_lock);
        if (lock == 0) {
            kavach_err_print(KAVACH_ERR_POLICY_VIOLATION, "attestation required; no lock");
            _audit_record_if(audit, "exec_error", "attestation required; no lock");
            return 0;
        }
        mutex_lock(lock);
        if (_attest_take_nonce(sandbox) == 0) {
            backend_attest_reset(0, 0);
            mutex_unlock(lock);
            kavach_err_print(KAVACH_ERR_POLICY_VIOLATION, "attestation required; no nonce");
            _audit_record_if(audit, "exec_error", "attestation required; no nonce");
            return 0;
        }
    }

    # 1. Backend dispatch. The process-wide diagnostic flag is cleared first for a
    # caller on one thread (see backend_diagnostic_reset); this exec reads the
    # result's own.
    backend_diagnostic_reset();
    var result = backend_dispatch_exec(sandbox, command);
    # Taken and cleared on every path out of the dispatch, so none of them
    # leaves a nonce or quote for whatever dispatches next. The sandbox's quote
    # first, then one a backend handed to the process-wide pair.
    var quote = 0;
    var quote_len = 0;
    var nonce = 0;
    var nonce_len = 0;
    if (attest == 1) {
        quote = Sandbox_quote(sandbox);
        quote_len = Sandbox_quote_len(sandbox);
        if (quote == 0) {
            quote = backend_quote();
            quote_len = backend_quote_len();
        }
        nonce = Sandbox_attest_nonce(sandbox);
        nonce_len = Sandbox_attest_nonce_len(sandbox);
        backend_attest_reset(0, 0);
        mutex_unlock(lock);
    }
    _attest_clear(sandbox);
    if (result == 0) {
        _audit_record_if(audit, "exec_error", "backend dispatch failed");
        return 0;
    }

    # Both gates are skipped when the backend returned a DIAGNOSTIC rather than
    # captured output (no runtime found, bad bundle, runtime-guard violation).
    # The externalization gate polices what the payload externalizes; a
    # diagnostic is kavach explaining why there was no payload, and scanning it
    # lets kavach censor its own error messages — see
    # backend_result_is_diagnostic. With no payload there is no guest to attest
    # either. The result still flows back to the caller carrying its non-zero
    # exit code and its reason. 3.14.8: the result says so, not a process-wide
    # flag another thread's dispatch may have set or cleared.
    if (exec_result_is_diagnostic(result) == 1) {
        _last_scan_result = 0;
        _last_assessment = 0;
        _audit_record_if(audit, "exec_complete", "diagnostic");
        return result;
    }

    # 2. Attestation gate. The guest's quote is verified against the policy
    # before any of its output leaves; a guest that cannot show an allowed
    # measurement on a genuine platform, bound to this exec's nonce, fails the
    # exec. The clock is read here, after the run.
    if (attest == 1) {
        var now = _attest_time;
        if (now == 0) { now = clock_epoch_secs(); }
        var ar = kavach_attest_quote(SandboxConfig_backend(cfg), quote, quote_len, sp,
          nonce, nonce_len, now);
        _last_attestation = ar;
        Sandbox_set_last_attestation(sandbox, ar);
        _audit_record_if(audit, "attestation", attestation_trust_name(AttestationResult_trust(ar)));
        if (kavach_attest_passes(ar, sp) == 0) {
            kavach_err_print(KAVACH_ERR_POLICY_VIOLATION, AttestationResult_details(ar));
            return 0;
        }
    }

    # 3. Externalization gate
    var scan = gate_apply(result, policy);
    _last_scan_result = scan;
    Sandbox_set_last_scan(sandbox, scan);

    # 4. Threat classification
    var assessment = classify_threat(ScanResult_findings(scan));
    _last_assessment = assessment;
    Sandbox_set_last_assessment(sandbox, assessment);

    var verdict = ScanResult_verdict(scan);

    # 5. Audit record — one entry per exec with verdict payload
    if (audit != 0) {
        var vname = verdict_name(verdict);
        audit_chain_record(audit, "exec_complete", vname);
    }

    if (verdict == ScanVerdict.BLOCK) {
        kavach_err_print(KAVACH_ERR_EXTERNALIZATION_BLOCKED, "blocked by gate");
        return 0;
    }
    if (verdict == ScanVerdict.QUARANTINE) {
        kavach_err_print(KAVACH_ERR_EXTERNALIZATION_BLOCKED, "quarantined");
        return 0;
    }
    return result;
}

# ---- Initialization -------------------------------------------------------
# Call once at startup to register the v3.0 skeleton backends.
fn kavach_init() {
    alloc_init();
    sha256_global_init();
    # 3.14.8: the tables kavach builds once and only reads after, built here, on
    # the thread that calls this before a consumer starts others. Each is
    # published only when whole, so building one late on two threads costs a
    # second copy and nothing else; this keeps even that off the exec path.
    _cg_automaton();
    _seccomp_deny_list();
    _seccomp_allow_list();
    security_capability_names();
    _syscall_map_init();
    _oci_paths_json();
    backend_noop_register();
    backend_process_register();
    backend_gvisor_register();
    backend_oci_register();
    backend_wasm_register();
    backend_sy_agnos_register();
    backend_sgx_register();
    backend_sev_register();
    backend_tdx_register();
    backend_firecracker_register();
    return 0;
}
