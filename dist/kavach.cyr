fn _cg_reverse_shell(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "mkfifo") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "data_exfiltration", "Reverse shell", "mkfifo");
    }
    if (_cg_hit(hits, lower, "/dev/tcp/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "data_exfiltration", "Reverse shell", "/dev/tcp/");
    }
    if (_cg_hit(hits, lower, "nc -e") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "data_exfiltration", "Reverse shell", "nc -e");
    }
    if (_cg_hit(hits, lower, "ncat -e") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "data_exfiltration", "Reverse shell", "ncat -e");
    }
    if (_cg_hit(hits, lower, "socat exec:") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "data_exfiltration", "Reverse shell", "socat exec:");
    }
    if (_cg_hit(hits, lower, "bash -i >& /dev/tcp") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "data_exfiltration", "Reverse shell", "bash -i >& /dev/tcp");
    }
    return 0;
}

