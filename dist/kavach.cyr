fn kv_dup2(oldfd, newfd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_dup2(oldfd, newfd);
    #endif
}

fn kv_execve(path, argv, envp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_execve(path, argv, envp);
    #endif
}

# ---- exec by pinned fd (ADR-005 §H4) --------------------------------------
# A binary chosen by path — a runtime found with kavach_path_exists, or the
# absolute program a command names — used to be exec'd by that path in the
# child, so whatever sat at the path at exec time ran. kv_exec_pin opens the
# binary in the PARENT, before fork, and the child execs that fd with
# execveat(AT_EMPTY_PATH): what runs is the file that was open when kavach
# committed to it.
var KV_EXEC_BY_PATH = 0 - 1;   # pinning does not apply: exec by path
var KV_EXEC_REFUSED = 0 - 2;   # an absolute path that could not be pinned: do not exec it
# Set in the child only: the inherited-fd sweep in confine.cyr must spare it.
var _kv_exec_keep_fd = 0 - 1;

# Open `path` for exec by fd. Returns the fd, KV_EXEC_BY_PATH, or KV_EXEC_REFUSED.
# By path: agnos (no execveat) and a relative path (the child's cwd decides it).
# Refused, never downgraded to by-path: an absolute path that cannot be opened,
# or is not a regular file with an execute bit — falling back to the path would
# reopen the very window this closes. O_PATH (0x200000; the stdlib names none,
# and x86_64 and aarch64 agree) needs no read permission, so exec-only binaries
# pin too. O_CLOEXEC keeps the fd from outliving the exec; kv_exec_pinned
# handles the one case that needs it to.
fn kv_exec_pin(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return KV_EXEC_BY_PATH;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (path == 0) { return KV_EXEC_REFUSED; }
    if (load8(path) != 47) { return KV_EXEC_BY_PATH; }   # not '/'
    var fd = file_open(path, 0x200000 | O_CLOEXEC, 0);
    if (fd < 0) { return KV_EXEC_REFUSED; }
    var st[144];
    if (sys_fstat(fd, &st) < 0) {
        sys_close(fd);
        return KV_EXEC_REFUSED;
    }
    var mode = load32(&st + STAT_MODE);
    # S_IFMT 0170000 / S_IFREG 0100000, and any of the 0111 execute bits.
    if ((mode & 61440) != 32768) {
        sys_close(fd);
        return KV_EXEC_REFUSED;
    }
    if ((mode & 73) == 0) {
        sys_close(fd);
        return KV_EXEC_REFUSED;
    }
    return fd;
    #endif
}

# ---- the name a pinned exec gives its program (3.14.0) --------------------
# execveat(fd, "", AT_EMPTY_PATH) makes the kernel record the program as
# /dev/fd/N (AT_EXECFN). uutils coreutils, Ubuntu's default since 25.10, picks
# its utility from AT_EXECFN unless that starts with /proc/ (then argv[0]), and
# Ubuntu's build also requires that name to be /proc/self/exe's basename. So a
# pinned /bin/echo ran as utility "N" and exited 1 ("unknown program 'N'";
# "Requested utility `N` does not match executable name"), on every uutils host.
# execve("/proc/self/fd/N") runs the same open file, because a procfs fd entry
# is a magic link to the file object, not to a path. The name it records starts
# with /proc/, so uutils takes argv[0]. Only through a genuine procfs, checked
# with statfs, and only when the link resolves to the pinned inode, so a rootfs
# that plants its own /proc/self/fd/N cannot redirect the exec.
var KV_PROC_SUPER_MAGIC = 0x9fa0;   # include/uapi/linux/magic.h
var KV_STATFS_TYPE = 0;             # f_type, first in struct statfs on x86_64 and aarch64
var KV_STAT_DEV = 0;                # st_dev and st_ino lead struct stat on x86_64
var KV_STAT_INO = 8;                # (asm/stat.h) and aarch64 (asm-generic/stat.h) alike

# "/proc/self/fd/<fd>" into `buf` (at least 40 bytes), NUL-terminated. In the
# CHILD, so no heap.
fn _kv_proc_fd_path(fd, buf) {
    var pre = "/proc/self/fd/";
    var n = 0;
    while (load8(pre + n) != 0) {
        store8(buf + n, load8(pre + n));
        n = n + 1;
    }
    var digits[24];
    var k = 0;
    var v = fd;
    if (v == 0) {
        store8(&digits, 48);
        k = 1;
    }
    while (v > 0) {
        store8(&digits + k, 48 + v % 10);
        v = v / 10;
        k = k + 1;
    }
    while (k > 0) {
        k = k - 1;
        store8(buf + n, load8(&digits + k));
        n = n + 1;
    }
    store8(buf + n, 0);
    return n;
}

# Exec pinned `fd` through /proc/self/fd/N. In the CHILD, so only syscalls.
# Returns only when it did not exec: 1 where it does not apply (no genuine
# procfs, a link that is not the pinned file, a #! script), else execve's error.
# A script stays on the fd exec: its interpreter must open the name after the
# close-on-exec fd is gone, which kv_exec_pinned's dup retry provides, and
# uutils accepts an interpreter run for a #! file.
fn _kv_exec_via_proc(fd, argv, envp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 1;   # no fd exec on agnos (kv_exec_pin execs by path there)
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var path[40];
    _kv_proc_fd_path(fd, &path);
    var sfs[2176];   # STATFS_BUFSZ, the stdlib's statfs buffer contract
    if (sys_statfs("/proc/self/fd", &sfs) < 0) { return 1; }
    if (load64(&sfs + KV_STATFS_TYPE) != KV_PROC_SUPER_MAGIC) { return 1; }
    # O_PATH (0x200000, as kv_exec_pin): resolves the link with no read right.
    var lfd = file_open(&path, 0x200000 | O_CLOEXEC, 0);
    if (lfd < 0) { return 1; }
    var a[144];
    var b[144];
    var same = 0;
    if (sys_fstat(lfd, &a) == 0) {
        if (sys_fstat(fd, &b) == 0) {
            if (load64(&a + KV_STAT_DEV) == load64(&b + KV_STAT_DEV)) {
                if (load64(&a + KV_STAT_INO) == load64(&b + KV_STAT_INO)) { same = 1; }
            }
        }
    }
    sys_close(lfd);
    if (same == 0) { return 1; }
    # An unreadable file cannot be a script: an interpreter could not read it.
    var rfd = file_open(&path, O_RDONLY | O_CLOEXEC, 0);
    if (rfd >= 0) {
        var hdr[8];
        store64(&hdr, 0);
        var got = sys_read(rfd, &hdr, 2);
        sys_close(rfd);
        if (got == 2) {
            if (load8(&hdr) == 35) {
                if (load8(&hdr + 1) == 33) { return 1; }   # "#!"
            }
        }
    }
    return kv_execve(&path, argv, envp);
    #endif
}

# Exec the pinned fd. In the CHILD, so only syscalls. Returns only on failure.
# Through /proc/self/fd first (above); where that does not apply or fails, the
# fd itself. ENOENT on a valid fd means a #! script: the kernel hands the
# interpreter /dev/fd/N, and a close-on-exec fd is gone by the time it opens
# that. A dup has FD_CLOEXEC clear, so the retry lets the interpreter read the
# same file.
fn kv_exec_pinned(fd, argv, envp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    _kv_exec_via_proc(fd, argv, envp);
    var r = sys_execveat(fd, "", argv, envp, AT_EMPTY_PATH);
    if (r == 0 - 2) {
        var fd2 = syscall(SYS_DUP, fd);
        if (fd2 >= 0) { r = sys_execveat(fd2, "", argv, envp, AT_EMPTY_PATH); }
    }
    return r;
    #endif
}

# The one exec every kavach child makes: by pinned fd, by path, or — for a pin
# that was refused — not at all. Returns only on failure; the caller exits 127.
fn kv_exec_child(pin, path, argv, envp): i64 {
    if (pin >= 0) { return kv_exec_pinned(pin, argv, envp); }
    if (pin == KV_EXEC_BY_PATH) { return kv_execve(path, argv, envp); }
    return 0 - 1;
}

# lib/process.cyr's exec_capture (cyrius 6.6.6) with the exec pinned: stdout
# into `buf`, stderr to /dev/null, an empty environment, and the stdlib's own
# parent-death guard, read deadline and reaping. The exec call is the only
# difference; switch back if the stdlib grows an fd-exec variant. agnos keeps
# the stdlib's: it has no fork, and its exec_capture is its own.
fn kv_exec_capture(args, buf, buflen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return exec_capture(args, buf, buflen);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    # No buffer (3.14.7: `backend_capture_buf` answers 0 when it has none) is a
    # failed capture, never a write through a null pointer.
    if (buf == 0 || buflen < 2) { return 0 - 1; }
    var cmd = vec_get(args, 0);
    var argv = alloc((argc + 1) * 8);
    var avi = 0;
    while (avi < argc) {
        store64(argv + avi * 8, vec_get(args, avi));
        avi = avi + 1;
    }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);
    var pin = kv_exec_pin(cmd);
    var pipefd[16];
    sys_pipe(&pipefd);
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);
    var ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(rfd);
        sys_close(wfd);
        if (pin >= 0) { sys_close(pin); }
        return 0 - 1;
    }
    if (pid == 0) {
        _proc_child_guard(ppid);
        sys_close(rfd);
        sys_dup2(wfd, 1);
        sys_close(wfd);
        var devnull = file_open("/dev/null", O_WRONLY, 0);
        if (devnull >= 0) {
            sys_dup2(devnull, 2);
            sys_close(devnull);
        }
        # 3.14.8: nothing inherited reaches the runtime but its stdio and its pin,
        # as in every capture: another thread's capture pipes are not close-on-exec.
        _kv_exec_keep_fd = pin;
        _spawn_close_inherited(3);
        kv_exec_child(pin, cmd, argv, envp);
        sys_exit(127);
    }
    if (pin >= 0) { sys_close(pin); }
    sys_close(wfd);
    var total = _proc_read_pipe(rfd, buf, buflen, proc_timeout_ms());
    sys_close(rfd);
    var stbuf[4];
    _proc_wait_deadline(pid, &stbuf, proc_timeout_ms());
    return total;
    #endif
}

fn kv_setsid(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_setsid();
    #endif
}

# ---- constant-time ops ---------------------------------------------------
# Delegates to the stdlib ct_eq_bytes_lens, which XORs byte-by-byte into an
# accumulator without early exit. Prevents timing side channels on
# HMAC/signature verification (ADR-005 §C1). sigil retired its own ct_eq in
# the 3.x line in favor of this stdlib symbol (identical semantics) — see
# CHANGELOG 3.3.0.

fn ct_streq(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    if (la != lb) { return 0; }
    return ct_eq_bytes_lens(a, la, b, lb);
}

# ---- overflow-checked arithmetic -----------------------------------------
# Return -1 on overflow instead of wrapping. Use for sizes fed to alloc().

fn checked_add(a, b) {
    if (a < 0) { return 0 - 1; }
    if (b < 0) { return 0 - 1; }
    var r = a + b;
    if (r < a) { return 0 - 1; }
    return r;
}

fn checked_mul(a, b) {
    if (a < 0) { return 0 - 1; }
    if (b < 0) { return 0 - 1; }
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var r = a * b;
    if (r / a != b) { return 0 - 1; }
    return r;
}

# Sum 4 non-negative sizes with overflow detection. Returns -1 on any
# negative input or any intermediate overflow. Unused slots: pass 0.
# Chosen arity keeps our worst alloc sites (audit/quarantine/oci_spec)
# coverable in one call — those stitch at most 4 user-lengths plus a
# bounded constant the caller adds separately.
fn checked_sum4(a, b, c, d) {
    var s = checked_add(a, b);
    if (s < 0) { return 0 - 1; }
    s = checked_add(s, c);
    if (s < 0) { return 0 - 1; }
    s = checked_add(s, d);
    if (s < 0) { return 0 - 1; }
    return s;
}

# Overflow-safe alloc: returns 0 (instead of aborting) if requested size
# is negative or exceeds the attacker-defense ceiling of 64 MiB per
# single allocation. 64 MiB is larger than any legitimate per-op buffer
# kavach allocates (OCI spec worst case ~2 MiB, audit line < 1 MiB).
fn alloc_checked(size) {
    if (size < 0) { return 0; }
    if (size > 67108864) { return 0; }
    return alloc(size);
}

# ---- input validation ----------------------------------------------------

# Reject control chars (NUL, BEL, ESC, …) while allowing tab/newline/CR.
# Prevents JSON injection, log forgery, and terminal escape smuggling.
# Returns 1 if safe, 0 otherwise.
#
# Reads the untrusted input through a bounds-checked slice (`sl[i]` lowers to
# the stdlib `_slice_idx_get_1`, which traps on out-of-range): on this
# security-relevant validation path a future off-by-one becomes a clean abort
# rather than an out-of-bounds read of attacker-influenced memory.
fn is_safe_text(s) {
    var n = strlen(s);
    var sl: [u8] = 0;
    slice_set(&sl, s, n);
    var i = 0;
    while (i < n) {
        var c = sl[i];
        if (c < 32) {
            if (c != 9) {
                if (c != 10) {
                    if (c != 13) { return 0; }
                }
            }
        }
        i = i + 1;
    }
    return 1;
}

# Stricter: reject newlines + CR too (used for command arguments where
# each line becomes a token and could smuggle extra args). Same
# bounds-checked-slice read of untrusted input as is_safe_text.
fn is_safe_argument(s) {
    var n = strlen(s);
    var sl: [u8] = 0;
    slice_set(&sl, s, n);
    var i = 0;
    while (i < n) {
        var c = sl[i];
        if (c < 32) {
            if (c != 9) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# ---- secure file I/O -----------------------------------------------------
# Open flags are the stdlib's O_* names, never literals: they differ by target —
# O_NOFOLLOW is 0x20000 on x86_64 but 0x8000 on aarch64, where 0x20000 is
# O_LARGEFILE. agnos gets the x86_64 values from lib/io.cyr, which file_open
# maps to its AO_* bits. Opens go through file_open, not sys_open: agnos's
# sys_open is (name, namelen, flags). Mode 0600 = 384.

# Human-readable name for a stdlib IoError variant — for the structured
# log/error line emitted on a failed external write (ADR-005 audit trail).
fn io_error_name(e) {
    if (e == IoNotFound) { return "not found"; }
    if (e == IoAccessDenied) { return "access denied"; }
    if (e == IoBadFd) { return "bad fd"; }
    if (e == IoFailed) { return "write incomplete"; }
    return "i/o error";
}

# Result-returning hardened write. Same O_EXCL|O_NOFOLLOW guarantee as
# file_write_secure (refuses to follow a symlink or clobber an existing file;
# mode 0600), but built on the stdlib `_r` primitives so the failure carries a
# distinguishable IoError (ENOENT vs EACCES vs ELOOP/EEXIST→IoOther) instead of
# a bare -1. NOTE: the stdlib file_write_all_r is deliberately NOT used — it
# opens O_WRONLY|O_CREAT|O_TRUNC without the O_EXCL|O_NOFOLLOW hardening
# (ADR-005 §C4). Returns Ok(len) or Err(IoError).
fn file_write_secure_r(path, buf, len): Result {
    var flags = O_WRONLY | O_CREAT | O_TRUNC | O_EXCL | O_NOFOLLOW;
    var fo_t, fo_v = file_open_r(path, flags, 384);
    if (is_err_result(fo_t) == 1) { return Err(fo_v); }
    var fd = result_unwrap(fo_t, fo_v);
    var wr_t, wr_v = file_write_r(fd, buf, len);
    file_close_r(fd);
    if (is_err_result(wr_t) == 1) { return Err(wr_v); }
    if (result_unwrap(wr_t, wr_v) != len) { return Err(IoFailed); }
    return Ok(len);
}

# Back-compat int wrapper: returns bytes written, or -1 on any failure.
# Existing callers that don't need the distinguished error keep using this.
fn file_write_secure(path, buf, len) {
    var fw_t, fw_v = file_write_secure_r(path, buf, len);
    return result_unwrap_or(fw_t, fw_v, 0 - 1);
}

# As file_write_secure, but honors a caller-supplied final mode via fchmod
# on the same fd that the write went through. Used by credential injection
# (ADR-005 §M2): the file is created mode 0600 by O_CREAT, the content
# lands while still 0600 (no other-readable window), then the fd is
# fchmod'd to the requested mode before close. Closing the fd between
# write and chmod would re-open a TOCTOU window — using fchmod on the
# same fd closes it.
#
# 3.12.6: `sys_fchmod` replaces a raw `syscall(91, ...)`. 91 is fchmod only on
# x86_64 — aarch64 runs capset — so off x86 the requested mode was silently
# never applied. A failed fchmod now fails the write instead of being ignored.
# agnos has no fchmod (91 there is gpu_blit_bb) and does not model POSIX modes
# (its stdlib sys_chmod is a success no-op), so no chmod is issued there. The
# open went through raw sys_open until 3.12.6, which on agnos passed the flags
# as the name length.
fn file_write_secure_modal(path, buf, len, mode) {
    var flags = O_WRONLY | O_CREAT | O_TRUNC | O_EXCL | O_NOFOLLOW;
    var fd = file_open(path, flags, 384);
    if (fd < 0) { return 0 - 1; }
    var n = sys_write(fd, buf, len);
    if (n < 0) { sys_close(fd); return 0 - 1; }
    if (n != len) { sys_close(fd); return 0 - 1; }
    #ifndef CYRIUS_TARGET_AGNOS
    if (sys_fchmod(fd, mode) < 0) { sys_close(fd); return 0 - 1; }
    #endif
    sys_close(fd);
    return n;
}

# ---- random bytes --------------------------------------------------------
# Fill `count` bytes of buf from the kernel CSPRNG via getrandom(2) (the
# stdlib random_bytes wrapper). Returns bytes filled, or -1 on failure. Used
# for unpredictable container ids — breaks the /tmp-symlink-precreate attack
# (ADR-005 §C3). getrandom needs no fd and works where /dev/urandom isn't
# mounted (chroot, landlocked, minimal mount ns) — strictly better for a
# sandbox tool than the old open/read/close on /dev/urandom. Blocks only
# until the kernel pool is seeded (immediate post-boot); flags=0, never
# GRND_INSECURE — the unpredictability is a security property here.
fn fill_random(buf, count) {
    var n = random_bytes(buf, count);
    if (n < 0) { return 0 - 1; }
    return n;
}

# Hex-encode `len` bytes from src into dst. dst must fit len*2 + 1 bytes.
fn hex_encode_bytes(src, len, dst) {
    var hex = "0123456789abcdef";
    var i = 0;
    while (i < len) {
        var b = load8(src + i);
        store8(dst + i * 2, load8(hex + ((b >> 4) & 15)));
        store8(dst + i * 2 + 1, load8(hex + (b & 15)));
        i = i + 1;
    }
    store8(dst + len * 2, 0);
    return 0;
}

# 16-char hex id from the kernel CSPRNG (8 random bytes × 2). Returns heap cstr.
fn rand_hex_id() {
    var raw[8];
    fill_random(&raw, 8);
    var out = alloc(17);
    hex_encode_bytes(&raw, 8, out);
    return out;
}

# 64-bit random from the kernel CSPRNG. Used for UUID-v4-equivalent internal
# IDs (sandbox, finding, quarantine entry). Collision probability across
# 2^32 entries is ~2^-32 — sufficient for correlation IDs. Falls back
# to 0 on failure (caller sees a duplicate, which is a visible bug
# rather than a silent TOCTOU).
fn rand_u64() {
    var raw[8];
    if (fill_random(&raw, 8) != 8) { return 0; }
    return load64(&raw);
}

# 32-char hex UUID-like id. Two u64 samples give 128 bits of randomness.
fn rand_uuid_hex() {
    var raw[16];
    fill_random(&raw, 16);
    var out = alloc(33);
    hex_encode_bytes(&raw, 16, out);
    return out;
}

# ---- secret redaction ----------------------------------------------------
# For evidence snippets that may contain an actual secret. Policy: show
# first 4 + '****' + last 4 if len > 8; otherwise full mask. Preserves
# signal (prefix identifies key type, e.g. 'AKIA****') without leaking
# the secret content.

fn redact_evidence(text, start, len) {
    if (len <= 8) {
        var mask = alloc(len + 1);
        memset(mask, 42, len);
        store8(mask + len, 0);
        return mask;
    }
    var buf = alloc(13);
    memcpy(buf, text + start, 4);
    memcpy(buf + 4, "****", 4);
    memcpy(buf + 8, text + start + len - 4, 4);
    store8(buf + 12, 0);
    return buf;
}

# ---- existing helpers ----------------------------------------------------

fn ch_ascii_lower(c) {
    if (c >= 65) {
        if (c <= 90) { return c + 32; }
    }
    return c;
}

# Case-insensitive null-terminated string equality. 1 = equal, 0 = not.
fn strieq(a, b) {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ch_ascii_lower(ca) != ch_ascii_lower(cb)) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Split a command line on runs of spaces/tabs into a vec of cstr tokens.
#
# Lives here rather than in a backend because BOTH the process backend and the
# OCI spec generator need it — the OCI spec must emit `process.args` as real
# argv, not a `/bin/sh -c` string, or any image without a shell (distroless,
# scratch, a single static binary) cannot run.
fn _split_command(cmdline) {
    var args = vec_new();
    var n = strlen(cmdline);
    var i = 0;
    while (i < n) {
        while (i < n) {
            var c = load8(cmdline + i);
            if (c != 32) { if (c != 9) { break; } }
            i = i + 1;
        }
        if (i >= n) { break; }
        var start = i;
        while (i < n) {
            var c = load8(cmdline + i);
            if (c == 32) { break; }
            if (c == 9) { break; }
            i = i + 1;
        }
        var len = i - start;
        var tok = alloc(len + 1);
        memcpy(tok, cmdline + start, len);
        store8(tok + len, 0);
        vec_push(args, tok);
    }
    return args;
}

# Sleep `ms` milliseconds.
#
# 3.11.4: the drain loop in `confine_capture` polls a non-blocking pipe, and
# without a sleep between reads it burns a full core for as long as the payload
# runs. agnosai measured exactly that shape in its own capture — 100% CPU for
# the duration of a `sleep 2` — before adding the idle sleep.
fn kv_sleep_ms(ms): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # sys_nanosleep carries each architecture's number. Until 3.12.8 this was a
    # raw 35, right on aarch64 only through cyrius's translation row (since
    # 6.6.5; before that, aarch64 ran it as unlinkat).
    var ts[16];
    store64(&ts, ms / 1000);
    store64(&ts + 8, (ms % 1000) * 1000000);
    return sys_nanosleep(&ts, 0);
    #endif
}

# --- generic string helpers, lifted out of scanning_code.cyr at 3.12.3 ---------------------------------
#
# ⚠ They live HERE, not in the code scanner where they were written, because `scanning_runtime.cyr` also
# calls them — which meant the [lib.confine] profile could not close without dragging the entire code
# scanner (and its 25 pattern groups) into a bundle whose whole point is to carry only the confinement
# path. Cyrius has ONE flat namespace, so every existing caller is unaffected by the move.

# Copy src (null-terminated) into dst, ascii-lowered. dst must be sized.
fn str_to_lower_into(src, dst) {
    var i = 0;
    while (1 == 1) {
        var c = load8(src + i);
        store8(dst + i, ch_ascii_lower(c));
        if (c == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# 1 if haystack contains needle (both null-terminated cstrs). Linear search.
fn cstr_contains(haystack, needle) {
    var hlen = strlen(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var i = 0;
    while (i + nlen <= hlen) {
        var j = 0;
        while (j < nlen) {
            if (load8(haystack + i + j) != load8(needle + j)) { break; }
            j = j + 1;
        }
        if (j == nlen) { return 1; }
        i = i + 1;
    }
    return 0;
}

# --- error.cyr ---

# kavach — error codes
# Ported from rust-old/src/error.rs
#
# Members are namespaced `KAVACH_ERR_*` — the same crate-name prefix
# convention as `SysErrorKind` (src/sys_error.cyr). Cyrius hoists enum
# members to global constants under "last definition wins", and qualified
# `KavachError.X` access is only sugar for that hoisted global (verified:
# a two-enum consumer probe had `KavachError.OK` resolve to a later dep's
# generic `OK`, not 0). Bare generic names (`OK`, `TIMEOUT`, `IO_ERROR`,
# `OTHER`) would therefore silently collide with any dep minting the same
# names — in either direction. The `KAVACH_ERR_*` prefix keeps every member
# globally unique so no consumer surface can clash. See ADR-006 §4.

enum KavachError {
    KAVACH_ERR_OK = 0;
    KAVACH_ERR_BACKEND_UNAVAILABLE = 1;
    KAVACH_ERR_CREATION_FAILED = 2;
    KAVACH_ERR_EXEC_FAILED = 3;
    KAVACH_ERR_TIMEOUT = 4;
    KAVACH_ERR_POLICY_VIOLATION = 5;
    KAVACH_ERR_CREDENTIAL_ERROR = 6;
    KAVACH_ERR_INVALID_TRANSITION = 7;
    KAVACH_ERR_EXTERNALIZATION_BLOCKED = 8;
    KAVACH_ERR_IO_ERROR = 9;
    KAVACH_ERR_OTHER = 10;
}

fn kavach_err_name(code) {
    if (code == KAVACH_ERR_OK) { return "ok"; }
    if (code == KAVACH_ERR_BACKEND_UNAVAILABLE) { return "backend not available"; }
    if (code == KAVACH_ERR_CREATION_FAILED) { return "sandbox creation failed"; }
    if (code == KAVACH_ERR_EXEC_FAILED) { return "sandbox execution failed"; }
    if (code == KAVACH_ERR_TIMEOUT) { return "sandbox timeout"; }
    if (code == KAVACH_ERR_POLICY_VIOLATION) { return "policy violation"; }
    if (code == KAVACH_ERR_CREDENTIAL_ERROR) { return "credential error"; }
    if (code == KAVACH_ERR_INVALID_TRANSITION) { return "lifecycle error"; }
    if (code == KAVACH_ERR_EXTERNALIZATION_BLOCKED) { return "externalization blocked"; }
    if (code == KAVACH_ERR_IO_ERROR) { return "i/o error"; }
    if (code == KAVACH_ERR_OTHER) { return "error"; }
    return "unknown error";
}

fn kavach_err_print(code, detail) {
    var name = kavach_err_name(code);
    # Diagnostics to stderr (fd 2) via the stdlib write wrapper — no raw
    # syscall/magic number. Lengths are strlen of NUL-terminated cstrs or
    # literal byte counts of fixed strings (S3).
    sys_write(2, "kavach: ", 8);
    sys_write(2, name, strlen(name));
    if (detail != 0) {
        sys_write(2, ": ", 2);
        sys_write(2, detail, strlen(detail));
    }
    sys_write(2, "\n", 1);
    return 0;
}

# --- sys_error.cyr ---

# error.cyr — unified error type with errno mapping
# Ported from rust-old/src/error.rs
#
# In Cyrius, errors are integer codes. The SysError "enum" becomes
# integer constants, and error messages are string pointers.
#
# Error representation: a Result (tagged union from lib/tagged.cyr)
# where Err payload is a pointer to an error struct:
#   { kind: i64, errno: i64, message: *str }
#
# Convention: all agnosys functions return Result values.
# Ok(value) on success, Err(err_ptr) on failure.

# ================================================================
# Error kind constants (maps to Rust SysError variants)
# ================================================================

enum SysErrorKind {
    KAVACH_ERR_SYSCALL_FAILED = 1;
    KAVACH_ERR_INVALID_ARGUMENT = 2;
    KAVACH_ERR_PERMISSION_DENIED = 3;
    KAVACH_ERR_WOULD_BLOCK = 4;
    KAVACH_ERR_MODULE_NOT_LOADED = 5;
    KAVACH_ERR_NOT_SUPPORTED = 6;
    KAVACH_ERR_UNKNOWN = 7;
    KAVACH_ERR_IO = 8;
}

# ================================================================
# Errno constants (Linux x86_64)
# ================================================================

enum Errno {
    EPERM = 1;
    ENOENT = 2;
    ESRCH = 3;
    EINTR = 4;
    EIO = 5;
    ENXIO = 6;
    EBADF = 9;
    EAGAIN = 11;
    ENOMEM = 12;
    EACCES = 13;
    EFAULT = 14;
    EBUSY = 16;
    EEXIST = 17;
    ENODEV = 19;
    ENOTDIR = 20;
    EISDIR = 21;
    EINVAL = 22;
    EMFILE = 24;
    ENOSPC = 28;
    EPIPE = 32;
    ERANGE = 34;
    ENOSYS = 38;
    ENOTEMPTY = 39;
    ENODATA = 61;
    EOVERFLOW = 75;
    EOPNOTSUPP = 95;
    EADDRINUSE = 98;
    ECONNREFUSED = 111;
    ETIMEDOUT = 110;
}

# ================================================================
# Error struct: { kind, errno, message_ptr }
# Layout: kind at +0, errno at +8, message at +16. Total: 24 bytes.
# ================================================================

# ================================================================
# Error representation — dual encoding
# ================================================================
#
# Packed error: kind << 16 | errno (no message, no heap, value < 0x100000)
# Heap error:   pointer to { kind, errno, message_ptr } (24 bytes, value >= 0x100000)
#
# kavach_syserr_kind/errno/message dispatch on the value automatically.

# Pack kind + errno into a single integer (zero allocation)
fn kavach_syserr_pack(kind, errno): i64 {
    return kind << 16 | errno;
}

# Create a new error with message (heap-allocated, cold path)
fn kavach_syserr_new(kind, errno, message): i64 {
    var e = alloc(24);
    store64(e, kind);
    store64(e + 8, errno);
    store64(e + 16, message);
    return e;
}

# Get error kind (works for both packed and heap errors)
fn kavach_syserr_kind(e): i64 {
    if (e < 0x100000) { return e >> 16; }
    return load64(e);
}

# Get errno value (works for both packed and heap errors)
fn kavach_syserr_errno(e): i64 {
    if (e < 0x100000) { return e & 0xFFFF; }
    return load64(e + 8);
}

# Get error message pointer (0 for packed errors)
fn kavach_syserr_message(e): i64 {
    if (e < 0x100000) { return 0; }
    return load64(e + 16);
}

# ================================================================
# Error constructors — packed (fast, no alloc)
# ================================================================

fn kavach_err_syscall_failed_nr(errno): i64 {
    return Err(kavach_syserr_pack(KAVACH_ERR_SYSCALL_FAILED, errno));
}

fn kavach_err_permission_denied_nr(errno): i64 {
    return Err(kavach_syserr_pack(KAVACH_ERR_PERMISSION_DENIED, errno));
}

fn kavach_err_would_block(): i64 {
    return Err(kavach_syserr_pack(KAVACH_ERR_WOULD_BLOCK, EAGAIN));
}

fn kavach_err_invalid_argument_nr(): i64 {
    return Err(kavach_syserr_pack(KAVACH_ERR_INVALID_ARGUMENT, EINVAL));
}

fn kavach_err_not_supported_nr(): i64 {
    return Err(kavach_syserr_pack(KAVACH_ERR_NOT_SUPPORTED, ENOSYS));
}

# ================================================================
# Error constructors — with message (heap, cold path)
# ================================================================

fn kavach_err_syscall_failed(errno, message): i64 {
    return Err(kavach_syserr_new(KAVACH_ERR_SYSCALL_FAILED, errno, message));
}

fn kavach_err_invalid_argument(message): i64 {
    return Err(kavach_syserr_new(KAVACH_ERR_INVALID_ARGUMENT, EINVAL, message));
}

fn kavach_err_permission_denied(operation): i64 {
    return Err(kavach_syserr_new(KAVACH_ERR_PERMISSION_DENIED, EPERM, operation));
}

fn kavach_err_module_not_loaded(module): i64 {
    return Err(kavach_syserr_new(KAVACH_ERR_MODULE_NOT_LOADED, ENODEV, module));
}

fn kavach_err_not_supported(feature): i64 {
    return Err(kavach_syserr_new(KAVACH_ERR_NOT_SUPPORTED, ENOSYS, feature));
}

fn kavach_err_unknown(message): i64 {
    return Err(kavach_syserr_new(KAVACH_ERR_UNKNOWN, 0, message));
}

fn kavach_err_io(errno, message): i64 {
    return Err(kavach_syserr_new(KAVACH_ERR_IO, errno, message));
}

# ================================================================
# Errno-based error creation — packed (zero alloc, hot path)
# ================================================================

fn kavach_err_from_errno(errno): i64 {
    if (errno == EPERM) { return kavach_err_permission_denied_nr(EPERM); }
    if (errno == EACCES) { return kavach_err_permission_denied_nr(EACCES); }
    if (errno == EAGAIN) { return kavach_err_would_block(); }
    if (errno == EINVAL) { return kavach_err_invalid_argument_nr(); }
    if (errno == ENOSYS) { return kavach_err_not_supported_nr(); }
    return kavach_err_syscall_failed_nr(errno);
}

fn kavach_err_from_syscall_ret(ret): i64 {
    var errno = 0 - ret;
    return kavach_err_from_errno(errno);
}

# ================================================================
# Error printing
# ================================================================

fn kavach_syserr_print(e): i64 {
    var kind = kavach_syserr_kind(e);
    var msg = kavach_syserr_message(e);
    var msglen = 0;
    if (msg != 0) { msglen = strlen(msg); }

    # Exhaustive match — every SysErrorKind variant explicit so cyrius
    # lint catches any future addition that misses a handler. No
    # `_ =>` opt-out: a missing variant should fail loud (fall through
    # to the trailing newline + return) rather than silently degrade.
    match kind {
        KAVACH_ERR_SYSCALL_FAILED => {
            sys_write(2, "syscall failed (errno ", 22);
            var ebuf[24];
            var elen = fmt_int_buf(kavach_syserr_errno(e), &ebuf);
            sys_write(2, &ebuf, elen);
            sys_write(2, "): ", 3);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_INVALID_ARGUMENT => {
            sys_write(2, "invalid argument: ", 18);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_PERMISSION_DENIED => {
            sys_write(2, "permission denied: ", 19);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_WOULD_BLOCK => {
            sys_write(2, "resource temporarily unavailable", 32);
        }
        KAVACH_ERR_MODULE_NOT_LOADED => {
            sys_write(2, "kernel module not loaded: ", 26);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_NOT_SUPPORTED => {
            sys_write(2, "feature not supported: ", 23);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_UNKNOWN => {
            sys_write(2, "unknown error: ", 15);
            sys_write(2, msg, msglen);
        }
        KAVACH_ERR_IO => {
            sys_write(2, "io error (errno ", 16);
            var ibuf[24];
            var ilen = fmt_int_buf(kavach_syserr_errno(e), &ibuf);
            sys_write(2, &ibuf, ilen);
            sys_write(2, "): ", 3);
            sys_write(2, msg, msglen);
        }
    }
    sys_write(2, "\n", 1);
    return 0;
}

# Print error from a Result if it's Err, then return the error code.
# Returns 0 if the Result is Ok.
# 6.6.0 value form: a Result is a register PAIR, so both halves must be passed —
# `var t, v = f(); kavach_result_print_err(t, v);`. Was 1-arg over the boxed form.
# ⚠ Named `kavach_` since 3.12.9, like the `kavach_syserr_*` accessors above.
# sigil and agnodrm each define `result_print_err` and `syserr_*` from the same
# agnosys fork, and under "last definition wins" only one copy survives in a
# consumer. When kavach's took 1 argument and sigil's 2, every call to the loser
# silently mis-bound; matching the signature (6.6.0) only hid the collision.
fn kavach_result_print_err(res_tag, res): i64 {
    if (is_ok(res_tag) == 1) { return 0; }
    var e = res;
    kavach_syserr_print(e);
    return kavach_syserr_errno(e);
}

# ================================================================
# Result helpers for agnosys convention
# ================================================================

# Propagate error: if res is Err, return it immediately.
# Use at top of functions: var val = try_unwrap(res); if (val == 0) { ... }
# Note: Cyrius has no ? operator, so error propagation is manual.
# Pattern:
#   var res_t, res_v = some_call();
#   if (is_err_result(res_t) == 1) { return Err(res_v); }
#   var val = res_v;
# ⛔ NOT `return res_t;` and NOT `return res_v;`. Returning the payload alone
#    delivers Err(77) to the caller as tag=77 / is_err_result==0 — an error that
#    reads as SUCCESS. That shape cost yukti 19 silent defects at the flip.

# (`is_syscall_err` and `wrap_syscall` lived here until 3.12.9: no caller in
# kavach or any consumer, and sigil and agnodrm define the same two names.)

# --- sys_util.cyr ---

# sys_util.cyr — a helper carried over from the agnosys fold (v3.5.0).
#
# Until 3.12.9 this file held seven `agnosys_*` helpers. sigil defines the same
# seven names from the same agnosys fork, so under last-definition-wins only one
# copy of each survived in a consumer, chosen by source order. Six had no caller
# in kavach or any consumer and were removed; one of those, `agnosys_run_checked`,
# still exec'd by path through the stdlib's `exec_vec`. The one in use is renamed
# `kavach_` below (ADR-006 §4).

# Emit a JSON value for a possibly-null C string into a str_builder:
# `null` when the pointer is 0, otherwise a JSON-quoted/escaped string.
fn kavach_json_emit_cstr_or_null(sb, c): i64 {
    if (c == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_json_str(sb, str_from(c));
    }
    return 0;
}

# --- security.cyr ---

# security.cyr — Landlock, seccomp BPF, namespace creation
# Ported from rust-old/src/security.rs
#
# Provides Landlock filesystem sandboxing, seccomp-BPF syscall filtering,
# and Linux namespace creation via raw syscalls.

#define LINUX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "lib/hashmap.cyr"

# ================================================================
# Landlock constants (kernel 5.13+)
# ================================================================
#
# SYS_LANDLOCK_* numbers are arch-invariant and now provided by
# lib/syscalls.cyr (cyrius 5.7.x). SYS_PRCTL is arch-varying and comes from
# the same place, one number per Linux peer.

# **The full ABI v1 right set, plus the two later additions.**
#
# Until 3.11.1 only READ_FILE, READ_DIR and WRITE_FILE were declared, and only
# those three went into `handled_access_fs`. **Landlock restricts ONLY the
# rights named there and leaves every other right fully permitted**, so a
# confined process could still delete any file on the host, create directories
# anywhere, and exec any binary — while the obvious smoke test ("cannot read
# /etc/passwd") passed, because reading was one of the three that *were*
# handled. Reported by agnosai with a runnable probe; the filing is in
# `docs/development/issues/`, dated 2026-08-03.
enum LandlockConst {
    LANDLOCK_ACCESS_FS_EXECUTE = 1;
    LANDLOCK_ACCESS_FS_WRITE_FILE = 2;
    LANDLOCK_ACCESS_FS_READ_FILE = 4;
    LANDLOCK_ACCESS_FS_READ_DIR = 8;
    LANDLOCK_ACCESS_FS_REMOVE_DIR = 16;
    LANDLOCK_ACCESS_FS_REMOVE_FILE = 32;
    LANDLOCK_ACCESS_FS_MAKE_CHAR = 64;
    LANDLOCK_ACCESS_FS_MAKE_DIR = 128;
    LANDLOCK_ACCESS_FS_MAKE_REG = 256;
    LANDLOCK_ACCESS_FS_MAKE_SOCK = 512;
    LANDLOCK_ACCESS_FS_MAKE_FIFO = 1024;
    LANDLOCK_ACCESS_FS_MAKE_BLOCK = 2048;
    LANDLOCK_ACCESS_FS_MAKE_SYM = 4096;
    LANDLOCK_ACCESS_FS_REFER = 8192;
    LANDLOCK_ACCESS_FS_TRUNCATE = 16384;
    # ABI v5: ioctl on a character or block device opened under the ruleset.
    LANDLOCK_ACCESS_FS_IOCTL_DEV = 32768;
    # ABI v6 scopes: a process may reach an abstract unix socket, or signal a
    # process, only inside its own landlock domain.
    LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET = 1;
    LANDLOCK_SCOPE_SIGNAL = 2;
    # ABI v4 network rights (3.14.8): bind and connect a TCP socket. A ruleset
    # handling them refuses both with EACCES, except to a port a NET_PORT rule
    # names. UDP, raw and unix sockets are not landlock network rights.
    LANDLOCK_ACCESS_NET_BIND_TCP = 1;
    LANDLOCK_ACCESS_NET_CONNECT_TCP = 2;
    LANDLOCK_RULE_PATH_BENEATH = 1;
    LANDLOCK_RULE_NET_PORT = 2;
    # Flag to `landlock_create_ruleset` that asks for the ABI version instead of
    # creating a ruleset. Returns the version as a positive integer.
    LANDLOCK_CREATE_RULESET_VERSION = 1;
}

# The ABI v1 rights — every kernel with Landlock at all accepts these.
fn _landlock_rights_v1(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR
    | LANDLOCK_ACCESS_FS_REMOVE_DIR | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM;
}

# The running kernel's Landlock ABI version, or 0 if Landlock is unavailable.
#
# **This query is not optional.** `landlock_create_ruleset` fails with EINVAL if
# `handled_access_fs` names a right the running ABI does not know, so naming
# REFER (v2) or TRUNCATE (v3) unconditionally would turn a working sandbox into
# a hard error on any kernel older than 6.2.
fn security_landlock_abi_version(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var v = syscall(SYS_LANDLOCK_CREATE_RULESET, 0, 0, LANDLOCK_CREATE_RULESET_VERSION);
    if (v < 0) { return 0; }
    return v;
    #endif
}

# Every right this kernel will accept in `handled_access_fs`.
#
# Masking down by ABI rather than up: the v1 set is the floor, and the later
# rights are added only where the kernel knows them. IOCTL_DEV (v5) is handled
# since 3.13.2; before, no kavach ruleset restricted ioctl on a device file.
fn _landlock_handled_access(abi): i64 {
    var mask = _landlock_rights_v1();
    if (abi >= 2) { mask = mask | LANDLOCK_ACCESS_FS_REFER; }
    if (abi >= 3) { mask = mask | LANDLOCK_ACCESS_FS_TRUNCATE; }
    if (abi >= 5) { mask = mask | LANDLOCK_ACCESS_FS_IOCTL_DEV; }
    return mask;
}

# The rights granted **inside** a path opened read-only.
#
# EXECUTE is included deliberately. Before 3.11.1 it was permitted *everywhere*
# because it was unhandled, and a sandbox that read-only-mounts `/usr` in order
# to run `/usr/bin/python3` is the normal case — withholding it here would turn
# a security fix into a breaking change for every such consumer. Granting it
# only within allowed paths is strictly tighter than the old behaviour while
# keeping that case working.
fn _landlock_allow_read_only(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_READ_FILE
    | LANDLOCK_ACCESS_FS_READ_DIR;
}

# The rights granted **inside** a path opened read-write.
#
# The read-only set plus every mutation right, so a sandboxed process retains
# full control of its own writable area — create, delete, truncate, and (on ABI
# v2+) rename across two of its own allowed directories. Outside those paths all
# of it is now denied, which is the actual fix.
#
# IOCTL_DEV (ABI v5, since 3.13.2) is a read-write right only, as WRITE_FILE is:
# an ioctl on a device drives it. A read-only rule leaves a device readable and
# its ioctls refused, and descriptors opened before the ruleset, the payload's
# stdio among them, are not affected.
fn _landlock_allow_read_write(abi): i64 {
    var mask = _landlock_allow_read_only() | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_REMOVE_DIR | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM;
    if (abi >= 2) { mask = mask | LANDLOCK_ACCESS_FS_REFER; }
    if (abi >= 3) { mask = mask | LANDLOCK_ACCESS_FS_TRUNCATE; }
    if (abi >= 5) { mask = mask | LANDLOCK_ACCESS_FS_IOCTL_DEV; }
    return mask;
}

# The rights a rule naming a file, not a directory, can hold: the kernel's
# ACCESS_FILE. `landlock_add_rule` refuses any other right on a non-directory
# with EINVAL. Measured one right at a time on 7.2.6 (ABI 10): EXECUTE,
# WRITE_FILE, READ_FILE, TRUNCATE and IOCTL_DEV are taken on a file, and
# READ_DIR, the REMOVE_* and MAKE_* rights and REFER are refused.
#
# Masked with a rule's rights, this keeps TRUNCATE (ABI v3) and IOCTL_DEV (ABI
# v5) only where the rule had them, which `_landlock_allow_read_write` gives. A
# rule may grant only rights the ruleset handles, so neither can reach a kernel
# older than its ABI.
fn _landlock_file_rights(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_TRUNCATE
    | LANDLOCK_ACCESS_FS_IOCTL_DEV;
}

# Filesystem access levels
enum FsAccess {
    FS_NO_ACCESS = 0;
    FS_READ_ONLY = 1;
    FS_READ_WRITE = 2;
}

# Filesystem rule: { path_ptr, access }
# path_ptr is a null-terminated C string pointer
fn security_fs_rule_new(path, access): i64 {
    var r = alloc(16);
    store64(r, path);
    store64(r + 8, access);
    return r;
}

fn security_fs_rule_path(r): i64 { return load64(r); }
fn security_fs_rule_access(r): i64 { return load64(r + 8); }

fn security_fs_rule_read_only(path): i64 { return security_fs_rule_new(path, FS_READ_ONLY); }
fn security_fs_rule_read_write(path): i64 { return security_fs_rule_new(path, FS_READ_WRITE); }

# ================================================================
# Apply Landlock filesystem restrictions
# ================================================================

# rules: vec of fs_rule pointers, count: number of rules
# Returns Result: Ok(0) on success, Err on failure.
fn security_apply_landlock(rules, count): i64 {
    return security_apply_landlock_scoped(rules, count, 0);
}

# The same, with landlock scopes (ABI v6, applied since 3.13.2). `scopes` is a
# mask of LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET and LANDLOCK_SCOPE_SIGNAL: the
# process may then connect to an abstract unix socket, or signal a process,
# only inside its own landlock domain. A ruleset of scopes alone handles no
# filesystem right, so `count == 0` with a scope still installs one. A kernel
# older than ABI v6 cannot express a scope, and the scopes are left out there,
# as a kernel without landlock leaves out the whole ruleset.
fn security_apply_landlock_scoped(rules, count, scopes): i64 {
    if (count <= 0 && scopes == 0) { return Ok(0); }

    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no Landlock (a Linux LSM/MAC primitive). FS confinement on AGNOS
    # is the capability layer's responsibility, so report a structured "unsupported
    # on this platform" the system process can surface + branch on — the same way
    # mac.cyr handles SELinux/AppArmor and kernel_audit.cyr handles NETLINK_AUDIT.
    # This is deliberately NOT a silent Ok(0): a silent success would falsely imply
    # the sandbox's FS rules were enforced. Transitional — until AGNOS ships its own
    # FS-confinement mechanism (the native capability-layer Landlock-equivalent),
    # at which point this branch calls that instead of returning unsupported.
    return kavach_err_not_supported("LANDLOCK");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS

    # 3.11.1 — every right the running kernel knows, not the three that happened
    # to be declared. Unhandled rights are PERMITTED by Landlock, so the mask is
    # the entire security surface.
    var abi = security_landlock_abi_version();
    if (abi == 0) { return Ok(0); }
    var handled_access = 0;
    if (count > 0) { handled_access = _landlock_handled_access(abi); }
    var scoped = 0;
    if (abi >= 6) {
        scoped = scopes & (LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET | LANDLOCK_SCOPE_SIGNAL);
    }
    if (handled_access == 0 && scoped == 0) { return Ok(0); }

    # SAFETY: LandlockRulesetAttr is { handled_access_fs: u64,
    # handled_access_net: u64 (ABI v4), scoped: u64 (ABI v6) }, 24 bytes, and
    # `attr` is 24 bytes. Function-local `var X[N]` is N BYTES (cyrius 6.3.13
    # moved these to the guard-paged thread stack), so every store64 below lands
    # inside it. With no scope only the first 8 bytes are passed, the struct
    # every landlock kernel knows; an older kernel refuses a longer one whose
    # tail it cannot read as zero.
    var attr[24];
    store64(&attr, handled_access);
    store64(&attr + 8, 0);
    store64(&attr + 16, scoped);
    var attr_size = 8;
    if (scoped != 0) { attr_size = 24; }

    var ruleset_fd = syscall(SYS_LANDLOCK_CREATE_RULESET, &attr, attr_size, 0);
    if (ruleset_fd < 0) {
        var errno = 0 - ruleset_fd;
        if (errno == ENOSYS) { return Ok(0); }
        if (errno == EOPNOTSUPP) { return Ok(0); }
        return kavach_err_syscall_failed(errno, "landlock_create_ruleset failed");
    }
    defer { syscall(SYS_CLOSE, ruleset_fd); }

    var walk_t, walk_v = _landlock_add_rules(ruleset_fd, rules, count, abi);
    if (is_err_result(walk_t) == 1) { return Err(walk_v); }

    # Set no_new_privs (required by Landlock)
    var ret = syscall(SYS_PRCTL, 38, 1, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_NO_NEW_PRIVS failed");
    }

    ret = syscall(SYS_LANDLOCK_RESTRICT_SELF, ruleset_fd, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "landlock_restrict_self failed");
    }

    return Ok(0);
    #endif
}

# Add the first `count` rules of `rules` to `ruleset_fd`, at `abi`. Ok(0) or Err.
fn _landlock_add_rules(ruleset_fd, rules, count, abi): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return kavach_err_not_supported("LANDLOCK");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 3.11.3: bound the walk by the list as well as the count. A caller asking
    # for a ruleset with **no** path-beneath rules — total filesystem denial,
    # which `policy_landlock_deny_all` expresses as a non-zero count over an
    # empty list — must create and enforce the ruleset without indexing past
    # the end of it. `count == 0` with no scope still means "no landlock at
    # all", which is a different request and stays different; with a scope it
    # is a ruleset handling no filesystem right, and the walk adds nothing.
    var walk = count;
    if (walk < 0) { walk = 0; }
    if (rules == 0) { walk = 0; }
    else { if (vec_len(rules) < walk) { walk = vec_len(rules); } }

    var idx = 0;
    while (idx < walk) {
        var rule = vec_get(rules, idx);
        var access = security_fs_rule_access(rule);

        var allowed_access = 0;
        if (access == FS_READ_ONLY) {
            allowed_access = _landlock_allow_read_only();
        }
        elif (access == FS_READ_WRITE) {
            allowed_access = _landlock_allow_read_write(abi);
        }

        if (allowed_access != 0) {
            var path = security_fs_rule_path(rule);
            # O_PATH = 0x200000, O_CLOEXEC = 0x80000
            var path_fd = sys_open(path, 0x280000, 0);
            if (path_fd < 0) {
                return kavach_err_syscall_failed(0 - path_fd, "landlock open path failed");
            }

            # A rule naming a file (anything but a directory, the open having
            # followed a symlink) grants that file alone, and takes only the
            # rights a file can hold. Until this was masked, the directory
            # rights in both access masks made `landlock_add_rule` refuse every
            # file rule with EINVAL, so any policy naming a file failed its exec
            # closed (exit 124).
            # SAFETY: `st` is 144 bytes, no smaller than struct stat on x86-64
            # (144) or aarch64 (128), and STAT_MODE is the stdlib's per-arch
            # offset of the 32-bit st_mode inside it.
            var st[144];
            var sr = sys_fstat(path_fd, &st);
            if (sr < 0) {
                syscall(SYS_CLOSE, path_fd);
                return kavach_err_syscall_failed(0 - sr, "landlock stat path failed");
            }
            if ((load32(&st + STAT_MODE) & 61440) != 16384) {   # not S_IFDIR
                allowed_access = allowed_access & _landlock_file_rights();
            }

            # LandlockPathBeneathAttr: { allowed_access: u64, parent_fd: i32 }
            # Layout: 8 bytes access + 4 bytes fd = 12 bytes (pad to 16)
            var beneath[16];
            store64(&beneath, allowed_access);
            store32(&beneath + 8, path_fd);

            var ret = syscall(SYS_LANDLOCK_ADD_RULE,
              ruleset_fd, LANDLOCK_RULE_PATH_BENEATH, &beneath, 0);
            syscall(SYS_CLOSE, path_fd);

            if (ret < 0) {
                return kavach_err_syscall_failed(0 - ret, "landlock_add_rule failed");
            }
        }
        idx = idx + 1;
    }

    return Ok(0);
    #endif
}

# A landlock domain for a payload (3.14.8): the policy's filesystem rules and
# scopes as `security_apply_landlock_scoped` takes them, its network, and a domain
# whatever else it asks for. Returns Ok(0), or Err when a ruleset was due and could
# not be applied. A kernel with no landlock gets none, as before.
#
#   - **Always a domain.** A process inside a landlock domain may ptrace, and so
#     reach through `/proc/<pid>/root`, only a process in that domain or one below
#     it. Through 3.14.7 a payload with a caller's `/proc` read a file in a sibling
#     sandbox's root, as root, under both policies: the sibling held the same
#     twelve capabilities, which is all the ptrace check compared. Each payload now
#     has a domain of its own, and with ABI v6 its signals stay inside it too
#     (LANDLOCK_SCOPE_SIGNAL), so a root payload holding CAP_KILL signals neither a
#     sibling nor kavach. A kernel below ABI v6 with nothing else to handle gets a
#     ruleset that handles one right, making a block device, and allows it beneath
#     "/": every path is allowed, and the domain is there.
#   - **The network** (ABI v4). `net_deny` 1 handles TCP bind and connect, so both
#     read EACCES, with no namespace and no privilege: agnosai filed that a policy
#     denying network was enforced only by a network namespace, which Ubuntu 24.04,
#     docker's default seccomp profile and GitHub's runners refuse to an
#     unprivileged process. `tcp_bind` and `tcp_connect` are vecs of ports the
#     payload may still bind or connect to (`policy_network_allow_tcp`), or 0.
#     Below ABI v4 the network part is left out, as a scope is below ABI v6.
#
# ⚠ Landlock's network rights are plain TCP's: measured, an MPTCP connect and an
# SCTP connect go out past them. UDP, raw sockets, the other families and io_uring
# are refused by `security_net_seccomp_filter` instead, which the confinement
# sequence loads beside this ruleset wherever it hands it `net_deny`.
fn security_apply_landlock_domain(rules, count, scopes, net_deny, tcp_bind, tcp_connect): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return kavach_err_not_supported("LANDLOCK");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var abi = security_landlock_abi_version();
    if (abi == 0) { return Ok(0); }
    var handled_fs = 0;
    if (count > 0) { handled_fs = _landlock_handled_access(abi); }
    var scoped = 0;
    if (abi >= 6) {
        scoped = (scopes & (LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET | LANDLOCK_SCOPE_SIGNAL))
        | LANDLOCK_SCOPE_SIGNAL;
    }
    var handled_net = 0;
    if (net_deny == 1 && abi >= 4) {
        handled_net = LANDLOCK_ACCESS_NET_BIND_TCP | LANDLOCK_ACCESS_NET_CONNECT_TCP;
    }
    var allow_all = 0;
    if (handled_fs == 0 && scoped == 0 && handled_net == 0) {
        handled_fs = LANDLOCK_ACCESS_FS_MAKE_BLOCK;
        allow_all = 1;
    }

    # SAFETY: LandlockRulesetAttr is { handled_access_fs: u64, handled_access_net:
    # u64 (ABI v4), scoped: u64 (ABI v6) }, 24 bytes, and `attr` is 24 bytes, so
    # every store64 lands inside it. The size passed is the shortest that holds
    # what is set, so a kernel that cannot read a tail it does not know is never
    # handed one.
    var attr[24];
    store64(&attr, handled_fs);
    store64(&attr + 8, handled_net);
    store64(&attr + 16, scoped);
    var attr_size = 8;
    if (handled_net != 0) { attr_size = 16; }
    if (scoped != 0) { attr_size = 24; }
    var ruleset_fd = syscall(SYS_LANDLOCK_CREATE_RULESET, &attr, attr_size, 0);
    if (ruleset_fd < 0) {
        var errno = 0 - ruleset_fd;
        if (errno == ENOSYS) { return Ok(0); }
        if (errno == EOPNOTSUPP) { return Ok(0); }
        return kavach_err_syscall_failed(errno, "landlock_create_ruleset failed");
    }
    defer { syscall(SYS_CLOSE, ruleset_fd); }

    if (allow_all == 1) {
        var all_t, all_v = _landlock_add_path(ruleset_fd, "/", LANDLOCK_ACCESS_FS_MAKE_BLOCK);
        if (is_err_result(all_t) == 1) { return Err(all_v); }
    } else {
        if (count > 0) {
            var add_t, add_v = _landlock_add_rules(ruleset_fd, rules, count, abi);
            if (is_err_result(add_t) == 1) { return Err(add_v); }
        }
    }
    if (handled_net != 0) {
        var pb_t, pb_v = _landlock_add_ports(ruleset_fd, tcp_bind, LANDLOCK_ACCESS_NET_BIND_TCP);
        if (is_err_result(pb_t) == 1) { return Err(pb_v); }
        var pc_t, pc_v = _landlock_add_ports(ruleset_fd, tcp_connect, LANDLOCK_ACCESS_NET_CONNECT_TCP);
        if (is_err_result(pc_t) == 1) { return Err(pc_v); }
    }

    var ret = syscall(SYS_PRCTL, 38, 1, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_NO_NEW_PRIVS failed");
    }
    ret = syscall(SYS_LANDLOCK_RESTRICT_SELF, ruleset_fd, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "landlock_restrict_self failed");
    }
    return Ok(0);
    #endif
}

# One path-beneath rule granting `access` under `path`. Ok(0) or Err.
fn _landlock_add_path(ruleset_fd, path, access): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return kavach_err_not_supported("LANDLOCK");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # O_PATH = 0x200000, O_CLOEXEC = 0x80000, the same on x86-64 and aarch64.
    var fd = sys_open(path, 0x280000, 0);
    if (fd < 0) { return kavach_err_syscall_failed(0 - fd, "landlock open path failed"); }
    var beneath[16];
    store64(&beneath, access);
    store32(&beneath + 8, fd);
    var r = syscall(SYS_LANDLOCK_ADD_RULE, ruleset_fd, LANDLOCK_RULE_PATH_BENEATH, &beneath, 0);
    syscall(SYS_CLOSE, fd);
    if (r < 0) { return kavach_err_syscall_failed(0 - r, "landlock_add_rule failed"); }
    return Ok(0);
    #endif
}

# A NET_PORT rule granting `access` for each port in `ports` (a vec, or 0).
# Two rules for one port, bind and connect, merge into one in the kernel.
fn _landlock_add_ports(ruleset_fd, ports, access): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return kavach_err_not_supported("LANDLOCK");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (ports == 0) { return Ok(0); }
    var i = 0;
    while (i < vec_len(ports)) {
        # SAFETY: LandlockNetPortAttr is { allowed_access: u64, port: u64 }, 16
        # bytes, and `np` is 16.
        var np[16];
        store64(&np, access);
        store64(&np + 8, vec_get(ports, i));
        var r = syscall(SYS_LANDLOCK_ADD_RULE, ruleset_fd, LANDLOCK_RULE_NET_PORT, &np, 0);
        if (r < 0) { return kavach_err_syscall_failed(0 - r, "landlock_add_rule (port) failed"); }
        i = i + 1;
    }
    return Ok(0);
    #endif
}

# ================================================================
# Seccomp BPF
# ================================================================

# BPF instruction constants
enum BpfConst {
    BPF_LD_W_ABS = 0x20;
    BPF_JMP_JEQ_K = 0x15;
    BPF_JMP_JGE_K = 0x35;
    BPF_JMP_JSET_K = 0x45;
    BPF_RET_K = 0x06;
    BPF_ALU_AND_K = 0x54;               # BPF_ALU | BPF_AND | BPF_K
    SECCOMP_RET_ALLOW = 0x7FFF0000;
    SECCOMP_RET_ERRNO = 0x00050000;     # | errno, returned to the caller
    SECCOMP_RET_KILL_PROCESS = 0x80000000;
    SECCOMP_RET_TRAP = 0x00030000;
    BPF_MAXINSNS = 4096;
    PR_SET_NO_NEW_PRIVS = 38;
    PR_SET_SECCOMP = 22;
    SECCOMP_MODE_FILTER = 2;
    # struct seccomp_data (linux/seccomp.h): int nr at +0, __u32 arch at +4.
    SECCOMP_DATA_NR = 0;
    SECCOMP_DATA_ARCH = 4;
    SECCOMP_DATA_ARG0 = 16;             # __u64 args[6]; the low word, little-endian
    SECCOMP_DATA_ARG1 = 24;             # args[1], low word
    SECCOMP_DATA_ARG2 = 32;             # args[2], low word
    SECCOMP_DATA_ARG4 = 48;             # args[4], low word
    SECCOMP_DATA_ARG4_HI = 52;          # args[4], high word
    SECCOMP_DATA_ARG5 = 56;             # args[5], low word
    # clone(2)'s CLONE_NEW* flags (linux/sched.h): NEWNS | NEWCGROUP | NEWUTS |
    # NEWIPC | NEWUSER | NEWPID | NEWNET. CLONE_NEWTIME (0x80) is left out: in
    # clone() that bit is part of the exit signal, and the kernel accepts
    # NEWTIME only from unshare and clone3, both handled on their own.
    SECCOMP_CLONE_NS_FLAGS = 0x7E020000;
    # An x32-ABI call enters as AUDIT_ARCH_X86_64 with this bit set in nr
    # (__X32_SYSCALL_BIT, asm/unistd.h).
    X32_SYSCALL_BIT = 0x40000000;
}

# AUDIT_ARCH_* (linux/audit.h): EM_* | __AUDIT_ARCH_64BIT | __AUDIT_ARCH_LE.
enum AuditArch {
    AUDIT_ARCH_X86_64 = 0xC000003E;     # EM_X86_64 = 62
    AUDIT_ARCH_AARCH64 = 0xC00000B7;    # EM_AARCH64 = 183
}

# The one architecture a kavach filter admits: the one this binary was built
# for. A syscall number means nothing without its ABI — 101 is ptrace on
# x86-64, ioperm through the i386 `int 0x80` gate, and nanosleep on aarch64 —
# so every filter kills any other `seccomp_data.arch` before it reads `nr`.
fn security_seccomp_native_arch(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return AUDIT_ARCH_AARCH64;
    #endif
    #ifdef CYRIUS_ARCH_X86
    return AUDIT_ARCH_X86_64;
    #endif
}

# The same architecture as an OCI runtime spec names it (`linux.seccomp`).
fn security_seccomp_oci_arch() {
    #ifdef CYRIUS_ARCH_AARCH64
    return "SCMP_ARCH_AARCH64";
    #endif
    #ifdef CYRIUS_ARCH_X86
    return "SCMP_ARCH_X86_64";
    #endif
}

# BPF sock_filter instruction — kernel ABI struct (8 bytes).
# Layout enforced by per-field widths; pointer-to-struct dot syntax
# emits store16/store8/store32 at the kernel-correct offsets.
struct bpf_insn {
    code: i16;
    jt: i8;
    jf: i8;
    k: i32;
}

# Write a BPF sock_filter instruction (8 bytes) to buf at offset.
# Write one classic-BPF instruction at `buf + offset`.
#
# Layout is the kernel's `struct sock_filter`, little-endian:
#   +0 u16 code   +2 u8 jt   +3 u8 jf   +4 u32 k
#
# Written with explicit byte stores rather than through a typed `bpf_insn`
# local. The typed form — `var insn: bpf_insn = buf + offset; insn.code = …` —
# compiled to a NO-OP under this toolchain: every field write was dropped and
# the buffer stayed zero-filled. Nothing failed loudly; the filter simply came
# out as 184 zero bytes, and PR_SET_SECCOMP rejected it with EINVAL, so
# **seccomp confinement was never actually applied by any caller**. The
# regression test below asserts the produced bytes, not just that the call
# returned — the previous shape "worked" by every check except the only one
# that mattered.
fn security_bpf_write_insn(buf, offset, code, jt, jf, k): i64 {
    store8(buf + offset, code & 255);
    store8(buf + offset + 1, (code >> 8) & 255);
    store8(buf + offset + 2, jt & 255);
    store8(buf + offset + 3, jf & 255);
    store8(buf + offset + 4, k & 255);
    store8(buf + offset + 5, (k >> 8) & 255);
    store8(buf + offset + 6, (k >> 16) & 255);
    store8(buf + offset + 7, (k >> 24) & 255);
    return 0;
}

# Load a seccomp-BPF filter into the calling process.
# filter: pointer to BPF bytecode, filter_len: total bytes.
# Returns Result.
fn security_load_seccomp(filter, filter_len): i64 {
    if (filter_len == 0) {
        return kavach_err_invalid_argument("empty seccomp filter");
    }
    if (filter_len % 8 != 0) {
        return kavach_err_invalid_argument("filter size not multiple of 8");
    }
    var num_insns = filter_len / 8;
    if (num_insns > BPF_MAXINSNS) {
        return kavach_err_invalid_argument("seccomp filter too large");
    }

    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no seccomp-BPF (a Linux syscall-filtering facility). Syscall-surface
    # restriction on AGNOS is the capability layer's job, so report a structured
    # "unsupported on this platform" (same pattern as Landlock above) rather than a
    # silent Ok(0) that would falsely imply the syscall surface was filtered. The
    # filter is still validated above. Transitional — until AGNOS provides native
    # syscall-surface filtering, at which point this branch calls that instead.
    return kavach_err_not_supported("SECCOMP");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS

    # Set no_new_privs
    var ret = syscall(SYS_PRCTL, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_NO_NEW_PRIVS failed");
    }

    # sock_fprog: { u16 len, pad[6], u64 filter_ptr }
    # On x86_64: { u16 len (2 bytes), 6 pad, ptr (8 bytes) } = 16 bytes
    var prog[16];
    store16(&prog, num_insns);
    store64(&prog + 8, filter);

    ret = syscall(SYS_PRCTL, PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &prog, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_SECCOMP failed");
    }

    return Ok(0);
    #endif
}

# ---- Syscall tables --------------------------------------------------------
#
# A filter compares `seccomp_data.nr`, which is the KERNEL's number for the
# running architecture. So these tables hold native numbers, one column per
# architecture (x86-64: asm/unistd_64.h; aarch64: asm-generic/unistd.h), and
# deliberately NOT the stdlib's SYS_* names: the aarch64 peer spells some calls
# with x86 numbers that cyrius renumbers only at a syscall() site, and a BPF
# constant is data that is never renumbered. Until 3.12.8 the tables were the
# x86-64 column alone, so on aarch64 the exec-safe filter killed nanosleep (101)
# and let the real ptrace (117), mount (40) and unshare (97) through.

# Pick a table row's column: the number for the architecture this binary was
# built for. -1 marks a call that architecture does not have.
fn _seccomp_native_nr(x86_64_nr, aarch64_nr): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return aarch64_nr;
    #endif
    #ifdef CYRIUS_ARCH_X86
    return x86_64_nr;
    #endif
}

fn _seccomp_push(v, x86_64_nr, aarch64_nr): i64 {
    var nr = _seccomp_native_nr(x86_64_nr, aarch64_nr);
    if (nr >= 0) { vec_push(v, nr); }
    return 0;
}

# Syscalls denied by the exec-safe profile. These are the ones a container
# payload has no business making and that lead directly to host compromise or
# namespace escape. Ordered roughly by how often they appear in escape chains.
#
# Each row names its call as well as numbering it (3.14.4). The BPF filter
# compares numbers; an OCI runtime takes names (`_oci_seccomp_json`). One table
# feeds both, so a payload under runc is denied what a payload under the process
# backend is denied, and a row added here reaches both.
var _SECCOMP_DENY = 0;
var _SECCOMP_DENY_NAMES = 0;

# One deny row, for the architecture this binary was built for. A call that
# architecture does not have is left out of both lists.
fn _seccomp_deny_row(v, names, name, x86_64_nr, aarch64_nr): i64 {
    var nr = _seccomp_native_nr(x86_64_nr, aarch64_nr);
    if (nr >= 0) {
        vec_push(v, nr);
        vec_push(names, name);
    }
    return 0;
}

fn _seccomp_deny_list() {
    if (_SECCOMP_DENY != 0) { return _SECCOMP_DENY; }
    var v = vec_new();
    var n = vec_new();
    #                 name, x86-64, aarch64
    _seccomp_deny_row(v, n, "mount", 165, 40);
    _seccomp_deny_row(v, n, "umount2", 166, 39);
    _seccomp_deny_row(v, n, "pivot_root", 155, 41);
    _seccomp_deny_row(v, n, "unshare", 272, 97);  # re-namespacing after confinement
    _seccomp_deny_row(v, n, "setns", 308, 268);  # entering another container's ns
    _seccomp_deny_row(v, n, "ptrace", 101, 117);  # reading/writing sibling processes
    _seccomp_deny_row(v, n, "process_vm_readv", 310, 270);
    _seccomp_deny_row(v, n, "process_vm_writev", 311, 271);
    _seccomp_deny_row(v, n, "init_module", 175, 105);
    _seccomp_deny_row(v, n, "delete_module", 176, 106);
    _seccomp_deny_row(v, n, "finit_module", 313, 273);
    _seccomp_deny_row(v, n, "kexec_load", 246, 104);
    _seccomp_deny_row(v, n, "reboot", 169, 142);
    _seccomp_deny_row(v, n, "swapon", 167, 224);
    _seccomp_deny_row(v, n, "swapoff", 168, 225);
    _seccomp_deny_row(v, n, "bpf", 321, 280);
    _seccomp_deny_row(v, n, "perf_event_open", 298, 241);
    _seccomp_deny_row(v, n, "userfaultfd", 323, 282);  # a classic exploit-timing primitive
    _seccomp_deny_row(v, n, "sysfs", 139, 0 - 1);  # x86-64 only
    _seccomp_deny_row(v, n, "syslog", 103, 116);
    # The mount API that is not mount(2) (3.12.9). Each reaches what the denied
    # mount does: fsopen + fsconfig + fsmount + move_mount builds and attaches a
    # filesystem; open_tree + move_mount attaches a bind mount; mount_setattr
    # changes an existing mount's flags. Numbered since Linux 5.1 in the shared
    # table, so both columns agree. An older kernel returns ENOSYS for them anyway.
    _seccomp_deny_row(v, n, "open_tree", 428, 428);
    _seccomp_deny_row(v, n, "move_mount", 429, 429);
    _seccomp_deny_row(v, n, "fsopen", 430, 430);
    _seccomp_deny_row(v, n, "fsconfig", 431, 431);
    _seccomp_deny_row(v, n, "fsmount", 432, 432);
    _seccomp_deny_row(v, n, "fspick", 433, 433);
    _seccomp_deny_row(v, n, "mount_setattr", 442, 442);
    _seccomp_deny_row(v, n, "open_tree_attr", 467, 467);  # (Linux 6.15)
    # Published last, names first: a thread that sees the list sees all of it, and
    # a filter compiled from a half-built list would miss the rows not yet pushed.
    _SECCOMP_DENY_NAMES = n;
    _SECCOMP_DENY = v;
    return v;
}

# The deny list by name, in the order of `_seccomp_deny_list`.
fn security_seccomp_deny_names() {
    _seccomp_deny_list();
    return _SECCOMP_DENY_NAMES;
}

# ---- Capabilities ----------------------------------------------------------
#
# Here, not in `oci_spec.cyr` where they began (3.14.5), because the process path
# reads them too since 3.14.6, and `[lib.confine]` carries this module and not
# that one.

var _SECURITY_CAP_NAMES = 0;

# Every capability kavach can name, in kernel order, so an index is that
# capability's bit in /proc/self/status. Published last, as `_seccomp_deny_list`
# publishes its table.
#[must_use]
fn security_capability_names() {
    if (_SECURITY_CAP_NAMES != 0) { return _SECURITY_CAP_NAMES; }
    var v = vec_new();
    vec_push(v, "CAP_CHOWN");
    vec_push(v, "CAP_DAC_OVERRIDE");
    vec_push(v, "CAP_DAC_READ_SEARCH");
    vec_push(v, "CAP_FOWNER");
    vec_push(v, "CAP_FSETID");
    vec_push(v, "CAP_KILL");
    vec_push(v, "CAP_SETGID");
    vec_push(v, "CAP_SETUID");
    vec_push(v, "CAP_SETPCAP");
    vec_push(v, "CAP_LINUX_IMMUTABLE");
    vec_push(v, "CAP_NET_BIND_SERVICE");
    vec_push(v, "CAP_NET_BROADCAST");
    vec_push(v, "CAP_NET_ADMIN");
    vec_push(v, "CAP_NET_RAW");
    vec_push(v, "CAP_IPC_LOCK");
    vec_push(v, "CAP_IPC_OWNER");
    vec_push(v, "CAP_SYS_MODULE");
    vec_push(v, "CAP_SYS_RAWIO");
    vec_push(v, "CAP_SYS_CHROOT");
    vec_push(v, "CAP_SYS_PTRACE");
    vec_push(v, "CAP_SYS_PACCT");
    vec_push(v, "CAP_SYS_ADMIN");
    vec_push(v, "CAP_SYS_BOOT");
    vec_push(v, "CAP_SYS_NICE");
    vec_push(v, "CAP_SYS_RESOURCE");
    vec_push(v, "CAP_SYS_TIME");
    vec_push(v, "CAP_SYS_TTY_CONFIG");
    vec_push(v, "CAP_MKNOD");
    vec_push(v, "CAP_LEASE");
    vec_push(v, "CAP_AUDIT_WRITE");
    vec_push(v, "CAP_AUDIT_CONTROL");
    vec_push(v, "CAP_SETFCAP");
    vec_push(v, "CAP_MAC_OVERRIDE");
    vec_push(v, "CAP_MAC_ADMIN");
    vec_push(v, "CAP_SYSLOG");
    vec_push(v, "CAP_WAKE_ALARM");
    vec_push(v, "CAP_BLOCK_SUSPEND");
    vec_push(v, "CAP_AUDIT_READ");
    vec_push(v, "CAP_PERFMON");
    vec_push(v, "CAP_BPF");
    vec_push(v, "CAP_CHECKPOINT_RESTORE");
    _SECURITY_CAP_NAMES = v;
    return v;
}

# The capabilities a payload with a rootfs gets unless `config_capabilities` names
# others, on the OCI and gVisor backends and, since 3.14.6, on the process path, as
# a fresh vec: a caller may push onto it and hand it back.
#
# Docker's default set less CAP_NET_RAW and CAP_MKNOD. Measured under
# `no-new-privileges`: nginx (its workers change user) and postgres's entry point
# (it chowns the data directory and drops to postgres) both run under this set, as
# do `su` and `chown`. All four fail under the three names `runc spec` writes.
#
#   - CAP_NET_RAW reaches nothing in the empty namespace of a policy with no
#     network. `network_enabled` shares the HOST's namespace (`netns` in
#     `oci_generate_spec`), where a payload running as root could read and forge
#     the host's traffic. So it is either useless or too much.
#   - CAP_MKNOD cannot make a device node in a user namespace. As root under runc
#     1.5.2 it can, and opening one past runc's default rules still read EPERM.
#
# ⚠ Name nothing newer than the oldest kernel kavach supports. runc logs a
# capability the kernel does not have at level=warning, into the `--log` file
# `_oci_exec_with` reads as a runtime failure, so a default of CAP_PERFMON (5.8)
# would fail every container on a kernel older than that. The newest name here is
# CAP_SETFCAP (2.6.24). A caller naming a newer one gets that failure on an older
# kernel, which is the right answer to asking for what the kernel does not have.
#[must_use]
fn oci_default_capabilities() {
    var v = vec_new();
    vec_push(v, "CAP_CHOWN");
    vec_push(v, "CAP_DAC_OVERRIDE");
    vec_push(v, "CAP_FOWNER");
    vec_push(v, "CAP_FSETID");
    vec_push(v, "CAP_KILL");
    vec_push(v, "CAP_SETGID");
    vec_push(v, "CAP_SETUID");
    vec_push(v, "CAP_SETPCAP");
    vec_push(v, "CAP_NET_BIND_SERVICE");
    vec_push(v, "CAP_SYS_CHROOT");
    vec_push(v, "CAP_AUDIT_WRITE");
    vec_push(v, "CAP_SETFCAP");
    return v;
}

# The first of `names` the table does not hold, as a message, or 0 when it holds
# them all. A list is refused rather than a name dropped: a payload running with
# less than its caller asked for fails later, somewhere that says nothing of why.
#[must_use]
fn security_capability_refusal(names) {
    var known = security_capability_names();
    var i = 0;
    while (i < vec_len(names)) {
        var name = vec_get(names, i);
        var hit = 0;
        var k = 0;
        while (name != 0 && k < vec_len(known)) {
            if (streq(name, vec_get(known, k)) == 1) { hit = 1; }
            k = k + 1;
        }
        if (hit == 0) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "unknown capability: ");
            if (name != 0) { str_builder_add_cstr(sb, name); }
            return str_data(str_builder_build(sb));
        }
        i = i + 1;
    }
    return 0;
}

# ---- /proc and /sys paths a payload may not write (3.14.7) -----------------
#
# `runc spec` 1.5.2's `linux.maskedPaths` and `linux.readonlyPaths`, which the OCI
# spec has written since 3.14.5. Here, not in `oci_spec.cyr`, because since 3.14.7
# the process path applies them too, to a `/proc` or `/sys` the caller mounted in a
# rootfs, and `[lib.confine]` carries this module and not that one, as with the
# capability table.
#
# By index, as string literals, so a forked child reads them with no allocation.
# Order is runc's. `/sys/firmware` stays in a list whose spec mounts no `/sys`, so
# the lists are runc's and not a variant of them.

var SECURITY_MASKED_PATHS = 10;
var SECURITY_READONLY_PATHS = 5;

# The `i`th masked path, or 0 past the end. A file is masked by the host's
# /dev/null and a directory by an empty read-only tmpfs.
fn security_masked_path(i) {
    if (i == 0) { return "/proc/acpi"; }
    if (i == 1) { return "/proc/asound"; }
    if (i == 2) { return "/proc/kcore"; }
    if (i == 3) { return "/proc/keys"; }
    if (i == 4) { return "/proc/latency_stats"; }
    if (i == 5) { return "/proc/timer_list"; }
    if (i == 6) { return "/proc/timer_stats"; }
    if (i == 7) { return "/proc/sched_debug"; }
    if (i == 8) { return "/sys/firmware"; }
    if (i == 9) { return "/proc/scsi"; }
    return 0;
}

# The `i`th read-only path, or 0 past the end.
fn security_readonly_path(i) {
    if (i == 0) { return "/proc/bus"; }
    if (i == 1) { return "/proc/fs"; }
    if (i == 2) { return "/proc/irq"; }
    if (i == 3) { return "/proc/sys"; }
    if (i == 4) { return "/proc/sysrq-trigger"; }
    return 0;
}

# `names` as a mask, each at its bit in /proc/self/status. A name the table does not
# hold adds nothing, so a caller asks `security_capability_refusal` first.
#[must_use]
fn security_capability_mask(names) {
    var known = security_capability_names();
    var mask = 0;
    var i = 0;
    while (i < vec_len(names)) {
        var name = vec_get(names, i);
        var k = 0;
        while (name != 0 && k < vec_len(known)) {
            if (streq(name, vec_get(known, k)) == 1) { mask = mask | (1 << k); }
            k = k + 1;
        }
        i = i + 1;
    }
    return mask;
}

# Syscalls the basic (allowlist) profile permits.
var _SECCOMP_ALLOW = 0;

fn _seccomp_allow_list() {
    if (_SECCOMP_ALLOW != 0) { return _SECCOMP_ALLOW; }
    var v = vec_new();
    #             x86-64, aarch64
    _seccomp_push(v, 0, 63);        # read
    _seccomp_push(v, 1, 64);        # write
    _seccomp_push(v, 3, 57);        # close
    _seccomp_push(v, 5, 80);        # fstat
    _seccomp_push(v, 9, 222);       # mmap
    _seccomp_push(v, 10, 226);      # mprotect
    _seccomp_push(v, 11, 215);      # munmap
    _seccomp_push(v, 12, 214);      # brk
    _seccomp_push(v, 15, 139);      # rt_sigreturn
    _seccomp_push(v, 60, 93);       # exit
    _seccomp_push(v, 131, 132);     # sigaltstack
    _seccomp_push(v, 158, 0 - 1);   # arch_prctl     — x86-64 only
    _seccomp_push(v, 186, 178);     # gettid
    _seccomp_push(v, 202, 98);      # futex
    _seccomp_push(v, 218, 96);      # set_tid_address
    _seccomp_push(v, 231, 94);      # exit_group
    _seccomp_push(v, 273, 99);      # set_robust_list
    _seccomp_push(v, 318, 278);     # getrandom
    _seccomp_push(v, 228, 113);     # clock_gettime
    _seccomp_push(v, 334, 293);     # rseq
    # 3.14.1: waiting on an fd the process already holds. Each reads and writes
    # only the caller's own pollfd array. The stdlib polls for a deadline-bound
    # socket read or write (cyrius 6.6.13 TLS deadlines, 6.6.20 async waits).
    _seccomp_push(v, 7, 0 - 1);     # poll           — x86-64 only
    _seccomp_push(v, 271, 73);      # ppoll
    _SECCOMP_ALLOW = v;
    return v;
}

# ---- Architecture check ----------------------------------------------------
#
# Every filter opens with it:
#
#   0  LD   seccomp_data.arch
#   1  JEQ  <native AUDIT_ARCH>, jt 1         match: skip the KILL
#   2  RET  KILL_PROCESS                      any other ABI
#   3  LD   seccomp_data.nr
#   4  JGE  X32_SYSCALL_BIT -> kill_idx       x86-64 only
#
# Without it a filter keyed on numbers alone is the pitfall seccomp(2) warns
# about. A 64-bit x86 process can still enter the kernel through the i386 gate
# (`int 0x80`), where every number means a different call: i386 21 is mount,
# which the x86-64 table reads as access and allows. An x32 call enters as
# AUDIT_ARCH_X86_64 with bit 30 set in nr, so it matches no x86-64 entry. Each
# is now killed, and so is a 32-bit payload: a filter loaded before exec stays
# in force, and an i386 or AArch32 binary's first syscall carries a foreign
# arch. systemd.exec(5) recommends the same restriction,
# SystemCallArchitectures=native, so that "secondary ABIs may not be used to
# circumvent the restrictions applied to the native ABI".

fn _seccomp_prologue_len(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return 4;
    #endif
    #ifdef CYRIUS_ARCH_X86
    return 5;
    #endif
}

# Write the prologue into `filter`; `kill_idx` is the index of the filter's RET
# KILL instruction. Returns the prologue length, the first free index.
fn _seccomp_write_prologue(filter, kill_idx): i64 {
    security_bpf_write_insn(filter, 0, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARCH);
    security_bpf_write_insn(filter, 8, BPF_JMP_JEQ_K, 1, 0, security_seccomp_native_arch());
    security_bpf_write_insn(filter, 16, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);
    security_bpf_write_insn(filter, 24, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_NR);
    #ifdef CYRIUS_ARCH_X86
    # A BPF jump counts instructions to SKIP: from index 4, kill_idx is
    # kill_idx - 5 ahead.
    security_bpf_write_insn(filter, 32, BPF_JMP_JGE_K, kill_idx - 5, 0, X32_SYSCALL_BIT);
    #endif
    return _seccomp_prologue_len();
}

# Create a seccomp filter that can be installed BEFORE execve.
# Returns Result: Ok(info) where info is {ptr, len}.
#
# **This is a DENY-list (default ALLOW), unlike
# security_create_basic_seccomp_filter's ~20-syscall allowlist, and the
# difference is deliberate rather than lazy.**
#
# The allowlist profile is designed for a process already running its payload:
# it permits read/write/mmap/futex and friends, and does NOT permit execve. Load
# it before an exec and the kernel kills the child on the very syscall that
# starts it — so it is unusable on any spawn path, which is why the detached
# spawn needs this variant.
#
# A default-deny profile usable pre-exec would need to allowlist execve plus the
# whole dynamic-loader surface (openat, mmap, mprotect, access, newfstatat, …)
# and then everything the payload itself uses — in practice the ~300-entry list
# the OCI default profile carries. That list is a policy artifact, not something
# this function should invent. Until it exists, blocking the ~20 syscalls that
# actually appear in container-escape chains is the honest, applicable middle:
# strictly better than no filter, and explicitly weaker than the allowlist.
#
# Layout (n denied numbers, p prologue instructions):
#
#   p .. p+n-1   JEQ deny[i] -> KILL
#   p+n          JEQ clone3  -> ERRNO(ENOSYS)
#   p+n+1        JEQ clone   -> next, else ALLOW
#   p+n+2        LD  args[0]                       clone's flags
#   p+n+3        JSET SECCOMP_CLONE_NS_FLAGS -> KILL, else ALLOW
#   p+n+4        RET ALLOW
#   p+n+5        RET ERRNO | ENOSYS
#   p+n+6        RET KILL
#
# 40 instructions on x86-64, 38 on aarch64.
#
# **Why the clone tail (3.12.9).** unshare and setns are denied because a
# payload must not re-namespace itself, but clone(2) creates namespaces too:
# CLONE_NEWUSER | CLONE_NEWNS makes a child that can mount in its own mount
# namespace, which is the thing the mount entries above deny. A filter can
# test clone's flags because they are an argument. clone3(2) passes them in a
# struct that seccomp cannot read, so it gets ENOSYS rather than KILL: glibc
# answers ENOSYS by falling back to clone, which the filter can test. Payloads
# that fork, spawn threads or run posix_spawn keep working.
fn security_create_exec_seccomp_filter(): i64 {
    var deny = _seccomp_deny_list();
    var n = vec_len(deny);
    var p = _seccomp_prologue_len();
    var allow_idx = p + n + 4;
    var errno_idx = p + n + 5;
    var kill_idx = p + n + 6;
    var filter_size = (kill_idx + 1) * 8;
    var filter = alloc(filter_size);

    _seccomp_write_prologue(filter, kill_idx);
    # From index p+i, the jump to kill_idx skips kill_idx - (p+i) - 1 = n + 5 - i.
    var i = 0;
    while (i < n) {
        security_bpf_write_insn(filter, (p + i) * 8, BPF_JMP_JEQ_K,
          n + 5 - i, 0, vec_get(deny, i));
        i = i + 1;
    }
    var at = p + n;
    security_bpf_write_insn(filter, at * 8, BPF_JMP_JEQ_K,
      errno_idx - at - 1, 0, _seccomp_native_nr(435, 435));          # clone3
    at = at + 1;
    security_bpf_write_insn(filter, at * 8, BPF_JMP_JEQ_K,
      0, allow_idx - at - 1, _seccomp_native_nr(56, 220));           # clone
    at = at + 1;
    security_bpf_write_insn(filter, at * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG0);
    at = at + 1;
    security_bpf_write_insn(filter, at * 8, BPF_JMP_JSET_K,
      kill_idx - at - 1, allow_idx - at - 1, SECCOMP_CLONE_NS_FLAGS);
    security_bpf_write_insn(filter, allow_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW);
    security_bpf_write_insn(filter, errno_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ERRNO | ENOSYS);
    security_bpf_write_insn(filter, kill_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);

    var info = alloc(16);
    store64(info, filter);
    store64(info + 8, filter_size);
    return Ok(info);
}

# Socket families, the stream type and the TCP protocol number as Linux's
# `socket(2)` takes them (linux/socket.h, linux/net.h, linux/in.h): data the
# network rules below compare with `seccomp_data.args`, the same on x86-64 and
# aarch64. Kavach's own, and not lib/net.cyr's AF_INET and SOCK_STREAM: that
# module is not in `[lib.confine]`, and its AF_INET6 is the host's, 30 on Darwin.
var KAVACH_AF_UNIX = 1;
var KAVACH_AF_INET = 2;
var KAVACH_AF_INET6 = 10;
var KAVACH_AF_NETLINK = 16;
var KAVACH_SOCK_STREAM = 1;
var KAVACH_IPPROTO_TCP = 6;

# The network rules a confined payload denied network needs beyond landlock's TCP
# rights (3.14.8), as a filter of their own, loaded on top of any other. agnosai's
# filing named UDP: landlock refuses a TCP bind and connect, and a payload could
# still send a DNS query. Measured on Linux 7.2.14 (landlock ABI 10) with landlock
# holding TCP: an MPTCP socket connected to a port the rule refused, and an SCTP
# connect went out, so landlock's TCP rights are plain TCP's and nothing more.
#
#   - `socket(2)` is allowed for AF_UNIX and AF_NETLINK, which stay on the host,
#     and for AF_INET and AF_INET6 only as a TCP stream: SOCK_STREAM, protocol 0
#     or IPPROTO_TCP, which landlock then holds to the policy's ports. Anything
#     else (UDP, raw, SCTP, MPTCP, packet, vsock and the rest) reads EACCES, as
#     landlock refuses a connect, so a payload sees a refusal and not a kill.
#   - `io_uring_setup` reads ENOSYS, as clone3 does in the exec filter: a ring
#     opens sockets with no `socket(2)` call to test, and a payload falls back.
#   - Every other call is allowed: this filter is the network's, and the policy's
#     own filter, when it has one, is loaded beside it.
#
# Layout (p prologue instructions):
#
#   p        JEQ socket -> p+1, else p+12
#   p+1..+5  LD args[0]: AF_UNIX, AF_NETLINK -> ALLOW; AF_INET, AF_INET6 -> p+6;
#            else EACCES
#   p+6..+8  LD args[1], AND 0xf: SOCK_STREAM -> p+9, else EACCES
#   p+9..+11 LD args[2]: 0, IPPROTO_TCP -> ALLOW, else EACCES
#   p+12     JEQ io_uring_setup -> ENOSYS, else ALLOW
#   p+13     RET ALLOW
#   p+14     RET ERRNO | ENOSYS
#   p+15     RET ERRNO | EACCES
#   p+16     RET KILL                       (the prologue's foreign arch or x32)
#
# 22 instructions on x86-64, 21 on aarch64. Written into a static buffer, with no
# allocation, because the child after `fork` loads it and may not allocate; the
# bytes are the same on every write, so writing it again changes nothing.
var KAVACH_NET_FILTER_MAX = 24;
var _SECCOMP_NET_FILTER[24];
var _SECCOMP_NET_INFO[2];

fn security_net_seccomp_filter(): i64 {
    var filter = &_SECCOMP_NET_FILTER;
    var p = _seccomp_prologue_len();
    var allow_idx = p + 13;
    var nosys_idx = p + 14;
    var acces_idx = p + 15;
    var kill_idx = p + 16;
    _seccomp_write_prologue(filter, kill_idx);
    # A BPF jump counts instructions to SKIP: from index a, target t is t - a - 1.
    security_bpf_write_insn(filter, p * 8, BPF_JMP_JEQ_K, 0, 11, _seccomp_native_nr(41, 198));  # socket
    security_bpf_write_insn(filter, (p + 1) * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG0);
    security_bpf_write_insn(filter, (p + 2) * 8, BPF_JMP_JEQ_K, allow_idx - (p + 2) - 1, 0, KAVACH_AF_UNIX);
    security_bpf_write_insn(filter, (p + 3) * 8, BPF_JMP_JEQ_K, allow_idx - (p + 3) - 1, 0, KAVACH_AF_NETLINK);
    security_bpf_write_insn(filter, (p + 4) * 8, BPF_JMP_JEQ_K, 1, 0, KAVACH_AF_INET);
    security_bpf_write_insn(filter, (p + 5) * 8, BPF_JMP_JEQ_K, 0, acces_idx - (p + 5) - 1, KAVACH_AF_INET6);
    security_bpf_write_insn(filter, (p + 6) * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG1);
    security_bpf_write_insn(filter, (p + 7) * 8, BPF_ALU_AND_K, 0, 0, 15);
    security_bpf_write_insn(filter, (p + 8) * 8, BPF_JMP_JEQ_K, 0, acces_idx - (p + 8) - 1, KAVACH_SOCK_STREAM);
    security_bpf_write_insn(filter, (p + 9) * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG2);
    security_bpf_write_insn(filter, (p + 10) * 8, BPF_JMP_JEQ_K, allow_idx - (p + 10) - 1, 0, 0);
    security_bpf_write_insn(filter, (p + 11) * 8, BPF_JMP_JEQ_K, allow_idx - (p + 11) - 1,
      acces_idx - (p + 11) - 1, KAVACH_IPPROTO_TCP);
    security_bpf_write_insn(filter, (p + 12) * 8, BPF_JMP_JEQ_K, nosys_idx - (p + 12) - 1,
      allow_idx - (p + 12) - 1, _seccomp_native_nr(425, 425));                         # io_uring_setup
    security_bpf_write_insn(filter, allow_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW);
    security_bpf_write_insn(filter, nosys_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ERRNO | ENOSYS);
    security_bpf_write_insn(filter, acces_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ERRNO | EACCES);
    security_bpf_write_insn(filter, kill_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);
    store64(&_SECCOMP_NET_INFO, filter);
    store64(&_SECCOMP_NET_INFO + 8, (kill_idx + 1) * 8);
    return &_SECCOMP_NET_INFO;
}

# Create a basic seccomp filter allowing safe syscalls.
# Returns Result: Ok(filter_ptr) where payload is {ptr, len}.
# The caller must use the returned pointer and length with security_load_seccomp.
#
# An allowlist, killing the process on a miss. Two calls are allowed only in
# the shape that is a write or a flag change on an fd the process already holds
# (3.14.1). Since cyrius 6.6.16 every stdlib socket write is
# `sendto(fd, buf, n, MSG_NOSIGNAL, NULL, 0)`, and a deadline-bound one also
# sets O_NONBLOCK with fcntl, so through 3.14.0 a process under this filter died
# of SIGSYS on its first `sock_send_all` or TLS record.
#
#   - sendto only with no destination: `dest_addr` NULL in both words and
#     `addrlen` 0. On a connected socket that is exactly write(2); it refuses a
#     datagram to an address and MSG_FASTOPEN, which needs one. The flags are
#     left free (MSG_NOSIGNAL, MSG_DONTWAIT and MSG_OOB reach nothing new).
#   - fcntl only F_GETFL and F_SETFL, so no F_DUPFD, locks, leases or owners.
#
#   p .. p+m-1   JEQ allow[i] -> ALLOW
#   p+m          JEQ sendto -> p+m+2, else next
#   p+m+1        JEQ fcntl  -> p+m+8, else KILL
#   p+m+2..+7    LD arg4 lo, JEQ 0; LD arg4 hi, JEQ 0; LD arg5 lo, JEQ 0 -> ALLOW
#   p+m+8..+10   LD arg1 lo, JEQ F_GETFL -> ALLOW, JEQ F_SETFL -> ALLOW, else KILL
#   p+m+11       RET KILL
#   p+m+12       RET ALLOW
#
# 40 instructions on x86-64 (22 plain calls), 37 on aarch64 (20: no poll, no
# arch_prctl). The pointer is checked in both words; `addrlen` (an int) and the
# fcntl command (an unsigned int) in the low word only, which is all the kernel
# reads. Until 3.12.8 this was 23 hand-written instructions of x86-64 numbers
# with no architecture check.
fn security_create_basic_seccomp_filter(): i64 {
    var allow = _seccomp_allow_list();
    var m = vec_len(allow);
    var p = _seccomp_prologue_len();
    var t = p + m;
    var kill_idx = t + 11;
    var allow_idx = t + 12;
    var filter_size = (allow_idx + 1) * 8;
    var filter = alloc(filter_size);

    _seccomp_write_prologue(filter, kill_idx);
    # A BPF jump counts instructions to SKIP: from index i, target j is j - i - 1.
    var i = 0;
    while (i < m) {
        security_bpf_write_insn(filter, (p + i) * 8, BPF_JMP_JEQ_K,
          allow_idx - (p + i) - 1, 0, vec_get(allow, i));
        i = i + 1;
    }
    security_bpf_write_insn(filter, t * 8, BPF_JMP_JEQ_K,
      1, 0, _seccomp_native_nr(44, 206));                            # sendto
    security_bpf_write_insn(filter, (t + 1) * 8, BPF_JMP_JEQ_K,
      6, kill_idx - (t + 1) - 1, _seccomp_native_nr(72, 25));        # fcntl
    security_bpf_write_insn(filter, (t + 2) * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG4);
    security_bpf_write_insn(filter, (t + 3) * 8, BPF_JMP_JEQ_K,
      0, kill_idx - (t + 3) - 1, 0);
    security_bpf_write_insn(filter, (t + 4) * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG4_HI);
    security_bpf_write_insn(filter, (t + 5) * 8, BPF_JMP_JEQ_K,
      0, kill_idx - (t + 5) - 1, 0);
    security_bpf_write_insn(filter, (t + 6) * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG5);
    security_bpf_write_insn(filter, (t + 7) * 8, BPF_JMP_JEQ_K,
      allow_idx - (t + 7) - 1, kill_idx - (t + 7) - 1, 0);
    security_bpf_write_insn(filter, (t + 8) * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG1);
    security_bpf_write_insn(filter, (t + 9) * 8, BPF_JMP_JEQ_K,
      allow_idx - (t + 9) - 1, 0, F_GETFL);
    security_bpf_write_insn(filter, (t + 10) * 8, BPF_JMP_JEQ_K,
      allow_idx - (t + 10) - 1, kill_idx - (t + 10) - 1, F_SETFL);
    security_bpf_write_insn(filter, kill_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);
    security_bpf_write_insn(filter, allow_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW);

    var info = alloc(16);
    store64(info, filter);
    store64(info + 8, filter_size);
    return Ok(info);
}

# Get filter pointer from security_create_basic_seccomp_filter result
fn security_seccomp_filter_ptr(info): i64 { return load64(info); }
fn security_seccomp_filter_len(info): i64 { return load64(info + 8); }

# ================================================================
# Namespace creation
# ================================================================

enum CloneFlag {
    CLONE_NEWNET = 0x40000000;
    CLONE_NEWNS = 0x00020000;
    CLONE_NEWPID = 0x20000000;
    CLONE_NEWUSER = 0x10000000;
}

enum NsFlag {
    NS_NETWORK = 1;
    NS_MOUNT = 2;
    NS_PID = 4;
    NS_USER = 8;
}

# Create new namespace(s) with specified flags.
# flags: bitwise OR of NS_NETWORK, NS_MOUNT, NS_PID, NS_USER
# Returns Result.
fn security_create_namespace(flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no Linux namespaces / unshare(2). Process isolation on AGNOS is the
    # capability layer's job, so report a structured "unsupported on this platform"
    # (same pattern as Landlock/seccomp) rather than a silent Ok(0) that would falsely
    # imply isolation was applied. Transitional — until AGNOS provides native
    # isolation primitives, at which point this branch calls those instead.
    return kavach_err_not_supported("NAMESPACES");
    #endif
    # sys_unshare since 3.14.2. Through 3.14.1 this was kavach's own x86-64 272,
    # x86-only, and aarch64 refused: cyrius did not renumber 272, so aarch64 ran
    # kcmp(2) through 3.12.7, and the native 97 is not a number kavach may write
    # (ADR-007). The stdlib names SYS_UNSHARE in both Linux peers (ESYSXLAT
    # 272→97), so aarch64 gets namespaces.
    #ifndef CYRIUS_TARGET_AGNOS
    var sflags = 0;
    if ((flags & NS_NETWORK) != 0) { sflags = sflags | CLONE_NEWNET; }
    if ((flags & NS_MOUNT) != 0) { sflags = sflags | CLONE_NEWNS; }
    if ((flags & NS_PID) != 0) { sflags = sflags | CLONE_NEWPID; }
    if ((flags & NS_USER) != 0) { sflags = sflags | CLONE_NEWUSER; }

    var ret = sys_unshare(sflags);
    if (ret < 0) {
        var errno = 0 - ret;
        if (errno == EPERM) { return kavach_err_permission_denied("security_create_namespace"); }
        if (errno == EINVAL) { return kavach_err_invalid_argument("security_create_namespace: invalid flags"); }
        return kavach_err_syscall_failed(errno, "unshare failed");
    }

    return Ok(0);
    #endif
}

# ================================================================
# Syscall name to number mapping (hashmap, O(1) lookup)
# ================================================================

var _syscall_map = 0;

fn security_syscall_map_reset(): i64 { _syscall_map = 0; return 0; }

# Built into a map of its own and published last (3.14.8), as `_seccomp_deny_list`
# publishes its table: until then the map was published empty and filled in place,
# so a lookup on another thread could find a name missing that was about to be
# there.
fn _syscall_map_init(): i64 {
    if (_syscall_map != 0) { return 0; }
    var m = map_new();
    #                 name, x86-64, aarch64
    _syscall_map_row(m, "read", 0, 63);
    _syscall_map_row(m, "write", 1, 64);
    _syscall_map_row(m, "open", 2, 0 - 1);
    _syscall_map_row(m, "close", 3, 57);
    _syscall_map_row(m, "stat", 4, 0 - 1);
    _syscall_map_row(m, "fstat", 5, 80);
    _syscall_map_row(m, "lseek", 8, 62);
    _syscall_map_row(m, "mmap", 9, 222);
    _syscall_map_row(m, "mprotect", 10, 226);
    _syscall_map_row(m, "munmap", 11, 215);
    _syscall_map_row(m, "brk", 12, 214);
    _syscall_map_row(m, "rt_sigreturn", 15, 139);
    _syscall_map_row(m, "ioctl", 16, 29);
    _syscall_map_row(m, "access", 21, 0 - 1);
    _syscall_map_row(m, "pipe", 22, 0 - 1);
    _syscall_map_row(m, "dup", 32, 23);
    _syscall_map_row(m, "dup2", 33, 0 - 1);
    _syscall_map_row(m, "getpid", 39, 172);
    _syscall_map_row(m, "socket", 41, 198);
    _syscall_map_row(m, "connect", 42, 203);
    _syscall_map_row(m, "accept", 43, 202);
    _syscall_map_row(m, "sendto", 44, 206);
    _syscall_map_row(m, "recvfrom", 45, 207);
    _syscall_map_row(m, "bind", 49, 200);
    _syscall_map_row(m, "listen", 50, 201);
    _syscall_map_row(m, "fork", 57, 0 - 1);
    _syscall_map_row(m, "execve", 59, 221);
    _syscall_map_row(m, "exit", 60, 93);
    _syscall_map_row(m, "wait4", 61, 260);
    _syscall_map_row(m, "kill", 62, 129);
    _syscall_map_row(m, "fcntl", 72, 25);
    _syscall_map_row(m, "fsync", 74, 82);
    _syscall_map_row(m, "getcwd", 79, 17);
    _syscall_map_row(m, "chdir", 80, 49);
    _syscall_map_row(m, "mkdir", 83, 0 - 1);
    _syscall_map_row(m, "rmdir", 84, 0 - 1);
    _syscall_map_row(m, "unlink", 87, 0 - 1);
    _syscall_map_row(m, "chmod", 90, 0 - 1);
    _syscall_map_row(m, "getuid", 102, 174);
    _syscall_map_row(m, "getgid", 104, 176);
    _syscall_map_row(m, "geteuid", 107, 175);
    _syscall_map_row(m, "getegid", 108, 177);
    _syscall_map_row(m, "getppid", 110, 173);
    _syscall_map_row(m, "setsid", 112, 157);
    _syscall_map_row(m, "prctl", 157, 167);
    _syscall_map_row(m, "mount", 165, 40);
    _syscall_map_row(m, "umount2", 166, 39);
    _syscall_map_row(m, "gettid", 186, 178);
    _syscall_map_row(m, "futex", 202, 98);
    _syscall_map_row(m, "getdents64", 217, 61);
    _syscall_map_row(m, "set_tid_address", 218, 96);
    _syscall_map_row(m, "clock_gettime", 228, 113);
    _syscall_map_row(m, "exit_group", 231, 94);
    _syscall_map_row(m, "openat", 257, 56);
    _syscall_map_row(m, "set_robust_list", 273, 99);
    _syscall_map_row(m, "pipe2", 293, 59);
    _syscall_map_row(m, "epoll_create1", 291, 20);
    _syscall_map_row(m, "getrandom", 318, 278);
    _syscall_map_row(m, "rseq", 334, 293);
    _syscall_map = m;
    return 0;
}

# One name-map row: the number for the architecture this binary was built
# for. A name that architecture does not have (-1) is left out, so it maps
# to -1 rather than to some other call's number.
fn _syscall_map_row(m, name, x86_64_nr, aarch64_nr): i64 {
    var nr = _seccomp_native_nr(x86_64_nr, aarch64_nr);
    if (nr >= 0) { map_set(m, name, nr); }
    return 0;
}

# Map a syscall name to its number on the architecture this binary was built
# for. Returns -1 if not found, including for a name that architecture does not
# have: aarch64 has no open, stat, access, pipe, dup2, fork, mkdir, rmdir,
# unlink or chmod (its libc uses the *at forms, pipe2, dup3 and clone). Until
# 3.12.8 this returned the x86-64 number on every architecture.
fn security_syscall_name_to_nr(name): i64 {
    _syscall_map_init();
    if (map_has(_syscall_map, name) == 1) {
        return map_get(_syscall_map, name);
    }
    return 0 - 1;
}

# --- mac.cyr ---

# mac.cyr — Mandatory Access Control (MAC) interface
# Ported from rust-old/src/mac.rs
#
# Auto-detects the active Linux Security Module (SELinux or AppArmor)
# and provides security context / profile management.
#
# Reads /sys/kernel/security/lsm for LSM detection. SELinux mode from
# /sys/fs/selinux/enforce. AppArmor profiles via /proc/self/attr/current.
#
# Requires: lib/syscalls.cyr, lib/string.cyr, lib/str.cyr, src/error.cyr

#define LINUX
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"

# ================================================================
# MAC system constants
# ================================================================

enum MacSystem {
    MAC_NONE = 0;
    MAC_SELINUX = 1;
    MAC_APPARMOR = 2;
}

# ================================================================
# SELinux mode constants
# ================================================================

enum SELinuxMode {
    SELINUX_ENFORCING = 1;
    SELINUX_PERMISSIVE = 2;
    SELINUX_DISABLED = 3;
}

# ================================================================
# AppArmor profile state constants
# ================================================================

enum AppArmorState {
    AA_ENFORCE = 1;
    AA_COMPLAIN = 2;
    AA_UNCONFINED = 3;
}

# ================================================================
# File read helper — read a small file into a Str
# Returns Result: Ok(str_ptr) or Err(syserr)
# ================================================================

fn mac_read_file(path): i64 {
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) {
        return kavach_err_io(0 - fd, path);
    }
    defer { sys_close(fd); }
    # Read up to 4096 bytes (plenty for sysfs/procfs files)
    var buf = alloc(4097);
    memset(buf, 0, 4097);
    var n = sys_read(fd, buf, 4096);
    if (n < 0) {
        return kavach_err_io(0 - n, path);
    }
    # Null-terminate
    store8(buf + n, 0);
    # Create Str from buffer
    var s = str_new(buf, n);
    return Ok(s);
}

# ================================================================
# File write helper — write a C string to a file
# Returns Result: Ok(0) or Err(syserr)
# ================================================================

fn mac_write_file(path, data, data_len): i64 {
    var fd = file_open(path, O_WRONLY, 0);
    if (fd < 0) {
        var errno = 0 - fd;
        if (errno == EPERM) { return kavach_err_permission_denied(path); }
        if (errno == EACCES) { return kavach_err_permission_denied(path); }
        return kavach_err_io(errno, path);
    }
    defer { sys_close(fd); }
    var n = sys_write(fd, data, data_len);
    if (n < 0) {
        var werrno = 0 - n;
        if (werrno == EPERM) { return kavach_err_permission_denied(path); }
        if (werrno == EACCES) { return kavach_err_permission_denied(path); }
        return kavach_err_io(werrno, path);
    }
    return Ok(0);
}

# ================================================================
# File existence check — returns 1 if file exists, 0 otherwise
# ================================================================

fn mac_file_exists(path): i64 {
    # F_OK = 0
    return sys_access(path, 0) == 0;
}

# ================================================================
# Detect which MAC system is active on this kernel
# Reads /sys/kernel/security/lsm — returns MAC_SELINUX, MAC_APPARMOR,
# or MAC_NONE.
# ================================================================

fn mac_detect_system(): i64 {
    var res_t, res_v = mac_read_file("/sys/kernel/security/lsm");
    if (is_err_result(res_t) == 1) {
        # Cannot read LSM file — no MAC detection available
        return MAC_NONE;
    }
    var contents = res_v;

    # Check SELinux first (higher priority if both are listed)
    if (str_contains(contents, str_from("selinux")) == 1) {
        return MAC_SELINUX;
    }
    # Also check uppercase variant
    if (str_contains(contents, str_from("SELinux")) == 1) {
        return MAC_SELINUX;
    }

    if (str_contains(contents, str_from("apparmor")) == 1) {
        return MAC_APPARMOR;
    }
    if (str_contains(contents, str_from("AppArmor")) == 1) {
        return MAC_APPARMOR;
    }

    return MAC_NONE;
}

# ================================================================
# SELinux mode query
# Reads /sys/fs/selinux/enforce.
# Returns Result: Ok(mode) where mode is SELINUX_ENFORCING,
# SELINUX_PERMISSIVE, or SELINUX_DISABLED.
# ================================================================

fn mac_get_selinux_mode(): i64 {
    var enforce_path = "/sys/fs/selinux/enforce";

    if (mac_file_exists(enforce_path) == 0) {
        return Ok(SELINUX_DISABLED);
    }

    var res_t, res_v = mac_read_file(enforce_path);
    if (is_err_result(res_t) == 1) { return Err(res_v); }

    var contents = res_v;
    var trimmed = str_trim(contents);
    var data = str_data(trimmed);
    var tlen = str_len(trimmed);

    # "1" = enforcing, "0" = permissive
    if (tlen >= 1) {
        var ch = load8(data);
        if (ch == 49) { return Ok(SELINUX_ENFORCING); }
        if (ch == 48) { return Ok(SELINUX_PERMISSIVE); }
    }

    return Ok(SELINUX_DISABLED);
}

# ================================================================
# Set SELinux enforcement mode
# Writes to /sys/fs/selinux/enforce. Requires CAP_MAC_ADMIN.
# Returns Result: Ok(0) or Err.
# ================================================================

fn mac_set_selinux_mode(mode): i64 {
    var enforce_path = "/sys/fs/selinux/enforce";

    if (mac_file_exists(enforce_path) == 0) {
        return kavach_err_not_supported("selinux");
    }

    if (mode == SELINUX_DISABLED) {
        return kavach_err_invalid_argument("cannot disable SELinux at runtime; use kernel boot parameter");
    }

    if (mode == SELINUX_ENFORCING) {
        return mac_write_file(enforce_path, "1", 1);
    }
    if (mode == SELINUX_PERMISSIVE) {
        return mac_write_file(enforce_path, "0", 1);
    }

    return kavach_err_invalid_argument("invalid SELinux mode");
}

# ================================================================
# Get the current SELinux security context of this process
# Reads /proc/self/attr/current.
# Returns Result: Ok(str_ptr) or Err.
# ================================================================

fn mac_get_selinux_context(): i64 {
    var path = "/proc/self/attr/current";

    if (mac_file_exists(path) == 0) {
        return kavach_err_not_supported("selinux");
    }

    var res_t, res_v = mac_read_file(path);
    if (is_err_result(res_t) == 1) { return Err(res_v); }

    var raw = res_v;
    # Trim trailing nulls and whitespace
    var trimmed = str_trim(raw);
    return Ok(trimmed);
}

# ================================================================
# Set the SELinux security context for this process
# context: null-terminated C string (user:role:type:level)
# on_exec: if 1, apply on next exec (writes /proc/self/attr/exec)
#          if 0, apply immediately (writes /proc/self/attr/current)
# Returns Result: Ok(0) or Err.
# ================================================================

fn mac_set_selinux_context(context, on_exec): i64 {
    if (strlen(context) == 0) {
        return kavach_err_invalid_argument("SELinux context cannot be empty");
    }

    # Validate format: must have at least 3 colons (user:role:type:level)
    var ctx_len = strlen(context);
    var colon_count = 0;
    var vi = 0;
    while (vi < ctx_len) {
        if (load8(context + vi) == 58) {
            colon_count = colon_count + 1;
        }
        vi = vi + 1;
    }
    if (colon_count < 3) {
        return kavach_err_invalid_argument(
          "invalid SELinux context format (expected user:role:type:level)");
    }

    var path = "/proc/self/attr/current";
    if (on_exec == 1) {
        path = "/proc/self/attr/exec";
    }

    if (mac_file_exists(path) == 0) {
        return kavach_err_not_supported("selinux");
    }

    return mac_write_file(path, context, ctx_len);
}

# ================================================================
# Get the current AppArmor mode/profile of this process
# Reads /proc/self/attr/current.
# Returns Result: Ok(state) where state is AA_ENFORCE, AA_COMPLAIN,
# or AA_UNCONFINED.
# ================================================================

fn mac_get_apparmor_mode(): i64 {
    var path = "/proc/self/attr/current";

    if (mac_file_exists(path) == 0) {
        return kavach_err_not_supported("apparmor");
    }

    var res_t, res_v = mac_read_file(path);
    if (is_err_result(res_t) == 1) { return Err(res_v); }

    var raw = res_v;
    var trimmed = str_trim(raw);

    # AppArmor format: "profile_name (mode)" or "unconfined"
    if (str_contains(trimmed, str_from("unconfined")) == 1) {
        return Ok(AA_UNCONFINED);
    }
    if (str_contains(trimmed, str_from("enforce")) == 1) {
        return Ok(AA_ENFORCE);
    }
    if (str_contains(trimmed, str_from("complain")) == 1) {
        return Ok(AA_COMPLAIN);
    }

    # Default: if we got a non-empty profile, assume enforce mode
    if (str_len(trimmed) > 0) {
        return Ok(AA_ENFORCE);
    }

    return Ok(AA_UNCONFINED);
}

# ================================================================
# Change the AppArmor profile of the current process
# Writes "changeprofile <name>" to /proc/self/attr/current.
# profile_name: null-terminated C string.
# Returns Result: Ok(0) or Err.
# ================================================================

fn mac_apparmor_change_profile(profile_name): i64 {
    var name_len = strlen(profile_name);

    if (name_len == 0) {
        return kavach_err_invalid_argument("AppArmor profile name cannot be empty");
    }

    # Validate: no slashes or nulls in profile name
    var ci = 0;
    while (ci < name_len) {
        var ch = load8(profile_name + ci);
        if (ch == 47) {
            return kavach_err_invalid_argument("invalid AppArmor profile name: contains /");
        }
        if (ch == 0) {
            return kavach_err_invalid_argument("invalid AppArmor profile name: contains null");
        }
        ci = ci + 1;
    }

    var attr_path = "/proc/self/attr/current";
    if (mac_file_exists(attr_path) == 0) {
        return kavach_err_not_supported("apparmor");
    }

    # Build "changeprofile <name>" command
    var prefix = "changeprofile ";
    var prefix_len = strlen(prefix);
    var cmd_len = prefix_len + name_len;
    var cmd = alloc(cmd_len + 1);
    memcpy(cmd, prefix, prefix_len);
    memcpy(cmd + prefix_len, profile_name, name_len);
    store8(cmd + cmd_len, 0);

    return mac_write_file(attr_path, cmd, cmd_len);
}

# ================================================================
# Agent MAC profile struct
# Each field is a pointer to a null-terminated C string (or 0 for none).
# Total: 24 bytes (3 * 8). Accessors auto-generated:
#   getters: mac_profile_<field>(p)
#   setters: mac_profile_set_<field>(p, v)
# ================================================================

#derive(accessors)
struct mac_profile { agent_type; selinux_ctx; apparmor_name; }

fn mac_profile_new(agent_type): i64 {
    var p = alloc(24);
    mac_profile_set_agent_type(p, agent_type);
    mac_profile_set_selinux_ctx(p, 0);
    mac_profile_set_apparmor_name(p, 0);
    return p;
}

# Hand-rolled JSON serializer (cyrius v5.10.15 #derive(Serialize)
# doesn't support cstring-pointer fields; cyrius issue filed
# 2026-05-09). Mirrors the codegen output shape for migration when
# cstring support lands.
fn mac_profile_to_json(p, sb): i64 {
    str_builder_add_cstr(sb, "{\"agent_type\":");
    kavach_json_emit_cstr_or_null(sb, mac_profile_agent_type(p));
    str_builder_add_cstr(sb, ",\"selinux_ctx\":");
    kavach_json_emit_cstr_or_null(sb, mac_profile_selinux_ctx(p));
    str_builder_add_cstr(sb, ",\"apparmor_name\":");
    kavach_json_emit_cstr_or_null(sb, mac_profile_apparmor_name(p));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ================================================================
# Create a default agent MAC profile from an agent type string
# Generates standard SELinux context and AppArmor profile name.
# agent_type: null-terminated C string (e.g. "user", "service", "system")
# ================================================================

fn mac_default_profile(agent_type): i64 {
    var p = mac_profile_new(agent_type);
    var tlen = strlen(agent_type);

    # Build SELinux context: "system_u:system_r:agnos_agent_<type>_t:s0"
    # Max: 29 + 32 (type) + 5 = 66 bytes
    var ctx_prefix = "system_u:system_r:agnos_agent_";
    var ctx_suffix = "_t:s0";
    var cplen = 29;
    var cslen = 5;
    # Build straight into the heap allocation (caller may hold the pointer
    # beyond alloc_reset). Skips a static staging buffer + the extra
    # buffer→heap copy, and avoids the function-scoped `var buf[N]`
    # static-data hazard.
    var ctx_total = cplen + tlen + cslen;
    var ctx = alloc(ctx_total + 1);
    memcpy(ctx, ctx_prefix, cplen);
    memcpy(ctx + cplen, agent_type, tlen);
    memcpy(ctx + cplen + tlen, ctx_suffix, cslen);
    store8(ctx + cplen + tlen + cslen, 0);
    mac_profile_set_selinux_ctx(p, ctx);

    # Build AppArmor profile: "agnos-agent-<type>"
    var aa_prefix = "agnos-agent-";
    var aplen = 12;
    var aa_total = aplen + tlen;
    var aa = alloc(aa_total + 1);
    memcpy(aa, aa_prefix, aplen);
    memcpy(aa + aplen, agent_type, tlen);
    store8(aa + aplen + tlen, 0);
    mac_profile_set_apparmor_name(p, aa);

    return p;
}

# ================================================================
# Validate an agent MAC profile for a given MAC system
# Returns Result: Ok(0) on valid, Err on invalid.
# ================================================================

fn mac_profile_validate(profile, mac_system): i64 {
    var agent_type = mac_profile_agent_type(profile);
    if (agent_type == 0) {
        return kavach_err_invalid_argument("agent type cannot be empty");
    }
    if (strlen(agent_type) == 0) {
        return kavach_err_invalid_argument("agent type cannot be empty");
    }

    if (mac_system == MAC_SELINUX) {
        var ctx = mac_profile_selinux_ctx(profile);
        if (ctx == 0) {
            return kavach_err_invalid_argument("SELinux context required but not set");
        }
        var ctx_len = strlen(ctx);
        if (ctx_len == 0) {
            return kavach_err_invalid_argument("SELinux context required but not set");
        }
        # Count colons — must have at least 3 (user:role:type:level)
        var colon_count = 0;
        var vi = 0;
        while (vi < ctx_len) {
            if (load8(ctx + vi) == 58) { colon_count = colon_count + 1; }
            vi = vi + 1;
        }
        if (colon_count < 3) {
            return kavach_err_invalid_argument("invalid SELinux context format");
        }
    }

    if (mac_system == MAC_APPARMOR) {
        var aa_name = mac_profile_apparmor_name(profile);
        if (aa_name == 0) {
            return kavach_err_invalid_argument("AppArmor profile name required but not set");
        }
        var aa_len = strlen(aa_name);
        if (aa_len == 0) {
            return kavach_err_invalid_argument("AppArmor profile name required but not set");
        }
        # No slashes or nulls allowed
        var ai = 0;
        while (ai < aa_len) {
            if (load8(aa_name + ai) == 47) {
                return kavach_err_invalid_argument("invalid AppArmor profile name");
            }
            ai = ai + 1;
        }
    }

    return Ok(0);
}

# ================================================================
# Apply agent MAC profile based on detected MAC system
# Detects the active MAC system, finds the matching profile,
# validates it, and applies it.
# agent_type: C string of agent type to match
# profiles: vec of mac_profile pointers
# profile_count: number of profiles
# Returns Result: Ok(0) or Err.
# ================================================================

fn mac_apply_agent_profile(agent_type, profiles, profile_count): i64 {
    var mac_system = mac_detect_system();

    if (mac_system == MAC_NONE) {
        # No MAC system active — nothing to do
        return Ok(0);
    }

    # Find matching profile
    var found = 0;
    var idx = 0;
    while (idx < profile_count) {
        var p = vec_get(profiles, idx);
        var ptype = mac_profile_agent_type(p);
        if (streq(ptype, agent_type) == 1) {
            found = p;
            idx = profile_count;  # match found — end the loop (no break in var-loop)
        } else {
            idx = idx + 1;
        }
    }

    if (found == 0) {
        return kavach_err_invalid_argument("no MAC profile found for agent type");
    }

    # Validate the profile
    var vres_t, vres_v = mac_profile_validate(found, mac_system);
    if (is_err_result(vres_t) == 1) { return Err(vres_v); }

    if (mac_system == MAC_SELINUX) {
        var ctx = mac_profile_selinux_ctx(found);
        # Apply on next exec
        return mac_set_selinux_context(ctx, 1);
    }

    if (mac_system == MAC_APPARMOR) {
        var aa_name = mac_profile_apparmor_name(found);
        return mac_apparmor_change_profile(aa_name);
    }

    return kavach_err_unknown("cannot apply MAC profile: unknown MAC system");
}

# --- kernel_audit.cyr ---

# audit.cyr — Linux Audit Subsystem interface
# Ported from rust-old/src/audit.rs
#
# Provides netlink audit socket management, event sending, status queries,
# rule add/delete, and AGNOS /proc audit reading.
#
# Requires CAP_AUDIT_CONTROL for configuration and CAP_AUDIT_WRITE for events.
#
# Requires: lib/syscalls.cyr, lib/string.cyr, lib/str.cyr,
#           lib/net.cyr, src/error.cyr

#define LINUX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "lib/net.cyr"
include "lib/process.cyr"

# ================================================================
# Netlink / audit constants
# ================================================================

enum AuditConst {
    AF_NETLINK = 16;
    SOCK_RAW = 3;
    NETLINK_AUDIT = 9;
    NLMSG_HDRLEN = 16;
    NLM_F_REQUEST = 1;
    NLM_F_ACK = 4;
    NLMSG_NOOP = 1;
    NLMSG_ERROR = 2;
    NLMSG_DONE = 3;
    AUDIT_GET = 1000;
    AUDIT_SET = 1001;
    AUDIT_USER = 1005;
    AUDIT_ADD_RULE = 1011;
    AUDIT_DEL_RULE = 1012;
    SYS_AGNOS_AUDIT_LOG = 520;
    AUDIT_MAX_MSG_LEN = 8192;
    AUDIT_MAX_KEY_LEN = 256;
    AUDIT_STATUS_ENABLED = 1;
    EPROTONOSUPPORT = 93;
}

# The netlink socket calls go through the stdlib's sys_socket / sys_bind /
# sys_sendto / sys_recvfrom, which carry each architecture's own number. Until
# 3.12.8 they were raw x86-64 numbers (41/49/44/45) that were right on aarch64
# only because cyrius renumbers those four. They are reached ONLY from the
# `#ifndef CYRIUS_TARGET_AGNOS` branches below: agnos has no BSD sockets, and
# the stdlib does not define the first three there.

# ================================================================
# Audit rule type constants
# ================================================================

enum AuditRuleType {
    AUDIT_RULE_FILE_WATCH = 1;
    AUDIT_RULE_SYSCALL_WATCH = 2;
}

# ================================================================
# Audit config struct — 3 fields * 8 = 24 bytes.
# 1.0 surface uses asymmetric setter names: getters keep the `use_`
# prefix (`audit_config_use_netlink/use_proc`) but setters drop it
# (`audit_config_set_netlink/set_proc`). Field names match the
# getters; the asymmetric setters stay as thin hand-written wrappers
# delegating through the derive-generated `set_use_*`.
# ================================================================

#derive(accessors)
struct audit_config { use_netlink; use_proc; proc_path; }

fn audit_config_new(): i64 {
    var c = alloc(24);
    audit_config_set_use_netlink(c, 1);
    audit_config_set_use_proc(c, 0);
    audit_config_set_proc_path(c, "/proc/agnos/audit");
    return c;
}

# 1.0 API preservation — asymmetric setter names delegate to derive.
fn audit_config_set_netlink(c, val): i64 { return audit_config_set_use_netlink(c, val); }
fn audit_config_set_proc(c, val): i64 { return audit_config_set_use_proc(c, val); }

# ================================================================
# Audit handle struct — 2 fields * 8 = 16 bytes.
# ================================================================

#derive(accessors)
struct audit_handle { fd; config; }

fn audit_handle_new(fd, config): i64 {
    var h = alloc(16);
    audit_handle_set_fd(h, fd);
    audit_handle_set_config(h, config);
    return h;
}

# ================================================================
# Audit status struct — 6 i64 fields * 8 = 48 bytes.
# ================================================================

#derive(accessors)
#derive(Serialize)
struct audit_status { enabled; failure_action; pid; backlog_limit; lost; backlog; }

fn audit_status_new(): i64 {
    var s = alloc(48);
    audit_status_set_enabled(s, 0);
    audit_status_set_failure_action(s, 1);    # printk
    audit_status_set_pid(s, 0);
    audit_status_set_backlog_limit(s, 8192);
    audit_status_set_lost(s, 0);
    audit_status_set_backlog(s, 0);
    return s;
}

# ================================================================
# Audit rule struct — 4 fields * 8 = 32 bytes.
# 1.0 surface uses `audit_rule_syscall(r)` as the getter, but
# `syscall` is a cyrius builtin so it can't be a struct field name.
# Field is named `syscall_nr` (matches the constructor arg);
# the 1.0 `audit_rule_syscall(r)` getter stays as a thin wrapper.
# ================================================================

#derive(accessors)
struct audit_rule { type; path; syscall_nr; key; }

fn audit_rule_new(rule_type, path, syscall_nr, key): i64 {
    var r = alloc(32);
    audit_rule_set_type(r, rule_type);
    audit_rule_set_path(r, path);
    audit_rule_set_syscall_nr(r, syscall_nr);
    audit_rule_set_key(r, key);
    return r;
}

# 1.0 API preservation — `syscall` getter delegates to `syscall_nr`.
fn audit_rule_syscall(r): i64 { return audit_rule_syscall_nr(r); }

# Create a file watch rule
fn audit_rule_file_watch(path, key): i64 {
    return audit_rule_new(AUDIT_RULE_FILE_WATCH, path, 0, key);
}

# Create a syscall watch rule
fn audit_rule_syscall_watch(syscall_nr, key): i64 {
    return audit_rule_new(AUDIT_RULE_SYSCALL_WATCH, 0, syscall_nr, key);
}

# ================================================================
# Rule validation
# Returns Result: Ok(0) if valid, Err if not.
# ================================================================

fn audit_rule_validate(rule): i64 {
    var key = audit_rule_key(rule);
    if (key == 0) {
        return kavach_err_invalid_argument("audit rule key cannot be empty");
    }
    var key_len = strlen(key);
    if (key_len == 0) {
        return kavach_err_invalid_argument("audit rule key cannot be empty");
    }
    if (key_len > AUDIT_MAX_KEY_LEN) {
        return kavach_err_invalid_argument("audit rule key too long (max 256)");
    }

    var rtype = audit_rule_type(rule);
    if (rtype == AUDIT_RULE_FILE_WATCH) {
        var path = audit_rule_path(rule);
        if (path == 0) {
            return kavach_err_invalid_argument("FileWatch rule requires a path");
        }
        var path_len = strlen(path);
        if (path_len == 0) {
            return kavach_err_invalid_argument("FileWatch path cannot be empty");
        }
        # Path must be absolute (start with '/')
        if (load8(path) != 47) {
            return kavach_err_invalid_argument("FileWatch path must be absolute");
        }
        # Reject path traversal via ".." components
        var pi = 0;
        while (pi < path_len - 1) {
            if (load8(path + pi) == 46 && load8(path + pi + 1) == 46) {
                return kavach_err_invalid_argument("audit path contains ..");
            }
            pi = pi + 1;
        }
    }
    elif (rtype == AUDIT_RULE_SYSCALL_WATCH) {
        # syscall_nr is stored directly, 0 is a valid syscall (read)
        # so we just accept it
    }
    else {
        return kavach_err_invalid_argument("unknown audit rule type");
    }

    return Ok(0);
}

# ================================================================
# Kernel-ABI structs — typed fields enforce the byte layout the
# kernel expects via syscall (sockaddr_nl: 12 B; nlmsghdr: 16 B;
# audit_kstatus: 32 B). Pointer-to-struct dot syntax produces
# tight-packed kernel-correct offsets; using `var s: <struct> = buf;`
# avoids derive(accessors) which lays fields out at i64 slots.
# Width-correct codegen (cyrius 5.8.16+) emits the right
# store16/store32/load32 instructions automatically.
# ================================================================

struct sockaddr_nl {
    nl_family: i16;
    nl_pad: i16;
    nl_pid: i32;
    nl_groups: i32;
}

struct nlmsghdr {
    nlmsg_len: i32;
    nlmsg_type: i16;
    nlmsg_flags: i16;
    nlmsg_seq: i32;
    nlmsg_pid: i32;
}

# Kernel `struct audit_status` (first 32 bytes — agnosys reads/writes
# the fields it needs; kernel struct continues with additional fields
# we currently don't touch).
struct audit_kstatus {
    mask: i32;
    enabled: i32;
    failure: i32;
    pid: i32;
    rate_limit: i32;
    backlog_limit: i32;
    lost: i32;
    backlog: i32;
}

fn audit_sockaddr_nl(pid): i64 {
    var buf = alloc(12);
    memset(buf, 0, 12);
    var sa: sockaddr_nl = buf;
    sa.nl_family = AF_NETLINK;
    sa.nl_pid = pid;
    return buf;
}

# ================================================================
# Build a netlink message header + payload
# Returns pointer to the buffer (stores total length at the head).
# ================================================================

fn audit_build_nlmsg(msg_type, payload_ptr, payload_len): i64 {
    var total_len = NLMSG_HDRLEN + payload_len;
    var buf = alloc(total_len);
    memset(buf, 0, total_len);

    var hdr: nlmsghdr = buf;
    hdr.nlmsg_len = total_len;
    hdr.nlmsg_type = msg_type;
    hdr.nlmsg_flags = NLM_F_REQUEST;
    hdr.nlmsg_seq = _audit_next_seq();
    hdr.nlmsg_pid = sys_getpid();

    if (payload_len > 0) {
        memcpy(buf + NLMSG_HDRLEN, payload_ptr, payload_len);
    }

    return buf;
}

# Get total length of a built nlmsg (read from the header)
fn audit_nlmsg_len(buf): i64 {
    return load32(buf);
}

# Netlink sequence numbers, one per request (3.12.9). Every request used seq 1,
# so a reply left queued by an earlier request was indistinguishable from the
# current one's.
var _audit_seq = 0;

fn _audit_next_seq(): i64 {
    # 3.14.8: one atomic step, so two threads' requests never share a number.
    return atomic_fetch_add(&_audit_seq, 1) + 1;
}

# struct nlmsgerr's `error` is an s32; `load32` zero-extends, so -1 read as
# 4294967295 and the errno reported was garbage.
fn _audit_s32(v): i64 {
    if (v >= 2147483648) { return v - 4294967296; }
    return v;
}

# Send a request with NLM_F_ACK and wait for the kernel's answer to it (3.12.9).
#
# ⛔ The control calls below sent their request and returned Ok(0) as soon as
# the SEND succeeded; none read a reply. The kernel answers a failure with an
# NLMSG_ERROR whether or not an ack was asked for, so, unprivileged, enabling
# auditing or adding a watch rule failed with EPERM in a reply nobody read, and
# the caller was told the control was in place. Now the reply decides: an
# NLMSG_ERROR carrying 0 is the ack, anything else the errno. Replies to other
# sequence numbers are skipped, a bounded number of them.
fn _audit_request_acked(handle, nlmsg, what): i64 {
    var hdr: nlmsghdr = nlmsg;
    hdr.nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
    var seq = hdr.nlmsg_seq;
    var sres_t, sres_v = audit_send_raw(handle, nlmsg, audit_nlmsg_len(nlmsg));
    if (is_err_result(sres_t) == 1) { return Err(sres_v); }
    var buf = alloc(1024);
    var tries = 0;
    while (tries < 8) {
        memset(buf, 0, 1024);
        var rres_t, rres_v = audit_recv_raw(handle, buf, 1024);
        if (is_err_result(rres_t) == 1) { return Err(rres_v); }
        if (rres_v < NLMSG_HDRLEN + 4) {
            return kavach_err_unknown("audit reply truncated (no nlmsgerr)");
        }
        var rh: nlmsghdr = buf;
        if (rh.nlmsg_seq == seq) {
            if (rh.nlmsg_type != NLMSG_ERROR) {
                return kavach_err_unknown("audit reply is not an acknowledgement");
            }
            var nerr = _audit_s32(load32(buf + NLMSG_HDRLEN));
            if (nerr == 0) { return Ok(0); }
            return kavach_err_syscall_failed(0 - nerr, what);
        }
        tries = tries + 1;
    }
    return kavach_err_unknown("no acknowledgement for the audit request");
}

# ================================================================
# Open an audit connection
# config: pointer to audit_config struct
# Returns Result: Ok(handle_ptr) or Err.
# ================================================================

fn audit_open(config): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no NETLINK_AUDIT and no BSD sockets. The Linux socket()/bind()
    # numbers (41, 49) alias DANGEROUSLY on agnos's 0-62 table (#41=sleep_ms,
    # #49=sock_recv), so a raw syscall(49, fd, sockaddr, 12) would invoke
    # sock_recv with a sockaddr as a destination buffer — memory-unsafe. Never
    # reach them; report unsupported the same way security.cyr does for
    # LANDLOCK/SECCOMP/NAMESPACES. The sovereign audit path on AGNOS is the HMAC
    # chain in audit.cyr, not netlink.
    return kavach_err_not_supported("NETLINK_AUDIT");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = 0 - 1;

    if (audit_config_use_netlink(config) == 1) {
        # socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_AUDIT)
        var sock_flags = SOCK_RAW | SOCK_CLOEXEC;
        fd = sys_socket(AF_NETLINK, sock_flags, NETLINK_AUDIT);
        if (fd < 0) {
            var errno = 0 - fd;
            if (errno == EPERM) {
                return kavach_err_permission_denied("open_audit netlink socket");
            }
            if (errno == EACCES) {
                return kavach_err_permission_denied("open_audit netlink socket");
            }
            if (errno == EPROTONOSUPPORT) {
                return kavach_err_not_supported("NETLINK_AUDIT");
            }
            return kavach_err_syscall_failed(errno, "socket(NETLINK_AUDIT) failed");
        }

        # Bind the socket
        var sa = audit_sockaddr_nl(sys_getpid());
        var ret = sys_bind(fd, sa, 12);
        if (ret < 0) {
            sys_close(fd);
            return kavach_err_syscall_failed(0 - ret, "bind(NETLINK_AUDIT) failed");
        }
    }

    # Verify proc path if configured
    if (audit_config_use_proc(config) == 1) {
        var proc_path = audit_config_proc_path(config);
        # Non-fatal: netlink still works even if the proc path is unreadable.
        # (agnosys log_warn dropped in the agnosys→kavach fold — no kavach logger
        # wired yet; rewire to kavach's logging when one exists.)
    }

    var handle = audit_handle_new(fd, config);
    return Ok(handle);
    #endif
}

# ================================================================
# Close an audit handle
# Closes the netlink socket if open.
# ================================================================

fn audit_close(handle): i64 {
    var fd = audit_handle_fd(handle);
    if (fd >= 0) {
        syscall(SYS_CLOSE, fd);
    }
    return 0;
}

# ================================================================
# Send raw netlink message on audit socket
# Returns Result: Ok(bytes_sent) or Err.
# ================================================================

fn audit_send_raw(handle, buf, buf_len): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Linux sendto is 44; on agnos #44 is unassigned. No netlink on agnos.
    return kavach_err_not_supported("NETLINK_AUDIT");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = audit_handle_fd(handle);
    if (fd < 0) {
        return kavach_err_invalid_argument("audit handle has no netlink socket");
    }

    # sendto(fd, buf, len, 0, NULL, 0)
    var ret = sys_sendto(fd, buf, buf_len, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "send(audit) failed");
    }
    return Ok(ret);
    #endif
}

# ================================================================
# Receive raw netlink message from audit socket
# buf: receive buffer, buf_len: buffer capacity
# Returns Result: Ok(bytes_received) or Err.
# ================================================================

fn audit_recv_raw(handle, buf, buf_len): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Linux recvfrom is 45; on agnos #45 is getrandom. No netlink on agnos.
    return kavach_err_not_supported("NETLINK_AUDIT");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = audit_handle_fd(handle);
    if (fd < 0) {
        return kavach_err_invalid_argument("audit handle has no netlink socket");
    }

    # recvfrom(fd, buf, len, 0, NULL, NULL)
    var ret = sys_recvfrom(fd, buf, buf_len, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "recv(audit) failed");
    }
    return Ok(ret);
    #endif
}

# ================================================================
# Send an audit user event
# event_type: C string (e.g. "AGENT_START")
# message: C string payload
# Returns Result: Ok(0) or Err.
# ================================================================

fn audit_send_event(handle, event_type, message): i64 {
    var fd = audit_handle_fd(handle);
    if (fd < 0) {
        return kavach_err_invalid_argument("audit handle has no netlink socket");
    }

    if (strlen(event_type) == 0) {
        return kavach_err_invalid_argument("event type cannot be empty");
    }

    var msg_len = strlen(message);
    if (msg_len > AUDIT_MAX_MSG_LEN) {
        return kavach_err_invalid_argument("audit message too large (max 8192)");
    }

    # Build payload: "op=<event_type> <message>"
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "op=");
    str_builder_add_cstr(sb, event_type);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, message);
    var payload = str_builder_build(sb);

    var payload_data = str_data(payload);
    var payload_len = str_len(payload);

    # Build netlink message with AUDIT_USER type
    var nlmsg = audit_build_nlmsg(AUDIT_USER, payload_data, payload_len);
    return _audit_request_acked(handle, nlmsg, "AUDIT_USER refused by the kernel");
}

# ================================================================
# Get audit subsystem status (AUDIT_GET)
# Returns Result: Ok(audit_status_ptr) or Err.
# ================================================================

fn audit_get_status(handle): i64 {
    var fd = audit_handle_fd(handle);
    if (fd < 0) {
        return kavach_err_invalid_argument("audit handle has no netlink socket");
    }

    # Send AUDIT_GET request (no payload)
    var nlmsg = audit_build_nlmsg(AUDIT_GET, 0, 0);
    var total_len = audit_nlmsg_len(nlmsg);
    var get_hdr: nlmsghdr = nlmsg;
    var get_seq = get_hdr.nlmsg_seq;

    var sres_t, sres_v = audit_send_raw(handle, nlmsg, total_len);
    if (is_err_result(sres_t) == 1) { return Err(sres_v); }

    # Receive response
    var recv_buf = alloc(4096);
    memset(recv_buf, 0, 4096);

    var rres_t, rres_v = audit_recv_raw(handle, recv_buf, 4096);
    if (is_err_result(rres_t) == 1) { return Err(rres_v); }

    var nbytes = rres_v;
    # Audit F-6 (2026-04-26): validate the full nlmsghdr, not just length.
    # Per CVE-2026-31495 (ctnetlink) and the broader netlink validation
    # CVE class, defensive parsers must verify type + seq match the
    # request and surface NLMSG_ERROR replies as structured errors
    # instead of treating them as success.
    if (nbytes < NLMSG_HDRLEN) {
        return kavach_err_unknown("AUDIT_GET reply truncated (no nlmsghdr)");
    }
    var hdr: nlmsghdr = recv_buf;
    if (hdr.nlmsg_len > nbytes) {
        return kavach_err_unknown("AUDIT_GET reply nlmsg_len exceeds bytes received");
    }
    if (hdr.nlmsg_seq != get_seq) {
        return kavach_err_unknown("AUDIT_GET reply seq mismatch");
    }
    if (hdr.nlmsg_type == NLMSG_ERROR) {
        # struct nlmsgerr { s32 error; struct nlmsghdr msg; }
        if (nbytes < NLMSG_HDRLEN + 4) {
            return kavach_err_unknown("NLMSG_ERROR reply truncated (no error code)");
        }
        var nerr = _audit_s32(load32(recv_buf + NLMSG_HDRLEN));  # negative errno
        if (nerr == 0) {
            return kavach_err_unknown("NLMSG_ERROR with zero error (ack-only)");
        }
        return kavach_err_syscall_failed(0 - nerr, "AUDIT_GET kernel returned NLMSG_ERROR");
    }
    if (hdr.nlmsg_type != AUDIT_GET) {
        return kavach_err_unknown("AUDIT_GET reply unexpected nlmsg_type");
    }
    if (nbytes < NLMSG_HDRLEN + 24) {
        return kavach_err_unknown("AUDIT_GET response too short for audit_status");
    }

    # Parse audit_status from payload after nlmsghdr.
    var ks: audit_kstatus = recv_buf + NLMSG_HDRLEN;
    var status = audit_status_new();
    audit_status_set_enabled(status, ks.enabled);
    audit_status_set_failure_action(status, ks.failure);
    audit_status_set_pid(status, ks.pid);
    audit_status_set_backlog_limit(status, ks.backlog_limit);
    audit_status_set_lost(status, ks.lost);
    audit_status_set_backlog(status, ks.backlog);

    return Ok(status);
}

# ================================================================
# Enable or disable the audit subsystem (AUDIT_SET)
# enabled: 1 to enable, 0 to disable
# Returns Result: Ok(0) or Err.
# ================================================================

fn audit_set_enabled(handle, enabled): i64 {
    var fd = audit_handle_fd(handle);
    if (fd < 0) {
        return kavach_err_invalid_argument("audit handle has no netlink socket");
    }

    # Build audit_status payload — set mask=AUDIT_STATUS_ENABLED (1)
    # and the enabled field; other fields stay zero.
    var pld_len = 32;
    var pld = alloc(pld_len);
    memset(pld, 0, pld_len);
    var ks: audit_kstatus = pld;
    ks.mask = AUDIT_STATUS_ENABLED;
    ks.enabled = enabled;

    var nlmsg = audit_build_nlmsg(AUDIT_SET, pld, pld_len);
    return _audit_request_acked(handle, nlmsg, "AUDIT_SET refused by the kernel");
}

# ================================================================
# Send an audit rule message (add or delete)
# msg_type: AUDIT_ADD_RULE or AUDIT_DEL_RULE
# rule: pointer to audit rule struct
# Returns Result: Ok(0) or Err.
# ================================================================

fn audit_send_rule_msg(handle, rule, msg_type): i64 {
    var fd = audit_handle_fd(handle);
    if (fd < 0) {
        return kavach_err_invalid_argument("audit handle has no netlink socket");
    }

    # Build rule text payload
    var sb = str_builder_new();
    var rtype = audit_rule_type(rule);

    if (rtype == AUDIT_RULE_FILE_WATCH) {
        str_builder_add_cstr(sb, "watch=");
        var path = audit_rule_path(rule);
        if (path != 0) {
            str_builder_add_cstr(sb, path);
        }
        str_builder_add_cstr(sb, " key=");
        str_builder_add_cstr(sb, audit_rule_key(rule));
    }
    elif (rtype == AUDIT_RULE_SYSCALL_WATCH) {
        str_builder_add_cstr(sb, "syscall=");
        str_builder_add_int(sb, audit_rule_syscall(rule));
        str_builder_add_cstr(sb, " key=");
        str_builder_add_cstr(sb, audit_rule_key(rule));
    }

    var rule_text = str_builder_build(sb);
    var rule_data = str_data(rule_text);
    var rule_len = str_len(rule_text);

    var nlmsg = audit_build_nlmsg(msg_type, rule_data, rule_len);
    return _audit_request_acked(handle, nlmsg, "audit rule refused by the kernel");
}

# ================================================================
# Add an audit rule
# Returns Result: Ok(0) or Err.
# ================================================================

fn audit_add_rule(handle, rule): i64 {
    var vres_t, vres_v = audit_rule_validate(rule);
    if (is_err_result(vres_t) == 1) { return Err(vres_v); }

    return audit_send_rule_msg(handle, rule, AUDIT_ADD_RULE);
}

# ================================================================
# Delete an audit rule
# Returns Result: Ok(0) or Err.
# ================================================================

fn audit_delete_rule(handle, rule): i64 {
    var vres_t, vres_v = audit_rule_validate(rule);
    if (is_err_result(vres_t) == 1) { return Err(vres_v); }

    return audit_send_rule_msg(handle, rule, AUDIT_DEL_RULE);
}

# ================================================================
# Read audit events from /proc/agnos/audit
# Reads the file line-by-line and returns a vec of raw line Str pointers.
# (Full JSON parsing is beyond Cyrius scope — consumers parse the Strs.)
# proc_path: C string path to the proc file
# Returns Result: Ok(vec_of_strs) or Err.
# ================================================================

fn audit_read_proc_events(proc_path): i64 {
    # Check if file exists
    if (sys_access(proc_path, 0) != 0) {
        # File does not exist — return empty vec
        return Ok(vec_new());
    }

    var fd = file_open(proc_path, O_RDONLY, 0);
    if (fd < 0) {
        return kavach_err_io(0 - fd, proc_path);
    }
    defer { sys_close(fd); }

    # Read entire file (up to 64KB)
    var buf_size = 65536;
    var buf = alloc(buf_size + 1);
    memset(buf, 0, buf_size + 1);
    var total_read = 0;

    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(fd, buf + total_read, buf_size - total_read);
        if (n <= 0) {
            rgo = 0;
        } else {
            total_read = total_read + n;
            if (total_read >= buf_size) { rgo = 0; }
        }
    }

    if (total_read == 0) {
        return Ok(vec_new());
    }

    # Null-terminate
    store8(buf + total_read, 0);

    # Split into lines (by newline = 10)
    var contents = str_new(buf, total_read);
    var lines = str_split(contents, 10);
    var entries = vec_new();

    var line_count = vec_len(lines);
    var li = 0;
    while (li < line_count) {
        var line = vec_get(lines, li);
        var trimmed = str_trim(line);
        if (str_len(trimmed) > 0) {
            vec_push(entries, trimmed);
        }
        li = li + 1;
    }

    return Ok(entries);
}

# ================================================================
# Log via AGNOS custom syscall (SYS_AGNOS_AUDIT_LOG = 520)
# action: C string (max 256 bytes)
# data: C string (max 4096 bytes)
# result_code: integer result code (0 = success)
# Returns Result: Ok(0) or Err.
# ================================================================

fn audit_agnos_log(action, data, result_code): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # SYS_AGNOS_AUDIT_LOG=520 is out of agnos's 0-62 syscall range (no #520 arm
    # exists → dispatch returns -1); despite the name there is NO kernel audit-log
    # syscall on agnos. The sovereign audit path is the HMAC chain in audit.cyr.
    return kavach_err_not_supported("SYS_AGNOS_AUDIT_LOG");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var action_len = strlen(action);
    if (action_len == 0) {
        return kavach_err_invalid_argument("audit action cannot be empty");
    }
    if (action_len > 256) {
        return kavach_err_invalid_argument("audit action too long (max 256)");
    }

    var data_len = strlen(data);
    if (data_len > 4096) {
        return kavach_err_invalid_argument("audit data too long (max 4096)");
    }

    var ret = syscall(SYS_AGNOS_AUDIT_LOG, action, data, result_code);
    if (ret < 0) {
        var errno = 0 - ret;
        if (errno == ENOSYS) {
            return kavach_err_not_supported("SYS_AGNOS_AUDIT_LOG");
        }
        if (errno == EPERM) {
            return kavach_err_permission_denied("agnos_audit_log");
        }
        return kavach_err_syscall_failed(errno, "SYS_AGNOS_AUDIT_LOG failed");
    }

    return Ok(0);
    #endif
}

# --- backend.cyr ---

# kavach — Backend enum and metadata
# Ported from rust-old/src/backend/mod.rs

enum KavachBackend {
    PROCESS = 0;
    GVISOR = 1;
    FIRECRACKER = 2;
    WASM = 3;
    OCI = 4;
    SGX = 5;
    SEV = 6;
    TDX = 7;
    SY_AGNOS = 8;
    NOOP = 9;
}

var KAVACH_BACKEND_COUNT = 10;

# Renamed from `backend_name` (3.8.2): ai-hwaccel — pulled transitively via
# [deps.samay] since 3.8.0 — defines its own `backend_name(b)` over a DIFFERENT
# enum (BACKEND_CUDA..BACKEND_WINDOWS, 17 hardware-detection backends). Both
# enums start at 0, cycc resolves duplicate fns last-definition-wins, and
# ai-hwaccel sorts after kavach — so the collision silently returned hardware
# names for OS backends (`backend_name(KavachBackend.OCI)` → "intel-npu"). `os_`
# marks this as the OS/isolation-backend namer; ai-hwaccel keeps the bare name.
fn os_backend_name(b) {
    if (b == KavachBackend.PROCESS) { return "process"; }
    if (b == KavachBackend.GVISOR) { return "gvisor"; }
    if (b == KavachBackend.FIRECRACKER) { return "firecracker"; }
    if (b == KavachBackend.WASM) { return "wasm"; }
    if (b == KavachBackend.OCI) { return "oci"; }
    if (b == KavachBackend.SGX) { return "sgx"; }
    if (b == KavachBackend.SEV) { return "sev"; }
    if (b == KavachBackend.TDX) { return "tdx"; }
    if (b == KavachBackend.SY_AGNOS) { return "sy-agnos"; }
    if (b == KavachBackend.NOOP) { return "noop"; }
    return "unknown";
}

# Case-insensitive parse. Returns backend code on success, -1 on unknown.
fn backend_parse(s) {
    if (strieq(s, "process") == 1) { return KavachBackend.PROCESS; }
    if (strieq(s, "gvisor") == 1) { return KavachBackend.GVISOR; }
    if (strieq(s, "firecracker") == 1) { return KavachBackend.FIRECRACKER; }
    if (strieq(s, "wasm") == 1) { return KavachBackend.WASM; }
    if (strieq(s, "oci") == 1) { return KavachBackend.OCI; }
    if (strieq(s, "sgx") == 1) { return KavachBackend.SGX; }
    if (strieq(s, "sev") == 1) { return KavachBackend.SEV; }
    if (strieq(s, "tdx") == 1) { return KavachBackend.TDX; }
    if (strieq(s, "sy-agnos") == 1) { return KavachBackend.SY_AGNOS; }
    if (strieq(s, "syagnos") == 1) { return KavachBackend.SY_AGNOS; }
    if (strieq(s, "noop") == 1) { return KavachBackend.NOOP; }
    return 0 - 1;
}

# Existence check via the stdlib access(2) wrapper with F_OK (mode 0).
# Returns 1 if the path exists, 0 otherwise. (Was a raw `syscall(21, ...)`;
# routing through sys_access drops the bare syscall + magic number — S2.)
fn kavach_path_exists(path) {
    if (sys_access(path, 0) == 0) { return 1; }
    return 0;
}

# Check common PATH locations for a binary. Returns 1 if any exists.
fn which_exists(name) {
    var nlen = strlen(name);
    var buf = alloc(nlen + 24);

    var p1 = "/usr/local/bin/";
    memcpy(buf, p1, strlen(p1));
    memcpy(buf + strlen(p1), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p2 = "/usr/bin/";
    memcpy(buf, p2, strlen(p2));
    memcpy(buf + strlen(p2), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p3 = "/bin/";
    memcpy(buf, p3, strlen(p3));
    memcpy(buf + strlen(p3), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p4 = "/usr/sbin/";
    memcpy(buf, p4, strlen(p4));
    memcpy(buf + strlen(p4), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    return 0;
}

# Look for wasmtime on PATH. Returns path cstr, or 0 if none.
fn _wasm_binary_path() {
    if (kavach_path_exists("/usr/local/bin/wasmtime") == 1) { return "/usr/local/bin/wasmtime"; }
    if (kavach_path_exists("/usr/bin/wasmtime") == 1) { return "/usr/bin/wasmtime"; }
    # Fall back to a cargo-installed wasmtime under $HOME/.cargo/bin. getenv
    # ships in the stdlib now (reads /proc/self/environ + allocates) — call it
    # here at config time only, never post-fork (it is not async-signal-safe).
    var home = getenv("HOME");
    if (home != 0) {
        var suffix = "/.cargo/bin/wasmtime";
        var hlen = strlen(home);
        var slen = strlen(suffix);
        var path = alloc_checked(checked_sum4(hlen, slen, 1, 0));
        if (path != 0) {
            memcpy(path, home, hlen);
            memcpy(path + hlen, suffix, slen);
            store8(path + hlen + slen, 0);
            if (kavach_path_exists(path) == 1) { return path; }
        }
    }
    return 0;
}

fn backend_is_available(b) {
    if (b == KavachBackend.NOOP) { return 1; }
    if (b == KavachBackend.PROCESS) { return 1; }
    # 3.11.8: PROBE, like every sibling below. This was a hardcoded 0 while
    # `wasm_health` right next to it did the correct check — and because
    # `sandbox_create` refuses a backend that reports unavailable, the WASM path
    # was unreachable through the public API **even with wasmtime installed**.
    # A consumer could register the backend, configure it and never reach
    # `wasm_exec`. `_wasm_binary_path` moved here from `backend_wasm.cyr` so
    # this file can call it; Cyrius resolves single-pass, callees first.
    if (b == KavachBackend.WASM) {
        if (_wasm_binary_path() == 0) { return 0; }
        return 1;
    }
    if (b == KavachBackend.GVISOR) { return which_exists("runsc"); }
    if (b == KavachBackend.FIRECRACKER) { return which_exists("firecracker"); }
    if (b == KavachBackend.OCI) {
        if (which_exists("runc") == 1) { return 1; }
        if (which_exists("crun") == 1) { return 1; }
        return 0;
    }
    if (b == KavachBackend.SGX) { return kavach_path_exists("/dev/sgx_enclave"); }
    if (b == KavachBackend.SEV) { return kavach_path_exists("/dev/sev"); }
    if (b == KavachBackend.TDX) { return kavach_path_exists("/dev/tdx_guest"); }
    if (b == KavachBackend.SY_AGNOS) {
        if (which_exists("docker") == 1) { return 1; }
        if (which_exists("podman") == 1) { return 1; }
        return 0;
    }
    return 0;
}

# Iterate all 10 backends by index 0..KAVACH_BACKEND_COUNT.
fn backend_at(i) {
    return i;
}

# ---- shared exec-backend epilogue ----------------------------------------
# Every exec-capture backend (process / gvisor / oci / wasm / sgx / sev /
# tdx / sy-agnos / firecracker) builds its ExecResult the same way. These
# three helpers carry that shared shape so the logic — and its hardening —
# lives in exactly one place.

# Whether the most recent backend result is a KAVACH DIAGNOSTIC rather than
# captured payload output.
#
# It matters because `sandbox_exec` runs the externalization gate over the
# result's stdout+stderr, and the gate's contract is "scan what the payload
# is about to externalize". A backend error is not payload output — it is
# kavach explaining why there was no payload. Scanning it lets kavach's own
# secret scanner censor kavach's own error messages: `code_scan` rates a
# runtime diagnostic such as
#   runc run failed: ... exec: "/app/x": stat /app/x: no such file or directory
# a HIGH finding, the gate turns HIGH into QUARANTINE, and the user is told
# "externalization blocked: quarantined" instead of what actually went wrong.
# That is a category error, and it silently swallows exactly the message
# needed to diagnose the failure.
#
# Set by the two diagnostic constructors, cleared by the capture path, so the
# flag always describes the result the caller is holding.
#
# ⚠ Since 3.14.8 the result carries it (`ExecResult_diagnostic`), and that is what
# `sandbox_exec` reads. This flag is the process's most recent, which with two
# dispatches on two threads is either one's: agnosai filed the race. Kept for a
# caller on one thread.
var _backend_diag_only = 0;

#[must_use]
fn backend_result_is_diagnostic() { return _backend_diag_only; }

# Whether `r` is a diagnostic rather than captured output (3.14.8). 0 for a null
# result, which no gate is asked to scan.
#[must_use]
fn exec_result_is_diagnostic(r) {
    if (r == 0) { return 0; }
    return ExecResult_diagnostic(r);
}

# Clear the flag before a dispatch (3.12.9). Only the two diagnostic
# constructors set it and only `backend_capture_finish` cleared it, so a backend
# that builds its ExecResult any other way (noop does; a consumer's registered
# backend may) left the PREVIOUS exec's value in place: after one guard
# diagnostic, the next exec's real output skipped the gate, secrets and all.
fn backend_diagnostic_reset() { _backend_diag_only = 0; return 0; }

# ---- Attestation evidence (3.13.0) ----------------------------------------
# When the sandbox policy requires attestation, `sandbox_exec` sets a nonce
# before the dispatch. A backend that can attest has its guest put the nonce in
# the quote's report data and hands the quote back with `backend_attach_quote`.
# The backend does not judge its own evidence: `sandbox_exec` verifies the quote
# against the policy once the dispatch returns. A nonce length of 0 means the
# policy did not ask for attestation.
var _backend_nonce = 0;
var _backend_nonce_len = 0;
var _backend_quote = 0;
var _backend_quote_len = 0;

fn backend_attest_nonce() { return _backend_nonce; }
fn backend_attest_nonce_len() { return _backend_nonce_len; }
fn backend_quote() { return _backend_quote; }
fn backend_quote_len() { return _backend_quote_len; }

fn backend_attach_quote(buf, len) {
    _backend_quote = buf;
    _backend_quote_len = len;
    return 0;
}

# The nonce `sandbox_exec` set for `sandbox`'s exec in flight, and its length (0
# when the policy did not ask for attestation), and the quote a backend hands back
# for it (3.14.8). They live on the sandbox, so an exec on another thread neither
# sees this one's nonce nor clears it. Through 3.14.7 only the process-wide pair
# above existed, which every exec cleared before and after its dispatch, so an exec
# that did not attest cleared the nonce of one that did, mid-dispatch. The pair
# above is still set for an attesting exec, under a lock, for a backend written
# against it.
fn backend_sandbox_nonce(sandbox) {
    if (sandbox == 0) { return 0; }
    return Sandbox_attest_nonce(sandbox);
}

fn backend_sandbox_nonce_len(sandbox) {
    if (sandbox == 0) { return 0; }
    return Sandbox_attest_nonce_len(sandbox);
}

fn backend_sandbox_attach_quote(sandbox, buf, len) {
    if (sandbox == 0) { return 0 - 1; }
    Sandbox_set_quote(sandbox, buf);
    Sandbox_set_quote_len(sandbox, len);
    return 0;
}

# Set the nonce for the next dispatch and drop the last dispatch's quote, which
# must not stand in for this one's (the same reasoning as
# `backend_diagnostic_reset`).
fn backend_attest_reset(nonce, len) {
    _backend_nonce = nonce;
    _backend_nonce_len = len;
    _backend_quote = 0;
    _backend_quote_len = 0;
    return 0;
}

# Simple failure result: exit 1, no stdout, caller-supplied stderr, zero
# duration. Replaces the per-backend `_X_error` helpers.
fn backend_error_result(msg) {
    _backend_diag_only = 1;
    var r = exec_result_new();
    ExecResult_set_diagnostic(r, 1);
    ExecResult_set_exit_code(r, 1);
    ExecResult_set_stdout(r, "");
    ExecResult_set_stderr(r, msg);
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# Runtime-guard violation result: exit 126 with the first violation's
# description. Call only when vec_len(violations) > 0.
fn backend_guard_result(violations) {
    _backend_diag_only = 1;
    var r = exec_result_new();
    ExecResult_set_diagnostic(r, 1);
    ExecResult_set_exit_code(r, 126);
    var v0 = vec_get(violations, 0);
    ExecResult_set_stderr(r, GuardViolation_description(v0));
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# A capture's buffer of `cap` bytes, for `backend_capture_finish` to copy from and
# give back (3.14.7). An anonymous mapping, so it costs the pages the payload writes
# into, and it goes back to the kernel after the copy. 0 when none could be had, which
# every capture reads as a failed one.
#
# Through 3.14.6 each exec took `alloc(cap)`, 1 MiB, from a heap with no free, and the
# result's stdout WAS that buffer, so it lived as long as the result and could never
# be given back. agnosai measured 1,051,136 B of `alloc_used()` per `/bin/true` on the
# process backend, and RSS from 9.5 MB to 421 MB over 400 execs: a payload printing
# nothing cost what one printing 1 MiB cost.
#
# agnos has no mmap (`mmap_anon` answers 0 there), so it keeps `alloc`, and its
# backend gets the copy without the release.
fn backend_capture_buf(cap) {
    if (cap <= 1) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    return alloc(cap);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return mmap_anon(cap);
    #endif
}

# Give back a `backend_capture_buf` buffer, after `backend_capture_finish` or
# `backend_run_finish` has copied it. ⛔ Only one of those: this unmaps.
fn backend_capture_release(buf, cap) {
    if (buf == 0) { return 0; }
    #ifndef CYRIUS_TARGET_AGNOS
    cyr_munmap(buf, cap);
    #endif
    return 0;
}

# Build the success/failure ExecResult from a captured-output buffer.
#
# 3.14.7: the result's stdout is a copy of the `n` bytes captured, so the caller can
# give `out_buf` back (`backend_capture_release`) and a result costs what the payload
# wrote. It is not released here, because a caller may pass a buffer of its own.
# `out_buf == 0` is a capture that had no buffer, and reads as failed.
#
# SAFETY (M1, 3.3.1): `exec_capture` fills until `total >= buflen` and can
# return exactly `out_cap`. Writing `store8(out_buf + n, 0)` with n == out_cap
# is one byte past `alloc(out_cap)` — a heap overflow on attacker-influenced
# subprocess output. Clamping n into [0, out_cap - 1] before the NUL makes the
# terminator always land inside the allocation. At the exact-fill boundary this
# drops the final byte of an already-truncated 1 MiB capture — acceptable; the
# alternative (reading past the buffer) is not. Centralizing here fixes the
# off-by-one for all nine capture backends at once.
fn backend_capture_finish(out_buf, n, out_cap, fail_msg, start_ns, end_ns) {
    # This IS captured payload output, so the gate must see it.
    _backend_diag_only = 0;
    var r = exec_result_new();
    if (n < 0 || out_buf == 0) {
        ExecResult_set_exit_code(r, 1);
        ExecResult_set_stdout(r, "");
        ExecResult_set_stderr(r, fail_msg);
    }
    else {
        if (n >= out_cap) { n = out_cap - 1; }
        var out = alloc(n + 1);
        memcpy(out, out_buf, n);
        store8(out + n, 0);
        ExecResult_set_exit_code(r, 0);
        # With its length (3.14.9): a payload's output may carry a NUL, and `strlen`
        # stops there, in the gate's scan and size cap as in any other reader.
        exec_result_set_stdout_n(r, out, n);
        ExecResult_set_stderr(r, "");
    }
    ExecResult_set_duration_ms(r, (end_ns - start_ns) / 1000000);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# Set `r`'s stderr to a copy of the last capture's, with its length.
#
# `confine_last_stderr()` is one static buffer that the next capture overwrites.
# Through 3.13.1 the process and WASM backends stored that pointer in their
# results, so every result shared one stderr and an earlier result's changed to
# a later exec's (measured: after a second `sandbox_exec`, the first result's
# stderr read the second's error, through the same pointer).
#
# ⚠ The process's last capture, for a caller with one thread. Since 3.14.8
# kavach's backends use `backend_set_capture_stderr_of` with the capture they ran.
fn backend_set_capture_stderr(r) {
    var n = confine_last_stderr_len();
    var p = alloc(n + 1);
    memcpy(p, confine_last_stderr(), n);
    store8(p + n, 0);
    exec_result_set_stderr_n(r, p, n);
    return r;
}

# Set `r`'s stderr to a copy of capture `c`'s (3.14.8), which no other capture
# writes.
fn backend_set_capture_stderr_of(r, c) {
    var n = ConfineCapture_err_len(c);
    var e = ConfineCapture_err(c);
    if (e == 0) { n = 0; }
    var p = alloc(n + 1);
    if (n > 0) { memcpy(p, e, n); }
    store8(p + n, 0);
    exec_result_set_stderr_n(r, p, n);
    return r;
}

# The ExecResult for capture `c` once it has run (3.14.8): `backend_capture_finish`'s
# over its buffer, then its exit status, its deadline flag and a copy of its stderr,
# all read from `c`. A capture that failed (`total < 0`) keeps
# `backend_capture_finish`'s (1, `fail_msg`). Releases `c`'s stderr buffer and not
# its stdout one, which is the caller's.
fn backend_capture_result(c, fail_msg, start_ns, end_ns) {
    var n = ConfineCapture_total(c);
    var r = backend_capture_finish(ConfineCapture_buf(c), n, ConfineCapture_buflen(c), fail_msg,
      start_ns, end_ns);
    if (r != 0 && n >= 0) {
        ExecResult_set_exit_code(r, ConfineCapture_exit(c));
        ExecResult_set_timed_out(r, ConfineCapture_timed_out(c));
        backend_set_capture_stderr_of(r, c);
    }
    confine_capture_release(c);
    return r;
}

# Run a backend's runtime (runsc, runc or crun, docker or podman) the way the
# process backend runs a payload (3.13.2): its stdout into `out_buf`, its own
# stderr, exit status and the config's deadline, with the payload's stdin as the
# runtime's (`_config_payload_stdin`). Returns the byte count, or -1; the rest
# of the run is `confine_last_*`, which `backend_run_finish` reads.
#
# The runtime runs unconfined, as it did: it is the boundary, not the payload,
# and its environment is empty. Through 3.13.1 gVisor and SY-agnos ran through
# `kv_exec_capture`, which sends stderr to /dev/null, reports no exit status
# and has no deadline kavach sets, and hands the runtime kavach's own stdin.
fn backend_run_capture(args, cfg, out_buf, out_cap) {
    var c = backend_run_start(args, cfg, out_buf, out_cap);
    var n = ConfineCapture_total(c);
    confine_capture_release(c);
    return n;
}

# The same run, handing back its capture (3.14.8), for `backend_capture_result`:
# the run's outcome is then the capture's own, whatever runs on another thread.
fn backend_run_start(args, cfg, out_buf, out_cap) {
    var tmo = 0;
    if (cfg != 0) { tmo = SandboxConfig_timeout_ms(cfg); }
    var c = confine_capture_new(args, 0, 0, 0, 0, out_buf, out_cap, 0, tmo, 0,
      _config_payload_stdin(cfg), _config_payload_stdin_len(cfg), 0, 0);
    confine_capture_run(c);
    return c;
}

# The ExecResult for a `backend_run_capture` run: `backend_capture_finish`'s,
# with the runtime's exit status, its stderr and whether the deadline killed it.
# A failed capture (`n < 0`) keeps `backend_capture_finish`'s (1, `fail_msg`).
fn backend_run_finish(out_buf, n, out_cap, fail_msg, start_ns, end_ns) {
    var r = backend_capture_finish(out_buf, n, out_cap, fail_msg, start_ns, end_ns);
    if (r != 0 && n >= 0) {
        ExecResult_set_exit_code(r, confine_last_exit());
        ExecResult_set_timed_out(r, confine_last_timed_out());
        backend_set_capture_stderr(r);
    }
    return r;
}

# --- policy.cyr ---

# kavach — SandboxPolicy
# Ported from rust-old/src/policy/mod.rs
#
# No floats in Cyrius core — cpu_limit stored as tenths (10 = 1.0 core).

#derive(accessors)
struct SandboxPolicy {
    seccomp_enabled;
    seccomp_profile;
    landlock_rules_len;
    network_enabled;
    network_tcp_bind_len;
    network_tcp_connect_len;
    read_only_rootfs;
    memory_limit_mb;
    cpu_limit_tenths;
    max_pids;
    landlock_abstract_unix;
    landlock_signal;
    landlock_rules;
    attest_measurements;
    attest_root;
    attest_root_len;
    attest_allow_debug;
    attest_rtmrs;
    attest_collateral;
    attest_tcb_accept;
    network_tcp_bind;
    network_tcp_connect;
}

# 104 (3.11.3): `landlock_rules` is appended, so no existing field offset moves
# and a consumer holding a policy built by an older release keeps working.
# 136 (3.13.0): the four attestation fields are appended the same way.
# 160 (3.14.2): the TDX RTMR allowlists, the collateral and the accepted TCB
# statuses, appended the same way.
# 176 (3.14.8): the TCP ports a payload with no network may still bind and
# connect to, behind the two counts that had no list until now.
var SANDBOX_POLICY_SIZE = 176;

fn policy_new() {
    var p = alloc(SANDBOX_POLICY_SIZE);
    var i = 0;
    while (i < SANDBOX_POLICY_SIZE) {
        store64(p + i, 0);
        i = i + 8;
    }
    return p;
}

fn policy_minimal() {
    return policy_new();
}

fn policy_basic() {
    var p = policy_new();
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, "basic");
    return p;
}

fn policy_strict() {
    var p = policy_new();
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, "strict");
    SandboxPolicy_set_read_only_rootfs(p, 1);
    SandboxPolicy_set_memory_limit_mb(p, 512);
    SandboxPolicy_set_cpu_limit_tenths(p, 10);
    SandboxPolicy_set_max_pids(p, 64);
    SandboxPolicy_set_landlock_abstract_unix(p, 1);
    SandboxPolicy_set_landlock_signal(p, 1);
    return p;
}

# Allow the payload access to `path`, and to everything beneath it.
#
# A `path` that is a file, not a directory, allows that file alone, with the
# rights a file can hold: read and execute for `FS_READ_ONLY`, and write and
# truncate as well for `FS_READ_WRITE`. Creating, removing or renaming it takes
# a rule on its directory. Through 3.13.0 a rule naming a file failed every
# exec closed (exit 124): it was given directory rights, which landlock refuses
# on a file.
#
# **Before 3.11.3 there was no way to say this.** `landlock_rules_len` was a
# bare counter with no list behind it, and `confine_child` called
# `security_apply_landlock(0, 0)` — so a consumer could not express a rule, both
# shipped presets carried a count of 0, and landlock was applied by nothing.
# The machinery underneath was complete: `security_apply_landlock` walks a vec
# of `security_fs_rule` and has since 3.11.1 handled all thirteen ABI v1 rights.
# Only the path from a policy to that vec was missing.
#
# `access` is `FS_READ_ONLY` or `FS_READ_WRITE`. The counter is kept in step
# with the list so `score_backend`, which reads the count, keeps describing
# what is actually configured.
#
# **Landlock is allow-list only.** A policy with one rule permits that subtree
# and denies every other path; a policy with no rules gets no landlock ruleset
# at all, which is not the same thing — see `policy_landlock_deny_all`.
#
# Refused (-1) on a deny-all policy, which stays deny-all: the rule would give
# back a path that policy has taken away. Through 3.13.0 the rule was added and
# the policy stopped being deny-all.
fn policy_landlock_add(p, path, access) {
    if (p == 0) { return 0 - 1; }
    if (policy_landlock_is_deny_all(p) == 1) { return 0 - 1; }
    var rules = SandboxPolicy_landlock_rules(p);
    if (rules == 0) {
        rules = vec_new();
        SandboxPolicy_set_landlock_rules(p, rules);
    }
    vec_push(rules, security_fs_rule_new(path, access));
    SandboxPolicy_set_landlock_rules_len(p, vec_len(rules));
    return 0;
}

# Deny the payload every filesystem path.
#
# The policy's ruleset names no path, so it permits nothing. Rules the policy
# named before are dropped, and `policy_landlock_add` refuses one afterwards, so
# the call means the same in either order, and the same as a deny-all side in
# `merge_policies`. Through 3.13.0 the rules were kept and the child applied
# them: a policy that named a path and was then made deny-all still permitted
# that path, and denied everything only once merged.
#
# ⚠ **Every path includes the payload's own executable.** Landlock goes on in
# the child before `execve`, and the exec opens the binary, so a deny-all
# payload never starts: the exec fails with EACCES and the child exits 127
# (measured through `sandbox_exec` and a persistent guest; `sandbox_spawn`
# execs the same way). Descriptors the child already holds stay usable, which
# helps only code that goes on in the child without an exec. A payload that has
# to start needs `policy_landlock_add` instead, naming its binary and, if it is
# dynamically linked, its loader and libraries; every other path is then denied
# already.
#
# Written as an empty list and a count of one. The count is what makes the
# child install a ruleset, and a count above the list is how every reader
# recognises deny-all (`policy_landlock_is_deny_all`). Distinct from naming no
# rule at all, which installs no ruleset and restricts nothing.
fn policy_landlock_deny_all(p) {
    if (p == 0) { return 0 - 1; }
    # A fresh list rather than the old one emptied: a caller holding the old
    # list, or another policy sharing it, keeps its rules.
    SandboxPolicy_set_landlock_rules(p, vec_new());
    SandboxPolicy_set_landlock_rules_len(p, 1);
    return 0;
}

# The rule list a policy carries, or 0 when it names none.
fn policy_landlock_rules(p) {
    if (p == 0) { return 0; }
    return SandboxPolicy_landlock_rules(p);
}

# Whether `p` denies the payload every path: its count asks for more rules than
# its list holds. `policy_landlock_deny_all` writes an empty list and a count of
# one; a count with no list reads the same, and so does any count set above the
# list through the raw accessor. The child's landlock step
# (`_spawn_apply_landlock`), `merge_policies` and `policy_landlock_add` all ask
# this, so a policy means the same thing wherever it is used.
fn policy_landlock_is_deny_all(p) {
    if (p == 0) { return 0; }
    var rules = SandboxPolicy_landlock_rules(p);
    var have = 0;
    if (rules != 0) { have = vec_len(rules); }
    if (SandboxPolicy_landlock_rules_len(p) > have) { return 1; }
    return 0;
}

# What `policy_network_allow_tcp` allows: binding a TCP port, connecting to one,
# or both (3.14.8). Landlock's own bits (LANDLOCK_ACCESS_NET_*).
var KAVACH_TCP_BIND = 1;
var KAVACH_TCP_CONNECT = 2;

# Let a payload whose policy denies network (`network_enabled = 0`) still bind
# TCP `port`, connect to it, or both (`access`, KAVACH_TCP_BIND | KAVACH_TCP_CONNECT),
# as `policy_landlock_add` lets it reach a path. For "only 443": connect, 443.
# Returns 0, or -1 for a port outside 0..65535 or no access. A port named twice
# is kept once.
#
# Applied by landlock (ABI v4, Linux 6.7) on the process path, as a NET_PORT rule
# of the payload's domain: every other TCP bind and connect reads EACCES. That
# needs no namespace, so a policy naming a port makes the path create no network
# namespace for it, which would leave nothing to connect to. Below ABI v4 the
# payload has no landlock network rights and keeps the network.
#
# ⚠ TCP only. A payload with no network has its UDP, raw and other sockets refused
# by the exec filter when the policy enables seccomp, so a name to resolve needs a
# resolver over TCP, port 53, or an address. On the OCI and gVisor backends a
# policy denying network gets an empty network namespace, where no port is
# reachable: the list is stricter there, not looser. With `network_enabled = 1`
# the list is kept and has no effect.
#
# Through 3.14.7 a policy carried `network_tcp_bind_len` and
# `network_tcp_connect_len`, counts with no list and no setter; the counts now
# follow the lists, as `landlock_rules_len` follows its rules.
fn policy_network_allow_tcp(p, port, access) {
    if (p == 0) { return 0 - 1; }
    if (port < 0 || port > 65535) { return 0 - 1; }
    if ((access & (KAVACH_TCP_BIND | KAVACH_TCP_CONNECT)) == 0) { return 0 - 1; }
    if ((access & KAVACH_TCP_BIND) != 0) {
        var b = SandboxPolicy_network_tcp_bind(p);
        if (b == 0) {
            b = vec_new();
            SandboxPolicy_set_network_tcp_bind(p, b);
        }
        if (_policy_port_in(b, port) == 0) { vec_push(b, port); }
        SandboxPolicy_set_network_tcp_bind_len(p, vec_len(b));
    }
    if ((access & KAVACH_TCP_CONNECT) != 0) {
        var c = SandboxPolicy_network_tcp_connect(p);
        if (c == 0) {
            c = vec_new();
            SandboxPolicy_set_network_tcp_connect(p, c);
        }
        if (_policy_port_in(c, port) == 0) { vec_push(c, port); }
        SandboxPolicy_set_network_tcp_connect_len(p, vec_len(c));
    }
    return 0;
}

# 1 when `port` is in `ports`, a vec of ports or 0.
fn _policy_port_in(ports, port) {
    if (ports == 0) { return 0; }
    var i = 0;
    while (i < vec_len(ports)) {
        if (vec_get(ports, i) == port) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when `p` names a TCP port a payload with no network may still use.
fn policy_network_tcp_rules(p) {
    if (p == 0) { return 0; }
    var b = SandboxPolicy_network_tcp_bind(p);
    var c = SandboxPolicy_network_tcp_connect(p);
    if (b != 0 && vec_len(b) > 0) { return 1; }
    if (c != 0 && vec_len(c) > 0) { return 1; }
    return 0;
}

# Whether this policy asks for any child-side confinement.
#
# The routing predicate for `process_exec`: a policy answering 1 must not reach
# a plain `exec_capture`, because that path has no seam between `fork` and
# `execve` in which to install a filter. Answering on the policy rather than on
# the rootfs is the whole of the 3.11.3 fix. A landlock scope asks for a ruleset
# as a rule does (3.13.2), and so does a TCP port rule (3.14.8).
#
# ⚠ `network_enabled = 0` alone does not (3.14.8). It is `policy_new()`'s default,
# and the policy asking for nothing else runs unconfined, as it always has. Where
# the payload is confined, for any other reason, the network is denied by
# landlock and the exec filter (`_spawn_apply_landlock`).
fn policy_wants_confinement(p) {
    if (p == 0) { return 0; }
    if (SandboxPolicy_seccomp_enabled(p) == 1) { return 1; }
    if (SandboxPolicy_landlock_rules_len(p) > 0) { return 1; }
    if (SandboxPolicy_landlock_abstract_unix(p) == 1) { return 1; }
    if (SandboxPolicy_landlock_signal(p) == 1) { return 1; }
    # 3.14.8: a TCP port rule is a landlock rule, so it takes the seam too.
    if (SandboxPolicy_network_enabled(p) == 0 && policy_network_tcp_rules(p) == 1) { return 1; }
    return 0;
}

# Allow a TEE guest whose measurement is `hex`: its MRENCLAVE (64 hex digits)
# for SGX, its MRTD (96) for TDX. Upper-case digits are folded to lower case.
# Returns 0, or -1 for anything that is not 64 or 96 hex digits.
#
# One entry makes the policy require attestation. `sandbox_exec` then runs the
# command only on a backend that can attest (SGX, TDX), and releases its output
# only if the guest's quote verifies to the policy's root, carries the exec's
# nonce and names an allowed measurement (`kavach_attest_quote`). Every other
# path that runs a payload under a policy refuses one that requires attestation:
# a local process has no quote to check.
fn policy_attest_allow(p, hex) {
    if (p == 0 || hex == 0) { return 0 - 1; }
    var n = strlen(hex);
    if (n != 64 && n != 96) { return 0 - 1; }
    var m = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var c = load8(hex + i);
        if (c >= 65 && c <= 70) { c = c + 32; }
        # Digits compared inline: `is_digit_c` lives in scanning_secrets.cyr,
        # which the `[lib.confine]` bundle does not carry.
        if ((c < 48 || c > 57) && (c < 97 || c > 102)) { return 0 - 1; }
        store8(m + i, c);
        i = i + 1;
    }
    store8(m + n, 0);
    var list = SandboxPolicy_attest_measurements(p);
    if (list == 0) {
        list = vec_new();
        SandboxPolicy_set_attest_measurements(p, list);
    }
    vec_push(list, m);
    return 0;
}

# The root a guest's quote must chain to, as DER: Intel's SGX root CA, which TDX
# quotes also chain to. The bytes are copied. kavach ships no root, so a policy
# that allows measurements and names no root fails every attestation.
fn policy_attest_root(p, der, len) {
    if (p == 0 || der == 0 || len <= 0) { return 0 - 1; }
    var copy = alloc(len);
    memcpy(copy, der, len);
    SandboxPolicy_set_attest_root(p, copy);
    SandboxPolicy_set_attest_root_len(p, len);
    return 0;
}

# Accept a debug enclave or debug TD. The host can read and write a debug
# guest's memory, so its measurement does not establish what ran; a debug guest
# that passes every other check is reported at `KAVACH_TRUST_WARNING`, not
# `KAVACH_TRUST_AFFIRMING`. Off by default.
fn policy_attest_allow_debug(p, on) {
    if (p == 0) { return 0 - 1; }
    SandboxPolicy_set_attest_allow_debug(p, on);
    return 0;
}

# Allow `hex` (96 hex digits) as the value of TDX runtime measurement register
# `index` (0 to 3). Upper-case digits are folded. Returns 0, or -1.
#
# MRTD measures only the TD's initial memory, its firmware (TDVF). TDVF extends
# what it loads into the RTMRs: RTMR0 the TD's configuration (the TD HOB, the
# ACPI tables, the boot variables), RTMR1 the OS loader and kernel, RTMR2 the
# kernel command line and initrd, and RTMR3 is left to the guest (Intel TDX
# Virtual Firmware Design Guide §11). Since 3.14.2 a TDX quote passes only when
# the policy pins RTMR0, RTMR1 and RTMR2 and each is on its list, so the kernel
# and command line are checked as well as the firmware. RTMR3 is checked when
# pinned. A nonce on the kernel command line would change RTMR2 on every exec.
fn policy_attest_rtmr(p, index, hex) {
    if (p == 0 || hex == 0 || index < 0 || index > 3) { return 0 - 1; }
    if (strlen(hex) != 96) { return 0 - 1; }
    var m = alloc(97);
    var i = 0;
    while (i < 96) {
        var c = load8(hex + i);
        if (c >= 65 && c <= 70) { c = c + 32; }
        if ((c < 48 || c > 57) && (c < 97 || c > 102)) { return 0 - 1; }
        store8(m + i, c);
        i = i + 1;
    }
    store8(m + 96, 0);
    var lists = SandboxPolicy_attest_rtmrs(p);
    if (lists == 0) {
        lists = alloc(32);
        memset(lists, 0, 32);
        SandboxPolicy_set_attest_rtmrs(p, lists);
    }
    var list = load64(lists + index * 8);
    if (list == 0) {
        list = vec_new();
        store64(lists + index * 8, list);
    }
    vec_push(list, m);
    return 0;
}

# The allowlist for RTMR `index`, or 0 when the policy pins none.
fn policy_attest_rtmr_list(p, index) {
    if (p == 0 || index < 0 || index > 3) { return 0; }
    var lists = SandboxPolicy_attest_rtmrs(p);
    if (lists == 0) { return 0; }
    var list = load64(lists + index * 8);
    if (list == 0) { return 0; }
    if (vec_len(list) == 0) { return 0; }
    return list;
}

# The collateral a quote's platform is checked against (`kavach_collateral_new`
# and its setters, in src/attest_collateral.cyr): Intel's TCB info, QE identity,
# their signing chain, the PCK CRL and the root CRL. Since 3.14.2 a quote passes
# only with all five: without them a genuine platform whose TCB is out of date,
# or whose PCK key is revoked, passes. The collateral is held, not copied.
fn policy_attest_collateral(p, c) {
    if (p == 0 || c == 0) { return 0 - 1; }
    SandboxPolicy_set_attest_collateral(p, c);
    return 0;
}

# The TCB statuses (KAVACH_TCB_* bits) a passing quote may have, besides
# UpToDate, which is always accepted. 0, the default, accepts UpToDate only.
# KAVACH_TCB_REVOKED is never accepted, whatever the mask says.
fn policy_attest_accept_tcb(p, mask) {
    if (p == 0 || mask < 0) { return 0 - 1; }
    SandboxPolicy_set_attest_tcb_accept(p, mask);
    return 0;
}

# Whether this policy requires attestation: it allows at least one measurement.
fn policy_wants_attestation(p) {
    if (p == 0) { return 0; }
    var list = SandboxPolicy_attest_measurements(p);
    if (list == 0) { return 0; }
    if (vec_len(list) > 0) { return 1; }
    return 0;
}

# Case-insensitive preset lookup. Returns 0 on unknown name.
fn policy_from_preset(name) {
    if (strieq(name, "minimal") == 1) { return policy_minimal(); }
    if (strieq(name, "basic") == 1) { return policy_basic(); }
    if (strieq(name, "strict") == 1) { return policy_strict(); }
    return 0;
}

# --- scoring.cyr ---

# kavach — strength scoring (0-100)
# Ported from rust-old/src/scoring/mod.rs

fn base_score(backend) {
    if (backend == KavachBackend.NOOP) { return 0; }
    if (backend == KavachBackend.PROCESS) { return 50; }
    if (backend == KavachBackend.OCI) { return 55; }
    if (backend == KavachBackend.WASM) { return 65; }
    if (backend == KavachBackend.GVISOR) { return 70; }
    if (backend == KavachBackend.SGX) { return 80; }
    if (backend == KavachBackend.SEV) { return 82; }
    if (backend == KavachBackend.TDX) { return 85; }
    if (backend == KavachBackend.SY_AGNOS) { return 80; }
    if (backend == KavachBackend.FIRECRACKER) { return 90; }
    return 0;
}

fn score_label(score) {
    if (score < 30) { return "minimal"; }
    if (score < 50) { return "basic"; }
    if (score < 70) { return "standard"; }
    if (score < 85) { return "hardened"; }
    if (score <= 100) { return "fortress"; }
    return "unknown";
}

# Score a backend with policy modifiers applied. Matches SY reference, less what a
# backend does not apply.
#
# 3.14.7: a modifier counts only where the backend applies it with no config to say
# more, which is all this function is given. Through 3.14.6:
#
#   - The process backend took 5 for `network_enabled = 0` and 3 for
#     `read_only_rootfs`. With no rootfs it gives a payload neither: it runs in
#     kavach's network namespace unless `config_require_namespaces` is set, and
#     on the host's root. `score_config` adds them back where the config makes
#     the path apply them, and `score_spawn` scores `sandbox_spawn`.
#   - gVisor took 5 for `seccomp_enabled`. Its spec carries no filter, because
#     runsc applies one only under `--oci-seccomp` and has no case for the
#     action the OCI backend's filter uses (read in runsc's source, not run:
#     docs/development/issues/archived/2026-11-06-gvisor-policy-seccomp-is-not-applied.md).
#     The sentry stands between its payload and the host either way.
fn score_backend(backend, policy) {
    var score = base_score(backend);

    if (SandboxPolicy_seccomp_enabled(policy) == 1) {
        if (backend != KavachBackend.GVISOR) { score = score + 5; }
    }
    if (SandboxPolicy_landlock_rules_len(policy) > 0) { score = score + 3; }
    if (backend != KavachBackend.PROCESS) {
        if (SandboxPolicy_network_enabled(policy) == 0) { score = score + 5; }
        if (SandboxPolicy_read_only_rootfs(policy) == 1) { score = score + 3; }
    }

    # Resource limits: +2 once if either memory or cpu is set
    if (SandboxPolicy_memory_limit_mb(policy) > 0) { score = score + 2; }
    elif (SandboxPolicy_cpu_limit_tenths(policy) > 0) { score = score + 2; }

    # Landlock TCP ports (ABI v4) are not scored here (3.13.2). Through 3.13.1 the
    # bare counts added 3 for a restriction nothing applied. Since 3.14.8 a list
    # is applied on the process path, and `score_config` scores it there.

    # Landlock scoping (ABI v6), applied since 3.13.2 by `_spawn_apply_landlock`
    # where the kernel has ABI v6.
    if (SandboxPolicy_landlock_abstract_unix(policy) == 1) { score = score + 2; }
    if (SandboxPolicy_landlock_signal(policy) == 1) { score = score + 2; }

    if (score > 100) { score = 100; }
    if (score < 0) { score = 0; }
    return score;
}

# What the process path adds for `policy` past `score_backend`'s, when it creates
# the policy's namespaces (`ns`), enters a rootfs (`rootfs`) and confines the
# payload at all (`confined`).
#
# 3.14.8: a confined payload denied network has it denied with no namespace, by
# landlock's TCP rule and the network filter, where the kernel has landlock ABI v4
# (`_spawn_net_alone`), and that scores the 5 a network namespace does. A policy
# naming TCP ports gets no namespace and no 5, since it has a network, and 3 for
# the list where the list is applied: the score landlock's TCP ports had through
# 3.13.1, when nothing applied them.
fn _score_process_path(policy, rootfs, ns, confined) {
    var s = 0;
    if (SandboxPolicy_network_enabled(policy) == 0) {
        var ports = policy_network_tcp_rules(policy);
        var held = 0;
        if (confined == 1 && security_landlock_abi_version() >= 4) { held = 1; }
        if (ports == 0 && (ns == 1 || held == 1)) { s = s + 5; }
        if (ports == 1 && held == 1) { s = s + 3; }
    }
    if (rootfs != 0 && SandboxPolicy_read_only_rootfs(policy) == 1) { s = s + 3; }
    return s;
}

fn _score_clamp(s) {
    if (s > 100) { return 100; }
    if (s < 0) { return 0; }
    return s;
}

# The score of what `sandbox_exec` applies for `cfg`, 0-100 (3.14.7). It is
# `score_backend` for the config's backend and policy, and on the process backend
# it adds what the config makes that path apply: the network namespace with a
# rootfs or `config_require_namespaces`, or since 3.14.8 landlock and the network
# filter on any confined payload where the kernel has them, a TCP port list, and
# the read-only root with a rootfs.
#[must_use]
fn score_config(cfg) {
    if (cfg == 0) { return 0; }
    var b = SandboxConfig_backend(cfg);
    var p = SandboxConfig_policy(cfg);
    if (p == 0) { return base_score(b); }
    var s = score_backend(b, p);
    if (b == KavachBackend.PROCESS) {
        var rootfs = SandboxConfig_rootfs(cfg);
        var ns = 0;
        if (rootfs != 0 || SandboxConfig_require_ns(cfg) == 1) { ns = 1; }
        var confined = ns;
        if (policy_wants_confinement(p) == 1) { confined = 1; }
        s = s + _score_process_path(p, rootfs, ns, confined);
    }
    return _score_clamp(s);
}

# The score of what `sandbox_spawn` applies for `cfg`, 0-100 (3.14.7). A payload
# spawned from a sandbox whose backend has no spawn of its own runs on the process
# path and scores as one, where `score_backend` gave it the backend's 55 or 70. Its
# namespaces are always requested, and refused closed, so the network counts.
#
# 3.14.8: an OCI sandbox's spawn runs `runc run` (`oci_spawn`), where the OCI
# backend is registered, and scores as an OCI exec does. gVisor's still detaches on
# the process path.
#[must_use]
fn score_spawn(cfg) {
    if (cfg == 0) { return 0; }
    var b = SandboxConfig_backend(cfg);
    var p = SandboxConfig_policy(cfg);
    if (backend_spawn_fn(b) != 0) {
        if (p == 0) { return base_score(b); }
        return _score_clamp(score_backend(b, p));
    }
    if (p == 0) { return base_score(KavachBackend.PROCESS); }
    var s = score_backend(KavachBackend.PROCESS, p);
    s = s + _score_process_path(p, SandboxConfig_rootfs(cfg), 1, 1);
    return _score_clamp(s);
}

# Rank all available backends by score under `policy`. Returns strongest
# available backend code. Falls back to KavachBackend.NOOP if nothing else passes.
fn resolve_best_backend(policy) {
    var best = KavachBackend.NOOP;
    var best_score = 0 - 1;
    var i = 0;
    while (i < KAVACH_BACKEND_COUNT) {
        var b = backend_at(i);
        if (b != KavachBackend.NOOP) {
            if (backend_is_available(b) == 1) {
                var s = score_backend(b, policy);
                if (s > best_score) {
                    best_score = s;
                    best = b;
                }
            }
        }
        i = i + 1;
    }
    return best;
}

# Returns strongest backend meeting min_score, or -1 if none.
fn resolve_min_strength_backend(policy, min_score) {
    var best = 0 - 1;
    var best_score = min_score - 1;
    var i = 0;
    while (i < KAVACH_BACKEND_COUNT) {
        var b = backend_at(i);
        if (backend_is_available(b) == 1) {
            var s = score_backend(b, policy);
            if (s >= min_score) {
                if (s > best_score) {
                    best_score = s;
                    best = b;
                }
            }
        }
        i = i + 1;
    }
    return best;
}

# --- lifecycle.cyr ---

# kavach — sandbox lifecycle (state machine, config, exec result, Sandbox)
# Ported from rust-old/src/lifecycle/mod.rs
#
# Deferred vs Rust: async is synchronous here, UUID is a monotonic counter,
# timestamps are nanoseconds from CLOCK_MONOTONIC (0 = unset), SecretRef/
# ExternalizationPolicy/RuntimeManifest plumbing omitted until those modules land.

# ---- SandboxState ---------------------------------------------------------

enum SandboxState {
    CREATED = 0;
    RUNNING = 1;
    PAUSED = 2;
    STOPPED = 3;
    DESTROYED = 4;
}

fn state_name(s) {
    if (s == SandboxState.CREATED) { return "created"; }
    if (s == SandboxState.RUNNING) { return "running"; }
    if (s == SandboxState.PAUSED) { return "paused"; }
    if (s == SandboxState.STOPPED) { return "stopped"; }
    if (s == SandboxState.DESTROYED) { return "destroyed"; }
    return "unknown";
}

# Valid FSM edges, mirroring the Rust matches!(...) table:
#   Created  -> Running
#   Running  -> Paused | Stopped | Destroyed
#   Paused   -> Running | Stopped | Destroyed
#   Stopped  -> Destroyed
fn valid_transition(from, to) {
    if (from == SandboxState.CREATED) {
        if (to == SandboxState.RUNNING) { return 1; }
        return 0;
    }
    if (from == SandboxState.RUNNING) {
        if (to == SandboxState.PAUSED) { return 1; }
        if (to == SandboxState.STOPPED) { return 1; }
        if (to == SandboxState.DESTROYED) { return 1; }
        return 0;
    }
    if (from == SandboxState.PAUSED) {
        if (to == SandboxState.RUNNING) { return 1; }
        if (to == SandboxState.STOPPED) { return 1; }
        if (to == SandboxState.DESTROYED) { return 1; }
        return 0;
    }
    if (from == SandboxState.STOPPED) {
        if (to == SandboxState.DESTROYED) { return 1; }
        return 0;
    }
    return 0;
}

# ---- ExecResult -----------------------------------------------------------

# `stdout_len` / `stderr_len` (3.11.7): the artifact's TRUE byte length, or -1
# when the caller did not supply one and `strlen` is the right answer.
#
# They exist because the externalization gate measured every artifact with
# `strlen`, which is not a length — it is a distance to the first NUL. A payload
# whose stdout contained an embedded NUL was scanned only up to it, so a
# credential sitting after one was **released as PASS**. Appended after
# `timed_out` so no existing field offset moves.
#
# `diagnostic` (3.14.8): 1 when the result is kavach's own explanation of why no
# payload ran (`backend_error_result`, `backend_guard_result`), not captured
# output, so `sandbox_exec` passes it by the gates. Through 3.14.7 that was one
# process-wide flag, `backend_result_is_diagnostic()`, set by the result's
# constructor and read after the dispatch, so with two dispatches at once one
# could skip the gate on the other's say. A result built any other way reads 0,
# which is the gated answer.
#
# NB: keep field comments OUT of this struct body — `#derive(accessors)` reads
# each line as a field.
#derive(accessors)
struct ExecResult {
    exit_code;
    stdout;
    stderr;
    duration_ms;
    timed_out;
    stdout_len;
    stderr_len;
    diagnostic;
}

var EXEC_RESULT_SIZE = 64;

fn exec_result_new() {
    var r = alloc(EXEC_RESULT_SIZE);
    var i = 0;
    while (i < EXEC_RESULT_SIZE) { store64(r + i, 0); i = i + 8; }
    ExecResult_set_stdout(r, "");
    ExecResult_set_stderr(r, "");
    # -1, not 0, so "unset" and "genuinely empty" stay distinguishable — a 0
    # sentinel would make every default-constructed result claim its stdout is
    # zero bytes and silence the gate entirely.
    ExecResult_set_stdout_len(r, 0 - 1);
    ExecResult_set_stderr_len(r, 0 - 1);
    return r;
}

# Set stdout together with its true length — the length-carrying setter.
#
# Use this whenever the artifact may contain a NUL. The bare
# `ExecResult_set_stdout` leaves the stored length untouched, which is correct
# for a cstring and **stale** if a length was set earlier for a different
# buffer, so do not mix the two on one result.
fn exec_result_set_stdout_n(r, p, n) {
    ExecResult_set_stdout(r, p);
    ExecResult_set_stdout_len(r, n);
    return r;
}

fn exec_result_set_stderr_n(r, p, n) {
    ExecResult_set_stderr(r, p);
    ExecResult_set_stderr_len(r, n);
    return r;
}

# The artifact's length: the supplied one when there is one, else `strlen`.
#
# Every reader of an `ExecResult` artifact goes through these two rather than
# calling `strlen` directly, so a caller that supplied a length gets it honoured
# everywhere and one that did not keeps the pre-3.11.7 behaviour exactly.
#[must_use]
fn exec_result_stdout_len(r) {
    var n = ExecResult_stdout_len(r);
    if (n >= 0) { return n; }
    return strlen(ExecResult_stdout(r));
}

#[must_use]
fn exec_result_stderr_len(r) {
    var n = ExecResult_stderr_len(r);
    if (n >= 0) { return n; }
    return strlen(ExecResult_stderr(r));
}

# ---- SandboxConfig --------------------------------------------------------

# `rootfs` (3.9.1): the filesystem the payload runs INSIDE, or 0 to run on the
# host filesystem — which is what every release before 3.9.1 did unconditionally,
# so a container runtime consuming this API had no way to say "run in this
# rootfs" and its containers silently executed host binaries. Appended at offset
# 64 so no existing field offset moves.
#
# NB: keep field comments OUT of this struct body — `#derive(accessors)` reads
# each line as a field, so a continuation comment becomes a field named `#` and
# generates `SandboxConfig_set_#`.
#derive(accessors)
struct SandboxConfig {
    backend;
    policy;
    timeout_ms;
    inner_backend;
    agent_id;
    hostname;
    domainname;
    workdir;
    rootfs;
    externalization;
    require_ns;
    stdin;
    stdin_len;
    fuel;
    env;
    stdin_inherit;
    wasm_max_instances;
    wasm_max_tables;
    wasm_max_table_elements;
    wasm_max_memories;
    wasm_grow_returns_failure;
    capabilities;
}

# 176: `capabilities` appended (3.14.5), so no existing field offset moves; the same
# discipline the five `wasm_*` fields followed at 168 (3.14.4), `stdin_inherit` at
# 128, `env` at 120, `fuel` at 112, `stdin`/`stdin_len` at 104 and `require_ns` at 88.
var SANDBOX_CONFIG_SIZE = 176;

# Defaults match Rust's SandboxConfig::default():
#   backend=Process, policy=basic(), timeout_ms=30000, inner_backend=-1 (none)
fn config_new() {
    var c = alloc(SANDBOX_CONFIG_SIZE);
    var i = 0;
    while (i < SANDBOX_CONFIG_SIZE) { store64(c + i, 0); i = i + 8; }
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy_basic());
    SandboxConfig_set_timeout_ms(c, 30000);
    SandboxConfig_set_inner_backend(c, 0 - 1);
    return c;
}

# Fluent-ish setters: mutate in place and return the config pointer so
# callers may chain if they wish.
fn config_backend(c, b)        { SandboxConfig_set_backend(c, b); return c; }
fn config_policy(c, p)         { SandboxConfig_set_policy(c, p); return c; }

# The payload's wall-clock deadline, in ms: 30000 from `config_new`, 0 for
# none. At the deadline the payload is killed and the result reports
# `timed_out`. Enforced by the process backend (since 3.11.4), the WASM backend,
# and the gVisor, OCI and SY-agnos backends on their runtime's run (since
# 3.13.2). The SGX, SEV, TDX and Firecracker launchers do not take it yet.
fn config_timeout_ms(c, ms)    { SandboxConfig_set_timeout_ms(c, ms); return c; }

# Bytes to hand the payload on stdin (3.11.8). With none (`ptr = 0`, the
# default), the payload gets an empty stdin, an immediate EOF, unless the
# config opts in to kavach's own with `config_stdin_inherit`. A non-zero `ptr`
# with `len = 0` is an empty stdin too.
#
# ⚠ **Through 3.13.1 an unset stdin inherited kavach's own**, so a payload could
# read, and consume, whatever the host process had there. 3.11.8 kept that
# default for interactive payloads; they now say so with
# `config_stdin_inherit`.
#
# Honoured by the process backend (since 3.13.1), the WASM backend (since
# 3.11.8), and the gVisor, OCI and SY-agnos backends (since 3.13.2). ⚠ Through
# 3.13.0 the process backend passed it to neither of its captures, so a payload
# read kavach's own stdin in its place. The SGX, SEV, TDX and Firecracker
# launchers, which shell out through `kv_exec_capture`, do not take it yet; a
# persistent guest has its own channel, `persistent_send`.
#
# ⚠ The buffer is NOT copied — it must outlive the `sandbox_exec` that consumes
# it. Its size is not capped: it goes out as the payload reads it, while its
# output is drained and under the config's deadline (3.14.4; through 3.14.3 an
# input past the pipe's 64 KiB could hang the caller for good).
fn config_stdin(c, ptr, len)   {
    SandboxConfig_set_stdin(c, ptr);
    SandboxConfig_set_stdin_len(c, len);
    return c;
}

# Hand the payload kavach's own stdin when the config names no bytes (`on` 1),
# the default through 3.13.1. For a payload that has to read the terminal
# kavach runs in; anything on kavach's stdin reaches the payload, which can
# also consume it. Bytes set with `config_stdin` take precedence.
fn config_stdin_inherit(c, on) { SandboxConfig_set_stdin_inherit(c, on); return c; }

# The stdin a backend hands the payload, as a capture's `input`: the config's
# bytes; with none, 0 (inherit kavach's) if the config opts in, and otherwise ""
# (an empty stdin). Its length is `_config_payload_stdin_len`.
fn _config_payload_stdin(c) {
    if (c == 0) { return ""; }
    var p = SandboxConfig_stdin(c);
    if (p != 0) { return p; }
    if (SandboxConfig_stdin_inherit(c) == 1) { return 0; }
    return "";
}

fn _config_payload_stdin_len(c) {
    if (c == 0) { return 0; }
    if (SandboxConfig_stdin(c) == 0) { return 0; }
    return SandboxConfig_stdin_len(c);
}

# An explicit WASM instruction budget, in wasmtime `--fuel` units.
#
# ⚠ **0 means "derive from `timeout_ms`", which is what every caller got before
# this existed** — `_wasm_fuel_from_timeout` returns `timeout_ms * 1_000_000`,
# so the default 30 s timeout implies 3e10. That is a *wall-clock* bound
# expressed as a *CPU* bound, and the two are not interchangeable: a caller
# wanting Rust's `Store::set_fuel(1_000_000_000)` had no way to ask for it
# without also shortening its timeout to one second.
#
# Reported by agnosai 2026-08-13, whose `WasmSandbox` advertises the oracle's
# 1e9 through `agnosai_wasm_sandbox_fuel` while the guest actually ran with 30x
# that. Setting this makes the advertised limit the enforced one.
fn config_fuel(c, fuel)        { SandboxConfig_set_fuel(c, fuel); return c; }

# Bounds on what a WASM guest may create (3.14.4), each a wasmtime `-W` option of
# the same name (`wasmtime run -W help`), checked against wasmtime 50.0.1. 0, the
# default, leaves that bound to wasmtime. agnosai's Rust line held its guests to
# 10 instances, tables and memories.
fn config_wasm_max_instances(c, n)      { SandboxConfig_set_wasm_max_instances(c, n); return c; }
# wasmtime's `-W max-tables`: tables a guest may create. 0 leaves it to wasmtime.
fn config_wasm_max_tables(c, n)         { SandboxConfig_set_wasm_max_tables(c, n); return c; }
# wasmtime's `-W max-table-elements`: the size a table may reach. 0 leaves it to wasmtime.
fn config_wasm_max_table_elements(c, n) { SandboxConfig_set_wasm_max_table_elements(c, n); return c; }
# wasmtime's `-W max-memories`: linear memories a guest may create. 0 leaves it to wasmtime.
fn config_wasm_max_memories(c, n)       { SandboxConfig_set_wasm_max_memories(c, n); return c; }

# Whether a failed `memory.grow` or `table.grow` traps (`on` 1, the default) or
# returns -1 to the guest (`on` 0), as WebAssembly itself specifies. On by
# default, as agnosai asked and its Rust line did: a guest that ignores -1 stops
# with a non-zero exit, not on whatever it does with a failed allocation.
#
# ⚠ The trap is not free for a guest that handles -1 well. One that over-asks and
# falls back when refused, or an allocator that treats NULL as a cache miss, exits
# 0 with the trap off and traps with it on. Such a guest turns it off. A module's
# own declared maximum counts as a failed grow too, so the 64 MiB default is not
# the only ceiling that can trip it.
#
# Stored inverted, so the zeroed struct `config_new` builds means the default.
fn config_wasm_trap_on_grow_failure(c, on) {
    var ret = 0;
    if (on == 0) { ret = 1; }
    SandboxConfig_set_wasm_grow_returns_failure(c, ret);
    return c;
}

# Require the namespaces the policy asks for, even without a rootfs.
#
# **Off by default, and that default is a deliberate trade** (3.11.5). Namespace
# isolation on a rootfs-less sandbox needs a new *user* namespace when
# unprivileged, and Ubuntu 24.04 restricts those outright — so applying it
# unconditionally turns payloads that used to run into payloads that do not run
# at all, on a stock CI host. 3.11.3 briefly did exactly that.
#
# With this set, the rootfs-less path requests the policy's namespaces and
# **fails closed** if the host refuses: the payload exits `SPAWN_EXIT_NS` (123)
# or `SPAWN_EXIT_IDMAP` (118) rather than running with the network the policy
# said it would not have. That is the right answer for a caller who needs the
# guarantee, and the wrong default for one who does not know they are asking.
#
# Off, a rootfs-less sandbox gets seccomp and landlock and **no network
# isolation** — which is what it silently got before 3.11.5, now sayable.
fn config_require_namespaces(c, on) { SandboxConfig_set_require_ns(c, on); return c; }
fn config_inner_backend(c, b)  { SandboxConfig_set_inner_backend(c, b); return c; }
fn config_agent_id(c, s)       { SandboxConfig_set_agent_id(c, s); return c; }
fn config_hostname(c, s)       { SandboxConfig_set_hostname(c, s); return c; }
fn config_domainname(c, s)     { SandboxConfig_set_domainname(c, s); return c; }
fn config_workdir(c, s)        { SandboxConfig_set_workdir(c, s); return c; }

# The filesystem the payload runs INSIDE (3.9.1). Absent (0) means the payload
# execs on the host filesystem, which is what every release before 3.9.1 did
# unconditionally — a container runtime consuming this API had no way to say
# "run in this rootfs", so its containers silently ran host binaries.
fn config_rootfs(c, path)      { SandboxConfig_set_rootfs(c, path); return c; }

# Attach an externalization policy to this sandbox — 3.11.2.
#
# **Carrying the policy is all this does; nothing applies it for you.** The
# lifecycle does not run the gate, so a caller still passes the policy to
# `gate_apply` at the point it wants output scanned. What the field buys is that
# two sandboxes running under different trust levels no longer look identical to
# anything reading their configs.
#
# Reported by agnosai, whose Rust original builds every config with
# `.externalization(ExternalizationPolicy::default())` and had no counterpart to
# port. Default is **0**, not `ext_policy_default()`: defaulting to an active
# policy would start scanning output for every existing consumer that never
# asked for it, which is a behaviour change rather than a new capability.
fn config_externalization(c, p) { SandboxConfig_set_externalization(c, p); return c; }

# The payload's environment — an EXPLICIT, caller-supplied vec of "KEY=VALUE"
# cstrs. Default 0, which execs with an empty environment exactly as before.
#
# This does NOT reverse kavach's standing position that the caller's environment
# is never leaked into a sandbox (`backend_oci.cyr`). The two are opposites:
# inheritance is implicit and carries whatever the host happened to export;
# this is a list the caller wrote down. Nothing is inherited — an entry reaches
# the payload only because a caller put it there. That distinction is the whole
# reason this is safe to add: the default stays empty, so every existing
# consumer is byte-identical, and `getenv` in a sandbox still returns nothing
# unless someone explicitly asked for it.
#
# Reported by stiva, whose containers silently lost the OCI image's declared
# `process.env`: it parsed the image config, persisted the vars, built them into
# its RuntimeSpec — and then had no kavach setter to hand them to, so every
# container ran without the environment its image declared. The Rust runtime
# stiva was ported from applied them via `Command::env`, so this was a parity
# regression with no expressible fix on the consumer side.
#
# Honoured by the process backend (`confine_capture_input`), `sandbox_spawn`,
# and the OCI backend's `process.env`. NOT honoured by persistent sandboxes,
# which have no config in scope — see `_persistent_spawn_inner`. Through 3.13.0
# the process backend honoured it, and `config_workdir`, only under a policy
# asking for confinement: its unconfined capture took neither.
fn config_env(c, v) { SandboxConfig_set_env(c, v); return c; }

# The capabilities a payload with a rootfs runs with, on the OCI and gVisor backends
# and, since 3.14.6, on the process path and `sandbox_spawn`: a vec of "CAP_*" cstrs.
# Unset, it runs with `oci_default_capabilities()`.
#
# Set, the list REPLACES that one, as `config_env` replaces its defaults. A payload
# that needs one more pushes onto `oci_default_capabilities()`, and one that needs
# less names less. An empty vec is no capabilities at all, where an empty
# `config_env` means the defaults, because a caller who passes an empty list here
# can only mean that.
#
# A name kavach does not know fails the exec on every path. `oci_capabilities_refusal`
# refuses CAP_SYS_ADMIN under a seccomp filter too, on the OCI backend, and
# `confine_capabilities_refusal` says why the process path does not. A sandbox with
# no rootfs does not read this, so a caller narrowing it there gets no narrowing,
# and `score_backend`, which takes a policy, does not see it.
fn config_capabilities(c, v) { SandboxConfig_set_capabilities(c, v); return c; }

# Build a NULL-terminated envp from a vec of "KEY=VALUE" cstrs. `v == 0` (the
# default) yields the empty envp every kavach exec path used unconditionally
# before 3.12.0, so an unset config is bit-for-bit the old behaviour.
#[must_use]
fn kv_envp_from_vec(v) {
    if (v == 0) {
        var e0 = alloc(8);
        store64(e0, 0);
        return e0;
    }
    var n = vec_len(v);
    var envp = alloc((n + 1) * 8);
    var i = 0;
    while (i < n) {
        store64(envp + i * 8, vec_get(v, i));
        i = i + 1;
    }
    store64(envp + n * 8, 0);
    return envp;
}

# Convenience: enable seccomp with a profile name on the config's policy.
fn config_policy_seccomp(c, profile) {
    var p = SandboxConfig_policy(c);
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, profile);
    return c;
}

fn config_network(c, enabled) {
    var p = SandboxConfig_policy(c);
    SandboxPolicy_set_network_enabled(p, enabled);
    return c;
}

# ---- Sandbox --------------------------------------------------------------

#derive(accessors)
struct Sandbox {
    id;
    config;
    state;
    created_at;
    started_at;
    stopped_at;
    argv;           # the vec a sandbox_*_argv call is running, or 0
    last_scan;
    last_assessment;
    last_attestation;
    attest_nonce;
    attest_nonce_len;
    quote;
    quote_len;
}

# 112 (3.14.8): what `sandbox_exec` found for this sandbox's last exec, and the
# attestation nonce and quote of the exec in flight, appended so no field moves.
# Through 3.14.7 they were process-wide globals (`sandbox_exec_last_scan_result`
# and the rest, which still read the process's most recent), so two sandboxes
# exec'ing at once on two threads read each other's.
var SANDBOX_SIZE = 112;

# Sandbox IDs: 64 bits from /dev/urandom, UUID-v4-equivalent for
# correlation. Collision probability across 2^32 sandboxes is ~2^-32.
# Previously a monotonic counter (deferred per ADR-004 §8); closed in
# v3.0 now that util.cyr ships rand_u64().

# Monotonic nanoseconds. Thin alias over the stdlib chrono.clock_now_ns
# (chrono is already a dep) — was a byte-for-byte duplicate of it
# (CLOCK_MONOTONIC clock_gettime). Kept as a named wrapper so the ~22
# backend/lifecycle call sites stay put and the raw syscall + magic 228
# live in one upstream place (S1).
fn mono_now_ns() {
    return clock_now_ns();
}

# Create a sandbox from config. Fails with BACKEND_UNAVAILABLE if the
# selected backend is not present on this system.
fn sandbox_create(config) {
    var b = SandboxConfig_backend(config);
    if (backend_is_available(b) == 0) {
        kavach_err_print(KAVACH_ERR_BACKEND_UNAVAILABLE, os_backend_name(b));
        return 0;
    }
    var s = alloc(SANDBOX_SIZE);
    memset(s, 0, SANDBOX_SIZE);
    Sandbox_set_id(s, rand_u64());
    Sandbox_set_config(s, config);
    Sandbox_set_state(s, SandboxState.CREATED);
    Sandbox_set_created_at(s, mono_now_ns());
    Sandbox_set_started_at(s, 0);
    Sandbox_set_stopped_at(s, 0);
    Sandbox_set_argv(s, 0);
    return s;
}

# The payload's argv for the command in flight: the vec a sandbox_*_argv call
# set, else `command` split on spaces and tabs. Only the argv form can carry an
# argument that holds either, or an empty one.
fn _sandbox_command_argv(sandbox, command) {
    var argv = Sandbox_argv(sandbox);
    if (argv != 0) { return argv; }
    return _split_command(command);
}

# 1 when `s` is what _split_command hands back unchanged: not empty, no space,
# no tab.
fn _kv_arg_is_word(s) {
    var n = strlen(s);
    if (n == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 32 || c == 9) { return 0; }
        i = i + 1;
    }
    return 1;
}

# `argv` joined with spaces: the text the runtime guard, the audit chain and a
# string backend read. 0 when there is nothing to run.
#
# ⛔ The first element must be a word. The guard's blocklist reads the first
# word of this text as the program, so an argv[0] of "/tmp/a b/bash" would show
# it "a" and then exec a file named bash.
fn _kv_argv_command(argv) {
    if (argv == 0) { return 0; }
    var n = vec_len(argv);
    if (n == 0) { return 0; }
    if (_kv_arg_is_word(vec_get(argv, 0)) == 0) { return 0; }
    var cap = 1;
    var i = 0;
    while (i < n) {
        cap = checked_add(cap, strlen(vec_get(argv, i)) + 1);
        if (cap < 0) { return 0; }
        i = i + 1;
    }
    var buf = alloc_checked(cap);
    if (buf == 0) { return 0; }
    var pos = 0;
    i = 0;
    while (i < n) {
        if (i > 0) {
            store8(buf + pos, 32);
            pos = pos + 1;
        }
        var s = vec_get(argv, i);
        var len = strlen(s);
        memcpy(buf + pos, s, len);
        pos = pos + len;
        i = i + 1;
    }
    store8(buf + pos, 0);
    return buf;
}

# Transition to a new state. Returns KAVACH_ERR_OK on success,
# KAVACH_ERR_INVALID_TRANSITION otherwise.
fn sandbox_transition(s, to) {
    var from = Sandbox_state(s);
    if (valid_transition(from, to) == 0) {
        return KAVACH_ERR_INVALID_TRANSITION;
    }
    Sandbox_set_state(s, to);
    if (to == SandboxState.RUNNING) {
        Sandbox_set_started_at(s, mono_now_ns());
    }
    if (to == SandboxState.STOPPED) { Sandbox_set_stopped_at(s, mono_now_ns()); }
    if (to == SandboxState.DESTROYED) { Sandbox_set_stopped_at(s, mono_now_ns()); }
    return KAVACH_ERR_OK;
}

# Destroy the sandbox. Transitions through STOPPED if still running.
fn sandbox_destroy(s) {
    var st = Sandbox_state(s);
    if (st == SandboxState.RUNNING) {
        sandbox_transition(s, SandboxState.STOPPED);
    }
    if (st == SandboxState.PAUSED) {
        sandbox_transition(s, SandboxState.STOPPED);
    }
    return sandbox_transition(s, SandboxState.DESTROYED);
}

# ---- SandboxPool ----------------------------------------------------------

#derive(accessors)
struct SandboxPool {
    template;
    warm_count;
    pool_vec;
}

fn sandbox_pool_new(template, warm_count) {
    var p = alloc(24);
    SandboxPool_set_template(p, template);
    SandboxPool_set_warm_count(p, warm_count);
    var v = vec_new();
    var i = 0;
    while (i < warm_count) {
        var sb = sandbox_create(template);
        if (sb == 0) { return 0; }
        vec_push(v, sb);
        i = i + 1;
    }
    SandboxPool_set_pool_vec(p, v);
    return p;
}

# Pop a pre-created sandbox from the pool; cold-start one on miss.
fn sandbox_pool_claim(p) {
    var v = SandboxPool_pool_vec(p);
    if (vec_len(v) > 0) {
        return vec_pop(v);
    }
    return sandbox_create(SandboxPool_template(p));
}

fn sandbox_pool_replenish(p) {
    var v = SandboxPool_pool_vec(p);
    var target = SandboxPool_warm_count(p);
    while (vec_len(v) < target) {
        var sb = sandbox_create(SandboxPool_template(p));
        if (sb == 0) { return KAVACH_ERR_CREATION_FAILED; }
        vec_push(v, sb);
    }
    return KAVACH_ERR_OK;
}

fn sandbox_pool_available(p) {
    return vec_len(SandboxPool_pool_vec(p));
}

# --- scanning_types.cyr ---

# kavach — scanning types
# Ported from rust-old/src/scanning/types.rs

enum Severity {
    INFO = 0;
    LOW = 1;
    MEDIUM = 2;
    HIGH = 3;
    CRITICAL = 4;
}

enum ScanVerdict {
    PASS = 0;
    WARN = 1;
    QUARANTINE = 2;
    BLOCK = 3;
}

fn severity_name(s) {
    if (s == Severity.INFO) { return "info"; }
    if (s == Severity.LOW) { return "low"; }
    if (s == Severity.MEDIUM) { return "medium"; }
    if (s == Severity.HIGH) { return "high"; }
    if (s == Severity.CRITICAL) { return "critical"; }
    return "unknown";
}

fn verdict_name(v) {
    if (v == ScanVerdict.PASS) { return "pass"; }
    if (v == ScanVerdict.WARN) { return "warn"; }
    if (v == ScanVerdict.QUARANTINE) { return "quarantine"; }
    if (v == ScanVerdict.BLOCK) { return "block"; }
    return "unknown";
}

# A single finding from a scanner.
#derive(accessors)
struct ScanFinding {
    id;
    scanner;
    severity;
    category;
    message;
    evidence;
}

var SCAN_FINDING_SIZE = 48;

# Finding IDs: 64-bit random from /dev/urandom (UUID-v4-equivalent).
# Swapped from a monotonic counter in v3.0 — see ADR-004 §8.
fn finding_new(scanner, severity, category, message, evidence) {
    var f = alloc(SCAN_FINDING_SIZE);
    ScanFinding_set_id(f, rand_u64());
    ScanFinding_set_scanner(f, scanner);
    ScanFinding_set_severity(f, severity);
    ScanFinding_set_category(f, category);
    ScanFinding_set_message(f, message);
    ScanFinding_set_evidence(f, evidence);
    return f;
}

#derive(accessors)
struct ScanResult {
    verdict;
    findings;
    worst_severity;
}

var SCAN_RESULT_SIZE = 24;

fn scan_result_new() {
    var r = alloc(SCAN_RESULT_SIZE);
    ScanResult_set_verdict(r, ScanVerdict.PASS);
    ScanResult_set_findings(r, vec_new());
    ScanResult_set_worst_severity(r, Severity.INFO);
    return r;
}

fn scan_result_push(r, finding) {
    var v = ScanResult_findings(r);
    vec_push(v, finding);
    var sev = ScanFinding_severity(finding);
    if (sev > ScanResult_worst_severity(r)) {
        ScanResult_set_worst_severity(r, sev);
    }
    return 0;
}

# Externalization gate policy.
#derive(accessors)
struct ExternalizationPolicy {
    enabled;
    max_artifact_size_bytes;
    block_threshold;
    quarantine_threshold;
    redact_secrets;
}

var EXT_POLICY_SIZE = 40;

fn ext_policy_default() {
    var p = alloc(EXT_POLICY_SIZE);
    ExternalizationPolicy_set_enabled(p, 1);
    # 50 MiB
    ExternalizationPolicy_set_max_artifact_size_bytes(p, 52428800);
    ExternalizationPolicy_set_block_threshold(p, Severity.CRITICAL);
    ExternalizationPolicy_set_quarantine_threshold(p, Severity.HIGH);
    ExternalizationPolicy_set_redact_secrets(p, 1);
    return p;
}

# --- aho_corasick.cyr ---

# kavach — Aho-Corasick multi-pattern matcher
#
# Replaces the scanners' per-pattern full-buffer re-scan (O(patterns × n × m)
# naive substring, ~150 cstr_contains calls in scanning_code.cyr) with a
# single O(n + matches) pass: build one automaton over the literal pattern set,
# run the text through it once, and read each pattern's first-match position
# out of a hit table.
#
# The automaton is built once over a static pattern set and cached by the
# caller (the pattern set is compile-time fixed), so build cost is amortized to
# zero across scans; only the O(n) search runs per artifact.
#
# Patterns are matched case-sensitively against bytes — callers that want
# case-insensitive matching pre-lower both the text and the patterns (which is
# exactly what the code/data scanners already do against their `lower` buffer).
#
# Memory model (all heap, manual): dense 256-way goto so a transition is a flat
# load; node count is bounded by the total pattern length, built once.
#
#   automaton struct (64 bytes):
#     +0  goto_base   (num_nodes_cap * 256 i64; 0 = no transition, root = node 0)
#     +8  fail_base   (num_nodes_cap i64)
#     +16 term_base   (num_nodes_cap i64; pattern id ending at node, or -1)
#     +24 dict_base   (num_nodes_cap i64; output/suffix link to nearest terminal)
#     +32 patlen_base (num_pats i64; byte length of each pattern)
#     +40 num_pats
#     +48 num_nodes   (actual, after build)

# Build an automaton from a vec of pattern cstrs. Pattern ids are the vec
# indices. Returns a heap automaton pointer (never freed — cache it).
fn ac_build(patterns) {
    var np = vec_len(patterns);

    # Upper bound on trie nodes: root + one per pattern char (shared prefixes
    # only ever use fewer). Sized exactly once.
    var total = 0;
    var i = 0;
    while (i < np) {
        total = total + strlen(vec_get(patterns, i));
        i = i + 1;
    }
    var cap = total + 1;

    var goto_b = alloc(cap * 256 * 8);
    memset(goto_b, 0, cap * 256 * 8);
    var fail_b = alloc(cap * 8);
    memset(fail_b, 0, cap * 8);
    var dict_b = alloc(cap * 8);
    memset(dict_b, 0, cap * 8);
    var term_b = alloc(cap * 8);
    var patlen_b = alloc(np * 8);

    # term[] initialised to -1 (no pattern ends here).
    var t = 0;
    while (t < cap) { store64(term_b + t * 8, 0 - 1); t = t + 1; }

    var num_nodes = 1;   # node 0 = root

    # ---- insert patterns into the trie ----
    i = 0;
    while (i < np) {
        var p = vec_get(patterns, i);
        var plen = strlen(p);
        store64(patlen_b + i * 8, plen);
        var node = 0;
        var j = 0;
        while (j < plen) {
            var c = load8(p + j);
            var slot = goto_b + (node * 256 + c) * 8;
            var nxt = load64(slot);
            if (nxt == 0) {
                nxt = num_nodes;
                num_nodes = num_nodes + 1;
                store64(slot, nxt);
            }
            node = nxt;
            j = j + 1;
        }
        store64(term_b + node * 8, i);   # pattern i terminates at `node`
        i = i + 1;
    }

    # ---- BFS to compute failure + dict (output) links ----
    var queue = vec_new();
    # depth-1 nodes (root's children) fail to root.
    var c0 = 0;
    while (c0 < 256) {
        var ch = load64(goto_b + c0 * 8);   # goto[root][c0]
        if (ch != 0) {
            store64(fail_b + ch * 8, 0);
            vec_push(queue, ch);
        }
        c0 = c0 + 1;
    }
    var qi = 0;
    while (qi < vec_len(queue)) {
        var u = vec_get(queue, qi);
        qi = qi + 1;
        var cc = 0;
        while (cc < 256) {
            var v = load64(goto_b + (u * 256 + cc) * 8);
            if (v != 0) {
                # follow u's fail chain to find the longest proper suffix that
                # has a transition on cc
                var f = load64(fail_b + u * 8);
                while (f != 0) {
                    if (load64(goto_b + (f * 256 + cc) * 8) != 0) { break; }
                    f = load64(fail_b + f * 8);
                }
                var ff = load64(goto_b + (f * 256 + cc) * 8);
                if (ff == v) { ff = 0; }   # never let a node fail to itself
                store64(fail_b + v * 8, ff);
                # dict link: nearest terminal node reachable via fail links
                if (load64(term_b + ff * 8) != (0 - 1)) {
                    store64(dict_b + v * 8, ff);
                }
                else {
                    store64(dict_b + v * 8, load64(dict_b + ff * 8));
                }
                vec_push(queue, v);
            }
            cc = cc + 1;
        }
    }

    var ac = alloc(64);
    store64(ac + 0, goto_b);
    store64(ac + 8, fail_b);
    store64(ac + 16, term_b);
    store64(ac + 24, dict_b);
    store64(ac + 32, patlen_b);
    store64(ac + 40, np);
    store64(ac + 48, num_nodes);
    return ac;
}

fn ac_num_pats(ac) { return load64(ac + 40); }

# Allocate a hit-position table for `ac`, initialised to -1 (no match).
# Indexed by pattern id; on a hit, holds the START offset of the first match.
fn ac_hits_new(ac) {
    var np = load64(ac + 40);
    var h = alloc(np * 8);
    var i = 0;
    while (i < np) { store64(h + i * 8, 0 - 1); i = i + 1; }
    return h;
}

# Run `text` (length n) through the automaton, recording the first-match start
# offset of every pattern into `hit_pos` (caller-allocated via ac_hits_new).
fn ac_search(ac, text, n, hit_pos) {
    var goto_b = load64(ac + 0);
    var fail_b = load64(ac + 8);
    var term_b = load64(ac + 16);
    var dict_b = load64(ac + 24);
    var patlen_b = load64(ac + 32);

    var node = 0;
    var i = 0;
    while (i < n) {
        var c = load8(text + i);
        # follow fail links until a transition on c exists (or we're at root)
        while (node != 0) {
            if (load64(goto_b + (node * 256 + c) * 8) != 0) { break; }
            node = load64(fail_b + node * 8);
        }
        node = load64(goto_b + (node * 256 + c) * 8);   # 0 (root) if none
        # emit every pattern ending at this position via the dict-link chain
        var u = node;
        if (load64(term_b + u * 8) == (0 - 1)) { u = load64(dict_b + u * 8); }
        while (u != 0) {
            var pid = load64(term_b + u * 8);
            if (pid != (0 - 1)) {
                if (load64(hit_pos + pid * 8) == (0 - 1)) {
                    store64(hit_pos + pid * 8, i - load64(patlen_b + pid * 8) + 1);
                }
            }
            u = load64(dict_b + u * 8);
        }
        i = i + 1;
    }
    return 0;
}

# --- scanning_secrets.cyr ---

# kavach — secrets scanner
# Ported from rust-old/src/scanning/secrets.rs
#
# Cyrius' `lib/regex.cyr` is glob-only; PCRE character classes aren't
# available yet. This port uses hand-rolled literal-prefix + char-class
# matchers for patterns with distinctive prefixes. Patterns that rely on
# case-insensitive or negative lookahead (AWS secret, generic api_key,
# bearer, password assign, email) are left as TODO until a full regex
# engine lands in the stdlib.

# ---- character classes ---------------------------------------------------

fn is_upper_c(c) {
    if (c >= 65) { if (c <= 90) { return 1; } }
    return 0;
}
fn is_lower_c(c) {
    if (c >= 97) { if (c <= 122) { return 1; } }
    return 0;
}
fn is_digit_c(c) {
    if (c >= 48) { if (c <= 57) { return 1; } }
    return 0;
}
fn is_alnum_c(c) {
    if (is_upper_c(c) == 1) { return 1; }
    if (is_lower_c(c) == 1) { return 1; }
    if (is_digit_c(c) == 1) { return 1; }
    return 0;
}
# [A-Za-z0-9_]
fn is_token_c(c) {
    if (is_alnum_c(c) == 1) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}
# [A-Za-z0-9_-]
fn is_jwt_c(c) {
    if (is_token_c(c) == 1) { return 1; }
    if (c == 45) { return 1; }
    return 0;
}

# Literal prefix check: returns 1 if text[i..] starts with prefix.
fn starts_with_at(text, i, n, prefix) {
    var plen = strlen(prefix);
    if (i + plen > n) { return 0; }
    var j = 0;
    while (j < plen) {
        if (load8(text + i + j) != load8(prefix + j)) { return 0; }
        j = j + 1;
    }
    return 1;
}

# ---- individual pattern matchers -----------------------------------------
# Each returns match length on success, 0 otherwise.

# AKIA + 16 [A-Z0-9]
fn match_aws_access_key(text, i, n) {
    if (i + 20 > n) { return 0; }
    if (load8(text + i) != 65) { return 0; }
    if (load8(text + i + 1) != 75) { return 0; }
    if (load8(text + i + 2) != 73) { return 0; }
    if (load8(text + i + 3) != 65) { return 0; }
    var j = 0;
    while (j < 16) {
        var c = load8(text + i + 4 + j);
        if (is_upper_c(c) == 0) {
            if (is_digit_c(c) == 0) { return 0; }
        }
        j = j + 1;
    }
    return 20;
}

# gh[ps]_ + 36+ [A-Za-z0-9_]
fn match_github_token(text, i, n) {
    if (i + 4 > n) { return 0; }
    if (load8(text + i) != 103) { return 0; }      # g
    if (load8(text + i + 1) != 104) { return 0; }  # h
    var c2 = load8(text + i + 2);
    if (c2 != 112) {                                # p
        if (c2 != 115) { return 0; }                # s
    }
    if (load8(text + i + 3) != 95) { return 0; }    # _
    var j = 0;
    while (i + 4 + j < n) {
        if (is_token_c(load8(text + i + 4 + j)) == 0) {
            if (j >= 36) { return 4 + j; }
            return 0;
        }
        j = j + 1;
    }
    if (j >= 36) { return 4 + j; }
    return 0;
}

# AIza + 35 [A-Za-z0-9_-]
fn match_gcp_key(text, i, n) {
    if (i + 39 > n) { return 0; }
    if (load8(text + i) != 65) { return 0; }      # A
    if (load8(text + i + 1) != 73) { return 0; }  # I
    if (load8(text + i + 2) != 122) { return 0; } # z
    if (load8(text + i + 3) != 97) { return 0; }  # a
    var j = 0;
    while (j < 35) {
        if (is_jwt_c(load8(text + i + 4 + j)) == 0) { return 0; }
        j = j + 1;
    }
    return 39;
}

# eyJ<jwt_c+>.eyJ<jwt_c+>.<jwt_c+>
fn match_jwt(text, i, n) {
    if (i + 3 > n) { return 0; }
    if (load8(text + i) != 101) { return 0; }     # e
    if (load8(text + i + 1) != 121) { return 0; } # y
    if (load8(text + i + 2) != 74) { return 0; }  # J
    var j = 3;
    var seg1 = 0;
    while (i + j < n) {
        if (is_jwt_c(load8(text + i + j)) == 0) { break; }
        j = j + 1;
        seg1 = seg1 + 1;
    }
    if (seg1 < 10) { return 0; }
    if (i + j + 4 > n) { return 0; }
    if (load8(text + i + j) != 46) { return 0; }    # .
    if (load8(text + i + j + 1) != 101) { return 0; } # e
    if (load8(text + i + j + 2) != 121) { return 0; } # y
    if (load8(text + i + j + 3) != 74) { return 0; }  # J
    j = j + 4;
    var seg2 = 0;
    while (i + j < n) {
        if (is_jwt_c(load8(text + i + j)) == 0) { break; }
        j = j + 1;
        seg2 = seg2 + 1;
    }
    if (seg2 < 10) { return 0; }
    if (i + j + 1 > n) { return 0; }
    if (load8(text + i + j) != 46) { return 0; }
    j = j + 1;
    var seg3 = 0;
    while (i + j < n) {
        if (is_jwt_c(load8(text + i + j)) == 0) { break; }
        j = j + 1;
        seg3 = seg3 + 1;
    }
    if (seg3 < 10) { return 0; }
    return j;
}

# \b\d{3}-\d{2}-\d{4}\b
fn match_ssn(text, i, n) {
    if (i + 11 > n) { return 0; }
    # Word boundary: preceding char (if any) must not be alnum/_
    if (i > 0) {
        var prev = load8(text + i - 1);
        if (is_token_c(prev) == 1) { return 0; }
    }
    if (is_digit_c(load8(text + i)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 1)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 2)) == 0) { return 0; }
    if (load8(text + i + 3) != 45) { return 0; }
    if (is_digit_c(load8(text + i + 4)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 5)) == 0) { return 0; }
    if (load8(text + i + 6) != 45) { return 0; }
    if (is_digit_c(load8(text + i + 7)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 8)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 9)) == 0) { return 0; }
    if (is_digit_c(load8(text + i + 10)) == 0) { return 0; }
    if (i + 11 < n) {
        if (is_token_c(load8(text + i + 11)) == 1) { return 0; }
    }
    return 11;
}

# (postgres|mysql|mongodb|redis)://<non-space>{10,256}
fn _scheme_len(text, i, n) {
    if (starts_with_at(text, i, n, "postgres://") == 1) { return 11; }
    if (starts_with_at(text, i, n, "mysql://") == 1) { return 8; }
    if (starts_with_at(text, i, n, "mongodb://") == 1) { return 10; }
    if (starts_with_at(text, i, n, "redis://") == 1) { return 8; }
    return 0;
}

fn match_conn_string(text, i, n) {
    var sl = _scheme_len(text, i, n);
    if (sl == 0) { return 0; }
    var body = 0;
    while (i + sl + body < n) {
        var c = load8(text + i + sl + body);
        if (c == 32) { break; }
        if (c == 9) { break; }
        if (c == 10) { break; }
        if (c == 13) { break; }
        body = body + 1;
        if (body >= 256) { break; }
    }
    if (body < 10) { return 0; }
    return sl + body;
}

# ---- evidence truncation -------------------------------------------------

# Evidence is stored in ScanFinding and may end up in audit logs and
# quarantine metadata. Delegate to util.cyr's redact_evidence, which
# keeps a 4-char prefix + '****' + 4-char suffix — enough signal to
# identify the finding type (e.g. 'AKIA****DATA') without leaking the
# actual secret into at-rest artifacts. See ADR-005 §H1.
fn _evidence_copy(text, start, len) {
    return redact_evidence(text, start, len);
}

# ---- in-place redaction for WARN verdict (ADR-004 §7) --------------------
# Walks text once, rewriting every matched secret span to
# "[REDACTED:CATEGORY]" and leaving non-matches untouched. Returns a
# heap-allocated cstr. Called from scanning_gate.cyr when a WARN verdict
# is reached with policy.redact_secrets enabled.

fn _redact_append_marker(out, out_pos, category) {
    var prefix = "[REDACTED:";
    memcpy(out + out_pos, prefix, 10);
    out_pos = out_pos + 10;
    memcpy(out + out_pos, category, strlen(category));
    out_pos = out_pos + strlen(category);
    store8(out + out_pos, 93);
    return out_pos + 1;
}

# Redact over `n` bytes rather than to the first NUL, reporting the produced
# length through `out_len` (0 to ignore).
#
# **The output length is not `strlen` of the output.** Redaction copies the
# non-matching spans verbatim, so an artifact containing a NUL produces an
# output containing that NUL — measuring the result with `strlen` would truncate
# the very artifact the caller is about to release. `out_pos` is the exact
# figure and is now handed back.
#
# `secrets_redact` keeps its signature and behaviour for a cstring caller.
fn secrets_redact_n(text, n, out_len) {
    var starts = vec_new();
    var lens = vec_new();
    var cats = vec_new();

    var i = 0;
    while (i < n) {
        var m = match_aws_access_key(text, i, n);
        if (m > 0) {
            vec_push(starts, i); vec_push(lens, m); vec_push(cats, "cloud_credential");
            i = i + m;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN RSA PRIVATE KEY-----") == 1) {
            vec_push(starts, i); vec_push(lens, 31); vec_push(cats, "private_key");
            i = i + 31;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN EC PRIVATE KEY-----") == 1) {
            vec_push(starts, i); vec_push(lens, 30); vec_push(cats, "private_key");
            i = i + 30;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN OPENSSH PRIVATE KEY-----") == 1) {
            vec_push(starts, i); vec_push(lens, 35); vec_push(cats, "private_key");
            i = i + 35;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN PRIVATE KEY-----") == 1) {
            vec_push(starts, i); vec_push(lens, 27); vec_push(cats, "private_key");
            i = i + 27;
        }
        else {
            var g = match_github_token(text, i, n);
            if (g > 0) {
                vec_push(starts, i); vec_push(lens, g); vec_push(cats, "api_token");
                i = i + g;
            }
            else {
                var k = match_gcp_key(text, i, n);
                if (k > 0) {
                    vec_push(starts, i); vec_push(lens, k); vec_push(cats, "cloud_credential");
                    i = i + k;
                }
                else {
                    var jw = match_jwt(text, i, n);
                    if (jw > 0) {
                        vec_push(starts, i); vec_push(lens, jw); vec_push(cats, "auth_token");
                        i = i + jw;
                    }
                    else {
                        var cs = match_conn_string(text, i, n);
                        if (cs > 0) {
                            vec_push(starts, i); vec_push(lens, cs); vec_push(cats, "connection_string");
                            i = i + cs;
                        }
                        else {
                            var ss = match_ssn(text, i, n);
                            if (ss > 0) {
                                vec_push(starts, i); vec_push(lens, ss); vec_push(cats, "pii");
                                i = i + ss;
                            }
                            else {
                                i = i + 1;
                            }
                        }
                    }
                }
            }
        }
    }

    if (vec_len(starts) == 0) {
        var copy = alloc(n + 1);
        memcpy(copy, text, n);
        store8(copy + n, 0);
        if (out_len != 0) { store64(out_len, n); }
        return copy;
    }

    # Output cap: original text + up to 32 bytes overhead per match.
    var match_count = vec_len(starts);
    var overhead = checked_mul(match_count, 32);
    if (overhead < 0) { return 0; }
    var cap = checked_add(n, overhead);
    if (cap < 0) { return 0; }
    cap = checked_add(cap, 1);
    if (cap < 0) { return 0; }
    var out = alloc_checked(cap);
    if (out == 0) { return 0; }

    var cursor = 0;
    var out_pos = 0;
    var j = 0;
    while (j < match_count) {
        var s = vec_get(starts, j);
        var l = vec_get(lens, j);
        var c = vec_get(cats, j);
        if (s > cursor) {
            memcpy(out + out_pos, text + cursor, s - cursor);
            out_pos = out_pos + (s - cursor);
        }
        out_pos = _redact_append_marker(out, out_pos, c);
        cursor = s + l;
        j = j + 1;
    }
    if (cursor < n) {
        memcpy(out + out_pos, text + cursor, n - cursor);
        out_pos = out_pos + (n - cursor);
    }
    store8(out + out_pos, 0);
    if (out_len != 0) { store64(out_len, out_pos); }
    return out;
}

# Redact a NUL-terminated cstring. Unchanged behaviour, kept for every caller
# that has one — the length-carrying form above is for artifacts that may not.
fn secrets_redact(text) {
    return secrets_redact_n(text, strlen(text), 0);
}

# ---- scan loop -----------------------------------------------------------

var MAX_FINDINGS = 1000;

fn secrets_scan(text, result) {
    var i = 0;
    var n = strlen(text);
    while (i < n) {
        var v = ScanResult_findings(result);
        if (vec_len(v) >= MAX_FINDINGS) { return 0; }

        var m = match_aws_access_key(text, i, n);
        if (m > 0) {
            scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                "cloud_credential", "AWS Access Key detected",
                _evidence_copy(text, i, m)));
            i = i + m;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN RSA PRIVATE KEY-----") == 1) {
            scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                "private_key", "RSA Private Key detected",
                _evidence_copy(text, i, 20)));
            i = i + 31;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN EC PRIVATE KEY-----") == 1) {
            scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                "private_key", "EC Private Key detected",
                _evidence_copy(text, i, 20)));
            i = i + 30;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN OPENSSH PRIVATE KEY-----") == 1) {
            scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                "private_key", "OpenSSH Private Key detected",
                _evidence_copy(text, i, 20)));
            i = i + 35;
        }
        elif (starts_with_at(text, i, n, "-----BEGIN PRIVATE KEY-----") == 1) {
            scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                "private_key", "Generic Private Key detected",
                _evidence_copy(text, i, 20)));
            i = i + 27;
        }
        else {
            var j = match_github_token(text, i, n);
            if (j > 0) {
                scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                    "api_token", "GitHub Token detected",
                    _evidence_copy(text, i, j)));
                i = i + j;
            }
            else {
                var k = match_gcp_key(text, i, n);
                if (k > 0) {
                    scan_result_push(result, finding_new("secrets", Severity.HIGH,
                        "cloud_credential", "GCP API Key detected",
                        _evidence_copy(text, i, k)));
                    i = i + k;
                }
                else {
                    var jw = match_jwt(text, i, n);
                    if (jw > 0) {
                        scan_result_push(result, finding_new("secrets", Severity.HIGH,
                            "auth_token", "JWT detected",
                            _evidence_copy(text, i, jw)));
                        i = i + jw;
                    }
                    else {
                        var cs = match_conn_string(text, i, n);
                        if (cs > 0) {
                            scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                                "connection_string", "Database Connection String detected",
                                _evidence_copy(text, i, cs)));
                            i = i + cs;
                        }
                        else {
                            var ss = match_ssn(text, i, n);
                            if (ss > 0) {
                                scan_result_push(result, finding_new("secrets", Severity.CRITICAL,
                                    "pii", "SSN detected",
                                    _evidence_copy(text, i, ss)));
                                i = i + ss;
                            }
                            else {
                                i = i + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

# --- scanning_code.cyr ---

# kavach — code violation scanner
# Ported from rust-old/src/scanning/code.rs
#
# Rust used &str substring match against a pre-lowered copy of the text.
# Same strategy here: lowercase once, then scan 25 pattern groups.

# ---- helpers -------------------------------------------------------------

# `str_to_lower_into` moved to src/util.cyr at 3.12.3 — a generic string helper that scanning_runtime
# also calls, and which cannot live behind the code scanner if the [lib.confine] profile is to close.

# `cstr_contains` moved to src/util.cyr at 3.12.3 — same reason.

# Find position of needle in haystack, or -1.
fn cstr_index_of(haystack, needle) {
    var hlen = strlen(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 0; }
    if (nlen > hlen) { return 0 - 1; }
    var i = 0;
    while (i + nlen <= hlen) {
        var j = 0;
        while (j < nlen) {
            if (load8(haystack + i + j) != load8(needle + j)) { break; }
            j = j + 1;
        }
        if (j == nlen) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Extract up to 20 bytes on each side of the match, from the ORIGINAL
# (case-preserved) text. Returns a heap copy (null-terminated).
fn code_extract_evidence(text, lower, pattern) {
    var pos = cstr_index_of(lower, pattern);
    if (pos < 0) { return 0; }
    var plen = strlen(pattern);
    var tlen = strlen(text);
    var start = pos - 20;
    if (start < 0) { start = 0; }
    var end = pos + plen + 20;
    if (end > tlen) { end = tlen; }
    var n = end - start;
    var buf = alloc(n + 1);
    memcpy(buf, text + start, n);
    store8(buf + n, 0);
    return buf;
}

fn code_emit(text, lower, result, severity, category, name, matched) {
    var msg_buf = alloc(strlen(name) + 10);
    var offset = 0;
    memcpy(msg_buf, name, strlen(name));
    offset = strlen(name);
    memcpy(msg_buf + offset, " detected", 9);
    store8(msg_buf + offset + 9, 0);
    scan_result_push(result, finding_new("code", severity, category,
        msg_buf, code_extract_evidence(text, lower, matched)));
    return 1;
}

# Extract up to 20 bytes on each side of a KNOWN match span [start, start+len)
# in the original text. Returns a heap copy (NUL-terminated). Unlike
# code_extract_evidence, this does NO re-scan — the caller already has the
# position, so the snippet is taken from the actual match (not the first
# occurrence of a stand-in pattern) and a multi-MiB artifact isn't re-walked
# per finding.
fn code_extract_evidence_at(text, start, len) {
    var tlen = strlen(text);
    var s = start - 20;
    if (s < 0) { s = 0; }
    var e = start + len + 20;
    if (e > tlen) { e = tlen; }
    var n = e - s;
    var buf = alloc(n + 1);
    memcpy(buf, text + s, n);
    store8(buf + n, 0);
    return buf;
}

# As code_emit, but for callers that already know the match position+length
# (e.g. the structural PII matchers) — avoids the stand-in-pattern re-scan.
fn code_emit_at(text, result, severity, category, name, start, len) {
    var msg_buf = alloc(strlen(name) + 10);
    var offset = 0;
    memcpy(msg_buf, name, strlen(name));
    offset = strlen(name);
    memcpy(msg_buf + offset, " detected", 9);
    store8(msg_buf + offset + 9, 0);
    scan_result_push(result, finding_new("code", severity, category,
        msg_buf, code_extract_evidence_at(text, start, len)));
    return 1;
}

# ---- Aho-Corasick presence pass -----------------------------------------
# The 26 pattern groups below each used to call cstr_contains(lower, LIT) per
# literal — ~109 full re-scans of the (pre-lowered) artifact, i.e. O(patterns ×
# n × m). code_scan now runs ONE Aho-Corasick pass over `lower` and the groups
# query a cheap per-pattern hit table via _cg_hit(). The master pattern list
# below must mirror the literals the groups check; a literal NOT in it falls
# back to a direct cstr_contains scan, so a drifted list can only cost speed,
# never correctness. The automaton + list are built once and cached (the
# pattern set is static); only the O(n) search runs per scan.
#
# Each scan's context, its hit table and its lowered text, is passed to the
# groups as `hits` and `lower` (3.14.8). Through 3.14.7 it lived in two module
# globals set at the top of code_scan, on the premise that kavach's scan path is
# synchronous (ADR-004 §1). A consumer running `sandbox_exec` on several threads
# makes it concurrent, and a gate there read another scan's hits: a payload's
# findings could be another payload's. The pattern list and the automaton stay
# cached, built once and only read after; `kavach_init` builds them before a
# consumer starts a thread.

var _cg_pats_cache = 0;
var _cg_ac = 0;

fn _cg_master_patterns() {
    if (_cg_pats_cache != 0) { return _cg_pats_cache; }
    var v = vec_new();
    vec_push(v, "exec(");
    vec_push(v, "execsync(");
    vec_push(v, "child_process");
    vec_push(v, "spawn(");
    vec_push(v, "spawnsync(");
    vec_push(v, "eval(");
    vec_push(v, "function(");
    vec_push(v, "/bin/sh");
    vec_push(v, "/bin/bash");
    vec_push(v, "/bin/zsh");
    vec_push(v, "cmd.exe");
    vec_push(v, "powershell");
    vec_push(v, "$(");
    vec_push(v, "${");
    vec_push(v, "| sh");
    vec_push(v, "| bash");
    vec_push(v, "; sh");
    vec_push(v, "; bash");
    vec_push(v, "/dev/tcp");
    vec_push(v, "<(");
    vec_push(v, ">(");
    vec_push(v, "curl | sh");
    vec_push(v, "curl | bash");
    vec_push(v, "wget | sh");
    vec_push(v, "wget | bash");
    vec_push(v, "fetch(");
    vec_push(v, "axios.");
    vec_push(v, "http.request(");
    vec_push(v, "https.request(");
    vec_push(v, "dns.resolve");
    vec_push(v, "dns.lookup");
    vec_push(v, "nslookup");
    vec_push(v, "dig ");
    vec_push(v, "mkfifo");
    vec_push(v, "/dev/tcp/");
    vec_push(v, "nc -e");
    vec_push(v, "ncat -e");
    vec_push(v, "socat exec:");
    vec_push(v, "bash -i >& /dev/tcp");
    vec_push(v, "nc ");
    vec_push(v, "ncat ");
    vec_push(v, "socat ");
    vec_push(v, "telnet ");
    vec_push(v, "nmap ");
    vec_push(v, "sudo ");
    vec_push(v, "su -");
    vec_push(v, "su root");
    vec_push(v, "chmod ");
    vec_push(v, "chown ");
    vec_push(v, "chgrp ");
    vec_push(v, "setuid");
    vec_push(v, "setgid");
    vec_push(v, "insmod ");
    vec_push(v, "modprobe ");
    vec_push(v, "rmmod ");
    vec_push(v, "mount ");
    vec_push(v, "umount ");
    vec_push(v, "mount(");
    vec_push(v, "setcap ");
    vec_push(v, "getcap ");
    vec_push(v, "capsh ");
    vec_push(v, "npm install");
    vec_push(v, "pip install");
    vec_push(v, "gem install");
    vec_push(v, "cargo install");
    vec_push(v, "go install");
    vec_push(v, "apt install");
    vec_push(v, "apt-get install");
    vec_push(v, "yum install");
    vec_push(v, "dnf install");
    vec_push(v, "pacman -s");
    vec_push(v, "wget -o - |");
    vec_push(v, "curl -ssl |");
    vec_push(v, "require(");
    vec_push(v, "import(");
    vec_push(v, "__import__(");
    vec_push(v, "atob(");
    vec_push(v, "base64 -d");
    vec_push(v, "base64 --decode");
    vec_push(v, "b64decode");
    vec_push(v, "\\u00");
    vec_push(v, "\\x00");
    vec_push(v, "string.fromcharcode");
    vec_push(v, "\\x");
    vec_push(v, "fromhex(");
    vec_push(v, "hex.decode");
    vec_push(v, "/etc/shadow");
    vec_push(v, "/etc/passwd");
    vec_push(v, "/etc/sudoers");
    vec_push(v, "/.ssh/");
    vec_push(v, "/.gnupg/");
    vec_push(v, "/.aws/");
    vec_push(v, "/.kube/");
    vec_push(v, "/dev/mem");
    vec_push(v, "/dev/kmem");
    vec_push(v, "/proc/kcore");
    vec_push(v, "../");
    vec_push(v, "..\\");
    vec_push(v, "rm -rf");
    vec_push(v, "dd if=");
    vec_push(v, "mkfs.");
    vec_push(v, "shred ");
    vec_push(v, "md5(");
    vec_push(v, "sha1(");
    vec_push(v, "aes_key =");
    vec_push(v, "encryption_key =");
    vec_push(v, "secret_key =");
    _cg_pats_cache = v;
    return v;
}

fn _cg_automaton() {
    if (_cg_ac == 0) { _cg_ac = ac_build(_cg_master_patterns()); }
    return _cg_ac;
}

# 1 if `lit` occurs in the current scan's lowered text, else 0. O(patterns)
# lookup over the AC hit table; falls back to a direct substring scan if `lit`
# isn't in the master set (correctness over speed).
fn _cg_hit(hits, lower, lit) {
    var pats = _cg_master_patterns();
    var np = vec_len(pats);
    var i = 0;
    while (i < np) {
        if (streq(vec_get(pats, i), lit) == 1) {
            if (load64(hits + i * 8) >= 0) { return 1; }
            return 0;
        }
        i = i + 1;
    }
    return cstr_contains(lower, lit);
}

# ---- pattern groups -------------------------------------------------------
# Each returns 1 if any pattern matched (one finding emitted per group).

fn _cg_shell_exec(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "exec(") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Shell exec", "exec(");
    }
    if (_cg_hit(hits, lower, "execsync(") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Shell exec", "execsync(");
    }
    if (_cg_hit(hits, lower, "child_process") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Shell exec", "child_process");
    }
    return 0;
}

fn _cg_process_spawn(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "spawn(") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Process spawn", "spawn(");
    }
    if (_cg_hit(hits, lower, "spawnsync(") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Process spawn", "spawnsync(");
    }
    return 0;
}

fn _cg_eval_exec(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "eval(") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Eval execution", "eval(");
    }
    if (_cg_hit(hits, lower, "function(") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Eval execution", "function(");
    }
    return 0;
}

fn _cg_shell_invoc(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "/bin/sh") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell invocation", "/bin/sh");
    }
    if (_cg_hit(hits, lower, "/bin/bash") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell invocation", "/bin/bash");
    }
    if (_cg_hit(hits, lower, "/bin/zsh") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell invocation", "/bin/zsh");
    }
    if (_cg_hit(hits, lower, "cmd.exe") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell invocation", "cmd.exe");
    }
    if (_cg_hit(hits, lower, "powershell") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell invocation", "powershell");
    }
    return 0;
}

fn _cg_shell_meta(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "$(") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "$(");
    }
    if (_cg_hit(hits, lower, "${") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "${");
    }
    if (_cg_hit(hits, lower, "| sh") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "| sh");
    }
    if (_cg_hit(hits, lower, "| bash") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "| bash");
    }
    if (_cg_hit(hits, lower, "; sh") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "; sh");
    }
    if (_cg_hit(hits, lower, "; bash") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "; bash");
    }
    if (_cg_hit(hits, lower, "/dev/tcp") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "/dev/tcp");
    }
    if (_cg_hit(hits, lower, "<(") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", "<(");
    }
    if (_cg_hit(hits, lower, ">(") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "command_injection", "Shell metacharacters", ">(");
    }
    return 0;
}

fn _cg_pipe_shell(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "curl | sh") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Pipe to shell", "curl | sh");
    }
    if (_cg_hit(hits, lower, "curl | bash") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Pipe to shell", "curl | bash");
    }
    if (_cg_hit(hits, lower, "wget | sh") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Pipe to shell", "wget | sh");
    }
    if (_cg_hit(hits, lower, "wget | bash") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "command_injection", "Pipe to shell", "wget | bash");
    }
    return 0;
}

fn _cg_http_req(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "fetch(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "data_exfiltration", "HTTP request", "fetch(");
    }
    if (_cg_hit(hits, lower, "axios.") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "data_exfiltration", "HTTP request", "axios.");
    }
    if (_cg_hit(hits, lower, "http.request(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "data_exfiltration", "HTTP request", "http.request(");
    }
    if (_cg_hit(hits, lower, "https.request(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "data_exfiltration", "HTTP request", "https.request(");
    }
    return 0;
}

fn _cg_dns_exfil(text, lower, result, hits) {
    if (_cg_hit(hits, lower, "dns.resolve") == 1) {
