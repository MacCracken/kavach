# kavach — SandboxPolicy
# Ported from rust-old/src/policy/mod.rs
#
# No floats in Cyrius core — cpu_limit stored as tenths (10 = 1.0 core).

#derive(accessors)
struct SandboxPolicy {
    seccomp_enabled;
    seccomp_profile;
    landlock_rules_len;
    network_enabled;
    network_tcp_bind_len;
    network_tcp_connect_len;
    read_only_rootfs;
    memory_limit_mb;
    cpu_limit_tenths;
    max_pids;
    landlock_abstract_unix;
    landlock_signal;
    landlock_rules;
    attest_measurements;
    attest_root;
    attest_root_len;
    attest_allow_debug;
}

# 104 (3.11.3): `landlock_rules` is appended, so no existing field offset moves
# and a consumer holding a policy built by an older release keeps working.
# 136 (3.13.0): the four attestation fields are appended the same way.
var SANDBOX_POLICY_SIZE = 136;

fn policy_new() {
    var p = alloc(SANDBOX_POLICY_SIZE);
    var i = 0;
    while (i < SANDBOX_POLICY_SIZE) {
        store64(p + i, 0);
        i = i + 8;
    }
    return p;
}

fn policy_minimal() {
    return policy_new();
}

fn policy_basic() {
    var p = policy_new();
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, "basic");
    return p;
}

fn policy_strict() {
    var p = policy_new();
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_seccomp_profile(p, "strict");
    SandboxPolicy_set_read_only_rootfs(p, 1);
    SandboxPolicy_set_memory_limit_mb(p, 512);
    SandboxPolicy_set_cpu_limit_tenths(p, 10);
    SandboxPolicy_set_max_pids(p, 64);
    SandboxPolicy_set_landlock_abstract_unix(p, 1);
    SandboxPolicy_set_landlock_signal(p, 1);
    return p;
}

# Allow the payload access to `path`, and to everything beneath it.
#
# A `path` that is a file, not a directory, allows that file alone, with the
# rights a file can hold: read and execute for `FS_READ_ONLY`, and write and
# truncate as well for `FS_READ_WRITE`. Creating, removing or renaming it takes
# a rule on its directory. Through 3.13.0 a rule naming a file failed every
# exec closed (exit 124): it was given directory rights, which landlock refuses
# on a file.
#
# **Before 3.11.3 there was no way to say this.** `landlock_rules_len` was a
# bare counter with no list behind it, and `confine_child` called
# `security_apply_landlock(0, 0)` — so a consumer could not express a rule, both
# shipped presets carried a count of 0, and landlock was applied by nothing.
# The machinery underneath was complete: `security_apply_landlock` walks a vec
# of `security_fs_rule` and has since 3.11.1 handled all thirteen ABI v1 rights.
# Only the path from a policy to that vec was missing.
#
# `access` is `FS_READ_ONLY` or `FS_READ_WRITE`. The counter is kept in step
# with the list so `score_backend`, which reads the count, keeps describing
# what is actually configured.
#
# **Landlock is allow-list only.** A policy with one rule permits that subtree
# and denies every other path; a policy with no rules gets no landlock ruleset
# at all, which is not the same thing — see `policy_landlock_deny_all`.
#
# Refused (-1) on a deny-all policy, which stays deny-all: the rule would give
# back a path that policy has taken away. Through 3.13.0 the rule was added and
# the policy stopped being deny-all.
fn policy_landlock_add(p, path, access) {
    if (p == 0) { return 0 - 1; }
    if (policy_landlock_is_deny_all(p) == 1) { return 0 - 1; }
    var rules = SandboxPolicy_landlock_rules(p);
    if (rules == 0) {
        rules = vec_new();
        SandboxPolicy_set_landlock_rules(p, rules);
    }
    vec_push(rules, security_fs_rule_new(path, access));
    SandboxPolicy_set_landlock_rules_len(p, vec_len(rules));
    return 0;
}

# Deny the payload every filesystem path.
#
# The policy's ruleset names no path, so it permits nothing. Rules the policy
# named before are dropped, and `policy_landlock_add` refuses one afterwards, so
# the call means the same in either order, and the same as a deny-all side in
# `merge_policies`. Through 3.13.0 the rules were kept and the child applied
# them: a policy that named a path and was then made deny-all still permitted
# that path, and denied everything only once merged.
#
# ⚠ **Every path includes the payload's own executable.** Landlock goes on in
# the child before `execve`, and the exec opens the binary, so a deny-all
# payload never starts: the exec fails with EACCES and the child exits 127
# (measured through `sandbox_exec` and a persistent guest; `sandbox_spawn`
# execs the same way). Descriptors the child already holds stay usable, which
# helps only code that goes on in the child without an exec. A payload that has
# to start needs `policy_landlock_add` instead, naming its binary and, if it is
# dynamically linked, its loader and libraries; every other path is then denied
# already.
#
# Written as an empty list and a count of one. The count is what makes the
# child install a ruleset, and a count above the list is how every reader
# recognises deny-all (`policy_landlock_is_deny_all`). Distinct from naming no
# rule at all, which installs no ruleset and restricts nothing.
fn policy_landlock_deny_all(p) {
    if (p == 0) { return 0 - 1; }
    # A fresh list rather than the old one emptied: a caller holding the old
    # list, or another policy sharing it, keeps its rules.
    SandboxPolicy_set_landlock_rules(p, vec_new());
    SandboxPolicy_set_landlock_rules_len(p, 1);
    return 0;
}

# The rule list a policy carries, or 0 when it names none.
fn policy_landlock_rules(p) {
    if (p == 0) { return 0; }
    return SandboxPolicy_landlock_rules(p);
}

# Whether `p` denies the payload every path: its count asks for more rules than
# its list holds. `policy_landlock_deny_all` writes an empty list and a count of
# one; a count with no list reads the same, and so does any count set above the
# list through the raw accessor. The child's landlock step
# (`_spawn_apply_landlock`), `merge_policies` and `policy_landlock_add` all ask
# this, so a policy means the same thing wherever it is used.
fn policy_landlock_is_deny_all(p) {
    if (p == 0) { return 0; }
    var rules = SandboxPolicy_landlock_rules(p);
    var have = 0;
    if (rules != 0) { have = vec_len(rules); }
    if (SandboxPolicy_landlock_rules_len(p) > have) { return 1; }
    return 0;
}

# Whether this policy asks for any child-side confinement.
#
# The routing predicate for `process_exec`: a policy answering 1 must not reach
# a plain `exec_capture`, because that path has no seam between `fork` and
# `execve` in which to install a filter. Answering on the policy rather than on
# the rootfs is the whole of the 3.11.3 fix.
fn policy_wants_confinement(p) {
    if (p == 0) { return 0; }
    if (SandboxPolicy_seccomp_enabled(p) == 1) { return 1; }
    if (SandboxPolicy_landlock_rules_len(p) > 0) { return 1; }
    return 0;
}

# Allow a TEE guest whose measurement is `hex`: its MRENCLAVE (64 hex digits)
# for SGX, its MRTD (96) for TDX. Upper-case digits are folded to lower case.
# Returns 0, or -1 for anything that is not 64 or 96 hex digits.
#
# One entry makes the policy require attestation. `sandbox_exec` then runs the
# command only on a backend that can attest (SGX, TDX), and releases its output
# only if the guest's quote verifies to the policy's root, carries the exec's
# nonce and names an allowed measurement (`kavach_attest_quote`). Every other
# path that runs a payload under a policy refuses one that requires attestation:
# a local process has no quote to check.
fn policy_attest_allow(p, hex) {
    if (p == 0 || hex == 0) { return 0 - 1; }
    var n = strlen(hex);
    if (n != 64 && n != 96) { return 0 - 1; }
    var m = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var c = load8(hex + i);
        if (c >= 65 && c <= 70) { c = c + 32; }
        # Digits compared inline: `is_digit_c` lives in scanning_secrets.cyr,
        # which the `[lib.confine]` bundle does not carry.
        if ((c < 48 || c > 57) && (c < 97 || c > 102)) { return 0 - 1; }
        store8(m + i, c);
        i = i + 1;
    }
    store8(m + n, 0);
    var list = SandboxPolicy_attest_measurements(p);
    if (list == 0) {
        list = vec_new();
        SandboxPolicy_set_attest_measurements(p, list);
    }
    vec_push(list, m);
    return 0;
}

# The root a guest's quote must chain to, as DER: Intel's SGX root CA, which TDX
# quotes also chain to. The bytes are copied. kavach ships no root, so a policy
# that allows measurements and names no root fails every attestation.
fn policy_attest_root(p, der, len) {
    if (p == 0 || der == 0 || len <= 0) { return 0 - 1; }
    var copy = alloc(len);
    memcpy(copy, der, len);
    SandboxPolicy_set_attest_root(p, copy);
    SandboxPolicy_set_attest_root_len(p, len);
    return 0;
}

# Accept a debug enclave or debug TD. The host can read and write a debug
# guest's memory, so its measurement does not establish what ran; a debug guest
# that passes every other check is reported at `KAVACH_TRUST_WARNING`, not
# `KAVACH_TRUST_AFFIRMING`. Off by default.
fn policy_attest_allow_debug(p, on) {
    if (p == 0) { return 0 - 1; }
    SandboxPolicy_set_attest_allow_debug(p, on);
    return 0;
}

# Whether this policy requires attestation: it allows at least one measurement.
fn policy_wants_attestation(p) {
    if (p == 0) { return 0; }
    var list = SandboxPolicy_attest_measurements(p);
    if (list == 0) { return 0; }
    if (vec_len(list) > 0) { return 1; }
    return 0;
}

# Case-insensitive preset lookup. Returns 0 on unknown name.
fn policy_from_preset(name) {
    if (strieq(name, "minimal") == 1) { return policy_minimal(); }
    if (strieq(name, "basic") == 1) { return policy_basic(); }
    if (strieq(name, "strict") == 1) { return policy_strict(); }
    return 0;
}
