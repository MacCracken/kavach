# kavach — persistent guest execution (live stdin / stdout)
#
# The one-shot PROCESS backend (backend_process.cyr) runs a guest to completion
# and captures its stdout. This module adds a PERSISTENT guest: fork+exec the
# command with a live stdin pipe (the parent writes) and a stdout pipe (the
# parent reads), so a host can STREAM input to a running guest and read its
# output over time. This is the execution primitive the swallow stage's M3
# protocol shim delivers events over (mehman → aethersafha).
#
# SECURITY: the same pre-exec command safety the one-shot path enforces applies
# here — `is_safe_argument` (reject control chars) + `check_command` (runtime
# guard) before the fork. What does NOT apply is the externalization gate: it
# scans a full captured output buffer, which is meaningless for an open-ended
# stream, so a persistent guest's stdout is NOT gate-scanned. Persistent
# execution is for trusted-shape guests behind the swallow capability contract;
# raw streaming is the deliberate trade for interactivity.
#
# LIMITATIONS: (1) writing to a guest that already exited on its own raises
# SIGPIPE (no SIG_IGN wrapper in the stdlib yet). `persistent_send` guards on the
# `alive` flag, so write-after-terminate is safe; stop sending once the guest is
# known dead. (2) `persistent_read` is blocking (a non-blocking variant via
# O_NONBLOCK/pipe2 is the follow-on for a compositor frame loop).

# Fields (all i64):
#   pid        — the child pid
#   stdin_fd   — parent's write end of the guest's stdin
#   stdout_fd  — parent's read end of the guest's stdout
#   alive      — 1 = running, 0 = terminated + reaped
#derive(accessors)
struct PersistentGuest {
    pid;
    stdin_fd;
    stdout_fd;
    alive;
}
var PERSISTENT_GUEST_SIZE = 32;

# Spawn `command` as a persistent guest with live stdin/stdout pipes. Runs the
# pre-exec safety checks, then fork + dup2 + execve (mirrors backend_process's
# argv build + the exec_capture pipe pattern, with a second pipe for stdin).
# -> PersistentGuest* (0 on an unsafe/blocked command, empty split, or fork/OOM).
# Spawn a persistent guest **inside a policy's confinement**.
#
# `persistent_spawn` — which this wraps — applies nothing: it is not associated
# with a `Sandbox`, takes no policy, and `kv_execve`s the payload with the
# caller's full ambient authority. That was invisible at the call site, and it
# is the only kavach API offering a stdin channel, so it is what a consumer
# needing one reaches for. agnosai measured the consequence against 3.11.2: a
# `cxvm` guest spawned this way opened `/etc/passwd`.
#
# **`persistent_spawn` keeps its signature and its behaviour** — callers who
# genuinely want an unconfined child still have it, now by naming it rather
# than by default. Its doc says so.
#
# Returns 0 if the command is refused, the fork fails, or the policy asks for
# confinement that could not be applied.
fn persistent_spawn_confined(command, policy) {
    return persistent_spawn_confined_ns(command, policy, 0);
}

# Spawn a persistent guest with the policy's confinement **and its namespaces**.
#
# `require_ns` is the same opt-in, fail-closed shape `config_require_namespaces`
# gave `process_exec` in 3.11.5 — expressed as a parameter here because the
# persistent path takes no `SandboxConfig` to carry a flag on.
#
# **Why it is opt-in.** A network namespace needs a new *user* namespace when
# unprivileged, and Ubuntu 24.04 restricts those outright; making it
# unconditional would turn guests that ran into guests that do not run at all.
# **Why it fails closed.** A caller asking for network isolation and silently
# not getting it is the failure mode this whole line of releases exists to
# remove — the guest exits `SPAWN_EXIT_NS` (123) or `SPAWN_EXIT_IDMAP` (118)
# rather than running with a network its policy said it would not have.
#
# The namespaces come from the policy, so `network_enabled = 0` — the default —
# is what asks for network isolation. Until 3.11.6 that field reached this path
# and nothing acted on it.
fn persistent_spawn_confined_ns(command, policy, require_ns) {
    if (policy == 0) { return persistent_spawn(command); }
    if (policy_wants_confinement(policy) == 0 && require_ns == 0) {
        return persistent_spawn(command);
    }

    var sec = 0;
    if (SandboxPolicy_seccomp_enabled(policy) == 1) {
        var sres = security_create_exec_seccomp_filter();
        # Fail closed: a policy that asked for seccomp and did not get a filter
        # must not fall through to an unconfined spawn.
        if (is_ok(sres) == 0) { return 0; }
        sec = result_unwrap(sres);
    }
    # Read in the PARENT: inside a new user namespace `getuid` reports the
    # mapped id, not the one the map must be written against.
    return _persistent_spawn_inner(command, policy, sec, require_ns, sys_getuid(), kv_getgid());
}

# Spawn a persistent guest with **no confinement**.
#
# Applies no seccomp, no landlock and no namespaces, whatever policy the caller
# may hold elsewhere — it takes none. For a payload that is not trusted, use
# `persistent_spawn_confined`.
fn persistent_spawn(command) {
    return _persistent_spawn_inner(command, 0, 0, 0, 0, 0);
}

fn _persistent_spawn_inner(command, policy, seccomp_info, want_ns, uid, gid) {
    # ⛔ LINUX ONLY — forks a child and installs `prctl`/namespaces/landlock/
    # seccomp on it. agnos has no fork by design and its sandboxing goes through
    # backend_sy_agnos.
    # ⚠ 0, the same "could not spawn" the guards below return: a caller must not
    # receive a guest handle for a child that does not exist.
    #
    # The body is **excluded** from the agnos build rather than merely
    # unreachable on it. `SYS_PRCTL` is not in the agnos syscall enum, and an
    # undefined symbol is a hard error whether or not the line can execute —
    # which, because `cyrius build` auto-prepends every `[deps.*]` module, fails
    # any `--agnos` consumer that declares `[deps.kavach]` at all. The namespace
    # work in 3.11.6 is what introduced the reference.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (is_safe_argument(command) == 0) { return 0; }
    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) { return 0; }
    var args = _split_command(command);
    var argc = vec_len(args);
    if (argc == 0) { return 0; }

    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) { store64(argv + i * 8, vec_get(args, i)); i = i + 1; }
    store64(argv + argc * 8, 0);
    var envp = alloc(8);
    store64(envp, 0);

    # stdin pipe: parent writes in_wfd -> child reads in_rfd (its fd 0)
    var inpipe[16];
    sys_pipe(&inpipe);
    var in_rfd = load32(&inpipe);
    var in_wfd = load32(&inpipe + 4);
    # stdout pipe: child writes out_wfd (its fd 1) -> parent reads out_rfd
    var outpipe[16];
    sys_pipe(&outpipe);
    var out_rfd = load32(&outpipe);
    var out_wfd = load32(&outpipe + 4);

    var pid = kv_fork();
    if (pid < 0) {
        sys_close(in_rfd); sys_close(in_wfd);
        sys_close(out_rfd); sys_close(out_wfd);
        return 0;
    }
    if (pid == 0) {
        # child: wire the pipe ends to stdin/stdout, /dev/null to stderr
        sys_close(in_wfd);
        sys_close(out_rfd);
        kv_dup2(in_rfd, 0);
        sys_close(in_rfd);
        kv_dup2(out_wfd, 1);
        sys_close(out_wfd);
        var devnull = sys_open("/dev/null", 1, 0);   # 1 = O_WRONLY (mirrors exec_capture)
        if (devnull >= 0) { kv_dup2(devnull, 2); sys_close(devnull); }
        # The seam. Namespaces, then landlock, then seccomp — installed HERE,
        # after the pipes are wired and before `execve`. The pipes come first
        # because none of these three affect descriptors that were already open,
        # which is what lets a confined guest still read its stdin; and all three
        # come before `execve` because a filter installed after it is too late by
        # definition.
        if (want_ns != 0 && policy != 0) {
            if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }
            var nsf = _spawn_ns_flags(policy, 0);
            if (nsf != 0) {
                if (is_ok(security_create_namespace(nsf)) == 0) { sys_exit(SPAWN_EXIT_NS); }
                if ((nsf & NS_USER) != 0) {
                    # Its own code: creating the namespace and mapping ids into
                    # it are different privileges that fail on different hosts.
                    if (_spawn_write_idmaps(uid, gid) != 0) { sys_exit(SPAWN_EXIT_IDMAP); }
                }
            }
        }
        if (policy != 0) {
            if (SandboxPolicy_landlock_rules_len(policy) > 0) {
                var _pl = SandboxPolicy_landlock_rules(policy);
                if (_pl == 0) { _pl = vec_new(); }
                if (is_ok(security_apply_landlock(_pl,
                SandboxPolicy_landlock_rules_len(policy))) == 0) {
                    sys_exit(SPAWN_EXIT_LANDLOCK);
                }
            }
        }
        if (seccomp_info != 0) {
            if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }
            if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(seccomp_info),
            security_seccomp_filter_len(seccomp_info))) == 0) {
                sys_exit(SPAWN_EXIT_SECCOMP);
            }
        }
        kv_execve(vec_get(args, 0), argv, envp);
        sys_exit(127);
    }
    # parent: keep the write-stdin + read-stdout ends
    sys_close(in_rfd);
    sys_close(out_wfd);
    var g = alloc(PERSISTENT_GUEST_SIZE);
    if (g == 0) { sys_close(in_wfd); sys_close(out_rfd); return 0; }
    PersistentGuest_set_pid(g, pid);
    PersistentGuest_set_stdin_fd(g, in_wfd);
    PersistentGuest_set_stdout_fd(g, out_rfd);
    PersistentGuest_set_alive(g, 1);
    return g;
    #endif
}

# Write `len` bytes to the guest's stdin. -> bytes written, or -1 if the guest is
# null / already terminated.
fn persistent_send(g, bytes, len): i64 {
    if (g == 0) { return 0 - 1; }
    if (PersistentGuest_alive(g) == 0) { return 0 - 1; }
    return sys_write(PersistentGuest_stdin_fd(g), bytes, len);
}

# Read up to `len` bytes of the guest's stdout into `buf` (blocking). -> bytes
# read (0 at EOF), or -1 for a null / terminated guest.
fn persistent_read(g, buf, len): i64 {
    if (g == 0) { return 0 - 1; }
    if (PersistentGuest_alive(g) == 0) { return 0 - 1; }
    return sys_read(PersistentGuest_stdout_fd(g), buf, len);
}

fn persistent_pid(g): i64   { if (g == 0) { return 0 - 1; } return PersistentGuest_pid(g); }
fn persistent_alive(g): i64 { if (g == 0) { return 0; } return PersistentGuest_alive(g); }

# Terminate + reap the guest: close its stdin (EOF), SIGKILL, waitpid (no zombie),
# close its stdout. Idempotent. -> 0 (or -1 for a null guest).
fn persistent_terminate(g): i64 {
    if (g == 0) { return 0 - 1; }
    if (PersistentGuest_alive(g) == 1) {
        sys_close(PersistentGuest_stdin_fd(g));
        sys_kill(PersistentGuest_pid(g), 9);   # 9 = SIGKILL (guaranteed reap)
        var stbuf[1];
        kv_waitpid(PersistentGuest_pid(g), &stbuf, 0);
        sys_close(PersistentGuest_stdout_fd(g));
        PersistentGuest_set_alive(g, 0);
    }
    return 0;
}
