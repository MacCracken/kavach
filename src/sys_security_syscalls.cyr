# sys_security_syscalls.cyr — the syscall numbers kavach still spells itself,
# because the cyrius stdlib does not name them yet: unshare(2) and chroot(2).
#
# **x86-64 only, and compiled only there.** cyrius spells syscall numbers in
# x86-64 terms, and its aarch64 backend renumbers the ones it knows at each
# syscall() site. It does not know these two, so aarch64 would run them as
# other calls: 272 is kcmp, 161 is sethostname. The enum sits inside
# `#ifdef CYRIUS_ARCH_X86`, so an aarch64 use is a compile error ("undefined
# variable") rather than a different syscall. The aarch64 callers refuse
# instead: security_create_namespace and _spawn_enter_rootfs. Both constants go
# when the stdlib declares SYS_UNSHARE and SYS_CHROOT (filed upstream at
# 3.12.8).
#
# ⚠ AGNOS — both numbers are outside agnos's 0-62 syscall table. Every use sits
# inside `#ifndef CYRIUS_TARGET_AGNOS`, and the agnos branch returns
# kavach_err_not_supported: confinement on agnos is the capability layer's job.
#
# Until 3.12.8 this file also held the socket family (41/49/44/45), which
# kernel_audit.cyr now reaches through the stdlib's sys_socket / sys_bind /
# sys_sendto / sys_recvfrom, an unused pivot_root (155), and a second copy of
# kernel_audit.cyr's SYS_AGNOS_AUDIT_LOG.
#ifdef CYRIUS_ARCH_X86
enum SecuritySyscall {
    SYS_UNSHARE = 272;          # x86-64 unshare
    SYS_CHROOT_NR = 161;        # x86-64 chroot
}
#endif
