# kavach — WASM (wasmtime) backend
# Ported from rust-old/src/backend/wasm/mod.rs
#
# The Rust version embedded wasmtime via Cargo crates. Cyrius v3.0 shells
# out to the `wasmtime` CLI binary instead, which accepts the same
# --fuel / --dir / --env / --max-memory-size flags. Module format is still
# `command = path to .wasm file`.
#
# Deferred: WAT inline modules, custom linker hooks. Both require embedding
# a real WASM runtime — v3.0 or whenever mabda/yukti exposes one.

# The guest memory ceiling applied when the policy names none, in MiB.
#
# ⚠ **A sandbox must not default to UNBOUNDED.** `policy_basic()` — what
# `config_new()` installs — sets seccomp and leaves `memory_limit_mb` at 0, and
# `_wasm_append_limits` used to emit `-W max-memory-size` only when that was
# > 0. So every caller on the default policy ran its guest with no ceiling at
# all: verified against wasmtime 47 with a module declaring **128 MiB**, which
# instantiates fine bare and is refused under a 64 MiB ceiling. wasm32 caps a
# guest at 4 GiB, so "no ceiling" means a hostile module can claim that much.
#
# 64 MiB is the value Rust's own `WasmSandbox` defaults to
# (`DEFAULT_MAX_MEMORY_BYTES`, agnosai's oracle at
# `rust-old/src/sandbox/wasm.rs:19`), so this matches the embedding host rather
# than inventing a number. A caller wanting more sets
# `SandboxPolicy_set_memory_limit_mb`; `policy_strict()` already sets 512.
var WASM_DEFAULT_MEMORY_LIMIT_MB = 64;

# The ceiling actually applied: the policy's, or the default when it names none.
fn _wasm_effective_memory_mb(policy) {
    var mem = SandboxPolicy_memory_limit_mb(policy);
    if (mem > 0) { return mem; }
    return WASM_DEFAULT_MEMORY_LIMIT_MB;
}

# Fuel calibration from timeout_ms. Matches Rust:
#   fuel ≈ timeout_ms * 1_000_000 (≈ 1B instr/sec assumption)
#
# ⚠ This is the FALLBACK, used only when `config_fuel` was not set. It derives a
# CPU budget from a wall-clock one, which is a guess — see `config_fuel`.
fn _wasm_fuel_from_timeout(timeout_ms) {
    return timeout_ms * 1000000;
}

# The effective fuel: an explicitly configured budget, or the timeout-derived
# fallback when none was set.
fn _wasm_effective_fuel(cfg, timeout_ms) {
    var explicit = SandboxConfig_fuel(cfg);
    if (explicit > 0) { return explicit; }
    return _wasm_fuel_from_timeout(timeout_ms);
}

# Whether `policy` asks for landlock: a rule, or deny-all. On this backend that
# makes the policy the guest's whole filesystem grant, and confines wasmtime.
fn _wasm_policy_has_landlock(policy) {
    if (policy == 0) { return 0; }
    if (SandboxPolicy_landlock_rules_len(policy) > 0) { return 1; }
    return 0;
}

# Append `--dir <path>`, or return -1 for a path `--dir` would misread:
# wasmtime splits its value at `::` into a host and a guest path, so
# `/srv/a::/etc` preopens the host's `/srv/a`, and names it `/etc`.
fn _wasm_push_dir(args, path) {
    if (cstr_contains(path, "::") == 1) { return 0 - 1; }
    vec_push(args, "--dir");
    vec_push(args, path);
    return 0;
}

# Whether `path` names something that exists and is not a directory, following
# a symlink as `--dir` and landlock do. 0 on agnos, where this backend cannot
# run a guest.
fn _wasm_names_a_file(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = file_open(path, 0x200000 | O_CLOEXEC, 0);    # O_PATH; the stdlib names none
    if (fd < 0) { return 0; }
    # SAFETY: `st` is 144 bytes, no smaller than struct stat on x86-64 (144) or
    # aarch64 (128), and STAT_MODE is the stdlib's per-arch offset of the 32-bit
    # st_mode inside it.
    var st[144];
    var r = sys_fstat(fd, &st);
    sys_close(fd);
    if (r < 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 61440) == 16384) { return 0; }   # S_IFDIR
    return 1;
    #endif
}

# The directories the guest may reach, as `--dir` preopens. Returns 0, or -1
# for a path `--dir` cannot express.
#
# **A policy with landlock is the whole grant**, as it is for a process: each
# rule the child would apply (the first `landlock_rules_len`) is preopened at
# its own path, and nothing else is, the workdir included. A deny-all policy
# preopens nothing. `--dir` is read-write, and wasmtime's CLI has no read-only
# form (wasmtime 49 takes `--dir X::/a::ro` and ignores the `::ro`), so an
# `FS_READ_ONLY` rule is held read-only by landlock on the wasmtime process
# (`_wasm_host_policy`).
#
# A rule naming a file gets no preopen, so the guest cannot reach that file.
# `--dir` takes only a directory (wasmtime refuses a file: "Not a directory"),
# and preopening the file's directory would hand the guest its siblings as
# well. A path that does not exist is passed on, and fails the exec closed.
#
# With no landlock the workdir, if set, is preopened, as before. That preopen
# is read-write: the comment here called it read-only through 3.13.0, and a
# guest could create files in it.
#
# Through 3.13.0 this read no rule. Its comment said the policy carried only a
# count, which stopped being so at 3.11.3. A deny-all policy's guest got the
# workdir, and a policy naming paths gave its guest the workdir and not them.
fn _wasm_append_preopens(args, sandbox) {
    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);
    if (_wasm_policy_has_landlock(policy) == 1) {
        if (policy_landlock_is_deny_all(policy) == 1) { return 0; }
        var rules = policy_landlock_rules(policy);
        var n = SandboxPolicy_landlock_rules_len(policy);
        var i = 0;
        while (i < n) {
            var path = security_fs_rule_path(vec_get(rules, i));
            if (_wasm_names_a_file(path) == 0) {
                if (_wasm_push_dir(args, path) != 0) { return 0 - 1; }
            }
            i = i + 1;
        }
        return 0;
    }
    var wd = SandboxConfig_workdir(cfg);
    if (wd != 0) {
        if (strlen(wd) > 0) { return _wasm_push_dir(args, wd); }
    }
    return 0;
}

# The landlock ruleset for the wasmtime process, when the policy asks for
# landlock. The guest reaches only its preopens either way; this ruleset is what
# makes an `FS_READ_ONLY` rule read-only inside its preopen, since `--dir`
# cannot, and it holds wasmtime itself to these paths.
#
# The policy's applied rules, with their access, and read-only access to what
# wasmtime needs to start and load the module: its binary, `/usr`, `/lib` and
# `/lib64` where they exist, and the module. A deny-all policy contributes no
# rule, so only wasmtime's own paths remain, and the guest has no preopen to
# reach them. The binary and the module are files, each granted alone: until a
# rule naming a file could be applied, this named their directories.
fn _wasm_host_policy(policy, wasmtime, module) {
    var host = policy_new();
    # The policy's landlock scopes (3.13.2) hold wasmtime too.
    SandboxPolicy_set_landlock_abstract_unix(host, SandboxPolicy_landlock_abstract_unix(policy));
    SandboxPolicy_set_landlock_signal(host, SandboxPolicy_landlock_signal(policy));
    policy_landlock_add(host, wasmtime, FS_READ_ONLY);
    policy_landlock_add(host, "/usr", FS_READ_ONLY);
    if (kavach_path_exists("/lib") == 1) { policy_landlock_add(host, "/lib", FS_READ_ONLY); }
    if (kavach_path_exists("/lib64") == 1) { policy_landlock_add(host, "/lib64", FS_READ_ONLY); }
    policy_landlock_add(host, module, FS_READ_ONLY);
    if (policy_landlock_is_deny_all(policy) == 1) { return host; }
    var rules = policy_landlock_rules(policy);
    var n = SandboxPolicy_landlock_rules_len(policy);
    var i = 0;
    while (i < n) {
        var r = vec_get(rules, i);
        policy_landlock_add(host, security_fs_rule_path(r), security_fs_rule_access(r));
        i = i + 1;
    }
    return host;
}

# The seccomp filter wasmtime runs under: kavach's exec filter when the policy
# enables seccomp, as a process payload gets it; 0 when it does not; -1 when
# the filter cannot be built, which fails the exec closed.
#
# Through 3.13.1 the WASM backend applied no filter, while `score_backend` added
# 5 for `seccomp_enabled` on every backend. WASI stays the guest's syscall
# boundary; this holds wasmtime itself to the filter's deny list. Measured
# before it was wired: wasmtime runs under the exec filter, its guest reading a
# preopened directory.
fn _wasm_seccomp_info(policy) {
    if (policy == 0) { return 0; }
    if (SandboxPolicy_seccomp_enabled(policy) != 1) { return 0; }
    var st, sv = security_create_exec_seccomp_filter();
    if (is_ok(st) == 0) { return 0 - 1; }
    return result_unwrap(st, sv);
}

# Append resource-limit flags from policy.
# Build one `-W key=value` argument, NUL-terminated.
#
# ⚠ Both limits must be a SINGLE argv element of the form `-Wkey=value` or the
# pair `-W` `key=value` — wasmtime's option groups do not accept
# `-W key value`. This helper emits the pair form.
fn _wasm_push_w_opt(args, key, value) {
    var buf[64];
    var klen = strlen(key);
    memcpy(&buf, key, klen);
    store8(&buf + klen, 61);
    var vlen = fmt_int_buf(value, &buf + klen + 1);
    var total = klen + 1 + vlen;
    var out = alloc(total + 1);
    memcpy(out, &buf, total);
    store8(out + total, 0);
    vec_push(args, "-W");
    vec_push(args, out);
    return 0;
}

# CPU and memory bounds for the guest.
#
# ⚠ **These moved into wasmtime's `-W` option group and the old spellings are
# now HARD ERRORS.** Until 3.11.10 this emitted `--max-memory-size <bytes>` and
# `--fuel <N>` as top-level `run` flags; wasmtime 47 answers
# `error: unexpected argument '--max-memory-size' found` and runs nothing.
#
# ⚠ **It was never validated.** Nothing in this repo had ever run a real module
# through `wasm_exec` — `test_wasm_exec_without_wasmtime` and
# `test_wasm_exec_missing_file` both fail before argv is assembled, so a wrong
# flag was invisible. `test_wasm_exec_real_module` now runs one end to end and
# is the guard; it fails on the old spellings.
#
# The `-W` group has existed since wasmtime 14, so the pair form is not a
# 47-specific accommodation — it is the spelling that has been correct all along.
fn _wasm_append_limits(args, policy, fuel) {
    # Always emitted — see `WASM_DEFAULT_MEMORY_LIMIT_MB` for why a missing
    # policy limit must not mean "unbounded".
    _wasm_push_w_opt(args, "max-memory-size",
      _wasm_effective_memory_mb(policy) * 1048576);

    if (fuel > 0) {
        _wasm_push_w_opt(args, "fuel", fuel);
    }
    return 0;
}

# Trim leading/trailing ASCII whitespace. Returns allocated cstr.
fn _wasm_trim(s) {
    var n = strlen(s);
    var start = 0;
    while (start < n) {
        var c = load8(s + start);
        if (c != 32) { if (c != 9) { if (c != 10) { if (c != 13) { break; } } } }
        start = start + 1;
    }
    var end = n;
    while (end > start) {
        var c = load8(s + end - 1);
        if (c != 32) { if (c != 9) { if (c != 10) { if (c != 13) { break; } } } }
        end = end - 1;
    }
    var len = end - start;
    var out = alloc(len + 1);
    memcpy(out, s + start, len);
    store8(out + len, 0);
    return out;
}

fn wasm_exec(sandbox, command) {
    var start_ns = mono_now_ns();
    var wasmtime = _wasm_binary_path();
    if (wasmtime == 0) {
        return backend_error_result("wasmtime not found in PATH");
    }

    # The command is expected to be a .wasm file path.
    var wasm_path = _wasm_trim(command);
    if (strlen(wasm_path) == 0) {
        return backend_error_result("WASM backend requires a .wasm file path as the command");
    }
    if (kavach_path_exists(wasm_path) == 0) {
        return backend_error_result("WASM module file not found");
    }

    # Runtime-guard precheck is still useful — a .wasm path containing
    # shell metacharacters (e.g., "/tmp/foo.wasm; cat /etc/shadow") would
    # only be sent as a literal argv element, but the sandbox caller still
    # deserves the warning.
    var guard_cfg = runtime_guard_config_default();
    var violations = check_command(command, guard_cfg);
    if (vec_len(violations) > 0) {
        return backend_guard_result(violations);
    }

    var cfg = Sandbox_config(sandbox);
    var policy = SandboxConfig_policy(cfg);
    var timeout = SandboxConfig_timeout_ms(cfg);

    # A policy with landlock confines wasmtime itself (`_wasm_host_policy`), and
    # one with seccomp runs it under the exec filter (`_wasm_seccomp_info`).
    var confined = _wasm_policy_has_landlock(policy);
    var sec = _wasm_seccomp_info(policy);
    if (sec < 0) {
        return backend_error_result("seccomp requested but the filter could not be built");
    }
    var run_policy = policy;
    if (confined == 1) { run_policy = _wasm_host_policy(policy, wasmtime, wasm_path); }

    var args = vec_new();
    vec_push(args, wasmtime);
    vec_push(args, "run");
    # Confined, wasmtime cannot reach its module cache: it looks up the cache's
    # config under the user's home, and stops with "config file not specified
    # and failed to get the default" (wasmtime 49). So a confined run compiles
    # the module afresh.
    if (confined == 1) {
        vec_push(args, "-C");
        vec_push(args, "cache=n");
    }
    _wasm_append_limits(args, policy, _wasm_effective_fuel(cfg, timeout));
    if (_wasm_append_preopens(args, sandbox) != 0) {
        return backend_error_result("WASM backend cannot preopen a path containing \"::\"");
    }
    # `--` separator guards against .wasm paths starting with '-'.
    vec_push(args, "--");
    vec_push(args, wasm_path);

    var out_cap = 1048576;
    var out_buf = alloc(out_cap);

    # 3.11.8: `confine_capture_input`, not the stdlib's `exec_capture`.
    #
    # ⚠ Three things were wrong with `exec_capture` here, and the process
    # backend had already fixed all three for itself in 3.11.4/3.11.5 — this
    # backend was simply left behind on the old call:
    #
    #   * **the guest's exit code was discarded.** `backend_capture_finish`
    #     stamps 0 on any successful capture, and nothing overrode it, so a
    #     module that TRAPPED reported success with whatever partial stdout it
    #     managed. A consumer branching on `exit_code != 0` — which is the whole
    #     failure taxonomy of a tool protocol — saw every failure as a success.
    #   * **stderr was hard-redirected to /dev/null**, so `ExecResult.stderr`
    #     always read "", which is a different and false claim from "the guest
    #     wrote nothing".
    #   * **there was no stdin**, so a guest could be run but not given
    #     parameters. That is what agnosai filed: a WASM tool that cannot
    #     receive its input is not a tool.
    #
    # `do_confine`: wasmtime's own WASI sandbox is the boundary for the guest:
    # no preopen means no filesystem, and fuel and the memory ceiling bound it.
    # A policy asking for child-side confinement (`policy_wants_confinement`)
    # also confines the wasmtime process: `confine_child` sets NO_NEW_PRIVS,
    # closes inherited descriptors, applies the ruleset (`_wasm_host_policy`'s
    # when the policy has rules, which lets wasmtime read its module; otherwise
    # one of the policy's scopes alone) and loads the exec filter when the
    # policy enables seccomp. No namespaces and no cgroup: those arguments are
    # 0. Through 3.13.0 no policy confined wasmtime, and through 3.13.1 only
    # landlock rules did: seccomp and the scopes were not applied (3.13.2).
    var do_confine = policy_wants_confinement(policy);
    var n = confine_capture_input(args, run_policy, 0, 0, sec, out_buf, out_cap, 0,
      timeout, do_confine, _config_payload_stdin(cfg), _config_payload_stdin_len(cfg));
    var end_ns = mono_now_ns();

    var r = backend_capture_finish(out_buf, n, out_cap, "wasmtime run failed", start_ns, end_ns);
    if (r != 0) {
        ExecResult_set_exit_code(r, confine_last_exit());
        ExecResult_set_timed_out(r, confine_last_timed_out());
        backend_set_capture_stderr(r);
    }
    return r;
}

fn wasm_health(sandbox) {
    if (_wasm_binary_path() == 0) { return 0; }
    return 1;
}

fn wasm_destroy(sandbox) { return 0; }

fn backend_wasm_register() {
    backend_register_exec(KavachBackend.WASM, &wasm_exec);
    backend_register_health(KavachBackend.WASM, &wasm_health);
    backend_register_destroy(KavachBackend.WASM, &wasm_destroy);
    return 0;
}
