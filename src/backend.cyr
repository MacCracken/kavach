# kavach — Backend enum and metadata
# Ported from rust-old/src/backend/mod.rs

enum KavachBackend {
    PROCESS = 0;
    GVISOR = 1;
    FIRECRACKER = 2;
    WASM = 3;
    OCI = 4;
    SGX = 5;
    SEV = 6;
    TDX = 7;
    SY_AGNOS = 8;
    NOOP = 9;
}

var KAVACH_BACKEND_COUNT = 10;

# Renamed from `backend_name` (3.8.2): ai-hwaccel — pulled transitively via
# [deps.samay] since 3.8.0 — defines its own `backend_name(b)` over a DIFFERENT
# enum (BACKEND_CUDA..BACKEND_WINDOWS, 17 hardware-detection backends). Both
# enums start at 0, cycc resolves duplicate fns last-definition-wins, and
# ai-hwaccel sorts after kavach — so the collision silently returned hardware
# names for OS backends (`backend_name(KavachBackend.OCI)` → "intel-npu"). `os_`
# marks this as the OS/isolation-backend namer; ai-hwaccel keeps the bare name.
fn os_backend_name(b) {
    if (b == KavachBackend.PROCESS) { return "process"; }
    if (b == KavachBackend.GVISOR) { return "gvisor"; }
    if (b == KavachBackend.FIRECRACKER) { return "firecracker"; }
    if (b == KavachBackend.WASM) { return "wasm"; }
    if (b == KavachBackend.OCI) { return "oci"; }
    if (b == KavachBackend.SGX) { return "sgx"; }
    if (b == KavachBackend.SEV) { return "sev"; }
    if (b == KavachBackend.TDX) { return "tdx"; }
    if (b == KavachBackend.SY_AGNOS) { return "sy-agnos"; }
    if (b == KavachBackend.NOOP) { return "noop"; }
    return "unknown";
}

# Case-insensitive parse. Returns backend code on success, -1 on unknown.
fn backend_parse(s) {
    if (strieq(s, "process") == 1) { return KavachBackend.PROCESS; }
    if (strieq(s, "gvisor") == 1) { return KavachBackend.GVISOR; }
    if (strieq(s, "firecracker") == 1) { return KavachBackend.FIRECRACKER; }
    if (strieq(s, "wasm") == 1) { return KavachBackend.WASM; }
    if (strieq(s, "oci") == 1) { return KavachBackend.OCI; }
    if (strieq(s, "sgx") == 1) { return KavachBackend.SGX; }
    if (strieq(s, "sev") == 1) { return KavachBackend.SEV; }
    if (strieq(s, "tdx") == 1) { return KavachBackend.TDX; }
    if (strieq(s, "sy-agnos") == 1) { return KavachBackend.SY_AGNOS; }
    if (strieq(s, "syagnos") == 1) { return KavachBackend.SY_AGNOS; }
    if (strieq(s, "noop") == 1) { return KavachBackend.NOOP; }
    return 0 - 1;
}

# Existence check via the stdlib access(2) wrapper with F_OK (mode 0).
# Returns 1 if the path exists, 0 otherwise. (Was a raw `syscall(21, ...)`;
# routing through sys_access drops the bare syscall + magic number — S2.)
fn kavach_path_exists(path) {
    if (sys_access(path, 0) == 0) { return 1; }
    return 0;
}

# Check common PATH locations for a binary. Returns 1 if any exists.
fn which_exists(name) {
    var nlen = strlen(name);
    var buf = alloc(nlen + 24);

    var p1 = "/usr/local/bin/";
    memcpy(buf, p1, strlen(p1));
    memcpy(buf + strlen(p1), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p2 = "/usr/bin/";
    memcpy(buf, p2, strlen(p2));
    memcpy(buf + strlen(p2), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p3 = "/bin/";
    memcpy(buf, p3, strlen(p3));
    memcpy(buf + strlen(p3), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    var p4 = "/usr/sbin/";
    memcpy(buf, p4, strlen(p4));
    memcpy(buf + strlen(p4), name, nlen + 1);
    if (kavach_path_exists(buf) == 1) { return 1; }

    return 0;
}

# Look for wasmtime on PATH. Returns path cstr, or 0 if none.
fn _wasm_binary_path() {
    if (kavach_path_exists("/usr/local/bin/wasmtime") == 1) { return "/usr/local/bin/wasmtime"; }
    if (kavach_path_exists("/usr/bin/wasmtime") == 1) { return "/usr/bin/wasmtime"; }
    # Fall back to a cargo-installed wasmtime under $HOME/.cargo/bin. getenv
    # ships in the stdlib now (reads /proc/self/environ + allocates) — call it
    # here at config time only, never post-fork (it is not async-signal-safe).
    var home = getenv("HOME");
    if (home != 0) {
        var suffix = "/.cargo/bin/wasmtime";
        var hlen = strlen(home);
        var slen = strlen(suffix);
        var path = alloc_checked(checked_sum4(hlen, slen, 1, 0));
        if (path != 0) {
            memcpy(path, home, hlen);
            memcpy(path + hlen, suffix, slen);
            store8(path + hlen + slen, 0);
            if (kavach_path_exists(path) == 1) { return path; }
        }
    }
    return 0;
}

fn backend_is_available(b) {
    if (b == KavachBackend.NOOP) { return 1; }
    if (b == KavachBackend.PROCESS) { return 1; }
    # 3.11.8: PROBE, like every sibling below. This was a hardcoded 0 while
    # `wasm_health` right next to it did the correct check — and because
    # `sandbox_create` refuses a backend that reports unavailable, the WASM path
    # was unreachable through the public API **even with wasmtime installed**.
    # A consumer could register the backend, configure it and never reach
    # `wasm_exec`. `_wasm_binary_path` moved here from `backend_wasm.cyr` so
    # this file can call it; Cyrius resolves single-pass, callees first.
    if (b == KavachBackend.WASM) {
        if (_wasm_binary_path() == 0) { return 0; }
        return 1;
    }
    if (b == KavachBackend.GVISOR) { return which_exists("runsc"); }
    if (b == KavachBackend.FIRECRACKER) { return which_exists("firecracker"); }
    if (b == KavachBackend.OCI) {
        if (which_exists("runc") == 1) { return 1; }
        if (which_exists("crun") == 1) { return 1; }
        return 0;
    }
    if (b == KavachBackend.SGX) { return kavach_path_exists("/dev/sgx_enclave"); }
    if (b == KavachBackend.SEV) { return kavach_path_exists("/dev/sev"); }
    if (b == KavachBackend.TDX) { return kavach_path_exists("/dev/tdx_guest"); }
    if (b == KavachBackend.SY_AGNOS) {
        if (which_exists("docker") == 1) { return 1; }
        if (which_exists("podman") == 1) { return 1; }
        return 0;
    }
    return 0;
}

# Iterate all 10 backends by index 0..KAVACH_BACKEND_COUNT.
fn backend_at(i) {
    return i;
}

# ---- shared exec-backend epilogue ----------------------------------------
# Every exec-capture backend (process / gvisor / oci / wasm / sgx / sev /
# tdx / sy-agnos / firecracker) builds its ExecResult the same way. These
# three helpers carry that shared shape so the logic — and its hardening —
# lives in exactly one place.

# Whether the most recent backend result is a KAVACH DIAGNOSTIC rather than
# captured payload output.
#
# It matters because `sandbox_exec` runs the externalization gate over the
# result's stdout+stderr, and the gate's contract is "scan what the payload
# is about to externalize". A backend error is not payload output — it is
# kavach explaining why there was no payload. Scanning it lets kavach's own
# secret scanner censor kavach's own error messages: `code_scan` rates a
# runtime diagnostic such as
#   runc run failed: ... exec: "/app/x": stat /app/x: no such file or directory
# a HIGH finding, the gate turns HIGH into QUARANTINE, and the user is told
# "externalization blocked: quarantined" instead of what actually went wrong.
# That is a category error, and it silently swallows exactly the message
# needed to diagnose the failure.
#
# Set by the two diagnostic constructors, cleared by the capture path, so the
# flag always describes the result the caller is holding.
#
# ⚠ Since 3.14.8 the result carries it (`ExecResult_diagnostic`), and that is what
# `sandbox_exec` reads. This flag is the process's most recent, which with two
# dispatches on two threads is either one's: agnosai filed the race. Kept for a
# caller on one thread.
var _backend_diag_only = 0;

#[must_use]
fn backend_result_is_diagnostic() { return _backend_diag_only; }

# Whether `r` is a diagnostic rather than captured output (3.14.8). 0 for a null
# result, which no gate is asked to scan.
#[must_use]
fn exec_result_is_diagnostic(r) {
    if (r == 0) { return 0; }
    return ExecResult_diagnostic(r);
}

# Clear the flag before a dispatch (3.12.9). Only the two diagnostic
# constructors set it and only `backend_capture_finish` cleared it, so a backend
# that builds its ExecResult any other way (noop does; a consumer's registered
# backend may) left the PREVIOUS exec's value in place: after one guard
# diagnostic, the next exec's real output skipped the gate, secrets and all.
fn backend_diagnostic_reset() { _backend_diag_only = 0; return 0; }

# ---- Attestation evidence (3.13.0) ----------------------------------------
# When the sandbox policy requires attestation, `sandbox_exec` sets a nonce
# before the dispatch. A backend that can attest has its guest put the nonce in
# the quote's report data and hands the quote back with `backend_attach_quote`.
# The backend does not judge its own evidence: `sandbox_exec` verifies the quote
# against the policy once the dispatch returns. A nonce length of 0 means the
# policy did not ask for attestation.
var _backend_nonce = 0;
var _backend_nonce_len = 0;
var _backend_quote = 0;
var _backend_quote_len = 0;

fn backend_attest_nonce() { return _backend_nonce; }
fn backend_attest_nonce_len() { return _backend_nonce_len; }
fn backend_quote() { return _backend_quote; }
fn backend_quote_len() { return _backend_quote_len; }

fn backend_attach_quote(buf, len) {
    _backend_quote = buf;
    _backend_quote_len = len;
    return 0;
}

# The nonce `sandbox_exec` set for `sandbox`'s exec in flight, and its length (0
# when the policy did not ask for attestation), and the quote a backend hands back
# for it (3.14.8). They live on the sandbox, so an exec on another thread neither
# sees this one's nonce nor clears it. Through 3.14.7 only the process-wide pair
# above existed, which every exec cleared before and after its dispatch, so an exec
# that did not attest cleared the nonce of one that did, mid-dispatch. The pair
# above is still set for an attesting exec, under a lock, for a backend written
# against it.
fn backend_sandbox_nonce(sandbox) {
    if (sandbox == 0) { return 0; }
    return Sandbox_attest_nonce(sandbox);
}

fn backend_sandbox_nonce_len(sandbox) {
    if (sandbox == 0) { return 0; }
    return Sandbox_attest_nonce_len(sandbox);
}

fn backend_sandbox_attach_quote(sandbox, buf, len) {
    if (sandbox == 0) { return 0 - 1; }
    Sandbox_set_quote(sandbox, buf);
    Sandbox_set_quote_len(sandbox, len);
    return 0;
}

# Set the nonce for the next dispatch and drop the last dispatch's quote, which
# must not stand in for this one's (the same reasoning as
# `backend_diagnostic_reset`).
fn backend_attest_reset(nonce, len) {
    _backend_nonce = nonce;
    _backend_nonce_len = len;
    _backend_quote = 0;
    _backend_quote_len = 0;
    return 0;
}

# Simple failure result: exit 1, no stdout, caller-supplied stderr, zero
# duration. Replaces the per-backend `_X_error` helpers.
fn backend_error_result(msg) {
    _backend_diag_only = 1;
    var r = exec_result_new();
    ExecResult_set_diagnostic(r, 1);
    ExecResult_set_exit_code(r, 1);
    ExecResult_set_stdout(r, "");
    ExecResult_set_stderr(r, msg);
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# Runtime-guard violation result: exit 126 with the first violation's
# description. Call only when vec_len(violations) > 0.
fn backend_guard_result(violations) {
    _backend_diag_only = 1;
    var r = exec_result_new();
    ExecResult_set_diagnostic(r, 1);
    ExecResult_set_exit_code(r, 126);
    var v0 = vec_get(violations, 0);
    ExecResult_set_stderr(r, GuardViolation_description(v0));
    ExecResult_set_duration_ms(r, 0);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# A capture's buffer of `cap` bytes, for `backend_capture_finish` to copy from and
# give back (3.14.7). An anonymous mapping, so it costs the pages the payload writes
# into, and it goes back to the kernel after the copy. 0 when none could be had, which
# every capture reads as a failed one.
#
# Through 3.14.6 each exec took `alloc(cap)`, 1 MiB, from a heap with no free, and the
# result's stdout WAS that buffer, so it lived as long as the result and could never
# be given back. agnosai measured 1,051,136 B of `alloc_used()` per `/bin/true` on the
# process backend, and RSS from 9.5 MB to 421 MB over 400 execs: a payload printing
# nothing cost what one printing 1 MiB cost.
#
# agnos has no mmap (`mmap_anon` answers 0 there), so it keeps `alloc`, and its
# backend gets the copy without the release.
fn backend_capture_buf(cap) {
    if (cap <= 1) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    return alloc(cap);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return mmap_anon(cap);
    #endif
}

# Give back a `backend_capture_buf` buffer, after `backend_capture_finish` or
# `backend_run_finish` has copied it. ⛔ Only one of those: this unmaps.
fn backend_capture_release(buf, cap) {
    if (buf == 0) { return 0; }
    #ifndef CYRIUS_TARGET_AGNOS
    cyr_munmap(buf, cap);
    #endif
    return 0;
}

# Build the success/failure ExecResult from a captured-output buffer.
#
# 3.14.7: the result's stdout is a copy of the `n` bytes captured, so the caller can
# give `out_buf` back (`backend_capture_release`) and a result costs what the payload
# wrote. It is not released here, because a caller may pass a buffer of its own.
# `out_buf == 0` is a capture that had no buffer, and reads as failed.
#
# SAFETY (M1, 3.3.1): `exec_capture` fills until `total >= buflen` and can
# return exactly `out_cap`. Writing `store8(out_buf + n, 0)` with n == out_cap
# is one byte past `alloc(out_cap)` — a heap overflow on attacker-influenced
# subprocess output. Clamping n into [0, out_cap - 1] before the NUL makes the
# terminator always land inside the allocation. At the exact-fill boundary this
# drops the final byte of an already-truncated 1 MiB capture — acceptable; the
# alternative (reading past the buffer) is not. Centralizing here fixes the
# off-by-one for all nine capture backends at once.
fn backend_capture_finish(out_buf, n, out_cap, fail_msg, start_ns, end_ns) {
    # This IS captured payload output, so the gate must see it.
    _backend_diag_only = 0;
    var r = exec_result_new();
    if (n < 0 || out_buf == 0) {
        ExecResult_set_exit_code(r, 1);
        ExecResult_set_stdout(r, "");
        ExecResult_set_stderr(r, fail_msg);
    }
    else {
        if (n >= out_cap) { n = out_cap - 1; }
        var out = alloc(n + 1);
        memcpy(out, out_buf, n);
        store8(out + n, 0);
        ExecResult_set_exit_code(r, 0);
        # With its length (3.14.9): a payload's output may carry a NUL, and `strlen`
        # stops there, in the gate's scan and size cap as in any other reader.
        exec_result_set_stdout_n(r, out, n);
        ExecResult_set_stderr(r, "");
    }
    ExecResult_set_duration_ms(r, (end_ns - start_ns) / 1000000);
    ExecResult_set_timed_out(r, 0);
    return r;
}

# Set `r`'s stderr to a copy of the last capture's, with its length.
#
# `confine_last_stderr()` is one static buffer that the next capture overwrites.
# Through 3.13.1 the process and WASM backends stored that pointer in their
# results, so every result shared one stderr and an earlier result's changed to
# a later exec's (measured: after a second `sandbox_exec`, the first result's
# stderr read the second's error, through the same pointer).
#
# ⚠ The process's last capture, for a caller with one thread. Since 3.14.8
# kavach's backends use `backend_set_capture_stderr_of` with the capture they ran.
fn backend_set_capture_stderr(r) {
    var n = confine_last_stderr_len();
    var p = alloc(n + 1);
    memcpy(p, confine_last_stderr(), n);
    store8(p + n, 0);
    exec_result_set_stderr_n(r, p, n);
    return r;
}

# Set `r`'s stderr to a copy of capture `c`'s (3.14.8), which no other capture
# writes.
fn backend_set_capture_stderr_of(r, c) {
    var n = ConfineCapture_err_len(c);
    var e = ConfineCapture_err(c);
    if (e == 0) { n = 0; }
    var p = alloc(n + 1);
    if (n > 0) { memcpy(p, e, n); }
    store8(p + n, 0);
    exec_result_set_stderr_n(r, p, n);
    return r;
}

# The ExecResult for capture `c` once it has run (3.14.8): `backend_capture_finish`'s
# over its buffer, then its exit status, its deadline flag and a copy of its stderr,
# all read from `c`. A capture that failed (`total < 0`) keeps
# `backend_capture_finish`'s (1, `fail_msg`). Releases `c`'s stderr buffer and not
# its stdout one, which is the caller's.
fn backend_capture_result(c, fail_msg, start_ns, end_ns) {
    var n = ConfineCapture_total(c);
    var r = backend_capture_finish(ConfineCapture_buf(c), n, ConfineCapture_buflen(c), fail_msg,
      start_ns, end_ns);
    if (r != 0 && n >= 0) {
        ExecResult_set_exit_code(r, ConfineCapture_exit(c));
        ExecResult_set_timed_out(r, ConfineCapture_timed_out(c));
        backend_set_capture_stderr_of(r, c);
    }
    confine_capture_release(c);
    return r;
}

# Run a backend's runtime (runsc, runc or crun, docker or podman) the way the
# process backend runs a payload (3.13.2): its stdout into `out_buf`, its own
# stderr, exit status and the config's deadline, with the payload's stdin as the
# runtime's (`_config_payload_stdin`). Returns the byte count, or -1; the rest
# of the run is `confine_last_*`, which `backend_run_finish` reads.
#
# The runtime runs unconfined, as it did: it is the boundary, not the payload,
# and its environment is empty. Through 3.13.1 gVisor and SY-agnos ran through
# `kv_exec_capture`, which sends stderr to /dev/null, reports no exit status
# and has no deadline kavach sets, and hands the runtime kavach's own stdin.
fn backend_run_capture(args, cfg, out_buf, out_cap) {
    var c = backend_run_start(args, cfg, out_buf, out_cap);
    var n = ConfineCapture_total(c);
    confine_capture_release(c);
    return n;
}

# The same run, handing back its capture (3.14.8), for `backend_capture_result`:
# the run's outcome is then the capture's own, whatever runs on another thread.
fn backend_run_start(args, cfg, out_buf, out_cap) {
    var tmo = 0;
    if (cfg != 0) { tmo = SandboxConfig_timeout_ms(cfg); }
    var c = confine_capture_new(args, 0, 0, 0, 0, out_buf, out_cap, 0, tmo, 0,
      _config_payload_stdin(cfg), _config_payload_stdin_len(cfg), 0, 0);
    confine_capture_run(c);
    return c;
}

# The ExecResult for a `backend_run_capture` run: `backend_capture_finish`'s,
# with the runtime's exit status, its stderr and whether the deadline killed it.
# A failed capture (`n < 0`) keeps `backend_capture_finish`'s (1, `fail_msg`).
fn backend_run_finish(out_buf, n, out_cap, fail_msg, start_ns, end_ns) {
    var r = backend_capture_finish(out_buf, n, out_cap, fail_msg, start_ns, end_ns);
    if (r != 0 && n >= 0) {
        ExecResult_set_exit_code(r, confine_last_exit());
        ExecResult_set_timed_out(r, confine_last_timed_out());
        backend_set_capture_stderr(r);
    }
    return r;
}
