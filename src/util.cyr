# kavach — shared string helpers + security hardening primitives

# ⛔ EXPLICIT chrono INCLUDE — DO NOT DELETE AS "UNUSED HERE".
# `chrono` is declared in `[deps].stdlib`, but under cc 6.5.27 that declaration
# alone stopped putting it in the compilation unit, and every kavach chrono call
# (`clock_epoch_secs` in audit / quarantine / oci_spec / observability /
# attestation / scanning_threat / scanning_runtime, `clock_now_ns` in lifecycle,
# `sleep_ms` in spawn) became an undefined function — a hard build stop.
#
# The mechanism is an ORDERING bug in the resolver, not a missing declaration.
# `_dep_copy_stdlib_recursive` (cyrius cbt/deps.cyr) tests its `seen` set on the
# FIRST line and returns before the `is_top == 1` push onto `_dep_includes`. So a
# module that is first pulled TRANSITIVELY (is_top=0) is marked seen, and its own
# later top-level `[deps].stdlib` entry silently resolves to a no-op — the file is
# copied into lib/ but no `include` is ever prepended. cc 6.5.27 added
# `lib/async_macos.cyr`, which includes `lib/chrono.cyr`, and `lib/async.cyr`
# includes that; since `async` precedes `chrono` in our `[deps].stdlib`, chrono
# started arriving transitively and lost its prepend.
#
# Fixed here rather than by reordering `[deps].stdlib`, because an explicit
# include is order-independent: it survives any further churn in upstream's
# include chains, and it rides into `dist/kavach.cyr` (distlib preserves
# `include "lib/..."` lines), so CONSUMERS get the same protection — their
# `dist/kavach.deps` sidecar resolves chrono through the identical code path and
# would otherwise hit the identical no-op. Cyrius include resolution is
# include-once, so this is a no-op wherever the auto-prepend works.
include "lib/chrono.cyr"

# ---- portable filesystem-removal shims -----------------------------------
# ⛔ THE AGNOS AND LINUX SYSCALL WRAPPERS HAVE DIFFERENT ARITIES, and kavach called the Linux form
# unguarded in eight files. On Linux `sys_unlink(path)` / `sys_rmdir(path)` take one argument; on
# agnos they take `(path, pathlen)`. Cyrius used to WARN on an arity mismatch and compile anyway —
# it is now a hard ERROR, which is correct, and which turned this latent wrongness into a build stop.
#
# ⚠ THE BLAST RADIUS WAS THE WHOLE CONSUMER, NOT THE BACKEND. `cyrius build` auto-prepends every
# `[deps.*]` module into the compilation unit, so any project declaring `[deps.kavach]` and building
# `--agnos` failed to compile even if it never touched the OCI or Firecracker backends. That is how
# it surfaced: it broke the aethersafha compositor, which uses only `sandbox_*`.
#
# These shims are the ONE place the difference lives. Call sites use kv_unlink / kv_rmdir and stay
# target-agnostic. See docs/development/issues/2026-08-01-linux-only-backends-break-every-agnos-consumer.md
fn kv_unlink(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_unlink(path, strlen(path));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_unlink(path);
    #endif
}

fn kv_rmdir(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path, strlen(path));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path);
    #endif
}

# kv_waitpid(pid, status_out, opts) — portable reap. Returns the pid (>0) or -1.
#
# ⛔ THIS IS NOT AN ARITY DIFFERENCE, IT IS A MODEL DIFFERENCE, and treating it as the former would
# be silently wrong. Linux `sys_waitpid(pid, status, opts)` writes a packed wait-STATUS word whose
# low 7 bits are the terminating signal and whose bits 8-15 are the exit code. agnos
# `sys_waitpid(pid)` takes one argument and returns the child's **exit code DIRECTLY** — cyrius's own
# `syscalls_x86_64_agnos.cyr` says so where it defines the agnos `W*` decoders.
#
# ⚠ Every caller in this repo decodes `(status >> 8) & 255`. Handing them a bare exit code would put
# the code in the SIGNAL field: a child exiting 11 would read as "killed by SIGSEGV", and a clean
# exit 0 would read as "killed by signal 0". So the agnos arm SYNTHESISES the Linux-shaped word.
fn kv_waitpid(pid, status_out, opts): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var code = sys_waitpid(pid);
    if (code < 0) { return 0 - 1; }
    # agnos children always exit normally (there is no signal-kill model here), so the signal
    # field is 0 and the exit code goes where every caller already looks for it.
    if (status_out != 0) { store32(status_out, (code & 255) << 8); }
    return pid;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_waitpid(pid, status_out, opts);
    #endif
}

# kv_getgid() — the caller's group id, or -1 where the platform has no group model.
#
# ⛔ AN `#ifdef` EARLY-RETURN DOES NOT REMOVE THE REST OF THE BODY FROM THE BUILD, which is why
# 3.10.0's fail-closed guards did not fix this. `spawn_namespaces_available` opens with
# `#ifdef CYRIUS_TARGET_AGNOS return 0; #endif` and STILL referenced `sys_getgid` twenty lines
# further down: the guard is a runtime branch, so every statement after it is compiled and every
# symbol it names must resolve. Only a shim — whose two arms are selected at COMPILE time — keeps
# the undefined name out of the object. That distinction cost a build.
#
# ⚠ agnos defines `sys_getuid` and does NOT define `sys_getgid` — there is no group model in the
# kernel, so there is no honest number to return. This answers **-1 = unknown**, never 0: every
# consumer here (the uid_map/gid_map writer, the OCI `gidMappings` field) treats the value as a
# real credential, and 0 is the id of *root*. A shim that quietly reports root on a platform with
# no groups is the kind of lie that reads as a working sandbox.
#
# ⭐ Nothing on agnos consumes the result: all four call sites sit inside Linux-only namespace /
# seccomp / OCI paths that 3.10.0 already made fail closed. The arm exists so the module compiles.
fn kv_getgid(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_getgid();
    #endif
}

# kv_lstat(path, statbuf) — stat WITHOUT following a final symlink. 0 on success, -1 otherwise.
#
# ⛔ THE AGNOS ARM MUST NOT FALL BACK TO `sys_stat`, even though agnos has one. lstat's whole
# purpose at the single call site (`_oci_dir_is_ours`) is to refuse a path whose last component is
# a symlink — an attacker pointing the state root at a directory they control is exactly the case
# it exists to catch. agnos's `sys_stat(path, pathlen, statbuf)` FOLLOWS links, so substituting it
# would turn a security check into its own bypass while every caller still read 0 = "verified ours".
#
# ⚠ It would also return the wrong SHAPE: agnos's stat buffer carries no `st_uid`, and the caller
# reads the owner out of `+24 >> 32` (see the xstat-bridges-the-call-not-the-struct finding). A
# successful-looking return would hand it a garbage uid to compare against.
#
# So agnos answers -1, the caller returns "no usable state root", and the OCI backend — which is
# Linux-only by construction — stays refused.
fn kv_lstat(path, statbuf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_lstat(path, statbuf);
    #endif
}

# ---- portable fork/exec shims --------------------------------------------
# agnos has NO fork/exec model at all: `sys_fork`, `sys_dup2`, `sys_execve` and `sys_setsid` are
# absent from `syscalls_x86_64_agnos.cyr`, and process creation is the FUSED `sys_spawn_path(path,
# len)` #43 — load an ELF and run it, with no separately-addressable child in between. There is no
# moment at which a child could redirect its stdio or replace its image, so there is nothing for
# these to map onto and they answer -1 rather than pretending.
#
# ⭐ THE REFUSAL IS THE EXISTING ERROR PATH, NOT A NEW ONE. Every fork site in this repo is already
# written `var pid = kv_fork(); if (pid < 0) { ...cleanup...; return -1; }`, so a -1 walks straight
# into the failure handling the Linux path uses when fork itself fails. No caller needs a target
# check, no sandbox reports success, and the `if (pid == 0)` child block is unreachable at runtime
# by construction rather than by guard.
#
# ⚠ SHIMMED EVEN THOUGH ONLY `sys_execve` CURRENTLY TRIPS THE BUILD. The compiler flags undefined
# symbols it can prove reachable; `sys_fork`/`sys_dup2`/`sys_setsid` sit in the SAME child blocks
# and are undefined too — they warn today and error the moment reachability analysis, an inliner,
# or one new caller shifts. Leaving three of a family of four un-shimmed keeps a build break loaded
# for whoever touches this next, which is exactly how the 2026-08-01 aethersafha stop happened.
fn kv_fork(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_fork();
    #endif
}

# ⚠ NOT emulated with agnos's `sys_dup` — dup picks the lowest free descriptor, dup2 forces a
# SPECIFIC one. Every call here targets fd 0/1/2 to wire up stdio, and a shim that returned some
# other descriptor would report success while the child's output went nowhere the parent reads.
fn kv_dup2(oldfd, newfd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_dup2(oldfd, newfd);
    #endif
}

fn kv_execve(path, argv, envp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_execve(path, argv, envp);
    #endif
}

fn kv_setsid(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_setsid();
    #endif
}

# ---- constant-time ops ---------------------------------------------------
# Delegates to the stdlib ct_eq_bytes_lens, which XORs byte-by-byte into an
# accumulator without early exit. Prevents timing side channels on
# HMAC/signature verification (ADR-005 §C1). sigil retired its own ct_eq in
# the 3.x line in favor of this stdlib symbol (identical semantics) — see
# CHANGELOG 3.3.0.

fn ct_streq(a, b) {
    var la = strlen(a);
    var lb = strlen(b);
    if (la != lb) { return 0; }
    return ct_eq_bytes_lens(a, la, b, lb);
}

# ---- overflow-checked arithmetic -----------------------------------------
# Return -1 on overflow instead of wrapping. Use for sizes fed to alloc().

fn checked_add(a, b) {
    if (a < 0) { return 0 - 1; }
    if (b < 0) { return 0 - 1; }
    var r = a + b;
    if (r < a) { return 0 - 1; }
    return r;
}

fn checked_mul(a, b) {
    if (a < 0) { return 0 - 1; }
    if (b < 0) { return 0 - 1; }
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var r = a * b;
    if (r / a != b) { return 0 - 1; }
    return r;
}

# Sum 4 non-negative sizes with overflow detection. Returns -1 on any
# negative input or any intermediate overflow. Unused slots: pass 0.
# Chosen arity keeps our worst alloc sites (audit/quarantine/oci_spec)
# coverable in one call — those stitch at most 4 user-lengths plus a
# bounded constant the caller adds separately.
fn checked_sum4(a, b, c, d) {
    var s = checked_add(a, b);
    if (s < 0) { return 0 - 1; }
    s = checked_add(s, c);
    if (s < 0) { return 0 - 1; }
    s = checked_add(s, d);
    if (s < 0) { return 0 - 1; }
    return s;
}

# Overflow-safe alloc: returns 0 (instead of aborting) if requested size
# is negative or exceeds the attacker-defense ceiling of 64 MiB per
# single allocation. 64 MiB is larger than any legitimate per-op buffer
# kavach allocates (OCI spec worst case ~2 MiB, audit line < 1 MiB).
fn alloc_checked(size) {
    if (size < 0) { return 0; }
    if (size > 67108864) { return 0; }
    return alloc(size);
}

# ---- input validation ----------------------------------------------------

# Reject control chars (NUL, BEL, ESC, …) while allowing tab/newline/CR.
# Prevents JSON injection, log forgery, and terminal escape smuggling.
# Returns 1 if safe, 0 otherwise.
#
# Reads the untrusted input through a bounds-checked slice (`sl[i]` lowers to
# the stdlib `_slice_idx_get_1`, which traps on out-of-range): on this
# security-relevant validation path a future off-by-one becomes a clean abort
# rather than an out-of-bounds read of attacker-influenced memory.
fn is_safe_text(s) {
    var n = strlen(s);
    var sl: [u8] = 0;
    slice_set(&sl, s, n);
    var i = 0;
    while (i < n) {
        var c = sl[i];
        if (c < 32) {
            if (c != 9) {
                if (c != 10) {
                    if (c != 13) { return 0; }
                }
            }
        }
        i = i + 1;
    }
    return 1;
}

# Stricter: reject newlines + CR too (used for command arguments where
# each line becomes a token and could smuggle extra args). Same
# bounds-checked-slice read of untrusted input as is_safe_text.
fn is_safe_argument(s) {
    var n = strlen(s);
    var sl: [u8] = 0;
    slice_set(&sl, s, n);
    var i = 0;
    while (i < n) {
        var c = sl[i];
        if (c < 32) {
            if (c != 9) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# ---- secure file I/O -----------------------------------------------------
# O_WRONLY=1, O_CREAT=0x40, O_TRUNC=0x200, O_EXCL=0x80, O_NOFOLLOW=0x20000
# Mode 0600 = 384.

# Human-readable name for a stdlib IoError variant — for the structured
# log/error line emitted on a failed external write (ADR-005 audit trail).
fn io_error_name(e) {
    if (e == IoNotFound) { return "not found"; }
    if (e == IoAccessDenied) { return "access denied"; }
    if (e == IoBadFd) { return "bad fd"; }
    if (e == IoFailed) { return "write incomplete"; }
    return "i/o error";
}

# Result-returning hardened write. Same O_EXCL|O_NOFOLLOW guarantee as
# file_write_secure (refuses to follow a symlink or clobber an existing file;
# mode 0600), but built on the stdlib `_r` primitives so the failure carries a
# distinguishable IoError (ENOENT vs EACCES vs ELOOP/EEXIST→IoOther) instead of
# a bare -1. NOTE: the stdlib file_write_all_r is deliberately NOT used — it
# opens O_WRONLY|O_CREAT|O_TRUNC without the O_EXCL|O_NOFOLLOW hardening
# (ADR-005 §C4). Returns Ok(len) or Err(IoError).
fn file_write_secure_r(path, buf, len): Result {
    var flags = 1 + 64 + 512 + 128 + 131072;
    var fo = file_open_r(path, flags, 384);
    if (is_err_result(fo) == 1) { return fo; }
    var fd = result_unwrap(fo);
    var wr = file_write_r(fd, buf, len);
    file_close_r(fd);
    if (is_err_result(wr) == 1) { return wr; }
    if (result_unwrap(wr) != len) { return Err(IoFailed); }
    return Ok(len);
}

# Back-compat int wrapper: returns bytes written, or -1 on any failure.
# Existing callers that don't need the distinguished error keep using this.
fn file_write_secure(path, buf, len) {
    return result_unwrap_or(file_write_secure_r(path, buf, len), 0 - 1);
}

# As file_write_secure, but honors a caller-supplied final mode via fchmod
# on the same fd that the write went through. Used by credential injection
# (ADR-005 §M2): the file is created mode 0600 by O_CREAT, the content
# lands while still 0600 (no other-readable window), then the fd is
# fchmod'd to the requested mode before close. Closing the fd between
# write and chmod would re-open a TOCTOU window — using fchmod on the
# same fd closes it.
#
# Raw `syscall(91, ...)` because the stdlib doesn't ship a sys_fchmod
# wrapper at cc 5.10.34. SYS_FCHMOD = 91 on x86_64 Linux. Only used here;
# folded back into sys_fchmod when the wrapper lands upstream.
fn file_write_secure_modal(path, buf, len, mode) {
    var flags = 1 + 64 + 512 + 128 + 131072;
    var fd = sys_open(path, flags, 384);
    if (fd < 0) { return 0 - 1; }
    var n = sys_write(fd, buf, len);
    if (n < 0) { sys_close(fd); return 0 - 1; }
    if (n != len) { sys_close(fd); return 0 - 1; }
    # SAFETY: SYS_FCHMOD = 91 on x86_64 Linux; fd is owned by this fn
    # (just opened above), mode is the caller-supplied octal value, the
    # third arg is the standard syscall(...) trailing zero.
    syscall(91, fd, mode, 0);
    sys_close(fd);
    return n;
}

# Restrict an existing file to owner-only (best-effort; ignores errors so
# that failing platforms don't break the exec path — caller still wrote).
fn file_restrict_mode(path) {
    sys_chmod(path, 384);
    return 0;
}

# ---- random bytes --------------------------------------------------------
# Fill `count` bytes of buf from the kernel CSPRNG via getrandom(2) (the
# stdlib random_bytes wrapper). Returns bytes filled, or -1 on failure. Used
# for unpredictable container ids — breaks the /tmp-symlink-precreate attack
# (ADR-005 §C3). getrandom needs no fd and works where /dev/urandom isn't
# mounted (chroot, landlocked, minimal mount ns) — strictly better for a
# sandbox tool than the old open/read/close on /dev/urandom. Blocks only
# until the kernel pool is seeded (immediate post-boot); flags=0, never
# GRND_INSECURE — the unpredictability is a security property here.
fn fill_random(buf, count) {
    var n = random_bytes(buf, count);
    if (n < 0) { return 0 - 1; }
    return n;
}

# Hex-encode `len` bytes from src into dst. dst must fit len*2 + 1 bytes.
fn hex_encode_bytes(src, len, dst) {
    var hex = "0123456789abcdef";
    var i = 0;
    while (i < len) {
        var b = load8(src + i);
        store8(dst + i * 2, load8(hex + ((b >> 4) & 15)));
        store8(dst + i * 2 + 1, load8(hex + (b & 15)));
        i = i + 1;
    }
    store8(dst + len * 2, 0);
    return 0;
}

# 16-char hex id from the kernel CSPRNG (8 random bytes × 2). Returns heap cstr.
fn rand_hex_id() {
    var raw[8];
    fill_random(&raw, 8);
    var out = alloc(17);
    hex_encode_bytes(&raw, 8, out);
    return out;
}

# 64-bit random from the kernel CSPRNG. Used for UUID-v4-equivalent internal
# IDs (sandbox, finding, quarantine entry). Collision probability across
# 2^32 entries is ~2^-32 — sufficient for correlation IDs. Falls back
# to 0 on failure (caller sees a duplicate, which is a visible bug
# rather than a silent TOCTOU).
fn rand_u64() {
    var raw[8];
    if (fill_random(&raw, 8) != 8) { return 0; }
    return load64(&raw);
}

# 32-char hex UUID-like id. Two u64 samples give 128 bits of randomness.
fn rand_uuid_hex() {
    var raw[16];
    fill_random(&raw, 16);
    var out = alloc(33);
    hex_encode_bytes(&raw, 16, out);
    return out;
}

# ---- secret redaction ----------------------------------------------------
# For evidence snippets that may contain an actual secret. Policy: show
# first 4 + '****' + last 4 if len > 8; otherwise full mask. Preserves
# signal (prefix identifies key type, e.g. 'AKIA****') without leaking
# the secret content.

fn redact_evidence(text, start, len) {
    if (len <= 8) {
        var mask = alloc(len + 1);
        memset(mask, 42, len);
        store8(mask + len, 0);
        return mask;
    }
    var buf = alloc(13);
    memcpy(buf, text + start, 4);
    memcpy(buf + 4, "****", 4);
    memcpy(buf + 8, text + start + len - 4, 4);
    store8(buf + 12, 0);
    return buf;
}

# ---- existing helpers ----------------------------------------------------

fn ch_ascii_lower(c) {
    if (c >= 65) {
        if (c <= 90) { return c + 32; }
    }
    return c;
}

# Case-insensitive null-terminated string equality. 1 = equal, 0 = not.
fn strieq(a, b) {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ch_ascii_lower(ca) != ch_ascii_lower(cb)) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Split a command line on runs of spaces/tabs into a vec of cstr tokens.
#
# Lives here rather than in a backend because BOTH the process backend and the
# OCI spec generator need it — the OCI spec must emit `process.args` as real
# argv, not a `/bin/sh -c` string, or any image without a shell (distroless,
# scratch, a single static binary) cannot run.
fn _split_command(cmdline) {
    var args = vec_new();
    var n = strlen(cmdline);
    var i = 0;
    while (i < n) {
        while (i < n) {
            var c = load8(cmdline + i);
            if (c != 32) { if (c != 9) { break; } }
            i = i + 1;
        }
        if (i >= n) { break; }
        var start = i;
        while (i < n) {
            var c = load8(cmdline + i);
            if (c == 32) { break; }
            if (c == 9) { break; }
            i = i + 1;
        }
        var len = i - start;
        var tok = alloc(len + 1);
        memcpy(tok, cmdline + start, len);
        store8(tok + len, 0);
        vec_push(args, tok);
    }
    return args;
}

# Sleep `ms` milliseconds.
#
# 3.11.4: the drain loop in `confine_capture` polls a non-blocking pipe, and
# without a sleep between reads it burns a full core for as long as the payload
# runs. agnosai measured exactly that shape in its own capture — 100% CPU for
# the duration of a `sleep 2` — before adding the idle sleep.
fn kv_sleep_ms(ms): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 35 = nanosleep on x86_64 Linux. Spelled numerically because the stdlib
    # exposes no constant for it and kavach must not depend on one appearing.
    var ts[16];
    store64(&ts, ms / 1000);
    store64(&ts + 8, (ms % 1000) * 1000000);
    return syscall(35, &ts, 0);
    #endif
}

# --- generic string helpers, lifted out of scanning_code.cyr at 3.12.3 ---------------------------------
#
# ⚠ They live HERE, not in the code scanner where they were written, because `scanning_runtime.cyr` also
# calls them — which meant the [lib.confine] profile could not close without dragging the entire code
# scanner (and its 25 pattern groups) into a bundle whose whole point is to carry only the confinement
# path. Cyrius has ONE flat namespace, so every existing caller is unaffected by the move.

# Copy src (null-terminated) into dst, ascii-lowered. dst must be sized.
fn str_to_lower_into(src, dst) {
    var i = 0;
    while (1 == 1) {
        var c = load8(src + i);
        store8(dst + i, ch_ascii_lower(c));
        if (c == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# 1 if haystack contains needle (both null-terminated cstrs). Linear search.
fn cstr_contains(haystack, needle) {
    var hlen = strlen(haystack);
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    if (nlen > hlen) { return 0; }
    var i = 0;
    while (i + nlen <= hlen) {
        var j = 0;
        while (j < nlen) {
            if (load8(haystack + i + j) != load8(needle + j)) { break; }
            j = j + 1;
        }
        if (j == nlen) { return 1; }
        i = i + 1;
    }
    return 0;
}
