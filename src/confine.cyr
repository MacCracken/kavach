# confine.cyr — the child-side confinement sequence, shared by every backend
# that forks (3.9.1).
#
# Extracted from spawn.cyr so the BLOCKING exec path can use it too:
# `backend_process.cyr` is included before `spawn.cyr` (spawn needs its
# `_split_command`), so it cannot reach into spawn — and without this split only
# detached containers would enter their rootfs, which would be a stranger bug
# than the one being fixed.
#
# Everything here runs in the CHILD, after fork and before execve.

# Highest fd we scan when clearing inherited descriptors. close_range(2) would
# be tidier but is not in the frozen syscall surface this module may use.
var SPAWN_MAX_FD = 1024;

# O_WRONLY|O_CREAT|O_APPEND, mode 0644. Append rather than truncate: a restarted
# container should extend its log, not silently erase the evidence of why the
# previous attempt died.
var SPAWN_LOG_FLAGS = 1089;
var SPAWN_LOG_MODE = 420;

# Child exit codes for a confinement step that could not be applied. The child
# _exits rather than execing, so the payload never runs less confined than the
# policy promised — and the specific code says which primitive was missing.
enum SpawnExit {
    SPAWN_EXIT_STDIO = 120;
    SPAWN_EXIT_CGROUP = 121;
    SPAWN_EXIT_NNP = 122;
    SPAWN_EXIT_NS = 123;
    SPAWN_EXIT_LANDLOCK = 124;
    SPAWN_EXIT_SECCOMP = 125;
    SPAWN_EXIT_ROOTFS = 119;
    SPAWN_EXIT_IDMAP = 118;
    SPAWN_EXIT_WORKDIR = 117;
    SPAWN_EXIT_CAPS = 116;
    SPAWN_EXIT_PROC = 115;
    SPAWN_EXIT_READONLY = 114;
}

# 3.14.6: the capabilities a payload with a rootfs keeps unless its config names
# others, as a mask: `oci_default_capabilities()`, which a payload reads as
# `CapEff: 00000000a00405fb`. A constant because `confine_child` runs after fork,
# where it cannot allocate, and `test_capability_masks` holds it to the list.
var KAVACH_CAPS_DEFAULT = 0xA00405FB;

# prctl(2) options and the capget(2) header version, which the stdlib does not name.
var KAVACH_PR_CAPBSET_READ = 23;
var KAVACH_PR_CAPBSET_DROP = 24;
var KAVACH_CAP_VERSION_3 = 0x20080522;

# CAP_SYS_ADMIN's bit. With it and no filter a payload unmounts the read-only `/proc`
# and `/sys`, and as root mounts a `/proc` of its own (3.14.7).
var KAVACH_CAP_SYS_ADMIN = 21;

# statfs(2) f_type values (linux/magic.h), and where f_type and f_flags sit in the
# 64-bit Linux `struct statfs`, the same on x86-64 and aarch64. The stdlib's STATFS_*
# name neither field.
var KAVACH_PROC_SUPER_MAGIC = 0x9FA0;
var KAVACH_SYSFS_MAGIC = 0x62656572;
var KAVACH_STATFS_TYPE = 0;
var KAVACH_STATFS_FLAGS = 80;

# The mount flags the stdlib's MsFlag does not name, and statfs's ST_RELATIME, the one
# ST_* bit whose MS_* counterpart has another value. The rest share them.
var KAVACH_MS_NOATIME = 1024;
var KAVACH_MS_NODIRATIME = 2048;
var KAVACH_MS_RELATIME = 2097152;
var KAVACH_ST_RELATIME = 4096;

# Namespace flags implied by the policy.
#
# `network_enabled == 0` asks for a private network namespace. Note this reads a
# field that `policy_new` zero-fills, so the DEFAULT policy requests network
# isolation — that is the intended default for a sandbox, and the exec path's
# failure to act on it is a gap there, not a licence to ignore it here.
#
# Unprivileged `unshare(CLONE_NEWNET)` is EPERM: an unprivileged process may
# only create a network namespace as part of a NEW USER namespace, which is
# exactly how rootless containers get one. So when we are not root we pair
# NS_USER with it. Running as root, the user namespace is unnecessary and adds a
# uid-mapping step nothing here needs, so it is omitted.
#[must_use]
fn _spawn_ns_flags(policy, rootfs) {
    var f = 0;
    if (policy != 0) {
        if (SandboxPolicy_network_enabled(policy) == 0) { f = f | NS_NETWORK; }
    }
    # Entering a rootfs needs a mount namespace of our own, or making `/`
    # private and entering it would affect the host.
    if (rootfs != 0) { f = f | NS_MOUNT; }
    if (f == 0) { return 0; }
    # Unprivileged, neither a network nor a mount namespace is obtainable on its
    # own — both require being in a NEW USER namespace, which is how rootless
    # containers get them. As root the user namespace is unnecessary.
    if (sys_getuid() != 0) { f = f | NS_USER; }
    return f;
}

# mount(2) flags used to detach our mount namespace from the host's.
var MS_REC_PRIVATE = 278528;        # MS_REC (0x4000) | MS_PRIVATE (0x40000)
var MS_REC_BIND = 20480;            # MS_REC (0x4000) | MS_BIND (0x1000)
var KAVACH_MNT_DETACH = 2;

# Map our uid/gid to root INSIDE the new user namespace.
#
# Without this every file in the rootfs is owned by `nobody` from the payload's
# point of view, and anything needing uid 0 (most container images) fails in a
# way that looks like a corrupt image rather than a missing mapping.
# `setgroups=deny` first is mandatory for an unprivileged writer of gid_map —
# the kernel refuses the gid_map otherwise.
fn _spawn_write_idmaps(uid, gid) {
    file_write_all("/proc/self/setgroups", "deny", 4);
    var ub[64];
    var un = fmt_int_buf(0, &ub);
    store8(&ub + un, 32);
    un = un + 1 + fmt_int_buf(uid, &ub + un + 1);
    store8(&ub + un, 32);
    store8(&ub + un + 1, 49);                       # '1'
    if (file_write_all("/proc/self/uid_map", &ub, un + 2) < 0) { return 0 - 1; }
    var gb[64];
    var gn = fmt_int_buf(0, &gb);
    store8(&gb + gn, 32);
    gn = gn + 1 + fmt_int_buf(gid, &gb + gn + 1);
    store8(&gb + gn, 32);
    store8(&gb + gn + 1, 49);
    if (file_write_all("/proc/self/gid_map", &gb, gn + 2) < 0) { return 0 - 1; }
    return 0;
}

# ---- A caller's /proc and /sys in a rootfs (3.14.7) ------------------------
#
# A rootfs entered with no `/proc` of kavach's own may hold one the caller mounted:
# the postgres entry point needs one (ADR-009). There, through 3.14.6, uid 0 with the
# twelve opened `core_pattern` and `sysrq-trigger` to write, because that access is
# uid 0's and not a capability's. These make a `/proc` and a `/sys` there what runc
# makes them: `security_readonly_path`'s read-only and `security_masked_path`'s
# masked, and a sysfs read-only, as runc's spec mounts one. See ADR-010.
#
# They run in the child, from `_spawn_enter_rootfs`, with the cwd at the top of the
# new root, so every path is relative to it. ⛔ LINUX ONLY: on agnos `sys_mount`,
# `sys_lstat` and `sys_statfs` take other arguments, so every body is out of that build.

# 1 when `path` is a directory, not a symlink, on a filesystem of type `magic`.
fn _spawn_is_fs(path, magic) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var st[144];
    if (kv_lstat(path, &st) != 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x4000) { return 0; }
    var sfs[2176];
    if (sys_statfs(path, &sfs) != 0) { return 0; }
    if ((load64(&sfs + KAVACH_STATFS_TYPE) & 0xFFFFFFFF) != magic) { return 0; }
    return 1;
    #endif
}

# The flags a bind remount of `path` must carry over, or -1. In a user namespace the
# kernel locks nosuid, nodev, noexec and the atime flags of every mount it copied,
# and a remount that drops one reads EPERM, so they are read from the mount itself.
fn _spawn_locked_flags(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfs[2176];
    if (sys_statfs(path, &sfs) != 0) { return 0 - 1; }
    var st = load64(&sfs + KAVACH_STATFS_FLAGS);
    var f = st & (MS_NOSUID | MS_NODEV | MS_NOEXEC | KAVACH_MS_NOATIME | KAVACH_MS_NODIRATIME);
    if ((st & KAVACH_ST_RELATIME) != 0) { f = f | KAVACH_MS_RELATIME; }
    return f;
    #endif
}

# Bind `path` onto itself and remount it read-only. Returns 0, or -1.
#
# Not recursive first, so a mount below `path` is not carried into the bind: a
# read-only remount is not recursive, and binfmt_misc under `/proc/sys`, or a cgroup
# or debugfs under `/sys`, would keep its own flags and stay writable. The bind then
# hides them. In a user namespace the kernel refuses that bind (EINVAL) when a locked
# mount is below, and there it is recursive: such a mount is owned by a uid the
# payload is not, and writing to it reads EACCES. A path the kernel does not have is
# skipped, as runc skips it.
fn _spawn_readonly(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var r = sys_mount(path, path, 0, MS_BIND, 0);
    if (r == 0 - ENOENT) { return 0; }
    if (r == 0 - EINVAL) { r = sys_mount(path, path, 0, MS_REC_BIND, 0); }
    if (r != 0) { return 0 - 1; }
    var f = _spawn_locked_flags(path);
    if (f < 0) { return 0 - 1; }
    if (sys_mount(0, path, 0, MS_REMOUNT | MS_BIND | MS_RDONLY | f, 0) != 0) { return 0 - 1; }
    return 0;
    #endif
}

# Mask `path` as runc's maskPath does: the host's /dev/null over a file, and an empty
# read-only tmpfs over a directory. Returns 0, or -1. A path the kernel does not have
# is skipped. The caller has checked that /dev/null is a character device, so an
# ENOENT here is the target's.
fn _spawn_mask(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var st[144];
    var l = kv_lstat(path, &st);
    if (l == 0 - ENOENT) { return 0; }
    if (l != 0) { return 0 - 1; }
    var r = 0;
    if ((load32(&st + STAT_MODE) & 0xF000) == 0x4000) {
        r = sys_mount("tmpfs", path, "tmpfs", MS_RDONLY, 0);
    } else {
        r = sys_mount("/dev/null", path, 0, MS_BIND, 0);
    }
    if (r != 0) { return 0 - 1; }
    return 0;
    #endif
}

# 1 when `p`, a path from the tables, is under `top`, which ends in a slash.
fn _spawn_path_under(p, top) {
    var n = strlen(top);
    if (strlen(p) < n) { return 0; }
    return memeq(p, top, n);
}

# Guard a `/proc` and a `/sys` at the top of the cwd. Returns 0, or -1 when one is
# there and could not be guarded, and the payload must not run.
#
# Before the pivot, where /dev/null is the host's: a rootfs as kavach leaves it has
# no /dev, and runc's own check on a rootfs's /dev/null exists because a payload's
# image can make that one a symlink (CVE-2025-31133). The host's is checked too.
#
# ⚠ Only `/proc` and `/sys`, as runc's lists name them, and only as directories: a
# symlink would resolve against the host here, so it is left to
# `_spawn_proc_sys_held`, which refuses one that leads to an unguarded procfs. A
# procfs the caller mounted anywhere else in the rootfs is not found: see ADR-010.
fn _spawn_guard_proc_sys() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var has_proc = _spawn_is_fs("proc", KAVACH_PROC_SUPER_MAGIC);
    var has_sys = _spawn_is_fs("sys", KAVACH_SYSFS_MAGIC);
    if (has_proc == 0 && has_sys == 0) { return 0; }
    var st[144];
    if (kv_lstat("/dev/null", &st) != 0) { return 0 - 1; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x2000) { return 0 - 1; }
    # runc's order: the read-only paths, then the masks.
    if (has_sys == 1) {
        if (_spawn_readonly("sys") != 0) { return 0 - 1; }
    }
    var i = 0;
    while (i < SECURITY_READONLY_PATHS) {
        var rp = security_readonly_path(i) + 1;
        if (has_proc == 1 && _spawn_path_under(rp, "proc/") == 1) {
            if (_spawn_readonly(rp) != 0) { return 0 - 1; }
        }
        i = i + 1;
    }
    i = 0;
    while (i < SECURITY_MASKED_PATHS) {
        var mp = security_masked_path(i) + 1;
        var want = 0;
        if (has_proc == 1 && _spawn_path_under(mp, "proc/") == 1) { want = 1; }
        if (has_sys == 1 && _spawn_path_under(mp, "sys/") == 1) { want = 1; }
        if (want == 1) {
            if (_spawn_mask(mp) != 0) { return 0 - 1; }
        }
        i = i + 1;
    }
    return 0;
    #endif
}

# After the pivot, whether a `/proc` and a `/sys` the payload will meet are guarded.
# Returns 0, or -1, and then the payload must not run.
#
# `_spawn_guard_proc_sys` runs before the pivot, where an absolute symlink in the
# rootfs resolves against the host, so it guards only a `proc` or `sys` that is a
# directory. After the pivot a symlink resolves inside the rootfs, and could lead to a
# procfs nothing guarded. This follows it, as the payload will: a procfs at `/proc`
# must have a read-only `/proc/sys`, and a sysfs at `/sys` must be read-only.
fn _spawn_proc_sys_held() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sfs[2176];
    if (sys_statfs("/proc", &sfs) == 0) {
        if ((load64(&sfs + KAVACH_STATFS_TYPE) & 0xFFFFFFFF) == KAVACH_PROC_SUPER_MAGIC) {
            var r = sys_statfs("/proc/sys", &sfs);
            if (r != 0 && r != 0 - ENOENT) { return 0 - 1; }
            if (r == 0 && (load64(&sfs + KAVACH_STATFS_FLAGS) & MS_RDONLY) == 0) { return 0 - 1; }
        }
    }
    if (sys_statfs("/sys", &sfs) == 0) {
        if ((load64(&sfs + KAVACH_STATFS_TYPE) & 0xFFFFFFFF) == KAVACH_SYSFS_MAGIC) {
            if ((load64(&sfs + KAVACH_STATFS_FLAGS) & MS_RDONLY) == 0) { return 0 - 1; }
        }
    }
    return 0;
    #endif
}

# Remount the root read-only, for a policy with `read_only_rootfs` (3.14.7). Through
# 3.14.6 the flag was scored and nothing on the process path applied it. Run after
# the pivot, where `/` is the rootfs's own bind, so only that mount changes: a `/proc`
# or `/sys` below keeps what `_spawn_guard_proc_sys` gave it. Returns 0, or -1.
fn _spawn_readonly_root() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var f = _spawn_locked_flags("/");
    if (f < 0) { return 0 - 1; }
    if (sys_mount(0, "/", 0, MS_REMOUNT | MS_BIND | MS_RDONLY | f, 0) != 0) { return 0 - 1; }
    return 0;
    #endif
}

# Enter `rootfs` — the step whose absence made every container before 3.9.1 run
# host binaries.
#
# Requires a mount namespace already unshared (the caller does that with
# NS_MOUNT), or the private-mount call below would alter the HOST's propagation.
#
# pivot_root(2), runc's sequence, since 3.14.6. Through 3.14.5 this was chroot(2),
# which moves a process's root and leaves the old tree in its mount namespace. A
# payload left in three calls, needing no fd from outside: `chroot("sub")` puts its
# cwd outside the new root, `..` from there walks to the top of the namespace, and
# `chroot(".")` settles there. It held CAP_SYS_CHROOT, nothing denies `chroot`, and
# that held rootless too (docs/development/issues/2026-11-06-process-backend-keeps-
# every-capability.md). Here nothing is left to walk up to, because the old root is
# detached, so a payload may hold CAP_SYS_CHROOT, as `oci_default_capabilities` has
# it do. See ADR-009.
#
# pivot_root wants a mount point, so the rootfs is bound onto itself first, and
# MS_REC because a user namespace refuses to bind a subtree holding locked mounts
# without it. The rest is the sequence pivot_root(2) gives for needing no temporary
# directory: `pivot_root(".", ".")` stacks the old root on top of the new one, and
# `.` resolves up that stack, so the detach takes the old root off.
#
# ⛔ FAILS CLOSED where this cannot run, with no fall back to chroot, which is the
# escape. pivot_root(2) names a root on the initial ramfs as one such host (read, not
# run). A caller that is itself chrooted onto a plain directory is refused sooner, at
# the private mount, as it was through 3.14.5, and onto a mount point it works.
#
# 3.14.7: a `/proc` or `/sys` the caller mounted in the rootfs is made what runc makes
# them (`_spawn_guard_proc_sys`), between the bind and the pivot. Returns 0, -1 when
# the rootfs cannot be entered, or -2 when a `/proc` or `/sys` there cannot be guarded.
fn _spawn_enter_rootfs(rootfs) {
    if (rootfs == 0) { return 0; }
    # ⛔ LINUX ONLY, AND IT MUST FAIL CLOSED ELSEWHERE. This is mount-namespace + pivot_root
    # confinement: agnos has no mount namespaces, no `pivot_root`, and no `chdir` syscall — `sys_mount`
    # is a 0-argument stub there and `SYS_CHDIR` is not in the enum at all, so this function did not
    # even COMPILE for `--agnos`, taking every consumer of `[deps.kavach]` down with it.
    # ⚠ The agnos arm returns -1, NOT 0. Returning 0 would report "the payload is confined to
    # `rootfs`" on a platform where nothing of the sort happened — a sandbox that silently is not
    # one. A caller that cannot confine must be told it cannot confine.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # Detach propagation, or our mounts leak to the host.
    if (sys_mount(0, "/", 0, MS_REC_PRIVATE, 0) < 0) { return 0 - 1; }
    # "/" is the root already, with nothing above it to leave, and pivot_root reads
    # EBUSY for a new root on the mount it would replace.
    if (streq(rootfs, "/") == 1) {
        if (syscall(SYS_CHDIR, "/") < 0) { return 0 - 1; }
        if (_spawn_guard_proc_sys() != 0) { return 0 - 2; }
        if (_spawn_proc_sys_held() != 0) { return 0 - 2; }
        return 0;
    }
    if (sys_mount(rootfs, rootfs, 0, MS_REC_BIND, 0) < 0) { return 0 - 1; }
    if (syscall(SYS_CHDIR, rootfs) < 0) { return 0 - 1; }
    # Before the pivot: the mask's /dev/null is the host's, and a bind from a mount
    # the pivot then detaches reads EINVAL. The cwd is the bind, so the relative
    # paths resolve in it, and the mounts move with it.
    if (_spawn_guard_proc_sys() != 0) { return 0 - 2; }
    if (sys_pivot_root(".", ".") < 0) { return 0 - 1; }
    if (sys_umount2(".", KAVACH_MNT_DETACH) < 0) { return 0 - 1; }
    # As runc does, because the kernel promises nothing about the cwd after this.
    if (syscall(SYS_CHDIR, "/") < 0) { return 0 - 1; }
    if (_spawn_proc_sys_held() != 0) { return 0 - 2; }
    return 0;
    #endif
}

# 3.12.2: chdir into the payload's configured working directory.
#
# ⚠ MUST run AFTER `_spawn_enter_rootfs`, or the path resolves against the HOST
# filesystem — a `workdir` of `/app` would land in the host's `/app` and the
# payload would run outside the container with no error. `_spawn_enter_rootfs`
# already `chdir("/")`s after the pivot, so this refines a cwd that is already
# inside the root rather than establishing one.
#
# ⚠ FAILS CLOSED. A workdir the caller asked for and did not get is a silently
# wrong environment — the payload runs somewhere it was not told to. runc errors
# out in the same situation, and so does this: the child `_exit`s with
# SPAWN_EXIT_WORKDIR rather than falling through to execve from the wrong
# directory. `workdir == 0` (the default) is not a request and returns 0.
fn _spawn_enter_workdir(workdir) {
    if (workdir == 0) { return 0; }
    if (strlen(workdir) == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no chdir syscall — see _spawn_enter_rootfs. A caller that asked
    # for a workdir must be told it did not get one.
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (syscall(SYS_CHDIR, workdir) < 0) { return 0 - 1; }
    return 0;
    #endif
}

# Bound the calling process, the child, to `mask`: the bounding set, then permitted
# and effective, with inheritable empty, which takes ambient with it. Returns 0, or
# -1 when a capability that had to go could not be dropped.
#
# The bounding set is what holds. A payload running as uid 0, in the host's user
# namespace or its own, takes its permitted set from it at `execve`. CAP_SETPCAP
# drops it, so that comes before the `capset` that may give it up.
#
# A bound, not a grant. `mask` is cut to what the caller holds, because `capset`
# refuses more, and NO_NEW_PRIVS stops `execve` adding any.
#
# Only with a rootfs: see `confine_child_caps`. ⛔ LINUX ONLY, like the sequence.
fn _spawn_bound_capabilities(mask) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var hdr[8];
    var data[24];
    store32(&hdr, KAVACH_CAP_VERSION_3);
    store32(&hdr + 4, 0);
    memset(&data, 0, 24);
    if (sys_capget(&hdr, &data) != 0) { return 0 - 1; }
    var held = load32(&data + 4) | (load32(&data + 16) << 32);
    var i = 0;
    while (i < 64) {
        if (((mask >> i) & 1) == 0) {
            # EINVAL is past the kernel's last capability.
            var bounded = syscall(SYS_PRCTL, KAVACH_PR_CAPBSET_READ, i, 0, 0, 0);
            if (bounded < 0) { break; }
            if (bounded == 1) {
                if (syscall(SYS_PRCTL, KAVACH_PR_CAPBSET_DROP, i, 0, 0, 0) < 0) { return 0 - 1; }
            }
        }
        i = i + 1;
    }
    var keep = mask & held;
    memset(&data, 0, 24);
    store32(&data, keep & 0xFFFFFFFF);
    store32(&data + 4, keep & 0xFFFFFFFF);
    store32(&data + 12, keep >> 32);
    store32(&data + 16, keep >> 32);
    if (sys_capset(&hdr, &data) != 0) { return 0 - 1; }
    return 0;
    #endif
}

# Why `config`'s capability list cannot be honoured here, as a message, or 0. Read
# with a rootfs only, which is where a list applies. CAP_SYS_ADMIN under a filter
# is not refused, unlike `oci_capabilities_refusal`: that rule answers a runtime
# resolving a filter by name and skipping one it does not know, and this filter
# compares numbers, so `open_tree_attr` is denied here.
#
# 3.14.7: CAP_SYS_ADMIN with no filter is refused. It unmounts the read-only `/proc`
# and `/sys` that `_spawn_guard_proc_sys` makes, and as root mounts a `/proc` of its
# own, so with it the masks would mean nothing. A filter denies `mount`, `umount2`,
# `move_mount` and the rest of the mount API, and there the masks hold.
#[must_use]
fn confine_capabilities_refusal(config) {
    if (config == 0) { return 0; }
    if (SandboxConfig_rootfs(config) == 0) { return 0; }
    var v = SandboxConfig_capabilities(config);
    if (v == 0) { return 0; }
    var unknown = security_capability_refusal(v);
    if (unknown != 0) { return unknown; }
    if (((security_capability_mask(v) >> KAVACH_CAP_SYS_ADMIN) & 1) == 1) {
        var p = SandboxConfig_policy(config);
        var filtered = 0;
        if (p != 0) { filtered = SandboxPolicy_seccomp_enabled(p); }
        if (filtered != 1) {
            return "CAP_SYS_ADMIN with a rootfs needs a seccomp filter: without one it unmounts the read-only /proc";
        }
    }
    return 0;
}

# `config`'s capabilities as a mask, for `confine_child_caps`. Built in the PARENT,
# because alloc after fork is unsafe and the list is strings.
#[must_use]
fn confine_capabilities(config) {
    if (config == 0) { return KAVACH_CAPS_DEFAULT; }
    var v = SandboxConfig_capabilities(config);
    if (v == 0) { return KAVACH_CAPS_DEFAULT; }
    return security_capability_mask(v);
}

# SIGPIPE back to its default in the payload (3.13.2), with the stdlib's
# `signal_default`. A signal set to SIG_IGN stays ignored across `execve`, so a
# payload inherited SIGPIPE ignored whenever kavach's own process ignored it, as
# a server often does and as the GitHub Actions runner starts its steps. A
# payload writing to a closed pipe then got EPIPE where it dies of SIGPIPE
# outside a sandbox: measured, `head` writing past a full capture exited 1, not
# 141. agnosai filed the stdlib function for this divergence. The capture,
# `sandbox_spawn` and persistent guests call it first in the child.
fn _spawn_default_sigpipe() {
    signal_default(SIGPIPE);
    return 0;
}

# The capture's payload dies with kavach (3.13.2): PR_SET_PDEATHSIG (1) with
# SIGKILL (9), set in the child before `execve`, which keeps it for a binary
# that is not set-id. Through 3.13.1 a payload outlived a kavach killed
# mid-capture (measured: its `sleep` still running after kavach's SIGKILL), and
# gVisor and SY-agnos had the stdlib capture's guard until they moved onto this
# one. `getppid` against `ppid`, read before the fork, catches a parent that
# died before the `prctl`, when the signal would never come.
#
# Only for the capture, where kavach waits on the payload. `sandbox_spawn` and
# persistent guests hand the caller a handle to a process meant to run on.
fn _spawn_die_with_parent(ppid) {
    # ⛔ LINUX ONLY: `SYS_PRCTL` is not in the agnos syscall enum, and the one
    # caller, the capture, is compiled out there.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    syscall(SYS_PRCTL, 1, 9, 0, 0, 0);
    if (sys_getppid() != ppid) { sys_exit(1); }
    return 0;
    #endif
}

# Close every descriptor from `from` up to SPAWN_MAX_FD. Errors are expected
# and ignored — most of the range is simply not open. The one fd spared is the
# pinned binary the child is about to exec (kv_exec_pin, util.cyr). It is a
# close-on-exec fd to a FILE, and it only exists when there is no rootfs, so it
# is never a directory outside the root, which is what closing the rest is for.
fn _spawn_close_inherited(from) {
    var fd = from;
    while (fd < SPAWN_MAX_FD) {
        if (fd != _kv_exec_keep_fd) { sys_close(fd); }
        fd = fd + 1;
    }
    return 0;
}

# Put the CALLING process into `cgroup_path`. Returns 0 on success, -1 on
# failure. Called in the child, so "the calling process" is the payload.
fn _spawn_cgroup_join(cgroup_path) {
    if (cgroup_path == 0) { return 0; }
    var fpath = _cgroup_file(cgroup_path, "cgroup.procs");
    var buf[32];
    var len = fmt_int_buf(sys_getpid(), &buf);
    if (file_write_all(fpath, &buf, len) < 0) { return 0 - 1; }
    return 0;
}

# Install `policy`'s landlock ruleset in the calling process, the child, after
# the rootfs and before `execve`. Returns 0, also when the policy asks for no
# landlock (a count of 0), or -1 when the ruleset could not be applied.
#
# `confine_child` and the persistent guest's sequence both call this, so they
# cannot differ on what a policy means. Until 3.11.3 `confine_child` passed
# `(0, 0)`, which `security_apply_landlock` answers `Ok(0)` at once: the count
# was checked, the rules never sent, and no ruleset installed.
#
# A deny-all policy (`policy_landlock_is_deny_all`) gets a ruleset naming no
# path, whatever its list holds: the null list gives the walk nothing, and the
# count still makes `security_apply_landlock` install the ruleset. Through
# 3.13.0 both paths passed the list, and the walk, bounded by the list and the
# count, applied every rule in it, so a deny-all policy that also named paths
# permitted them. Any other policy holds at least `count` rules, and the first
# `count` are applied. Unlike the code it replaced, this makes no list after
# `fork` for a count with no list.
#
# The policy's scopes go into the same ruleset (3.13.2): `landlock_abstract_unix`
# and `landlock_signal`, which `policy_strict()` sets, confine the payload's
# abstract unix sockets and signals to its own landlock domain. Through 3.13.1
# they were stored and scored and applied by nothing; a `policy_strict()`
# payload could signal kavach itself. A policy with scopes and no rules gets a
# ruleset of scopes alone.
fn _spawn_apply_landlock(policy) {
    if (policy == 0) { return 0; }
    var count = SandboxPolicy_landlock_rules_len(policy);
    if (count < 0) { count = 0; }
    var scopes = _spawn_landlock_scopes(policy);
    if (count == 0 && scopes == 0) { return 0; }
    var rules = SandboxPolicy_landlock_rules(policy);
    if (policy_landlock_is_deny_all(policy) == 1) { rules = 0; }
    if (is_ok(security_apply_landlock_scoped(rules, count, scopes)) == 0) { return 0 - 1; }
    return 0;
}

# The landlock scopes `policy` asks for, as the kernel's mask.
fn _spawn_landlock_scopes(policy) {
    var scopes = 0;
    if (SandboxPolicy_landlock_abstract_unix(policy) == 1) {
        scopes = scopes | LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET;
    }
    if (SandboxPolicy_landlock_signal(policy) == 1) { scopes = scopes | LANDLOCK_SCOPE_SIGNAL; }
    return scopes;
}

# Redirect stdio for the detached child: stdin from /dev/null, stdout+stderr to
# `log_path` (or /dev/null when none was given). Returns 0 / -1.
fn _spawn_redirect_stdio(log_path) {
    var devnull = file_open("/dev/null", O_RDONLY, 0);
    if (devnull < 0) { return 0 - 1; }
    kv_dup2(devnull, 0);
    sys_close(devnull);

    var out = 0 - 1;
    if (log_path != 0) {
        out = file_open(log_path, SPAWN_LOG_FLAGS, SPAWN_LOG_MODE);
    }
    if (out < 0) {
        out = file_open("/dev/null", O_WRONLY, 0);
        if (out < 0) { return 0 - 1; }
    }
    kv_dup2(out, 1);
    kv_dup2(out, 2);
    if (out > 2) { sys_close(out); }
    return 0;
}

# Apply the whole confinement sequence in the child. Returns 0, or does not
# return (each step _exits with its own code so a caller can tell which
# primitive was unavailable).
#
# Order is security-relevant and is the reason this is one function rather than
# a checklist each backend re-implements:
#   fds -> cgroup -> NO_NEW_PRIVS -> namespaces (+idmap) -> rootfs (+ a caller's
#   /proc and /sys guarded) -> read-only root -> landlock -> capabilities -> seccomp
# seccomp is last because it denies mount/pivot_root/unshare; rootfs entry precedes
# landlock because landlock path rules resolve against the current root, and the
# capabilities follow landlock because its rules open their paths. The mounts that
# guard `/proc` and make the root read-only come before the capabilities, which
# take away the CAP_SYS_ADMIN they need and that would undo them.
# `want_ns` (3.11.3) — whether to create namespaces as the policy requests.
#
# **1 for every caller that predates 3.11.3, and their behaviour is unchanged.**
# `sandbox_spawn` in particular has a fail-closed namespace contract with a test
# to match: a policy asking for network isolation on a host that denies
# unprivileged user namespaces must exit 123/118 rather than run the payload
# less isolated than promised.
#
# 0 for exactly one caller: the rootfs-less capture that 3.11.3 added so
# `seccomp_enabled` would stop being ignored. That path previously applied
# **nothing at all**, so seccomp + landlock is a strict gain — but making
# unprivileged namespace creation a *precondition* for it would turn payloads
# that used to run into payloads that do not run, on any host restricting user
# namespaces (Ubuntu 24.04 does). It claims no network isolation it did not get;
# a caller wanting that guarantee uses a rootfs-bearing sandbox or
# `sandbox_spawn`, both of which still fail closed.
fn confine_child(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns) {
    return confine_child_wd(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, 0);
}

# 3.12.2: the same sequence with the payload's working directory. `workdir == 0`
# is the pre-3.12.2 behaviour (cwd `/` inside the rootfs), so the wrapper above
# is unchanged for every existing caller — the same discipline `confine_capture`
# follows for `input` and `confine_capture_input_env` for `env`.
fn confine_child_wd(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, workdir) {
    return confine_child_caps(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, workdir,
      KAVACH_CAPS_DEFAULT);
}

# 3.14.6: the same sequence with the capabilities a payload with a rootfs keeps, as
# a mask (`confine_capabilities`). The wrapper above gives it the default, so a
# caller of `dist/kavach-confine.cyr` passing a rootfs gets the bound unasked.
#
# ⚠ `caps` applies only with a rootfs. With none the payload is on the host's files,
# where no set bounds a uid 0 process from what root owns (`core_pattern` opens to
# write with `CapEff` zero), so this path holds what kavach holds, as it always has.
# See ADR-009.
fn confine_child_caps(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, workdir, caps) {
    # ⛔ THE WHOLE SEQUENCE IS LINUX-SPECIFIC and none of it exists on agnos: no cgroups, no
    # `prctl`, no namespaces, no landlock, no seccomp. `SYS_PRCTL` is not even in the agnos syscall
    # enum, so this function failed to COMPILE for `--agnos` and took every consumer of
    # `[deps.kavach]` with it — including consumers that never sandbox anything.
    # ⚠ FAIL CLOSED, and loudly. Returning 0 here would tell a caller "the child is confined" on a
    # platform where not one primitive ran — a sandbox that is silently not a sandbox, which is the
    # worst failure mode this file has. agnos sandboxing goes through backend_sy_agnos, not here.
    #ifdef CYRIUS_TARGET_AGNOS
    sys_exit(SPAWN_EXIT_NNP);
    return 0 - 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    _spawn_close_inherited(3);
    if (_spawn_cgroup_join(cgroup_path) != 0) { sys_exit(SPAWN_EXIT_CGROUP); }
    if (syscall(SYS_PRCTL, 38, 1, 0, 0, 0) < 0) { sys_exit(SPAWN_EXIT_NNP); }

    # `want_ns` is 0 only for the capture path added in 3.11.3 — see the note
    # on `confine_child`'s signature.
    #
    # ⛔ A rootfs always gets its namespaces, whatever `want_ns` says (3.12.9).
    # `_spawn_enter_rootfs` makes `/` private and pivots, and with no mount
    # namespace of our own that `mount` lands in the caller's: as root, the
    # host's propagation. kavach's own callers pass want_ns = 1 whenever there
    # is a rootfs, but this function is exported (`dist/kavach-confine.cyr`),
    # and a caller passing 0 with a rootfs reached exactly that.
    var nsf = 0;
    if (want_ns != 0 || rootfs != 0) { nsf = _spawn_ns_flags(policy, rootfs); }
    if (nsf != 0) {
        if (is_ok(security_create_namespace(nsf)) == 0) { sys_exit(SPAWN_EXIT_NS); }
        if ((nsf & NS_USER) != 0) {
            # Its OWN code. Creating the namespace and mapping ids into it are
            # different privileges that fail on different hosts — a CI runner
            # already inside a restricted user namespace creates one happily and
            # then cannot write uid_map. Sharing SPAWN_EXIT_NS between them made
            # the two indistinguishable, which is exactly the opacity the
            # per-step codes exist to remove.
            if (_spawn_write_idmaps(uid, gid) != 0) { sys_exit(SPAWN_EXIT_IDMAP); }
        }
    }
    var entered = _spawn_enter_rootfs(rootfs);
    if (entered == 0 - 2) { sys_exit(SPAWN_EXIT_PROC); }
    if (entered != 0) { sys_exit(SPAWN_EXIT_ROOTFS); }
    if (rootfs != 0 && policy != 0) {
        if (SandboxPolicy_read_only_rootfs(policy) == 1) {
            if (_spawn_readonly_root() != 0) { sys_exit(SPAWN_EXIT_READONLY); }
        }
    }
    # After the pivot, so the path resolves inside the container. See the fn's header.
    if (_spawn_enter_workdir(workdir) != 0) { sys_exit(SPAWN_EXIT_WORKDIR); }

    if (_spawn_apply_landlock(policy) != 0) { sys_exit(SPAWN_EXIT_LANDLOCK); }
    if (rootfs != 0) {
        # 3.14.7: CAP_SYS_ADMIN with no filter unmounts the read-only `/proc` and, as
        # root, mounts a `/proc` of its own, so it is refused without one. The
        # parent refuses it sooner (`confine_capabilities_refusal`); this holds for a
        # caller of `confine_child_caps` that passed the mask itself.
        if (((caps >> KAVACH_CAP_SYS_ADMIN) & 1) == 1 && seccomp_info == 0) {
            sys_exit(SPAWN_EXIT_CAPS);
        }
        if (_spawn_bound_capabilities(caps) != 0) { sys_exit(SPAWN_EXIT_CAPS); }
    }
    if (seccomp_info != 0) {
        if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(seccomp_info),
              security_seccomp_filter_len(seccomp_info))) == 0) {
            sys_exit(SPAWN_EXIT_SECCOMP);
        }
    }
    return 0;
    #endif
}

# Human-readable name for a confinement exit code, or 0 when `code` is not one.
#
# The child _exits with a distinct code per failed primitive, which is precise
# but opaque at the call site: "the container exited 123" says nothing, and a
# caller staring at that has no way to know the host simply cannot create user
# namespaces. Callers should run a non-zero exit through this before reporting.
#[must_use]
fn spawn_exit_name(code) {
    if (code == SPAWN_EXIT_STDIO) { return "cannot redirect stdio"; }
    if (code == SPAWN_EXIT_CGROUP) { return "cannot join cgroup"; }
    if (code == SPAWN_EXIT_NNP) { return "cannot set no_new_privs"; }
    if (code == SPAWN_EXIT_NS) {
        return "cannot create namespaces (unprivileged user namespaces may be disabled on this host)";
    }
    if (code == SPAWN_EXIT_LANDLOCK) { return "cannot apply landlock"; }
    if (code == SPAWN_EXIT_SECCOMP) { return "cannot load seccomp filter"; }
    if (code == SPAWN_EXIT_ROOTFS) { return "cannot enter rootfs"; }
    if (code == SPAWN_EXIT_CAPS) { return "cannot bound capabilities"; }
    if (code == SPAWN_EXIT_PROC) { return "cannot make /proc or /sys in the rootfs read-only"; }
    if (code == SPAWN_EXIT_READONLY) { return "cannot make the rootfs read-only"; }
    if (code == SPAWN_EXIT_IDMAP) {
        return "cannot write uid_map/gid_map (already inside a restricted user namespace?)";
    }
    # 0 is the contract, not an oversight: "this is not a confinement code",
    # which `test_spawn_exit_name` asserts for a normal exit and for 127.
    # Callers must not hand it straight to a string function — see the guard in
    # `test_spawn_namespaces_environment_aware`, where an unexpected code would
    # otherwise turn a failed assertion into a SIGSEGV.
    return 0;
}

# 1 when this host can actually create the namespaces `flags` asks for.
#
# Probes in a FORKED CHILD, because unshare(2) mutates the caller — there is no
# way to ask "would this work?" without doing it. Hosts with
# `kernel.unprivileged_userns_clone=0`, some hardened distros, and many CI
# containers deny unprivileged user namespaces outright, and a caller wanting to
# degrade gracefully (or a test wanting to skip) needs to know that up front
# rather than decoding a child exit code afterwards.
#[must_use]
fn spawn_namespaces_available(flags) {
    # ⛔ LINUX ONLY. This PROBES namespace availability by forking a child; agnos has no fork,
    # no namespaces, and no uid_map. ⚠ Answering 0 ("unavailable") is the honest and SAFE answer —
    # a caller that believes namespaces exist would build a policy it cannot enforce.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    if (flags == 0) { return 1; }
    # Read the ids BEFORE the fork. Inside a fresh user namespace getuid()
    # reports the UNMAPPED id (nobody), and a uid_map written against that is
    # rejected — the probe would then report "unavailable" on a host that works
    # perfectly. sandbox_spawn reads them in the parent for the same reason.
    var probe_uid = sys_getuid();
    var probe_gid = kv_getgid();
    var pid = kv_fork();
    if (pid < 0) { return 0; }
    if (pid == 0) {
        if (is_ok(security_create_namespace(flags)) == 0) { sys_exit(1); }
        # Creating the namespace is only half of it — mapping ids into it is a
        # separate privilege, and a host can grant the first and refuse the
        # second. Probing only the first reports "available" for a spawn that
        # will still die.
        if ((flags & NS_USER) != 0) {
            if (_spawn_write_idmaps(probe_uid, probe_gid) != 0) { sys_exit(1); }
        }
        sys_exit(0);
    }
    var st[4];
    store32(&st, 0);
    kv_waitpid(pid, &st, 0);
    var status = load32(&st);
    if ((status & 127) != 0) { return 0; }
    if (((status >> 8) & 255) != 0) { return 0; }
    return 1;
}

# 1 when this host will actually load a seccomp filter.
#
# Same shape and same reason as spawn_namespaces_available: the filter is loaded
# in the CHILD, so a host that refuses it turns every spawn into an opaque
# `SPAWN_EXIT_SECCOMP`. Probes in a fork because loading a filter is
# irreversible for the calling process.
#[must_use]
fn spawn_seccomp_available() {
    # ⛔ LINUX ONLY — forks a child to test-load a seccomp filter. agnos has neither.
    # ⚠ 0 = "no seccomp here", which is true, and which keeps callers from promising a filter.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    var res_t, res_v = security_create_exec_seccomp_filter();
    if (is_ok(res_t) == 0) { return 0; }
    var info = result_unwrap(res_t, res_v);
    var pid = kv_fork();
    if (pid < 0) { return 0; }
    if (pid == 0) {
        if (is_ok(security_load_seccomp(security_seccomp_filter_ptr(info),
              security_seccomp_filter_len(info))) == 0) {
            sys_exit(1);
        }
        sys_exit(0);
    }
    var st[4];
    store32(&st, 0);
    kv_waitpid(pid, &st, 0);
    var status = load32(&st);
    if ((status & 127) != 0) { return 0; }
    if (((status >> 8) & 255) != 0) { return 0; }
    return 1;
}

# Fork, confine, exec, and capture stdout — the blocking counterpart of
# sandbox_spawn, used when the sandbox names a rootfs.
#
# The stdlib's `exec_capture` forks and execs on the HOST; it has no seam for a
# child-side confinement step, which is why a rootfs-bearing sandbox needs its
# own fork here rather than a flag passed down.
#
# Returns bytes captured, or -1.
# `timeout_ms` (3.11.4) — wall-clock budget, 0 for none. On expiry the payload
# is SIGKILLed and reaped, and `confine_last_timed_out()` reports it.
#
# **`SandboxConfig.timeout_ms` was accepted and ignored by every backend except
# WASM.** A config with a 1000 ms deadline ran `/bin/sleep 8` for 8001 ms and
# reported `timed_out = 0` — the bound was not enforced and the flag said it
# had been. `process_exec` now passes the config's deadline here.
#
# `do_confine` (3.11.4) — whether to run `confine_child` at all. 0 gives a plain
# fork/exec capture, which is what the non-confining path used to get from the
# stdlib's `exec_capture`. Routing it through here instead is what gives that
# path a real exit code and a deadline; `exec_capture` discards the wait status
# and has no seam for either.
fn confine_capture_input(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len) {
    return confine_capture_input_env(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, input, input_len, 0);
}

# 3.12.0: the same path with an explicit payload environment. `env == 0` is the
# empty envp every caller got before, so the wrapper above is unchanged
# behaviour — the same discipline `confine_capture` follows for `input`.
fn confine_capture_input_env(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env) {
    return confine_capture_input_env_wd(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, input, input_len, env, 0);
}

# 3.12.2: …and the payload's working directory. `workdir == 0` is unchanged
# behaviour, so the wrapper above covers every 3.12.0/3.12.1 caller.
#
# ⚠ The parameter list grew to 14 by strict append-and-wrap, which kept every release
# source-compatible and is where it stops. What comes next is a `ConfineCapture`
# field: `caps` was the first (3.14.6).
fn confine_capture_input_env_wd(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env, workdir) {
    return confine_capture_run(confine_capture_new(args, policy, rootfs, cgroup_path, seccomp_info,
        buf, buflen, want_ns, timeout_ms, do_confine, input, input_len, env, workdir));
}

# One capture: everything `confine_capture_run` reads.
#derive(accessors)
struct ConfineCapture {
    args;
    policy;
    rootfs;
    cgroup_path;
    seccomp_info;
    buf;
    buflen;
    want_ns;
    timeout_ms;
    do_confine;
    input;
    input_len;
    env;
    workdir;
    caps;
}
var CONFINE_CAPTURE_SIZE = 120;

# A capture of what the positional wrappers above have always taken, with `caps` at
# the default. A caller with a config sets `caps` from `confine_capabilities`.
fn confine_capture_new(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen,
  want_ns, timeout_ms, do_confine, input, input_len, env, workdir) {
    var c = alloc(CONFINE_CAPTURE_SIZE);
    ConfineCapture_set_args(c, args);
    ConfineCapture_set_policy(c, policy);
    ConfineCapture_set_rootfs(c, rootfs);
    ConfineCapture_set_cgroup_path(c, cgroup_path);
    ConfineCapture_set_seccomp_info(c, seccomp_info);
    ConfineCapture_set_buf(c, buf);
    ConfineCapture_set_buflen(c, buflen);
    ConfineCapture_set_want_ns(c, want_ns);
    ConfineCapture_set_timeout_ms(c, timeout_ms);
    ConfineCapture_set_do_confine(c, do_confine);
    ConfineCapture_set_input(c, input);
    ConfineCapture_set_input_len(c, input_len);
    ConfineCapture_set_env(c, env);
    ConfineCapture_set_workdir(c, workdir);
    ConfineCapture_set_caps(c, KAVACH_CAPS_DEFAULT);
    return c;
}

# Fork, confine, exec and capture. Returns the bytes in `buf`, or -1; the payload's
# exit code is `confine_last_exit()`.
fn confine_capture_run(c) {
    var args = ConfineCapture_args(c);
    var policy = ConfineCapture_policy(c);
    var rootfs = ConfineCapture_rootfs(c);
    var cgroup_path = ConfineCapture_cgroup_path(c);
    var seccomp_info = ConfineCapture_seccomp_info(c);
    var buf = ConfineCapture_buf(c);
    var buflen = ConfineCapture_buflen(c);
    var want_ns = ConfineCapture_want_ns(c);
    var timeout_ms = ConfineCapture_timeout_ms(c);
    var do_confine = ConfineCapture_do_confine(c);
    var input = ConfineCapture_input(c);
    var input_len = ConfineCapture_input_len(c);
    var env = ConfineCapture_env(c);
    var workdir = ConfineCapture_workdir(c);
    var caps = ConfineCapture_caps(c);
    # ⛔ LINUX ONLY — the fork/confine/execve/capture path. agnos has no fork by design and its
    # sandboxing goes through backend_sy_agnos, not this file.
    # ⚠ -1, never a fabricated success: a caller must not receive an empty capture buffer and
    # conclude the payload ran and printed nothing.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #endif
    # **The body is excluded from the agnos build, not merely unreachable on it.**
    # The `#ifdef` arm above returns before any of this runs, but a preprocessor
    # arm is not a compiler arm: the lines below are still compiled, and
    # `SYS_FCNTL` does not exist in the agnos syscall enum. That is a hard error
    # since cyrius made arity/undefined-symbol mismatches fatal, and because
    # `cyrius build` auto-prepends every `[deps.*]` module, it fails **any**
    # `--agnos` consumer that declares `[deps.kavach]` — including one that never
    # touches this backend. The non-blocking drain added in 3.11.5 is what
    # introduced the reference.
    #ifndef CYRIUS_TARGET_AGNOS
    var argc = vec_len(args);
    if (argc < 1) { return 0 - 1; }
    # No buffer (3.14.7: `backend_capture_buf` answers 0 when it has none) is a
    # failed capture, never a write through a null pointer.
    if (buf == 0 || buflen < 2) { return 0 - 1; }
    var argv = alloc((argc + 1) * 8);
    var i = 0;
    while (i < argc) {
        store64(argv + i * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(argv + argc * 8, 0);
    # Caller-supplied payload environment, or the empty envp when unset. Built
    # in the PARENT — alloc after fork is unsafe, same rule as the argv above.
    var envp = kv_envp_from_vec(env);

    # Read the ids in the PARENT — inside the new user namespace getuid()
    # reports the mapped id, not the one the map must be written against.
    var uid = sys_getuid();
    var gid = kv_getgid();
    # For `_spawn_die_with_parent`, read before the fork.
    var ppid = sys_getpid();

    var pipefd[16];
    sys_pipe(&pipefd);
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);
    # 3.11.5: a SECOND pipe, so the payload's stderr is its own stream. Until
    # then both fds went to one pipe and `backend_capture_finish` then set
    # `ExecResult.stderr` to "" — a field that always read empty, which is a
    # different and false claim from "the payload wrote nothing".
    var epipe[16];
    sys_pipe(&epipe);
    var erfd = load32(&epipe);
    var ewfd = load32(&epipe + 4);
    # 3.11.8: a THIRD pipe, for the payload's stdin — created ONLY when there is
    # something to send. Until then the child inherited the parent's fd 0, so a
    # backend could run a program but could not pass it arguments on stdin,
    # which is the whole contract of every WASM/CLI tool protocol. agnosai filed
    # it while porting `.agpkg`: "a WASM tool that cannot receive parameters is
    # not a port of this file".
    #
    # ⚠ `input == 0` keeps the INHERIT behaviour rather than handing the child an
    # empty stdin. Every pre-3.11.8 caller reaches here through `confine_capture`
    # with `input = 0`, and switching them to an immediate EOF would change what
    # an interactive payload sees.
    var in_rfd = 0 - 1;
    var in_wfd = 0 - 1;
    if (input != 0) {
        var inpipe[16];
        sys_pipe(&inpipe);
        in_rfd = load32(&inpipe);
        in_wfd = load32(&inpipe + 4);
    }
    # Pinned before fork, so the child execs the binary kavach committed to
    # (ADR-005 §H4). Not with a rootfs: there the path must resolve inside it.
    var pin = KV_EXEC_BY_PATH;
    if (rootfs == 0) { pin = kv_exec_pin(vec_get(args, 0)); }
    var pid = kv_fork();
    if (pid < 0) {
        sys_close(rfd); sys_close(wfd); sys_close(erfd); sys_close(ewfd);
        if (in_rfd >= 0) { sys_close(in_rfd); sys_close(in_wfd); }
        if (pin >= 0) { sys_close(pin); }
        return 0 - 1;
    }
    if (pid == 0) {
        _spawn_default_sigpipe();
        _spawn_die_with_parent(ppid);
        _kv_exec_keep_fd = pin;
        sys_close(rfd);
        sys_close(erfd);
        if (in_rfd >= 0) {
            sys_close(in_wfd);
            kv_dup2(in_rfd, 0);
            sys_close(in_rfd);
        }
        kv_dup2(wfd, 1);
        kv_dup2(ewfd, 2);
        sys_close(wfd);
        sys_close(ewfd);
        # ⚠ workdir is passed as 0 here and applied BELOW instead, so it lands
        # whether or not the child is confined. A working directory is process
        # setup, not a confinement primitive — the same reasoning that makes
        # `envp` unconditional. Applying it inside `confine_child_wd` only would
        # mean an UNCONFINED capture silently ignored the caller's workdir, which
        # is the decorative-setter shape this release exists to remove.
        if (do_confine != 0) {
            confine_child_caps(policy, rootfs, cgroup_path, uid, gid, seccomp_info, want_ns, 0, caps);
        }
        # After confinement, so the path resolves inside the rootfs when there is one.
        if (_spawn_enter_workdir(workdir) != 0) { sys_exit(SPAWN_EXIT_WORKDIR); }
        kv_exec_child(pin, vec_get(args, 0), argv, envp);
        # execve failed — 127 is the shell's "command not found", and it is
        # visible to the caller instead of being swallowed into a success.
        sys_exit(127);
    }
    if (pin >= 0) { sys_close(pin); }
    sys_close(wfd);
    sys_close(ewfd);

    # **The payload's stdin goes out from inside the drain loop** (3.14.4). Until
    # then it was one blocking write here, before the loop. A guest that writes
    # while it reads fills its stdout pipe while kavach is still blocked on its
    # stdin, and from then on each waits on the other. The deadline is checked
    # only in the loop, so `timeout_ms` never fired: agnosai measured an echoing
    # WASM guest on 200,000 B of stdin holding the calling thread for good. A
    # guest that reads to EOF still gets its EOF: the close comes after the last
    # byte, and straight away for an empty input.
    #
    # O_NONBLOCK belongs to this end's file description, so the payload's read
    # end stays a plain blocking pipe. SIGPIPE is held for the write, since a
    # payload may exit without reading it all: see `_confine_sigpipe_hold`.
    var in_sent = 0;
    var in_failed = 0;
    var in_held = 0;
    var in_mask[8];
    if (in_rfd >= 0) {
        sys_close(in_rfd);
        if (input_len > 0) {
            syscall(SYS_FCNTL, in_wfd, F_SETFL, O_NONBLOCK);
            _confine_sigpipe_hold(&in_mask);
            in_held = 1;
        } else {
            sys_close(in_wfd);
            in_wfd = 0 - 1;
        }
    }

    # **Both ends non-blocking and drained round-robin** (3.11.5). Draining one
    # to EOF and then the other deadlocks the moment the undrained pipe fills
    # (64 KiB): the payload blocks writing to it, so it never closes the first,
    # so the parent's read never finishes. The deadline needs the same
    # non-blocking reads, so the two requirements share one loop.
    syscall(SYS_FCNTL, rfd, 4, 2048);       # F_SETFL, O_NONBLOCK
    syscall(SYS_FCNTL, erfd, 4, 2048);

    var deadline = 0;
    if (timeout_ms > 0) { deadline = mono_now_ns() / 1000000 + timeout_ms; }

    var total = 0;
    var etotal = 0;
    var odone = 0;
    var edone = 0;
    var killed = 0;
    var idle = 0;
    while (odone == 0 || edone == 0 || in_wfd >= 0) {
        var moved = 0;
        if (in_wfd >= 0) {
            var w = sys_write(in_wfd, input + in_sent, input_len - in_sent);
            if (w > 0) {
                in_sent = in_sent + w;
                moved = 1;
            }
            # EAGAIN is a full pipe and EINTR a retry; anything else (EPIPE, the
            # reader is gone) ends the input, and the payload's exit status says
            # what became of it.
            if (w < 0 && w != 0 - EAGAIN && w != 0 - EINTR) { in_failed = 1; }
            if (in_failed == 1 || in_sent >= input_len) {
                sys_close(in_wfd);
                in_wfd = 0 - 1;
            }
        }
        # **A full buffer ends a stream without blocking the payload** (3.13.2).
        # Until then a full buffer only stopped the reads. The payload then
        # blocked writing to that pipe, never closed the other one, and the loop
        # waited for an EOF that could not come: measured, a `/bin/cat` of 2 MB
        # and a shell writing 200 KB of stderr before exiting 3 each hung until
        # the deadline, then reported `timed_out` and exit 137, and hung for good
        # with no deadline. A full stdout is closed, so the payload's next write
        # fails (SIGPIPE, exit 141), as it does under `exec_capture`. A full
        # stderr is read on into a sink, so diagnostics never stop a payload.
        if (odone == 0) {
            var n = sys_read(rfd, buf + total, buflen - 1 - total);
            if (n == 0) { odone = 1; }
            if (n > 0) {
                total = total + n;
                moved = 1;
                if (total >= buflen - 1) {
                    odone = 1;
                    sys_close(rfd);
                    rfd = 0 - 1;
                }
            }
        }
        if (edone == 0) {
            var room = CONFINE_ERR_MAX - 1 - etotal;
            var m = 0;
            if (room > 0) { m = sys_read(erfd, &_confine_err_buf + etotal, room); }
            else { m = sys_read(erfd, &_confine_err_sink, CONFINE_ERR_SINK); }
            if (m == 0) { edone = 1; }
            if (m > 0) {
                if (room > 0) { etotal = etotal + m; }
                moved = 1;
            }
        }
        # The deadline is read on every pass, not only an idle one (3.14.4). A
        # payload keeping a pipe busy leaves few idle passes: measured, one writing
        # stderr without pause under a 1000 ms deadline was killed at 2049 ms.
        if (deadline > 0 && mono_now_ns() / 1000000 >= deadline) {
            # Kill FIRST: the payload's pipe ends must close, or the loop
            # would wait on an EOF that is never coming.
            sys_kill(pid, 9);
            killed = 1;
            odone = 1;
            edone = 1;
            if (in_wfd >= 0) {
                sys_close(in_wfd);
                in_wfd = 0 - 1;
            }
        } else {
            if (moved == 0) {
                # An idle iteration still sleeps rather than spinning — a
                # non-blocking read that finds nothing returns at once, and
                # retrying it burns a core for as long as the payload runs.
                #
                # **But it backs off into that, rather than starting there
                # (3.11.7).** A flat `CONFINE_POLL_MS` charges every exec the
                # full interval before its first byte is even readable, and a
                # short payload is *entirely* that wait. Measured on
                # `/bin/echo hi` through the PROCESS backend: **11.96 ms at a
                # flat 5 ms against 4.78 ms at a flat 1 ms** — 2.5x, none of it
                # work. The regression arrived with this loop in 3.11.5 and
                # shipped through 3.11.6 because no benchmark execs anything;
                # `process_exec_echo` exists now so it cannot happen again.
                #
                # The ramp keeps both properties: a fast payload is noticed in
                # about a millisecond, and a slow one still converges to
                # `CONFINE_POLL_MS`, so the CPU argument above is unchanged for
                # exactly the case it was made about.
                idle = idle + 1;
                if (idle < CONFINE_POLL_RAMP) { kv_sleep_ms(1); }
                else { kv_sleep_ms(CONFINE_POLL_MS); }
            } else {
                # While input is going out the pace is the payload's, so it does
                # not settle at the slow end of the ramp: 5 ms a pipeful would cap
                # a large stdin at 13 MiB/s.
                if (in_wfd >= 0) { idle = 0; }
            }
        }
    }
    if (rfd >= 0) { sys_close(rfd); }
    sys_close(erfd);
    if (in_held == 1) { _confine_sigpipe_release(&in_mask, in_failed); }
    store8(&_confine_err_buf + etotal, 0);
    _confine_err_len = etotal;

    var stbuf[4];
    store32(&stbuf, 0);
    if (_confine_reap(pid, &stbuf, killed, deadline) == 1) { killed = 1; }
    _confine_last_timed_out = killed;
    var status = load32(&stbuf);
    var sig = status & 127;
    var code = 0;
    if (sig == 0) { code = (status >> 8) & 255; }
    else { code = 128 + sig; }
    _confine_last_exit = code;
    return total;
    #endif
}

# Reap `pid` into `stbuf`, holding it to `deadline` (ms, 0 for none) when it was
# not `killed` already. Returns 1 if the deadline killed it here, else 0.
#
# The drain loop ends at EOF on both streams, and that is not the payload's exit
# (3.14.4): one that closes stdout and stderr and carries on was outside the
# deadline, and held the caller in a blocking wait for as long as it ran.
# Measured, a payload closing its stdio and sleeping under a 1000 ms deadline
# was still running 6 s later.
fn _confine_reap(pid, stbuf, killed, deadline) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (killed == 0 && deadline > 0) {
        while (1 == 1) {
            # 0 is still running. Anything else ends the wait: the pid, or an
            # error such as ECHILD when the host ignores SIGCHLD.
            if (kv_waitpid(pid, stbuf, WNOHANG) != 0) { return 0; }
            if (mono_now_ns() / 1000000 >= deadline) { break; }
            kv_sleep_ms(1);
        }
        sys_kill(pid, 9);
        kv_waitpid(pid, stbuf, 0);
        return 1;
    }
    kv_waitpid(pid, stbuf, 0);
    return 0;
    #endif
}

# Hold SIGPIPE on the calling thread while kavach writes a payload's stdin; the
# caller's mask goes to `mask` (8 bytes).
#
# A payload that exits with stdin unread leaves the write end with no reader, and
# the next write raises SIGPIPE in KAVACH'S process, whose default is to die. It
# was possible before 3.14.4 and needed a payload exiting inside one write; with
# the write in the drain loop a payload has the whole run to do it. The signal
# goes to the writing thread, so a thread mask covers it without touching the
# process-wide disposition, which is the consumer's. The parent only: the child
# has forked already, so the payload does not inherit the block.
fn _confine_sigpipe_hold(mask) {
    #ifndef CYRIUS_TARGET_AGNOS
    var set[8];
    store64(&set, 1 << (SIGPIPE - 1));
    sys_sigprocmask(SIG_BLOCK, &set, mask);
    #endif
    return 0;
}

# Undo `_confine_sigpipe_hold`. After a failed write (`failed` 1) the SIGPIPE it
# raised is pending, and would be delivered when the mask comes back, so it is
# taken first, through a signalfd: the stdlib names no rt_sigtimedwait, and
# CLAUDE.md forbids the raw number. A caller that had SIGPIPE blocked keeps
# whatever is pending, as it would after its own write.
fn _confine_sigpipe_release(mask, failed) {
    #ifndef CYRIUS_TARGET_AGNOS
    var bit = 1 << (SIGPIPE - 1);
    if (failed == 1 && (load64(mask) & bit) == 0) {
        var set[8];
        store64(&set, bit);
        var fd = sys_signalfd(0 - 1, &set, O_NONBLOCK | O_CLOEXEC);
        if (fd >= 0) {
            var info[128];                                  # struct signalfd_siginfo
            sys_read(fd, &info, 128);
            sys_close(fd);
        }
    }
    sys_sigprocmask(SIG_SETMASK, mask, 0);
    #endif
    return 0;
}

# The pre-3.11.8 shape: capture with the child inheriting the parent's stdin.
# Every existing caller lands here, so none of them changed behaviour.
fn confine_capture(args, policy, rootfs, cgroup_path, seccomp_info, buf, buflen, want_ns,
  timeout_ms, do_confine) {
    return confine_capture_input(args, policy, rootfs, cgroup_path, seccomp_info, buf,
      buflen, want_ns, timeout_ms, do_confine, 0, 0);
}

# Exit code of the most recent confine_capture. The capture returns a byte
# count, and a caller that only looked at that would report success for a
# payload that never ran — which is exactly how the missing-rootfs bug stayed
# invisible.
var _confine_last_exit = 0;

# How often the drain loop looks again while a payload is running.
var CONFINE_POLL_MS = 5;

# Idle iterations spent at 1 ms before falling back to `CONFINE_POLL_MS`.
#
# 8 ms of fine-grained polling covers process startup, which is where a short
# payload's whole latency lives; past that the payload is genuinely working and
# 5 ms granularity costs it nothing. Set this to 0 to restore the flat interval
# 3.11.5 and 3.11.6 shipped.
var CONFINE_POLL_RAMP = 8;

# Ceiling on captured stderr. A payload cannot make the parent allocate without
# bound by writing diagnostics.
var CONFINE_ERR_MAX = 65536;
var _confine_err_buf[65536];
var _confine_err_len = 0;

# Where stderr past `CONFINE_ERR_MAX` is read and dropped (3.13.2): 4096 bytes,
# as 512 slots, since a top-level `var x[N]` is N*8 bytes.
var CONFINE_ERR_SINK = 4096;
var _confine_err_sink[512];

# The payload's stderr from the most recent `confine_capture`, NUL-terminated.
#
# Its own stream since 3.11.5. Before that both fds went to one pipe and
# `ExecResult.stderr` was hardcoded to "" — so a caller that checked it was told
# the payload wrote nothing, which is a different claim from "we did not keep
# it".
#[must_use]
fn confine_last_stderr() { return &_confine_err_buf; }

#[must_use]
fn confine_last_stderr_len() { return _confine_err_len; }

# Whether the most recent `confine_capture` killed its payload on the deadline.
var _confine_last_timed_out = 0;

#[must_use]
fn confine_last_timed_out() { return _confine_last_timed_out; }

#[must_use]
fn confine_last_exit() { return _confine_last_exit; }
