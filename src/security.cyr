# security.cyr — Landlock, seccomp BPF, namespace creation
# Ported from rust-old/src/security.rs
#
# Provides Landlock filesystem sandboxing, seccomp-BPF syscall filtering,
# and Linux namespace creation via raw syscalls.

#define LINUX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/tagged.cyr"
include "lib/syscalls.cyr"
include "lib/hashmap.cyr"

# ================================================================
# Landlock constants (kernel 5.13+)
# ================================================================
#
# SYS_LANDLOCK_* numbers are arch-invariant and now provided by
# lib/syscalls.cyr (cyrius 5.7.x). SYS_PRCTL is arch-varying and comes from
# the same place, one number per Linux peer.

# **The full ABI v1 right set, plus the two later additions.**
#
# Until 3.11.1 only READ_FILE, READ_DIR and WRITE_FILE were declared, and only
# those three went into `handled_access_fs`. **Landlock restricts ONLY the
# rights named there and leaves every other right fully permitted**, so a
# confined process could still delete any file on the host, create directories
# anywhere, and exec any binary — while the obvious smoke test ("cannot read
# /etc/passwd") passed, because reading was one of the three that *were*
# handled. Reported by agnosai with a runnable probe; the filing is in
# `docs/development/issues/`, dated 2026-08-03.
enum LandlockConst {
    LANDLOCK_ACCESS_FS_EXECUTE = 1;
    LANDLOCK_ACCESS_FS_WRITE_FILE = 2;
    LANDLOCK_ACCESS_FS_READ_FILE = 4;
    LANDLOCK_ACCESS_FS_READ_DIR = 8;
    LANDLOCK_ACCESS_FS_REMOVE_DIR = 16;
    LANDLOCK_ACCESS_FS_REMOVE_FILE = 32;
    LANDLOCK_ACCESS_FS_MAKE_CHAR = 64;
    LANDLOCK_ACCESS_FS_MAKE_DIR = 128;
    LANDLOCK_ACCESS_FS_MAKE_REG = 256;
    LANDLOCK_ACCESS_FS_MAKE_SOCK = 512;
    LANDLOCK_ACCESS_FS_MAKE_FIFO = 1024;
    LANDLOCK_ACCESS_FS_MAKE_BLOCK = 2048;
    LANDLOCK_ACCESS_FS_MAKE_SYM = 4096;
    LANDLOCK_ACCESS_FS_REFER = 8192;
    LANDLOCK_ACCESS_FS_TRUNCATE = 16384;
    # ABI v5: ioctl on a character or block device opened under the ruleset.
    LANDLOCK_ACCESS_FS_IOCTL_DEV = 32768;
    # ABI v6 scopes: a process may reach an abstract unix socket, or signal a
    # process, only inside its own landlock domain.
    LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET = 1;
    LANDLOCK_SCOPE_SIGNAL = 2;
    LANDLOCK_RULE_PATH_BENEATH = 1;
    # Flag to `landlock_create_ruleset` that asks for the ABI version instead of
    # creating a ruleset. Returns the version as a positive integer.
    LANDLOCK_CREATE_RULESET_VERSION = 1;
}

# The ABI v1 rights — every kernel with Landlock at all accepts these.
fn _landlock_rights_v1(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_READ_DIR
    | LANDLOCK_ACCESS_FS_REMOVE_DIR | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM;
}

# The running kernel's Landlock ABI version, or 0 if Landlock is unavailable.
#
# **This query is not optional.** `landlock_create_ruleset` fails with EINVAL if
# `handled_access_fs` names a right the running ABI does not know, so naming
# REFER (v2) or TRUNCATE (v3) unconditionally would turn a working sandbox into
# a hard error on any kernel older than 6.2.
fn security_landlock_abi_version(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var v = syscall(SYS_LANDLOCK_CREATE_RULESET, 0, 0, LANDLOCK_CREATE_RULESET_VERSION);
    if (v < 0) { return 0; }
    return v;
    #endif
}

# Every right this kernel will accept in `handled_access_fs`.
#
# Masking down by ABI rather than up: the v1 set is the floor, and the later
# rights are added only where the kernel knows them. IOCTL_DEV (v5) is handled
# since 3.13.2; before, no kavach ruleset restricted ioctl on a device file.
fn _landlock_handled_access(abi): i64 {
    var mask = _landlock_rights_v1();
    if (abi >= 2) { mask = mask | LANDLOCK_ACCESS_FS_REFER; }
    if (abi >= 3) { mask = mask | LANDLOCK_ACCESS_FS_TRUNCATE; }
    if (abi >= 5) { mask = mask | LANDLOCK_ACCESS_FS_IOCTL_DEV; }
    return mask;
}

# The rights granted **inside** a path opened read-only.
#
# EXECUTE is included deliberately. Before 3.11.1 it was permitted *everywhere*
# because it was unhandled, and a sandbox that read-only-mounts `/usr` in order
# to run `/usr/bin/python3` is the normal case — withholding it here would turn
# a security fix into a breaking change for every such consumer. Granting it
# only within allowed paths is strictly tighter than the old behaviour while
# keeping that case working.
fn _landlock_allow_read_only(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_READ_FILE
    | LANDLOCK_ACCESS_FS_READ_DIR;
}

# The rights granted **inside** a path opened read-write.
#
# The read-only set plus every mutation right, so a sandboxed process retains
# full control of its own writable area — create, delete, truncate, and (on ABI
# v2+) rename across two of its own allowed directories. Outside those paths all
# of it is now denied, which is the actual fix.
#
# IOCTL_DEV (ABI v5, since 3.13.2) is a read-write right only, as WRITE_FILE is:
# an ioctl on a device drives it. A read-only rule leaves a device readable and
# its ioctls refused, and descriptors opened before the ruleset, the payload's
# stdio among them, are not affected.
fn _landlock_allow_read_write(abi): i64 {
    var mask = _landlock_allow_read_only() | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_REMOVE_DIR | LANDLOCK_ACCESS_FS_REMOVE_FILE
    | LANDLOCK_ACCESS_FS_MAKE_CHAR | LANDLOCK_ACCESS_FS_MAKE_DIR
    | LANDLOCK_ACCESS_FS_MAKE_REG | LANDLOCK_ACCESS_FS_MAKE_SOCK
    | LANDLOCK_ACCESS_FS_MAKE_FIFO | LANDLOCK_ACCESS_FS_MAKE_BLOCK
    | LANDLOCK_ACCESS_FS_MAKE_SYM;
    if (abi >= 2) { mask = mask | LANDLOCK_ACCESS_FS_REFER; }
    if (abi >= 3) { mask = mask | LANDLOCK_ACCESS_FS_TRUNCATE; }
    if (abi >= 5) { mask = mask | LANDLOCK_ACCESS_FS_IOCTL_DEV; }
    return mask;
}

# The rights a rule naming a file, not a directory, can hold: the kernel's
# ACCESS_FILE. `landlock_add_rule` refuses any other right on a non-directory
# with EINVAL. Measured one right at a time on 7.2.6 (ABI 10): EXECUTE,
# WRITE_FILE, READ_FILE, TRUNCATE and IOCTL_DEV are taken on a file, and
# READ_DIR, the REMOVE_* and MAKE_* rights and REFER are refused.
#
# Masked with a rule's rights, this keeps TRUNCATE (ABI v3) and IOCTL_DEV (ABI
# v5) only where the rule had them, which `_landlock_allow_read_write` gives. A
# rule may grant only rights the ruleset handles, so neither can reach a kernel
# older than its ABI.
fn _landlock_file_rights(): i64 {
    return LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_WRITE_FILE
    | LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_TRUNCATE
    | LANDLOCK_ACCESS_FS_IOCTL_DEV;
}

# Filesystem access levels
enum FsAccess {
    FS_NO_ACCESS = 0;
    FS_READ_ONLY = 1;
    FS_READ_WRITE = 2;
}

# Filesystem rule: { path_ptr, access }
# path_ptr is a null-terminated C string pointer
fn security_fs_rule_new(path, access): i64 {
    var r = alloc(16);
    store64(r, path);
    store64(r + 8, access);
    return r;
}

fn security_fs_rule_path(r): i64 { return load64(r); }
fn security_fs_rule_access(r): i64 { return load64(r + 8); }

fn security_fs_rule_read_only(path): i64 { return security_fs_rule_new(path, FS_READ_ONLY); }
fn security_fs_rule_read_write(path): i64 { return security_fs_rule_new(path, FS_READ_WRITE); }

# ================================================================
# Apply Landlock filesystem restrictions
# ================================================================

# rules: vec of fs_rule pointers, count: number of rules
# Returns Result: Ok(0) on success, Err on failure.
fn security_apply_landlock(rules, count): i64 {
    return security_apply_landlock_scoped(rules, count, 0);
}

# The same, with landlock scopes (ABI v6, applied since 3.13.2). `scopes` is a
# mask of LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET and LANDLOCK_SCOPE_SIGNAL: the
# process may then connect to an abstract unix socket, or signal a process,
# only inside its own landlock domain. A ruleset of scopes alone handles no
# filesystem right, so `count == 0` with a scope still installs one. A kernel
# older than ABI v6 cannot express a scope, and the scopes are left out there,
# as a kernel without landlock leaves out the whole ruleset.
fn security_apply_landlock_scoped(rules, count, scopes): i64 {
    if (count <= 0 && scopes == 0) { return Ok(0); }

    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no Landlock (a Linux LSM/MAC primitive). FS confinement on AGNOS
    # is the capability layer's responsibility, so report a structured "unsupported
    # on this platform" the system process can surface + branch on — the same way
    # mac.cyr handles SELinux/AppArmor and kernel_audit.cyr handles NETLINK_AUDIT.
    # This is deliberately NOT a silent Ok(0): a silent success would falsely imply
    # the sandbox's FS rules were enforced. Transitional — until AGNOS ships its own
    # FS-confinement mechanism (the native capability-layer Landlock-equivalent),
    # at which point this branch calls that instead of returning unsupported.
    return kavach_err_not_supported("LANDLOCK");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS

    # 3.11.1 — every right the running kernel knows, not the three that happened
    # to be declared. Unhandled rights are PERMITTED by Landlock, so the mask is
    # the entire security surface.
    var abi = security_landlock_abi_version();
    if (abi == 0) { return Ok(0); }
    var handled_access = 0;
    if (count > 0) { handled_access = _landlock_handled_access(abi); }
    var scoped = 0;
    if (abi >= 6) {
        scoped = scopes & (LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET | LANDLOCK_SCOPE_SIGNAL);
    }
    if (handled_access == 0 && scoped == 0) { return Ok(0); }

    # SAFETY: LandlockRulesetAttr is { handled_access_fs: u64,
    # handled_access_net: u64 (ABI v4), scoped: u64 (ABI v6) }, 24 bytes, and
    # `attr` is 24 bytes. Function-local `var X[N]` is N BYTES (cyrius 6.3.13
    # moved these to the guard-paged thread stack), so every store64 below lands
    # inside it. With no scope only the first 8 bytes are passed, the struct
    # every landlock kernel knows; an older kernel refuses a longer one whose
    # tail it cannot read as zero.
    var attr[24];
    store64(&attr, handled_access);
    store64(&attr + 8, 0);
    store64(&attr + 16, scoped);
    var attr_size = 8;
    if (scoped != 0) { attr_size = 24; }

    var ruleset_fd = syscall(SYS_LANDLOCK_CREATE_RULESET, &attr, attr_size, 0);
    if (ruleset_fd < 0) {
        var errno = 0 - ruleset_fd;
        if (errno == ENOSYS) { return Ok(0); }
        if (errno == EOPNOTSUPP) { return Ok(0); }
        return kavach_err_syscall_failed(errno, "landlock_create_ruleset failed");
    }
    defer { syscall(SYS_CLOSE, ruleset_fd); }

    # 3.11.3: bound the walk by the list as well as the count. A caller asking
    # for a ruleset with **no** path-beneath rules — total filesystem denial,
    # which `policy_landlock_deny_all` expresses as a non-zero count over an
    # empty list — must create and enforce the ruleset without indexing past
    # the end of it. `count == 0` with no scope still means "no landlock at
    # all", which is a different request and stays different; with a scope it
    # is a ruleset handling no filesystem right, and the walk adds nothing.
    var walk = count;
    if (walk < 0) { walk = 0; }
    if (rules == 0) { walk = 0; }
    else { if (vec_len(rules) < walk) { walk = vec_len(rules); } }

    var idx = 0;
    while (idx < walk) {
        var rule = vec_get(rules, idx);
        var access = security_fs_rule_access(rule);

        var allowed_access = 0;
        if (access == FS_READ_ONLY) {
            allowed_access = _landlock_allow_read_only();
        }
        elif (access == FS_READ_WRITE) {
            allowed_access = _landlock_allow_read_write(abi);
        }

        if (allowed_access != 0) {
            var path = security_fs_rule_path(rule);
            # O_PATH = 0x200000, O_CLOEXEC = 0x80000
            var path_fd = sys_open(path, 0x280000, 0);
            if (path_fd < 0) {
                return kavach_err_syscall_failed(0 - path_fd, "landlock open path failed");
            }

            # A rule naming a file (anything but a directory, the open having
            # followed a symlink) grants that file alone, and takes only the
            # rights a file can hold. Until this was masked, the directory
            # rights in both access masks made `landlock_add_rule` refuse every
            # file rule with EINVAL, so any policy naming a file failed its exec
            # closed (exit 124).
            # SAFETY: `st` is 144 bytes, no smaller than struct stat on x86-64
            # (144) or aarch64 (128), and STAT_MODE is the stdlib's per-arch
            # offset of the 32-bit st_mode inside it.
            var st[144];
            var sr = sys_fstat(path_fd, &st);
            if (sr < 0) {
                syscall(SYS_CLOSE, path_fd);
                return kavach_err_syscall_failed(0 - sr, "landlock stat path failed");
            }
            if ((load32(&st + STAT_MODE) & 61440) != 16384) {   # not S_IFDIR
                allowed_access = allowed_access & _landlock_file_rights();
            }

            # LandlockPathBeneathAttr: { allowed_access: u64, parent_fd: i32 }
            # Layout: 8 bytes access + 4 bytes fd = 12 bytes (pad to 16)
            var beneath[16];
            store64(&beneath, allowed_access);
            store32(&beneath + 8, path_fd);

            var ret = syscall(SYS_LANDLOCK_ADD_RULE,
              ruleset_fd, LANDLOCK_RULE_PATH_BENEATH, &beneath, 0);
            syscall(SYS_CLOSE, path_fd);

            if (ret < 0) {
                return kavach_err_syscall_failed(0 - ret, "landlock_add_rule failed");
            }
        }
        idx = idx + 1;
    }

    # Set no_new_privs (required by Landlock)
    var ret = syscall(SYS_PRCTL, 38, 1, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_NO_NEW_PRIVS failed");
    }

    ret = syscall(SYS_LANDLOCK_RESTRICT_SELF, ruleset_fd, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "landlock_restrict_self failed");
    }

    return Ok(0);
    #endif
}

# ================================================================
# Seccomp BPF
# ================================================================

# BPF instruction constants
enum BpfConst {
    BPF_LD_W_ABS = 0x20;
    BPF_JMP_JEQ_K = 0x15;
    BPF_JMP_JGE_K = 0x35;
    BPF_JMP_JSET_K = 0x45;
    BPF_RET_K = 0x06;
    SECCOMP_RET_ALLOW = 0x7FFF0000;
    SECCOMP_RET_ERRNO = 0x00050000;     # | errno, returned to the caller
    SECCOMP_RET_KILL_PROCESS = 0x80000000;
    SECCOMP_RET_TRAP = 0x00030000;
    BPF_MAXINSNS = 4096;
    PR_SET_NO_NEW_PRIVS = 38;
    PR_SET_SECCOMP = 22;
    SECCOMP_MODE_FILTER = 2;
    # struct seccomp_data (linux/seccomp.h): int nr at +0, __u32 arch at +4.
    SECCOMP_DATA_NR = 0;
    SECCOMP_DATA_ARCH = 4;
    SECCOMP_DATA_ARG0 = 16;             # __u64 args[6]; the low word, little-endian
    # clone(2)'s CLONE_NEW* flags (linux/sched.h): NEWNS | NEWCGROUP | NEWUTS |
    # NEWIPC | NEWUSER | NEWPID | NEWNET. CLONE_NEWTIME (0x80) is left out: in
    # clone() that bit is part of the exit signal, and the kernel accepts
    # NEWTIME only from unshare and clone3, both handled on their own.
    SECCOMP_CLONE_NS_FLAGS = 0x7E020000;
    # An x32-ABI call enters as AUDIT_ARCH_X86_64 with this bit set in nr
    # (__X32_SYSCALL_BIT, asm/unistd.h).
    X32_SYSCALL_BIT = 0x40000000;
}

# AUDIT_ARCH_* (linux/audit.h): EM_* | __AUDIT_ARCH_64BIT | __AUDIT_ARCH_LE.
enum AuditArch {
    AUDIT_ARCH_X86_64 = 0xC000003E;     # EM_X86_64 = 62
    AUDIT_ARCH_AARCH64 = 0xC00000B7;    # EM_AARCH64 = 183
}

# The one architecture a kavach filter admits: the one this binary was built
# for. A syscall number means nothing without its ABI — 101 is ptrace on
# x86-64, ioperm through the i386 `int 0x80` gate, and nanosleep on aarch64 —
# so every filter kills any other `seccomp_data.arch` before it reads `nr`.
fn security_seccomp_native_arch(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return AUDIT_ARCH_AARCH64;
    #endif
    #ifdef CYRIUS_ARCH_X86
    return AUDIT_ARCH_X86_64;
    #endif
}

# BPF sock_filter instruction — kernel ABI struct (8 bytes).
# Layout enforced by per-field widths; pointer-to-struct dot syntax
# emits store16/store8/store32 at the kernel-correct offsets.
struct bpf_insn {
    code: i16;
    jt: i8;
    jf: i8;
    k: i32;
}

# Write a BPF sock_filter instruction (8 bytes) to buf at offset.
# Write one classic-BPF instruction at `buf + offset`.
#
# Layout is the kernel's `struct sock_filter`, little-endian:
#   +0 u16 code   +2 u8 jt   +3 u8 jf   +4 u32 k
#
# Written with explicit byte stores rather than through a typed `bpf_insn`
# local. The typed form — `var insn: bpf_insn = buf + offset; insn.code = …` —
# compiled to a NO-OP under this toolchain: every field write was dropped and
# the buffer stayed zero-filled. Nothing failed loudly; the filter simply came
# out as 184 zero bytes, and PR_SET_SECCOMP rejected it with EINVAL, so
# **seccomp confinement was never actually applied by any caller**. The
# regression test below asserts the produced bytes, not just that the call
# returned — the previous shape "worked" by every check except the only one
# that mattered.
fn security_bpf_write_insn(buf, offset, code, jt, jf, k): i64 {
    store8(buf + offset, code & 255);
    store8(buf + offset + 1, (code >> 8) & 255);
    store8(buf + offset + 2, jt & 255);
    store8(buf + offset + 3, jf & 255);
    store8(buf + offset + 4, k & 255);
    store8(buf + offset + 5, (k >> 8) & 255);
    store8(buf + offset + 6, (k >> 16) & 255);
    store8(buf + offset + 7, (k >> 24) & 255);
    return 0;
}

# Load a seccomp-BPF filter into the calling process.
# filter: pointer to BPF bytecode, filter_len: total bytes.
# Returns Result.
fn security_load_seccomp(filter, filter_len): i64 {
    if (filter_len == 0) {
        return kavach_err_invalid_argument("empty seccomp filter");
    }
    if (filter_len % 8 != 0) {
        return kavach_err_invalid_argument("filter size not multiple of 8");
    }
    var num_insns = filter_len / 8;
    if (num_insns > BPF_MAXINSNS) {
        return kavach_err_invalid_argument("seccomp filter too large");
    }

    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no seccomp-BPF (a Linux syscall-filtering facility). Syscall-surface
    # restriction on AGNOS is the capability layer's job, so report a structured
    # "unsupported on this platform" (same pattern as Landlock above) rather than a
    # silent Ok(0) that would falsely imply the syscall surface was filtered. The
    # filter is still validated above. Transitional — until AGNOS provides native
    # syscall-surface filtering, at which point this branch calls that instead.
    return kavach_err_not_supported("SECCOMP");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS

    # Set no_new_privs
    var ret = syscall(SYS_PRCTL, PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_NO_NEW_PRIVS failed");
    }

    # sock_fprog: { u16 len, pad[6], u64 filter_ptr }
    # On x86_64: { u16 len (2 bytes), 6 pad, ptr (8 bytes) } = 16 bytes
    var prog[16];
    store16(&prog, num_insns);
    store64(&prog + 8, filter);

    ret = syscall(SYS_PRCTL, PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &prog, 0, 0);
    if (ret < 0) {
        return kavach_err_syscall_failed(0 - ret, "PR_SET_SECCOMP failed");
    }

    return Ok(0);
    #endif
}

# ---- Syscall tables --------------------------------------------------------
#
# A filter compares `seccomp_data.nr`, which is the KERNEL's number for the
# running architecture. So these tables hold native numbers, one column per
# architecture (x86-64: asm/unistd_64.h; aarch64: asm-generic/unistd.h), and
# deliberately NOT the stdlib's SYS_* names: the aarch64 peer spells some calls
# with x86 numbers that cyrius renumbers only at a syscall() site, and a BPF
# constant is data that is never renumbered. Until 3.12.8 the tables were the
# x86-64 column alone, so on aarch64 the exec-safe filter killed nanosleep (101)
# and let the real ptrace (117), mount (40) and unshare (97) through.

# Pick a table row's column: the number for the architecture this binary was
# built for. -1 marks a call that architecture does not have.
fn _seccomp_native_nr(x86_64_nr, aarch64_nr): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return aarch64_nr;
    #endif
    #ifdef CYRIUS_ARCH_X86
    return x86_64_nr;
    #endif
}

fn _seccomp_push(v, x86_64_nr, aarch64_nr): i64 {
    var nr = _seccomp_native_nr(x86_64_nr, aarch64_nr);
    if (nr >= 0) { vec_push(v, nr); }
    return 0;
}

# Syscalls denied by the exec-safe profile. These are the ones a container
# payload has no business making and that lead directly to host compromise or
# namespace escape. Ordered roughly by how often they appear in escape chains.
var _SECCOMP_DENY = 0;

fn _seccomp_deny_list() {
    if (_SECCOMP_DENY != 0) { return _SECCOMP_DENY; }
    var v = vec_new();
    #             x86-64, aarch64
    _seccomp_push(v, 165, 40);      # mount
    _seccomp_push(v, 166, 39);      # umount2
    _seccomp_push(v, 155, 41);      # pivot_root
    _seccomp_push(v, 272, 97);      # unshare        — re-namespacing after confinement
    _seccomp_push(v, 308, 268);     # setns          — entering another container's ns
    _seccomp_push(v, 101, 117);     # ptrace         — reading/writing sibling processes
    _seccomp_push(v, 310, 270);     # process_vm_readv
    _seccomp_push(v, 311, 271);     # process_vm_writev
    _seccomp_push(v, 175, 105);     # init_module
    _seccomp_push(v, 176, 106);     # delete_module
    _seccomp_push(v, 313, 273);     # finit_module
    _seccomp_push(v, 246, 104);     # kexec_load
    _seccomp_push(v, 169, 142);     # reboot
    _seccomp_push(v, 167, 224);     # swapon
    _seccomp_push(v, 168, 225);     # swapoff
    _seccomp_push(v, 321, 280);     # bpf
    _seccomp_push(v, 298, 241);     # perf_event_open
    _seccomp_push(v, 323, 282);     # userfaultfd    — a classic exploit-timing primitive
    _seccomp_push(v, 139, 0 - 1);   # sysfs          — x86-64 only
    _seccomp_push(v, 103, 116);     # syslog
    # The mount API that is not mount(2) (3.12.9). Each reaches what the denied
    # mount does: fsopen + fsconfig + fsmount + move_mount builds and attaches a
    # filesystem; open_tree + move_mount attaches a bind mount; mount_setattr
    # changes an existing mount's flags. Numbered since Linux 5.1 in the shared
    # table, so both columns agree. An older kernel returns ENOSYS for them anyway.
    _seccomp_push(v, 428, 428);     # open_tree
    _seccomp_push(v, 429, 429);     # move_mount
    _seccomp_push(v, 430, 430);     # fsopen
    _seccomp_push(v, 431, 431);     # fsconfig
    _seccomp_push(v, 432, 432);     # fsmount
    _seccomp_push(v, 433, 433);     # fspick
    _seccomp_push(v, 442, 442);     # mount_setattr
    _seccomp_push(v, 467, 467);     # open_tree_attr (Linux 6.15)
    _SECCOMP_DENY = v;
    return v;
}

# Syscalls the basic (allowlist) profile permits.
var _SECCOMP_ALLOW = 0;

fn _seccomp_allow_list() {
    if (_SECCOMP_ALLOW != 0) { return _SECCOMP_ALLOW; }
    var v = vec_new();
    #             x86-64, aarch64
    _seccomp_push(v, 0, 63);        # read
    _seccomp_push(v, 1, 64);        # write
    _seccomp_push(v, 3, 57);        # close
    _seccomp_push(v, 5, 80);        # fstat
    _seccomp_push(v, 9, 222);       # mmap
    _seccomp_push(v, 10, 226);      # mprotect
    _seccomp_push(v, 11, 215);      # munmap
    _seccomp_push(v, 12, 214);      # brk
    _seccomp_push(v, 15, 139);      # rt_sigreturn
    _seccomp_push(v, 60, 93);       # exit
    _seccomp_push(v, 131, 132);     # sigaltstack
    _seccomp_push(v, 158, 0 - 1);   # arch_prctl     — x86-64 only
    _seccomp_push(v, 186, 178);     # gettid
    _seccomp_push(v, 202, 98);      # futex
    _seccomp_push(v, 218, 96);      # set_tid_address
    _seccomp_push(v, 231, 94);      # exit_group
    _seccomp_push(v, 273, 99);      # set_robust_list
    _seccomp_push(v, 318, 278);     # getrandom
    _seccomp_push(v, 228, 113);     # clock_gettime
    _seccomp_push(v, 334, 293);     # rseq
    _SECCOMP_ALLOW = v;
    return v;
}

# ---- Architecture check ----------------------------------------------------
#
# Every filter opens with it:
#
#   0  LD   seccomp_data.arch
#   1  JEQ  <native AUDIT_ARCH>, jt 1         match: skip the KILL
#   2  RET  KILL_PROCESS                      any other ABI
#   3  LD   seccomp_data.nr
#   4  JGE  X32_SYSCALL_BIT -> kill_idx       x86-64 only
#
# Without it a filter keyed on numbers alone is the pitfall seccomp(2) warns
# about. A 64-bit x86 process can still enter the kernel through the i386 gate
# (`int 0x80`), where every number means a different call: i386 21 is mount,
# which the x86-64 table reads as access and allows. An x32 call enters as
# AUDIT_ARCH_X86_64 with bit 30 set in nr, so it matches no x86-64 entry. Each
# is now killed, and so is a 32-bit payload: a filter loaded before exec stays
# in force, and an i386 or AArch32 binary's first syscall carries a foreign
# arch. systemd.exec(5) recommends the same restriction,
# SystemCallArchitectures=native, so that "secondary ABIs may not be used to
# circumvent the restrictions applied to the native ABI".

fn _seccomp_prologue_len(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return 4;
    #endif
    #ifdef CYRIUS_ARCH_X86
    return 5;
    #endif
}

# Write the prologue into `filter`; `kill_idx` is the index of the filter's RET
# KILL instruction. Returns the prologue length, the first free index.
fn _seccomp_write_prologue(filter, kill_idx): i64 {
    security_bpf_write_insn(filter, 0, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARCH);
    security_bpf_write_insn(filter, 8, BPF_JMP_JEQ_K, 1, 0, security_seccomp_native_arch());
    security_bpf_write_insn(filter, 16, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);
    security_bpf_write_insn(filter, 24, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_NR);
    #ifdef CYRIUS_ARCH_X86
    # A BPF jump counts instructions to SKIP: from index 4, kill_idx is
    # kill_idx - 5 ahead.
    security_bpf_write_insn(filter, 32, BPF_JMP_JGE_K, kill_idx - 5, 0, X32_SYSCALL_BIT);
    #endif
    return _seccomp_prologue_len();
}

# Build a filter: prologue, one JEQ per `nrs` entry jumping to `hit_action`,
# then the fall-through action, then the hit action. `jt` is a u8 on the wire
# (at most 255 instructions to skip); the tables above hold ~20 entries.
#
#   p .. p+n-1   JEQ nrs[i] -> hit        (jt = n - i)
#   p+n          RET miss_action
#   p+n+1        RET hit_action
#
# The architecture check needs a KILL to jump to. For the deny-list profile it
# is the hit instruction (p+n+1); for the allowlist it is the miss (p+n).
fn _seccomp_build(nrs, hit_action, miss_action): i64 {
    var n = vec_len(nrs);
    var p = _seccomp_prologue_len();
    var miss_idx = p + n;
    var hit_idx = p + n + 1;
    var kill_idx = hit_idx;
    if (miss_action == SECCOMP_RET_KILL_PROCESS) { kill_idx = miss_idx; }
    var filter_size = (hit_idx + 1) * 8;
    var filter = alloc(filter_size);

    _seccomp_write_prologue(filter, kill_idx);
    # From index p+i, the jump to hit_idx skips hit_idx - (p+i) - 1 = n - i.
    var i = 0;
    while (i < n) {
        security_bpf_write_insn(filter, (p + i) * 8, BPF_JMP_JEQ_K,
          n - i, 0, vec_get(nrs, i));
        i = i + 1;
    }
    security_bpf_write_insn(filter, miss_idx * 8, BPF_RET_K, 0, 0, miss_action);
    security_bpf_write_insn(filter, hit_idx * 8, BPF_RET_K, 0, 0, hit_action);

    var info = alloc(16);
    store64(info, filter);
    store64(info + 8, filter_size);
    return Ok(info);
}

# Create a seccomp filter that can be installed BEFORE execve.
# Returns Result: Ok(info) where info is {ptr, len}.
#
# **This is a DENY-list (default ALLOW), unlike
# security_create_basic_seccomp_filter's ~20-syscall allowlist, and the
# difference is deliberate rather than lazy.**
#
# The allowlist profile is designed for a process already running its payload:
# it permits read/write/mmap/futex and friends, and does NOT permit execve. Load
# it before an exec and the kernel kills the child on the very syscall that
# starts it — so it is unusable on any spawn path, which is why the detached
# spawn needs this variant.
#
# A default-deny profile usable pre-exec would need to allowlist execve plus the
# whole dynamic-loader surface (openat, mmap, mprotect, access, newfstatat, …)
# and then everything the payload itself uses — in practice the ~300-entry list
# the OCI default profile carries. That list is a policy artifact, not something
# this function should invent. Until it exists, blocking the ~20 syscalls that
# actually appear in container-escape chains is the honest, applicable middle:
# strictly better than no filter, and explicitly weaker than the allowlist.
#
# Layout (n denied numbers, p prologue instructions):
#
#   p .. p+n-1   JEQ deny[i] -> KILL
#   p+n          JEQ clone3  -> ERRNO(ENOSYS)
#   p+n+1        JEQ clone   -> next, else ALLOW
#   p+n+2        LD  args[0]                       clone's flags
#   p+n+3        JSET SECCOMP_CLONE_NS_FLAGS -> KILL, else ALLOW
#   p+n+4        RET ALLOW
#   p+n+5        RET ERRNO | ENOSYS
#   p+n+6        RET KILL
#
# 40 instructions on x86-64, 38 on aarch64.
#
# **Why the clone tail (3.12.9).** unshare and setns are denied because a
# payload must not re-namespace itself, but clone(2) creates namespaces too:
# CLONE_NEWUSER | CLONE_NEWNS makes a child that can mount in its own mount
# namespace, which is the thing the mount entries above deny. A filter can
# test clone's flags because they are an argument. clone3(2) passes them in a
# struct that seccomp cannot read, so it gets ENOSYS rather than KILL: glibc
# answers ENOSYS by falling back to clone, which the filter can test. Payloads
# that fork, spawn threads or run posix_spawn keep working.
fn security_create_exec_seccomp_filter(): i64 {
    var deny = _seccomp_deny_list();
    var n = vec_len(deny);
    var p = _seccomp_prologue_len();
    var allow_idx = p + n + 4;
    var errno_idx = p + n + 5;
    var kill_idx = p + n + 6;
    var filter_size = (kill_idx + 1) * 8;
    var filter = alloc(filter_size);

    _seccomp_write_prologue(filter, kill_idx);
    # From index p+i, the jump to kill_idx skips kill_idx - (p+i) - 1 = n + 5 - i.
    var i = 0;
    while (i < n) {
        security_bpf_write_insn(filter, (p + i) * 8, BPF_JMP_JEQ_K,
          n + 5 - i, 0, vec_get(deny, i));
        i = i + 1;
    }
    var at = p + n;
    security_bpf_write_insn(filter, at * 8, BPF_JMP_JEQ_K,
      errno_idx - at - 1, 0, _seccomp_native_nr(435, 435));          # clone3
    at = at + 1;
    security_bpf_write_insn(filter, at * 8, BPF_JMP_JEQ_K,
      0, allow_idx - at - 1, _seccomp_native_nr(56, 220));           # clone
    at = at + 1;
    security_bpf_write_insn(filter, at * 8, BPF_LD_W_ABS, 0, 0, SECCOMP_DATA_ARG0);
    at = at + 1;
    security_bpf_write_insn(filter, at * 8, BPF_JMP_JSET_K,
      kill_idx - at - 1, allow_idx - at - 1, SECCOMP_CLONE_NS_FLAGS);
    security_bpf_write_insn(filter, allow_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ALLOW);
    security_bpf_write_insn(filter, errno_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_ERRNO | ENOSYS);
    security_bpf_write_insn(filter, kill_idx * 8, BPF_RET_K, 0, 0, SECCOMP_RET_KILL_PROCESS);

    var info = alloc(16);
    store64(info, filter);
    store64(info + 8, filter_size);
    return Ok(info);
}

# Create a basic seccomp filter allowing safe syscalls.
# Returns Result: Ok(filter_ptr) where payload is {ptr, len}.
# The caller must use the returned pointer and length with security_load_seccomp.
#
# Layout: the architecture check; one JEQ per allowed nr jumping to ALLOW;
# RET KILL; RET ALLOW. 27 instructions on x86-64, 25 on aarch64 (which has no
# arch_prctl). Until 3.12.8 this was 23 hand-written instructions of x86-64
# numbers with no architecture check.
fn security_create_basic_seccomp_filter(): i64 {
    return _seccomp_build(_seccomp_allow_list(), SECCOMP_RET_ALLOW,
      SECCOMP_RET_KILL_PROCESS);
}

# Get filter pointer from security_create_basic_seccomp_filter result
fn security_seccomp_filter_ptr(info): i64 { return load64(info); }
fn security_seccomp_filter_len(info): i64 { return load64(info + 8); }

# ================================================================
# Namespace creation
# ================================================================

enum CloneFlag {
    CLONE_NEWNET = 0x40000000;
    CLONE_NEWNS = 0x00020000;
    CLONE_NEWPID = 0x20000000;
    CLONE_NEWUSER = 0x10000000;
}

enum NsFlag {
    NS_NETWORK = 1;
    NS_MOUNT = 2;
    NS_PID = 4;
    NS_USER = 8;
}

# SYS_UNSHARE is kavach's own x86-64 number, from src/sys_security_syscalls.cyr.

# Create new namespace(s) with specified flags.
# flags: bitwise OR of NS_NETWORK, NS_MOUNT, NS_PID, NS_USER
# Returns Result.
fn security_create_namespace(flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no Linux namespaces / unshare(2). Process isolation on AGNOS is the
    # capability layer's job, so report a structured "unsupported on this platform"
    # (same pattern as Landlock/seccomp) rather than a silent Ok(0) that would falsely
    # imply isolation was applied. Transitional — until AGNOS provides native
    # isolation primitives, at which point this branch calls those instead.
    return kavach_err_not_supported("NAMESPACES");
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    # **Refused on aarch64 until the stdlib names unshare(2).** Through 3.12.7 this
    # issued x86-64 272, which cyrius does not renumber, so aarch64 ran kcmp(2)
    # with the clone flags as a pid; it failed, closed, but no namespace was ever
    # made. The native number (97) cannot be written here: cyrius's rule is never
    # to put an aarch64-native number under an aarch64 #ifdef, because its
    # x86-number translation matches on the number alone and a row added later
    # silently takes it over. The call returns when the stdlib declares SYS_UNSHARE
    # (filed upstream at 3.12.8).
    return kavach_err_not_supported("NAMESPACES");
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_ARCH_AARCH64
    var sflags = 0;
    if ((flags & NS_NETWORK) != 0) { sflags = sflags | CLONE_NEWNET; }
    if ((flags & NS_MOUNT) != 0) { sflags = sflags | CLONE_NEWNS; }
    if ((flags & NS_PID) != 0) { sflags = sflags | CLONE_NEWPID; }
    if ((flags & NS_USER) != 0) { sflags = sflags | CLONE_NEWUSER; }

    var ret = syscall(SYS_UNSHARE, sflags);
    if (ret < 0) {
        var errno = 0 - ret;
        if (errno == EPERM) { return kavach_err_permission_denied("security_create_namespace"); }
        if (errno == EINVAL) { return kavach_err_invalid_argument("security_create_namespace: invalid flags"); }
        return kavach_err_syscall_failed(errno, "unshare failed");
    }

    return Ok(0);
    #endif
    #endif
}

# ================================================================
# Syscall name to number mapping (hashmap, O(1) lookup)
# ================================================================

var _syscall_map = 0;

fn security_syscall_map_reset(): i64 { _syscall_map = 0; return 0; }

fn _syscall_map_init(): i64 {
    if (_syscall_map != 0) { return 0; }
    _syscall_map = map_new();
    #                 name, x86-64, aarch64
    _syscall_map_row("read", 0, 63);
    _syscall_map_row("write", 1, 64);
    _syscall_map_row("open", 2, 0 - 1);
    _syscall_map_row("close", 3, 57);
    _syscall_map_row("stat", 4, 0 - 1);
    _syscall_map_row("fstat", 5, 80);
    _syscall_map_row("lseek", 8, 62);
    _syscall_map_row("mmap", 9, 222);
    _syscall_map_row("mprotect", 10, 226);
    _syscall_map_row("munmap", 11, 215);
    _syscall_map_row("brk", 12, 214);
    _syscall_map_row("rt_sigreturn", 15, 139);
    _syscall_map_row("ioctl", 16, 29);
    _syscall_map_row("access", 21, 0 - 1);
    _syscall_map_row("pipe", 22, 0 - 1);
    _syscall_map_row("dup", 32, 23);
    _syscall_map_row("dup2", 33, 0 - 1);
    _syscall_map_row("getpid", 39, 172);
    _syscall_map_row("socket", 41, 198);
    _syscall_map_row("connect", 42, 203);
    _syscall_map_row("accept", 43, 202);
    _syscall_map_row("sendto", 44, 206);
    _syscall_map_row("recvfrom", 45, 207);
    _syscall_map_row("bind", 49, 200);
    _syscall_map_row("listen", 50, 201);
    _syscall_map_row("fork", 57, 0 - 1);
    _syscall_map_row("execve", 59, 221);
    _syscall_map_row("exit", 60, 93);
    _syscall_map_row("wait4", 61, 260);
    _syscall_map_row("kill", 62, 129);
    _syscall_map_row("fcntl", 72, 25);
    _syscall_map_row("fsync", 74, 82);
    _syscall_map_row("getcwd", 79, 17);
    _syscall_map_row("chdir", 80, 49);
    _syscall_map_row("mkdir", 83, 0 - 1);
    _syscall_map_row("rmdir", 84, 0 - 1);
    _syscall_map_row("unlink", 87, 0 - 1);
    _syscall_map_row("chmod", 90, 0 - 1);
    _syscall_map_row("getuid", 102, 174);
    _syscall_map_row("getgid", 104, 176);
    _syscall_map_row("geteuid", 107, 175);
    _syscall_map_row("getegid", 108, 177);
    _syscall_map_row("getppid", 110, 173);
    _syscall_map_row("setsid", 112, 157);
    _syscall_map_row("prctl", 157, 167);
    _syscall_map_row("mount", 165, 40);
    _syscall_map_row("umount2", 166, 39);
    _syscall_map_row("gettid", 186, 178);
    _syscall_map_row("futex", 202, 98);
    _syscall_map_row("getdents64", 217, 61);
    _syscall_map_row("set_tid_address", 218, 96);
    _syscall_map_row("clock_gettime", 228, 113);
    _syscall_map_row("exit_group", 231, 94);
    _syscall_map_row("openat", 257, 56);
    _syscall_map_row("set_robust_list", 273, 99);
    _syscall_map_row("pipe2", 293, 59);
    _syscall_map_row("epoll_create1", 291, 20);
    _syscall_map_row("getrandom", 318, 278);
    _syscall_map_row("rseq", 334, 293);
    return 0;
}

# One name-map row: the number for the architecture this binary was built
# for. A name that architecture does not have (-1) is left out, so it maps
# to -1 rather than to some other call's number.
fn _syscall_map_row(name, x86_64_nr, aarch64_nr): i64 {
    var nr = _seccomp_native_nr(x86_64_nr, aarch64_nr);
    if (nr >= 0) { map_set(_syscall_map, name, nr); }
    return 0;
}

# Map a syscall name to its number on the architecture this binary was built
# for. Returns -1 if not found, including for a name that architecture does not
# have: aarch64 has no open, stat, access, pipe, dup2, fork, mkdir, rmdir,
# unlink or chmod (its libc uses the *at forms, pipe2, dup3 and clone). Until
# 3.12.8 this returned the x86-64 number on every architecture.
fn security_syscall_name_to_nr(name): i64 {
    _syscall_map_init();
    if (map_has(_syscall_map, name) == 1) {
        return map_get(_syscall_map, name);
    }
    return 0 - 1;
}
