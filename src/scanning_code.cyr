    if (_cg_hit("yum install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "yum install");
    }
    if (_cg_hit("dnf install") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "dnf install");
    }
    if (_cg_hit("pacman -s") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "supply_chain", "Package install", "pacman -s");
    }
    return 0;
}

fn _cg_remote_script(text, lower, result) {
    if (_cg_hit("curl | sh") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "curl | sh");
    }
    if (_cg_hit("curl | bash") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "curl | bash");
    }
    if (_cg_hit("wget -o - |") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "wget -o - |");
    }
    if (_cg_hit("curl -ssl |") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "supply_chain", "Remote script execution", "curl -ssl |");
    }
    return 0;
}

fn _cg_dyn_import(text, lower, result) {
    if (_cg_hit("require(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "supply_chain", "Dynamic require/import", "require(");
    }
    if (_cg_hit("import(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "supply_chain", "Dynamic require/import", "import(");
    }
    if (_cg_hit("__import__(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "supply_chain", "Dynamic require/import", "__import__(");
    }
    return 0;
}

fn _cg_base64(text, lower, result) {
    if (_cg_hit("atob(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "atob(");
    }
    if (_cg_hit("base64 -d") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "base64 -d");
    }
    if (_cg_hit("base64 --decode") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "base64 --decode");
    }
    if (_cg_hit("b64decode") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Base64 decode", "b64decode");
    }
    return 0;
}

fn _cg_unicode_esc(text, lower, result) {
    if (_cg_hit("\\u00") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Unicode escape", "\\u00");
    }
    if (_cg_hit("\\x00") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Unicode escape", "\\x00");
    }
    if (_cg_hit("string.fromcharcode") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "obfuscation", "Unicode escape", "string.fromcharcode");
    }
    return 0;
}

fn _cg_hex_enc(text, lower, result) {
    if (_cg_hit("\\x") == 1) {
        return code_emit(text, lower, result,
          Severity.LOW, "obfuscation", "Hex encoding", "\\x");
    }
    if (_cg_hit("fromhex(") == 1) {
        return code_emit(text, lower, result,
          Severity.LOW, "obfuscation", "Hex encoding", "fromhex(");
    }
    if (_cg_hit("hex.decode") == 1) {
        return code_emit(text, lower, result,
          Severity.LOW, "obfuscation", "Hex encoding", "hex.decode");
    }
    return 0;
}

fn _cg_sens_path(text, lower, result) {
    if (_cg_hit("/etc/shadow") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/etc/shadow");
    }
    if (_cg_hit("/etc/passwd") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/etc/passwd");
    }
    if (_cg_hit("/etc/sudoers") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/etc/sudoers");
    }
    if (_cg_hit("/.ssh/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.ssh/");
    }
    if (_cg_hit("/.gnupg/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.gnupg/");
    }
    if (_cg_hit("/.aws/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.aws/");
    }
    if (_cg_hit("/.kube/") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/.kube/");
    }
    if (_cg_hit("/dev/mem") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/dev/mem");
    }
    if (_cg_hit("/dev/kmem") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/dev/kmem");
    }
    if (_cg_hit("/proc/kcore") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Sensitive path access", "/proc/kcore");
    }
    return 0;
}

fn _cg_traversal(text, lower, result) {
    if (_cg_hit("../") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "filesystem_abuse", "Path traversal", "../");
    }
    if (_cg_hit("..\\") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "filesystem_abuse", "Path traversal", "..\\");
    }
    return 0;
}

fn _cg_destructive(text, lower, result) {
    if (_cg_hit("rm -rf") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "rm -rf");
    }
    if (_cg_hit("dd if=") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "dd if=");
    }
    if (_cg_hit("mkfs.") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "mkfs.");
    }
    if (_cg_hit("shred ") == 1) {
        return code_emit(text, lower, result,
          Severity.CRITICAL, "filesystem_abuse", "Destructive operation", "shred ");
    }
    return 0;
}

fn _cg_weak_hash(text, lower, result) {
    if (_cg_hit("md5(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "crypto_misuse", "Weak hash", "md5(");
    }
    if (_cg_hit("sha1(") == 1) {
        return code_emit(text, lower, result,
          Severity.MEDIUM, "crypto_misuse", "Weak hash", "sha1(");
    }
    return 0;
}

fn _cg_hardcoded_key(text, lower, result) {
    if (_cg_hit("aes_key =") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "crypto_misuse", "Hardcoded key", "aes_key =");
    }
    if (_cg_hit("encryption_key =") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "crypto_misuse", "Hardcoded key", "encryption_key =");
    }
    if (_cg_hit("secret_key =") == 1) {
        return code_emit(text, lower, result,
          Severity.HIGH, "crypto_misuse", "Hardcoded key", "secret_key =");
    }
    return 0;
}

# ---- main scan -----------------------------------------------------------

fn code_scan(text, result) {
    var n = strlen(text);
    var lower = alloc(n + 1);
    str_to_lower_into(text, lower);

    # Single Aho-Corasick pass over the lowered text replaces the ~109
    # per-pattern re-scans the groups below used to do. Results go into the
    # module-global hit table the groups read via _cg_hit().
    var ac = _cg_automaton();
    _cg_hits = ac_hits_new(ac);
    _cg_lower = lower;
    ac_search(ac, lower, n, _cg_hits);

    _cg_shell_exec(text, lower, result);
    _cg_process_spawn(text, lower, result);
    _cg_eval_exec(text, lower, result);
    _cg_shell_invoc(text, lower, result);
    _cg_shell_meta(text, lower, result);
    _cg_pipe_shell(text, lower, result);
    _cg_http_req(text, lower, result);
    _cg_dns_exfil(text, lower, result);
    _cg_reverse_shell(text, lower, result);
    _cg_net_tools(text, lower, result);
    _cg_sudo(text, lower, result);
    _cg_perm_change(text, lower, result);
    _cg_kernel_mod(text, lower, result);
    _cg_mount(text, lower, result);
    _cg_capability(text, lower, result);
    _cg_pkg_install(text, lower, result);
    _cg_remote_script(text, lower, result);
    _cg_dyn_import(text, lower, result);
    _cg_base64(text, lower, result);
    _cg_unicode_esc(text, lower, result);
    _cg_hex_enc(text, lower, result);
    _cg_sens_path(text, lower, result);
    _cg_traversal(text, lower, result);
    _cg_destructive(text, lower, result);
    _cg_weak_hash(text, lower, result);
    _cg_hardcoded_key(text, lower, result);
    return 0;
}
