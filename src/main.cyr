include "src/sandbox_exec.cyr"

fn _print_banner() {
    var banner = "kavach v3.2.0 — Cyrius port\n";
    sys_write(1, banner, strlen(banner));
    return 0;
}

fn _print_scoreboard() {
    var p = policy_strict();
    var best = resolve_best_backend(p);
    var score = score_backend(best, p);
    var prefix = "  best backend: ";
    sys_write(1, prefix, strlen(prefix));
    var name = os_backend_name(best);
    sys_write(1, name, strlen(name));
    sys_write(1, "\n", 1);
    var sp = "  score: ";
    sys_write(1, sp, strlen(sp));
    print_num(score);
    sys_write(1, " (", 2);
    var label = score_label(score);
    sys_write(1, label, strlen(label));
    sys_write(1, ")\n", 2);
    return 0;
}

fn main() {
    kavach_init();
    _print_banner();
    _print_scoreboard();

    # End-to-end demo: noop sandbox + safe exec + audit chain
    var cfg = config_new();
    config_backend(cfg, Backend.NOOP);
    var sb = sandbox_create(cfg);
    if (sb == 0) { return 1; }

    var chain = audit_chain_open("/tmp/kavach-demo.audit", "kavach-demo-key", 15);
    sandbox_exec_set_audit_chain(chain);

    sandbox_transition(sb, SandboxState.RUNNING);
    var r = sandbox_exec(sb, "echo hello");
    if (r == 0) {
        var msg = "  exec: blocked\n";
        sys_write(1, msg, strlen(msg));
    }
    else {
        var msg = "  exec: passed\n";
        sys_write(1, msg, strlen(msg));
    }
    sandbox_destroy(sb);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
