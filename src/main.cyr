# kavach — sandbox execution framework
# Cyrius port from rust-old/ (25935 lines of Rust; archived in git history
# pre-3.1.1 — see the rust-old removal commit + the kavach-pre-rust-removal
# tag for the original tree).

include "src/util.cyr"
include "src/error.cyr"
# Internalized agnosys (agnodrm) Linux security backends (Landlock/seccomp = security.cyr,
# SELinux/AppArmor = mac.cyr, Linux audit = kernel_audit.cyr) + sys_error/sys_util
# support + the 6 agnos-only security syscall consts — the agnosys → agnodrm
# decomposition (kavach owns the LSM/MAC/audit backends it already consumed; the
# landlock/prctl numbers come from cyrius's lib/syscalls). Before their users.
include "src/sys_security_syscalls.cyr"
include "src/sys_error.cyr"
include "src/sys_util.cyr"
include "src/security.cyr"
include "src/mac.cyr"
include "src/kernel_audit.cyr"
include "src/backend.cyr"
include "src/policy.cyr"
include "src/scoring.cyr"
include "src/lifecycle.cyr"
include "src/scanning_types.cyr"
include "src/aho_corasick.cyr"
include "src/scanning_secrets.cyr"
include "src/scanning_code.cyr"
include "src/scanning_data.cyr"
include "src/scanning_gate.cyr"
include "src/scanning_runtime.cyr"
include "src/scanning_threat.cyr"
include "src/audit.cyr"
include "src/credential.cyr"
include "src/credential_http.cyr"
include "src/quarantine.cyr"
include "src/cgroup.cyr"
include "src/oci_spec.cyr"
include "src/confine.cyr"
