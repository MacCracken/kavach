[package]
name = "kavach"
version = "${file:VERSION}"
description = "Sandbox execution framework — 10 backends, strength scoring (0-100), 3-scanner externalization gate, HMAC audit chain, threat classification. Cyrius port of Rust v2.x."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/kavach"
language = "cyrius"
cyrius = "6.0.43"

[build]
entry = "src/main.cyr"
output = "build/kavach"

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius-stdlib modules vendored into lib/ by `cyrius deps`. kavach
# includes them transitively via the modules under src/; the list
# here mirrors the union of imports across src/, tests/, fuzz/, and
# benches/ so `cyrius deps` resolves the full set. lib/ is gitignored
# (see .gitignore) — `cyrius deps` is the source of truth.
[deps]
stdlib = [
    "alloc",
    "args",
    "assert",
    "bench",
    "bigint",
    "chrono",
    "ct",
    "dynlib",
    "fdlopen",
    "fmt",
    "fnptr",
    "freelist",
    "fs",
    "hashmap",
    "hashmap_fast",
    "io",
    "json",
    "keccak",
    "mmap",
    "net",
    "process",
    "random",
    "result",
    "sandhi",
    "slice",
    "str",
    "string",
    "syscalls",
    "tagged",
    "thread",
    "tls",
    "vec",
]

# External first-party deps. Resolved into lib/sigil.cyr by `cyrius deps`
# at the pinned tag — used by src/audit.cyr for HMAC-SHA256 of the
# audit chain and src/util.cyr for ct_eq constant-time comparisons.
#
# Pinned at 3.5.9 — latest. The cc 5.10.x asm-offset bisect that
# capped sigil at 2.9.0 (2.9.1 → 3.0.1 SIGILL on the ed25519-NI path,
# 3.1.0 on the aes-gcm-NI path) no longer applies under cc 6.0.40: the
# NI-path offsets are stable across the sigil 3.x line on the 6.0
# toolchain, validated by a clean build/test/bench run at this pin.
# Bump in lockstep with the cyrius pin and re-validate.
[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.5.9"
modules = ["dist/sigil.cyr"]

# Transitive override. sigil 3.5.9 pins agnosys 1.2.7 (authored for
# cc 6.0.1), which fails to compile under the cc 6.0.40 toolchain
# (6.0.x tightened slice-subscript codegen to require the lib/slice.cyr
# helpers). 1.3.0 is the latest agnosys (cc 6.0.24) and builds clean.
# Drop this override once sigil bumps its own agnosys pin upstream.
[deps.agnosys]
git = "https://github.com/MacCracken/agnosys.git"
tag = "1.3.0"
modules = ["dist/agnosys.cyr"]
