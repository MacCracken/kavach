[package]
name = "kavach"
version = "${file:VERSION}"
description = "Sandbox execution framework — 10 backends, strength scoring (0-100), 3-scanner externalization gate, HMAC audit chain, threat classification. Cyrius port of Rust v2.x."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/kavach"
language = "cyrius"
cyrius = "6.5.17"

[build]
entry = "src/main.cyr"
output = "build/kavach"

# ── Library surface ──────────────────────────────────────────────
# kavach is consumable at the source level as a single-file bundle,
# `dist/kavach.cyr` (committed). `modules` lists the domain `src/*.cyr`
# files, in dependency order, that `cyrius distlib` concatenates to
# (re)build that bundle (and its `dist/kavach.deps` stdlib sidecar).
# This is the standard first-party dist flow — same as sigil, patra,
# and bhumi: `[lib].modules` here is the generator's single source of
# truth; `src/lib.cyr` mirrors this order as the human-facing header.
#
# Regenerate with `cyrius distlib` after changing any [lib] module; CI
# gates freshness (.github/workflows/ci.yml "Verify dist bundle fresh":
# runs distlib, fails if dist/ differs). scripts/version-bump.sh also
# re-runs distlib so the bundle header restamps the version.
#
# src/main.cyr is INTENTIONALLY excluded — it is the in-tree program
# entry (its own `main()` + end-to-end demo + top-level
# `syscall(SYS_EXIT)`); bundling it would inline a `main()` and a demo
# into every consumer and duplicate the module bodies (same lesson
# bhumi/agnosys learned). src/lib.cyr is also excluded: it is a pure
# aggregation header (only `include` directives), so bundling it would
# add unresolved `include "src/..."` lines to the flat bundle.
[lib]
modules = [
    "src/util.cyr",
    "src/error.cyr",
    # Internalized agnosys (agnodrm) Linux security backends + sys_error/sys_util
    # support + the agnos-only security syscall consts. Before their users.
    "src/sys_security_syscalls.cyr",
    "src/sys_error.cyr",
    "src/sys_util.cyr",
    "src/security.cyr",
    "src/mac.cyr",
    "src/kernel_audit.cyr",
    "src/backend.cyr",
    "src/policy.cyr",
    "src/scoring.cyr",
    "src/lifecycle.cyr",
    "src/scanning_types.cyr",
    "src/aho_corasick.cyr",
    "src/scanning_secrets.cyr",
    "src/scanning_code.cyr",
    "src/scanning_data.cyr",
    "src/scanning_gate.cyr",
    "src/scanning_runtime.cyr",
    "src/scanning_threat.cyr",
    "src/audit.cyr",
    "src/credential.cyr",
    "src/credential_http.cyr",
    "src/quarantine.cyr",
    "src/cgroup.cyr",
    "src/oci_spec.cyr",
    "src/confine.cyr",
    "src/backend_dispatch.cyr",
    "src/backend_noop.cyr",
    "src/backend_process.cyr",
    "src/persistent.cyr",
    "src/spawn.cyr",
    "src/backend_gvisor.cyr",
    "src/backend_oci.cyr",
    "src/backend_wasm.cyr",
    "src/backend_sy_agnos.cyr",
    "src/backend_sgx.cyr",
    "src/backend_sev.cyr",
    "src/backend_tdx.cyr",
    "src/backend_firecracker.cyr",
    "src/composite.cyr",
    "src/observability.cyr",
    "src/attestation.cyr",
    "src/sandbox_exec.cyr",
]

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius-stdlib modules vendored into lib/ by `cyrius deps`. kavach
# includes them transitively via the modules under src/; the list
# here mirrors the union of imports across src/, tests/, fuzz/, and
# benches/ so `cyrius deps` resolves the full set. lib/ is gitignored
# (see .gitignore) — `cyrius deps` is the source of truth.
[deps]
stdlib = [
    "alloc",
    "args",
    "assert",
    "async",
    # bayan = the 6.1.x consolidated data module (subsumes the pre-6.1
    # standalone `json` + `base64` stdlib modules, which no longer ship
    # as separate files). kavach does not parse JSON or decode base64
    # directly — its oci_json_escape is hand-rolled (src/oci_spec.cyr) —
    # but `bayan` is kept declared so `cyrius deps` resolves the union
    # that the vendored sandhi/sigil bundles forward-reference under the
    # single-pass loader. Replaced the retired `json` entry at 3.4.2.
    "bayan",
    "bench",
    "chrono",
    "ct",
    "dynlib",
    "fdlopen",
    "fmt",
    "fnptr",
    "freelist",
    "fs",
    "hashmap",
    "hashmap_fast",
    "io",
    "keccak",
    "math",
    "sakshi",
    "atomic",
    "mmap",
    "net",
    "process",
    "random",
    "result",
    "sandhi",
    "slice",
    "str",
    "string",
    "syscalls",
    "tagged",
    "thread",
    "thread_local",
    "tls",
    "vec",
]

# External first-party deps. Resolved into lib/sigil.cyr by `cyrius deps`
# at the pinned tag — used by src/audit.cyr for HMAC-SHA256 of the
# audit chain and src/util.cyr for ct_eq constant-time comparisons.
#
# Pinned at 3.11.1 — latest. Since sigil 3.6 the four opt-in stdlib
# modules (ct, keccak, thread, thread_local) are NOT in the cyrius
# auto-prepend union and the bundle does not carry them — each must be
# declared in [deps] above so `cyrius deps` vendors it into lib/ (cyrius
# then auto-includes the vendored module). Omitting one compiles its call
# site to a `ud2` trap that SIGILLs (exit 132) the first time a crypto
# path touches it (see sigil README §Usage); that was the 3.4.1 bug —
# thread_local was absent from [deps]. thread_local MUST stay declared
# (it precedes sigil in the auto-include order): sigil's crypto_scratch
# exercises the TLS path, so without thread_local storage the binary
# links clean but SIGILLs at first crypto use (latent through sigil
# ≤3.7.12, surfaced by the 3.7.14 bump — see bote 2.7.6 / libro 2.7.4).
# The pre-6.1 `bigint` stdlib module is RETIRED — sigil 3.x bundles its
# own u256/u384 inline and kavach has no direct big-integer use, so the
# old `bigint` [deps] entry was dropped at 3.4.2.
# Validated by a clean build/test/bench run at this pin under cc 6.4.62.
# Bump in lockstep with the cyrius pin and re-validate.
[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
tag = "3.12.6"
modules = ["dist/sigil.cyr"]

# ── Feature gating for the samay bridge ──────────────────────────
# cyrius auto-includes every ACTIVE [deps.*] module into the compilation unit.
# samay (72 KB) + its transitive ai-hwaccel (207 KB) were always-on, so every
# kavach consumer linked ~279 KB of scheduler/accelerator symbols — for a bridge
# kavach does not even ship: `src/samay_bridge.cyr` is excluded from
# [lib].modules, and `dist/kavach.cyr` contains zero samay references.
#
# That cost was not theoretical: it pushed stiva's `tests/stiva.tcyr` past
# cycc's identifier cap (261893/262144 — a hard compile error), and dragged in
# ai-hwaccel's `backend_name`, which collided with ours (fixed in 3.8.2 by
# renaming ours to `os_backend_name`).
#
# Both deps are now OPTIONAL behind the default-on `samay` feature. kavach's own
# build/tests keep it, so tests/samay_integration.tcyr still compiles. CONSUMERS
# are unaffected: transitive [features] tables are not parsed, so an optional dep
# stays inactive downstream — no clone, no module copy, no auto-include. A
# consumer that actually wants samay declares it directly (as stiva does for its
# roadmap §H/§I work). Same lever libro uses for sigil-tpm and mehman for kavach.
[features]
default = ["scheduler"]
scheduler = ["samay", "ai-hwaccel"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
path = "../ai-hwaccel"
tag = "2.3.16"
modules = ["dist/ai-hwaccel.cyr"]
optional = true

[deps.samay]
git = "https://github.com/MacCracken/samay.git"
path = "../samay"
tag = "1.0.1"
modules = ["dist/samay.cyr"]
optional = true

# No external agnosys (agnodrm) dep. kavach internalized the Linux security
# backends it used (security/mac/kernel_audit + sys_error/sys_util +
# sys_security_syscalls) as src modules — the security subsystems from the
# agnosys → agnodrm decomposition (agnosys narrowed to the device model; its
# security subsystems became agnodrm). The landlock/prctl syscall numbers come
# from cyrius's lib/syscalls; kavach consumes only sigil's committed
# dist/sigil.cyr bundle.
