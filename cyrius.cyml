[package]
name = "kavach"
version = "${file:VERSION}"
description = "Sandbox execution framework — 10 backends, strength scoring (0-100), 3-scanner externalization gate, HMAC audit chain, threat classification. Cyrius port of Rust v2.x."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/kavach"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
output = "build/kavach"

[lib]
modules = [
    "src/util.cyr",
    "src/error.cyr",
    "src/sys_security_syscalls.cyr",
    "src/sys_error.cyr",
    "src/sys_util.cyr",
    "src/security.cyr",
    "src/mac.cyr",
    "src/kernel_audit.cyr",
    "src/backend.cyr",
    "src/policy.cyr",
    "src/scoring.cyr",
    "src/lifecycle.cyr",
    "src/scanning_types.cyr",
    "src/aho_corasick.cyr",
    "src/scanning_secrets.cyr",
    "src/scanning_code.cyr",
    "src/scanning_data.cyr",
    "src/scanning_gate.cyr",
    "src/scanning_runtime.cyr",
    "src/scanning_threat.cyr",
    "src/audit.cyr",
    "src/credential.cyr",
    "src/credential_http.cyr",
    "src/quarantine.cyr",
    "src/cgroup.cyr",
    "src/oci_spec.cyr",
    "src/confine.cyr",
    "src/backend_dispatch.cyr",
    "src/backend_noop.cyr",
    "src/backend_process.cyr",
    "src/persistent.cyr",
    "src/spawn.cyr",
    "src/backend_gvisor.cyr",
    "src/backend_oci.cyr",
    "src/backend_wasm.cyr",
    "src/backend_sy_agnos.cyr",
    "src/backend_sgx.cyr",
    "src/backend_sev.cyr",
    "src/backend_tdx.cyr",
    "src/backend_firecracker.cyr",
    "src/composite.cyr",
    "src/observability.cyr",
    "src/attestation.cyr",
    "src/sandbox_exec.cyr",
]

[deps]
stdlib = [
    "alloc",
    "args",
    "assert",
    "async",
    "bayan",
    "bench",
    "chrono",
    "ct",
    "dynlib",
    "fdlopen",
    "fmt",
    "fnptr",
    "freelist",
    "fs",
    "hashmap",
    "hashmap_fast",
    "io",
    "keccak",
    "math",
    "sakshi",
    "atomic",
    "mmap",
    "net",
    "process",
    "random",
    "result",
    "sandhi",
    "slice",
    "str",
    "string",
    "syscalls",
    "tagged",
    "thread",
    "thread_local",
    "tls",
    "vec",
]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
path = "../sigil"
tag = "3.12.18"
modules = ["dist/sigil.cyr"]

[features]
default = ["scheduler"]
scheduler = ["samay", "ai-hwaccel"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
path = "../ai-hwaccel"
tag = "2.4.0"
modules = ["dist/ai-hwaccel.cyr"]
optional = true

[deps.samay]
git = "https://github.com/MacCracken/samay.git"
path = "../samay"
tag = "1.1.5"
modules = ["dist/samay.cyr"]
optional = true

[lib.confine]
modules = [
    "src/util.cyr",
    "src/error.cyr",
    "src/sys_security_syscalls.cyr",
    "src/sys_error.cyr",
    "src/sys_util.cyr",
    "src/security.cyr",
    "src/backend.cyr",
    "src/policy.cyr",
    "src/scoring.cyr",
    "src/lifecycle.cyr",
    "src/scanning_types.cyr",
    "src/aho_corasick.cyr",
    "src/scanning_runtime.cyr",
    "src/cgroup.cyr",
    "src/confine.cyr",
    "src/backend_dispatch.cyr",
    "src/backend_noop.cyr",
    "src/backend_process.cyr",
    "src/spawn.cyr",
]
