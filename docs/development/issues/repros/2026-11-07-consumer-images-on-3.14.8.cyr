# 3.14.8's consumer runs (ADR-011): postgres's entry point and nginx in their images'
# filesystems through kavach's public paths, before and after, a block device through a
# caller's /dev, and nginx detached through runc on an OCI sandbox. x86-64.
#
#   cyrius build <this file> <dir>/rig-after      # from the repository root
#   cyrius build <this file> <dir>/rig-before     # from a 3.14.7 tree, with the stand-in
#                                                 # for policy_network_allow_tcp below
#
# It runs only as real root in a throwaway privileged container, with <dir> bound at /rig:
# the .sh of the same name. A block device is opened read-only and closed; nothing is read.

include "src/util.cyr"
include "src/error.cyr"
