fn test_phylax_detects_namespace_escape() {
    test_group("phylax_namespace_escape");
    var r = scan_result_new();
    phylax_scan("running nsenter --target 1 --mount --pid --net", r);
    var v = ScanResult_findings(r);
    var found = 0;
    var i = 0;
    while (i < vec_len(v)) {
        var f = vec_get(v, i);
        if (streq(ScanFinding_category(f), "NAMESPACE_ESCAPE") == 1) { found = 1; }
        i = i + 1;
    }
    assert_eq(found, 1, "phylax caught nsenter");
    return 0;
}

