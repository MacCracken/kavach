fn test_gate_pass_clean() {
    test_group("gate_pass");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "hello world");
    var pol = ext_policy_default();
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.PASS, "verdict pass");
    return 0;
}

fn test_gate_block_private_key() {
    test_group("gate_block_private_key");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "-----BEGIN RSA PRIVATE KEY-----\nMIIEp...");
    var pol = ext_policy_default();
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.BLOCK, "verdict block");
    assert_eq(ScanResult_worst_severity(sr), Severity.CRITICAL, "critical");
    return 0;
}

fn test_gate_size_limit() {
    test_group("gate_size_limit");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "this is longer than 10 bytes");
    var pol = ext_policy_default();
    ExternalizationPolicy_set_max_artifact_size_bytes(pol, 10);
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.BLOCK, "oversized blocked");
    return 0;
}

fn test_gate_disabled() {
    test_group("gate_disabled");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "-----BEGIN RSA PRIVATE KEY-----");
    var pol = ext_policy_default();
    ExternalizationPolicy_set_enabled(pol, 0);
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.PASS, "disabled pass");
    return 0;
}

fn test_gate_stderr() {
    test_group("gate_stderr");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "clean");
    ExecResult_set_stderr(er, "-----BEGIN RSA PRIVATE KEY-----");
    var pol = ext_policy_default();
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.BLOCK, "stderr secret blocked");
    return 0;
}

# ---- 3.11.7: the gate measures a length, not a distance to the first NUL ----

# Build "ok" NUL "AKIAIOSFODNN7EXAMPLE" — 23 bytes with the secret AFTER a NUL.
fn _t_nul_artifact(sep) {
    var b = alloc(32);
    memcpy(b, "ok", 2);
    store8(b + 2, sep);
    memcpy(b + 3, "AKIAIOSFODNN7EXAMPLE", 20);
    store8(b + 23, 0);
    return b;
}

fn test_gate_scans_past_an_embedded_nul() {
    test_group("gate_embedded_nul");
    # The control FIRST: the same 23 bytes with a space where the NUL goes must
    # block, or the assertion below is measuring nothing.
    var ctl = exec_result_new();
    exec_result_set_stdout_n(ctl, _t_nul_artifact(32), 23);
    assert_eq(ScanResult_verdict(gate_apply(ctl, ext_policy_default())),
      ScanVerdict.BLOCK, "control: space-separated key blocks");

    # And with a NUL. Before 3.11.7 the gate measured `strlen` = 2 and released
    # a live credential as PASS.
    var er = exec_result_new();
    exec_result_set_stdout_n(er, _t_nul_artifact(0), 23);
    assert_eq(ScanResult_verdict(gate_apply(er, ext_policy_default())),
      ScanVerdict.BLOCK, "a credential AFTER an embedded NUL is still scanned");
    return 0;
}

fn test_gate_length_is_not_strlen_for_the_size_cap() {
    test_group("gate_nul_size_cap");
    # **CLEAN content on purpose.** An artifact carrying a secret blocks whether
    # or not the cap works, so it cannot tell the two apart — the first version
    # of this test used one and survived reverting the fix. With nothing to find,
    # BLOCK can only come from the size limit.
    var b = alloc(32);
    memcpy(b, "ok", 2);
    store8(b + 2, 0);
    memcpy(b + 3, "aaaaaaaaaaaaaaaaaaaa", 20);
    store8(b + 23, 0);

    # Sanity: uncapped, this artifact is PASS. Otherwise the assertion below
    # would be satisfied by content, which is what went wrong the first time.
    var clean = exec_result_new();
    exec_result_set_stdout_n(clean, b, 23);
    assert_eq(ScanResult_verdict(gate_apply(clean, ext_policy_default())),
      ScanVerdict.PASS, "the artifact itself is clean");

    # 23 real bytes against a 10-byte cap. `strlen` sees 2 and lets it through.
    var er = exec_result_new();
    exec_result_set_stdout_n(er, b, 23);
    var pol = ext_policy_default();
    ExternalizationPolicy_set_max_artifact_size_bytes(pol, 10);
    assert_eq(ScanResult_verdict(gate_apply(er, pol)), ScanVerdict.BLOCK,
      "the size cap sees 23 bytes, not strlen's 2");
    return 0;
}

fn test_exec_result_length_defaults_to_strlen() {
    test_group("gate_len_default");
    # A caller that supplies no length keeps the pre-3.11.7 behaviour exactly:
    # -1 means unset, and every reader falls back to strlen.
    var er = exec_result_new();
    assert_eq(ExecResult_stdout_len(er), 0 - 1, "unset is -1, not 0");
    ExecResult_set_stdout(er, "hello world");
    assert_eq(exec_result_stdout_len(er), 11, "unset resolves through strlen");
    # ...and a genuinely empty artifact is distinguishable from an unset one.
    exec_result_set_stdout_n(er, "", 0);
    assert_eq(exec_result_stdout_len(er), 0, "an explicit 0 length is honoured");
    return 0;
}

fn test_redact_covers_the_whole_artifact() {
    test_group("redact_past_nul");
    # Redaction must not stop at the NUL either, and must report the length it
    # produced — its output carries the NUL, so strlen would truncate it.
    var ol[8];
    store64(&ol, 0);
    var out = secrets_redact_n(_t_nul_artifact(0), 23, &ol);
    assert_neq(out, 0, "redaction produced a buffer");
    assert_neq(load64(&ol), 0, "...and reported its length");
    # The key is gone and the marker is present somewhere past the NUL.
    var found = 0;
    var i = 0;
    var n = load64(&ol);
    while (i + 4 <= n) {
        if (load8(out + i) == 82 && load8(out + i + 1) == 69
          && load8(out + i + 2) == 68 && load8(out + i + 3) == 65) { found = 1; }
        i = i + 1;
    }
    assert_eq(found, 1, "the secret after the NUL was redacted, not skipped");
    return 0;
}

fn test_credential_register_resolve() {
    test_group("credential_register");
    var p = credential_proxy_new();
    credential_proxy_register(p, "API_KEY", "sk-12345");
    var r = secret_ref_env("API_KEY", "OPENAI_API_KEY");
    var v = credential_proxy_resolve(p, r);
    assert(v != 0, "resolved");
    assert_eq(streq(v, "sk-12345"), 1, "value matches");

    var missing = secret_ref_stdin("NOPE");
    assert_eq(credential_proxy_resolve(p, missing), 0, "unknown returns 0");
    return 0;
}

fn test_credential_env_vars() {
    test_group("credential_env_vars");
    var p = credential_proxy_new();
    credential_proxy_register(p, "K1", "v1");
    credential_proxy_register(p, "K2", "v2");
    var refs = vec_new();
    vec_push(refs, secret_ref_env("K1", "MY_K1"));
    vec_push(refs, secret_ref_file("K2", "/tmp/secret", 384));
    var env = credential_proxy_env_vars(p, refs);
    assert_eq(vec_len(env), 2, "only ENV refs emitted (name+value)");
    assert_eq(streq(vec_get(env, 0), "MY_K1"), 1, "var name");
    assert_eq(streq(vec_get(env, 1), "v1"), 1, "var value");
    return 0;
}

fn test_credential_file_injections() {
    test_group("credential_file_injections");
    var p = credential_proxy_new();
    credential_proxy_register(p, "TLS_CERT", "-----CERT-----");
    var refs = vec_new();
    vec_push(refs, secret_ref_file("TLS_CERT", "/etc/ssl/cert.pem", 384));
    var files = credential_proxy_file_injections(p, refs);
    assert_eq(vec_len(files), 1, "one file injection");
    var f = vec_get(files, 0);
    assert_eq(streq(FileInjection_path(f), "/etc/ssl/cert.pem"), 1, "path");
    assert_eq(streq(FileInjection_content(f), "-----CERT-----"), 1, "content");
    assert_eq(FileInjection_mode(f), 384, "mode 0o600");
    return 0;
}

fn test_credential_inject_files() {
    test_group("credential_inject_files");

    # Empty vec -> 0 written
    var empty = vec_new();
    assert_eq(credential_inject_files(empty), 0, "empty vec -> 0");

    # One file with mode 0644 — honors mode + lands content
    var dir = "/tmp/kavach-test-inject";
    sys_mkdir(dir, 448);
    var path1 = "/tmp/kavach-test-inject/secret1.txt";
    sys_unlink(path1);
    var injections = vec_new();
    vec_push(injections, file_injection_new(path1, "payload-1", 420));
    var n = credential_inject_files(injections);
    assert_eq(n, 1, "one file written");
    # And the mode really is 0644. Until 3.12.6 the fchmod was a raw x86
    # `syscall(91)`, which aarch64 runs as capset: the file stayed 0600, and this
    # test, which only checked n and the content, could not see it.
    var st = alloc(256);
    assert_eq(sys_stat(path1, st), 0, "stat after inject");
    assert_eq(load32(st + STAT_MODE) & 4095, 420, "requested mode 0644 applied");

    # Verify content
    var buf[64];
    var fd = sys_open(path1, 0, 0);
    assert(fd >= 0, "file readable after inject");
    var rd = sys_read(fd, &buf, 32);
    sys_close(fd);
    assert_eq(rd, 9, "9 bytes content");

    # Two files in one batch — second succeeds even though first existed
    sys_unlink(path1);
    var path2 = "/tmp/kavach-test-inject/secret2.txt";
    sys_unlink(path2);
    var batch = vec_new();
    vec_push(batch, file_injection_new(path1, "alpha", 384));
    vec_push(batch, file_injection_new(path2, "beta", 384));
    assert_eq(credential_inject_files(batch), 2, "two-file batch");
    sys_unlink(path1);
    sys_unlink(path2);

    # O_EXCL refuses preexisting target — returns negative
    sys_open(path1, 1 + 64, 384);    # create empty preexisting target
    var fail_batch = vec_new();
    vec_push(fail_batch, file_injection_new(path1, "blocked", 384));
    var rc = credential_inject_files(fail_batch);
    assert(rc < 0, "O_EXCL refuses preexisting");
    assert_eq(rc, 0 - 1, "rc == -(written+1) == -1 on first-file fail");
    sys_unlink(path1);
    sys_rmdir(dir);
    return 0;
}

# 3.12.9: the injection methods were `ENV_VAR` / `FILE` / `STDIN`, and the
# stdlib's `var STDIN = 0` (lib/io.cyr) could win over kavach's `STDIN = 2` in a
# consumer, making STDIN equal ENV_VAR. kavach's own unit orders io.cyr first,
# so the aliasing never showed here; scripts/check-symbols.py is the gate for
# that class. What this pins: the three values are distinct, `STDIN` is the
# stdlib's fd 0 again (a kavach member named STDIN would shadow it in this unit
# and fail the first check), and a mixed list routes each ref exactly once.
fn test_credential_methods_do_not_alias() {
    test_group("credential_methods_do_not_alias");
    assert_eq(STDIN, 0, "STDIN is the stdlib's fd 0, not an injection method");
    assert_eq(KAVACH_INJECT_ENV_VAR, 0, "env var = 0");
    assert_eq(KAVACH_INJECT_FILE, 1, "file = 1");
    assert_eq(KAVACH_INJECT_STDIN, 2, "stdin = 2");

    var p = credential_proxy_new();
    credential_proxy_register(p, "E", "env-secret");
    credential_proxy_register(p, "S", "stdin-secret");
    credential_proxy_register(p, "F", "file-secret");
    var refs = vec_new();
    vec_push(refs, secret_ref_stdin("S"));
    vec_push(refs, secret_ref_env("E", "MY_E"));
    vec_push(refs, secret_ref_file("F", "/tmp/kavach-never-written", 384));

    var env = credential_proxy_env_vars(p, refs);
    assert_eq(vec_len(env), 2, "one env pair: the stdin ref is not an env var");
    assert_eq(streq(vec_get(env, 0), "MY_E"), 1, "its name");
    assert_eq(streq(vec_get(env, 1), "env-secret"), 1, "its value");

    var s = credential_proxy_stdin_payload(p, refs);
    assert(s != 0, "a stdin payload");
    if (s != 0) {
        assert_eq(streq(s, "stdin-secret"), 1, "only the stdin secret, not the env one");
    }
    assert_eq(vec_len(credential_proxy_file_injections(p, refs)), 1, "one file injection");
    return 0;
}

fn test_credential_stdin_payload() {
    test_group("credential_stdin_payload");
    var p = credential_proxy_new();
    credential_proxy_register(p, "PART1", "hello");
    credential_proxy_register(p, "PART2", "world");
    var refs = vec_new();
    vec_push(refs, secret_ref_stdin("PART1"));
    vec_push(refs, secret_ref_stdin("PART2"));
    var s = credential_proxy_stdin_payload(p, refs);
    assert(s != 0, "payload built");
    assert_eq(streq(s, "hello\nworld"), 1, "joined with newline");

    var empty_refs = vec_new();
    assert_eq(credential_proxy_stdin_payload(p, empty_refs), 0, "no refs -> 0");
    return 0;
}

fn test_audit_chain_record() {
    test_group("audit_chain_record");
    sha256_global_init();
    var c = audit_chain_open("/tmp/kavach-test-record.audit", "key-a", 5);
    assert_eq(audit_chain_len(c), 1, "genesis auto-recorded");
    audit_chain_record(c, "event1", "payload1");
    assert_eq(audit_chain_len(c), 2, "one more");
    audit_chain_record(c, "event2", "payload2");
    assert_eq(audit_chain_len(c), 3, "three total");
    return 0;
}

fn test_audit_chain_linkage() {
    test_group("audit_chain_linkage");
    sha256_global_init();
    var c = audit_chain_open("/tmp/kavach-test-link.audit", "key-b", 5);
    var e1 = audit_chain_record(c, "a", "p1");
    var e2 = audit_chain_record(c, "b", "p2");
    # e2.prev_hmac should equal e1.hmac
    assert_eq(streq(KavachAuditEntry_prev_hmac(e2), KavachAuditEntry_hmac(e1)), 1, "linked");
    assert(streq(KavachAuditEntry_hmac(e1), KavachAuditEntry_hmac(e2)) == 0, "distinct hmacs");
    return 0;
}

fn test_audit_verify_constant_time() {
    test_group("audit_verify_ct");
    # ct_streq must reject differing strings of SAME length — the
    # comparator we rely on for timing-safe HMAC verify (ADR-005 §C1).
    assert_eq(ct_streq("aaaa", "aaaa"), 1, "equal");
    assert_eq(ct_streq("aaaa", "aaab"), 0, "differ at end");
    assert_eq(ct_streq("aaaa", "baaa"), 0, "differ at start");
    assert_eq(ct_streq("abc", "abcd"), 0, "length mismatch");
    return 0;
}

fn test_json_escape_control_chars() {
    test_group("json_escape_ctrl");
    # \u0001 (SOH) must be escaped as \u0001, not passed through.
    var raw = alloc(4);
    store8(raw, 97);           # 'a'
    store8(raw + 1, 1);        # 0x01 SOH
    store8(raw + 2, 98);       # 'b'
    store8(raw + 3, 0);
    var esc = oci_json_escape(raw);
    assert_eq(streq(esc, "a\\u0001b"), 1, "SOH -> \\u0001");

    # \b \f \t \n \r all get short forms
    var raw2 = alloc(2);
    store8(raw2, 8);           # \b
    store8(raw2 + 1, 0);
    assert_eq(streq(oci_json_escape(raw2), "\\b"), 1, "backspace -> \\b");

    var raw3 = alloc(2);
    store8(raw3, 12);          # \f
    store8(raw3 + 1, 0);
    assert_eq(streq(oci_json_escape(raw3), "\\f"), 1, "formfeed -> \\f");
    return 0;
}

fn test_is_safe_argument() {
    test_group("is_safe_argument");
    assert_eq(is_safe_argument("echo hello"), 1, "normal cmd");
    assert_eq(is_safe_argument("with\ttab"), 1, "tab ok");

    # Build cmd with embedded newline
    var bad = alloc(16);
    memcpy(bad, "line1", 5);
    store8(bad + 5, 10);       # \n
    memcpy(bad + 6, "line2", 6);
    store8(bad + 11, 0);
    assert_eq(is_safe_argument(bad), 0, "newline rejected");

    # Embedded NUL via an allocated buffer
    var bad2 = alloc(8);
    store8(bad2, 97); store8(bad2 + 1, 0);
    assert_eq(is_safe_argument(bad2), 1, "pure ascii ok");
    return 0;
}

# is_safe_text (bounds-checked slice read): tab/newline/CR allowed, other
# control chars rejected. Empty string is trivially safe (zero-len slice).
fn test_is_safe_text() {
    test_group("is_safe_text");
    assert_eq(is_safe_text("hello world"), 1, "plain text ok");
    assert_eq(is_safe_text("a\tb\nc\rd"), 1, "tab/newline/CR allowed");
    assert_eq(is_safe_text(""), 1, "empty ok (zero-len slice)");
    var esc = alloc(4);
    store8(esc, 97); store8(esc + 1, 27); store8(esc + 2, 98); store8(esc + 3, 0);  # a<ESC>b
    assert_eq(is_safe_text(esc), 0, "ESC (0x1b) rejected");
    return 0;
}

fn test_process_rejects_newline_smuggling() {
    test_group("process_newline_smuggle");
    kavach_init();
    var cfg = config_new();
    config_backend(cfg, KavachBackend.PROCESS);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    # Build "ls\ncat /etc/shadow" — without the guard this splits into
    # two tokens and potentially runs the second as a separate exec.
    var cmd = alloc(32);
    memcpy(cmd, "ls", 2);
    store8(cmd + 2, 10);       # \n
    memcpy(cmd + 3, "cat /etc/shadow", 16);
    store8(cmd + 18, 0);
    var r = process_exec(sb, cmd);
    assert_eq(ExecResult_exit_code(r), 126, "newline rejected");
    assert(cstr_contains(ExecResult_stderr(r), "control") == 1, "msg says control");
    return 0;
}

fn test_overflow_helpers() {
    test_group("overflow_helpers");
    assert_eq(checked_add(1, 2), 3, "normal add");
    assert_eq(checked_add(0 - 1, 5), 0 - 1, "neg input rejected");
    # 2^62 + 2^62 = 2^63 which overflows i64 positives.
    var big = 4611686018427387904;
    assert_eq(checked_add(big, big), 0 - 1, "add overflow");

    assert_eq(checked_mul(3, 4), 12, "normal mul");
    assert_eq(checked_mul(big, 2), 0 - 1, "mul overflow");
    assert_eq(checked_mul(0, big), 0, "0 short-circuit");
    return 0;
}

fn test_redact_evidence() {
    test_group("redact_evidence");
    # len > 8: first 4 + **** + last 4
    var r1 = redact_evidence("AKIAIOSFODNN7EXAMPLE", 0, 20);
    assert_eq(streq(r1, "AKIA****MPLE"), 1, "20-char redacted");

    # len <= 8: all asterisks
    var r2 = redact_evidence("abcd", 0, 4);
    assert_eq(streq(r2, "****"), 1, "short fully masked");

    # Evidence from a finding: scanned artifact -> stored finding must
    # not contain the raw secret in audit-log-reachable fields.
    var sr = scan_result_new();
    secrets_scan("leak: AKIAIOSFODNN7EXAMPLE end", sr);
    var v = ScanResult_findings(sr);
    assert(vec_len(v) >= 1, "finding");
    var f = vec_get(v, 0);
    var ev = ScanFinding_evidence(f);
    assert(cstr_contains(ev, "****") == 1, "redacted evidence");
    assert_eq(cstr_contains(ev, "IOSFODNN7EXA"), 0, "no raw middle bytes");
    return 0;
}

fn test_audit_payload_escaped() {
    test_group("audit_payload_escaped");
    sha256_global_init();
    var c = audit_chain_open("/tmp/kavach-test-escape.audit", "key", 3);
    # Payload with embedded quote — must be escaped in JSONL output.
    var e = audit_chain_record(c, "evt", "has \"quote\"");
    # Verification still passes (HMAC covers the unescaped payload).
    assert_eq(audit_entry_verify(e, "key", 3), 1, "verify ok");
    audit_chain_close(c);
    return 0;
}

fn test_audit_chain_close_zeroes_key() {
    test_group("audit_close_zeroes");
    sha256_global_init();
    var keybuf = alloc(16);
    memcpy(keybuf, "mysecretkey12345", 16);
    var c = audit_chain_open("/tmp/kavach-test-close.audit", keybuf, 16);
    # key pointer is held inside the chain struct
    assert_eq(AuditChain_hmac_key(c), keybuf, "key ptr stored");
    audit_chain_close(c);
    assert_eq(AuditChain_hmac_key(c), 0, "key pointer cleared");
    # Key buffer itself is zeroed
    assert_eq(load8(keybuf), 0, "first byte zeroed");
    assert_eq(load8(keybuf + 15), 0, "last byte zeroed");
    return 0;
}

# A fresh /tmp path no other run or test can be holding.
fn _t_unique_tmp_path(prefix) {
    var rid = rand_hex_id();
    var path = alloc(strlen(prefix) + 17);
    memcpy(path, prefix, strlen(prefix));
    memcpy(path + strlen(prefix), rid, 16);
    store8(path + strlen(prefix) + 16, 0);
    return path;
}

# ADR-005 §C4: the audit log ends up owner-only whether the append created it or
# found it. The open creates a fresh log at 0600; a log that already exists
# wider is tightened by fchmod on the fd the record is written through.
fn test_audit_log_mode_0600() {
    test_group("audit_log_mode_0600");
    sha256_global_init();
    var path = _t_unique_tmp_path("/tmp/kavach-mode-");
    var st[144];

    audit_chain_open(path, "mode-key", 8);
    assert_eq(xstat(path, &st), 0, "fresh log exists");
    assert_eq(load32(&st + STAT_MODE) & 511, 384, "fresh log is 0600");

    sys_chmod(path, 420);                    # 0644: widened after the fact
    audit_chain_open(path, "mode-key", 8);   # appends a genesis to it
    assert_eq(xstat(path, &st), 0, "log still exists");
    assert_eq(load32(&st + STAT_MODE) & 511, 384, "a 0644 log is tightened to 0600");
    kv_unlink(path);
    return 0;
}

# Cap this process's file size (RLIMIT_FSIZE, resource 1).
fn _t_set_fsize_limit(bytes) { return _t_set_rlimit(1, bytes); }

# Set one of this process's resource limits, soft and hard. The stdlib has no
# rlimit wrapper, so prlimit64 goes by number — the KERNEL's own, per arch,
# because neither is an ESYSXLAT row: x86_64 302, aarch64 261 (as an x86
# number 261 is futimesat, which aarch64 lacks, so no row can ever claim it).
# -1 anywhere else: the caller reports what it needed as not exercisable.
fn _t_set_rlimit(resource, value) {
    var rl[16];
    store64(&rl, value);        # rlim_cur
    store64(&rl + 8, value);    # rlim_max
    #ifdef CYRIUS_TARGET_LINUX
    #ifdef CYRIUS_ARCH_X86
    # SAFETY: prlimit64(0 = this process, resource, &rl, no old-limit out);
    # rl is a 16-byte {rlim_cur, rlim_max} on this frame and is only read.
    return syscall(302, 0, resource, &rl, 0);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    # SAFETY: as the x86_64 arm, in aarch64 numbering.
    return syscall(261, 0, resource, &rl, 0);
    #endif
    #endif
    return 0 - 1;
}

# 1 when every record in the log at `path` is a complete line of its own, 0
# otherwise; the line count goes to `lines_out`. `{"serial":` cannot occur
# inside a record (event_type and payload are JSON-escaped), so it counts
# records whole or torn, and it equals the newline count only when none is
# torn or merged into another.
fn _t_audit_log_whole_lines(path, lines_out) {
    store64(lines_out, 0);
    var n = 0;
    var buf = file_read_whole(path, &n);
    if (buf == 0) { return 0; }
    var lines = 0;
    var starts = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c == 10) { lines = lines + 1; }
        if (c == 123) {
            if (i + 10 <= n) {
                if (memeq(buf + i, "{\"serial\":", 10) == 1) { starts = starts + 1; }
            }
        }
        i = i + 1;
    }
    store64(lines_out, lines);
    if (n > 0) {
        if (load8(buf + n - 1) != 10) { return 0; }
    }
    if (starts != lines) { return 0; }
    return 1;
}

# Child half of the torn-tail test. Exits 10 + the chain length it ended with;
# 3 when no file-size limit could be set; 4 when the limit refused nothing (so
# nothing was tested). SIGXFSZ keeps its default action on purpose.
fn _t_torn_tail_child(path) {
    # Each refusal prints to stderr. If the runner's stderr is a regular file,
    # the limit applies to it too, and a diagnostic written past 4 KiB would
    # SIGXFSZ this child for reasons unrelated to the audit log.
    var nul = file_open("/dev/null", O_WRONLY, 0);
    if (nul >= 0) {
        kv_dup2(nul, 1);
        kv_dup2(nul, 2);
    }
    if (_t_set_fsize_limit(4096) < 0) { syscall(SYS_EXIT_GROUP, 3); }
    var payload = alloc(2001);
    memset(payload, 97, 2000);
    store8(payload + 2000, 0);
    var c = audit_chain_open(path, "torn-key", 8);
    var refused = 0;
    var i = 0;
    while (i < 4) {
        if (audit_chain_record(c, "big", payload) == 0) { refused = refused + 1; }
        i = i + 1;
    }
    if (refused == 0) { syscall(SYS_EXIT_GROUP, 4); }
    syscall(SYS_EXIT_GROUP, 10 + audit_chain_len(c));
    return 0;
}

# A record the log cannot take whole must leave the log exactly as it was.
# 3.12.6 refused the record but left the bytes that landed at the tail; the
# next append merged into them, and the good record stopped parsing. The child
# caps its file size at 4 KiB and records 2 KB payloads past it. It keeps
# SIGXFSZ at the default action, so an append that retried a short write
# (the retry starts at the limit) would kill it, and so would leaving the torn
# bytes in place (the next write starts there); both fail here too.
fn test_audit_refused_append_leaves_no_torn_tail() {
    test_group("audit_refused_append_no_torn_tail");
    sha256_global_init();
    var path = _t_unique_tmp_path("/tmp/kavach-torn-");

    var pid = kv_fork();
    if (pid == 0) { _t_torn_tail_child(path); }
    assert(pid > 0, "fork");
    if (pid < 0) { return 0; }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    var status = load32(&st);
    var sig = status & 127;
    var code = (status >> 8) & 255;
    if (sig == 0) {
        if (code == 3) {
            assert_eq(1, 1, "no file-size limit on this target — rollback not exercisable");
            kv_unlink(path);
            return 0;
        }
    }
    assert_eq(sig, 0, "child not killed by a signal (SIGXFSZ: a write began at the limit)");

    var lines = 0;
    assert_eq(_t_audit_log_whole_lines(path, &lines), 1, "no torn record left in the log");
    if (sig == 0) {
        assert(code != 4, "the 4 KiB limit refused at least one record");
        assert(code > 10, "genesis landed under the limit");
        assert_eq(lines, code - 10, "one line per record the chain accepted");
    }

    # The harm the torn tail did: the NEXT writer merged into it. A new chain
    # on the same log must land on lines of its own.
    var before = lines;
    var c = audit_chain_open(path, "torn-key", 8);
    audit_chain_record(c, "after", "small");
    assert_eq(_t_audit_log_whole_lines(path, &lines), 1, "the next writer's records stay whole");
    assert_eq(lines, before + 2, "genesis + one record appended after the refusals");
    kv_unlink(path);
    return 0;
}

# A fragment the rollback cannot remove — a writer killed inside its write,
# agnos (no ftruncate), an append-only log — must not swallow the next record.
# Plant one with no trailing newline, then append: the fragment keeps a line of
# its own, byte for byte, and every record after it is whole.
fn test_audit_append_starts_a_fresh_line_after_a_torn_tail() {
    test_group("audit_append_fresh_line_after_torn_tail");
    sha256_global_init();
    var path = _t_unique_tmp_path("/tmp/kavach-frag-");
    var frag = "{\"serial\":7,\"event_type\":\"torn";
    file_write_all(path, frag, strlen(frag));

    var c = audit_chain_open(path, "frag-key", 8);
    assert(audit_chain_record(c, "after", "small") != 0, "the record is accepted");
    var lines = 0;
    assert_eq(_t_audit_log_whole_lines(path, &lines), 1, "every record after the fragment is whole");
    assert_eq(lines, 3, "fragment, genesis and the record each on a line of their own");
    var n = 0;
    var buf = file_read_whole(path, &n);
    assert_eq(memeq(buf, frag, strlen(frag)), 1, "the fragment is kept as it was");
    assert_eq(load8(buf + strlen(frag)), 10, "and ends at the newline the append put in front of genesis");
    kv_unlink(path);
    return 0;
}

fn test_uuid_v4_distinct() {
    test_group("uuid_v4");
    # Four random u64s must all differ (collision probability ~ 2^-62).
    var a = rand_u64();
    var b = rand_u64();
    var c = rand_u64();
    var d = rand_u64();
    assert(a != b, "a != b");
    assert(a != c, "a != c");
    assert(a != d, "a != d");
    assert(b != c, "b != c");
    # A fresh sandbox + a fresh finding must have distinct ids too.
    var cfg = config_new();
    config_backend(cfg, KavachBackend.NOOP);
    var sb1 = sandbox_create(cfg);
    var sb2 = sandbox_create(cfg);
    assert(Sandbox_id(sb1) != Sandbox_id(sb2), "sandbox ids distinct");
    var f1 = finding_new("s", Severity.LOW, "c", "m", 0);
    var f2 = finding_new("s", Severity.LOW, "c", "m", 0);
    assert(ScanFinding_id(f1) != ScanFinding_id(f2), "finding ids distinct");
    return 0;
}

fn test_warn_verdict_redacts_stdout() {
    test_group("warn_redact_stdout");
    # Low-severity finding (Email) lands in WARN tier under the default
    # policy (block=Critical, quarantine=High, anything > Info = Warn).
    var er = exec_result_new();
    ExecResult_set_stdout(er, "prefix AKIAIOSFODNN7EXAMPLE middle ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij tail");
    # Manually tune the policy so the gate emits WARN instead of BLOCK
    # (AWS key is Critical → BLOCK under defaults).
    var pol = ext_policy_default();
    ExternalizationPolicy_set_block_threshold(pol, Severity.CRITICAL + 1);
    ExternalizationPolicy_set_quarantine_threshold(pol, Severity.CRITICAL + 1);

    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.WARN, "verdict = warn");
    var out = ExecResult_stdout(er);
    assert(cstr_contains(out, "AKIAIOSFODNN7EXAMPLE") == 0, "aws key redacted");
    assert(cstr_contains(out, "[REDACTED:cloud_credential]") == 1, "marker present");
    assert(cstr_contains(out, "ghp_ABCDEFGHIJKLMNOPQRST") == 0, "gh token redacted");
    assert(cstr_contains(out, "[REDACTED:api_token]") == 1, "gh marker");
    assert(cstr_contains(out, "prefix ") == 1, "leading context preserved");
    assert(cstr_contains(out, " tail") == 1, "trailing context preserved");
    return 0;
}

fn test_warn_verdict_redact_disabled() {
