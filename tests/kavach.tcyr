# 3.12.9: `quarantine_update_status` wrote with `file_write_all`, which follows a
# symlink and creates at 0644, and returned OK whatever happened. A `.meta` link
# now fails the update and leaves the link's target alone; a real entry updates.
fn test_quarantine_update_refuses_a_symlinked_entry() {
    test_group("quarantine_update_refuses_a_symlinked_entry");
    var base = _t_unique_tmp_path("/tmp/kavach-t-qupd-");
    var q = quarantine_storage_new(base);
    assert(q != 0, "a store");
    if (q == 0) { return 0; }
    var sr = scan_result_new();
    ScanResult_set_verdict(sr, ScanVerdict.BLOCK);
    var id = quarantine_store(q, "blocked", 7, sr, "sb-u");
    assert_eq(quarantine_update_status(q, id, 1), KAVACH_ERR_OK, "a real entry updates");

    var victim = _t_unique_tmp_path("/tmp/kavach-t-qvictim-");
    file_write_all(victim, "keep", 4);
    var meta = _qpath(base, id, "meta");
    kv_unlink(meta);
    sys_symlink(victim, meta);
    assert(quarantine_update_status(q, id, 2) != KAVACH_ERR_OK, "a symlinked .meta is refused");
    var n = 0;
    var back = file_read_whole(victim, &n);
    assert(n == 4 && streq(back, "keep") == 1, "and the link's target is untouched");
    assert(quarantine_update_status(q, 424242, 2) != KAVACH_ERR_OK, "an unknown id is an error, not a new file");
    kv_unlink(meta);
    kv_unlink(victim);
    return 0;
}

# 3.12.9: `quarantine_storage_new` chmod'ed its base_dir by PATH, following a
# pre-planted symlink to the target, and then stored every entry there. A link
# is now refused (no store), and the target's mode is left alone.
fn test_quarantine_refuses_a_symlinked_base_dir() {
    test_group("quarantine_refuses_a_symlinked_base_dir");
    var target = _t_unique_tmp_path("/tmp/kavach-t-qtarget-");
    kv_mkdir(target, 493);                                 # 0755
    var link = _t_unique_tmp_path("/tmp/kavach-t-qlink-");
    sys_symlink(target, link);
    assert_eq(quarantine_storage_new(link), 0, "a symlinked base_dir is refused");
    var sb[144];
    if (kv_lstat(target, &sb) == 0) {
        assert_eq(load32(&sb + STAT_MODE) & 511, 493, "and the link's target keeps its mode");
    }
    kv_unlink(link);
    kv_rmdir(target);
    return 0;
}

# 3.12.9: the persistent guest never closed what it inherited. Hold an fd open
# (not close-on-exec) at a distinctive number, and list the guest's fds.
fn test_persistent_guest_closes_inherited_fds() {
    test_group("persistent_guest_closes_inherited_fds");
    var fd = file_open("/dev/null", O_RDONLY, 0);
    assert(fd >= 0, "an fd to leak");
    if (fd < 0) { return 0; }
    kv_dup2(fd, 57);
    sys_close(fd);
    var g = persistent_spawn("/bin/ls /proc/self/fd");
    assert(g != 0, "a guest");
    if (g == 0) { sys_close(57); return 0; }
    sys_close(PersistentGuest_stdin_fd(g));
    var buf = alloc(4096);
    var total = 0;
    var r = persistent_read(g, buf, 4095);
    while (r > 0 && total < 4095) {
        total = total + r;
        r = persistent_read(g, buf + total, 4095 - total);
    }
    store8(buf + total, 0);
    var st[8];
    store64(&st, 0);
    kv_waitpid(PersistentGuest_pid(g), &st, 0);
    sys_close(57);
    assert(cstr_contains(buf, "0\n") == 1, "the guest listed its fds");
    assert(cstr_contains(buf, "57\n") == 0, "and fd 57 was not among them");
    return 0;
}

fn test_quarantine_store() {
    test_group("quarantine_store");
    var q = quarantine_storage_new("/tmp/kavach-test-quar");
    var sr = scan_result_new();
    ScanResult_set_verdict(sr, ScanVerdict.BLOCK);
    var id = quarantine_store(q, "blocked stdout", 14, sr, "sb-1");
    # -1 = write failure; rand_u64() ids may be negative (high bit set)
    assert(id != 0 - 1, "id assigned");
    # Entry IDs are 64-bit random (v2.1); two stores must yield distinct ids.
    var id2 = quarantine_store(q, "second", 6, sr, "sb-2");
    assert(id != id2, "distinct random ids");
    return 0;
}

