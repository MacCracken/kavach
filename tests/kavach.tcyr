    assert_eq(ScanResult_worst_severity(sr), Severity.CRITICAL, "critical");
    return 0;
}

fn test_gate_size_limit() {
    test_group("gate_size_limit");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "this is longer than 10 bytes");
    var pol = ext_policy_default();
    ExternalizationPolicy_set_max_artifact_size_bytes(pol, 10);
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.BLOCK, "oversized blocked");
    return 0;
}

fn test_gate_disabled() {
    test_group("gate_disabled");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "-----BEGIN RSA PRIVATE KEY-----");
    var pol = ext_policy_default();
    ExternalizationPolicy_set_enabled(pol, 0);
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.PASS, "disabled pass");
    return 0;
}

fn test_gate_stderr() {
    test_group("gate_stderr");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "clean");
    ExecResult_set_stderr(er, "-----BEGIN RSA PRIVATE KEY-----");
    var pol = ext_policy_default();
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.BLOCK, "stderr secret blocked");
    return 0;
}

# ---- 3.11.7: the gate measures a length, not a distance to the first NUL ----

# Build "ok" NUL "AKIAIOSFODNN7EXAMPLE" — 23 bytes with the secret AFTER a NUL.
fn _t_nul_artifact(sep) {
    var b = alloc(32);
    memcpy(b, "ok", 2);
    store8(b + 2, sep);
    memcpy(b + 3, "AKIAIOSFODNN7EXAMPLE", 20);
    store8(b + 23, 0);
    return b;
}

fn test_gate_scans_past_an_embedded_nul() {
    test_group("gate_embedded_nul");
    # The control FIRST: the same 23 bytes with a space where the NUL goes must
    # block, or the assertion below is measuring nothing.
    var ctl = exec_result_new();
    exec_result_set_stdout_n(ctl, _t_nul_artifact(32), 23);
    assert_eq(ScanResult_verdict(gate_apply(ctl, ext_policy_default())),
      ScanVerdict.BLOCK, "control: space-separated key blocks");

    # And with a NUL. Before 3.11.7 the gate measured `strlen` = 2 and released
    # a live credential as PASS.
    var er = exec_result_new();
    exec_result_set_stdout_n(er, _t_nul_artifact(0), 23);
    assert_eq(ScanResult_verdict(gate_apply(er, ext_policy_default())),
      ScanVerdict.BLOCK, "a credential AFTER an embedded NUL is still scanned");
    return 0;
}

fn test_gate_length_is_not_strlen_for_the_size_cap() {
    test_group("gate_nul_size_cap");
    # **CLEAN content on purpose.** An artifact carrying a secret blocks whether
    # or not the cap works, so it cannot tell the two apart — the first version
    # of this test used one and survived reverting the fix. With nothing to find,
    # BLOCK can only come from the size limit.
    var b = alloc(32);
    memcpy(b, "ok", 2);
    store8(b + 2, 0);
    memcpy(b + 3, "aaaaaaaaaaaaaaaaaaaa", 20);
    store8(b + 23, 0);

    # Sanity: uncapped, this artifact is PASS. Otherwise the assertion below
    # would be satisfied by content, which is what went wrong the first time.
    var clean = exec_result_new();
    exec_result_set_stdout_n(clean, b, 23);
    assert_eq(ScanResult_verdict(gate_apply(clean, ext_policy_default())),
      ScanVerdict.PASS, "the artifact itself is clean");

    # 23 real bytes against a 10-byte cap. `strlen` sees 2 and lets it through.
    var er = exec_result_new();
    exec_result_set_stdout_n(er, b, 23);
    var pol = ext_policy_default();
    ExternalizationPolicy_set_max_artifact_size_bytes(pol, 10);
    assert_eq(ScanResult_verdict(gate_apply(er, pol)), ScanVerdict.BLOCK,
      "the size cap sees 23 bytes, not strlen's 2");
    return 0;
}

fn test_exec_result_length_defaults_to_strlen() {
    test_group("gate_len_default");
    # A caller that supplies no length keeps the pre-3.11.7 behaviour exactly:
    # -1 means unset, and every reader falls back to strlen.
    var er = exec_result_new();
    assert_eq(ExecResult_stdout_len(er), 0 - 1, "unset is -1, not 0");
    ExecResult_set_stdout(er, "hello world");
    assert_eq(exec_result_stdout_len(er), 11, "unset resolves through strlen");
    # ...and a genuinely empty artifact is distinguishable from an unset one.
    exec_result_set_stdout_n(er, "", 0);
    assert_eq(exec_result_stdout_len(er), 0, "an explicit 0 length is honoured");
    return 0;
}

fn test_redact_covers_the_whole_artifact() {
    test_group("redact_past_nul");
    # Redaction must not stop at the NUL either, and must report the length it
    # produced — its output carries the NUL, so strlen would truncate it.
    var ol[8];
    store64(&ol, 0);
    var out = secrets_redact_n(_t_nul_artifact(0), 23, &ol);
    assert_neq(out, 0, "redaction produced a buffer");
    assert_neq(load64(&ol), 0, "...and reported its length");
    # The key is gone and the marker is present somewhere past the NUL.
    var found = 0;
    var i = 0;
    var n = load64(&ol);
    while (i + 4 <= n) {
        if (load8(out + i) == 82 && load8(out + i + 1) == 69
          && load8(out + i + 2) == 68 && load8(out + i + 3) == 65) { found = 1; }
        i = i + 1;
    }
    assert_eq(found, 1, "the secret after the NUL was redacted, not skipped");
    return 0;
}

fn test_credential_register_resolve() {
    test_group("credential_register");
    var p = credential_proxy_new();
    credential_proxy_register(p, "API_KEY", "sk-12345");
    var r = secret_ref_env("API_KEY", "OPENAI_API_KEY");
    var v = credential_proxy_resolve(p, r);
    assert(v != 0, "resolved");
    assert_eq(streq(v, "sk-12345"), 1, "value matches");

    var missing = secret_ref_stdin("NOPE");
    assert_eq(credential_proxy_resolve(p, missing), 0, "unknown returns 0");
    return 0;
}

fn test_credential_env_vars() {
    test_group("credential_env_vars");
    var p = credential_proxy_new();
    credential_proxy_register(p, "K1", "v1");
    credential_proxy_register(p, "K2", "v2");
    var refs = vec_new();
    vec_push(refs, secret_ref_env("K1", "MY_K1"));
    vec_push(refs, secret_ref_file("K2", "/tmp/secret", 384));
    var env = credential_proxy_env_vars(p, refs);
    assert_eq(vec_len(env), 2, "only ENV refs emitted (name+value)");
    assert_eq(streq(vec_get(env, 0), "MY_K1"), 1, "var name");
    assert_eq(streq(vec_get(env, 1), "v1"), 1, "var value");
    return 0;
}

fn test_credential_file_injections() {
    test_group("credential_file_injections");
    var p = credential_proxy_new();
    credential_proxy_register(p, "TLS_CERT", "-----CERT-----");
    var refs = vec_new();
    vec_push(refs, secret_ref_file("TLS_CERT", "/etc/ssl/cert.pem", 384));
    var files = credential_proxy_file_injections(p, refs);
    assert_eq(vec_len(files), 1, "one file injection");
    var f = vec_get(files, 0);
    assert_eq(streq(FileInjection_path(f), "/etc/ssl/cert.pem"), 1, "path");
    assert_eq(streq(FileInjection_content(f), "-----CERT-----"), 1, "content");
    assert_eq(FileInjection_mode(f), 384, "mode 0o600");
    return 0;
}

fn test_credential_inject_files() {
    test_group("credential_inject_files");

    # Empty vec -> 0 written
    var empty = vec_new();
    assert_eq(credential_inject_files(empty), 0, "empty vec -> 0");

    # One file with mode 0644 — honors mode + lands content
    var dir = "/tmp/kavach-test-inject";
    sys_mkdir(dir, 448);
    var path1 = "/tmp/kavach-test-inject/secret1.txt";
    sys_unlink(path1);
    var injections = vec_new();
    vec_push(injections, file_injection_new(path1, "payload-1", 420));
    var n = credential_inject_files(injections);
    assert_eq(n, 1, "one file written");

    # Verify content
    var buf[64];
    var fd = sys_open(path1, 0, 0);
    assert(fd >= 0, "file readable after inject");
    var rd = sys_read(fd, &buf, 32);
    sys_close(fd);
    assert_eq(rd, 9, "9 bytes content");

    # Two files in one batch — second succeeds even though first existed
    sys_unlink(path1);
    var path2 = "/tmp/kavach-test-inject/secret2.txt";
    sys_unlink(path2);
    var batch = vec_new();
    vec_push(batch, file_injection_new(path1, "alpha", 384));
    vec_push(batch, file_injection_new(path2, "beta", 384));
    assert_eq(credential_inject_files(batch), 2, "two-file batch");
    sys_unlink(path1);
    sys_unlink(path2);

    # O_EXCL refuses preexisting target — returns negative
    sys_open(path1, 1 + 64, 384);    # create empty preexisting target
    var fail_batch = vec_new();
    vec_push(fail_batch, file_injection_new(path1, "blocked", 384));
    var rc = credential_inject_files(fail_batch);
    assert(rc < 0, "O_EXCL refuses preexisting");
    assert_eq(rc, 0 - 1, "rc == -(written+1) == -1 on first-file fail");
    sys_unlink(path1);
    sys_rmdir(dir);
    return 0;
}

fn test_credential_stdin_payload() {
    test_group("credential_stdin_payload");
    var p = credential_proxy_new();
    credential_proxy_register(p, "PART1", "hello");
    credential_proxy_register(p, "PART2", "world");
    var refs = vec_new();
