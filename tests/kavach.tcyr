    vec_push(refs, secret_ref_stdin("PART2"));
    var s = credential_proxy_stdin_payload(p, refs);
    assert(s != 0, "payload built");
    assert_eq(streq(s, "hello\nworld"), 1, "joined with newline");

    var empty_refs = vec_new();
    assert_eq(credential_proxy_stdin_payload(p, empty_refs), 0, "no refs -> 0");
    return 0;
}

fn test_audit_chain_record() {
    test_group("audit_chain_record");
    sha256_global_init();
    var c = audit_chain_open("/tmp/kavach-test-record.audit", "key-a", 5);
    assert_eq(audit_chain_len(c), 1, "genesis auto-recorded");
    audit_chain_record(c, "event1", "payload1");
    assert_eq(audit_chain_len(c), 2, "one more");
    audit_chain_record(c, "event2", "payload2");
    assert_eq(audit_chain_len(c), 3, "three total");
    return 0;
}

fn test_audit_chain_linkage() {
    test_group("audit_chain_linkage");
    sha256_global_init();
    var c = audit_chain_open("/tmp/kavach-test-link.audit", "key-b", 5);
    var e1 = audit_chain_record(c, "a", "p1");
    var e2 = audit_chain_record(c, "b", "p2");
    # e2.prev_hmac should equal e1.hmac
    assert_eq(streq(AuditEntry_prev_hmac(e2), AuditEntry_hmac(e1)), 1, "linked");
    assert(streq(AuditEntry_hmac(e1), AuditEntry_hmac(e2)) == 0, "distinct hmacs");
    return 0;
}

fn test_audit_verify_constant_time() {
    test_group("audit_verify_ct");
    # ct_streq must reject differing strings of SAME length — the
    # comparator we rely on for timing-safe HMAC verify (ADR-005 §C1).
    assert_eq(ct_streq("aaaa", "aaaa"), 1, "equal");
    assert_eq(ct_streq("aaaa", "aaab"), 0, "differ at end");
    assert_eq(ct_streq("aaaa", "baaa"), 0, "differ at start");
    assert_eq(ct_streq("abc", "abcd"), 0, "length mismatch");
    return 0;
}

fn test_json_escape_control_chars() {
    test_group("json_escape_ctrl");
    # \u0001 (SOH) must be escaped as \u0001, not passed through.
    var raw = alloc(4);
    store8(raw, 97);           # 'a'
    store8(raw + 1, 1);        # 0x01 SOH
    store8(raw + 2, 98);       # 'b'
    store8(raw + 3, 0);
    var esc = oci_json_escape(raw);
    assert_eq(streq(esc, "a\\u0001b"), 1, "SOH -> \\u0001");

    # \b \f \t \n \r all get short forms
    var raw2 = alloc(2);
    store8(raw2, 8);           # \b
    store8(raw2 + 1, 0);
    assert_eq(streq(oci_json_escape(raw2), "\\b"), 1, "backspace -> \\b");

    var raw3 = alloc(2);
    store8(raw3, 12);          # \f
    store8(raw3 + 1, 0);
    assert_eq(streq(oci_json_escape(raw3), "\\f"), 1, "formfeed -> \\f");
    return 0;
}

fn test_is_safe_argument() {
    test_group("is_safe_argument");
    assert_eq(is_safe_argument("echo hello"), 1, "normal cmd");
    assert_eq(is_safe_argument("with\ttab"), 1, "tab ok");

    # Build cmd with embedded newline
    var bad = alloc(16);
    memcpy(bad, "line1", 5);
    store8(bad + 5, 10);       # \n
    memcpy(bad + 6, "line2", 6);
    store8(bad + 11, 0);
    assert_eq(is_safe_argument(bad), 0, "newline rejected");

    # Embedded NUL via an allocated buffer
    var bad2 = alloc(8);
    store8(bad2, 97); store8(bad2 + 1, 0);
    assert_eq(is_safe_argument(bad2), 1, "pure ascii ok");
    return 0;
}

# is_safe_text (bounds-checked slice read): tab/newline/CR allowed, other
# control chars rejected. Empty string is trivially safe (zero-len slice).
fn test_is_safe_text() {
    test_group("is_safe_text");
    assert_eq(is_safe_text("hello world"), 1, "plain text ok");
    assert_eq(is_safe_text("a\tb\nc\rd"), 1, "tab/newline/CR allowed");
    assert_eq(is_safe_text(""), 1, "empty ok (zero-len slice)");
    var esc = alloc(4);
    store8(esc, 97); store8(esc + 1, 27); store8(esc + 2, 98); store8(esc + 3, 0);  # a<ESC>b
    assert_eq(is_safe_text(esc), 0, "ESC (0x1b) rejected");
    return 0;
}

fn test_process_rejects_newline_smuggling() {
    test_group("process_newline_smuggle");
    kavach_init();
    var cfg = config_new();
    config_backend(cfg, Backend.PROCESS);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    # Build "ls\ncat /etc/shadow" — without the guard this splits into
    # two tokens and potentially runs the second as a separate exec.
    var cmd = alloc(32);
    memcpy(cmd, "ls", 2);
    store8(cmd + 2, 10);       # \n
    memcpy(cmd + 3, "cat /etc/shadow", 16);
    store8(cmd + 18, 0);
    var r = process_exec(sb, cmd);
    assert_eq(ExecResult_exit_code(r), 126, "newline rejected");
    assert(cstr_contains(ExecResult_stderr(r), "control") == 1, "msg says control");
    return 0;
}

fn test_overflow_helpers() {
    test_group("overflow_helpers");
    assert_eq(checked_add(1, 2), 3, "normal add");
    assert_eq(checked_add(0 - 1, 5), 0 - 1, "neg input rejected");
    # 2^62 + 2^62 = 2^63 which overflows i64 positives.
    var big = 4611686018427387904;
    assert_eq(checked_add(big, big), 0 - 1, "add overflow");

    assert_eq(checked_mul(3, 4), 12, "normal mul");
    assert_eq(checked_mul(big, 2), 0 - 1, "mul overflow");
    assert_eq(checked_mul(0, big), 0, "0 short-circuit");
    return 0;
}

fn test_redact_evidence() {
    test_group("redact_evidence");
    # len > 8: first 4 + **** + last 4
    var r1 = redact_evidence("AKIAIOSFODNN7EXAMPLE", 0, 20);
    assert_eq(streq(r1, "AKIA****MPLE"), 1, "20-char redacted");

    # len <= 8: all asterisks
    var r2 = redact_evidence("abcd", 0, 4);
    assert_eq(streq(r2, "****"), 1, "short fully masked");

    # Evidence from a finding: scanned artifact -> stored finding must
    # not contain the raw secret in audit-log-reachable fields.
    var sr = scan_result_new();
    secrets_scan("leak: AKIAIOSFODNN7EXAMPLE end", sr);
    var v = ScanResult_findings(sr);
    assert(vec_len(v) >= 1, "finding");
    var f = vec_get(v, 0);
    var ev = ScanFinding_evidence(f);
    assert(cstr_contains(ev, "****") == 1, "redacted evidence");
    assert_eq(cstr_contains(ev, "IOSFODNN7EXA"), 0, "no raw middle bytes");
    return 0;
}

fn test_audit_payload_escaped() {
    test_group("audit_payload_escaped");
    sha256_global_init();
    var c = audit_chain_open("/tmp/kavach-test-escape.audit", "key", 3);
    # Payload with embedded quote — must be escaped in JSONL output.
    var e = audit_chain_record(c, "evt", "has \"quote\"");
    # Verification still passes (HMAC covers the unescaped payload).
    assert_eq(audit_entry_verify(e, "key", 3), 1, "verify ok");
    audit_chain_close(c);
    return 0;
}

fn test_audit_chain_close_zeroes_key() {
    test_group("audit_close_zeroes");
    sha256_global_init();
    var keybuf = alloc(16);
    memcpy(keybuf, "mysecretkey12345", 16);
    var c = audit_chain_open("/tmp/kavach-test-close.audit", keybuf, 16);
    # key pointer is held inside the chain struct
    assert_eq(AuditChain_hmac_key(c), keybuf, "key ptr stored");
    audit_chain_close(c);
    assert_eq(AuditChain_hmac_key(c), 0, "key pointer cleared");
    # Key buffer itself is zeroed
    assert_eq(load8(keybuf), 0, "first byte zeroed");
    assert_eq(load8(keybuf + 15), 0, "last byte zeroed");
    return 0;
}

fn test_uuid_v4_distinct() {
    test_group("uuid_v4");
    # Four random u64s must all differ (collision probability ~ 2^-62).
    var a = rand_u64();
    var b = rand_u64();
    var c = rand_u64();
    var d = rand_u64();
    assert(a != b, "a != b");
    assert(a != c, "a != c");
    assert(a != d, "a != d");
    assert(b != c, "b != c");
    # A fresh sandbox + a fresh finding must have distinct ids too.
    var cfg = config_new();
    config_backend(cfg, Backend.NOOP);
    var sb1 = sandbox_create(cfg);
    var sb2 = sandbox_create(cfg);
    assert(Sandbox_id(sb1) != Sandbox_id(sb2), "sandbox ids distinct");
    var f1 = finding_new("s", Severity.LOW, "c", "m", 0);
    var f2 = finding_new("s", Severity.LOW, "c", "m", 0);
    assert(ScanFinding_id(f1) != ScanFinding_id(f2), "finding ids distinct");
    return 0;
}

fn test_warn_verdict_redacts_stdout() {
    test_group("warn_redact_stdout");
    # Low-severity finding (Email) lands in WARN tier under the default
    # policy (block=Critical, quarantine=High, anything > Info = Warn).
    var er = exec_result_new();
    ExecResult_set_stdout(er, "prefix AKIAIOSFODNN7EXAMPLE middle ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij tail");
    # Manually tune the policy so the gate emits WARN instead of BLOCK
    # (AWS key is Critical → BLOCK under defaults).
    var pol = ext_policy_default();
    ExternalizationPolicy_set_block_threshold(pol, Severity.CRITICAL + 1);
    ExternalizationPolicy_set_quarantine_threshold(pol, Severity.CRITICAL + 1);

    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.WARN, "verdict = warn");
    var out = ExecResult_stdout(er);
    assert(cstr_contains(out, "AKIAIOSFODNN7EXAMPLE") == 0, "aws key redacted");
    assert(cstr_contains(out, "[REDACTED:cloud_credential]") == 1, "marker present");
    assert(cstr_contains(out, "ghp_ABCDEFGHIJKLMNOPQRST") == 0, "gh token redacted");
    assert(cstr_contains(out, "[REDACTED:api_token]") == 1, "gh marker");
    assert(cstr_contains(out, "prefix ") == 1, "leading context preserved");
    assert(cstr_contains(out, " tail") == 1, "trailing context preserved");
    return 0;
}

fn test_warn_verdict_redact_disabled() {
    test_group("warn_redact_disabled");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "prefix AKIAIOSFODNN7EXAMPLE tail");
    var pol = ext_policy_default();
    ExternalizationPolicy_set_block_threshold(pol, Severity.CRITICAL + 1);
    ExternalizationPolicy_set_quarantine_threshold(pol, Severity.CRITICAL + 1);
    ExternalizationPolicy_set_redact_secrets(pol, 0);
    gate_apply(er, pol);
    assert(cstr_contains(ExecResult_stdout(er), "AKIAIOSFODNN7EXAMPLE") == 1, "not redacted");
    return 0;
}

