fn test_attestation_trust_ordering() {
    test_group("attestation_ordering");
    assert(AttestationTrust.CONTRAINDICATED < AttestationTrust.WARNING, "c<w");
    assert(AttestationTrust.WARNING < AttestationTrust.NONE, "w<n");
    assert(AttestationTrust.NONE < AttestationTrust.AFFIRMING, "n<a");
    return 0;
}

fn test_attestation_acceptable() {
    test_group("attestation_acceptable");
    var r = attestation_result_new(Backend.SGX);
    AttestationResult_set_trust(r, AttestationTrust.AFFIRMING);
    assert_eq(attestation_is_acceptable(r, AttestationTrust.NONE), 1, "affirming passes NONE bar");
    assert_eq(attestation_is_acceptable(r, AttestationTrust.AFFIRMING), 1, "affirming passes AFFIRMING bar");

    AttestationResult_set_trust(r, AttestationTrust.WARNING);
    assert_eq(attestation_is_acceptable(r, AttestationTrust.NONE), 0, "warning fails NONE bar");
    return 0;
}

fn test_sgx_report_verify_structure() {
    test_group("sgx_report_struct");
    var r = sgx_report_new();
    # All-zero report fails.
    assert_eq(sgx_report_verify_structure(r), 0, "empty report rejected");
    # Valid measurements + signature
    SgxAttestationReport_set_mrenclave_hex(r,
    "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
    SgxAttestationReport_set_mrsigner_hex(r,
    "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210");
    SgxAttestationReport_set_ias_signature(r, "base64signatureblobthatisatleast32chars...");
    assert_eq(sgx_report_verify_structure(r), 1, "valid structure");
    # Non-hex measurement fails
    SgxAttestationReport_set_mrenclave_hex(r,
    "XYZ456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0");
    assert_eq(sgx_report_verify_structure(r), 0, "non-hex rejected");
    return 0;
}

fn test_integrity_report_shape() {
    test_group("integrity_report");
    var r = check_integrity();
    assert(r != 0, "report returned");
    var checks = IntegrityReport_checks(r);
    assert_eq(vec_len(checks), 3, "3 checks: pid+mount+user ns");
    # Each check has a name + pass flag + detail
    var i = 0;
    while (i < vec_len(checks)) {
        var c = vec_get(checks, i);
        assert(IntegrityCheck_name(c) != 0, "name present");
        assert(IntegrityCheck_detail(c) != 0, "detail present");
        i = i + 1;
    }
    # Running from a terminal on a non-containerized host, this test
    # MAY report intact=0 — that's a correct signal, not a bug.
    assert(IntegrityReport_checked_at(r) > 0, "timestamp captured");
    return 0;
}

fn test_oci_bundle_mode_0700() {
    test_group("oci_bundle_mode");
    var cfg = config_new();
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    var id = oci_container_id("kavach-modetest");
    var bundle = oci_prepare_bundle(id, sb, "echo hi");
    assert(bundle != 0, "bundle created");
    # Random id component prevents predictable-path attacks.
    assert(cstr_contains(id, "kavach-modetest-") == 1, "prefix kept");
    # ID includes 16-hex random suffix → total length > prefix+timestamp+counter
    assert(strlen(id) > 30, "id includes randomness");
    oci_cleanup_bundle(bundle);
    return 0;
}

fn test_audit_entry_verify() {
    test_group("audit_verify");
    sha256_global_init();
    var c = audit_chain_open("/tmp/kavach-test-verify.audit", "mykey", 5);
    var e = audit_chain_record(c, "good", "clean payload");
    assert_eq(audit_entry_verify(e, "mykey", 5), 1, "correct key verifies");
    assert_eq(audit_entry_verify(e, "wrong", 5), 0, "wrong key fails");

    # Tamper the payload in place; verification must fail with original key.
    AuditEntry_set_payload(e, "tampered payload");
    assert_eq(audit_entry_verify(e, "mykey", 5), 0, "tamper detected");
    return 0;
}

