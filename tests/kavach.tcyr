fn test_offender_tracker_basic() {
    test_group("offender_tracker_basic");
    var t = offender_tracker_new();
    assert_eq(offender_tracker_count(t), 0, "empty");

    var findings = vec_new();
    vec_push(findings, finding_new("secrets", Severity.CRITICAL, "private_key", "k", 0));
    vec_push(findings, finding_new("code", Severity.CRITICAL, "command_injection", "c", 0));
    vec_push(findings, finding_new("code", Severity.CRITICAL, "data_exfiltration", "d", 0));
    var assess = classify_threat(findings);

    offender_tracker_record(t, "agent-A", assess);
    offender_tracker_record(t, "agent-A", assess);
    offender_tracker_record(t, "agent-B", assess);
    assert_eq(offender_tracker_count(t), 3, "three records");

    # agent-A accumulates: 1000 + 1000 = 2000 (fresh, no decay yet)
    var score_a = offender_tracker_agent_score(t, "agent-A");
    assert(score_a >= 1500, "agent-A score high");
    var score_b = offender_tracker_agent_score(t, "agent-B");
    assert(score_b < score_a, "agent-B below A");
    var score_unknown = offender_tracker_agent_score(t, "agent-unknown");
    assert_eq(score_unknown, 0, "unknown = 0");
    return 0;
}

fn test_offender_tracker_escalation() {
    test_group("offender_tracker_escalate");
    # Default threshold = 3000 (x1000 = 3.0). Four MALICIOUS records at
    # intent=1000 each sum to 4000 > 3000 → escalate.
    var t = offender_tracker_new();
    var findings = vec_new();
    vec_push(findings, finding_new("secrets", Severity.CRITICAL, "private_key", "k", 0));
    vec_push(findings, finding_new("code", Severity.CRITICAL, "command_injection", "c", 0));
    vec_push(findings, finding_new("code", Severity.CRITICAL, "data_exfiltration", "d", 0));
    var assess = classify_threat(findings);

    offender_tracker_record(t, "spammer", assess);
    offender_tracker_record(t, "spammer", assess);
    offender_tracker_record(t, "spammer", assess);
    offender_tracker_record(t, "spammer", assess);
    assert_eq(offender_tracker_should_escalate(t, "spammer"), 1, "escalate");

    assert_eq(offender_tracker_should_escalate(t, "calm"), 0, "calm passes");
    return 0;
}

fn test_composite_merge_policies() {
    test_group("composite_merge");
    # minimal + strict → strict wins.
    var merged = merge_policies(policy_minimal(), policy_strict());
    assert_eq(SandboxPolicy_seccomp_enabled(merged), 1, "seccomp from strict");
    assert_eq(SandboxPolicy_read_only_rootfs(merged), 1, "ro from strict");
    assert_eq(SandboxPolicy_memory_limit_mb(merged), 512, "mem from strict");
    assert_eq(SandboxPolicy_network_enabled(merged), 0, "network disabled (both)");

    # seccomp profile: strict wins over basic
    var p_b = policy_basic();
    var p_s = policy_strict();
    var merged_bs = merge_policies(p_b, p_s);
    assert_eq(streq(SandboxPolicy_seccomp_profile(merged_bs), "strict"), 1, "strict wins");

    # memory: smaller wins
    var p1 = policy_minimal();
    var p2 = policy_minimal();
    SandboxPolicy_set_memory_limit_mb(p1, 1024);
    SandboxPolicy_set_memory_limit_mb(p2, 256);
    var m = merge_policies(p1, p2);
    assert_eq(SandboxPolicy_memory_limit_mb(m), 256, "min wins");
    return 0;
}

fn test_composite_score() {
    test_group("composite_score");
    # gVisor outer (base 70) + Process inner (base 50), strict policy
    # gvisor strict score ≈ 89 (70+5+5+3+2+2+2), so composite = 89+5 = 94
    var p = policy_strict();
    var score = score_composite(Backend.GVISOR, Backend.PROCESS, p);
    assert(score >= 80, "layered bonus");
    assert(score <= 100, "clamped");
    return 0;
}

