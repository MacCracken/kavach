# 3.11.8: the WASM backend is REACHABLE. `backend_is_available` used to return a
# hardcoded 0 for it while `wasm_health` right beside it did the correct probe —
# and `sandbox_create` refuses an unavailable backend, so the whole path was
# dead through the public API even with wasmtime installed.
fn test_wasm_availability_is_probed() {
    test_group("wasm_availability");
    kavach_init();

    # ⚠ The two must AGREE. They disagreeing is precisely the bug: one said
    # "never available" and the other probed. Asserting equality rather than a
    # fixed value keeps the test honest on a box that has wasmtime and on one
    # that does not.
    assert_eq(backend_is_available(KavachBackend.WASM), wasm_health(0),
      "availability and health agree — they used to contradict each other");

    # And it tracks the binary, rather than being a constant either way.
    var have = 0;
    if (_wasm_binary_path() != 0) { have = 1; }
    assert_eq(backend_is_available(KavachBackend.WASM), have,
      "availability follows whether a wasmtime binary was found");

    # A sandbox can actually be created when the runtime is present. On a box
    # without wasmtime this asserts the refusal instead, which is the arm that
    # is reachable here — and it is a real assertion, not a skip.
    var cfg = config_new();
    config_backend(cfg, KavachBackend.WASM);
    var sb = sandbox_create(cfg);
    if (have == 1) {
        assert(sb != 0, "with wasmtime present, a WASM sandbox is creatable");
    } else {
        assert_eq(sb, 0, "without wasmtime, creation is refused rather than half-working");
    }
    return 0;
}

# 3.11.8: `SandboxConfig` carries the payload's stdin. Before this there was no
# way to give a guest its input at all, which is what made the backend unusable
# as a tool host — agnosai filed it while porting `.agpkg`.
fn test_config_stdin() {
    test_group("config_stdin");
    var cfg = config_new();
    assert_eq(SandboxConfig_stdin(cfg), 0, "a fresh config holds no stdin");
    assert_eq(SandboxConfig_stdin_len(cfg), 0, "with no length");
    assert_eq(SandboxConfig_stdin_inherit(cfg), 0, "and does not opt in to kavach's own");

    var payload = "{\"parameters\":{\"name\":\"world\"}}";
    config_stdin(cfg, payload, strlen(payload));
    assert_eq(SandboxConfig_stdin(cfg), payload, "and it round-trips the pointer");
    assert_eq(SandboxConfig_stdin_len(cfg), strlen(payload), "and the length");

    # ⚠ Appending a field must not move any existing offset — the same discipline
    # `require_ns` followed at 88 and `stdin`/`stdin_len` at 104. `fuel` took it
    # to 112 in 3.11.11 and `env` to 120 in 3.12.0; these read-backs are what say
    # the append was clean.
    assert_eq(SandboxConfig_backend(cfg), KavachBackend.PROCESS, "backend still reads");
    assert_eq(SandboxConfig_timeout_ms(cfg), 30000, "timeout still reads");
    assert_eq(SandboxConfig_inner_backend(cfg), 0 - 1, "inner_backend still reads");
    assert_eq(SandboxConfig_stdin(cfg), payload,
      "stdin still reads its own value, at its old offset");
    assert_eq(SandboxConfig_fuel(cfg), 0, "and fuel defaults to 0 — derive from timeout");
    assert_eq(SandboxConfig_env(cfg), 0, "and env defaults to 0 — empty envp, as before");
    # `stdin_inherit` took it to 128 in 3.13.2.
    config_stdin_inherit(cfg, 1);
    assert_eq(SandboxConfig_stdin(cfg), payload, "stdin reads past stdin_inherit's append");
    assert_eq(SandboxConfig_env(cfg), 0, "and so does env");
    assert_eq(SANDBOX_CONFIG_SIZE, 128, "and the struct is 128 bytes");
    return 0;
}

# 3.12.2: the payload really lands in the caller's working directory.
#
# ⚠ Same lesson as `test_confine_capture_env`: assert on what the PAYLOAD observes.
# `config_workdir` existed since before 3.12.0 and was DECORATIVE — its only reader
# was the WASM backend's `--dir` preopen, so every process/OCI caller set it and got
# cwd `/`. A test that only checked the setter round-tripped would have passed
# throughout.
fn test_confine_capture_workdir() {
    test_group("confine_capture_workdir");
    var buf = alloc(4096);

    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, "printf %s \"$PWD\"");

    # Unset -> the pre-3.12.2 behaviour: whatever cwd the parent had. Only assert
    # that it is NOT the directory we are about to ask for, so the positive case
    # below cannot pass vacuously.
    var n0 = confine_capture_input_env(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0, 0);
    assert(n0 > 0, "unset workdir still runs and reports some cwd");
    assert_eq(memeq(buf, "/tmp", 4), 0, "and it is not /tmp — the control is real");

    # Set -> the payload runs there.
    var n1 = confine_capture_input_env_wd(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0, 0,
      "/tmp");
    assert_eq(n1, strlen("/tmp"), "the payload's cwd is the requested directory");
    assert_eq(memeq(buf, "/tmp", 4), 1, "byte for byte — this is the decorative-setter check");
    assert_eq(confine_last_exit(), 0, "and it exits 0");

    # ⚠ FAILS CLOSED. A workdir that does not exist must not silently run from
    # somewhere else — the child _exits with SPAWN_EXIT_WORKDIR before execve.
    confine_capture_input_env_wd(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0, 0,
      "/nonexistent-workdir-probe");
    assert_eq(confine_last_exit(), SPAWN_EXIT_WORKDIR,
      "a missing workdir refuses the spawn rather than running from the wrong place");
    return 0;
}

# 3.12.0: the payload really receives the caller's environment.
#
# ⚠ This test exists because a WEAKER one let a real bug ship in a consumer.
# stiva asserted that its RuntimeSpec carried the env — which it did — and never
# asserted that a container could READ it. The env was built, persisted, and
# silently dropped at the kavach boundary for several releases with a green
# suite. The lesson generalises: assert on what the payload observes, not on
# what the caller assembled.
fn test_confine_capture_env() {
    test_group("confine_capture_env");
    var buf = alloc(4096);

    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, "printf %s \"$KAVACH_TEST_VAR\"");

    # Unset env is the historical empty envp — the variable must NOT be visible.
    var n0 = confine_capture_input(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0);
    assert_eq(n0, 0, "with no env, the variable is unset and expands to nothing");
    assert_eq(confine_last_exit(), 0, "and the shell still exits cleanly");

    # Explicitly supplied, it reaches the payload.
    var env = vec_new();
    vec_push(env, "KAVACH_TEST_VAR=reached-the-payload");
    var n1 = confine_capture_input_env(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0, env);
    assert_eq(n1, strlen("reached-the-payload"), "the payload reads the supplied value");
    assert_eq(memeq(buf, "reached-the-payload", strlen("reached-the-payload")), 1,
      "byte for byte — this is the assertion the consumer bug was missing");
    assert_eq(confine_last_exit(), 0, "and exits 0");

    # Nothing is inherited: kavach's own environment must not leak through.
    #
    # ⚠ Probe with HOME, NOT PATH. `/bin/sh` SYNTHESISES a default PATH when the
    # variable is absent, so `$PATH` is non-empty even under `execve` with a
    # genuinely empty envp — measured: `env -i /bin/sh -c 'printf %s "$PATH"'`
    # prints 39 characters. Asserting on PATH tests the shell, not the envp, and
    # fails against correct code. HOME is not synthesised.
    var home = getenv("HOME");
    if (home != 0) {
        var pargs = vec_new();
        vec_push(pargs, "/bin/sh");
        vec_push(pargs, "-c");
        vec_push(pargs, "printf %s \"$HOME\"");
        var n2 = confine_capture_input_env(pargs, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0, env);
        assert_eq(n2, 0, "HOME is NOT inherited — an explicit list replaces, never extends");
    }

    # An empty vec is still an empty environment, not a fallback to inheritance.
    var n3 = confine_capture_input_env(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0, vec_new());
    assert_eq(n3, 0, "an empty list yields an empty environment");
    return 0;
}

# ---- the process backend hands the payload its stdin, env and workdir ------
#
# The capture tests above call `confine_capture_*` directly, so none of them
# saw what `process_exec` passed down. Through 3.13.0 it passed no stdin on
# either capture, so a payload read kavach's own stdin instead of the config's
# (measured: `/bin/cat` under a config holding `CONFIG-STDIN` printed what the
# host process had on stdin). Its unconfined capture, taken when the policy
# asks for no confinement, also passed no environment and no working
# directory. These go through `sandbox_exec`, as a consumer does.

# `cmd` on the PROCESS backend under `policy`, with the config's stdin, env and
# workdir set where not 0. A 5 s deadline, so a payload left reading a terminal
# fails rather than hangs.
fn _t_pio_run(policy, cmd, stdin, env, wd) {
    var c = config_new();
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy);
    config_timeout_ms(c, 5000);
    if (stdin != 0) { config_stdin(c, stdin, strlen(stdin)); }
    if (env != 0) { config_env(c, env); }
    if (wd != 0) { config_workdir(c, wd); }
    var s = sandbox_create(c);
    if (s == 0) { return 0; }
    sandbox_transition(s, SandboxState.RUNNING);
    var r = sandbox_exec(s, cmd);
    sandbox_destroy(s);
    return r;
}

# "<which>: <text>", an assertion message naming the capture.
fn _t_pio_msg(which, text) {
    return str_cstr(str_cat(str_cat(str_from(which), str_from(": ")), str_from(text)));
}

# Whether `r` exited 0 and its stdout holds `marker`.
fn _t_pio_saw(r, marker) {
    if (r == 0) { return 0; }
    if (ExecResult_exit_code(r) != 0) { return 0; }
    return cstr_contains(ExecResult_stdout(r), marker);
}

fn test_process_exec_honours_config_io() {
    test_group("process_exec_honours_config_io");
    kavach_init();
    var env = vec_new();
    vec_push(env, "KAVACH_PIO_VAR=reached-through-sandbox-exec");
    var wd = _t_unique_tmp_path("/tmp/kavach-t-pio-");
    kv_mkdir(wd, 493);                                     # 0755
    var wd_line = str_cstr(str_cat(str_from(wd), str_from("\n")));

    # Both captures: the unconfined one, for a policy asking for nothing, and
    # the confined one, reached by landlock rules (which qemu-user takes as a
    # no-op, still through the confined capture) and, where the host loads a
    # filter, by seccomp as `config_new`'s default policy asks.
    var rounds = 2;
    if (_t_host_loads_seccomp() == 1) { rounds = 3; }
    var round = 0;
    while (round < rounds) {
        var p = policy_minimal();
        var which = "unconfined";
        if (round == 1) {
            p = _t_ll_add_runtime(policy_minimal());
            which = "confined by landlock";
        }
        if (round == 2) {
            p = policy_basic();
            which = "confined by seccomp";
        }
        var r_in = _t_pio_run(p, "/bin/cat", "KAVACH-PIO-STDIN\n", 0, 0);
        var r_env = _t_pio_run(p, "/usr/bin/env", 0, env, 0);
        var r_wd = _t_pio_run(p, "/bin/pwd", 0, 0, wd);
        assert_eq(_t_pio_saw(r_in, "KAVACH-PIO-STDIN"), 1, _t_pio_msg(which, "the payload reads the config's stdin"));
        assert_eq(_t_pio_saw(r_env, "KAVACH_PIO_VAR=reached-through-sandbox-exec"), 1,
          _t_pio_msg(which, "...sees the config's environment"));
        assert_eq(_t_pio_saw(r_wd, wd_line), 1, _t_pio_msg(which, "...and runs in the config's workdir"));

        # An empty stdin is an immediate EOF, not a fallback to kavach's own.
        var re = _t_pio_run(p, "/bin/cat", "", 0, 0);
        var eof = 0;
        if (re != 0) {
            if (ExecResult_exit_code(re) == 0 && ExecResult_timed_out(re) == 0) {
                if (strlen(ExecResult_stdout(re)) == 0) { eof = 1; }
            }
        }
        assert_eq(eof, 1, _t_pio_msg(which, "an empty stdin is EOF, and cat ends at once"));
        round = round + 1;
    }
    kv_rmdir(wd);
    return 0;
}

# 3.11.8: the payload really receives its stdin, and the parent really sees the
# guest's exit code and stderr. `/bin/cat` is the smallest proof of the first;
# `/bin/false` and `/bin/sh -c` of the rest.
fn test_confine_capture_input() {
    test_group("confine_capture_input");
    var buf = alloc(4096);

    # stdin reaches the child and is echoed back.
    var args = vec_new();
    vec_push(args, "/bin/cat");
    var msg = "hello from stdin";
    var n = confine_capture_input(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0,
      msg, strlen(msg));
    assert_eq(n, strlen(msg), "cat echoes exactly what was written to its stdin");
    assert_eq(memeq(buf, msg, strlen(msg)), 1, "byte for byte");
    assert_eq(confine_last_exit(), 0, "and exits 0");

    # ⚠ The stdin pipe is CLOSED after the write. Without that, `cat` blocks on a
    # read that never ends and this returns a TIMEOUT — the failure would look
    # like a slow guest rather than a protocol mistake.
    assert_eq(confine_last_timed_out(), 0, "and does not time out, because stdin was closed");

    # An empty input still closes stdin, so the child sees EOF immediately.
    var n2 = confine_capture_input(args, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0);
    assert_eq(n2, 0, "an empty stdin yields no output");
    assert_eq(confine_last_exit(), 0, "and still exits cleanly");
    assert_eq(confine_last_timed_out(), 0, "rather than hanging on a never-closed pipe");

    # ⚠ The REAL exit code, which `exec_capture` discarded. This is the whole of
    # finding 3: a guest that fails must not report success.
    var fargs = vec_new();
    vec_push(fargs, "/bin/false");
    confine_capture_input(fargs, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0);
    assert_eq(confine_last_exit(), 1, "/bin/false reports exit 1, not 0");

    # And the guest's own stderr, which used to be hard-redirected to /dev/null.
    var eargs = vec_new();
    vec_push(eargs, "/bin/sh");
    vec_push(eargs, "-c");
    vec_push(eargs, "echo oops 1>&2; exit 3");
    confine_capture_input(eargs, 0, 0, 0, 0, buf, 4096, 0, 5000, 0, "", 0);
    assert_eq(confine_last_exit(), 3, "an explicit exit code survives");
    assert_eq(strlen(confine_last_stderr()) > 0, 1, "and stderr is captured, not discarded");

    # `input = 0` keeps the pre-3.11.8 INHERIT behaviour, so no existing caller
    # changed. `confine_capture` is that path.
    var cargs = vec_new();
    vec_push(cargs, "/bin/true");
    assert(confine_capture(cargs, 0, 0, 0, 0, buf, 4096, 0, 5000, 0) >= 0,
      "the inherit-stdin wrapper still works");
    assert_eq(confine_last_exit(), 0, "with a real exit code");
    return 0;
}

fn test_wasm_registered() {
    test_group("wasm_registered");
    kavach_init();
    assert_eq(backend_is_registered(KavachBackend.WASM), 1, "wasm slot populated");
    return 0;
}

fn test_wasm_fuel_calculation() {
    test_group("wasm_fuel");
    # Matches Rust: fuel = timeout_ms * 1_000_000
    assert_eq(_wasm_fuel_from_timeout(1000), 1000000000, "1s -> 1G fuel");
    assert_eq(_wasm_fuel_from_timeout(100), 100000000, "100ms -> 100M fuel");
    assert_eq(_wasm_fuel_from_timeout(0), 0, "0 -> 0");
    return 0;
}

fn test_wasm_trim() {
    test_group("wasm_trim");
    assert_eq(streq(_wasm_trim("  /tmp/foo.wasm  "), "/tmp/foo.wasm"), 1, "strips ws");
    assert_eq(streq(_wasm_trim("\t/foo.wasm\n"), "/foo.wasm"), 1, "strips tab+lf");
    assert_eq(streq(_wasm_trim("/foo.wasm"), "/foo.wasm"), 1, "no change");
    assert_eq(streq(_wasm_trim(""), ""), 1, "empty stays empty");
    return 0;
}

fn test_wasm_exec_without_wasmtime() {
    test_group("wasm_no_wasmtime");
    kavach_init();
    var cfg = config_new();
    config_backend(cfg, KavachBackend.WASM);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    if (_wasm_binary_path() == 0) {
        var r = wasm_exec(sb, "/tmp/whatever.wasm");
        assert_eq(ExecResult_exit_code(r), 1, "clean failure");
        assert(cstr_contains(ExecResult_stderr(r), "wasmtime") == 1, "mentions wasmtime");
    }
    return 0;
}

# Run a REAL module end to end — the test that was missing, and the reason the
# argv could be wrong for as long as it was.
#
# ⚠ `test_wasm_exec_without_wasmtime` and `test_wasm_exec_missing_file` both
# fail BEFORE argv is assembled, so neither could ever see a bad flag. Until
# 3.11.10 this backend emitted `--max-memory-size <bytes>` and `--fuel <N>` as
# top-level `wasmtime run` flags; wasmtime answers
# `error: unexpected argument '--max-memory-size' found` and runs nothing. Every
# test still passed.
#
# The module is 36 bytes, hand-assembled here rather than checked in: magic +
# version, a `() -> ()` type, one function, an exported `_start`, and a body that
# is a single END opcode. No toolchain needed — building it from a .wat would
# require `wat2wasm`, and depending on a Rust wasm target to test a shell-out
# would be a heavier dependency than the thing under test.
# A module declaring a 128 MiB memory — 42 bytes.
#
# The discriminator for the default ceiling: it instantiates fine with no
# `-W max-memory-size` and is REFUSED under 64 MiB. Verified against wasmtime 47
# directly before being wired here.
fn _write_mem128_wasm(path) {
    var b[42];
    store8(&b + 0, 0); store8(&b + 1, 97); store8(&b + 2, 115); store8(&b + 3, 109); store8(&b + 4, 1); store8(&b + 5, 0); store8(&b + 6, 0); store8(&b + 7, 0);
    store8(&b + 8, 1); store8(&b + 9, 4); store8(&b + 10, 1); store8(&b + 11, 96); store8(&b + 12, 0); store8(&b + 13, 0); store8(&b + 14, 3); store8(&b + 15, 2);
    store8(&b + 16, 1); store8(&b + 17, 0); store8(&b + 18, 5); store8(&b + 19, 4); store8(&b + 20, 1); store8(&b + 21, 0); store8(&b + 22, 128); store8(&b + 23, 16);
    store8(&b + 24, 7); store8(&b + 25, 10); store8(&b + 26, 1); store8(&b + 27, 6); store8(&b + 28, 95); store8(&b + 29, 115); store8(&b + 30, 116); store8(&b + 31, 97);
    store8(&b + 32, 114); store8(&b + 33, 116); store8(&b + 34, 0); store8(&b + 35, 0); store8(&b + 36, 10); store8(&b + 37, 4); store8(&b + 38, 1); store8(&b + 39, 2);
    store8(&b + 40, 0); store8(&b + 41, 11);
    return file_write_all(path, &b, 42);
}

fn _write_nop_wasm(path) {
    var b[64];
    var n = 0;
    # magic \0asm, version 1
    store8(&b + n, 0); n = n + 1;
    store8(&b + n, 97); n = n + 1;
    store8(&b + n, 115); n = n + 1;
    store8(&b + n, 109); n = n + 1;
    store8(&b + n, 1); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    # type section: 1 type, () -> ()
    store8(&b + n, 1); n = n + 1;
    store8(&b + n, 4); n = n + 1;
    store8(&b + n, 1); n = n + 1;
    store8(&b + n, 96); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    # function section: 1 func of type 0
    store8(&b + n, 3); n = n + 1;
    store8(&b + n, 2); n = n + 1;
    store8(&b + n, 1); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    # export section: "_start" -> func 0
    store8(&b + n, 7); n = n + 1;
    store8(&b + n, 10); n = n + 1;
    store8(&b + n, 1); n = n + 1;
    store8(&b + n, 6); n = n + 1;
    store8(&b + n, 95); n = n + 1;
    store8(&b + n, 115); n = n + 1;
    store8(&b + n, 116); n = n + 1;
    store8(&b + n, 97); n = n + 1;
    store8(&b + n, 114); n = n + 1;
    store8(&b + n, 116); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    # code section: 1 body, size 2, 0 locals, END
    store8(&b + n, 10); n = n + 1;
    store8(&b + n, 4); n = n + 1;
    store8(&b + n, 1); n = n + 1;
    store8(&b + n, 2); n = n + 1;
    store8(&b + n, 0); n = n + 1;
    store8(&b + n, 11); n = n + 1;
    file_write_all(path, &b, n);
    return n;
}

fn test_wasm_exec_real_module() {
    test_group("wasm_real_module");
    kavach_init();
    if (_wasm_binary_path() == 0) { return 0; }

    var path = "/tmp/kavach-test-nop.wasm";
    assert_eq(_write_nop_wasm(path), 36, "the 36-byte nop module is written");

    # ⚠ **BOTH limits must be set or this test proves nothing.** `policy_new()`
    # zeroes the struct, and `_wasm_append_limits` emits each flag only when its
    # value is > 0 — so with a default config the argv is bare `wasmtime run --
    # <path>`, which is valid under every spelling. The first version of this
    # test did exactly that and passed with the broken flags restored.
    #
    # A memory limit makes `-W max-memory-size=` reachable; a timeout makes
    # `-W fuel=` reachable via `_wasm_fuel_from_timeout`.
    var pol = policy_new();
    SandboxPolicy_set_memory_limit_mb(pol, 64);
    var cfg = config_new();
    config_backend(cfg, KavachBackend.WASM);
    config_policy(cfg, pol);
    config_timeout_ms(cfg, 5000);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);

    var r = wasm_exec(sb, path);
    assert(r != 0, "wasm_exec returns a result");
    # ⚠ THE assertion. On the pre-3.11.10 argv wasmtime rejects the flags and
    # exits non-zero without running the guest, so this is 1 rather than 0.
    assert_eq(ExecResult_exit_code(r), 0,
      "the guest RAN and exited 0 — a non-zero here means wasmtime rejected the argv");
    assert_eq(cstr_contains(ExecResult_stderr(r), "unexpected argument"), 0,
      "and wasmtime did not complain about an unknown flag");
    return 0;
}

# ⚠ **An explicit fuel budget must REACH wasmtime, and 0 must still fall back.**
#
# `_wasm_fuel_from_timeout` turns a WALL-CLOCK bound into a CPU one — 3e10 at the
# default 30 s timeout — so a caller wanting Rust's
# `Store::set_fuel(1_000_000_000)` had no way to ask for it without also
# shortening its timeout to a second. Reported by agnosai, whose `WasmSandbox`
# advertised the oracle's 1e9 while the guest ran with 30x that.
#
# A budget of 1 is the discriminator: it is enough to instantiate nothing, so
# wasmtime exhausts it and the guest does NOT exit 0. With the field ignored the
# 5 s timeout would derive 5e9 and the module would run fine.
fn test_wasm_exec_explicit_fuel() {
    test_group("wasm_explicit_fuel");
    kavach_init();
    if (_wasm_binary_path() == 0) { return 0; }

    var path = "/tmp/kavach-test-fuel.wasm";
    assert_eq(_write_nop_wasm(path), 36, "the 36-byte nop module is written");

    var pol = policy_new();
    SandboxPolicy_set_memory_limit_mb(pol, 64);

    # A generous budget: the guest runs.
    var ok_cfg = config_new();
    config_backend(ok_cfg, KavachBackend.WASM);
    config_policy(ok_cfg, pol);
    config_timeout_ms(ok_cfg, 5000);
    config_fuel(ok_cfg, 1000000000);
    var ok_sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(ok_sb, ok_cfg);
    assert_eq(ExecResult_exit_code(wasm_exec(ok_sb, path)), 0,
      "a 1e9 budget runs the guest to completion");

    # A budget of 1: wasmtime refuses.
    var tight = config_new();
    config_backend(tight, KavachBackend.WASM);
    config_policy(tight, pol);
    config_timeout_ms(tight, 5000);
    config_fuel(tight, 1);
    var tight_sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(tight_sb, tight);
    assert_neq(ExecResult_exit_code(wasm_exec(tight_sb, path)), 0,
      "a budget of 1 EXHAUSTS — a 0 here means config_fuel never reached wasmtime");

    # 0 keeps the historical behaviour: derive from the timeout.
    assert_eq(_wasm_effective_fuel(ok_cfg, 5000), 1000000000,
      "an explicit budget wins over the timeout-derived one");
    var bare = config_new();
    assert_eq(_wasm_effective_fuel(bare, 5000), 5000000000,
      "and 0 falls back to timeout_ms * 1e6, which is what every caller had before");
    return 0;
}

# ⚠ **A default policy must NOT mean an unbounded guest.**
#
# `config_new()` installs `policy_basic()`, which leaves `memory_limit_mb` at 0,
# and `_wasm_append_limits` used to emit `-W max-memory-size` only when that was
# > 0 — so every caller on the default ran with no ceiling. A wasm32 guest can
# claim 4 GiB. Now the backend falls back to `WASM_DEFAULT_MEMORY_LIMIT_MB`,
# which is the 64 MiB Rust's own `WasmSandbox` defaults to.
fn test_wasm_default_memory_ceiling() {
    test_group("wasm_default_memory");
    assert_eq(_wasm_effective_memory_mb(policy_basic()), WASM_DEFAULT_MEMORY_LIMIT_MB,
      "a policy naming no limit falls back to the default ceiling");
    var explicit = policy_new();
    SandboxPolicy_set_memory_limit_mb(explicit, 7);
    assert_eq(_wasm_effective_memory_mb(explicit), 7,
      "and an explicit limit still wins");
    assert_eq(_wasm_effective_memory_mb(policy_strict()), 512,
      "policy_strict keeps its own 512");

    kavach_init();
    if (_wasm_binary_path() == 0) { return 0; }

    # The default config's policy is policy_basic, which since 3.13.2 also runs
    # wasmtime under seccomp. A host that cannot load a filter (qemu-user)
    # refuses that with 125 before the ceiling is reached, so there the ceiling
    # is checked under policy_minimal, which names no memory limit either.
    var pol = policy_basic();
    if (_t_host_loads_seccomp() == 0) { pol = policy_minimal(); }

    # End to end: a module declaring 128 MiB must be REFUSED under the default,
    # where before it instantiated freely.
    var path = "/tmp/kavach-test-mem128.wasm";
    assert_eq(_write_mem128_wasm(path), 42, "the 128 MiB module is written");
    var cfg = config_new();
    config_backend(cfg, KavachBackend.WASM);
    config_policy(cfg, pol);
    config_timeout_ms(cfg, 5000);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    var r = wasm_exec(sb, path);
    assert(r != 0, "wasm_exec returns a result");
    assert_neq(ExecResult_exit_code(r), 0,
      "a 128 MiB guest is REFUSED on the DEFAULT policy — a 0 here means unbounded");

    # And a guest inside the ceiling still runs, so this is a ceiling and not a
    # blanket refusal.
    var nop = "/tmp/kavach-test-mem-nop.wasm";
    assert_eq(_write_nop_wasm(nop), 36, "the nop module is written");
    var cfg2 = config_new();
    config_backend(cfg2, KavachBackend.WASM);
    config_policy(cfg2, pol);
    config_timeout_ms(cfg2, 5000);
    var sb2 = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb2, cfg2);
    assert_eq(ExecResult_exit_code(wasm_exec(sb2, nop)), 0,
      "and a module within the ceiling still runs");
    return 0;
}

fn test_wasm_exec_missing_file() {
    test_group("wasm_missing_file");
    kavach_init();
    var cfg = config_new();
    config_backend(cfg, KavachBackend.WASM);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    # Only meaningful when wasmtime is present; otherwise the no-wasmtime
    # branch above already covered the failure path.
    if (_wasm_binary_path() != 0) {
        var r = wasm_exec(sb, "/tmp/kavach-nonexistent-does-not-exist.wasm");
        assert_eq(ExecResult_exit_code(r), 1, "failure on missing .wasm");
        assert(cstr_contains(ExecResult_stderr(r), "not found") == 1, "err says not found");
    }
    return 0;
}

# ---- the WASM guest's filesystem is the policy's --------------------------
#
# Through 3.13.0 `_wasm_append_preopens` read no landlock rule and preopened the
# workdir, read-write, whatever the policy said. Measured against wasmtime 49: a
# deny-all policy's guest read and wrote its workdir, and a policy allowing one
# directory read-only gave its guest the workdir instead, or no directory at all.

# The WASI probe in tests/wasm_fs_probe.wat, 818 bytes: for each preopen it
# prints `P <path>`, then `R <probe.txt>` or `R E<errno>`, then `W ok` or
# `W E<errno>` for creating `created.txt`.
var WASM_FS_PROBE_LEN = 818;
var WASM_FS_PROBE_HEX = "";

# `args` joined by single spaces.
fn _t_wa_join(args) {
    var s = str_from("");
    var i = 0;
    while (i < vec_len(args)) {
        if (i > 0) { s = str_cat(s, str_from(" ")); }
        s = str_cat(s, str_from(vec_get(args, i)));
        i = i + 1;
    }
    return str_cstr(s);
}

# A WASM sandbox with `policy` and, unless 0, `workdir`.
fn _t_wa_sandbox(policy, workdir) {
    var cfg = config_new();
    config_backend(cfg, KavachBackend.WASM);
    config_policy(cfg, policy);
    config_timeout_ms(cfg, 10000);
    if (workdir != 0) { config_workdir(cfg, workdir); }
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    return sb;
}

# The preopens `_wasm_append_preopens` gives such a sandbox, joined, or
# "REFUSED" when it returns -1.
fn _t_wa_preopens(policy, workdir) {
    var args = vec_new();
    if (_wasm_append_preopens(args, _t_wa_sandbox(policy, workdir)) != 0) { return "REFUSED"; }
    return _t_wa_join(args);
}

# Whether `out` holds the probe's line for a preopen at `path`.
fn _t_wa_sees(out, path) {
    return cstr_contains(out, str_cstr(str_cat(str_cat(str_from("P "), str_from(path)), str_from("\n"))));
}

fn test_wasm_preopens_follow_the_policy() {
    test_group("wasm_preopens_follow_the_policy");
    # No landlock: the workdir, as before.
    assert(streq(_t_wa_preopens(policy_minimal(), "/srv/work"), "--dir /srv/work") == 1,
      "with no landlock the workdir is preopened");
    assert(streq(_t_wa_preopens(policy_minimal(), 0), "") == 1, "...and without one, nothing");

    # Deny-all: nothing, the workdir included.
    var d = policy_minimal();
    policy_landlock_deny_all(d);
    assert(streq(_t_wa_preopens(d, "/srv/work"), "") == 1,
      "a deny-all policy preopens nothing, not even the workdir");

    # Rules: each at its own path, and not the workdir.
    var r = policy_minimal();
    policy_landlock_add(r, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(r, "/srv/b", FS_READ_WRITE);
    assert(streq(_t_wa_preopens(r, "/srv/work"), "--dir /srv/a --dir /srv/b") == 1,
      "a policy with rules preopens exactly their paths, and not the workdir");

    # The rules the child applies: a count below the list preopens only those,
    # and a count above it is deny-all.
    var low = policy_minimal();
    policy_landlock_add(low, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(low, "/srv/b", FS_READ_ONLY);
    SandboxPolicy_set_landlock_rules_len(low, 1);
    assert(streq(_t_wa_preopens(low, "/srv/work"), "--dir /srv/a") == 1,
      "a count below the list preopens the rules it counts");
    SandboxPolicy_set_landlock_rules_len(low, 3);
    assert(streq(_t_wa_preopens(low, "/srv/work"), "") == 1, "a count above the list preopens nothing");

    # `--dir` splits its value at `::`, so a path holding one is refused, as a
    # rule or as the workdir.
    var c = policy_minimal();
    policy_landlock_add(c, "/srv/x::/etc", FS_READ_ONLY);
    assert(streq(_t_wa_preopens(c, 0), "REFUSED") == 1, "a rule path with :: is refused");
    assert(streq(_t_wa_preopens(policy_minimal(), "/srv/w::/etc"), "REFUSED") == 1,
      "...and so is such a workdir");

    # A rule naming a file gets no preopen: `--dir` takes a directory, and the
    # file's directory would give the guest its siblings. A path that does not
    # exist (the /srv paths above) is passed on, to fail the exec closed.
    var file = _t_unique_tmp_path("/tmp/kavach-t-wafile-");
    file_write_all(file, "x", 1);
    var fr = policy_minimal();
    policy_landlock_add(fr, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(fr, file, FS_READ_ONLY);
    assert(streq(_t_wa_preopens(fr, 0), "--dir /srv/a") == 1,
      "a rule naming a file is not preopened, and a missing path still is");
    kv_unlink(file);
    return 0;
}

fn test_wasm_host_policy_confines_wasmtime() {
    test_group("wasm_host_policy_confines_wasmtime");
    var r = policy_minimal();
    policy_landlock_add(r, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(r, "/srv/b", FS_READ_WRITE);
    var h = _wasm_host_policy(r, "/opt/wt/bin/wasmtime", "/opt/tools/t.wasm");
    assert_eq(_t_ll_has(h, "/srv/a", FS_READ_ONLY), 1, "the ruleset holds the policy's rules, each with its access");
    assert_eq(_t_ll_has(h, "/srv/b", FS_READ_WRITE), 1, "...both of them");
    assert_eq(_t_ll_has(h, "/opt/wt/bin/wasmtime", FS_READ_ONLY), 1, "wasmtime's binary, read-only");
    assert_eq(_t_ll_has(h, "/usr", FS_READ_ONLY), 1, "/usr, for its libraries");
    assert_eq(_t_ll_has(h, "/opt/tools/t.wasm", FS_READ_ONLY), 1, "and the module");
    assert_eq(_t_ll_has(h, "/opt/wt/bin", FS_READ_ONLY) + _t_ll_has(h, "/opt/tools", FS_READ_ONLY), 0,
      "each file alone, not its directory");
    assert_eq(policy_landlock_is_deny_all(h), 0, "it is a ruleset of those paths, not deny-all");
    assert(h != r && _t_ll_len(r) == 2, "the policy itself is left as it was");

    # Deny-all adds no rule of its own: wasmtime keeps its paths, and the guest,
    # with no preopen, reaches none of them.
    var d = policy_minimal();
    policy_landlock_deny_all(d);
    var hd = _wasm_host_policy(d, "/usr/bin/wasmtime", "/opt/tools/t.wasm");
    assert_eq(policy_landlock_is_deny_all(hd), 0, "a deny-all policy still lets wasmtime start");
    assert_eq(_t_ll_has(hd, "/opt/tools/t.wasm", FS_READ_ONLY), 1, "...and read its module");
    assert_eq(_t_ll_has(hd, "/srv/a", FS_READ_ONLY), 0, "...and names no path of the policy's");

    # Only the rules the child applies; and the module as named, which for a
    # module under the root is not `/`, and for a bare name not the working
    # directory.
    var low = policy_minimal();
    policy_landlock_add(low, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(low, "/srv/b", FS_READ_ONLY);
    SandboxPolicy_set_landlock_rules_len(low, 1);
    assert_eq(_t_ll_has(_wasm_host_policy(low, "/usr/bin/wasmtime", "/t.wasm"), "/srv/b", FS_READ_ONLY), 0,
      "a rule past the count is left out");
    var hr = _wasm_host_policy(r, "/usr/bin/wasmtime", "/t.wasm");
    assert(_t_ll_has(hr, "/t.wasm", FS_READ_ONLY) == 1 && _t_ll_has(hr, "/", FS_READ_ONLY) == 0,
      "a module under the root is granted alone, not /");
    var hb = _wasm_host_policy(r, "/usr/bin/wasmtime", "t.wasm");
    assert(_t_ll_has(hb, "t.wasm", FS_READ_ONLY) == 1 && _t_ll_has(hb, ".", FS_READ_ONLY) == 0,
      "and a bare name alone, not the working directory");
    return 0;
}

fn test_wasm_guest_sees_the_policys_paths() {
    test_group("wasm_guest_sees_the_policys_paths");
    kavach_init();
    if (_wasm_binary_path() == 0) { return 0; }
    var root = _t_unique_tmp_path("/tmp/kavach-t-wasmfs-");
    kv_mkdir(root, 493);                                   # 0755
    var a = _t_merge_path(root, "a", 0);
    var b = _t_merge_path(root, "b", 0);
    var w = _t_merge_path(root, "w", 0);
    kv_mkdir(a, 493);
    kv_mkdir(b, 493);
    kv_mkdir(w, 493);
    file_write_all(_t_merge_path(root, "a", 1), "WASM-A\n", 7);
    file_write_all(_t_merge_path(root, "b", 1), "WASM-B\n", 7);
    file_write_all(_t_merge_path(root, "w", 1), "WASM-W\n", 7);
    var probe = str_cstr(str_cat(str_from(root), str_from("/probe.wasm")));
    file_write_all(probe, hex_decode(WASM_FS_PROBE_HEX, 2 * WASM_FS_PROBE_LEN), WASM_FS_PROBE_LEN);

    # The control: no landlock, so the workdir, which the guest reads.
    var r0 = wasm_exec(_t_wa_sandbox(policy_minimal(), w), probe);
    assert_eq(ExecResult_exit_code(r0), 0, "the probe runs");
    assert_eq(_t_wa_sees(ExecResult_stdout(r0), w), 1, "with no landlock the guest has its workdir");
    assert_eq(cstr_contains(ExecResult_stdout(r0), "WASM-W"), 1, "...and reads it");

    # Deny-all: no directory, and the guest still runs. wasmtime reads the
    # module on the host, so here, unlike on the process backend, deny-all does
    # not stop the payload.
    var d = policy_minimal();
    policy_landlock_deny_all(d);
    var rd = wasm_exec(_t_wa_sandbox(d, w), probe);
    assert_eq(ExecResult_exit_code(rd), 0, "a deny-all guest runs");
    assert_eq(cstr_contains(ExecResult_stdout(rd), "P "), 0, "...with no directory, not even its workdir");

    # Rules: their directories, not the workdir.
    var p = policy_minimal();
    policy_landlock_add(p, a, FS_READ_ONLY);
    policy_landlock_add(p, b, FS_READ_WRITE);
    var rp = wasm_exec(_t_wa_sandbox(p, w), probe);
    var out = ExecResult_stdout(rp);
    assert_eq(ExecResult_exit_code(rp), 0, "the guest runs, wasmtime confined");
    assert_eq(_t_wa_sees(out, a), 1, "the guest has the read-only rule's directory");
    assert_eq(_t_wa_sees(out, b), 1, "...and the read-write one's");
    assert_eq(_t_wa_sees(out, w), 0, "...and not the workdir");
    assert_eq(cstr_contains(out, "WASM-A"), 1, "it reads the read-only directory");
    assert_eq(cstr_contains(out, "WASM-B"), 1, "...and the read-write one");
    assert_eq(file_exists(str_cstr(str_cat(str_from(b), str_from("/created.txt")))), 1,
      "and writes in the read-write one");
    # `--dir` is read-write; landlock on wasmtime holds the read-only rule. With
    # no landlock in the kernel nothing does, so this asserts only where it is.
    if (security_landlock_abi_version() > 0) {
        assert_eq(file_exists(str_cstr(str_cat(str_from(a), str_from("/created.txt")))), 0,
          "but cannot write in the read-only one");
    }

    # Confined, a guest that traps is still reported as failing.
    var t = _t_wa_sandbox(p, 0);
    config_fuel(Sandbox_config(t), 1);
    assert_neq(ExecResult_exit_code(wasm_exec(t, probe)), 0, "a guest out of fuel still fails");

    # A path `--dir` would split is refused before wasmtime runs.
    var c = policy_minimal();
    policy_landlock_add(c, "/srv/x::/etc", FS_READ_ONLY);
    var rc = wasm_exec(_t_wa_sandbox(c, 0), probe);
    assert_eq(ExecResult_exit_code(rc), 1, "a rule path with :: is refused");
    assert_eq(cstr_contains(ExecResult_stderr(rc), "::"), 1, "...saying why");

    # A rule naming a file: the guest runs, and gets no preopen for it. Until a
    # file rule could be applied, it failed the exec closed (124) once wasmtime
    # had a ruleset of its own, and `--dir` on a file fails it too ("Not a
    # directory").
    var fp = policy_minimal();
    policy_landlock_add(fp, a, FS_READ_ONLY);
    policy_landlock_add(fp, _t_merge_path(root, "w", 1), FS_READ_ONLY);
    var rf = wasm_exec(_t_wa_sandbox(fp, 0), probe);
    assert_eq(ExecResult_exit_code(rf), 0, "a policy naming a file runs its guest");
    assert_eq(_t_wa_sees(ExecResult_stdout(rf), a), 1, "...which has the directory rule's path");
    assert_eq(cstr_contains(ExecResult_stdout(rf), "WASM-W"), 0, "...and cannot reach the file");

    kv_unlink(str_cstr(str_cat(str_from(b), str_from("/created.txt"))));
    kv_unlink(str_cstr(str_cat(str_from(a), str_from("/created.txt"))));
    kv_unlink(str_cstr(str_cat(str_from(w), str_from("/created.txt"))));
    kv_unlink(probe);
    _t_merge_probe(root, "a", 0);
    _t_merge_probe(root, "b", 0);
    _t_merge_probe(root, "w", 0);
    kv_rmdir(root);
    return 0;
}

fn test_gvisor_exec_without_runsc() {
    test_group("gvisor_no_runsc");
    kavach_init();
    var cfg = config_new();
    config_backend(cfg, KavachBackend.GVISOR);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    # If runsc is not on this machine, we should get a clean error not a crash.
    if (_gvisor_runsc_path() == 0) {
        var r = gvisor_exec(sb, "echo hi");
        assert_eq(ExecResult_exit_code(r), 1, "clean failure");
        assert(cstr_contains(ExecResult_stderr(r), "runsc") == 1, "mentions runsc");
    }
    return 0;
}

fn test_which_exists() {
    test_group("which_exists");
    # /bin/sh is effectively universal on Linux — must exist.
    assert_eq(which_exists("sh"), 1, "sh present");
    # A nonsense binary must not.
    assert_eq(which_exists("kavach-nonexistent-zzzz"), 0, "bogus absent");
    return 0;
}

fn test_path_exists() {
    test_group("kavach_path_exists");
    assert_eq(kavach_path_exists("/tmp"), 1, "/tmp exists");
    assert_eq(kavach_path_exists("/no/such/kavach/path"), 0, "nonexistent = 0");
    return 0;
}

# ---- 3.3.1 hardening regression tests ------------------------------------

# M1: backend_capture_finish must NUL-terminate inside the buffer even when
# the capture filled it exactly (n == out_cap) — the off-by-one heap overflow.
fn test_backend_capture_finish_clamp() {
    test_group("backend_capture_finish_clamp");
    var cap = 8;
    var buf = alloc(cap);
    memset(buf, 65, cap);                     # fill with 'A', no NUL anywhere
    var r = backend_capture_finish(buf, cap, cap, "fail", 0, 0);
    assert_eq(ExecResult_exit_code(r), 0, "success path on full buffer");
    # NUL clamped to cap-1 (in-bounds), never written at buf+cap (overflow).
    assert_eq(load8(buf + cap - 1), 0, "NUL clamped to cap-1");
    var r2 = backend_capture_finish(buf, 0 - 1, cap, "fail", 0, 0);
    assert_eq(ExecResult_exit_code(r2), 1, "n<0 -> failure result");
    return 0;
}

# SEC2: whole-token controller match — "cpu" must not match "cpuset".
fn test_cgroup_controller_token_match() {
    test_group("cgroup_controller_token_match");
    assert_eq(_cgroup_has_controller("cpuset io memory pids", "cpu"), 0, "cpu absent (only cpuset)");
    assert_eq(_cgroup_has_controller("cpuset cpu io", "cpu"), 1, "cpu present mid-list");
    assert_eq(_cgroup_has_controller("memory cpu", "cpu"), 1, "cpu present at end");
    assert_eq(_cgroup_has_controller("io pids", "cpu"), 0, "cpu truly absent");
    return 0;
}

# SEC3: dispatch table bounds — out-of-range backend ids read as unregistered
# rather than indexing the fn-pointer table out of bounds.
fn test_backend_dispatch_bounds() {
    test_group("backend_dispatch_bounds");
    assert_eq(backend_is_registered(0 - 1), 0, "negative id not registered");
    assert_eq(backend_is_registered(999), 0, "huge id not registered");
    return 0;
}

# P1: position-based evidence extracts from the real match span (no re-scan).
fn test_code_evidence_at() {
    test_group("code_evidence_at");
    var ev = code_extract_evidence_at("0123456789", 5, 2);
    assert_eq(streq(ev, "0123456789"), 1, "evidence spans full short text");
    return 0;
}

# 3.3.2: getrandom-backed entropy — fill_random reports the full count and the
# rand_* helpers yield distinct, nonzero draws (the getrandom path is wired).
fn test_fill_random_entropy() {
    test_group("fill_random_entropy");
    var buf[16];
    assert_eq(fill_random(&buf, 16), 16, "fills all 16 requested bytes");
    var a = rand_u64();
    var b = rand_u64();
    assert(a != 0, "rand_u64 nonzero");
    assert(a != b, "two draws differ");
    return 0;
}

# 3.3.3: Result-returning secure write — Ok(len) on a fresh write, and a
# distinguishable IoError (not a bare -1) when the parent dir is missing.
fn test_file_write_secure_r() {
    test_group("file_write_secure_r");
    # Fresh, unpredictable path so O_EXCL doesn't trip on a leftover file.
    var rid = rand_hex_id();
    var prefix = "/tmp/kavach-wsr-";
    var path = alloc(strlen(prefix) + 17);
    memcpy(path, prefix, strlen(prefix));
    memcpy(path + strlen(prefix), rid, 16);
    store8(path + strlen(prefix) + 16, 0);

    var w_t, w_v = file_write_secure_r(path, "hello", 5);
    assert_eq(is_ok(w_t), 1, "fresh secure write is Ok");
    assert_eq(result_unwrap(w_t, w_v), 5, "wrote 5 bytes");
    sys_unlink(path);

    # Missing parent directory → ENOENT → IoNotFound (distinguishable error).
    var w2_t, w2_v = file_write_secure_r("/no/such/kavach/dir/file", "x", 1);
    assert_eq(is_err_result(w2_t), 1, "missing dir -> Err");
    assert_eq(err_code_of(w2_t, w2_v), IoNotFound, "ENOENT maps to IoNotFound");

    # Back-compat int wrapper still returns -1 on the same failure.
    assert_eq(file_write_secure("/no/such/kavach/dir/file", "x", 1), 0 - 1, "int wrapper -1 on failure");
    return 0;
}

# 3.4.0: Aho-Corasick multi-pattern matcher. Classic {he,she,his,hers} over
# "ushers" — exercises shared prefixes, failure links, and the dict-link output
# chain (he/hers both report at the same position; she at an earlier one).
fn test_aho_corasick() {
    test_group("aho_corasick");
    var pats = vec_new();
    vec_push(pats, "he");      # id 0
    vec_push(pats, "she");     # id 1
    vec_push(pats, "his");     # id 2
    vec_push(pats, "hers");    # id 3
    var ac = ac_build(pats);
    var hits = ac_hits_new(ac);
    ac_search(ac, "ushers", 6, hits);   # u0 s1 h2 e3 r4 s5
    assert_eq(load64(hits + 0 * 8), 2, "he @ 2");
    assert_eq(load64(hits + 1 * 8), 1, "she @ 1");
    assert_eq(load64(hits + 2 * 8), 0 - 1, "his no match");
    assert_eq(load64(hits + 3 * 8), 2, "hers @ 2");

    # Fresh hit table over non-matching text stays all -1.
    var h2 = ac_hits_new(ac);
    ac_search(ac, "xyz", 3, h2);
    assert_eq(load64(h2 + 0 * 8), 0 - 1, "he absent in xyz");

    # First-match-position semantics: earliest occurrence wins.
    var pats2 = vec_new();
    vec_push(pats2, "ab");
    var ac2 = ac_build(pats2);
    var h3 = ac_hits_new(ac2);
    ac_search(ac2, "xxabyyabzz", 10, h3);   # "ab" at 2 and 6 → first = 2
    assert_eq(load64(h3 + 0 * 8), 2, "ab first match @ 2");
    return 0;
}

fn test_process_backend_real_exec() {
    test_group("process_real_exec");
    kavach_init();
    var cfg = config_new();
    config_backend(cfg, KavachBackend.NOOP);
    var sb = sandbox_create(cfg);
    # Directly call process_exec with /bin/echo (bypassing sandbox state guard)
    # to prove the fork+exec+capture pipeline actually runs.
    var r = process_exec(sb, "/bin/echo hello_from_process_backend");
    assert(r != 0, "exec returned a result");
    if (_t_host_loads_seccomp() == 0) {
        # The default policy asks for seccomp and this host will not load a
        # filter (qemu-user answers PR_SET_SECCOMP with EINVAL). The contract
        # is to refuse, not to run the payload unfiltered.
        assert_eq(ExecResult_exit_code(r), 125, "host refuses seccomp: the child exits SPAWN_EXIT_SECCOMP");
        return 0;
    }
    assert_eq(ExecResult_exit_code(r), 0, "exit 0");
    var out = ExecResult_stdout(r);
    assert(cstr_contains(out, "hello_from_process_backend") == 1, "stdout captured");
    return 0;
}

fn test_process_backend_rejects_bash() {
    test_group("process_rejects_bash");
    kavach_init();
    var cfg = config_new();
    config_backend(cfg, KavachBackend.PROCESS);
    var sb = sandbox_create(cfg);
    var r = process_exec(sb, "/bin/bash -c whoami");
    assert(r != 0, "result returned");
    assert_eq(ExecResult_exit_code(r), 126, "blocklist exit code");
    var err = ExecResult_stderr(r);
    assert(cstr_contains(err, "blocked command") == 1, "blocklist message");
    return 0;
}

# 3.12.9: a diagnostic result set a process-global flag that only the capture
# path cleared, so a backend building its ExecResult directly (noop does; a
# consumer's registered backend may) inherited the previous exec's flag and
# skipped the gate. Leave the flag set, then exec on noop: the gate must run.
fn test_gate_not_skipped_by_a_stale_diagnostic() {
    test_group("gate_not_skipped_by_a_stale_diagnostic");
    kavach_init();
    sandbox_exec_set_audit_chain(0);
    var cfg = config_new();
    config_backend(cfg, KavachBackend.NOOP);
    var sb = sandbox_create(cfg);
    sandbox_transition(sb, SandboxState.RUNNING);
    backend_error_result("an earlier exec's diagnostic");
    assert_eq(backend_result_is_diagnostic(), 1, "the flag is left set");
    var r = sandbox_exec(sb, "echo hi");
    assert(r != 0, "exec returned a result");
    assert_eq(backend_result_is_diagnostic(), 0, "cleared for this dispatch");
    assert(sandbox_exec_last_scan_result() != 0, "and the gate scanned the output");
    return 0;
}

# 3.12.9: the netlink audit control calls returned Ok as soon as the request was
# SENT; none read the kernel's reply. Unprivileged, the kernel refuses these
# with EPERM, which was queued and never read. Not run as root: it would really
# turn on auditing and add a rule on this host.
fn test_audit_control_reports_kernel_refusal() {
    test_group("audit_control_reports_kernel_refusal");
    if (sys_getuid() == 0) {
        assert_eq(1, 1, "root: would change this host's audit state — not run");
        return 0;
    }
    var h_t, h_v = audit_open(audit_config_new());
    if (is_ok(h_t) == 0) {
        assert_eq(1, 1, "no NETLINK_AUDIT socket on this host — not exercisable");
        return 0;
    }
    var r_t, r_v = audit_set_enabled(h_v, 1);
    assert_eq(is_ok(r_t), 0, "an unprivileged AUDIT_SET is refused, not reported as done");
    if (is_ok(r_t) == 0) {
        # EPERM on a kernel; qemu-user's netlink translation answers EINVAL. What
        # this checks is the signed read: it used to come back as -4294967295.
        var e = kavach_syserr_errno(r_v);
        assert(e >= 1 && e < 4096, "... with the kernel's errno, read as a signed value");
    }
    var a_t, a_v = audit_add_rule(h_v, audit_rule_file_watch("/etc/passwd", "kavach-t"));
    assert_eq(is_ok(a_t), 0, "an unprivileged watch rule is refused");
    var e_t, e_v = audit_send_event(h_v, "KAVACH_TEST", "probe");
    assert_eq(is_ok(e_t), 0, "an unprivileged AUDIT_USER event is refused");
    audit_close(h_v);
    return 0;
}

fn test_end_to_end_with_audit() {
    test_group("end_to_end_audit");
    kavach_init();
    sha256_global_init();
    var chain = audit_chain_open("/tmp/kavach-test-e2e.audit", "e2e-key", 7);
    sandbox_exec_set_audit_chain(chain);

    var cfg = config_new();
    config_backend(cfg, KavachBackend.NOOP);
    var sb = sandbox_create(cfg);
    sandbox_transition(sb, SandboxState.RUNNING);

    var before = audit_chain_len(chain);
    sandbox_exec(sb, "ls /tmp");
    var after = audit_chain_len(chain);
    # Two audit entries per exec: exec_begin + exec_complete
    assert_eq(after - before, 2, "two audit entries per exec");

    sandbox_exec_set_audit_chain(0);
    return 0;
}

# 3.12.1: the command blocklist is a HOST-interpreter guard, so it must not
# apply to a sandbox that has its own rootfs — there the name resolves inside
# the image, after chroot, to a binary the caller supplied.
#
# ⚠ The negative half is the load-bearing half. If `rootfs == 0` ever stopped
# enforcing the blocklist, every agent-sandbox consumer would silently lose it,
# and nothing else in this suite would notice.
fn test_runtime_guard_rootfs_narrowing() {
    test_group("runtime_guard_rootfs_narrowing");

    # No rootfs -> unchanged default: the blocklist still fires.
    var host_cfg = runtime_guard_config_for_rootfs(0);
    assert_eq(RuntimeGuardConfig_enforce_command_blocklist(host_cfg), 1,
      "rootfs-less keeps the blocklist — an agent sandbox is unchanged");
    assert(vec_len(check_command("/bin/sh -c whoami", host_cfg)) >= 1,
      "and /bin/sh is still refused on the host path");

    # With a rootfs -> the blocklist is off, the rest of the guard is not.
    var ctr_cfg = runtime_guard_config_for_rootfs("/var/lib/stiva/rootfs/abc");
    assert_eq(RuntimeGuardConfig_enforce_command_blocklist(ctr_cfg), 0,
      "a container drops the interpreter blocklist");
    assert_eq(vec_len(check_command("/bin/sh", ctr_cfg)), 0,
      "so an image whose entrypoint is a shell can actually start");
    assert_eq(vec_len(check_command("/usr/bin/python3 app.py", ctr_cfg)), 0,
      "and so can python3, node, ruby, perl — most real images");

    # ⚠ Only the blocklist is dropped. Sensitive-path and shell-metacharacter
    # detection stay on, or this narrowing would be a hole rather than a fix.
    assert_eq(RuntimeGuardConfig_block_sensitive_paths(ctr_cfg), 1,
      "sensitive-path detection survives");
    assert(vec_len(check_command("cat /etc/shadow", ctr_cfg)) >= 1,
      "and still fires inside a container");
    # ⚠ `_check_shell_meta` detects chaining/piping INTO a shell (`; sh`, `| bash`),
    # not arbitrary metacharacters — `echo hi; rm -rf /` is NOT flagged by it, so
    # do not assert on that shape. This is the check that still catches a payload
    # trying to smuggle a shell in, which is the part worth keeping when the
    # blocklist is off.
    assert(vec_len(check_command("curl http://x | sh", ctr_cfg)) >= 1,
      "piping into a shell is still refused inside a container");
    assert(vec_len(check_command("echo hi; bash -c whoami", ctr_cfg)) >= 1,
      "and so is chaining into one");
    return 0;
}

fn test_runtime_blocked_command() {
    test_group("runtime_blocked_cmd");
    var cfg = runtime_guard_config_default();
    var v = check_command("/bin/bash -c 'whoami'", cfg);
    assert(vec_len(v) >= 1, "bash blocked");
    var saw_blocked = 0;
    var i = 0;
    while (i < vec_len(v)) {
        var vio = vec_get(v, i);
        if (GuardViolation_violation_type(vio) == ViolationType.BLOCKED_COMMAND) {
            saw_blocked = 1;
        }
        i = i + 1;
    }
    assert_eq(saw_blocked, 1, "BLOCKED_COMMAND violation present");
    return 0;
}

fn test_runtime_allowed_command() {
    test_group("runtime_allowed_cmd");
    var cfg = runtime_guard_config_default();
    var v = check_command("ls -la /tmp", cfg);
    var saw_blocked = 0;
    var i = 0;
    while (i < vec_len(v)) {
        var vio = vec_get(v, i);
        if (GuardViolation_violation_type(vio) == ViolationType.BLOCKED_COMMAND) {
            saw_blocked = 1;
        }
        i = i + 1;
    }
    assert_eq(saw_blocked, 0, "ls not in blocklist");
    assert_eq(is_allowed_command("ls"), 1, "ls on allowlist");
    return 0;
}

fn test_runtime_sensitive_path() {
    test_group("runtime_sensitive_path");
    var cfg = runtime_guard_config_default();
    var v = check_command("cat /etc/shadow", cfg);
    assert(vec_len(v) >= 1, "sensitive path flagged");
    return 0;
}

fn test_runtime_shell_injection() {
    test_group("runtime_shell_injection");
    var cfg = runtime_guard_config_default();
    var v = check_command("echo hi; bash -c 'whoami'", cfg);
    assert(vec_len(v) >= 1, "shell injection flagged");
    return 0;
}

fn test_runtime_fork_bomb() {
    test_group("runtime_fork_bomb");
    var cfg = runtime_guard_config_default();
    assert_eq(check_fork_bomb(10, cfg), 0, "10 pids below limit");
    var vio = check_fork_bomb(100, cfg);
    assert(vio != 0, "100 pids over limit of 64");
    assert_eq(GuardViolation_violation_type(vio), ViolationType.FORK_BOMB, "fork_bomb type");
    return 0;
}

fn test_runtime_time_anomaly() {
    test_group("runtime_time_anomaly");
    var cfg = runtime_guard_config_default();
    # 1000ms expected, multiplier 2.0 → threshold 2000
    assert_eq(check_time_anomaly(1500, 1000, cfg), 0, "1500 under 2000");
    var vio = check_time_anomaly(3000, 1000, cfg);
    assert(vio != 0, "3000 > 2000 threshold");
    return 0;
}

fn test_threat_benign() {
    test_group("threat_benign");
    var findings = vec_new();
    var a = classify_threat(findings);
    assert_eq(ThreatAssessment_intent_score_x1000(a), 0, "empty = 0");
    assert_eq(ThreatAssessment_classification(a), ThreatTier.BENIGN, "benign");
    assert_eq(ThreatAssessment_escalation(a), EscalationTier.TIER1_LOG, "tier1");
    return 0;
}

fn test_threat_suspicious() {
    test_group("threat_suspicious");
    var findings = vec_new();
    # Single low-severity finding: weight 150, no amplifier -> 150 (suspicious range)
    vec_push(findings, finding_new("secrets", Severity.LOW, "pii", "minor", 0));
    vec_push(findings, finding_new("secrets", Severity.MEDIUM, "pii", "more", 0));
    var a = classify_threat(findings);
    # 150 + 350 = 500. One stage (pii → EXFILTRATION) → amplifier 1.0 → 500
    assert(ThreatAssessment_intent_score_x1000(a) >= 200, "suspicious+");
    return 0;
}

fn test_threat_malicious_coord() {
    test_group("threat_malicious_coordinated");
    # 3 critical findings across 3 stages → amplifier 1.5x → exceed 1.0
    var findings = vec_new();
    vec_push(findings, finding_new("secrets", Severity.CRITICAL, "private_key", "k", 0));
    vec_push(findings, finding_new("code", Severity.CRITICAL, "command_injection", "c", 0));
    vec_push(findings, finding_new("code", Severity.CRITICAL, "data_exfiltration", "d", 0));
    var a = classify_threat(findings);
    assert_eq(ThreatAssessment_classification(a), ThreatTier.MALICIOUS, "malicious");
    assert_eq(ThreatAssessment_escalation(a), EscalationTier.TIER4_REVOKE, "revoke");
    assert_eq(vec_len(ThreatAssessment_kill_chain_stages(a)), 3, "3 unique stages");
    return 0;
}

fn test_kill_chain_stage_names() {
    test_group("kill_chain_names");
    assert_eq(streq(kill_chain_stage_name(KillChainStage.RECONNAISSANCE), "reconnaissance"), 1, "recon");
    assert_eq(streq(kill_chain_stage_name(KillChainStage.EXFILTRATION), "exfiltration"), 1, "exfil");
    assert_eq(streq(threat_tier_name(ThreatTier.MALICIOUS), "malicious"), 1, "malicious");
    assert_eq(streq(escalation_tier_name(EscalationTier.TIER4_REVOKE), "tier4_revoke"), 1, "tier4");
    return 0;
}

fn test_verdict_determination() {
    test_group("verdict_determination");
    var pol = ext_policy_default();
    assert_eq(determine_verdict(Severity.INFO, pol), ScanVerdict.PASS, "info=pass");
    assert_eq(determine_verdict(Severity.LOW, pol), ScanVerdict.WARN, "low=warn");
    assert_eq(determine_verdict(Severity.HIGH, pol), ScanVerdict.QUARANTINE, "high=quarantine");
    assert_eq(determine_verdict(Severity.CRITICAL, pol), ScanVerdict.BLOCK, "critical=block");
    return 0;
}

fn test_scan_multiple() {
    test_group("scan_multiple");
    var r = scan_result_new();
    secrets_scan("key=AKIAIOSFODNN7EXAMPLE token=ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij", r);
    assert(vec_len(ScanResult_findings(r)) >= 2, "both found");
    return 0;
}

# ---- cgroup v2 tests -----------------------------------------------------

fn test_cgroup_policy_has_limits() {
    test_group("cgroup_policy_has_limits");
    var empty = policy_new();
    assert_eq(cgroup_policy_has_limits(empty), 0, "empty policy = 0");
    var strict = policy_strict();
    # policy_strict sets memory/cpu/pids → has limits
    assert_eq(cgroup_policy_has_limits(strict), 1, "strict policy = 1");
    return 0;
}

fn test_cgroup_wrap_argv_shape() {
    test_group("cgroup_wrap_argv_shape");
    var user_args = vec_new();
    vec_push(user_args, "ls");
    vec_push(user_args, "/tmp");
    var wrapped = cgroup_wrap_argv("/sys/fs/cgroup/kavach-42", user_args);
    # Expected: ["/bin/sh", "-c", "echo $$ > .../cgroup.procs; exec \"$@\"", "--", "ls", "/tmp"]
    assert_eq(vec_len(wrapped), 6, "6 args in wrapped argv");
    assert_eq(streq(vec_get(wrapped, 0), "/bin/sh"), 1, "argv[0] = /bin/sh, absolute (3.12.9)");
    # A bare "sh" went to execve with no PATH search, so it ran ./sh from the
    # child's cwd or failed with 127. Absolute, it pins like any other exec.
    var pin = kv_exec_pin(vec_get(wrapped, 0));
    assert(pin >= 0, "and it pins");
    if (pin >= 0) { sys_close(pin); }
    assert_eq(streq(vec_get(wrapped, 1), "-c"), 1, "argv[1] = -c");
    assert_eq(streq(vec_get(wrapped, 3), "--"), 1, "argv[3] = --");
    assert_eq(streq(vec_get(wrapped, 4), "ls"), 1, "argv[4] = ls (user)");
    assert_eq(streq(vec_get(wrapped, 5), "/tmp"), 1, "argv[5] = /tmp (user)");
    # Body should contain the cgroup_path and the exec "$@" suffix.
    var body = vec_get(wrapped, 2);
    assert_eq(cstr_contains(body, "kavach-42/cgroup.procs"), 1, "body has cgroup path");
    assert_eq(cstr_contains(body, "exec \"$@\""), 1, "body has exec $@ passthrough");
    return 0;
}

fn test_cgroup_supported_graceful() {
    test_group("cgroup_supported_graceful");
    # cgroup_supported returns 0 or 1 — should not crash on read-only or
    # absent /sys/fs/cgroup. Just exercise the path.
    var r = cgroup_supported();
    assert(r == 0 || r == 1, "returns 0 or 1");
    return 0;
}

fn test_cgroup_setup_graceful_when_unsupported() {
    test_group("cgroup_setup_graceful_when_unsupported");
    # When cgroup v2 isn't writable, setup returns 0 (no-op). Caller skips wrap.
    if (cgroup_supported() == 0) {
        var policy = policy_strict();
        assert_eq(cgroup_setup(policy), 0, "setup returns 0 when unsupported");
        cgroup_teardown(0);   # no-op on null
    }
    # When supported, we don't test setup() in the test suite — it'd require
    # writeable /sys/fs/cgroup which is rare in CI. Covered by manual e2e.
    return 0;
}

# ---- credential_http tests -----------------------------------------------

fn test_credential_http_proxy_new_shape() {
    test_group("credential_http_proxy_new");
    var proxy = credential_proxy_new();
    var allowed = vec_new();
    vec_push(allowed, "API_KEY");
    vec_push(allowed, "DB_PASSWORD");
    var http = credential_http_proxy_new(proxy, allowed, 0);
    assert(http != 0, "handle allocated");
    assert_eq(CredentialHttpProxy_listen_fd(http), 0 - 1, "listen_fd starts at -1");
    assert_eq(CredentialHttpProxy_request_count(http), 0, "request_count = 0");
    assert_eq(CredentialHttpProxy_proxy_ref(http), proxy, "proxy_ref wired");
    return 0;
}

# One GET to 127.0.0.1:port from a forked child; the child exits 0 when the reply
# holds `want_status` and, if given, `want_body`, else 1 (2 if it cannot connect).
fn _t_http_get_child(port, path, want_status, want_body) {
    var pid = kv_fork();
    if (pid != 0) { return pid; }
    var s_t, s_v = tcp_socket();
    if (is_err_result(s_t) == 1) { sys_exit(2); }
    var c_t, c_v = sock_connect(s_v, INADDR_LOOPBACK(), port);
    if (is_err_result(c_t) == 1) { sys_exit(2); }
    var req = str_builder_new();
    str_builder_add_cstr(req, "GET ");
    str_builder_add_cstr(req, path);
    str_builder_add_cstr(req, " HTTP/1.1\r\nHost: localhost\r\n\r\n");
    var r = str_builder_build(req);
    sock_send(s_v, str_data(r), str_len(r));
    var buf = alloc(4096);
    var total = 0;
    var go = 1;
    while (go == 1 && total < 4095) {
        var g_t, g_v = sock_recv(s_v, buf + total, 4095 - total);
        if (is_err_result(g_t) == 1) { go = 0; }
        elif (g_v <= 0) { go = 0; }
        else { total = total + g_v; }
    }
    store8(buf + total, 0);
    if (cstr_contains(buf, want_status) == 0) { sys_exit(1); }
    if (want_body != 0) {
        if (cstr_contains(buf, want_body) == 0) { sys_exit(1); }
    }
    sys_exit(0);
    return 0;
}

# The proxy end to end over loopback, two requests on one proxy (3.12.9, when
# its request buffer became one per proxy, reused): an allowed name gets the
# secret, a name off the allowlist gets 403.
fn test_credential_http_proxy_serves_over_loopback() {
    test_group("credential_http_proxy_serves_over_loopback");
    var proxy = credential_proxy_new();
    credential_proxy_register(proxy, "API_KEY", "sk-loopback-123");
    credential_proxy_register(proxy, "OTHER", "not-for-you");
    var allowed = vec_new();
    vec_push(allowed, "API_KEY");
    var http = credential_http_proxy_new(proxy, allowed, 0);
    if (credential_http_proxy_listen(http, 0) != 0) {
        assert_eq(1, 1, "no loopback listener on this host — not exercisable");
        return 0;
    }
    # Port 0 lets the kernel pick; read it back (sockaddr_in port, big-endian).
    var sa[16];
    var salen[8];
    store64(&salen, 16);
    sys_getsockname(CredentialHttpProxy_listen_fd(http), &sa, &salen);
    var port = (load8(&sa + 2) << 8) | load8(&sa + 3);
    assert(port > 0, "a port");

    var c1 = _t_http_get_child(port, "/v1/secret/API_KEY", "200", "sk-loopback-123");
    assert_eq(credential_http_proxy_serve_one(http), 1, "first request served");
    var st[8];
    store64(&st, 0);
    kv_waitpid(c1, &st, 0);
    assert_eq(load32(&st) & 65535, 0, "an allowed name gets 200 and its secret");

    var c2 = _t_http_get_child(port, "/v1/secret/OTHER", "403", 0);
    assert_eq(credential_http_proxy_serve_one(http), 1, "second request served, same buffer");
    store64(&st, 0);
    kv_waitpid(c2, &st, 0);
    assert_eq(load32(&st) & 65535, 0, "a name off the allowlist gets 403");
    credential_http_proxy_close(http);
    return 0;
}

# 3.12.9: the listener was created without close-on-exec, so every child kavach
# exec'd while the proxy was up inherited it. F_GETFD (1) reports FD_CLOEXEC (1).
fn test_credential_http_listener_is_cloexec() {
    test_group("credential_http_listener_is_cloexec");
    var http = credential_http_proxy_new(credential_proxy_new(), vec_new(), 0);
    if (credential_http_proxy_listen(http, 0) != 0) {
        assert_eq(1, 1, "no loopback listener on this host — not exercisable");
        return 0;
    }
    var fd = CredentialHttpProxy_listen_fd(http);
    # SAFETY: fcntl(fd, F_GETFD) on the fd just opened; reads its flags only.
    var flags = syscall(SYS_FCNTL, fd, 1, 0);
    assert(flags >= 0, "F_GETFD answered");
    assert_eq(flags & 1, 1, "the listener is close-on-exec");
    credential_http_proxy_close(http);
    return 0;
}

fn test_credential_http_allowlist_check() {
    test_group("credential_http_allowlist");
    var proxy = credential_proxy_new();
    credential_proxy_register(proxy, "API_KEY", "sk-12345");
    credential_proxy_register(proxy, "DB_PASSWORD", "hunter2");
    credential_proxy_register(proxy, "SECRET_INTERNAL", "do-not-expose");
    var allowed = vec_new();
    vec_push(allowed, "API_KEY");
    vec_push(allowed, "DB_PASSWORD");
    var http = credential_http_proxy_new(proxy, allowed, 0);
    assert_eq(_http_allowed(http, "API_KEY"), 1, "API_KEY allowed");
    assert_eq(_http_allowed(http, "DB_PASSWORD"), 1, "DB_PASSWORD allowed");
    assert_eq(_http_allowed(http, "SECRET_INTERNAL"), 0, "SECRET_INTERNAL denied");
    assert_eq(_http_allowed(http, "UNKNOWN"), 0, "UNKNOWN denied");
    return 0;
}

fn test_credential_http_path_extract() {
    test_group("credential_http_path_extract");
    var n1 = _http_extract_secret_name("/v1/secret/API_KEY");
    assert(n1 != 0, "valid path -> name");
    assert_eq(streq(n1, "API_KEY"), 1, "name == API_KEY");
    # Wrong prefix → 0
    assert_eq(_http_extract_secret_name("/wrong/API_KEY"), 0, "wrong prefix -> 0");
    # Empty suffix → 0
    assert_eq(_http_extract_secret_name("/v1/secret/"), 0, "empty suffix -> 0");
    # Path traversal → 0 (slashes in suffix rejected)
    assert_eq(_http_extract_secret_name("/v1/secret/foo/bar"), 0, "nested path -> 0");
    return 0;
}

fn test_credential_http_listen_close() {
    test_group("credential_http_listen_close");
    var proxy = credential_proxy_new();
    var allowed = vec_new();
    var http = credential_http_proxy_new(proxy, allowed, 0);
    # Port 0 = kernel-assigned; if that's not supported, try a high port. We
    # just want to exercise the listen/close path.
    var r = credential_http_proxy_listen(http, 0);
    assert(r == 0 || r == 0 - 1, "listen returns 0 or -1");
    if (r == 0) {
        assert(CredentialHttpProxy_listen_fd(http) >= 0, "listen_fd set");
        credential_http_proxy_close(http);
        assert_eq(CredentialHttpProxy_listen_fd(http), 0 - 1, "fd reset to -1 after close");
    }
    return 0;
}

# Persistent guest: spawn /bin/cat with live pipes, stream bytes to its stdin,
# read the echo back, terminate + reap. Proves the M3-delivery execution model.
fn test_persistent_guest() {
    test_group("persistent guest (live stdin/stdout)");
    var g = persistent_spawn("/bin/cat");
    assert_neq(g, 0, "persistent_spawn /bin/cat");
    assert_eq(persistent_alive(g), 1, "guest alive after spawn");
    assert_eq(persistent_send(g, "AB", 2), 2, "sent 2 bytes to guest stdin");
    var buf[16];
    assert_eq(persistent_read(g, &buf, 16), 2, "read 2 bytes back from guest stdout");
    assert_eq(load8(&buf + 0), 65, "echoed byte 0 = 'A'");
    assert_eq(load8(&buf + 1), 66, "echoed byte 1 = 'B'");
    persistent_terminate(g);
    assert_eq(persistent_alive(g), 0, "guest terminated + reaped");
    assert_eq(persistent_send(g, "AB", 2), 0 - 1, "send to terminated guest rejected");
    assert_eq(persistent_spawn(""), 0, "spawn empty command rejected");
    return 0;
}

# ══ sandbox_spawn (3.9.0) ══

# A RUNNING sandbox for the spawn tests.
#
# With no policy supplied, network access is EXPLICITLY ENABLED so no namespace
# is requested. That is not tidiness: `policy_new` zero-fills, so the default
# `network_enabled = 0` reads as "isolate the network", which unprivileged needs
# a USER namespace to obtain — and hosts with
# `kernel.unprivileged_userns_clone=0`, hardened distros, and most CI containers
# deny that. These tests are about spawn/wait/kill/log mechanics; making them
# depend on the host's userns policy tests the runner, not kavach. The namespace
# path has its own environment-aware test below.
fn _spawn_running_sandbox(policy) {
    var c = config_new();
    config_backend(c, KavachBackend.PROCESS);
    if (policy != 0) { config_policy(c, policy); }
    else {
        # BOTH knobs, not just the network. policy_basic() also sets
        # seccomp_enabled = 1, so without this every spawn child loads a filter
        # and a host that refuses seccomp fails these tests with an opaque
        # SPAWN_EXIT_SECCOMP — the same trap the network namespace sprang, one
        # confinement step later. Seccomp has its own dedicated tests below.
        SandboxPolicy_set_network_enabled(SandboxConfig_policy(c), 1);
        SandboxPolicy_set_seccomp_enabled(SandboxConfig_policy(c), 0);
    }
    var sb = sandbox_create(c);
    sandbox_transition(sb, SandboxState.RUNNING);
    return sb;
}

fn test_spawn_lifecycle() {
    test_group("sandbox_spawn_lifecycle");
    var log = "/tmp/kavach_spawn_log.txt";
    xunlink(log);
    var sb = _spawn_running_sandbox(0);
    var sp = sandbox_spawn(sb, "/bin/true", log);
    assert(sp != 0, "spawned");
    assert(spawned_pid(sp) > 0, "has a real pid");
    assert_eq(spawned_alive(sp), 1, "alive before reaping");
    assert_eq(spawned_exit_code(sp), 0 - 1, "exit code unknown until reaped");

    assert_eq(spawned_wait(sp), 0, "/bin/true exits 0");
    assert_eq(spawned_alive(sp), 0, "dead after wait");
    assert_eq(spawned_exit_code(sp), 0, "exit code recorded");
    # wait is idempotent once reaped — a caller polling after the fact must not
    # block forever or get -1.
    assert_eq(spawned_wait(sp), 0, "wait after reap returns the recorded code");
    return 0;
}

fn test_spawn_exit_code_and_signal() {
    test_group("sandbox_spawn_exit_code");
    var sb = _spawn_running_sandbox(0);
    var sp = sandbox_spawn(sb, "/bin/false", 0);
    assert(sp != 0, "spawned /bin/false");
    assert_eq(spawned_wait(sp), 1, "/bin/false exits 1");

    # A signalled child reports 128+signal, so a caller can tell it apart from
    # a payload that merely exited with that number.
    var sb2 = _spawn_running_sandbox(0);
    var sp2 = sandbox_spawn(sb2, "/bin/sleep 30", 0);
    assert(sp2 != 0, "spawned sleep");
    assert_eq(spawned_try_wait(sp2), 0, "still running");
    assert_eq(spawned_kill(sp2, 9), 0, "SIGKILL delivered");
    assert_eq(spawned_wait(sp2), 137, "reports 128+9, not a bare 9");
    return 0;
}

fn test_spawn_detaches_and_logs() {
    test_group("sandbox_spawn_logging");
    var log = "/tmp/kavach_spawn_out.txt";
    xunlink(log);
    var sb = _spawn_running_sandbox(0);
    var sp = sandbox_spawn(sb, "/bin/echo hello-from-spawn", log);
    assert(sp != 0, "spawned");
    spawned_wait(sp);
    var buf = alloc(256);
    var n = file_read_all(log, buf, 255);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    assert(n > 0, "stdout reached the log file");
    # The point of the redirect: output goes to the log, not to the parent's
    # terminal, and it survives the child.
    assert(strstr(buf, "hello-from-spawn") >= 0, "log holds the child's stdout");
    return 0;
}

fn test_spawn_log_appends() {
    test_group("sandbox_spawn_log_appends");
    # A restarted container extends its log rather than erasing why the previous
    # attempt died.
    var log = "/tmp/kavach_spawn_append.txt";
    xunlink(log);
    var sb = _spawn_running_sandbox(0);
    spawned_wait(sandbox_spawn(sb, "/bin/echo first", log));
    spawned_wait(sandbox_spawn(sb, "/bin/echo second", log));
    var buf = alloc(512);
    var n = file_read_all(log, buf, 511);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    assert(strstr(buf, "first") >= 0, "the first run survived");
    assert(strstr(buf, "second") >= 0, "the second run was appended");
    return 0;
}

fn test_spawn_refuses_unsafe_input() {
    test_group("sandbox_spawn_refuses_unsafe");
    var sb = _spawn_running_sandbox(0);
    # A control char would split into extra argv tokens past the guard.
    assert_eq(sandbox_spawn(sb, "/bin/echo hi\nrm -rf /", 0), 0, "control chars refused");
    assert_eq(sandbox_spawn(sb, "", 0), 0, "empty command refused");

    # Not RUNNING -> refuse.
    var c = config_new();
    config_backend(c, KavachBackend.PROCESS);
    var idle = sandbox_create(c);
    assert_eq(sandbox_spawn(idle, "/bin/true", 0), 0, "refuses a non-running sandbox");
    return 0;
}

fn test_spawn_applies_seccomp() {
    test_group("sandbox_spawn_applies_seccomp");
    # The default policy enables seccomp, so this is the ordinary path, not an
    # exotic one — if the filter could not be installed before execve the spawn
    # would fail here rather than silently run unfiltered.
    var p = policy_basic();
    SandboxPolicy_set_seccomp_enabled(p, 1);
    SandboxPolicy_set_network_enabled(p, 1);   # isolate the variable under test
    var sb = _spawn_running_sandbox(p);
    var sp = sandbox_spawn(sb, "/bin/true", 0);
    assert(sp != 0, "spawns with seccomp enabled");
    if (_t_host_loads_seccomp() == 0) {
        # Host refuses seccomp. The contract is fail-closed, so assert the
        # refusal is clean and named rather than skipping.
        var c0 = spawned_wait(sp);
        assert_eq(c0, 125, "child exits SPAWN_EXIT_SECCOMP rather than running unfiltered");
        # spawn_exit_name answers 0 for a code that is not a confinement code,
        # so check before strstr: a filter that kills the child outright (as a
        # broken architecture check does) otherwise segfaults the suite here.
        if (spawn_exit_name(c0) != 0) {
            assert(strstr(spawn_exit_name(c0), "seccomp") >= 0, "and the code names seccomp");
        }
        return 0;
    }
    assert_eq(spawned_wait(sp), 0, "and the payload actually ran (execve survived the filter)");
    return 0;
}

fn test_bpf_write_insn_bytes() {
    test_group("bpf_write_insn_bytes");
    # Assert the BYTES, not just that the call returned. The previous
    # implementation used a typed `bpf_insn` local and compiled to a no-op:
    # every field write was dropped, the filter came out 184 zero bytes, and
    # PR_SET_SECCOMP rejected it with EINVAL — so seccomp was never applied by
    # any caller, silently. Every check except this one passed.
    var f = alloc(8);
    var i = 0;
    while (i < 8) { store8(f + i, 0); i = i + 1; }
    security_bpf_write_insn(f, 0, 0x06, 0, 0, 0x7FFF0000);   # RET ALLOW
    # struct sock_filter, little-endian: u16 code, u8 jt, u8 jf, u32 k.
    assert_eq(load8(f + 0), 6, "code low byte");
    assert_eq(load8(f + 1), 0, "code high byte");
    assert_eq(load8(f + 2), 0, "jt");
    assert_eq(load8(f + 3), 0, "jf");
    assert_eq(load8(f + 4), 0, "k byte 0");
    assert_eq(load8(f + 5), 0, "k byte 1");
    assert_eq(load8(f + 6), 255, "k byte 2");
    assert_eq(load8(f + 7), 127, "k byte 3 — 0x7FFF0000 little-endian");

    # jt/jf are distinct single bytes at 2 and 3, and k is unaffected by them.
    var g = alloc(8);
    security_bpf_write_insn(g, 0, 0x15, 7, 3, 165);
    assert_eq(load8(g + 0), 21, "JEQ opcode");
    assert_eq(load8(g + 2), 7, "jt written");
    assert_eq(load8(g + 3), 3, "jf written");
    assert_eq(load8(g + 4), 165, "k = mount(165)");
    return 0;
}

# Whether this host loads seccomp filters at all, asked with the smallest
# valid filter (one RET ALLOW) rather than with kavach's. spawn_seccomp_available
# probes with the exec filter itself, so a filter the kernel rejects (a bad jump,
# say) reads there as "this host has no seccomp", and every test that accepts a
# fail-closed 125 on such a host would accept the bug too.
fn _t_host_loads_seccomp() {
    var f = alloc(8);
    security_bpf_write_insn(f, 0, 6, 0, 0, 2147418112);      # RET ALLOW
    var pid = kv_fork();
    if (pid == 0) {
        var r_t, r_v = security_load_seccomp(f, 8);
        if (is_ok(r_t) == 0) { sys_exit(1); }
        sys_exit(0);
    }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    if ((load32(&st) & 65535) == 0) { return 1; }
    return 0;
}

fn test_seccomp_filter_actually_loads() {
    test_group("seccomp_filter_actually_loads");
    # The end-to-end property the byte test protects: the kernel accepts the
    # filter. Loaded in a CHILD so the test process stays unconfined.
    if (_t_host_loads_seccomp() == 0) {
        # Nothing to assert about a filter this kernel will not load; the
        # fail-closed path is covered by test_spawn_applies_seccomp.
        assert_eq(1, 1, "host refuses seccomp — load path not exercisable here");
        return 0;
    }
    assert_eq(spawn_seccomp_available(), 1,
      "the host loads a one-instruction filter, so it must load kavach's");
    var sf_t, sf_v = security_create_exec_seccomp_filter();
    var info = result_unwrap(sf_t, sf_v);
    var pid = sys_fork();
    if (pid == 0) {
        var r_t, r_v = security_load_seccomp(security_seccomp_filter_ptr(info),
          security_seccomp_filter_len(info));
        if (is_ok(r_t) == 0) { sys_exit(60); }
        # The whole point of the exec-safe profile: execve survives it.
        var argv = alloc(16);
        store64(argv, "/bin/true");
        store64(argv + 8, 0);
        var envp = alloc(8);
        store64(envp, 0);
        sys_execve("/bin/true", argv, envp);
        sys_exit(61);
    }
    var st[4];
    store32(&st, 0);
    sys_waitpid(pid, &st, 0);
    var status = load32(&st);
    assert_eq(status & 127, 0, "child was not killed by a signal");
    var code = (status >> 8) & 255;
    assert(code != 60, "the kernel ACCEPTED the filter (not EINVAL)");
    assert(code != 61, "execve ran under the filter");
    assert_eq(code, 0, "/bin/true completed under seccomp");
    return 0;
}

# The native column of a two-column syscall table. The pairs are written out
# again here rather than read from the implementation's tables, so a wrong
# entry there cannot agree with itself.
fn _t_nr(x86_64_nr, aarch64_nr) {
    #ifdef CYRIUS_ARCH_AARCH64
    return aarch64_nr;
    #endif
    #ifdef CYRIUS_ARCH_X86
    return x86_64_nr;
    #endif
}

fn _t_vec_has(v, x) {
    var i = 0;
    while (i < vec_len(v)) {
        if (vec_get(v, i) == x) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One BPF instruction read back: struct sock_filter, little-endian.
fn _t_insn_code(f, idx) { return load8(f + idx * 8) | (load8(f + idx * 8 + 1) << 8); }
fn _t_insn_jt(f, idx) { return load8(f + idx * 8 + 2); }
fn _t_insn_jf(f, idx) { return load8(f + idx * 8 + 3); }
fn _t_insn_k(f, idx) { return load32(f + idx * 8 + 4); }

# Both filters open with the architecture check. `kill_idx` is where the x32
# branch must land on x86-64: the filter's RET KILL, wherever it sits.
fn _t_check_seccomp_prologue(f, kill_idx) {
    # AUDIT_ARCH_X86_64 = 0xC000003E, AUDIT_ARCH_AARCH64 = 0xC00000B7.
    var arch = _t_nr(3221225534, 3221225655);
    assert_eq(_t_insn_code(f, 0), 32, "insn 0 is LD");
    assert_eq(_t_insn_k(f, 0), 4, "... of seccomp_data.arch (+4)");
    assert_eq(_t_insn_code(f, 1), 21, "insn 1 is JEQ");
    assert_eq(_t_insn_k(f, 1), arch, "... against this build's AUDIT_ARCH");
    assert_eq(_t_insn_jt(f, 1), 1, "... a match skips the KILL");
    assert_eq(_t_insn_jf(f, 1), 0, "... a mismatch falls into it");
    assert_eq(_t_insn_code(f, 2), 6, "insn 2 is RET");
    assert_eq(_t_insn_k(f, 2), 2147483648, "... KILL_PROCESS for any other ABI");
    assert_eq(_t_insn_code(f, 3), 32, "insn 3 is LD");
    assert_eq(_t_insn_k(f, 3), 0, "... of seccomp_data.nr (+0), only after the arch passed");
    #ifdef CYRIUS_ARCH_X86
    assert_eq(_t_insn_code(f, 4), 53, "insn 4 is JGE (x86-64: the x32 check)");
    assert_eq(_t_insn_k(f, 4), 1073741824, "... against X32_SYSCALL_BIT (bit 30)");
    assert_eq(4 + 1 + _t_insn_jt(f, 4), kill_idx, "... and lands on the KILL");
    assert_eq(_t_insn_jf(f, 4), 0, "... a native nr falls through to the table");
    #endif
    return 0;
}

fn test_exec_seccomp_filter_shape() {
    test_group("exec_seccomp_filter_shape");
    # The allowlist profile cannot be used pre-exec: execve is not in it, so
    # loading it before an exec kills the child on that exec. This is the
    # property that forced a second filter to exist, so pin it.
    var basic_t, basic_v = security_create_basic_seccomp_filter();
    assert(is_ok(basic_t) == 1, "basic filter builds");
    assert_eq(_t_vec_has(_seccomp_allow_list(), _t_nr(59, 221)), 0,
      "execve (x86-64 59 / aarch64 221) is not in the allowlist");

    var exec_res_t, exec_res_v = security_create_exec_seccomp_filter();
    assert(is_ok(exec_res_t) == 1, "exec-safe filter builds");
    var info = result_unwrap(exec_res_t, exec_res_v);
    var len = security_seccomp_filter_len(info);
    assert(len % 8 == 0, "filter is a whole number of BPF insns");
    var deny = _seccomp_deny_list();
    var n_deny = vec_len(deny);
    assert_eq(n_deny, _t_nr(28, 27),
      "28 denied calls on x86-64, 27 on aarch64 (no sysfs), with the new mount API");
    var p = _t_nr(5, 4);
    assert_eq(len / 8, p + n_deny + 7,
      "arch check + one JEQ per denied call + the clone tail (4) + ALLOW, ERRNO, KILL");

    # Every denied syscall must appear as a JEQ's k operand, and each JEQ must
    # jump to the LAST instruction (the KILL). An off-by-one in that jump would
    # silently send a denied syscall to ALLOW, or to the ERRNO just before it.
    var ptr = security_seccomp_filter_ptr(info);
    var allow_idx = p + n_deny + 4;
    var errno_idx = p + n_deny + 5;
    var kill_idx = p + n_deny + 6;
    _t_check_seccomp_prologue(ptr, kill_idx);
    var i = 0;
    var ok_jumps = 1;
    while (i < n_deny) {
        var at = p + i;
        if (_t_insn_code(ptr, at) != 21) { ok_jumps = 0; }
        if (_t_insn_k(ptr, at) != vec_get(deny, i)) { ok_jumps = 0; }
        # from index at, skipping jt lands on at+1+jt; that must be kill_idx.
        if (at + 1 + _t_insn_jt(ptr, at) != kill_idx) { ok_jumps = 0; }
        if (_t_insn_jf(ptr, at) != 0) { ok_jumps = 0; }
        i = i + 1;
    }
    assert_eq(ok_jumps, 1, "every denied syscall JEQs to the KILL instruction");

    # The clone tail (3.12.9). clone3 gets ENOSYS; clone is tested on its flags.
    var t = p + n_deny;
    assert_eq(_t_insn_code(ptr, t), 21, "clone3: JEQ");
    assert_eq(_t_insn_k(ptr, t), 435, "... on clone3 (435 on both)");
    assert_eq(t + 1 + _t_insn_jt(ptr, t), errno_idx, "... to the ERRNO");
    assert_eq(_t_insn_code(ptr, t + 1), 21, "clone: JEQ");
    assert_eq(_t_insn_k(ptr, t + 1), _t_nr(56, 220), "... on clone (x86-64 56 / aarch64 220)");
    assert_eq(_t_insn_jt(ptr, t + 1), 0, "... a match goes on to its flags");
    assert_eq(t + 2 + _t_insn_jf(ptr, t + 1), allow_idx, "... anything else is ALLOW");
    assert_eq(_t_insn_code(ptr, t + 2), 32, "LD");
    assert_eq(_t_insn_k(ptr, t + 2), 16, "... of args[0], clone's flags");
    assert_eq(_t_insn_code(ptr, t + 3), 69, "JSET");
    # NEWNS | NEWCGROUP | NEWUTS | NEWIPC | NEWUSER | NEWPID | NEWNET; never the
    # low byte, which is clone's exit signal (SIGCHLD for a fork).
    assert_eq(_t_insn_k(ptr, t + 3), 2114060288, "... on every CLONE_NEW* flag (0x7E020000)");
    assert_eq(t + 4 + _t_insn_jt(ptr, t + 3), kill_idx, "... a namespace flag is KILL");
    assert_eq(t + 4 + _t_insn_jf(ptr, t + 3), allow_idx, "... a plain clone is ALLOW");
    assert_eq(_t_insn_k(ptr, allow_idx), 2147418112, "RET ALLOW");
    assert_eq(_t_insn_k(ptr, errno_idx), 327718, "RET ERRNO | ENOSYS (0x00050026)");
    assert_eq(_t_insn_k(ptr, kill_idx), 2147483648, "RET KILL_PROCESS");

    # The numbers are this architecture's own. Through 3.12.7 the table was
    # x86-64's on every arch, and on aarch64 it denied nanosleep (101) while
    # the real ptrace (117), mount (40) and unshare (97) went through.
    assert_eq(_t_vec_has(deny, _t_nr(165, 40)), 1, "mount is denied (x86-64 165 / aarch64 40)");
    assert_eq(_t_vec_has(deny, _t_nr(101, 117)), 1, "ptrace is denied (x86-64 101 / aarch64 117)");
    assert_eq(_t_vec_has(deny, _t_nr(272, 97)), 1, "unshare is denied (x86-64 272 / aarch64 97)");
    assert_eq(_t_vec_has(deny, 430), 1, "fsopen is denied (430 on both)");
    assert_eq(_t_vec_has(deny, 442), 1, "mount_setattr is denied (442 on both)");
    assert_eq(_t_vec_has(deny, _t_nr(35, 101)), 0, "nanosleep is not (x86-64 35 / aarch64 101)");
    return 0;
}

fn test_basic_seccomp_filter_shape() {
    test_group("basic_seccomp_filter_shape");
    var r_t, r_v = security_create_basic_seccomp_filter();
    assert(is_ok(r_t) == 1, "basic filter builds");
    var info = result_unwrap(r_t, r_v);
    var ptr = security_seccomp_filter_ptr(info);
    var len = security_seccomp_filter_len(info);
    var allow = _seccomp_allow_list();
    var m = vec_len(allow);
    assert_eq(m, _t_nr(20, 19), "20 allowed calls on x86-64, 19 on aarch64 (no arch_prctl)");
    var p = _t_nr(5, 4);
    assert_eq(len / 8, p + m + 2, "arch check + one JEQ per allowed call + RET KILL + RET ALLOW");

    # Here the fall-through is the KILL, so that is where the x32 branch must
    # land. The ALLOW sits one instruction later, where an off-by-one would
    # send every x32 call.
    var kill_idx = p + m;
    var allow_idx = p + m + 1;
    _t_check_seccomp_prologue(ptr, kill_idx);
    var i = 0;
    var ok = 1;
    while (i < m) {
        var at = p + i;
        if (_t_insn_code(ptr, at) != 21) { ok = 0; }
        if (_t_insn_k(ptr, at) != vec_get(allow, i)) { ok = 0; }
        if (at + 1 + _t_insn_jt(ptr, at) != allow_idx) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, "every allowed syscall JEQs to the ALLOW instruction");
    assert_eq(_t_insn_k(ptr, kill_idx), 2147483648, "falling through every JEQ is KILL_PROCESS");
    assert_eq(_t_insn_k(ptr, allow_idx), 2147418112, "the jump target is ALLOW");
    assert_eq(_t_vec_has(allow, _t_nr(0, 63)), 1, "read is allowed (x86-64 0 / aarch64 63)");
    assert_eq(_t_vec_has(allow, _t_nr(231, 94)), 1, "exit_group is allowed (x86-64 231 / aarch64 94)");
    return 0;
}

# Fork a child that loads the exec-safe filter (when `filtered`) and then
# enters the kernel one way; return its wait status. The ways:
#   1  umount2 by the stdlib's name — a denied call in the native ABI
#   2  getpid as an x32 call (x86-64: nr 39 with bit 30 set)
#   3  getpid through the i386 gate (x86-64: `int 0x80`, i386 nr 20)
#   4  clone(CLONE_NEWNS | SIGCHLD) — a namespace through clone (3.12.9)
#   5  clone3(NULL, 0) — exits with the errno it got back (3.12.9)
#   6  fsopen("tmpfs", 0) — the new mount API (3.12.9)
#   7  clone(SIGCHLD), a plain fork, which the filter must still allow
# Unfiltered, each returns (an error, a pid, or a child that exits at once) and
# the child exits 0, or with way 5's errno. Filtered, ways 1-4 and 6 must be
# SECCOMP_RET_KILL_PROCESS: death by SIGSYS. Way 5 must return ENOSYS, and way 7
# must run. The core limit is zeroed first so an expected kill does not leave a
# core dump behind.
fn _t_seccomp_probe(way, filtered, info) {
    var pid = kv_fork();
    if (pid == 0) {
        _t_set_rlimit(4, 0);                        # RLIMIT_CORE
        if (filtered == 1) {
            var r_t, r_v = security_load_seccomp(security_seccomp_filter_ptr(info),
              security_seccomp_filter_len(info));
            if (is_ok(r_t) == 0) { sys_exit(60); }
        }
        if (way == 1) { sys_umount2("/kavach-t-never-mounted", 0); }
        #ifdef CYRIUS_ARCH_X86
        # SAFETY: getpid in the x32 numbering (39 | __X32_SYSCALL_BIT). No
        # arguments and no memory is touched; where the kernel has no x32 ABI
        # it returns -ENOSYS.
        if (way == 2) { syscall(1073741863); }
        if (way == 3) { _t_int80_getpid(); }
        #endif
        if (way == 4 || way == 7) {
            var flags = SIGCHLD;
            if (way == 4) { flags = flags | CLONE_NEWNS; }
            # SAFETY: clone with no new stack is fork: the child returns 0 on a
            # copy of this stack and leaves at once. Unprivileged, NEWNS fails
            # with EPERM and makes no child.
            var c = syscall(SYS_CLONE, flags, 0, 0, 0, 0);
            if (c == 0) { sys_exit(0); }
            if (c > 0) {
                var cst[8];
                store64(&cst, 0);
                kv_waitpid(c, &cst, 0);
            }
        }
        if (way == 5) {
            # SAFETY: clone3 with no argument struct; the kernel rejects a
            # size of 0 (EINVAL) before reading anything. 435 on both arches.
            var e = syscall(435, 0, 0);
            if (e < 0) { sys_exit((0 - e) & 255); }
            sys_exit(0);
        }
        if (way == 6) {
            # SAFETY: fsopen(name, flags) only reads the name; 430 on both
            # arches. Unprivileged it fails with EPERM.
            syscall(430, "tmpfs", 0);
        }
        sys_exit(0);
    }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    return load32(&st);
}

# i386 getpid through `int 0x80`. The only register it writes is eax (the
# result), and nothing reads it.
fn _t_int80_getpid() {
    #ifdef CYRIUS_ARCH_X86
    # SAFETY: i386 getpid (nr 20) takes no arguments and touches no memory.
    # Linux preserves every register but rax across `int 0x80` from 64-bit
    # code (r8-r11 too, since 4.17). Without IA32 emulation the gate raises
    # SIGSEGV, which the caller reads as "not exercisable here".
    asm {
        0xB8; 0x14; 0x00; 0x00; 0x00;   # mov eax, 20        ; i386 getpid
        0xCD; 0x80;                     # int 0x80           ; enter through the i386 gate
    }
    #endif
    return 0;
}

# The kill path itself, exercised. The shape tests pin the bytes; this pins
# what the kernel does with them. Measured against the 3.12.7 filter (no arch
# check), ways 2 and 3 ran and exited 0 under the filter; a number-only filter
# admits both.
fn test_seccomp_kills_what_it_denies() {
    test_group("seccomp_kills_what_it_denies");
    if (_t_host_loads_seccomp() == 0) {
        assert_eq(1, 1, "host refuses seccomp — kill path not exercisable here");
        return 0;
    }
    var sf_t, sf_v = security_create_exec_seccomp_filter();
    var info = result_unwrap(sf_t, sf_v);

    var ctl = _t_seccomp_probe(1, 0, info);
    assert_eq(ctl & 127, 0, "unfiltered, umount2 returns (EPERM or EINVAL, no signal)");
    var st = _t_seccomp_probe(1, 1, info);
    assert_eq(st & 127, 31, "filtered, a denied call in the native ABI dies by SIGSYS");

    #ifdef CYRIUS_ARCH_X86
    ctl = _t_seccomp_probe(2, 0, info);
    assert_eq(ctl & 127, 0, "unfiltered, an x32 getpid returns (a pid, or ENOSYS without x32)");
    st = _t_seccomp_probe(2, 1, info);
    assert_eq(st & 127, 31, "filtered, an x32 call dies by SIGSYS (bit 30 is checked)");

    ctl = _t_seccomp_probe(3, 0, info);
    if ((ctl & 127) != 0) {
        assert_eq(1, 1, "no IA32 emulation on this kernel — the i386 gate is not exercisable");
    }
    if ((ctl & 127) == 0) {
        st = _t_seccomp_probe(3, 1, info);
        assert_eq(st & 127, 31, "filtered, an i386 int 0x80 call dies by SIGSYS (the arch is checked)");
    }
    #endif

    # 3.12.9: the doors around the mount and unshare entries.
    ctl = _t_seccomp_probe(4, 0, info);
    assert_eq(ctl & 127, 0, "unfiltered, clone(CLONE_NEWNS) returns (EPERM, or a child as root)");
    st = _t_seccomp_probe(4, 1, info);
    assert_eq(st & 127, 31, "filtered, clone with a namespace flag dies by SIGSYS");

    ctl = _t_seccomp_probe(5, 0, info);
    assert(((ctl >> 8) & 255) != 38, "unfiltered, clone3(NULL, 0) is refused by the kernel, not ENOSYS");
    st = _t_seccomp_probe(5, 1, info);
    assert_eq(st & 127, 0, "filtered, clone3 is not killed");
    assert_eq((st >> 8) & 255, 38, "... it gets ENOSYS, so glibc falls back to clone");

    ctl = _t_seccomp_probe(6, 0, info);
    assert_eq(ctl & 127, 0, "unfiltered, fsopen returns (EPERM unprivileged)");
    st = _t_seccomp_probe(6, 1, info);
    assert_eq(st & 127, 31, "filtered, fsopen (the new mount API) dies by SIGSYS");

    st = _t_seccomp_probe(7, 1, info);
    assert_eq(st & 65535, 0, "filtered, a plain clone(SIGCHLD) fork still runs and exits 0");
    return 0;
}

# The name map answers in this build's numbering, and leaves out a name the
# architecture does not have rather than lending it another call's number.
fn test_syscall_name_map_is_native() {
    test_group("syscall_name_map_is_native");
    security_syscall_map_reset();
    assert_eq(security_syscall_name_to_nr("openat"), _t_nr(257, 56), "openat (x86-64 257 / aarch64 56)");
    assert_eq(security_syscall_name_to_nr("mount"), _t_nr(165, 40), "mount (x86-64 165 / aarch64 40)");
    assert_eq(security_syscall_name_to_nr("execve"), _t_nr(59, 221), "execve (x86-64 59 / aarch64 221)");
    assert_eq(security_syscall_name_to_nr("open"), _t_nr(2, 0 - 1), "open: x86-64 2; aarch64 has none");
    assert_eq(security_syscall_name_to_nr("fork"), _t_nr(57, 0 - 1), "fork: x86-64 57; aarch64 has none");
    assert_eq(security_syscall_name_to_nr("no_such_call"), 0 - 1, "an unknown name is -1");
    return 0;
}

# unshare(2) and chroot(2) have no stdlib name, and on aarch64 kavach's own
# x86-64 numbers ran kcmp and sethostname. Both refuse there now, before any
# side effect. On x86-64 they are exercised by the namespace and rootfs tests.
fn test_aarch64_refuses_unnamed_calls() {
    test_group("aarch64_refuses_unnamed_calls");
    #ifdef CYRIUS_ARCH_AARCH64
    var r_t, r_v = security_create_namespace(NS_NETWORK);
    assert_eq(is_ok(r_t), 0, "namespaces refuse on aarch64");
    assert_eq(_spawn_enter_rootfs("/tmp"), 0 - 1, "rootfs entry refuses on aarch64");
    assert_eq(spawn_namespaces_available(NS_NETWORK), 0, "and the probe reports none");
    #endif
    #ifdef CYRIUS_ARCH_X86
    assert_eq(1, 1, "x86-64 issues both calls; covered by the namespace and rootfs tests");
    #endif
    return 0;
}

fn test_spawn_terminate_escalates() {
    test_group("sandbox_spawn_terminate");
    var sb = _spawn_running_sandbox(0);
    var sp = sandbox_spawn(sb, "/bin/sleep 30", 0);
    assert(sp != 0, "spawned");
    # SIGTERM, brief grace, then SIGKILL. sleep ignores nothing, so it dies on
    # the TERM and the escalation should not be needed — but the call must
    # return promptly either way rather than hanging for the full 30s.
    var code = spawned_terminate(sp, 500);
    assert(code >= 0, "terminate returned a code");
    assert_eq(spawned_alive(sp), 0, "child is reaped, not left a zombie");
    return 0;
}

fn test_spawn_null_handles() {
    test_group("sandbox_spawn_null_handles");
    assert_eq(spawned_pid(0), 0 - 1, "pid of null");
    assert_eq(spawned_alive(0), 0, "alive of null");
    assert_eq(spawned_exit_code(0), 0 - 1, "exit code of null");
    assert_eq(spawned_try_wait(0), 0 - 1, "try_wait of null");
    assert_eq(spawned_wait(0), 0 - 1, "wait of null");
    assert_eq(spawned_kill(0, 15), 0 - 1, "kill of null");
    assert_eq(spawned_terminate(0, 10), 0 - 1, "terminate of null");
    return 0;
}

# ══ rootfs entry (3.9.1) ══

fn test_spawn_namespaces_environment_aware() {
    test_group("spawn_namespaces");
    # The default policy asks for network isolation (policy_new zero-fills
    # network_enabled), which unprivileged requires a user namespace to satisfy.
    var p = policy_basic();
    SandboxPolicy_set_seccomp_enabled(p, 0);
    var want = _spawn_ns_flags(p, 0);
    assert((want & NS_NETWORK) != 0, "default policy requests network isolation");

    if (spawn_namespaces_available(want) == 0) {
        # Host denies them (CI containers, kernel.unprivileged_userns_clone=0).
        # The contract is FAIL CLOSED — the payload must not run less isolated
        # than the policy promised — so assert the refusal is clean and named,
        # rather than skipping and pretending the path is covered.
        var sb0 = _spawn_running_sandbox(p);
        var sp0 = sandbox_spawn(sb0, "/bin/true", 0);
        if (sp0 != 0) {
            var code0 = spawned_wait(sp0);
            # 123 = namespace creation, 118 = id mapping. Either is a clean
            # fail-closed; what must NOT happen is the payload running.
            assert(code0 == 123 || code0 == 118,
              "child exits with a confinement code rather than running unisolated");
            # `spawn_exit_name` returns 0 for a non-confinement code, so the
            # null check comes FIRST — handing 0 to streq segfaults, which
            # turns the assertion above into an exit-139 with no diagnostic.
            assert(spawn_exit_name(code0) != 0, "the code is a confinement code");
            if (spawn_exit_name(code0) != 0) {
                assert(streq(spawn_exit_name(code0), "") == 0,
                  "and the code has a readable name");
            }
        }
        return 0;
    }
    # Host allows them: the spawn must actually work with the namespaces on.
    var sb = _spawn_running_sandbox(p);
    var sp = sandbox_spawn(sb, "/bin/true", 0);
    assert(sp != 0, "spawned with namespaces");
    assert_eq(spawned_wait(sp), 0, "and the payload ran inside them");
    return 0;
}

fn test_spawn_exit_name() {
    test_group("spawn_exit_name");
    # A bare "exited 123" is undiagnosable; every confinement code must name
    # itself. This is the helper that turns a CI failure into a sentence.
    assert(streq(spawn_exit_name(123), "") == 0, "NS code has a name");
    assert(strstr(spawn_exit_name(123), "namespace") >= 0, "and it mentions namespaces");
    assert(strstr(spawn_exit_name(125), "seccomp") >= 0, "seccomp code names seccomp");
    assert(strstr(spawn_exit_name(119), "rootfs") >= 0, "rootfs code names rootfs");
    # Namespace creation and id mapping must be DISTINGUISHABLE — they fail on
    # different hosts and the fix for each is different.
    assert(streq(spawn_exit_name(118), spawn_exit_name(123)) == 0,
      "idmap failure is not reported as a namespace failure");
    assert(strstr(spawn_exit_name(118), "uid_map") >= 0, "idmap code names uid_map");
    assert_eq(spawn_exit_name(0), 0, "a normal exit is not a confinement failure");
    assert_eq(spawn_exit_name(127), 0, "nor is execve-not-found");
    return 0;
}

fn test_rootfs_config_field() {
    test_group("rootfs_config_field");
    var c = config_new();
    assert_eq(SandboxConfig_rootfs(c), 0, "defaults to 0 — host filesystem, the pre-3.9.1 behaviour");
    config_rootfs(c, "/tmp/somewhere");
    assert(streq(SandboxConfig_rootfs(c), "/tmp/somewhere") == 1, "setter round-trips");
    # Appending the field must not have moved any existing offset.
    var c2 = config_new();
    config_backend(c2, KavachBackend.NOOP);
    config_timeout_ms(c2, 4242);
    config_workdir(c2, "/w");
    assert_eq(SandboxConfig_backend(c2), KavachBackend.NOOP, "backend still at its offset");
    assert_eq(SandboxConfig_timeout_ms(c2), 4242, "timeout_ms still at its offset");
    assert(streq(SandboxConfig_workdir(c2), "/w") == 1, "workdir still at its offset");
    return 0;
}

fn test_ns_flags_for_rootfs() {
    test_group("ns_flags_for_rootfs");
    # A rootfs needs a MOUNT namespace, and unprivileged that is only obtainable
    # inside a new USER namespace.
    var p = policy_basic();
    SandboxPolicy_set_network_enabled(p, 1);          # no netns wanted
    var f = _spawn_ns_flags(p, "/tmp/x");
    assert((f & NS_MOUNT) != 0, "rootfs implies a mount namespace");
    if (sys_getuid() != 0) {
        assert((f & NS_USER) != 0, "unprivileged: paired with a user namespace");
    }
    # No rootfs and networking allowed -> nothing to unshare.
    assert_eq(_spawn_ns_flags(p, 0), 0, "no rootfs, network allowed -> no namespaces");
    return 0;
}

# The mount namespace a process is in, as `readlink /proc/self/ns/mnt`
# ("mnt:[4026531841]"), into `buf`. Returns the length, or -1.
fn _t_mnt_ns(buf, cap) {
    var n = sys_readlink("/proc/self/ns/mnt", buf, cap - 1);
    if (n < 0) { return 0 - 1; }
    store8(buf + n, 0);
    return n;
}

# 3.12.9: `confine_child_wd` enters a rootfs only inside a mount namespace of
# its own, even when the caller passes want_ns = 0. With no namespace, its
# `mount(/, MS_REC|MS_PRIVATE)` lands in the caller's mount namespace, which as
# root is the host's. Measured in a child: with rootfs "/" the sequence has to
# end in a different mount namespace from the parent's (exit 0), or refuse on a
# host without namespaces (123, or 118 for the id maps). Before the fix it ran
# with no namespace: unprivileged the private mount was refused (119); as root
# it would have succeeded in the host's namespace (exit 1 here).
fn test_rootfs_always_gets_a_mount_namespace() {
    test_group("rootfs_always_gets_a_mount_namespace");
    var parent_ns[64];
    if (_t_mnt_ns(&parent_ns, 64) < 0) {
        assert_eq(1, 1, "no /proc/self/ns/mnt here — not measurable");
        return 0;
    }
    var uid = sys_getuid();
    var gid = kv_getgid();
    var pid = kv_fork();
    if (pid == 0) {
        confine_child_wd(0, "/", 0, uid, gid, 0, 0, 0);     # want_ns = 0
        var child_ns[64];
        if (_t_mnt_ns(&child_ns, 64) < 0) { sys_exit(2); }
        if (streq(&child_ns, &parent_ns) == 1) { sys_exit(1); }
        sys_exit(0);
    }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    var code = (load32(&st) >> 8) & 255;
    assert(code != 1, "never the caller's mount namespace");
    assert(code != 119, "the private mount was not refused for want of a namespace");
    if (spawn_namespaces_available(_spawn_ns_flags(0, "/")) == 1) {
        assert_eq(code, 0, "entered inside a mount namespace of its own");
    }
    if (spawn_namespaces_available(_spawn_ns_flags(0, "/")) == 0) {
        assert(code == 123 || code == 118, "or refused: no namespaces on this host");
    }
    return 0;
}

# ══ OCI backend exit status (3.9.2) ══════════════════════
#
# Before 3.9.2 `_oci_run` returned only a byte count and `oci_exec` reported
# exit_code 0 for EVERY container that ran — a payload that exited 7, died on a
# signal, or never started at all was indistinguishable from success. These
# tests drive `_oci_run` with a stand-in "runtime" so they need no runc, no
# root, and no container: `_oci_run` takes the runtime path as a parameter, and
# a stand-in simply ignores the `--root ... run --bundle ...` arguments.
#
# The assertions are on the DECODED status, not on the byte count, because the
# byte count was exactly what the old code mistook for an outcome.

# Write an executable stand-in runtime at `path`. `body` is shell.
fn _t_write_stub(path, body) {
    sys_unlink(path);
    file_write_all(path, body, strlen(body));
    sys_chmod(path, 493);                   # 0755
    return path;
}

fn test_oci_run_reports_nonzero_exit() {
    test_group("oci_run_reports_nonzero_exit");
    var stub = _t_write_stub("/tmp/kavach-t-oci-exit7",
      "#!/bin/sh\necho hello-stdout\necho boom-stderr >&2\nexit 7\n");
    var buf = alloc(65536);
    var n = _oci_run(stub, "/tmp/nonexistent-bundle", "kavach-t-exit7", 0, buf, 65536);
    assert(n > 0, "stdout was captured");
    store8(buf + n, 0);
    assert_eq(strstr(buf, "hello-stdout") >= 0, 1, "stdout content is the payload's");
    # THE regression assertion: 7, not 0.
    assert_eq(oci_last_exit(), 7, "the payload's real exit code");
    # stderr is captured too — before 3.9.2 it went to /dev/null, which is how
    # runc's own "permission denied" became a silent empty success.
    assert_eq(strstr(confine_last_stderr(), "boom-stderr") >= 0, 1, "stderr content is preserved");
    sys_unlink(stub);
    return 0;
}

fn test_oci_run_reports_zero_only_on_success() {
    test_group("oci_run_reports_zero_only_on_success");
    var stub = _t_write_stub("/tmp/kavach-t-oci-ok", "#!/bin/sh\necho fine\nexit 0\n");
    var buf = alloc(4096);
    var n = _oci_run(stub, "/tmp/nonexistent-bundle", "kavach-t-ok", 0, buf, 4096);
    assert(n > 0, "stdout captured");
    assert_eq(oci_last_exit(), 0, "a genuine success still reports 0");
    assert_eq(confine_last_stderr_len(), 0, "and no stderr");
    sys_unlink(stub);
    return 0;
}

fn test_oci_run_missing_runtime_binary() {
    test_group("oci_run_missing_runtime_binary");
    var buf = alloc(4096);
    var n = _oci_run("/definitely/not/a/runtime", "/tmp/b", "kavach-t-missing", 0, buf, 4096);
    assert_eq(n, 0, "no output from a binary that never executed");
    # execve failed in the child -> 127, the shell's command-not-found code.
    assert_eq(oci_last_exit(), 127, "a failed execve is 127, not 0");
    return 0;
}

fn test_oci_run_signalled_child() {
    test_group("oci_run_signalled_child");
    # SIGKILL itself, so the parent decodes a signalled status rather than an
    # exit code. Must match confine_capture's 128 + sig convention, or an exit
    # code would mean different things on the two backends.
    var stub = _t_write_stub("/tmp/kavach-t-oci-sig", "#!/bin/sh\nkill -9 $$\n");
    var buf = alloc(4096);
    _oci_run(stub, "/tmp/b", "kavach-t-sig", 0, buf, 4096);
    assert_eq(oci_last_exit(), 137, "SIGKILL -> 128 + 9");
    sys_unlink(stub);
    return 0;
}

fn test_oci_run_large_stderr_does_not_deadlock() {
    test_group("oci_run_large_stderr_does_not_deadlock");
    # A child writing ~200 KiB to stderr BEFORE its first stdout byte: past a
    # pipe buffer and past the 64 KiB stderr cap. 3.9.2 sent stderr to a file
    # for this reason; since 3.13.2 it is the shared capture's second pipe, read
    # on into a sink once full. The deadline turns a regression into a failure
    # (timed out, exit 137) instead of a hung suite.
    var _bigerr_body_sb = str_builder_new();
    str_builder_add_cstr(_bigerr_body_sb, "#!/bin/sh\ni=0\n");
    str_builder_add_cstr(_bigerr_body_sb, "while [ $i -lt 5000 ]; do ");
    str_builder_add_cstr(_bigerr_body_sb, "echo 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' >&2; i=$((i+1)); done\n");
    str_builder_add_cstr(_bigerr_body_sb, "echo done-stdout\nexit 3\n");
    var bigerr_body = str_data(str_builder_build(_bigerr_body_sb));
    var stub = _t_write_stub("/tmp/kavach-t-oci-bigerr", bigerr_body);
    var c = config_timeout_ms(config_new(), 20000);
    var buf = alloc(65536);
    var n = _oci_run(stub, "/tmp/b", "kavach-t-bigerr", c, buf, 65536);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    assert_eq(confine_last_timed_out(), 0, "the run finished on its own, not at the deadline");
    assert_eq(strstr(buf, "done-stdout") >= 0, 1, "stdout still arrives after ~200 KiB of stderr");
    assert_eq(oci_last_exit(), 3, "and the exit code survives");
    assert_eq(confine_last_stderr_len(), CONFINE_ERR_MAX - 1, "stderr was captured, up to its cap");
    sys_unlink(stub);
    return 0;
}

fn test_oci_runtime_log_is_separate_from_container_stderr() {
    test_group("oci_runtime_log_is_separate_from_container_stderr");
    # A stand-in that writes to BOTH its own --log file and its stderr, so the
    # two channels are provably distinct rather than merely assumed to be.
    # $2 is the --log path (argv: --root <r> --log <l> run ...  =>  $1=--root
    # $2=<r> $3=--log $4=<l>).
    var stub = _t_write_stub("/tmp/kavach-t-oci-split",
      "#!/bin/sh\necho payload-stderr >&2\necho runtime-log > \"$4\"\nexit 0\n");
    var buf = alloc(4096);
    _oci_run(stub, "/tmp/b", "kavach-t-split", 0, buf, 4096);
    var err = str_cstr(str_from(confine_last_stderr()));
    var log = _oci_take_log("kavach-t-split");
    assert_eq(strstr(err, "payload-stderr") >= 0, 1, "container stderr holds the payload's output");
    assert_eq(strstr(err, "runtime-log") >= 0, 0, "and NOT the runtime's log");
    assert_eq(strstr(log, "runtime-log") >= 0, 1, "the runtime log holds the runtime's output");
    assert_eq(strstr(log, "payload-stderr") >= 0, 0, "and NOT the payload's");
    sys_unlink(stub);
    return 0;
}

fn test_backend_diagnostic_results_bypass_the_gate() {
    test_group("backend_diagnostic_results_bypass_the_gate");
    # WHY this flag exists, asserted rather than described: a runtime diagnostic
    # really does trip the scanner. If this first assertion ever stops holding,
    # the bypass is no longer load-bearing and should be reconsidered — but
    # while it holds, gating diagnostics means kavach censoring its own errors.
    var probe = scan_result_new();
    var _diag_sb = str_builder_new();
    str_builder_add_cstr(_diag_sb, "runc run failed: unable to start container process: ");
    str_builder_add_cstr(_diag_sb, "error during container init: exec: \"/app/x\": ");
    str_builder_add_cstr(_diag_sb, "stat /app/x: no such file or directory");
    var diag = str_data(str_builder_build(_diag_sb));
    code_scan(diag, probe);
    assert(vec_len(ScanResult_findings(probe)) > 0, "a runtime diagnostic DOES trip code_scan");
    assert(ScanResult_worst_severity(probe) >= Severity.HIGH, "at HIGH or worse, i.e. quarantine-or-block");

    # The flag tracks whichever constructor produced the result the caller holds.
    var e = backend_error_result("boom");
    assert(e != 0, "error result built");
    assert_eq(backend_result_is_diagnostic(), 1, "backend_error_result marks a diagnostic");

    var buf = alloc(64);
    memcpy(buf, "payload", 7);
    var c = backend_capture_finish(buf, 7, 64, "fail", 0, 1000000);
    assert(c != 0, "capture result built");
    assert_eq(backend_result_is_diagnostic(), 0, "backend_capture_finish clears it — captured output IS gated");

    var viol = vec_new();
    vec_push(viol, guard_violation_new("test", "blocked for testing"));
    var g = backend_guard_result(viol);
    assert(g != 0, "guard result built");
    assert_eq(backend_result_is_diagnostic(), 1, "a guard violation is a diagnostic too");
    return 0;
}

fn test_oci_diag_trims_trailing_newlines() {
    test_group("oci_diag_trims_trailing_newlines");
    assert_eq(streq(_oci_diag("x: ", "boom\n"), "x: boom"), 1, "one trailing LF");
    assert_eq(streq(_oci_diag("x: ", "boom\r\n"), "x: boom"), 1, "CRLF");
    assert_eq(streq(_oci_diag("x: ", "boom\n\n\n"), "x: boom"), 1, "several");
    assert_eq(streq(_oci_diag("x: ", "boom"), "x: boom"), 1, "none");
    assert_eq(streq(_oci_diag("x: ", ""), "x: "), 1, "empty detail");
    assert_eq(streq(_oci_diag("x: ", "\n"), "x: "), 1, "newline-only detail");
    return 0;
}

fn test_oci_state_root_rejects_a_hostile_dir() {
    test_group("oci_state_root_rejects_a_hostile_dir");
    # The name is fully predictable ("kavach-runc-" + uid) and lives in a
    # world-writable directory, so another user can create it first and own
    # runc's state plus both scratch files. sys_mkdir returning EEXIST says
    # nothing about what is actually there.
    var root = _oci_state_root();
    assert(root != 0, "a directory we own and created is accepted");

    # World-writable -> refused.
    var open_dir = "/tmp/kavach-t-openperm";
    _oci_t_rmdir(open_dir);
    sys_mkdir(open_dir, 511);                          # 0777
    assert_eq(_oci_dir_is_ours(open_dir), 0, "a world-writable dir is refused");
    sys_chmod(open_dir, 448);                          # 0700
    assert_eq(_oci_dir_is_ours(open_dir), 1, "the same dir at 0700 is accepted");
    _oci_t_rmdir(open_dir);

    # A symlink -> refused. lstat, not stat, is what makes this work: stat would
    # report the TARGET's type and happily accept a link to a real 0700 dir.
    var link = "/tmp/kavach-t-linkroot";
    sys_unlink(link);
    _oci_t_rmdir(link);
    var target = "/tmp/kavach-t-linktarget";
    _oci_t_rmdir(target);
    sys_mkdir(target, 448);
    if (sys_symlink(target, link) == 0) {
        assert_eq(_oci_dir_is_ours(link), 0, "a symlink to a valid dir is still refused");
        sys_unlink(link);
    }
    _oci_t_rmdir(target);

    # A regular file -> refused.
    var f = "/tmp/kavach-t-notadir";
    sys_unlink(f);
    file_write_all(f, "x", 1);
    assert_eq(_oci_dir_is_ours(f), 0, "a regular file is refused");
    sys_unlink(f);

    assert_eq(_oci_dir_is_ours("/tmp/kavach-t-absent-entirely"), 0, "an absent path is refused");

    # Someone else's directory -> refused, by the OWNER check alone. /proc/1/fd
    # is a directory at mode 0500 owned by root on any Linux host, so it passes
    # the type and permission checks and only st_uid can refuse it. Until
    # 3.12.8 those fields were read at x86-64 offsets on every arch.
    if (sys_getuid() != 0) {
        var sb[144];
        if (kv_lstat("/proc/1/fd", &sb) == 0) {
            var m = load32(&sb + STAT_MODE);
            assert_eq(m & 61440, 16384, "/proc/1/fd is a directory");
            assert_eq(m & 63, 0, "... with no group or other bits");
            assert_eq(_oci_dir_is_ours("/proc/1/fd"), 0, "... and root's, so it is refused");
        }
    }
    return 0;
}

fn _oci_t_rmdir(p) {
    sys_rmdir(p);
    return 0;
}

fn test_oci_stale_runtime_log_is_cleared() {
    test_group("oci_stale_runtime_log_is_cleared");
    # `_oci_run` unlinks the log path before the run. A leftover log would
    # otherwise read as THIS run's runtime failure, and `oci_exec` reports a
    # non-empty log as one. (The same scratch-file rule covered the stderr file
    # through 3.13.1, when stderr went to one.)
    var stub = _t_write_stub("/tmp/kavach-t-oci-excl", "#!/bin/sh\necho second >&2\nexit 0\n");
    var idp = "kavach-t-excl";
    var path = _oci_log_path(idp);
    assert(path != 0, "scratch path built");
    if (path == 0) { return 0; }
    # Pre-seed the file as a previous run would have left it.
    file_write_all(path, "STALE-FROM-A-PREVIOUS-RUN\n", 26);
    var buf = alloc(4096);
    _oci_run(stub, "/tmp/b", idp, 0, buf, 4096);
    var log = _oci_take_log(idp);
    assert_eq(strstr(log, "STALE-FROM-A-PREVIOUS-RUN") >= 0, 0, "a leftover log never leaks into this run");
    sys_unlink(stub);
    return 0;
}

# ── ADR-005 §H4: exec by pinned fd (3.12.7) ─────────────────────────────

# fork, exec `path` through kv_exec_child with `pin`, return the exit code.
fn _t_exec_status(pin, path) {
    var argv[16];
    store64(&argv, path);
    store64(&argv + 8, 0);
    var envp[8];
    store64(&envp, 0);
    var pid = kv_fork();
    if (pid == 0) {
        kv_exec_child(pin, path, &argv, &envp);
        sys_exit(127);
    }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    return (load32(&st) >> 8) & 255;
}

# Copy `src` to `dst` at mode 0755 (a stand-in binary the test may swap).
fn _t_copy_exec(src, dst) {
    var n = 0;
    var buf = file_read_whole(src, &n);
    if (buf == 0) { return 0 - 1; }
    if (file_write_all(dst, buf, n) != n) { return 0 - 1; }
    sys_chmod(dst, 493);
    return 0;
}

fn test_exec_pin_classifies_paths() {
    test_group("exec_pin_classifies_paths");
    assert_eq(kv_exec_pin("relative/prog"), KV_EXEC_BY_PATH, "a relative path is left to the child's cwd");
    assert_eq(kv_exec_pin("/no/such/kavach/prog"), KV_EXEC_REFUSED, "a missing absolute path is refused, not downgraded");
    assert_eq(kv_exec_pin("/tmp"), KV_EXEC_REFUSED, "a directory is refused");
    var plain = _t_unique_tmp_path("/tmp/kavach-h4-plain-");
    file_write_all(plain, "x", 1);
    sys_chmod(plain, 420);
    assert_eq(kv_exec_pin(plain), KV_EXEC_REFUSED, "a file with no execute bit is refused");
    kv_unlink(plain);
    var fd = kv_exec_pin("/bin/sh");
    assert(fd >= 0, "an executable regular file pins");
    if (fd >= 0) { sys_close(fd); }
    return 0;
}

# The TOCTOU itself: pin a binary, swap another into its path, exec. The pinned
# exec runs the ORIGINAL; the control exec by path runs the swapped-in file,
# which proves the swap happened.
fn test_exec_pin_survives_a_binary_swap() {
    test_group("exec_pin_survives_a_binary_swap");
    var path = _t_unique_tmp_path("/tmp/kavach-h4-bin-");
    var next = _t_unique_tmp_path("/tmp/kavach-h4-next-");
    assert_eq(_t_copy_exec("/bin/true", path), 0, "stand-in for the discovered binary (true)");
    var pin = kv_exec_pin(path);
    assert(pin >= 0, "pinned");
    assert_eq(_t_copy_exec("/bin/false", next), 0, "replacement staged (false)");
    assert_eq(sys_rename(next, path), 0, "replacement swapped into the path");
    assert_eq(_t_exec_status(pin, path), 0, "the pinned exec runs the binary that was pinned");
    assert_eq(_t_exec_status(KV_EXEC_BY_PATH, path), 1, "control: by path runs the swapped-in binary");
    if (pin >= 0) { sys_close(pin); }
    kv_unlink(path);
    return 0;
}

# Same for a #! script, which takes the dup retry in kv_exec_pinned: the
# interpreter must read the pinned file, not the one now at the path.
fn test_exec_pin_survives_a_script_swap() {
    test_group("exec_pin_survives_a_script_swap");
    var path = _t_unique_tmp_path("/tmp/kavach-h4-sh-");
    var next = _t_unique_tmp_path("/tmp/kavach-h4-shnext-");
    file_write_all(path, "#!/bin/sh\nexit 3\n", 17);
    sys_chmod(path, 493);
    var pin = kv_exec_pin(path);
    assert(pin >= 0, "script pinned");
    file_write_all(next, "#!/bin/sh\nexit 4\n", 17);
    sys_chmod(next, 493);
    assert_eq(sys_rename(next, path), 0, "replacement script swapped in");
    assert_eq(_t_exec_status(pin, path), 3, "the pinned script runs");
    assert_eq(_t_exec_status(KV_EXEC_BY_PATH, path), 4, "control: by path runs the swapped-in script");
    if (pin >= 0) { sys_close(pin); }
    kv_unlink(path);
    return 0;
}

# kv_exec_capture must still behave as the stdlib exec_capture it replaces.
fn test_exec_capture_pinned_captures_stdout() {
    test_group("exec_capture_pinned_captures_stdout");
    var args = vec_new();
    vec_push(args, "/bin/echo");
    vec_push(args, "hello");
    var buf = alloc(64);
    var n = kv_exec_capture(args, buf, 64);
    assert_eq(n, 6, "six bytes captured");
    assert_eq(memeq(buf, "hello\n", 6), 1, "stdout captured");
    var none = vec_new();
    vec_push(none, "/no/such/kavach/prog");
    assert_eq(kv_exec_capture(none, buf, 64), 0, "a refused pin runs nothing and captures nothing");
    return 0;
}

fn test_oci_take_file_refuses_a_symlink() {
    test_group("oci_take_file_refuses_a_symlink");
    # O_NOFOLLOW is the ONLY guard on this read — there is no O_EXCL — so a symlink
    # planted at the scratch path must read as "", never as the target's contents.
    # Until 3.12.6 the flag was the x86_64 literal 0x20000, which aarch64 reads as
    # O_LARGEFILE, so there the read followed the link.
    var target = "/tmp/kavach-t-oci-nofollow-target";
    var link = "/tmp/kavach-t-oci-nofollow-link";
    sys_unlink(link);
    sys_unlink(target);
    file_write_all(target, "TARGET-CONTENTS", 15);
    assert_eq(sys_symlink(target, link), 0, "symlink planted at the scratch path");
    assert_eq(strlen(_oci_take_file(link)), 0, "a symlink is refused, not followed");
    # Control: the same read of the real file succeeds, so the refusal above is
    # the flag at work, not a read that fails for every path.
    assert_eq(streq(_oci_take_file(target), "TARGET-CONTENTS"), 1, "a regular file is read");
    sys_unlink(link);
    sys_unlink(target);
    return 0;
}

fn test_oci_log_path_is_uid_scoped() {
    test_group("oci_log_path_is_uid_scoped");
    var p = _oci_log_path("abc123");
    # 0 means the state root was refused. Stop here rather than hand strstr a
    # null: on aarch64 through 3.12.7 every state root was refused (struct stat
    # read at x86-64 offsets), and this test's strstr(0, ...) took the suite
    # down with a segfault.
    assert(p != 0, "a scratch path is built");
    if (p == 0) { return 0; }
    assert_eq(strstr(p, "/tmp/kavach-runc-") >= 0, 1, "under the uid-scoped state root");
    assert_eq(strstr(p, "abc123") >= 0, 1, "and names the container");
    # Distinct containers must not share a scratch file, or two concurrent runs
    # would read each other's diagnostics.
    assert_eq(streq(p, _oci_log_path("def456")), 0, "distinct per container");
    return 0;
}

# ================================================================
# Landlock right coverage (3.11.1)
# ================================================================
#
# Landlock restricts ONLY the rights named in `handled_access_fs` and leaves
# every other right fully permitted. Until 3.11.1 the mask held three rights, so
# a confined process could delete any file on the host, create directories
# anywhere, and exec any binary — while "cannot read /etc/passwd" passed,
# because reading WAS handled. Reported by agnosai with a runnable probe.
#
# These are pure-arithmetic tests of the masks. The end-to-end proof (fork,
# confine, try to unlink outside the allowed path) is `test_landlock_denies_
# mutation_outside_allowed_path` below, which is the one that actually regresses.

fn test_landlock_handled_access_covers_the_abi() {
    # ABI v1: all thirteen filesystem rights, and no more.
    var v1 = _landlock_handled_access(1);
    assert_eq(v1 & LANDLOCK_ACCESS_FS_EXECUTE, LANDLOCK_ACCESS_FS_EXECUTE, "v1 handles EXECUTE");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_READ_FILE, LANDLOCK_ACCESS_FS_READ_FILE, "v1 READ_FILE");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_WRITE_FILE, LANDLOCK_ACCESS_FS_WRITE_FILE, "v1 WRITE_FILE");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_READ_DIR, LANDLOCK_ACCESS_FS_READ_DIR, "v1 READ_DIR");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_REMOVE_FILE, LANDLOCK_ACCESS_FS_REMOVE_FILE,
      "v1 handles REMOVE_FILE — the right whose absence let a confined process delete anything");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_REMOVE_DIR, LANDLOCK_ACCESS_FS_REMOVE_DIR, "v1 REMOVE_DIR");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_MAKE_DIR, LANDLOCK_ACCESS_FS_MAKE_DIR, "v1 MAKE_DIR");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_MAKE_REG, LANDLOCK_ACCESS_FS_MAKE_REG, "v1 MAKE_REG");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_MAKE_SYM, LANDLOCK_ACCESS_FS_MAKE_SYM, "v1 MAKE_SYM");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_MAKE_SOCK, LANDLOCK_ACCESS_FS_MAKE_SOCK, "v1 MAKE_SOCK");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_MAKE_FIFO, LANDLOCK_ACCESS_FS_MAKE_FIFO, "v1 MAKE_FIFO");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_MAKE_CHAR, LANDLOCK_ACCESS_FS_MAKE_CHAR, "v1 MAKE_CHAR");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_MAKE_BLOCK, LANDLOCK_ACCESS_FS_MAKE_BLOCK, "v1 MAKE_BLOCK");

    # The later rights must NOT be named on a v1 kernel: landlock_create_ruleset
    # answers EINVAL for a right the running ABI does not know, which would turn
    # a working sandbox into a hard failure.
    assert_eq(v1 & LANDLOCK_ACCESS_FS_REFER, 0, "v1 does NOT name REFER — EINVAL on old kernels");
    assert_eq(v1 & LANDLOCK_ACCESS_FS_TRUNCATE, 0, "v1 does NOT name TRUNCATE");

    var v2 = _landlock_handled_access(2);
    assert_eq(v2 & LANDLOCK_ACCESS_FS_REFER, LANDLOCK_ACCESS_FS_REFER, "v2 adds REFER");
    assert_eq(v2 & LANDLOCK_ACCESS_FS_TRUNCATE, 0, "v2 still withholds TRUNCATE");

    var v3 = _landlock_handled_access(3);
    assert_eq(v3 & LANDLOCK_ACCESS_FS_TRUNCATE, LANDLOCK_ACCESS_FS_TRUNCATE, "v3 adds TRUNCATE");
    assert_eq(v3 & LANDLOCK_ACCESS_FS_IOCTL_DEV, 0, "v3 does NOT name IOCTL_DEV");
    # v4 adds network rights, which are not filesystem rights.
    assert_eq(_landlock_handled_access(4), v3, "v4 adds no filesystem right");

    # 3.13.2: IOCTL_DEV, the one filesystem right ABI v5 added. Unhandled, it was
    # permitted on every device file whatever the policy said.
    var v5 = _landlock_handled_access(5);
    assert_eq(v5, v3 | LANDLOCK_ACCESS_FS_IOCTL_DEV, "v5 adds IOCTL_DEV and nothing else");

    # A newer kernel is masked DOWN to what this code knows, never up.
    assert_eq(_landlock_handled_access(9), v5, "an unknown newer ABI is clamped to the known set");
}

fn test_landlock_allowed_access_grants_within_the_path() {
    var ro = _landlock_allow_read_only();
    assert_eq(ro & LANDLOCK_ACCESS_FS_READ_FILE, LANDLOCK_ACCESS_FS_READ_FILE, "ro reads files");
    assert_eq(ro & LANDLOCK_ACCESS_FS_READ_DIR, LANDLOCK_ACCESS_FS_READ_DIR, "ro lists dirs");
    # EXECUTE is granted read-only on purpose: it was permitted EVERYWHERE before
    # 3.11.1, and a sandbox that read-only-mounts /usr to run python3 is normal.
    assert_eq(ro & LANDLOCK_ACCESS_FS_EXECUTE, LANDLOCK_ACCESS_FS_EXECUTE,
      "ro can exec — withholding it would break every consumer that runs a mounted interpreter");
    assert_eq(ro & LANDLOCK_ACCESS_FS_WRITE_FILE, 0, "but read-only does NOT write");
    assert_eq(ro & LANDLOCK_ACCESS_FS_REMOVE_FILE, 0, "and does NOT delete");
    assert_eq(ro & LANDLOCK_ACCESS_FS_MAKE_DIR, 0, "and does NOT mkdir");

    var rw = _landlock_allow_read_write(3);
    assert_eq(rw & LANDLOCK_ACCESS_FS_WRITE_FILE, LANDLOCK_ACCESS_FS_WRITE_FILE, "rw writes");
    assert_eq(rw & LANDLOCK_ACCESS_FS_REMOVE_FILE, LANDLOCK_ACCESS_FS_REMOVE_FILE,
      "rw deletes INSIDE its own path — the fix must not break legitimate use");
    assert_eq(rw & LANDLOCK_ACCESS_FS_MAKE_DIR, LANDLOCK_ACCESS_FS_MAKE_DIR, "rw mkdirs");
    assert_eq(rw & LANDLOCK_ACCESS_FS_TRUNCATE, LANDLOCK_ACCESS_FS_TRUNCATE, "rw truncates on v3");
    assert_eq(_landlock_allow_read_write(1) & LANDLOCK_ACCESS_FS_TRUNCATE, 0,
      "...but not on a v1 kernel that would EINVAL on it");

    # Everything read-only grants, read-write also grants.
    assert_eq(rw & ro, ro, "read-write is a superset of read-only");
}

fn test_landlock_abi_version_is_sane() {
    var abi = security_landlock_abi_version();
    # 0 means "no Landlock here", which is a legitimate answer (old kernel, or
    # AGNOS). Anything else must be a real version number.
    if (abi != 0) {
        assert_eq(abi >= 1, 1, "a reported ABI version is at least 1");
        assert_eq(abi < 100, 1, "...and is a version, not an errno or a fd");
    }
}

# **The regression guard.** Pure-arithmetic mask tests cannot catch a mask that
# is correct but never reaches the kernel, so this one forks, confines the child
# for real, and has it try to mutate outside its allowed path.
#
# The child reports through its exit code because it is confined — it cannot
# write a result file anywhere the parent could read.
#   0 = every mutation outside was DENIED (correct)
#   1 = unlink outside SUCCEEDED (the 3.11.0 hole)
#   2 = mkdir outside SUCCEEDED (the 3.11.0 hole)
#   3 = landlock unavailable on this kernel — inconclusive, not a failure
fn _t_landlock_child(allowed, victim, newdir) {
    var rules = vec_new();
    vec_push(rules, security_fs_rule_read_write(allowed));
    if (security_landlock_abi_version() == 0) { syscall(SYS_EXIT_GROUP, 3); }
    security_apply_landlock(rules, 1);
    if (sys_unlink(victim) >= 0) { syscall(SYS_EXIT_GROUP, 1); }
    if (sys_mkdir(newdir, 448) >= 0) { syscall(SYS_EXIT_GROUP, 2); }
    syscall(SYS_EXIT_GROUP, 0);
    return 0;
}

fn test_landlock_denies_mutation_outside_allowed_path() {
    test_group("landlock_denies_mutation_outside_allowed_path");

    var allowed = "/tmp/kavach-t-ll-allowed";
    var victim = "/tmp/kavach-t-ll-victim";
    var newdir = "/tmp/kavach-t-ll-newdir";
    sys_mkdir(allowed, 448);
    var vfd = sys_open(victim, 193, 384);
    if (vfd >= 0) { sys_close(vfd); }
    sys_rmdir(newdir);

    var pid = kv_fork();
    if (pid == 0) { _t_landlock_child(allowed, victim, newdir); }

    var st[8];
    kv_waitpid(pid, &st, 0);
    var code = (load64(&st) >> 8) & 255;

    if (code == 3) {
        assert_eq(1, 1, "landlock unavailable on this kernel — mutation test inconclusive");
    } else {
        assert_eq(code, 0,
          "a confined child cannot unlink or mkdir OUTSIDE its allowed path (1=unlink, 2=mkdir)");
        # And the proof is on disk, not just in an exit code.
        assert_eq(file_exists(victim), 1, "the victim file survived the confined child");
    }

    sys_unlink(victim);
    sys_rmdir(newdir);
    sys_rmdir(allowed);
    return 0;
}

# ================================================================
# SandboxConfig.externalization (3.11.2)
# ================================================================
#
# Reported by agnosai: the Rust kavach lets a caller attach an
# ExternalizationPolicy to a config, and the Cyrius struct had no such field, so
# `build_config`'s unconditional `.externalization(...)` had no counterpart.
#
# The struct grew 72 -> 80 bytes, so the ABI-safety half matters as much as the
# feature: every pre-existing field must still round-trip.

fn test_config_externalization_defaults_off() {
    test_group("config_externalization_defaults_off");
    var c = config_new();
    # **0, not ext_policy_default().** Defaulting to an active policy would
    # start scanning output for every consumer that never asked for it.
    assert_eq(SandboxConfig_externalization(c), 0,
      "a fresh config carries NO externalization policy — behaviour is unchanged for existing callers");
    return 0;
}

fn test_config_externalization_round_trips() {
    test_group("config_externalization_round_trips");
    var c = config_new();
    var p = ext_policy_default();
    config_externalization(c, p);
    assert_eq(SandboxConfig_externalization(c), p, "the policy is stored");
    assert_eq(ExternalizationPolicy_block_threshold(SandboxConfig_externalization(c)),
      Severity.CRITICAL, "...and reads back intact");

    # A stricter policy is distinguishable from the default — the whole point is
    # that two sandboxes under different trust levels no longer look identical.
    var strict = alloc(EXT_POLICY_SIZE);
    ExternalizationPolicy_set_enabled(strict, 1);
    ExternalizationPolicy_set_max_artifact_size_bytes(strict, 1048576);
    ExternalizationPolicy_set_block_threshold(strict, Severity.MEDIUM);
    var c2 = config_new();
    config_externalization(c2, strict);
    assert_eq(ExternalizationPolicy_block_threshold(SandboxConfig_externalization(c2)),
      Severity.MEDIUM, "a per-sandbox policy is carried distinctly");
    assert_eq(ExternalizationPolicy_block_threshold(SandboxConfig_externalization(c)),
      Severity.CRITICAL, "...without disturbing the other config");
    return 0;
}

fn test_config_struct_growth_is_abi_safe() {
    test_group("config_struct_growth_is_abi_safe");
    # 72 -> 80. Every field is read at a fixed offset, so all nine originals
    # must still round-trip after the tenth was appended.
    var c = config_new();
    config_backend(c, KavachBackend.OCI);
    config_policy(c, policy_strict());
    config_timeout_ms(c, 12345);
    config_inner_backend(c, KavachBackend.WASM);
    config_agent_id(c, "agent-abc");
    config_hostname(c, "host1");
    config_domainname(c, "dom1");
    config_workdir(c, "/w");
    config_rootfs(c, "/r");
    config_externalization(c, ext_policy_default());

    assert_eq(SandboxConfig_backend(c), KavachBackend.OCI, "growth: backend intact");
    assert_eq(SandboxConfig_timeout_ms(c), 12345, "growth: timeout_ms intact");
    assert_eq(SandboxConfig_inner_backend(c), KavachBackend.WASM, "growth: inner_backend intact");
    assert_eq(SandboxPolicy_seccomp_enabled(SandboxConfig_policy(c)), 1, "growth: policy intact");
    assert_eq(str_eq_cstr(str_from(SandboxConfig_agent_id(c)), "agent-abc"), 1, "growth: agent_id intact");
    assert_eq(str_eq_cstr(str_from(SandboxConfig_hostname(c)), "host1"), 1, "growth: hostname intact");
    assert_eq(str_eq_cstr(str_from(SandboxConfig_domainname(c)), "dom1"), 1, "growth: domainname intact");
    assert_eq(str_eq_cstr(str_from(SandboxConfig_workdir(c)), "/w"), 1, "growth: workdir intact");
    assert_eq(str_eq_cstr(str_from(SandboxConfig_rootfs(c)), "/r"), 1, "growth: rootfs intact");
    assert_eq(SandboxConfig_externalization(c) != 0, 1, "growth: the new field holds");
    return 0;
}

# --- 3.11.3: confinement without a rootfs ---------------------------------

# Whether the payload could read a file outside any allowed path.
#
# `/bin/cat` of a scratch file the test writes itself: the externalization gate
# has nothing to say about it, so what comes back reflects access control and
# not output scanning. Pointing this at /etc/passwd instead is how the bug hid
# — the read SUCCEEDS and the gate then quarantines the output, so the call
# returns null and looks confined.
fn _t_conf_probe_path() {
    return "/tmp/kavach-confine-probe.txt";
}

fn _t_conf_write_probe() {
    var body = "OUTSIDE-THE-SANDBOX\n";
    file_write_all(_t_conf_probe_path(), body, strlen(body));
    return 0;
}

# Run `/bin/cat <probe>` under `policy`, returning its captured output.
#
# **Returns the text, not a byte count.** The capture merges the payload's
# stderr into the same buffer, so a denied read still produces output - `cat`'s
# own "Permission denied". Counting bytes reads that as a successful read; only
# the file's CONTENT distinguishes the two.
fn _t_conf_read_bytes(policy) {
    var c = config_new();
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy);
    var s = sandbox_create(c);
    if (s == 0) { return 0 - 1; }
    sandbox_transition(s, SandboxState.RUNNING);
    var cmd = str_cat(str_from("/bin/cat "), str_from(_t_conf_probe_path()));
    var r = sandbox_exec(s, str_cstr(cmd));
    sandbox_destroy(s);
    if (r == 0) { return str_from(""); }
    return str_from(ExecResult_stdout(r));
}

fn test_policy_wants_confinement() {
    test_group("policy_wants_confinement");
    assert_eq(policy_wants_confinement(0), 0, "a null policy asks for nothing");
    assert_eq(policy_wants_confinement(policy_minimal()), 0,
      "a minimal policy asks for nothing");
    assert_eq(policy_wants_confinement(policy_basic()), 1,
      "seccomp_enabled means the confined path is required");
    assert_eq(policy_wants_confinement(policy_strict()), 1, "and strict does too");

    var p = policy_minimal();
    policy_landlock_add(p, "/tmp", FS_READ_ONLY);
    assert_eq(policy_wants_confinement(p), 1,
      "a landlock rule alone requires it, with no seccomp");

    # 3.13.2: a landlock scope asks for a ruleset as a rule does.
    var su = policy_minimal();
    SandboxPolicy_set_landlock_abstract_unix(su, 1);
    assert_eq(policy_wants_confinement(su), 1, "an abstract-unix scope alone requires it");
    var sg = policy_minimal();
    SandboxPolicy_set_landlock_signal(sg, 1);
    assert_eq(policy_wants_confinement(sg), 1, "and so does a signal scope alone");
    return 0;
}

fn test_landlock_rules_are_expressible() {
    test_group("landlock_rules_are_expressible");
    # Before 3.11.3 `landlock_rules_len` was a counter with no list behind it,
    # so no consumer could name a path and both presets shipped a count of 0.
    var p = policy_minimal();
    assert_eq(SandboxPolicy_landlock_rules_len(p), 0, "a fresh policy names no paths");
    assert_eq(policy_landlock_rules(p), 0, "...and carries no list");

    policy_landlock_add(p, "/opt/tool-data", FS_READ_ONLY);
    assert_eq(SandboxPolicy_landlock_rules_len(p), 1, "adding a rule counts it");
    assert_eq(vec_len(policy_landlock_rules(p)), 1, "...and stores it");

    var r0 = vec_get(policy_landlock_rules(p), 0);
    assert_eq(str_eq(str_from(security_fs_rule_path(r0)), str_from("/opt/tool-data")), 1,
      "...with its path");
    assert_eq(security_fs_rule_access(r0), FS_READ_ONLY, "...and its access mode");

    policy_landlock_add(p, "/var/scratch", FS_READ_WRITE);
    assert_eq(SandboxPolicy_landlock_rules_len(p), 2, "a second rule accumulates");
    assert_eq(vec_len(policy_landlock_rules(p)), 2, "...in the same list");

    # The count and the list must not drift — score_backend reads the count.
    assert_eq(SandboxPolicy_landlock_rules_len(p), vec_len(policy_landlock_rules(p)),
      "the counter matches the list it counts");

    # deny_all is a count with no rules: a ruleset permitting nothing, which is
    # NOT the same as naming no ruleset at all.
    var d = policy_minimal();
    policy_landlock_deny_all(d);
    assert_eq(SandboxPolicy_landlock_rules_len(d), 1, "deny_all requests a ruleset");
    assert_eq(vec_len(policy_landlock_rules(d)), 0, "...that allows no path");
    return 0;
}

fn test_seccomp_applies_without_a_rootfs() {
    test_group("seccomp_applies_without_a_rootfs");
    # **The 3.11.3 regression.** Until then `process_exec` reached the confined
    # capture only under `rootfs != 0`, so a policy with seccomp_enabled = 1
    # ran through a plain fork/exec and the flag did nothing. agnosai measured
    # a policy_strict() sandbox reading an arbitrary host file and reporting
    # success.
    _t_conf_write_probe();

    # Unconfined by request: the file is readable, which is what makes the
    # confined case below a real comparison rather than a broken command.
    # Baseline: if the probe command cannot run here at all, there is nothing
    # to compare against and the test says so rather than failing on the
    # environment.
    var open_out = _t_conf_read_bytes(policy_minimal());
    if (str_contains_cstr(open_out, "OUTSIDE-THE-SANDBOX") == 0) { return 0; }

    # A confining policy must now take the seam. It reaches confine_child,
    # which installs seccomp; the read either succeeds under a permissive
    # filter or is denied, but it must NOT be the plain host exec.
    var confined_out = _t_conf_read_bytes(policy_basic());
    assert_eq(confined_out != 0, 1, "a confining policy still returns a result");
    return 0;
}

fn test_landlock_denies_a_path_outside_its_rules() {
    test_group("landlock_denies_a_path_outside_its_rules");
    # The end-to-end property the rule API exists for: a policy allowing only
    # one subtree must not read outside it. This is the assertion agnosai's
    # ADR-006 gate needs.
    _t_conf_write_probe();

    # Same baseline guard as above.
    if (str_contains_cstr(_t_conf_read_bytes(policy_minimal()),
        "OUTSIDE-THE-SANDBOX") == 0) { return 0; }

    var p = policy_minimal();
    # Allow a directory that does NOT contain the probe file.
    policy_landlock_add(p, "/usr", FS_READ_ONLY);

    var out = _t_conf_read_bytes(p);
    # On a kernel without landlock, security_apply_landlock returns Ok(0) and
    # nothing is enforced - so this asserts only when landlock is present.
    if (security_landlock_abi_version() > 0) {
        assert_eq(str_contains_cstr(out, "OUTSIDE-THE-SANDBOX"), 0,
          "a payload confined to /usr cannot read /tmp - landlock rules are APPLIED");
        # **Not "and cat explains why".** That asserts HOW the denial manifests,
        # which depends on the payload reaching `execve` at all — in a
        # restricted container it may exit earlier, with no output. The security
        # property is that the content does not come back; the manifestation is
        # the environment's business.
    }
    return 0;
}

# --- merge_policies and the landlock rules ---------------------------------
#
# Through 3.13.0 `merge_policies` summed the two counts and carried no list. A
# count over no list is deny-all, so a merge with a rule on either side denied
# the payload every path: `/bin/cat` read a file under the base policy and
# exited 127, unable to load, under its merge with a one-rule overlay. The
# composite guide documents a union.

# The length of `p`'s landlock list, 0 when it carries none. `vec_len` of a null
# list faults, and the old merge carried none.
fn _t_ll_len(p) {
    var rules = policy_landlock_rules(p);
    if (rules == 0) { return 0; }
    return vec_len(rules);
}

# Whether `p`'s landlock list holds a rule for `path` with `access`.
fn _t_ll_has(p, path, access) {
    var rules = policy_landlock_rules(p);
    if (rules == 0) { return 0; }
    var i = 0;
    while (i < vec_len(rules)) {
        var r = vec_get(rules, i);
        if (streq(security_fs_rule_path(r), path) == 1 && security_fs_rule_access(r) == access) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Whether `p` is deny-all in the form `policy_landlock_deny_all` gives it: an
# empty list and a count of one.
fn _t_ll_deny_all_form(p) {
    if (_t_ll_len(p) != 0) { return 0; }
    if (SandboxPolicy_landlock_rules_len(p) != 1) { return 0; }
    return 1;
}

# `<root>/<name>`, or with `file` 1 the probe inside it.
fn _t_merge_path(root, name, file) {
    var s = str_cat(str_from(root), str_from("/"));
    s = str_cat(s, str_from(name));
    if (file == 1) { s = str_cat(s, str_from("/probe.txt")); }
    return str_cstr(s);
}

# Create (`make` 1) or remove the probe directory `<root>/<name>` and its file.
fn _t_merge_probe(root, name, make) {
    var dir = _t_merge_path(root, name, 0);
    var file = _t_merge_path(root, name, 1);
    if (make == 0) {
        kv_unlink(file);
        return kv_rmdir(dir);
    }
    kv_mkdir(dir, 493);                                    # 0755
    var body = "MERGE-PROBE-CONTENT\n";
    return file_write_all(file, body, strlen(body));
}

# A fresh root holding three probe directories: `base` and `overlay`, for the
# two inputs' rules, and `neither`.
fn _t_merge_probes() {
    var root = _t_unique_tmp_path("/tmp/kavach-t-merge-");
    kv_mkdir(root, 493);                                   # 0755
    _t_merge_probe(root, "base", 1);
    _t_merge_probe(root, "overlay", 1);
    _t_merge_probe(root, "neither", 1);
    return root;
}

fn _t_merge_probes_remove(root) {
    _t_merge_probe(root, "base", 0);
    _t_merge_probe(root, "overlay", 0);
    _t_merge_probe(root, "neither", 0);
    return kv_rmdir(root);
}

# A policy allowing what `/bin/cat` needs to load: `/usr`, and `/bin`, `/lib`
# and `/lib64` where they exist. A rule on a missing path fails the exec closed.
fn _t_merge_runtime() {
    return _t_ll_add_runtime(policy_minimal());
}

# Add those rules to `p`, and return it.
fn _t_ll_add_runtime(p) {
    policy_landlock_add(p, "/usr", FS_READ_ONLY);
    if (file_exists("/bin") == 1) { policy_landlock_add(p, "/bin", FS_READ_ONLY); }
    if (file_exists("/lib") == 1) { policy_landlock_add(p, "/lib", FS_READ_ONLY); }
    if (file_exists("/lib64") == 1) { policy_landlock_add(p, "/lib64", FS_READ_ONLY); }
    return p;
}

# Whether `/bin/cat <root>/<name>/probe.txt` on the PROCESS backend prints the
# probe. With `inner` 0 it runs under `policy` through `sandbox_exec`;
# otherwise `composite_exec` merges `policy`, the sandbox's own, with `inner`.
fn _t_merge_reads(policy, inner, root, name) {
    var c = config_new();
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy);
    var s = sandbox_create(c);
    if (s == 0) { return 0; }
    sandbox_transition(s, SandboxState.RUNNING);
    var cmd = str_cstr(str_cat(str_from("/bin/cat "), str_from(_t_merge_path(root, name, 1))));
    var r = 0;
    if (inner == 0) { r = sandbox_exec(s, cmd); }
    else { r = composite_exec(KavachBackend.PROCESS, KavachBackend.PROCESS, s, cmd, inner); }
    sandbox_destroy(s);
    if (r == 0) { return 0; }
    return str_contains_cstr(str_from(ExecResult_stdout(r)), "MERGE-PROBE-CONTENT");
}

fn test_composite_merge_carries_landlock_rules() {
    test_group("composite_merge_carries_landlock_rules");
    var a = policy_minimal();
    policy_landlock_add(a, "/srv/base", FS_READ_ONLY);
    policy_landlock_add(a, "/usr", FS_READ_ONLY);
    var b = policy_minimal();
    policy_landlock_add(b, "/srv/overlay", FS_READ_WRITE);

    var m = merge_policies(a, b);
    assert_eq(_t_ll_len(m), 3, "the merged list holds both inputs' rules");
    assert_eq(SandboxPolicy_landlock_rules_len(m), 3, "...and the count is its length");
    assert_eq(_t_ll_has(m, "/srv/base", FS_READ_ONLY), 1, "base's rules, each with its access");
    assert_eq(_t_ll_has(m, "/usr", FS_READ_ONLY), 1, "...both of them");
    assert_eq(_t_ll_has(m, "/srv/overlay", FS_READ_WRITE), 1, "overlay's rule, still read-write");

    # A fresh list. Neither input changes, now or through a later add on the
    # merge; and an add on an input does not reach the merge.
    assert(policy_landlock_rules(m) != policy_landlock_rules(a), "not base's list");
    assert(policy_landlock_rules(m) != policy_landlock_rules(b), "not overlay's list");
    assert(_t_ll_len(a) == 2 && SandboxPolicy_landlock_rules_len(a) == 2
      && _t_ll_len(b) == 1 && SandboxPolicy_landlock_rules_len(b) == 1, "neither input changed");
    policy_landlock_add(m, "/var/tmp", FS_READ_ONLY);
    assert_eq(_t_ll_len(a), 2, "a rule added to the merge does not reach base");
    assert_eq(_t_ll_len(b), 1, "...nor overlay");
    policy_landlock_add(a, "/opt", FS_READ_ONLY);
    assert_eq(_t_ll_len(m), 4, "and one added to base does not reach the merge");

    # A side with no landlock contributes nothing. With neither, the merge has
    # no ruleset and no list, like a fresh policy.
    var one = merge_policies(policy_strict(), b);
    assert_eq(SandboxPolicy_landlock_rules_len(one), 1, "one side's rules alone carry over");
    assert_eq(_t_ll_has(one, "/srv/overlay", FS_READ_WRITE), 1, "...intact");
    var none = merge_policies(policy_basic(), policy_strict());
    assert_eq(SandboxPolicy_landlock_rules_len(none), 0, "no rules on either side, no ruleset");
    assert_eq(policy_landlock_rules(none), 0, "...and no list");

    # An input contributes the rules it applies. `confine_child` walks the first
    # `landlock_rules_len`, so a count set below the list leaves the rest out.
    var low = policy_minimal();
    policy_landlock_add(low, "/srv/applied", FS_READ_ONLY);
    policy_landlock_add(low, "/srv/unapplied", FS_READ_ONLY);
    SandboxPolicy_set_landlock_rules_len(low, 1);
    var lm = merge_policies(low, b);
    assert_eq(_t_ll_has(lm, "/srv/applied", FS_READ_ONLY), 1, "a lowered count keeps what it applies");
    assert_eq(_t_ll_has(lm, "/srv/unapplied", FS_READ_ONLY), 0, "...and not the rule it does not");
    return 0;
}

fn test_composite_merge_allows_either_sides_paths() {
    test_group("composite_merge_allows_either_sides_paths");
    var root = _t_merge_probes();
    # Baseline, as in landlock_denies_a_path_outside_its_rules: if cat cannot
    # read the probe unconfined, there is nothing to compare against.
    if (_t_merge_reads(policy_minimal(), 0, root, "base") == 0) {
        _t_merge_probes_remove(root);
        return 0;
    }
    var base = _t_merge_runtime();
    policy_landlock_add(base, _t_merge_path(root, "base", 0), FS_READ_ONLY);
    var overlay = policy_minimal();
    policy_landlock_add(overlay, _t_merge_path(root, "overlay", 0), FS_READ_ONLY);

    var m = merge_policies(base, overlay);
    assert_eq(_t_merge_reads(m, 0, root, "base"), 1,
      "under the merge, cat reads a path only base allows");
    assert_eq(_t_merge_reads(m, 0, root, "overlay"), 1, "...and a path only overlay allows");
    assert_eq(_t_merge_reads(base, overlay, root, "base"), 1,
      "composite_exec, merging the sandbox's policy with the inner one, reads base's path");
    assert_eq(_t_merge_reads(base, overlay, root, "overlay"), 1, "...and the inner policy's");

    # Still confined. With no landlock in the kernel nothing is enforced, so
    # these assert only where it is present.
    if (security_landlock_abi_version() > 0) {
        assert_eq(_t_merge_reads(m, 0, root, "neither"), 0, "a path neither allows stays shut");
        assert_eq(_t_merge_reads(base, 0, root, "overlay"), 0,
          "and base alone cannot read overlay's path: the merge's read came from overlay's rule");
    }
    _t_merge_probes_remove(root);
    return 0;
}

fn test_composite_merge_deny_all_wins() {
    test_group("composite_merge_deny_all_wins");
    # A count above the list is how `policy_landlock_deny_all` asks for a
    # ruleset naming no path. The merge stays deny-all, in that same form,
    # whatever the other side allows.
    var a = policy_minimal();
    policy_landlock_add(a, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(a, "/usr", FS_READ_ONLY);
    var d = policy_minimal();
    policy_landlock_deny_all(d);

    var m = merge_policies(d, a);
    assert_eq(_t_ll_deny_all_form(m), 1, "deny-all merged with rules is deny-all");
    assert_eq(_t_ll_deny_all_form(merge_policies(a, d)), 1, "...in either order");
    assert_eq(_t_ll_deny_all_form(merge_policies(d, policy_strict())), 1,
      "...and with a side that has no landlock");
    assert_eq(_t_ll_deny_all_form(merge_policies(d, d)), 1, "...or another deny-all");

    # Any count above the list is deny-all: over a list that holds rules, which
    # through 3.13.0 is what `policy_landlock_deny_all` left on a policy with
    # rules, and with no list behind it.
    var dr = policy_minimal();
    policy_landlock_add(dr, "/srv/dr", FS_READ_ONLY);
    SandboxPolicy_set_landlock_rules_len(dr, 2);
    assert_eq(_t_ll_deny_all_form(merge_policies(a, dr)), 1,
      "a deny-all side with rules in its list still makes the merge deny-all");
    var bare = policy_minimal();
    SandboxPolicy_set_landlock_rules_len(bare, 2);
    assert_eq(_t_ll_deny_all_form(merge_policies(bare, a)), 1, "so does a count with no list");

    # The merge's empty list is its own, and a rule for the deny-all input is
    # refused, so nothing reaches the merge that way.
    assert(policy_landlock_rules(m) != policy_landlock_rules(d), "the merge's list is not the input's");
    assert_eq(policy_landlock_add(d, "/srv/a", FS_READ_ONLY), 0 - 1, "an add on the input is refused");
    assert_eq(_t_ll_deny_all_form(m), 1, "...and the merge still denies everything");

    var root = _t_merge_probes();
    if (_t_merge_reads(policy_minimal(), 0, root, "base") == 1) {
        var allow = _t_merge_runtime();
        policy_landlock_add(allow, _t_merge_path(root, "base", 0), FS_READ_ONLY);
        var deny = policy_minimal();
        policy_landlock_deny_all(deny);
        # The control: the same rules merged with a side that is not deny-all
        # read the probe, so a refusal below is the deny-all side's doing.
        assert_eq(_t_merge_reads(merge_policies(policy_minimal(), allow), 0, root, "base"), 1,
          "the rules merged with a plain policy read the probe");
        if (security_landlock_abi_version() > 0) {
            assert_eq(_t_merge_reads(merge_policies(deny, allow), 0, root, "base"), 0,
              "merged with deny-all they read nothing");
            assert_eq(_t_merge_reads(allow, deny, root, "base"), 0,
              "...and nothing through composite_exec either");
        }
    }
    _t_merge_probes_remove(root);
    return 0;
}

# --- policy_landlock_deny_all denies every path ----------------------------
#
# Through 3.13.0 `policy_landlock_deny_all` set the count to the list's length
# plus one and kept the list, and the child walked the list: a policy that named
# paths and was then made deny-all still permitted them. A later
# `policy_landlock_add` reset the count and so ended the deny-all. Merged, the
# same policy denied every path. Measured on 3.13.0 through `sandbox_exec` and a
# persistent guest: `/bin/cat` read a file its rules allowed in either order.

# `p` with the rules `/bin/cat` needs and a rule for `<root>/base`.
fn _t_da_allow(p, root) {
    _t_ll_add_runtime(p);
    policy_landlock_add(p, _t_merge_path(root, "base", 0), FS_READ_ONLY);
    return p;
}

# Whether `/bin/cat <root>/<name>/probe.txt`, run as a persistent guest confined
# by `policy`, prints the probe.
fn _t_da_persist_reads(policy, root, name) {
    var cmd = str_cstr(str_cat(str_from("/bin/cat "), str_from(_t_merge_path(root, name, 1))));
    var g = persistent_spawn_confined(cmd, policy);
    if (g == 0) { return 0; }
    sys_close(PersistentGuest_stdin_fd(g));
    var buf = alloc(256);
    var total = 0;
    var r = persistent_read(g, buf, 255);
    while (r > 0 && total < 255) {
        total = total + r;
        r = persistent_read(g, buf + total, 255 - total);
    }
    store8(buf + total, 0);
    var st[8];
    store64(&st, 0);
    kv_waitpid(PersistentGuest_pid(g), &st, 0);
    sys_close(PersistentGuest_stdout_fd(g));
    return cstr_contains(buf, "MERGE-PROBE-CONTENT");
}

fn test_landlock_deny_all_drops_the_rules() {
    test_group("landlock_deny_all_drops_the_rules");
    # Rules, then deny-all: the rules go, leaving the form a merge with a
    # deny-all side gives.
    var p = policy_minimal();
    policy_landlock_add(p, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(p, "/srv/b", FS_READ_WRITE);
    var held = policy_landlock_rules(p);
    assert_eq(policy_landlock_deny_all(p), 0, "deny_all on a policy with rules succeeds");
    assert_eq(_t_ll_deny_all_form(p), 1, "...and leaves an empty list and a count of one");
    assert_eq(policy_landlock_is_deny_all(p), 1, "...which reads as deny-all");
    assert_eq(policy_wants_confinement(p), 1, "...and still takes the confined path");
    assert(policy_landlock_rules(p) != held, "the list is a fresh one");
    assert_eq(vec_len(held), 2, "...so the list a caller held keeps its rules");

    # A rule after deny-all is refused, whether or not rules came before it.
    var q = policy_minimal();
    policy_landlock_deny_all(q);
    assert_eq(policy_landlock_add(q, "/srv/a", FS_READ_ONLY), 0 - 1, "an add after deny_all is refused");
    assert_eq(_t_ll_deny_all_form(q), 1, "...and the policy stays deny-all");
    assert_eq(policy_landlock_add(p, "/srv/c", FS_READ_ONLY), 0 - 1, "so is one after rules and deny_all");
    assert_eq(_t_ll_deny_all_form(p), 1, "...which stays deny-all too");

    # The merge reads the policy as the policy reads itself.
    assert_eq(_t_ll_deny_all_form(merge_policies(p, policy_minimal())), 1,
      "merged with a plain policy it is deny-all, as it is alone");

    # The predicate: a count above the list, however it was set.
    assert_eq(policy_landlock_is_deny_all(0), 0, "a null policy is not deny-all");
    assert_eq(policy_landlock_is_deny_all(policy_strict()), 0, "nor is one with no landlock");
    var r = policy_minimal();
    policy_landlock_add(r, "/srv/a", FS_READ_ONLY);
    policy_landlock_add(r, "/srv/b", FS_READ_ONLY);
    assert_eq(policy_landlock_is_deny_all(r), 0, "nor one with rules");
    SandboxPolicy_set_landlock_rules_len(r, 1);
    assert_eq(policy_landlock_is_deny_all(r), 0, "nor one whose count is below its list");
    SandboxPolicy_set_landlock_rules_len(r, 3);
    assert_eq(policy_landlock_is_deny_all(r), 1, "a count above the list is deny-all");
    assert_eq(policy_landlock_add(r, "/srv/c", FS_READ_ONLY), 0 - 1, "...so an add is refused");
    assert_eq(_t_ll_len(r), 2, "...and the list is left as it was");
    var bare = policy_minimal();
    SandboxPolicy_set_landlock_rules_len(bare, 1);
    assert_eq(policy_landlock_is_deny_all(bare), 1, "so is a count with no list");
    return 0;
}

fn test_landlock_deny_all_denies_the_rules_paths() {
    test_group("landlock_deny_all_denies_the_rules_paths");
    var root = _t_merge_probes();
    # Baseline, as in landlock_denies_a_path_outside_its_rules.
    if (_t_merge_reads(policy_minimal(), 0, root, "base") == 0) {
        _t_merge_probes_remove(root);
        return 0;
    }
    # The control: these rules let cat read the probe, on both paths.
    var allow = _t_da_allow(policy_minimal(), root);
    assert_eq(_t_merge_reads(allow, 0, root, "base"), 1, "the rules alone read the probe");
    assert_eq(_t_da_persist_reads(allow, root, "base"), 1, "...and as a persistent guest");

    var rules_first = _t_da_allow(policy_minimal(), root);
    policy_landlock_deny_all(rules_first);
    var deny_first = policy_minimal();
    policy_landlock_deny_all(deny_first);
    _t_da_allow(deny_first, root);
    # With no landlock in the kernel nothing is enforced, so these assert only
    # where it is present.
    if (security_landlock_abi_version() > 0) {
        assert_eq(_t_merge_reads(rules_first, 0, root, "base"), 0,
          "rules, then deny_all: sandbox_exec reads nothing - the rules are not applied");
        assert_eq(_t_merge_reads(deny_first, 0, root, "base"), 0, "deny_all, then rules: the same");
        assert_eq(_t_da_persist_reads(rules_first, root, "base"), 0,
          "a persistent guest reads nothing either");
        assert_eq(_t_da_persist_reads(deny_first, root, "base"), 0, "...in either order");
        assert_eq(_t_merge_reads(merge_policies(rules_first, policy_minimal()), 0, root, "base"), 0,
          "and merged, as alone, it reads nothing");
    }
    _t_merge_probes_remove(root);
    return 0;
}

fn test_landlock_count_above_the_list_denies_all() {
    test_group("landlock_count_above_the_list_denies_all");
    # A count above a list that holds rules, set through the raw accessor. The
    # merge has read that as deny-all since its fix; the child now does too,
    # where through 3.13.0 it applied every rule in the list.
    var root = _t_merge_probes();
    var p = _t_da_allow(policy_minimal(), root);
    var n = _t_ll_len(p);
    SandboxPolicy_set_landlock_rules_len(p, n + 1);
    # First, while the policy is exactly that. The add below would, through
    # 3.13.0, have changed it.
    if (_t_merge_reads(policy_minimal(), 0, root, "base") == 1) {
        if (security_landlock_abi_version() > 0) {
            assert_eq(_t_merge_reads(p, 0, root, "base"), 0,
              "sandbox_exec applies none of the list's rules");
            assert_eq(_t_da_persist_reads(p, root, "base"), 0, "...and neither does a persistent guest");
        }
    }
    assert_eq(_t_ll_deny_all_form(merge_policies(p, policy_minimal())), 1, "merged, it is deny-all");
    assert_eq(policy_landlock_add(p, "/srv/x", FS_READ_ONLY), 0 - 1, "an add is refused");
    assert_eq(_t_ll_len(p), n, "...and the list is left as it was");
    _t_merge_probes_remove(root);
    return 0;
}

# --- a landlock rule naming a file -----------------------------------------
#
# Through 3.13.0 `security_apply_landlock` gave a rule naming a file the same
# rights as one naming a directory, READ_DIR and the MAKE_* and REMOVE_* rights
# among them, and `landlock_add_rule` refuses those on a file with EINVAL. So a
# policy naming a file failed every exec closed: `/bin/cat` of the very file its
# rule named exited 124 (SPAWN_EXIT_LANDLOCK) through `sandbox_exec`, and a rule
# on the file's directory read it.

# `<root>/<name>`.
fn _t_fr_path(root, name) {
    return str_cstr(str_cat(str_cat(str_from(root), str_from("/")), str_from(name)));
}

# `cmd` through `sandbox_exec` on the PROCESS backend under `policy`.
fn _t_fr_exec(policy, cmd) {
    var c = config_new();
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy);
    var s = sandbox_create(c);
    if (s == 0) { return 0; }
    sandbox_transition(s, SandboxState.RUNNING);
    var r = sandbox_exec(s, cmd);
    sandbox_destroy(s);
    return r;
}

# Whether `/bin/cat <path>` under `policy` prints `marker`.
fn _t_fr_reads(policy, path, marker) {
    var r = _t_fr_exec(policy, str_cstr(str_cat(str_from("/bin/cat "), str_from(path))));
    if (r == 0) { return 0; }
    return cstr_contains(ExecResult_stdout(r), marker);
}

# `/bin/cp <src> <dst>`.
fn _t_fr_cp(src, dst) {
    var s = str_cat(str_from("/bin/cp "), str_from(src));
    s = str_cat(str_cat(s, str_from(" ")), str_from(dst));
    return str_cstr(s);
}

# Whether the file at `path` holds `marker`.
fn _t_fr_holds(path, marker) {
    var buf = alloc(256);
    var n = 0;
    var fd = file_open(path, O_RDONLY, 0);
    if (fd >= 0) {
        n = sys_read(fd, buf, 255);
        sys_close(fd);
    }
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    return cstr_contains(buf, marker);
}

fn test_landlock_rule_on_a_file_allows_reading_it() {
    test_group("landlock_rule_on_a_file_allows_reading_it");
    var root = _t_unique_tmp_path("/tmp/kavach-t-frule-");
    kv_mkdir(root, 493);                                   # 0755
    var f = _t_fr_path(root, "named.txt");
    var sib = _t_fr_path(root, "sibling.txt");
    file_write_all(f, "FILE-RULE-NAMED\n", 16);
    file_write_all(sib, "FILE-RULE-SIBLING\n", 18);
    # Baseline, as in landlock_denies_a_path_outside_its_rules.
    if (_t_fr_reads(policy_minimal(), f, "FILE-RULE-NAMED") == 1) {
        var p = _t_ll_add_runtime(policy_minimal());
        policy_landlock_add(p, f, FS_READ_ONLY);
        # With no landlock in the kernel nothing is enforced, and cat reads
        # either way, so these assert only where it is present.
        if (security_landlock_abi_version() > 0) {
            var r = _t_fr_exec(p, str_cstr(str_cat(str_from("/bin/cat "), str_from(f))));
            assert(r != 0, "a result");
            if (r != 0) {
                assert_eq(ExecResult_exit_code(r), 0, "a read-only rule naming a file lets the exec run");
                assert_eq(cstr_contains(ExecResult_stdout(r), "FILE-RULE-NAMED"), 1, "...and read that file");
            }
            assert_eq(_t_fr_reads(p, sib, "FILE-RULE-SIBLING"), 0,
              "the rule is that file alone: a file beside it stays shut");
        }
    }
    kv_unlink(f);
    kv_unlink(sib);
    kv_rmdir(root);
    return 0;
}

fn test_landlock_rw_rule_on_a_file_allows_writing_it() {
    test_group("landlock_rw_rule_on_a_file_allows_writing_it");
    var root = _t_unique_tmp_path("/tmp/kavach-t-frule-");
    kv_mkdir(root, 493);                                   # 0755
    var src = _t_fr_path(root, "src.txt");
    var dst = _t_fr_path(root, "dst.txt");
    var created = _t_fr_path(root, "created.txt");
    file_write_all(src, "FILE-RULE-COPIED\n", 17);
    file_write_all(dst, "FILE-RULE-ORIGINAL\n", 19);
    var cp = _t_fr_cp(src, dst);
    if (security_landlock_abi_version() > 0) {
        # cp opens the destination to write and truncate it: WRITE_FILE, and
        # TRUNCATE from ABI v3, both of which a read-write rule on a file holds.
        var p = _t_ll_add_runtime(policy_minimal());
        policy_landlock_add(p, src, FS_READ_ONLY);
        policy_landlock_add(p, dst, FS_READ_WRITE);
        var r = _t_fr_exec(p, cp);
        assert(r != 0, "a result");
        if (r != 0) {
            assert_eq(ExecResult_exit_code(r), 0, "a read-write rule naming a file lets cp write it");
        }
        assert_eq(_t_fr_holds(dst, "FILE-RULE-COPIED"), 1, "...and the file holds what was written");

        # Read-only, the same file is not writable.
        file_write_all(dst, "FILE-RULE-ORIGINAL\n", 19);
        var q = _t_ll_add_runtime(policy_minimal());
        policy_landlock_add(q, src, FS_READ_ONLY);
        policy_landlock_add(q, dst, FS_READ_ONLY);
        var rq = _t_fr_exec(q, cp);
        assert(rq != 0 && ExecResult_exit_code(rq) != 0, "under a read-only rule cp fails");
        assert_eq(_t_fr_holds(dst, "FILE-RULE-ORIGINAL"), 1, "...and the file is unchanged");

        # A file rule does not reach the file's directory: creating a file
        # beside it takes a rule on the directory.
        var rc = _t_fr_exec(p, _t_fr_cp(src, created));
        assert(rc != 0 && ExecResult_exit_code(rc) != 0, "a read-write rule on a file cannot create one beside it");
        assert_eq(file_exists(created), 0, "...and none was created");
        # A rule on the directory keeps the directory rights: the file-only mask
        # applies to a rule that names a file, and to no other.
        var dirp = _t_ll_add_runtime(policy_minimal());
        policy_landlock_add(dirp, root, FS_READ_WRITE);
        var rdir = _t_fr_exec(dirp, _t_fr_cp(src, created));
        assert(rdir != 0 && ExecResult_exit_code(rdir) == 0, "a read-write rule on the directory can create it");
        assert_eq(_t_fr_holds(created, "FILE-RULE-COPIED"), 1, "...with the copy in it");
    }
    kv_unlink(created);
    kv_unlink(src);
    kv_unlink(dst);
    kv_rmdir(root);
    return 0;
}

# --- 3.11.4: the deadline and the exit code -------------------------------

fn _t_tmo_run(cmd, ms, pol) {
    var c = config_new();
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    if (pol != 0) { SandboxConfig_set_policy(c, pol); }
    config_timeout_ms(c, ms);
    var s = sandbox_create(c);
    if (s == 0) { return 0; }
    sandbox_transition(s, SandboxState.RUNNING);
    var r = sandbox_exec(s, cmd);
    sandbox_destroy(s);
    return r;
}

fn test_timeout_ms_is_enforced() {
    test_group("timeout_ms_is_enforced");
    # **Measured against 3.11.2**: a 1000 ms deadline ran `/bin/sleep 8` for
    # 8001 ms and reported timed_out = 0. The field was accepted, stored,
    # scored, and read by `wasm_exec` alone.
    var t0 = mono_now_ns() / 1000000;
    var r = _t_tmo_run("/bin/sleep 8", 1000, policy_minimal());
    var dt = mono_now_ns() / 1000000 - t0;
    if (r == 0) { return 0; }

    assert_eq(ExecResult_timed_out(r), 1, "a payload past its deadline is killed");
    var prompt = 0;
    if (dt < 5000) { prompt = 1; }
    assert_eq(prompt, 1, "...promptly, not after the payload finishes on its own");
    return 0;
}

fn test_timeout_does_not_truncate_fast_payloads() {
    test_group("timeout_does_not_truncate");
    var r = _t_tmo_run("/bin/echo within-budget", 30000, policy_minimal());
    if (r == 0) { return 0; }
    assert_eq(ExecResult_timed_out(r), 0, "a payload inside its deadline is not a timeout");
    assert_eq(str_contains_cstr(str_from(ExecResult_stdout(r)), "within-budget"), 1,
      "...and its output is not truncated by the poll loop");
    assert_eq(ExecResult_exit_code(r), 0, "...and its exit code is its own");
    return 0;
}

fn test_process_backend_reports_the_real_exit_code() {
    test_group("process_reports_real_exit_code");
    # **Measured against 3.11.2**: `backend_capture_finish` hardcoded
    # exit_code = 0, and `exec_capture` discarded the wait status, so
    # /bin/false (real exit 1) and /bin/ls on a missing path (real exit 2)
    # both came back 0. An unconfined policy took that path.
    var f = _t_tmo_run("/bin/false", 30000, policy_minimal());
    if (f == 0) { return 0; }
    var nonzero = 0;
    if (ExecResult_exit_code(f) != 0) { nonzero = 1; }
    assert_eq(nonzero, 1, "/bin/false reports a NON-ZERO exit through an unconfined policy");

    var t = _t_tmo_run("/bin/true", 30000, policy_minimal());
    if (t != 0) {
        assert_eq(ExecResult_exit_code(t), 0, "...and /bin/true still reports 0");
    }

    # And the confining path, which has reported it since 3.11.3.
    var cf = _t_tmo_run("/bin/false", 30000, policy_basic());
    if (cf != 0) {
        var cnz = 0;
        if (ExecResult_exit_code(cf) != 0) { cnz = 1; }
        assert_eq(cnz, 1, "a CONFINING policy reports it too - one capture, no drift");
    }
    return 0;
}

# --- 3.11.5: stderr and opt-in namespaces ---------------------------------

fn test_stderr_is_its_own_stream() {
    test_group("stderr_is_its_own_stream");
    # **`ExecResult.stderr` was always ""** — both fds went to one pipe and
    # `backend_capture_finish` hardcoded the field empty, so a caller was told
    # the payload wrote nothing to stderr rather than that kavach did not keep
    # it. Two pipes now, drained round-robin.
    var r = _t_tmo_run("/bin/sh -c", 30000, policy_minimal());
    # The runtime guard blocks `sh`, so drive a binary that writes to stderr
    # without one: `ls` on a missing path.
    var e = _t_tmo_run("/bin/ls /nonexistent-kavach-probe", 30000, policy_minimal());
    if (e == 0) { return 0; }

    var err = str_from(ExecResult_stderr(e));
    var got = 0;
    if (str_len(err) > 0) { got = 1; }
    assert_eq(got, 1, "a payload's stderr is captured, not discarded");
    assert_eq(str_contains_cstr(err, "nonexistent-kavach-probe"), 1,
      "...and it is the payload's own message");
    assert_eq(str_contains_cstr(str_from(ExecResult_stdout(e)), "nonexistent-kavach-probe"), 0,
      "...on its own stream, not merged into stdout");

    var nonzero = 0;
    if (ExecResult_exit_code(e) != 0) { nonzero = 1; }
    assert_eq(nonzero, 1, "...alongside the real exit code");
    return 0;
}

fn test_stdout_and_stderr_both_large_do_not_deadlock() {
    test_group("both_streams_large");
    # **Small stdout, huge stderr** — that is the shape that deadlocks a
    # drain-stdout-to-EOF-first loop: the parent waits for a stdout EOF that
    # never comes, because the payload is blocked writing to a stderr pipe
    # nobody is reading. A stream past its buffer is
    # `test_capture_ends_a_full_stream`'s case.
    #
    # The runtime guard blocks a bare `sh`, so the payload is a script run by
    # its own absolute path.
    var _body_sb = str_builder_new();
    str_builder_add_cstr(_body_sb, "#!/bin/sh\necho stdout-marker\n");
    str_builder_add_cstr(_body_sb, "awk 'BEGIN{for(i=0;i<6000;i++) print \"stderr-padding-line\"}' >&2\n");
    str_builder_add_cstr(_body_sb, "echo stdout-done\n");
    var body = str_data(str_builder_build(_body_sb));
    file_write_all("/tmp/kavach-both-streams.sh", body, strlen(body));
    sys_chmod("/tmp/kavach-both-streams.sh", 493);

    var r = _t_tmo_run("/tmp/kavach-both-streams.sh", 30000, policy_minimal());
    if (r == 0) { return 0; }

    var out = str_from(ExecResult_stdout(r));
    var err = str_from(ExecResult_stderr(r));
    # **A silent skip here would hide the deadlock this test exists for**, so
    # the flood is asserted rather than assumed. If the environment cannot run
    # the payload at all, both streams are empty and there is nothing to check.
    if (str_len(out) == 0 && str_len(err) == 0) { return 0; }
    var flooded = 0;
    if (str_len(err) > 65000) { flooded = 1; }
    assert_eq(flooded, 1,
      "the probe really did fill the stderr pipe past 64 KiB - without that the \
drain order cannot deadlock and this test proves nothing");

    assert_eq(str_contains_cstr(out, "stdout-marker"), 1,
      "stdout is captured while stderr floods");
    assert_eq(str_contains_cstr(out, "stdout-done"), 1,
      "...including what the payload wrote AFTER the flood - it was never blocked");
    assert_eq(str_contains_cstr(err, "stderr-padding-line"), 1, "...and stderr with it");
    assert_eq(ExecResult_timed_out(r), 0,
      "...without the drain deadlocking into its own deadline");
    return 0;
}

fn test_require_namespaces_is_opt_in() {
    test_group("require_namespaces_opt_in");
    var c = config_new();
    assert_eq(SandboxConfig_require_ns(c), 0,
      "a fresh config does NOT require namespaces - applying them unconditionally \
breaks payloads on hosts that restrict unprivileged user namespaces");

    config_require_namespaces(c, 1);
    assert_eq(SandboxConfig_require_ns(c), 1, "...and a caller can ask for them");

    # Opting in must be a real request, not a stored flag: with it set and no
    # rootfs, the payload either runs inside namespaces or fails closed.
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy_basic());
    config_timeout_ms(c, 30000);
    var s = sandbox_create(c);
    if (s == 0) { return 0; }
    sandbox_transition(s, SandboxState.RUNNING);
    var r = sandbox_exec(s, "/usr/bin/id -u");
    sandbox_destroy(s);
    if (r == 0) { return 0; }

    var code = ExecResult_exit_code(r);
    var out = str_from(ExecResult_stdout(r));
    # **`/bin/true` cannot tell the two outcomes apart** — it exits 0 whether or
    # not namespaces were created, so asserting on its code passes with the flag
    # ignored. `id -u` can: inside a new USER namespace the caller is mapped to
    # root and reports 0, outside it reports the real uid.
    #
    # So the acceptable outcomes are exactly two: it ran and saw uid 0, or it
    # was refused cleanly. Running as the real uid means the request was
    # silently dropped.
    if (code == 123 || code == 118) { return 0; }
    assert_eq(code, 0, "an opt-in namespace request either runs or fails closed");
    # **Not `contains "0"`** — the real uid 1000 contains a zero, so that
    # substring passed with the flag ignored. Exactly "0", plus its newline.
    var isroot = 0;
    if (str_len(out) <= 2 && str_len(out) > 0) {
        if (load8(str_data(out)) == 48) { isroot = 1; }
    }
    assert_eq(isroot, 1,
      "...and inside a user namespace the payload is uid 0 - the request was honoured, \
not stored and ignored");
    return 0;
}

# --- 3.11.6: namespaces on the persistent path ----------------------------

fn test_persistent_namespaces_are_opt_in_and_fail_closed() {
    test_group("persistent_namespaces");
    # **The persistent path applied landlock and seccomp and nothing else.** It
    # takes a SandboxPolicy, which carries `network_enabled`, and acted on none
    # of it — and `config_require_namespaces` (3.11.5) is a SandboxConfig field
    # that never reaches here. agnosai's cx tool sandbox uses this path, because
    # it is the only kavach API with a stdin channel, so a `.cyx` guest could
    # open a socket.
    var p = policy_basic();

    # Default: unchanged, no namespaces demanded.
    var g0 = persistent_spawn_confined("/usr/bin/id -u", p);
    if (g0 != 0) {
        sys_close(PersistentGuest_stdin_fd(g0));
        var b0 = alloc(256);
        var n0 = persistent_read(g0, b0, 255);
        var s0[8];
        store64(&s0, 0);
        kv_waitpid(PersistentGuest_pid(g0), &s0, 0);
        # policy_basic() asks for seccomp; a host that will not load a filter
        # must refuse the guest (qemu-user answers PR_SET_SECCOMP with EINVAL).
        var want0 = 0;
        if (_t_host_loads_seccomp() == 0) { want0 = 125; }
        assert_eq((load64(&s0) >> 8) & 255, want0,
          "the default path runs the guest, or refuses it on a host without seccomp");
    }

    # Opt in: the guest either runs INSIDE a user namespace - where it is
    # mapped to uid 0 - or is refused cleanly. Running as the real uid would
    # mean the request was stored and dropped, which is the bug.
    var g = persistent_spawn_confined_ns("/usr/bin/id -u", p, 1);
    if (g == 0) { return 0; }
    sys_close(PersistentGuest_stdin_fd(g));
    var buf = alloc(256);
    var n = persistent_read(g, buf, 255);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    var st[8];
    store64(&st, 0);
    kv_waitpid(PersistentGuest_pid(g), &st, 0);
    var code = (load64(&st) >> 8) & 255;

    if (code == 123 || code == 118) { return 0; }
    assert_eq(code, 0, "an opt-in namespace request either runs or fails closed");
    # Exactly "0", not `contains "0"` — the real uid 1000 contains a zero.
    var isroot = 0;
    if (n > 0 && load8(buf) == 48 && n <= 2) { isroot = 1; }
    assert_eq(isroot, 1,
      "...and inside a user namespace the guest is uid 0 - the policy's namespaces \
were APPLIED, not carried and ignored");
    return 0;
}

# --- 3.13.0: SGX and TDX quote verification ------------------------------
#
# The vectors, sigil's, are in tests/attest_vectors.cyr.


fn _t_att_bytes(hex, len) { return hex_decode(hex, 2 * len); }

fn _t_att_fill(n, byte) {
    var b = alloc(n);
    memset(b, byte, n);
    return b;
}

# A policy anchored on the fixture root that allows `measurement` (0 = none).
fn _t_att_policy(measurement) {
    var p = policy_new();
    policy_attest_root(p, _t_att_bytes(ATT_ROOT_HEX, ATT_ROOT_LEN), ATT_ROOT_LEN);
    if (measurement != 0) { policy_attest_allow(p, measurement); }
    return p;
}

# Null-safe, so an exec that stops before its check fails an assertion instead
# of crashing the suite.
fn _t_att_trust(r) {
    if (r == 0) { return 0 - 1; }
    return AttestationResult_trust(r);
}

fn _t_att_why(r, want) {
    if (r == 0) { return 0; }
    return streq(AttestationResult_details(r), want);
}

# Whether an ExecResult's stdout (fd 1) or stderr (fd 2) is `want`; 0 for none.
fn _t_att_out_is(r, fd, want) {
    if (r == 0) { return 0; }
    if (fd == 1) { return streq(ExecResult_stdout(r), want); }
    return streq(ExecResult_stderr(r), want);
}

fn _t_att_exit(r) {
    if (r == 0) { return 0 - 1; }
    return ExecResult_exit_code(r);
}

fn test_attest_sgx_accepts_the_fixture() {
    test_group("attest_sgx_accepts_the_fixture");
    var q = _t_att_bytes(ATT_SGX_HEX, ATT_SGX_LEN);
    var p = _t_att_policy(ATT_SGX_MRENCLAVE);
    var r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, _t_att_fill(32, 0xcc), 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_AFFIRMING, "a genuine quote with an allowed MRENCLAVE is affirmed");
    assert_eq(streq(AttestationResult_measurement_hex(r), ATT_SGX_MRENCLAVE), 1, "MRENCLAVE reported");
    assert_eq(streq(AttestationResult_signer_hex(r), ATT_SGX_MRSIGNER), 1, "MRSIGNER reported");
    assert_eq(AttestationResult_svn(r), 7, "ISVSVN reported");
    assert_eq(AttestationResult_fresh_at(r), ATT_NOW, "verification time reported");
    assert_eq(AttestationResult_backend(r), KavachBackend.SGX, "backend reported");
    assert_eq(kavach_attest_passes(r, p), 1, "an affirmed result passes");
    assert_eq(_t_att_why(r, ATTEST_PASSED), 1, "and says what was not evaluated");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, _t_att_fill(64, 0xcc), 64, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_AFFIRMING, "a 64-byte nonce covers all of the report data");
    var upper = _t_att_policy("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, upper, _t_att_fill(32, 0xcc), 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_AFFIRMING, "an upper-case allowlist entry is folded");
    r = kavach_attest_quote(KavachBackend.SGX, q, ATT_SGX_LEN, p, _t_att_fill(32, 0xcc), 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_AFFIRMING, "the dispatcher routes SGX");
    var pq = &_attest_parsed;
    assert_eq(_attest_sgx_debug(pq), 0, "the fixture enclave is not a debug enclave");
    return 0;
}

fn test_attest_sgx_rejects() {
    test_group("attest_sgx_rejects");
    var q = _t_att_bytes(ATT_SGX_HEX, ATT_SGX_LEN);
    var p = _t_att_policy(ATT_SGX_MRENCLAVE);
    var n32 = _t_att_fill(32, 0xcc);
    var wrong = policy_new();
    policy_attest_root(wrong, _t_att_bytes(ATT_WRONG_ROOT_HEX, ATT_WRONG_ROOT_LEN), ATT_WRONG_ROOT_LEN);
    policy_attest_allow(wrong, ATT_SGX_MRENCLAVE);
    var r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, wrong, n32, 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "an unrelated root is refused");
    assert_eq(_t_att_why(r, "the quote does not verify to the policy's root"), 1, "and says so");
    assert_eq(kavach_attest_passes(r, wrong), 0, "a contraindicated result does not pass");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, n32, 32, ATT_NOW_EARLY);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "before the certificates are valid");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, n32, 32, ATT_NOW_LATE);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "after the leaf expires");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, n32, 32, 0);
    assert_eq(_t_att_why(r, "no verification time"), 1, "time 0 would skip the validity dates, so it is refused");

    var t = alloc(ATT_SGX_LEN);
    memcpy(t, q, ATT_SGX_LEN);
    store8(t + 48 + 64, (load8(t + 48 + 64) & 0xFF) ^ 1);
    r = kavach_attest_sgx_quote(t, ATT_SGX_LEN, p, n32, 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "a changed MRENCLAVE breaks the signature");
    assert_eq(streq(AttestationResult_measurement_hex(r), ""), 1, "an unverified quote's measurement is not reported");
    var d = alloc(ATT_SGX_LEN);
    memcpy(d, q, ATT_SGX_LEN);
    store8(d + 48 + 48, load8(d + 48 + 48) | 2);
    r = kavach_attest_sgx_quote(d, ATT_SGX_LEN, p, n32, 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "setting DEBUG breaks the signature");
    assert_eq(_attest_sgx_debug(&_attest_parsed), 1, "the DEBUG bit is read from ATTRIBUTES");

    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, _t_att_policy(ATT_OTHER), n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "measurement not in the allowlist"), 1, "an MRENCLAVE off the allowlist is refused");
    assert_eq(streq(AttestationResult_measurement_hex(r), ATT_SGX_MRENCLAVE), 1, "and the verified MRENCLAVE is reported");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, _t_att_fill(32, 0xcd), 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the report data does not carry the nonce"), 1, "another exec's nonce is refused");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, _t_att_fill(65, 0xcc), 65, ATT_NOW);
    assert_eq(_t_att_why(r, "no nonce"), 1, "a nonce longer than the report data is refused");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, p, n32, 0, ATT_NOW);
    assert_eq(_t_att_why(r, "no nonce"), 1, "an empty nonce is refused");

    var noroot = policy_new();
    policy_attest_allow(noroot, ATT_SGX_MRENCLAVE);
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, noroot, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the policy names no root"), 1, "no root, no attestation");
    r = kavach_attest_sgx_quote(q, ATT_SGX_LEN, _t_att_policy(0), n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the policy allows no measurement"), 1, "no allowlist, no attestation");
    r = kavach_attest_sgx_quote(q, 100, p, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the quote does not parse"), 1, "a truncated quote is refused");
    r = kavach_attest_sgx_quote(_t_att_bytes(ATT_TDX_P256_HEX, ATT_TDX_P256_LEN), ATT_TDX_P256_LEN, p, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the quote does not parse"), 1, "a TDX quote is not an SGX quote");
    r = kavach_attest_quote(KavachBackend.PROCESS, q, ATT_SGX_LEN, p, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "this backend cannot attest"), 1, "the process backend has no quote format");
    return 0;
}

# The TDX fixtures are debug TDs, which is what the default policy refuses.
fn test_attest_tdx_fixtures() {
    test_group("attest_tdx_fixtures");
    var n32 = _t_att_fill(32, 0xcc);
    var q2 = _t_att_bytes(ATT_TDX_P256_HEX, ATT_TDX_P256_LEN);
    var q3 = _t_att_bytes(ATT_TDX_P384_HEX, ATT_TDX_P384_LEN);
    var p = _t_att_policy(ATT_TDX_MRTD);
    var r = kavach_attest_tdx_quote(q2, ATT_TDX_P256_LEN, p, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "debug guest"), 1, "a debug TD is refused by default");
    assert_eq(_attest_tdx_debug(&_attest_parsed), 1, "the DEBUG bit is read from TD_ATTRIBUTES");
    assert_eq(streq(AttestationResult_measurement_hex(r), ATT_TDX_MRTD), 1, "MRTD reported once verified");
    var dbg = _t_att_policy(ATT_TDX_MRTD);
    policy_attest_allow_debug(dbg, 1);
    r = kavach_attest_tdx_quote(q2, ATT_TDX_P256_LEN, dbg, n32, 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_WARNING, "an allowed debug TD is a warning, not affirmed (P-256)");
    assert_eq(kavach_attest_passes(r, dbg), 1, "and passes the policy that allowed it");
    assert_eq(_t_att_why(r, ATTEST_PASSED_DEBUG), 1, "saying the debug guest was allowed");
    assert_eq(kavach_attest_passes(r, p), 0, "but not one that did not");
    r = kavach_attest_tdx_quote(q3, ATT_TDX_P384_LEN, dbg, n32, 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_WARNING, "an allowed debug TD is a warning (P-384)");
    r = kavach_attest_quote(KavachBackend.TDX, q3, ATT_TDX_P384_LEN, dbg, n32, 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_WARNING, "the dispatcher routes TDX");

    var wrong = policy_new();
    policy_attest_root(wrong, _t_att_bytes(ATT_WRONG_ROOT_HEX, ATT_WRONG_ROOT_LEN), ATT_WRONG_ROOT_LEN);
    policy_attest_allow(wrong, ATT_TDX_MRTD);
    policy_attest_allow_debug(wrong, 1);
    r = kavach_attest_tdx_quote(q3, ATT_TDX_P384_LEN, wrong, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the quote does not verify to the policy's root"), 1, "an unrelated root is refused");
    var t = alloc(ATT_TDX_P384_LEN);
    memcpy(t, q3, ATT_TDX_P384_LEN);
    store8(t + 48 + 136, (load8(t + 48 + 136) & 0xFF) ^ 1);
    r = kavach_attest_tdx_quote(t, ATT_TDX_P384_LEN, dbg, n32, 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "a changed MRTD breaks the signature");
    var other = _t_att_policy(ATT_SGX_MRENCLAVE);
    policy_attest_allow_debug(other, 1);
    r = kavach_attest_tdx_quote(q2, ATT_TDX_P256_LEN, other, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "measurement not in the allowlist"), 1, "an MRTD off the allowlist is refused");
    r = kavach_attest_tdx_quote(q2, ATT_TDX_P256_LEN, dbg, _t_att_fill(32, 0), 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the report data does not carry the nonce"), 1, "another exec's nonce is refused");
    r = kavach_attest_tdx_quote(_t_att_bytes(ATT_SGX_HEX, ATT_SGX_LEN), ATT_SGX_LEN, dbg, n32, 32, ATT_NOW);
    assert_eq(_t_att_why(r, "the quote does not parse"), 1, "an SGX quote is not a TDX quote");
    return 0;
}

fn test_attest_policy_fields() {
    test_group("attest_policy_fields");
    var p = policy_new();
    assert_eq(policy_wants_attestation(p), 0, "a new policy does not require attestation");
    assert_eq(policy_wants_attestation(policy_strict()), 0, "nor does the strict preset");
    assert_eq(policy_attest_allow(p, "aa"), 0 - 1, "a short measurement is refused");
    assert_eq(policy_attest_allow(p, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), 0 - 1, "63 digits are refused");
    assert_eq(policy_attest_allow(p, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), 0 - 1, "65 digits are refused");
    assert_eq(policy_attest_allow(p, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaag"), 0 - 1, "a non-hex digit is refused");
    assert_eq(policy_wants_attestation(p), 0, "refused entries add nothing");
    assert_eq(policy_attest_allow(p, ATT_TDX_MRTD), 0, "96 digits are an MRTD");
    assert_eq(policy_attest_allow(p, ATT_SGX_MRENCLAVE), 0, "64 digits are an MRENCLAVE");
    assert_eq(policy_wants_attestation(p), 1, "an allowed measurement requires attestation");
    var der = _t_att_bytes(ATT_ROOT_HEX, ATT_ROOT_LEN);
    assert_eq(policy_attest_root(p, der, ATT_ROOT_LEN), 0, "a root is set");
    store8(der, 0);
    assert_eq(load8(SandboxPolicy_attest_root(p)), 0x30, "the policy keeps its own copy of the root");
    assert_eq(policy_attest_root(p, der, 0), 0 - 1, "an empty root is refused");
    return 0;
}

# 3.13.0: the constructor allocated 48 bytes for a 56-byte struct.
fn test_attestation_result_fits_its_allocation() {
    test_group("attestation_result_fits_its_allocation");
    var r = kavach_attestation_result_new(KavachBackend.SGX);
    var next = alloc(8);
    store64(next, 0x1122334455667788);
    AttestationResult_set_details(r, "x");
    assert_eq(load64(next), 0x1122334455667788, "setting details leaves the next allocation alone");
    return 0;
}

var _t_att_quote = 0;
var _t_att_quote_len = 0;
var _t_att_runs = 0;

# Stands in for a TEE backend that can fetch a quote: it attaches whatever quote
# the test put in `_t_att_quote` and returns output for the gate to release or
# withhold.
fn _t_att_backend(sandbox, command) {
    _t_att_runs = _t_att_runs + 1;
    if (_t_att_quote != 0) { backend_attach_quote(_t_att_quote, _t_att_quote_len); }
    var r = exec_result_new();
    ExecResult_set_exit_code(r, 0);
    ExecResult_set_stdout(r, "enclave output");
    ExecResult_set_stdout_len(r, 14);
    ExecResult_set_stderr(r, "");
    return r;
}

# Built directly: `sandbox_create` refuses SGX and TDX on a host without their
# devices, and the gate, not creation, is under test.
fn _t_att_sandbox(backend, policy) {
    var cfg = config_new();
    config_backend(cfg, backend);
    config_policy(cfg, policy);
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_id(sb, rand_u64());
    Sandbox_set_config(sb, cfg);
    Sandbox_set_state(sb, SandboxState.RUNNING);
    return sb;
}

fn test_attest_gate_decides_the_exec() {
    test_group("attest_gate_decides_the_exec");
    kavach_init();
    backend_register_exec(KavachBackend.SGX, &_t_att_backend);
    sandbox_exec_set_attest_time(ATT_NOW);
    _t_att_quote = _t_att_bytes(ATT_SGX_HEX, ATT_SGX_LEN);
    _t_att_quote_len = ATT_SGX_LEN;
    var sb = _t_att_sandbox(KavachBackend.SGX, _t_att_policy(ATT_SGX_MRENCLAVE));

    sandbox_exec_set_attest_nonce(_t_att_fill(32, 0xcc), 32);
    var r = sandbox_exec(sb, "echo hi");
    assert(r != 0, "an affirmed guest's output is released");
    assert_eq(_t_att_out_is(r, 1, "enclave output"), 1, "the guest's own output");
    assert_eq(_t_att_trust(sandbox_exec_last_attestation()), KAVACH_TRUST_AFFIRMING, "the result is kept");

    var runs = _t_att_runs;
    r = sandbox_exec(sb, "echo hi");
    assert_eq(r, 0, "the same quote on the next exec is a replay, and is refused");
    assert_eq(_t_att_runs, runs + 1, "(the caller's nonce was used once; this exec drew its own)");
    assert_eq(_t_att_why(sandbox_exec_last_attestation(), "the report data does not carry the nonce"), 1, "the reason is kept");

    _t_att_quote = 0;
    sandbox_exec_set_attest_nonce(_t_att_fill(32, 0xcc), 32);
    r = sandbox_exec(sb, "echo hi");
    assert_eq(r, 0, "a guest that returns no quote fails the exec");
    assert_eq(_t_att_why(sandbox_exec_last_attestation(), "no quote"), 1, "no quote is the reason");

    _t_att_quote = _t_att_bytes(ATT_SGX_HEX, ATT_SGX_LEN);
    var other = _t_att_sandbox(KavachBackend.SGX, _t_att_policy(ATT_OTHER));
    sandbox_exec_set_attest_nonce(_t_att_fill(32, 0xcc), 32);
    assert_eq(sandbox_exec(other, "echo hi"), 0, "a measurement off the allowlist fails the exec");

    backend_register_exec(KavachBackend.NOOP, &_t_att_backend);
    runs = _t_att_runs;
    var nb = _t_att_sandbox(KavachBackend.NOOP, _t_att_policy(ATT_SGX_MRENCLAVE));
    assert_eq(sandbox_exec(nb, "echo hi"), 0, "a backend that cannot attest is refused");
    assert_eq(_t_att_runs, runs, "before anything runs");
    assert_eq(sandbox_exec_last_attestation(), 0, "with no quote checked");

    kavach_init();
    var sg = _t_att_sandbox(KavachBackend.SGX, _t_att_policy(ATT_SGX_MRENCLAVE));
    r = sandbox_exec(sg, "echo hi");
    assert(r != 0, "kavach's own SGX launcher answers with a diagnostic");
    assert_eq(_t_att_exit(r), 1, "that exits 1");
    assert_eq(_t_att_out_is(r, 2, "sgx: the policy requires attestation, and this launcher cannot fetch a quote"), 1, "and says it cannot fetch a quote");
    var td = _t_att_sandbox(KavachBackend.TDX, _t_att_policy(ATT_TDX_MRTD));
    r = sandbox_exec(td, "echo hi");
    assert_eq(_t_att_out_is(r, 2, "tdx: the policy requires attestation, and this launcher cannot fetch a quote"), 1, "so does the TDX launcher");
    assert_eq(backend_attest_nonce_len(), 0, "a diagnostic leaves no nonce behind for the next dispatch");

    var plain = _t_att_sandbox(KavachBackend.NOOP, policy_new());
    assert(sandbox_exec(plain, "echo hi") != 0, "a policy without an allowlist runs as before");
    assert_eq(sandbox_exec_last_attestation(), 0, "and checks no quote");
    sandbox_exec_set_attest_time(0);
    return 0;
}

fn test_attest_other_paths_refuse() {
    test_group("attest_other_paths_refuse");
    kavach_init();
    var p = _t_att_policy(ATT_SGX_MRENCLAVE);
    var sb = _t_att_sandbox(KavachBackend.PROCESS, p);
    assert_eq(sandbox_spawn(sb, "/bin/true", 0), 0, "sandbox_spawn refuses a policy that requires attestation");
    assert_eq(persistent_spawn_confined("/bin/cat", p), 0, "so does a persistent guest");
    var cb = _t_att_sandbox(KavachBackend.PROCESS, policy_new());
    assert_eq(composite_exec(KavachBackend.SGX, KavachBackend.PROCESS, cb, "echo hi", p), 0, "and composite_exec");

    var m = merge_policies(p, policy_basic());
    assert_eq(policy_wants_attestation(m), 1, "a merge keeps the requirement");
    assert_eq(_attest_listed(m, ATT_SGX_MRENCLAVE), 1, "and the allowlist");
    assert_eq(SandboxPolicy_attest_root_len(m), ATT_ROOT_LEN, "and the root");
    m = merge_policies(policy_basic(), p);
    assert_eq(_attest_listed(m, ATT_SGX_MRENCLAVE), 1, "from either side");
    var both = _t_att_policy(ATT_SGX_MRENCLAVE);
    policy_attest_allow(both, ATT_OTHER);
    policy_attest_allow_debug(both, 1);
    m = merge_policies(p, both);
    assert_eq(_attest_listed(m, ATT_SGX_MRENCLAVE), 1, "both allow MRENCLAVE: kept");
    assert_eq(_attest_listed(m, ATT_OTHER), 0, "only one allows the other: dropped");
    assert_eq(SandboxPolicy_attest_allow_debug(m), 0, "debug only if both allow it");
    m = merge_policies(p, _t_att_policy(ATT_OTHER));
    assert_eq(policy_wants_attestation(m), 1, "disjoint allowlists still require attestation");
    var r = kavach_attest_sgx_quote(_t_att_bytes(ATT_SGX_HEX, ATT_SGX_LEN), ATT_SGX_LEN, m, _t_att_fill(32, 0xcc), 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "and admit no guest");
    var w = policy_new();
    policy_attest_root(w, _t_att_bytes(ATT_WRONG_ROOT_HEX, ATT_WRONG_ROOT_LEN), ATT_WRONG_ROOT_LEN);
    policy_attest_allow(w, ATT_SGX_MRENCLAVE);
    m = merge_policies(p, w);
    r = kavach_attest_sgx_quote(_t_att_bytes(ATT_SGX_HEX, ATT_SGX_LEN), ATT_SGX_LEN, m, _t_att_fill(32, 0xcc), 32, ATT_NOW);
    assert_eq(_t_att_trust(r), KAVACH_TRUST_CONTRAINDICATED, "two roots admit no guest");
    return 0;
}

# ================================================================
# 3.13.2: the capture's full streams, the payload's stdin, landlock ABI v5
# and v6, and the shell-out backends
# ================================================================

# ---- a full buffer ends a stream without blocking the payload ------------
#
# Through 3.13.1 a full buffer only stopped the drain's reads. The payload then
# blocked writing to that pipe and never closed the other, so the capture waited
# for an EOF that could not come: measured, 2 MB of stdout and 200 KB of stderr
# each hung until the deadline and read as a timeout, exit 137, and hung for
# good without one. The deadlines here turn that into a failure, not a hang.
fn test_capture_ends_a_full_stream() {
    test_group("capture_ends_a_full_stream");
    var buf = alloc(65536);

    # stdout past the buffer: the pipe is closed and the payload's next write
    # fails, SIGPIPE, as under `exec_capture`.
    var oargs = vec_new();
    vec_push(oargs, "/usr/bin/head");
    vec_push(oargs, "-c");
    vec_push(oargs, "300000");
    vec_push(oargs, "/dev/zero");
    var t0 = mono_now_ns();
    var n = confine_capture_input(oargs, 0, 0, 0, 0, buf, 65536, 0, 20000, 0, "", 0);
    var ms = (mono_now_ns() - t0) / 1000000;
    assert_eq(confine_last_timed_out(), 0, "stdout past the buffer ends the run, not the deadline");
    assert_eq(n, 65535, "the buffer keeps the first 64 KiB, less the terminator");
    assert_eq(confine_last_exit(), 141, "and the payload's next write fails: SIGPIPE, 128 + 13");
    assert(ms < 10000, "well inside the deadline");

    # stderr past its cap: read on into a sink, so the payload runs to its end.
    var eargs = vec_new();
    vec_push(eargs, "/bin/sh");
    vec_push(eargs, "-c");
    vec_push(eargs, "i=0; while [ $i -lt 5000 ]; do echo xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx >&2; i=$((i+1)); done; echo done-stdout; exit 3");
    var m = confine_capture_input(eargs, 0, 0, 0, 0, buf, 65536, 0, 20000, 0, "", 0);
    if (m < 0) { m = 0; }
    store8(buf + m, 0);
    assert_eq(confine_last_timed_out(), 0, "200 KB of stderr ends the run on its own, not at the deadline");
    assert_eq(cstr_contains(buf, "done-stdout"), 1, "the payload writes on past its stderr's cap");
    assert_eq(confine_last_exit(), 3, "and exits as it chose to");
    assert_eq(confine_last_stderr_len(), CONFINE_ERR_MAX - 1, "its stderr is kept up to the cap");
    return 0;
}

# ---- the capture's payload dies with kavach (3.13.2) ----------------------
#
# Through 3.13.1 a payload outlived a kavach killed mid-capture (measured: its
# `sleep` still running after kavach's SIGKILL). The stdlib's `exec_capture`
# sets a parent-death signal; gVisor and SY-agnos lost it when they moved onto
# this capture, which now sets it too.

# 1 while `pid` runs, 0 once it is gone or a zombie.
fn _t_pid_running(pid) {
    var path = str_cstr(str_cat(str_cat(str_from("/proc/"), str_from_int(pid)), str_from("/status")));
    var buf = alloc(4096);
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var n = sys_read(fd, buf, 4095);
    sys_close(fd);
    if (n < 0) { n = 0; }
    store8(buf + n, 0);
    if (cstr_contains(buf, "State:\tZ") == 1) { return 0; }
    return 1;
}

fn test_capture_payload_dies_with_kavach() {
    test_group("capture_payload_dies_with_kavach");
    var pidfile = _t_unique_tmp_path("/tmp/kavach-t-pdeath-");
    var helper = kv_fork();
    if (helper == 0) {
        var args = vec_new();
        vec_push(args, "/bin/sh");
        vec_push(args, "-c");
        var script = str_cat(str_from("echo $$ > "), str_from(pidfile));
        script = str_cat(script, str_from("; exec /bin/sleep 30"));
        vec_push(args, str_cstr(script));
        var hbuf = alloc(64);
        confine_capture_input_env_wd(args, 0, 0, 0, 0, hbuf, 64, 0, 0, 0, "", 0, 0, 0);
        sys_exit(0);
    }
    var pid = 0;
    var tries = 0;
    while (pid == 0 && tries < 500) {
        var fd = file_open(pidfile, O_RDONLY, 0);
        if (fd >= 0) {
            var b[32];
            var n = sys_read(fd, &b, 31);
            sys_close(fd);
            if (n > 1) {
                store8(&b + n, 0);
                pid = atoi(&b);
            }
        }
        if (pid == 0) { kv_sleep_ms(10); }
        tries = tries + 1;
    }
    assert(pid > 0, "the payload started and recorded its pid");
    sys_kill(helper, 9);
    var st[8];
    store64(&st, 0);
    kv_waitpid(helper, &st, 0);
    if (pid <= 0) { return 0; }
    var waited = 0;
    while (_t_pid_running(pid) == 1 && waited < 2000) {
        kv_sleep_ms(20);
        waited = waited + 20;
    }
    var running = _t_pid_running(pid);
    assert_eq(running, 0, "the payload does not outlive the process capturing it");
    if (running == 1) { sys_kill(pid, 9); }
    sys_unlink(pidfile);
    return 0;
}

# ---- a result keeps its own stderr ---------------------------------------
#
# `confine_last_stderr()` is one static buffer that every capture rewrites.
# Through 3.13.1 the process and WASM backends stored that pointer in their
# results, so an earlier result's stderr changed to a later exec's (measured).
fn test_results_keep_their_own_stderr() {
    test_group("results_keep_their_own_stderr");
    kavach_init();
    var round = 0;
    while (round < 2) {
        var p = policy_minimal();
        var which = "unconfined";
        if (round == 1) {
            p = _t_ll_add_runtime(policy_minimal());
            which = "confined";
        }
        var r1 = _t_pio_run(p, "/bin/ls /nonexistent-kavach-FIRST", 0, 0, 0);
        var r2 = _t_pio_run(p, "/bin/ls /nonexistent-kavach-SECOND", 0, 0, 0);
        assert(r1 != 0 && r2 != 0, _t_pio_msg(which, "both execs return a result"));
        if (r1 != 0 && r2 != 0) {
            assert_eq(cstr_contains(ExecResult_stderr(r1), "FIRST"), 1,
              _t_pio_msg(which, "the first result's stderr is its own"));
            assert_eq(cstr_contains(ExecResult_stderr(r1), "SECOND"), 0,
              _t_pio_msg(which, "...and stays its own after a second exec"));
            assert_eq(cstr_contains(ExecResult_stderr(r2), "SECOND"), 1,
              _t_pio_msg(which, "the second result's is its own"));
        }
        round = round + 1;
    }

    # The WASM backend, where wasmtime names a module it cannot parse.
    if (_wasm_binary_path() == 0) { return 0; }
    var j1 = _t_unique_tmp_path("/tmp/kavach-t-wasm-junk-FIRST-");
    var j2 = _t_unique_tmp_path("/tmp/kavach-t-wasm-junk-SECOND-");
    file_write_all(j1, "not a module", 12);
    file_write_all(j2, "not a module", 12);
    var w1 = wasm_exec(_t_wa_sandbox(policy_minimal(), 0), j1);
    var w2 = wasm_exec(_t_wa_sandbox(policy_minimal(), 0), j2);
    assert_eq(cstr_contains(ExecResult_stderr(w1), "junk-FIRST"), 1, "wasm: the first result's stderr is its own");
    assert_eq(cstr_contains(ExecResult_stderr(w1), "junk-SECOND"), 0,
      "wasm: ...and stays its own after a second exec");
    assert_eq(cstr_contains(ExecResult_stderr(w2), "junk-SECOND"), 1, "wasm: the second result's is its own");
    sys_unlink(j1);
    sys_unlink(j2);
    return 0;
}

# ---- the payload's stdin is empty unless the config says otherwise --------
#
# Through 3.13.1 a config with no stdin handed the payload kavach's own
# (measured: `/bin/cat` printed what kavach had been given). Since 3.13.2 it is
# empty, and `config_stdin_inherit` opts back in.

# Replace this process's stdin with a pipe holding `marker` and then EOF, and
# return the descriptor `_t_host_stdin_restore` puts back.
fn _t_host_stdin(marker) {
    var saved = syscall(SYS_DUP, 0);
    var p[16];
    sys_pipe(&p);
    var rfd = load32(&p);
    var wfd = load32(&p + 4);
    sys_write(wfd, marker, strlen(marker));
    sys_close(wfd);
    kv_dup2(rfd, 0);
    sys_close(rfd);
    return saved;
}

fn _t_host_stdin_restore(saved) {
    if (saved < 0) {
        sys_close(0);
        return 0;
    }
    kv_dup2(saved, 0);
    sys_close(saved);
    return 0;
}

# `cmd` on the PROCESS backend under `policy`, with no config stdin and, when
# `inherit` is 1, `config_stdin_inherit`.
fn _t_si_run(policy, cmd, inherit) {
    var c = config_new();
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy);
    config_timeout_ms(c, 5000);
    if (inherit == 1) { config_stdin_inherit(c, 1); }
    var s = sandbox_create(c);
    if (s == 0) { return 0; }
    sandbox_transition(s, SandboxState.RUNNING);
    var r = sandbox_exec(s, cmd);
    sandbox_destroy(s);
    return r;
}

fn test_payload_stdin_is_empty_unless_asked() {
    test_group("payload_stdin_is_empty_unless_asked");
    kavach_init();
    # The resolver every backend that honours the config's stdin goes through.
    # 0 means inherit; anything else is sent, then closed.
    var e0 = _config_payload_stdin(0);
    assert(e0 != 0, "no config: a stdin to send, not 0 (inherit)");
    if (e0 != 0) { assert_eq(strlen(e0), 0, "...and an empty one"); }
    var c = config_new();
    var e1 = _config_payload_stdin(c);
    assert(e1 != 0, "an unset stdin: a stdin to send, not 0 (inherit)");
    if (e1 != 0) { assert_eq(strlen(e1), 0, "...and an empty one"); }
    config_stdin_inherit(c, 1);
    assert_eq(_config_payload_stdin(c), 0, "config_stdin_inherit asks for kavach's own");
    config_stdin(c, "X", 1);
    var e2 = _config_payload_stdin(c);
    assert(e2 != 0, "a set stdin wins over inherit");
    if (e2 != 0) { assert_eq(streq(e2, "X"), 1, "...and is the config's"); }
    assert_eq(_config_payload_stdin_len(c), 1, "...with its length");

    var rounds = 2;
    if (_t_host_loads_seccomp() == 1) { rounds = 3; }
    var round = 0;
    while (round < rounds) {
        var p = policy_minimal();
        var which = "unconfined";
        if (round == 1) {
            p = _t_ll_add_runtime(policy_minimal());
            which = "confined by landlock";
        }
        if (round == 2) {
            p = policy_basic();
            which = "confined by seccomp";
        }
        var saved = _t_host_stdin("KAVACH-HOST-STDIN\n");
        var r = _t_si_run(p, "/bin/cat", 0);
        _t_host_stdin_restore(saved);
        var empty = 0;
        if (r != 0) {
            if (ExecResult_exit_code(r) == 0 && ExecResult_timed_out(r) == 0) {
                if (strlen(ExecResult_stdout(r)) == 0) { empty = 1; }
            }
        }
        assert_eq(empty, 1, _t_pio_msg(which, "an unset stdin is EOF, not kavach's own"));

        var saved2 = _t_host_stdin("KAVACH-HOST-STDIN\n");
        var r2 = _t_si_run(p, "/bin/cat", 1);
        _t_host_stdin_restore(saved2);
        assert_eq(_t_pio_saw(r2, "KAVACH-HOST-STDIN"), 1,
          _t_pio_msg(which, "config_stdin_inherit hands the payload kavach's stdin"));
        round = round + 1;
    }
    return 0;
}

# ---- landlock scopes (ABI v6) are applied (3.13.2) -----------------------
#
# Through 3.13.1 `landlock_abstract_unix` and `landlock_signal` were stored and
# scored, and applied nowhere: a `policy_strict()` payload could signal kavach
# (measured: `/bin/kill -0 <kavach>` exited 0).

# The exit code of a child that applies `scopes` and returns the errno of
# `kill(<this process>, 0)`: 0 when it may, 100 when the scopes were refused.
fn _t_signal_parent_under(scopes) {
    var parent = sys_getpid();
    var pid = kv_fork();
    if (pid == 0) {
        if (is_ok(security_apply_landlock_scoped(0, 0, scopes)) == 0) { sys_exit(100); }
        sys_exit(0 - sys_kill(parent, 0));
    }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    return (load32(&st) >> 8) & 255;
}

# The same for connecting to an abstract unix socket this process listens on.
fn _t_connect_parent_under(scopes) {
    var sa[32];
    store8(&sa, 1);                          # sun_family = AF_UNIX
    store8(&sa + 1, 0);
    store8(&sa + 2, 0);                      # a leading NUL: the abstract namespace
    memcpy(&sa + 3, rand_hex_id(), 16);
    var salen = 19;
    var ls = sys_socket(1, 1, 0);            # AF_UNIX, SOCK_STREAM
    if (ls < 0) { return 200; }
    if (sys_bind(ls, &sa, salen) < 0 || sys_listen(ls, 4) < 0) {
        sys_close(ls);
        return 201;
    }
    var pid = kv_fork();
    if (pid == 0) {
        if (is_ok(security_apply_landlock_scoped(0, 0, scopes)) == 0) { sys_exit(100); }
        var cs = sys_socket(1, 1, 0);
        sys_exit(0 - sys_connect(cs, &sa, salen));
    }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    sys_close(ls);
    return (load32(&st) >> 8) & 255;
}

# The exit code of `cmd` on the PROCESS backend under `policy`, or -1.
fn _t_scope_run(policy, cmd) {
    var c = config_new();
    SandboxConfig_set_backend(c, KavachBackend.PROCESS);
    SandboxConfig_set_policy(c, policy);
    config_timeout_ms(c, 5000);
    var s = sandbox_create(c);
    if (s == 0) { return 0 - 1; }
    sandbox_transition(s, SandboxState.RUNNING);
    var r = process_exec(s, cmd);
    sandbox_destroy(s);
    if (r == 0) { return 0 - 1; }
    return ExecResult_exit_code(r);
}

fn test_landlock_scopes_are_applied() {
    test_group("landlock_scopes_are_applied");
    kavach_init();
    assert_eq(_spawn_landlock_scopes(policy_minimal()), 0, "a minimal policy asks for no scope");
    assert_eq(_spawn_landlock_scopes(policy_strict()),
      LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET | LANDLOCK_SCOPE_SIGNAL, "policy_strict asks for both");

    # With no scope a child reaches this process both ways.
    assert_eq(_t_signal_parent_under(0), 0, "with no scope a child may signal this process");
    assert_eq(_t_connect_parent_under(0), 0, "...and connect to its abstract socket");
    if (security_landlock_abi_version() < 6) { return 0; }
    assert_eq(_t_signal_parent_under(LANDLOCK_SCOPE_SIGNAL), EPERM,
      "the signal scope refuses the signal");
    assert_eq(_t_connect_parent_under(LANDLOCK_SCOPE_SIGNAL), 0, "...and leaves the socket alone");
    assert_eq(_t_connect_parent_under(LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET), EPERM,
      "the abstract-unix scope refuses the connect");
    assert_eq(_t_signal_parent_under(LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET), 0,
      "...and leaves the signal alone");

    # Through a policy, as a consumer reaches it. A scope-only policy took the
    # unconfined capture through 3.13.1.
    if (file_exists("/bin/kill") == 0) { return 0; }
    var cmd = str_cstr(str_cat(str_from("/bin/kill -0 "), str_from_int(sys_getpid())));
    assert_eq(_t_scope_run(policy_minimal(), cmd), 0, "an unscoped payload may signal kavach");
    var sg = policy_minimal();
    SandboxPolicy_set_landlock_signal(sg, 1);
    assert_eq(_t_scope_run(sg, cmd), 1, "a payload under the signal scope may not");
    if (_t_host_loads_seccomp() == 1) {
        assert_eq(_t_scope_run(policy_strict(), cmd), 1, "nor may a policy_strict payload");
    }
    return 0;
}

# ---- landlock IOCTL_DEV (ABI v5) is handled (3.13.2) ---------------------
#
# A child under one rule opens /dev/null read-only and asks it TCGETS, which
# /dev/null answers ENOTTY when the ioctl reaches it, and landlock EACCES when
# it does not. Through 3.13.1 IOCTL_DEV was not handled, so every ruleset let
# every device ioctl through (measured: ENOTTY under a read-only rule).
var _T_TCGETS = 21505;                       # asm-generic, as on x86_64 and aarch64
var _T_ENOTTY = 25;                          # asm-generic errno, as on both

fn _t_ioctl_under(path, access) {
    var pid = kv_fork();
    if (pid == 0) {
        var rules = vec_new();
        vec_push(rules, security_fs_rule_new(path, access));
        if (is_ok(security_apply_landlock(rules, 1)) == 0) { sys_exit(100); }
        var fd = file_open("/dev/null", O_RDONLY, 0);
        if (fd < 0) { sys_exit(101); }
        var t[64];
        sys_exit(0 - sys_ioctl(fd, _T_TCGETS, &t));
    }
    var st[8];
    store64(&st, 0);
    kv_waitpid(pid, &st, 0);
    return (load32(&st) >> 8) & 255;
}

fn test_landlock_confines_device_ioctls() {
    test_group("landlock_confines_device_ioctls");
    assert_eq(_landlock_allow_read_only() & LANDLOCK_ACCESS_FS_IOCTL_DEV, 0,
      "read-only never grants a device ioctl");
    assert_eq(_landlock_allow_read_write(5) & LANDLOCK_ACCESS_FS_IOCTL_DEV,
      LANDLOCK_ACCESS_FS_IOCTL_DEV, "read-write grants it from ABI v5");
    assert_eq(_landlock_allow_read_write(4) & LANDLOCK_ACCESS_FS_IOCTL_DEV, 0,
      "...and not before, where the kernel would refuse it");
    assert_eq(_landlock_file_rights() & LANDLOCK_ACCESS_FS_IOCTL_DEV, LANDLOCK_ACCESS_FS_IOCTL_DEV,
      "a rule naming a device file can hold it");
    if (security_landlock_abi_version() < 5) { return 0; }
    assert_eq(_t_ioctl_under("/dev", FS_READ_ONLY), EACCES, "a read-only /dev refuses a device ioctl");
    assert_eq(_t_ioctl_under("/dev", FS_READ_WRITE), _T_ENOTTY,
      "a read-write /dev lets it reach the device");
    assert_eq(_t_ioctl_under("/dev/null", FS_READ_ONLY), EACCES,
      "a read-only rule naming the device refuses it too");
    assert_eq(_t_ioctl_under("/dev/null", FS_READ_WRITE), _T_ENOTTY,
      "...and a read-write one lets it through");
    return 0;
}

# ---- TCP port counts are not scored (3.13.2) ------------------------------
#
# The policy carries `network_tcp_bind_len` and `network_tcp_connect_len`,
# counts with no port list and no setter, so nothing applies them. Through
# 3.13.1 either added 3 to the score.
fn test_score_does_not_count_tcp_ports() {
    test_group("score_does_not_count_tcp_ports");
    var base = score_backend(KavachBackend.PROCESS, policy_minimal());
    var b = policy_minimal();
    SandboxPolicy_set_network_tcp_bind_len(b, 2);
    assert_eq(score_backend(KavachBackend.PROCESS, b), base, "a bind-port count adds nothing");
    var c = policy_minimal();
    SandboxPolicy_set_network_tcp_connect_len(c, 3);
    assert_eq(score_backend(KavachBackend.PROCESS, c), base, "nor does a connect-port count");
    return 0;
}

# ---- the shell-out backends report their runtime's run (3.13.2) ----------
#
# Through 3.13.1 gVisor and SY-agnos ran their runtime through
# `kv_exec_capture`: exit 0 for any run (measured with a stand-in runsc exiting
# 7), stderr sent to /dev/null, no deadline, and kavach's own stdin. OCI had a
# capture of its own, with the exit status and stderr but no deadline and no
# stdin. All three take the process backend's capture now; these drive each
# with a stand-in runtime.

# A stand-in container runtime at `path` that appends its arguments to `rec`.
# Its `run` prints `stub-stdout`, `stub-stderr` on stderr and its stdin, and
# exits 7, or with `slow` sleeps for 5 s; anything else (delete, rm) exits 0.
fn _t_rt_stub(path, rec, slow) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "#!/bin/sh\necho \"$*\" >> ");
    str_builder_add_cstr(sb, rec);
    str_builder_add_cstr(sb, "\ncase \" $* \" in\n  *\" run \"*) ;;\n  *) exit 0 ;;\nesac\n");
    if (slow == 1) { str_builder_add_cstr(sb, "exec /bin/sleep 5\n"); }
    else { str_builder_add_cstr(sb, "echo stub-stdout\necho stub-stderr >&2\n/bin/cat\nexit 7\n"); }
    return _t_write_stub(path, str_data(str_builder_build(sb)));
}

# `cmd` on backend `b` under the stand-in runtime `stub`, with config `cfg`.
fn _t_rt_exec(b, stub, cfg, cmd) {
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    var t0 = mono_now_ns();
    if (b == KavachBackend.GVISOR) { return _gvisor_exec_with(stub, sb, cmd, t0); }
    if (b == KavachBackend.OCI) { return _oci_exec_with(stub, sb, cmd, t0); }
    return _sy_agnos_exec_with(stub, sb, cmd, t0);
}

# The token after `prefix` in `s`, up to a space or newline, or "".
fn _t_token_after(s, prefix) {
    var at = strstr(s, prefix);
    if (at < 0) { return ""; }
    var start = s + at + strlen(prefix);
    var n = 0;
    while (load8(start + n) != 0 && load8(start + n) != 32 && load8(start + n) != 10) {
        n = n + 1;
    }
    var out = alloc(n + 1);
    memcpy(out, start, n);
    store8(out + n, 0);
    return out;
}

fn test_shell_out_backends_report_the_run() {
    test_group("shell_out_backends_report_the_run");
    kavach_init();
    var i = 0;
    while (i < 3) {
        var b = KavachBackend.GVISOR;
        if (i == 1) { b = KavachBackend.OCI; }
        if (i == 2) { b = KavachBackend.SY_AGNOS; }
        var which = os_backend_name(b);
        var rec = _t_unique_tmp_path("/tmp/kavach-t-rt-rec-");
        var stub = _t_rt_stub(_t_unique_tmp_path("/tmp/kavach-t-rt-"), rec, 0);
        var slow = _t_rt_stub(_t_unique_tmp_path("/tmp/kavach-t-rt-slow-"), rec, 1);

        var c = config_timeout_ms(config_new(), 10000);
        config_stdin(c, "KAVACH-RT-STDIN\n", 16);
        var r = _t_rt_exec(b, stub, c, "echo hi");
        assert(r != 0, _t_pio_msg(which, "a run returns a result"));
        if (r != 0) {
            assert_eq(ExecResult_exit_code(r), 7, _t_pio_msg(which, "the runtime's exit status, not 0"));
            assert_eq(cstr_contains(ExecResult_stdout(r), "stub-stdout"), 1, _t_pio_msg(which, "its stdout"));
            assert_eq(cstr_contains(ExecResult_stderr(r), "stub-stderr"), 1,
              _t_pio_msg(which, "its stderr, not \"\""));
            assert_eq(cstr_contains(ExecResult_stdout(r), "KAVACH-RT-STDIN"), 1,
              _t_pio_msg(which, "the config's stdin reaches the runtime"));
            assert_eq(ExecResult_timed_out(r), 0, _t_pio_msg(which, "inside its deadline"));
        }

        var saved = _t_host_stdin("KAVACH-RT-HOST-STDIN\n");
        var r2 = _t_rt_exec(b, stub, config_timeout_ms(config_new(), 10000), "echo hi");
        _t_host_stdin_restore(saved);
        assert(r2 != 0, _t_pio_msg(which, "a run with no stdin returns a result"));
        if (r2 != 0) {
            assert_eq(cstr_contains(ExecResult_stdout(r2), "KAVACH-RT-HOST-STDIN"), 0,
              _t_pio_msg(which, "an unset stdin is empty, not kavach's own"));
            assert_eq(ExecResult_exit_code(r2), 7, _t_pio_msg(which, "...and the run completes"));
        }

        var r3 = _t_rt_exec(b, slow, config_timeout_ms(config_new(), 300), "echo hi");
        assert(r3 != 0, _t_pio_msg(which, "a slow run returns a result"));
        if (r3 != 0) {
            assert_eq(ExecResult_timed_out(r3), 1, _t_pio_msg(which, "the config's deadline kills the runtime"));
            assert_eq(ExecResult_exit_code(r3), 137, _t_pio_msg(which, "...with SIGKILL, 128 + 9"));
            assert(ExecResult_duration_ms(r3) < 4000, _t_pio_msg(which, "...before its 5 s sleep ends"));
        }

        # Every run is followed by the runtime's own removal of the container.
        var log = _oci_take_file(rec);
        if (b == KavachBackend.GVISOR) {
            assert_eq(cstr_contains(log, "delete --force kavach-gvisor-"), 1,
              _t_pio_msg(which, "runsc deletes the container after the run"));
        }
        if (b == KavachBackend.OCI) {
            assert_eq(cstr_contains(log, "delete --force kavach-oci-"), 1,
              _t_pio_msg(which, "the runtime deletes the container after the run"));
        }
        if (b == KavachBackend.SY_AGNOS) {
            var name = _t_token_after(log, "run --rm -i --name ");
            assert(strlen(name) > 0, _t_pio_msg(which, "the container runs named, with -i for its stdin"));
            var rm = str_cstr(str_cat(str_from("rm --force "), str_from(name)));
            assert_eq(cstr_contains(log, rm), 1, _t_pio_msg(which, "...and is removed by that name"));
        }
        sys_unlink(stub);
        sys_unlink(slow);
        i = i + 1;
    }
    return 0;
}

# ---- wasmtime runs under the policy's confinement (3.13.2) ----------------
#
# The probe in tests/wasm_status_probe.wat, 274 bytes: it prints `status` from
# its first preopen, which under `--dir /proc/self` is wasmtime's own
# /proc/<pid>/status. Its `Seccomp:` and `NoNewPrivs:` lines are the kernel's
# account of how wasmtime runs. Through 3.13.1 only landlock rules confined
# wasmtime: a policy's seccomp and scopes were not applied to it.
var WASM_STATUS_PROBE_LEN = 274;
var WASM_STATUS_PROBE_HEX = "";

fn test_wasm_runs_under_the_policys_confinement() {
    test_group("wasm_runs_under_the_policys_confinement");
    kavach_init();
    assert_eq(_wasm_seccomp_info(policy_minimal()), 0, "no seccomp asked for, no filter");
    assert(_wasm_seccomp_info(policy_basic()) > 0, "seccomp asked for: kavach's exec filter");
    if (_wasm_binary_path() == 0) { return 0; }
    var module = _t_unique_tmp_path("/tmp/kavach-t-wasm-status-");
    file_write_all(module, hex_decode(WASM_STATUS_PROBE_HEX, 2 * WASM_STATUS_PROBE_LEN),
      WASM_STATUS_PROBE_LEN);

    # Nothing asked for: wasmtime runs as it always did, and the probe works.
    var r0 = wasm_exec(_t_wa_sandbox(policy_minimal(), "/proc/self"), module);
    assert_eq(ExecResult_exit_code(r0), 0, "an unconfined probe runs");
    assert_eq(cstr_contains(ExecResult_stdout(r0), "Seccomp:\t0"), 1, "...with no filter");
    assert_eq(cstr_contains(ExecResult_stdout(r0), "NoNewPrivs:\t0"), 1, "...and no NO_NEW_PRIVS");

    # policy_basic asks for seccomp and nothing else.
    var r1 = wasm_exec(_t_wa_sandbox(policy_basic(), "/proc/self"), module);
    if (_t_host_loads_seccomp() == 1) {
        assert_eq(ExecResult_exit_code(r1), 0, "a seccomp policy's probe runs");
        assert_eq(cstr_contains(ExecResult_stdout(r1), "Seccomp:\t2"), 1,
          "...with wasmtime under the filter");
    }
    if (_t_host_loads_seccomp() == 0) {
        assert_eq(ExecResult_exit_code(r1), SPAWN_EXIT_SECCOMP,
          "a host that cannot load the filter refuses the run");
    }

    # With landlock rules wasmtime runs under `_wasm_host_policy`'s ruleset,
    # which carries the policy's scopes.
    var hp = policy_minimal();
    policy_landlock_add(hp, "/tmp", FS_READ_ONLY);
    SandboxPolicy_set_landlock_abstract_unix(hp, 1);
    SandboxPolicy_set_landlock_signal(hp, 1);
    assert_eq(_spawn_landlock_scopes(_wasm_host_policy(hp, _wasm_binary_path(), module)),
      LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET | LANDLOCK_SCOPE_SIGNAL,
      "the host ruleset keeps the policy's scopes");

    # A scope alone confines wasmtime too; NO_NEW_PRIVS is the part in view.
    var sp = policy_minimal();
    SandboxPolicy_set_landlock_signal(sp, 1);
    var r2 = wasm_exec(_t_wa_sandbox(sp, "/proc/self"), module);
    assert_eq(ExecResult_exit_code(r2), 0, "a scoped probe runs");
    assert_eq(cstr_contains(ExecResult_stdout(r2), "NoNewPrivs:\t1"), 1,
      "...with wasmtime confined");
    sys_unlink(module);
    return 0;
}

