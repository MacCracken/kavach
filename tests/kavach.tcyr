fn test_gate_stderr() {
    test_group("gate_stderr");
    var er = exec_result_new();
    ExecResult_set_stdout(er, "clean");
    ExecResult_set_stderr(er, "-----BEGIN RSA PRIVATE KEY-----");
    var pol = ext_policy_default();
    var sr = gate_apply(er, pol);
    assert_eq(ScanResult_verdict(sr), ScanVerdict.BLOCK, "stderr secret blocked");
    return 0;
}

fn test_credential_register_resolve() {
    test_group("credential_register");
    var p = credential_proxy_new();
    credential_proxy_register(p, "API_KEY", "sk-12345");
    var r = secret_ref_env("API_KEY", "OPENAI_API_KEY");
    var v = credential_proxy_resolve(p, r);
    assert(v != 0, "resolved");
    assert_eq(streq(v, "sk-12345"), 1, "value matches");

    var missing = secret_ref_stdin("NOPE");
    assert_eq(credential_proxy_resolve(p, missing), 0, "unknown returns 0");
    return 0;
}

fn test_credential_env_vars() {
    test_group("credential_env_vars");
    var p = credential_proxy_new();
    credential_proxy_register(p, "K1", "v1");
    credential_proxy_register(p, "K2", "v2");
    var refs = vec_new();
    vec_push(refs, secret_ref_env("K1", "MY_K1"));
    vec_push(refs, secret_ref_file("K2", "/tmp/secret", 384));
    var env = credential_proxy_env_vars(p, refs);
    assert_eq(vec_len(env), 2, "only ENV refs emitted (name+value)");
    assert_eq(streq(vec_get(env, 0), "MY_K1"), 1, "var name");
    assert_eq(streq(vec_get(env, 1), "v1"), 1, "var value");
    return 0;
}

fn test_credential_file_injections() {
    test_group("credential_file_injections");
    var p = credential_proxy_new();
    credential_proxy_register(p, "TLS_CERT", "-----CERT-----");
    var refs = vec_new();
    vec_push(refs, secret_ref_file("TLS_CERT", "/etc/ssl/cert.pem", 384));
    var files = credential_proxy_file_injections(p, refs);
    assert_eq(vec_len(files), 1, "one file injection");
    var f = vec_get(files, 0);
    assert_eq(streq(FileInjection_path(f), "/etc/ssl/cert.pem"), 1, "path");
    assert_eq(streq(FileInjection_content(f), "-----CERT-----"), 1, "content");
    assert_eq(FileInjection_mode(f), 384, "mode 0o600");
    return 0;
}

fn test_credential_inject_files() {
    test_group("credential_inject_files");

    # Empty vec -> 0 written
    var empty = vec_new();
    assert_eq(credential_inject_files(empty), 0, "empty vec -> 0");

    # One file with mode 0644 — honors mode + lands content
    var dir = "/tmp/kavach-test-inject";
    sys_mkdir(dir, 448);
    var path1 = "/tmp/kavach-test-inject/secret1.txt";
    sys_unlink(path1);
    var injections = vec_new();
    vec_push(injections, file_injection_new(path1, "payload-1", 420));
    var n = credential_inject_files(injections);
    assert_eq(n, 1, "one file written");

    # Verify content
    var buf[64];
    var fd = sys_open(path1, 0, 0);
    assert(fd >= 0, "file readable after inject");
    var rd = sys_read(fd, &buf, 32);
    sys_close(fd);
    assert_eq(rd, 9, "9 bytes content");

    # Two files in one batch — second succeeds even though first existed
    sys_unlink(path1);
    var path2 = "/tmp/kavach-test-inject/secret2.txt";
    sys_unlink(path2);
    var batch = vec_new();
    vec_push(batch, file_injection_new(path1, "alpha", 384));
    vec_push(batch, file_injection_new(path2, "beta", 384));
    assert_eq(credential_inject_files(batch), 2, "two-file batch");
    sys_unlink(path1);
    sys_unlink(path2);

    # O_EXCL refuses preexisting target — returns negative
    sys_open(path1, 1 + 64, 384);    # create empty preexisting target
    var fail_batch = vec_new();
    vec_push(fail_batch, file_injection_new(path1, "blocked", 384));
    var rc = credential_inject_files(fail_batch);
    assert(rc < 0, "O_EXCL refuses preexisting");
    assert_eq(rc, 0 - 1, "rc == -(written+1) == -1 on first-file fail");
    sys_unlink(path1);
    sys_rmdir(dir);
    return 0;
}

fn test_credential_stdin_payload() {
    test_group("credential_stdin_payload");
    var p = credential_proxy_new();
    credential_proxy_register(p, "PART1", "hello");
    credential_proxy_register(p, "PART2", "world");
    var refs = vec_new();
