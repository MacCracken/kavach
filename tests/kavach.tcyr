# 3.4.0: the single AC pass must surface patterns from multiple distinct groups
# in one scan (exercises the dict-link output chain end-to-end through the real
# integration, not just the engine unit test).
fn test_code_scan_ac_multipattern() {
    test_group("code_scan_ac_multipattern");
    var r = scan_result_new();
    # eval( (eval_exec) · npm install (pkg_install) · /etc/passwd (sens_path) ·
    # "chmod " (perm_change) — four different groups, one pass.
    code_scan("eval(x); npm install foo; cat /etc/passwd; chmod 777 /", r);
    assert(vec_len(ScanResult_findings(r)) >= 4, "four distinct group hits in one pass");
    return 0;
}

