# 3.12.9: with a rootfs the spec writes real argv, `"tok",` per token, and the
# buffer had not counted that framing: 1500 one-character tokens wrote past it
# and crashed. The spec must come back whole, with every token in it.
fn test_oci_spec_argv_many_tokens() {
    test_group("oci_spec_argv_many_tokens");
    var cfg = config_new();
    config_backend(cfg, KavachBackend.OCI);
    config_rootfs(cfg, "/r");
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    var n = 3000;
    var cmd = alloc(n * 2 + 1);
    var i = 0;
    while (i < n) {
        store8(cmd + i * 2, 97);                       # 'a'
        store8(cmd + i * 2 + 1, 32);                   # ' '
        i = i + 1;
    }
    store8(cmd + n * 2 - 1, 0);
    var spec = oci_generate_spec(sb, cmd);
    assert(spec != 0, "a spec for 3000 argv tokens");
    if (spec == 0) { return 0; }
    var quoted = 0;
    var j = 0;
    var len = strlen(spec);
    while (j + 2 < len) {
        if (load8(spec + j) == 34 && load8(spec + j + 1) == 97 && load8(spec + j + 2) == 34) {
            quoted = quoted + 1;
        }
        j = j + 1;
    }
    assert_eq(quoted, n, "every token is in the args array");
    assert(cstr_contains(spec, "\"a\"]") == 1, "and the array is closed after the last one");
    return 0;
}

fn test_gvisor_oci_spec_shape() {
    test_group("gvisor_spec_shape");
    var cfg = config_new();
    config_backend(cfg, KavachBackend.GVISOR);
    # Craft sandbox directly — bypasses availability check so the test runs
    # even when runsc isn't installed.
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    var spec = oci_generate_spec(sb, "echo hi");
    assert(cstr_contains(spec, "\"ociVersion\":\"1.0.2\"") == 1, "version");
    assert(cstr_contains(spec, "\"args\":[\"/bin/sh\",\"-c\",\"echo hi\"]") == 1, "command wrapped");
    assert(cstr_contains(spec, "\"type\":\"pid\"") == 1, "pid ns");
    # network disabled by default → network namespace should be included
    assert(cstr_contains(spec, "\"type\":\"network\"") == 1, "net ns (default isolated)");
    return 0;
}

# 3.12.2: the OCI spec carries the config's workdir as `process.cwd`, where it
# hardcoded "/". The runc path is the OTHER half of the workdir fix — the process
# backend's half is `test_confine_capture_workdir`, and a container that takes
# the OCI backend goes nowhere near it.
fn test_oci_spec_cwd_from_config() {
    test_group("oci_spec_cwd_from_config");

    # Unset -> the historical default, so existing consumers are unchanged.
    var cfg0 = config_new();
    config_backend(cfg0, KavachBackend.OCI);
    var sb0 = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb0, cfg0);
    var spec0 = oci_generate_spec(sb0, "echo hi");
    assert(cstr_contains(spec0, "\"cwd\":\"/\"") == 1, "unset workdir keeps cwd /");

    # Set -> it reaches process.cwd.
    var cfg = config_new();
    config_backend(cfg, KavachBackend.OCI);
    config_workdir(cfg, "/app");
    var sb = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb, cfg);
    var spec = oci_generate_spec(sb, "echo hi");
    assert(cstr_contains(spec, "\"cwd\":\"/app\"") == 1,
      "the configured workdir reaches process.cwd — 0 here is the decorative-setter bug");
    assert(cstr_contains(spec, "\"cwd\":\"/\"}") == 0, "and the hardcoded / is gone");
    # The rest of the spec must still be intact around the substitution.
    assert(cstr_contains(spec, "\"ociVersion\":\"1.0.2\"") == 1, "spec still well-formed");
    assert(cstr_contains(spec, "\"root\":{\"path\":") == 1, "root object still emitted");

    # Caller-supplied, so it must be escaped rather than injected.
    var cfg2 = config_new();
    config_backend(cfg2, KavachBackend.OCI);
    config_workdir(cfg2, "/a\"b");
    var sb2 = alloc(SANDBOX_SIZE);
    Sandbox_set_config(sb2, cfg2);
    var spec2 = oci_generate_spec(sb2, "echo hi");
    assert(cstr_contains(spec2, "\"cwd\":\"/a\\\"b\"") == 1, "a quote in the workdir is escaped");
    return 0;
}

