var _strict_policy = 0;

fn _ensure_strict() {
    if (_strict_policy == 0) { _strict_policy = policy_strict(); }
    return _strict_policy;
}

# Sub-µs operations use batch timing to avoid clock-overhead bias.

fn bench_score_backend_process_strict() {
    score_backend(KavachBackend.PROCESS, _strict_policy);
    return 0;
}

fn bench_score_all_backends_strict() {
    var i = 0;
    while (i < KAVACH_BACKEND_COUNT) {
        score_backend(i, _strict_policy);
        i = i + 1;
    }
    return 0;
}

fn bench_policy_strict_create() {
    var p = policy_strict();
    return 0;
}

fn bench_config_builder_full() {
    var c = config_new();
    config_backend(c, KavachBackend.GVISOR);
    config_policy_seccomp(c, "strict");
    config_network(c, 0);
    config_timeout_ms(c, 60000);
    config_agent_id(c, "bench-agent");
    return 0;
}

fn bench_state_valid_transition_check() {
    valid_transition(SandboxState.CREATED, SandboxState.RUNNING);
    return 0;
}

var _proxy_100 = 0;
var _refs_100 = 0;

fn _setup_proxy_100() {
    if (_proxy_100 != 0) { return 0; }
    _proxy_100 = credential_proxy_new();
    _refs_100 = vec_new();
    var i = 0;
    while (i < 100) {
        var name_buf = alloc(16);
        memcpy(name_buf, "KEY_", 4);
        fmt_int_buf(i, name_buf + 4);
        credential_proxy_register(_proxy_100, name_buf, "value-xxxxxxxxxxxxxxxxxx");
        vec_push(_refs_100, secret_ref_env(name_buf, name_buf));
        i = i + 1;
    }
    return 0;
}

fn bench_credential_env_vars_100() {
    credential_proxy_env_vars(_proxy_100, _refs_100);
    return 0;
}

var _clean_text = "hello world, this is clean output with no secrets in it";
var _text_with_secrets = 0;

fn _setup_text_with_secrets() {
    if (_text_with_secrets != 0) { return 0; }
    _text_with_secrets = "prefix AKIAIOSFODNN7EXAMPLE middle ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij tail";
    return 0;
}

fn bench_secrets_scan_clean_text() {
    var r = scan_result_new();
    secrets_scan(_clean_text, r);
    return 0;
}

fn bench_secrets_scan_with_secrets() {
    var r = scan_result_new();
    secrets_scan(_text_with_secrets, r);
    return 0;
}

fn bench_secrets_redact() {
    secrets_redact(_text_with_secrets);
    return 0;
}

# ~16 KB benign artifact (no scanner patterns) — the worst case for the old
# per-pattern scan, since every cstr_contains runs to completion with no early
# exit. Lets the AC-vs-naive code-scan benches show the real delta.
var _large_code_text = 0;
fn _setup_large_code_text() {
    if (_large_code_text != 0) { return 0; }
    var unit = "the quick brown fox jumps over the lazy dog 0123456789 ";
    var ulen = strlen(unit);
    var reps = 300;
    var buf = alloc(ulen * reps + 1);
    var i = 0;
    while (i < reps) {
        memcpy(buf + i * ulen, unit, ulen);
        i = i + 1;
    }
    store8(buf + ulen * reps, 0);
    _large_code_text = buf;
    return 0;
}

# Code scan via the Aho-Corasick single pass (current implementation).
fn bench_code_scan_large() {
    var r = scan_result_new();
    code_scan(_large_code_text, r);
    return 0;
}

# Naive baseline: lower once, then one cstr_contains pass per master pattern —
# exactly what the 26 groups did before the AC integration. The ratio of this
# to bench_code_scan_large is the AC win on a scan-dominated artifact.
fn bench_code_scan_naive() {
    var n = strlen(_large_code_text);
    var lower = alloc(n + 1);
    str_to_lower_into(_large_code_text, lower);
    var pats = _cg_master_patterns();
    var np = vec_len(pats);
    var i = 0;
    while (i < np) {
        cstr_contains(lower, vec_get(pats, i));
        i = i + 1;
    }
    return 0;
}

var _clean_exec_result = 0;
var _default_policy = 0;

fn _setup_gate_clean() {
    if (_clean_exec_result != 0) { return 0; }
    _clean_exec_result = exec_result_new();
    ExecResult_set_stdout(_clean_exec_result, "hello world");
    _default_policy = ext_policy_default();
    return 0;
}

fn bench_gate_clean_output() {
    gate_apply(_clean_exec_result, _default_policy);
    return 0;
}

fn bench_health_check_noop() {
    var cfg = config_new();
    config_backend(cfg, KavachBackend.NOOP);
    var sb = sandbox_create(cfg);
    health_probe(sb);
    return 0;
}

# ---- the exec path, which nothing measured until 3.11.7 -------------------
#
# **Every benchmark above this line is in-process.** `sandbox_full_lifecycle`
# uses `KavachBackend.NOOP` and execs nothing, so scoring, policy, scanning and the
# audit chain were covered while `confine_capture` — fork, exec, the drain loop
# and the deadline — was not. That is the code 3.11.3 through 3.11.6 rewrote,
# and none of those releases recorded a `bench-history.csv` row either, so a
# regression in it could not have been seen from either direction.
#
# `_bench_exec` runs a real payload through the PROCESS backend. Iteration
# counts are low because each one forks: these are latency figures, not
# throughput.
fn _bench_exec(cmd, pol) {
    var cfg = config_new();
    SandboxConfig_set_backend(cfg, KavachBackend.PROCESS);
    if (pol != 0) { SandboxConfig_set_policy(cfg, pol); }
    config_timeout_ms(cfg, 30000);
    var s = sandbox_create(cfg);
    if (s == 0) { return 0; }
    sandbox_transition(s, SandboxState.RUNNING);
    sandbox_exec(s, cmd);
    sandbox_destroy(s);
    return 0;
}

# The short-payload case, and the one most exposed to `CONFINE_POLL_MS`: the
# parent's first non-blocking read almost certainly finds nothing yet, so the
# loop takes an idle iteration and sleeps before the output is there to read.
fn bench_process_exec_echo() {
    return _bench_exec("/bin/echo hi", policy_minimal());
}

# Output past the 64 KiB pipe buffer — what the round-robin drain exists for.
# A payload that fills a pipe the parent is not draining deadlocks, so this is
# both a latency figure and a standing check that it does not.
#
# **No shell, no metacharacters, no quotes.** `_split_command` splits on
# whitespace only, so `sh -c "a | b"` becomes the tokens `"a`, `|`, `b` and
# either the guard refuses it or the shell dies on the fragment — the first
# version of this benchmark did exactly that and reported 20 µs, faster than
# `echo`, which is what a benchmark that runs nothing looks like. `seq` needs
# none of it: measured at **228,894 bytes** of stdout through this API.
fn bench_process_exec_large_output() {
    return _bench_exec("/usr/bin/seq 1 40000", policy_minimal());
}

# The confined path — namespaces off, but landlock/seccomp routing engaged, so
# `confine_child` runs rather than the plain fork/exec.
fn bench_process_exec_confined() {
    return _bench_exec("/bin/echo hi", policy_strict());
}

fn bench_sandbox_full_lifecycle() {
    var cfg = config_new();
    config_backend(cfg, KavachBackend.NOOP);
    var sb = sandbox_create(cfg);
    sandbox_transition(sb, SandboxState.RUNNING);
    sandbox_transition(sb, SandboxState.STOPPED);
    sandbox_transition(sb, SandboxState.DESTROYED);
    return 0;
}

# Note: audit chain bench touches disk (file_append_locked) — timing
# will be dominated by fs I/O. Reported for completeness only.
var _bench_chain = 0;

fn _setup_chain() {
    if (_bench_chain != 0) { return 0; }
    _bench_chain = audit_chain_open("/tmp/kavach-bench.audit", "benchkey", 8);
    return 0;
}

fn bench_audit_chain_record() {
    audit_chain_record(_bench_chain, "exec", "benchpayload");
    return 0;
}

# Constant-time HMAC verify (just the compare, not full verify path).
fn bench_ct_streq_64() {
    ct_streq("abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
      "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789");
    return 0;
}

fn bench_backend_parse() {
    backend_parse("sy-agnos");
    return 0;
}

# ---- 3.2.0 modules -------------------------------------------------------

fn bench_cgroup_wrap_argv() {
    var user_args = vec_new();
    vec_push(user_args, "ls");
    vec_push(user_args, "/tmp");
    cgroup_wrap_argv("/sys/fs/cgroup/kavach-42", user_args);
    return 0;
}

fn bench_cgroup_policy_has_limits() {
    cgroup_policy_has_limits(_strict_policy);
    return 0;
}

fn bench_http_path_extract() {
    _http_extract_secret_name("/v1/secret/API_KEY");
    return 0;
}

var _bench_http_proxy = 0;

fn _bench_setup_http() {
    if (_bench_http_proxy != 0) { return 0; }
    var p = credential_proxy_new();
    credential_proxy_register(p, "K1", "v1");
    credential_proxy_register(p, "K2", "v2");
    var allowed = vec_new();
    vec_push(allowed, "K1");
    vec_push(allowed, "K2");
    _bench_http_proxy = credential_http_proxy_new(p, allowed, 0);
    return 0;
}

fn bench_http_allowlist_hit() {
    _http_allowed(_bench_http_proxy, "K2");
    return 0;
}

fn bench_http_allowlist_miss() {
    _http_allowed(_bench_http_proxy, "UNKNOWN");
    return 0;
}

fn main() {
    alloc_init();
    sha256_global_init();
    kavach_init();
    _ensure_strict();
    _setup_proxy_100();
    _setup_text_with_secrets();
    _setup_gate_clean();
    _setup_chain();
    _bench_setup_http();
    _setup_large_code_text();

    var benches = vec_new();

    # Fast ops (sub-µs): batch-timed for accuracy.
    var b1 = bench_new("score_backend_process_strict");
    bench_run_batch(b1, &bench_score_backend_process_strict, 10000, 50);
    vec_push(benches, b1);

    var b2 = bench_new("score_all_backends_strict");
    bench_run_batch(b2, &bench_score_all_backends_strict, 2000, 50);
    vec_push(benches, b2);

    var b3 = bench_new("policy_strict_create");
    bench_run_batch(b3, &bench_policy_strict_create, 5000, 50);
    vec_push(benches, b3);

    var b4 = bench_new("config_builder_full");
    bench_run_batch(b4, &bench_config_builder_full, 2000, 50);
    vec_push(benches, b4);

    var b5 = bench_new("state_valid_transition_check");
    bench_run_batch(b5, &bench_state_valid_transition_check, 100000, 100);
    vec_push(benches, b5);

    var b6 = bench_new("ct_streq_64");
    bench_run_batch(b6, &bench_ct_streq_64, 10000, 50);
    vec_push(benches, b6);

    var b7 = bench_new("backend_parse");
    bench_run_batch(b7, &bench_backend_parse, 10000, 50);
    vec_push(benches, b7);

    # Medium ops (µs-range): regular timing.
    var b8 = bench_new("credential_env_vars_100");
    bench_run(b8, &bench_credential_env_vars_100, 2000);
    vec_push(benches, b8);

    var b9 = bench_new("secrets_scan_clean_text");
    bench_run(b9, &bench_secrets_scan_clean_text, 2000);
    vec_push(benches, b9);

    var b10 = bench_new("secrets_scan_with_secrets");
    bench_run(b10, &bench_secrets_scan_with_secrets, 2000);
    vec_push(benches, b10);

    var b11 = bench_new("secrets_redact");
    bench_run(b11, &bench_secrets_redact, 2000);
    vec_push(benches, b11);

    var b12 = bench_new("gate_clean_output");
    bench_run(b12, &bench_gate_clean_output, 1000);
    vec_push(benches, b12);

    var b13 = bench_new("health_check_noop");
    bench_run(b13, &bench_health_check_noop, 1000);
    vec_push(benches, b13);

    var b14 = bench_new("sandbox_full_lifecycle");
    bench_run(b14, &bench_sandbox_full_lifecycle, 1000);
    vec_push(benches, b14);

    # The exec path (3.11.7). Low iteration counts — each forks.
    var b23 = bench_new("process_exec_echo");
    bench_run(b23, &bench_process_exec_echo, 50);
    vec_push(benches, b23);

    var b24 = bench_new("process_exec_large_output");
    bench_run(b24, &bench_process_exec_large_output, 20);
    vec_push(benches, b24);

    var b25 = bench_new("process_exec_confined");
    bench_run(b25, &bench_process_exec_confined, 50);
    vec_push(benches, b25);

    # Disk-bound (reference only)
    var b15 = bench_new("audit_chain_record_to_tmpfs");
    bench_run(b15, &bench_audit_chain_record, 500);
    vec_push(benches, b15);

    # 3.2.0 modules
    var b16 = bench_new("cgroup_wrap_argv");
    bench_run_batch(b16, &bench_cgroup_wrap_argv, 5000, 50);
    vec_push(benches, b16);

    var b17 = bench_new("cgroup_policy_has_limits");
    bench_run_batch(b17, &bench_cgroup_policy_has_limits, 100000, 100);
    vec_push(benches, b17);

    var b18 = bench_new("http_path_extract");
    bench_run_batch(b18, &bench_http_path_extract, 50000, 100);
    vec_push(benches, b18);

    var b19 = bench_new("http_allowlist_hit");
    bench_run_batch(b19, &bench_http_allowlist_hit, 50000, 100);
    vec_push(benches, b19);

    var b20 = bench_new("http_allowlist_miss");
    bench_run_batch(b20, &bench_http_allowlist_miss, 50000, 100);
    vec_push(benches, b20);

    # 3.4.0 — Aho-Corasick scanner. Two views on a ~16 KB artifact: the AC
    # single pass vs the old per-pattern scan, so the history captures the win.
    var b21 = bench_new("code_scan_large_ac");
    bench_run(b21, &bench_code_scan_large, 2000);
    vec_push(benches, b21);

    var b22 = bench_new("code_scan_large_naive");
    bench_run(b22, &bench_code_scan_naive, 2000);
    vec_push(benches, b22);

    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(60, r);
