# kavach — SGX and TDX quote vectors for tests/kavach.tcyr and tests/kavach.bcyr
#
# The vectors are sigil's, copied from its tests/tcyr/sgx_verify_full.tcyr and
# tdx_verify_full.tcyr (fixture of 2026-05-22): synthesized quotes carrying a
# real PEM PCK chain up to a self-signed test root, "Sigil SGX Test Root". What
# the quotes hold:
#   SGX: MRENCLAVE aa*32, MRSIGNER bb*32, ISVPRODID 42, ISVSVN 7, DEBUG clear,
#        report data cc*64.
#   TDX: MRTD aa*32 then 00*16, TD_ATTRIBUTES 0x0101010101010101 (DEBUG set),
#        report data cc*64; one quote per attestation-key type (P-256, P-384).
# The wrong root is sigil's unrelated "Sigil Test Root CA". The certificates are
# valid from 2026-05-22 to 2027-05-22 (the leaf), so the tests verify as of a
# fixed time inside that window, never the clock.

var ATT_ROOT_LEN = 425;
var ATT_ROOT_HEX = "";
var ATT_WRONG_ROOT_LEN = 421;
var ATT_WRONG_ROOT_HEX = "";
var ATT_SGX_LEN = 2310;
var ATT_SGX_HEX = "";
var ATT_TDX_P256_LEN = 2510;
var ATT_TDX_P256_HEX = "";
var ATT_TDX_P384_LEN = 2574;
var ATT_TDX_P384_HEX = "";
var ATT_NOW = 1782518400;
var ATT_NOW_EARLY = 1748520000;
var ATT_NOW_LATE = 1820000000;
var ATT_SGX_MRENCLAVE = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
var ATT_SGX_MRSIGNER = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
var ATT_TDX_MRTD = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa00000000000000000000000000000000";
var ATT_OTHER = "abababababababababababababababababababababababababababababababab";
