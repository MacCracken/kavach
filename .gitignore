# Build artifacts
/target/
/build/
rust-old/target/

# Resolved deps — `cyrius deps` populates lib/ from cyrius.cyml
# [deps] stdlib + [deps.sigil]. lib/ is reproducible from the
# manifest + lockfile and is NOT committed (post-3.1.0).
/lib/

# Cyrius toolchain artifacts pulled into the workspace by the
# installer flow (release tarball + source archive). CI extracts
# these under $HOME/.cyrius, but ad-hoc local installs sometimes
# land them at the repo root.
cyrius-*.tar.gz
cyrius-[0-9]*/

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Debugging
*.pdb
core
core.*

# Coverage
lcov.info
tarpaulin-report.html
coverage/

# Benchmark output (criterion stores baselines in target/)
criterion/

# Environment / secrets
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Rust artifacts
**/*.rs.bk
Cargo.lock.bak

# Claude Code
.claude/

# Logs
*.log
